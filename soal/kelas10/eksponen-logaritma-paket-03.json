      "pilihan": [
        [{ "tipe": "paragraph", "text": "3" }],
        [{ "tipe": "paragraph", "text": "5" }],
        [{ "tipe": "paragraph", "text": "8" }],
        [{ "tipe": "paragraph", "text": "12" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "^2\\log 8 = 3, \\quad ^2\\log 4 = 2, \\quad ^2\\log 2 = 1" },
        { "tipe": "formula_block", "latex": "\\dfrac{3 + 2}{1} = 5" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "eks-03-08",
