      "pilihan": [
        [{ "tipe": "paragraph", "text": "3" }],
        [{ "tipe": "paragraph", "text": "5" }],
        [{ "tipe": "paragraph", "text": "8" }],
        [{ "tipe": "paragraph", "text": "11" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah ke bentuk eksponen:" },
        { "tipe": "formula_block", "latex": "^2\\log (x + 3) = 3 \\Rightarrow x + 3 = 2^3 = 8" },
        { "tipe": "formula_block", "latex": "x = 5" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "eks-03-07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{^2\\log 8 + ^2\\log 4}{^2\\log 2}$ adalah..." }
