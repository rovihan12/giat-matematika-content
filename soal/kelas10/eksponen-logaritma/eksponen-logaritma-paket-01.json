{
  "id": "eksponen-logaritma-paket-01",
  "nama": "Paket 1 - Eksponen Dasar",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "deskripsi": "Sifat-sifat eksponen dan operasinya",
  "tingkat": "MUDAH",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "eks-01-01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^3 \\times 2^4$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2^7$" }],
        [{ "tipe": "paragraph", "text": "$2^{12}$" }],
        [{ "tipe": "paragraph", "text": "$4^7$" }],
        [{ "tipe": "paragraph", "text": "$2^1$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat $a^m \\times a^n = a^{m+n}$:" },
        { "tipe": "formula_block", "latex": "2^3 \\times 2^4 = 2^{3+4} = 2^7" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{3^5}{3^2}$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$3^7$" }],
        [{ "tipe": "paragraph", "text": "$3^3$" }],
        [{ "tipe": "paragraph", "text": "$3^{10}$" }],
        [{ "tipe": "paragraph", "text": "$1^3$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat $\\dfrac{a^m}{a^n} = a^{m-n}$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{3^5}{3^2} = 3^{5-2} = 3^3 = 27" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2^3)^2$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2^5$" }],
        [{ "tipe": "paragraph", "text": "$2^6$" }],
        [{ "tipe": "paragraph", "text": "$2^9$" }],
        [{ "tipe": "paragraph", "text": "$4^6$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat $(a^m)^n = a^{m \\times n}$:" },
        { "tipe": "formula_block", "latex": "(2^3)^2 = 2^{3 \\times 2} = 2^6 = 64" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $5^0 + 3^0$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "0" }],
        [{ "tipe": "paragraph", "text": "1" }],
        [{ "tipe": "paragraph", "text": "2" }],
        [{ "tipe": "paragraph", "text": "8" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan (kecuali 0) berpangkat 0 hasilnya 1:" },
        { "tipe": "formula_block", "latex": "5^0 + 3^0 = 1 + 1 = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(\\dfrac{2}{3}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{4}{9}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{9}{4}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{4}{9}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{9}{4}$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$:" },
        { "tipe": "formula_block", "latex": "\\left(\\dfrac{2}{3}\\right)^{-2} = \\left(\\dfrac{3}{2}\\right)^2 = \\dfrac{9}{4}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\sqrt{8}$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2\\sqrt{2}$" }],
        [{ "tipe": "paragraph", "text": "$4\\sqrt{2}$" }],
        [{ "tipe": "paragraph", "text": "$2\\sqrt{4}$" }],
        [{ "tipe": "paragraph", "text": "$8\\sqrt{2}$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah akar menjadi bentuk pangkat, lalu sederhanakan:" },
        { "tipe": "formula_block", "latex": "\\sqrt{8} = \\sqrt{4 \\times 2} = \\sqrt{4} \\times \\sqrt{2} = 2\\sqrt{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{2}\\right)^3$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{1}{6}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{1}{8}$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\left(\\dfrac{1}{2}\\right)^3 = \\dfrac{1^3}{2^3} = \\dfrac{1}{8}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $a = 2$, maka nilai dari $a^4 - a^2$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "4" }],
        [{ "tipe": "paragraph", "text": "8" }],
        [{ "tipe": "paragraph", "text": "12" }],
        [{ "tipe": "paragraph", "text": "16" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $a = 2$:" },
        { "tipe": "formula_block", "latex": "a^4 - a^2 = 2^4 - 2^2 = 16 - 4 = 12" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $27^{\\frac{1}{3}}$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "3" }],
        [{ "tipe": "paragraph", "text": "9" }],
        [{ "tipe": "paragraph", "text": "13,5" }],
        [{ "tipe": "paragraph", "text": "81" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat $a^{\\frac{1}{n}} = \\sqrt[n]{a}$:" },
        { "tipe": "formula_block", "latex": "27^{\\frac{1}{3}} = \\sqrt[3]{27} = 3" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "eks-01-10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{2^5 \\times 2^3}{2^6}$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2^2$" }],
        [{ "tipe": "paragraph", "text": "$2^4$" }],
        [{ "tipe": "paragraph", "text": "$2^8$" }],
        [{ "tipe": "paragraph", "text": "$2^{14}$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sederhanakan pembilang dulu, lalu bagi:" },
        { "tipe": "formula_block", "latex": "\\dfrac{2^5 \\times 2^3}{2^6} = \\dfrac{2^8}{2^6} = 2^2 = 4" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
