{
  "id": "komposisi-fungsi-invers-paket-01",
  "nama": "Paket 1 - Fungsi & Komposisi",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "deskripsi": "Fungsi, operasi fungsi, dan komposisi",
  "tingkat": "SEDANG",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "kfi-01-01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x + 3$ dan $g(x) = x^2$. Nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "7" }],
        [{ "tipe": "paragraph", "text": "9" }],
        [{ "tipe": "paragraph", "text": "11" }],
        [{ "tipe": "paragraph", "text": "13" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kerjakan $g$ dulu, lalu hasilnya dimasukkan ke $f$:" },
        { "tipe": "formula_block", "latex": "g(2) = 2^2 = 4" },
        { "tipe": "formula_block", "latex": "f(g(2)) = f(4) = 2(4) + 3 = 11" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "kfi-01-02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x + 5$ dan $g(x) = 3x - 2$. Nilai $(g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "16" }],
        [{ "tipe": "paragraph", "text": "18" }],
        [{ "tipe": "paragraph", "text": "20" }],
        [{ "tipe": "paragraph", "text": "22" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f(1) = 1 + 5 = 6" },
        { "tipe": "formula_block", "latex": "g(f(1)) = g(6) = 3(6) - 2 = 16" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "kfi-01-03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x - 1$ dan $g(x) = x + 3$. Rumus $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2x + 5$" }],
        [{ "tipe": "paragraph", "text": "$2x + 3$" }],
        [{ "tipe": "paragraph", "text": "$2x - 3$" }],
        [{ "tipe": "paragraph", "text": "$2x - 5$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(f \\circ g)(x) = f(g(x)) = f(x + 3)" },
        { "tipe": "formula_block", "latex": "= 2(x + 3) - 1" },
        { "tipe": "formula_block", "latex": "= 2x + 6 - 1 = 2x + 5" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "kfi-01-04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^2$ dan $g(x) = x - 4$. Rumus $(g \\circ f)(x)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x^2 - 4$" }],
        [{ "tipe": "paragraph", "text": "$x^2 + 4$" }],
        [{ "tipe": "paragraph", "text": "$(x - 4)^2$" }],
        [{ "tipe": "paragraph", "text": "$x^2 - 8x + 16$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(g \\circ f)(x) = g(f(x)) = g(x^2)" },
        { "tipe": "formula_block", "latex": "= x^2 - 4" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "kfi-01-05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 3x + 1$ dan $g(x) = 2x - 5$. Nilai $(f \\circ g)(3)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "4" }],
        [{ "tipe": "paragraph", "text": "5" }],
        [{ "tipe": "paragraph", "text": "6" }],
        [{ "tipe": "paragraph", "text": "7" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "g(3) = 2(3) - 5 = 1" },
        { "tipe": "formula_block", "latex": "f(g(3)) = f(1) = 3(1) + 1 = 4" },
        { "tipe": "paragraph", "text": "Hmm, hasilnya 4 — ada di pilihan A. Jadi jawabannya <b>A (4)</b>." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "kfi-01-06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x + 5$ dan $(f \\circ g)(x) = 6x + 1$. Rumus $g(x)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$3x - 2$" }],
        [{ "tipe": "paragraph", "text": "$3x + 2$" }],
        [{ "tipe": "paragraph", "text": "$3x - 4$" }],
        [{ "tipe": "paragraph", "text": "$3x + 4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(g(x)) = 6x + 1$." },
        { "tipe": "paragraph", "text": "Karena $f(x) = 2x + 5$:" },
        { "tipe": "formula_block", "latex": "2 \\cdot g(x) + 5 = 6x + 1" },
        { "tipe": "formula_block", "latex": "2 \\cdot g(x) = 6x - 4" },
        { "tipe": "formula_block", "latex": "g(x) = 3x - 2" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "kfi-01-07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 5x - 3$ dan $g(x) = x + 2$. Nilai $x$ yang memenuhi $(f \\circ g)(x) = 27$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "2" }],
        [{ "tipe": "paragraph", "text": "3" }],
        [{ "tipe": "paragraph", "text": "4" }],
        [{ "tipe": "paragraph", "text": "5" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(f \\circ g)(x) = f(x + 2) = 5(x + 2) - 3" },
        { "tipe": "formula_block", "latex": "= 5x + 10 - 3 = 5x + 7" },
        { "tipe": "paragraph", "text": "Set sama dengan 27:" },
        { "tipe": "formula_block", "latex": "5x + 7 = 27" },
        { "tipe": "formula_block", "latex": "5x = 20 \\Rightarrow x = 4" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "kfi-01-08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^2 + 1$ dan $g(x) = 2x - 3$. Nilai $(f \\circ g)(0)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "8" }],
        [{ "tipe": "paragraph", "text": "10" }],
        [{ "tipe": "paragraph", "text": "12" }],
        [{ "tipe": "paragraph", "text": "14" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "g(0) = 2(0) - 3 = -3" },
        { "tipe": "formula_block", "latex": "f(g(0)) = f(-3) = (-3)^2 + 1 = 9 + 1 = 10" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "kfi-01-09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 4x + 1$ dan $g(x) = x - 3$. Nilai $(g \\circ f)(-1)$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "0" }],
        [{ "tipe": "paragraph", "text": "1" }],
        [{ "tipe": "paragraph", "text": "-4" }],
        [{ "tipe": "paragraph", "text": "-6" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f(-1) = 4(-1) + 1 = -3" },
        { "tipe": "formula_block", "latex": "g(f(-1)) = g(-3) = -3 - 3 = -6" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "kfi-01-10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah toko memberi diskon 20% untuk semua barang, lalu memberi potongan tambahan Rp10.000. Fungsi diskon: $f(x) = 0{,}8x$, fungsi potongan: $g(x) = x - 10000$. Jika harga awal barang Rp200.000, harga setelah diskon lalu potongan adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "Rp140.000" }],
        [{ "tipe": "paragraph", "text": "Rp150.000" }],
        [{ "tipe": "paragraph", "text": "Rp160.000" }],
        [{ "tipe": "paragraph", "text": "Rp170.000" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Diskon dulu, baru potongan:" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(x) = g(f(x))" },
        { "tipe": "formula_block", "latex": "= g(0{,}8x) = 0{,}8x - 10000" },
        { "tipe": "paragraph", "text": "Substitusi $x = 200000$:" },
        { "tipe": "formula_block", "latex": "= 0{,}8(200000) - 10000" },
        { "tipe": "formula_block", "latex": "= 160000 - 10000 = 150000" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
