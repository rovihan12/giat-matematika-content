{
  "id": "trigonometri-paket-02",
  "nama": "Paket 2 - Sudut Istimewa",
  "kelas": 10,
  "kategori": "Trigonometri",
  "deskripsi": "Nilai sudut-sudut istimewa dan identitas dasar",
  "tingkat": "SEDANG",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "trig-02-01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 30^\\circ + \\cos 60^\\circ$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "1" }],
        [{ "tipe": "paragraph", "text": "2" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\sin 30^\\circ = \\dfrac{1}{2}, \\quad \\cos 60^\\circ = \\dfrac{1}{2}" },
        { "tipe": "formula_block", "latex": "\\sin 30^\\circ + \\cos 60^\\circ = \\dfrac{1}{2} + \\dfrac{1}{2} = 1" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "trig-02-02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\tan 45^\\circ \\cdot \\sin 30^\\circ$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{2}}{2}$" }],
        [{ "tipe": "paragraph", "text": "1" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\tan 45^\\circ = 1, \\quad \\sin 30^\\circ = \\dfrac{1}{2}" },
        { "tipe": "formula_block", "latex": "\\tan 45^\\circ \\cdot \\sin 30^\\circ = 1 \\cdot \\dfrac{1}{2} = \\dfrac{1}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "trig-02-03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 60^\\circ \\cdot \\cos 30^\\circ$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{3}}{2}$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\sin 60^\\circ = \\dfrac{\\sqrt{3}}{2}, \\quad \\cos 30^\\circ = \\dfrac{\\sqrt{3}}{2}" },
        { "tipe": "formula_block", "latex": "\\sin 60^\\circ \\cdot \\cos 30^\\circ = \\dfrac{\\sqrt{3}}{2} \\cdot \\dfrac{\\sqrt{3}}{2}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{3}{4}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "trig-02-04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^2 45^\\circ + \\cos^2 45^\\circ$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "0" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "1" }],
        [{ "tipe": "paragraph", "text": "$\\sqrt{2}$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas Pythagoras:" },
        { "tipe": "formula_block", "latex": "\\sin^2\\theta + \\cos^2\\theta = 1" },
        { "tipe": "paragraph", "text": "Berlaku untuk semua nilai $\\theta$, termasuk $45^\\circ$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "trig-02-05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 150^\\circ$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{3}}{2}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{\\sqrt{3}}{2}$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$150^\\circ = 180^\\circ - 30^\\circ$ (kuadran II, sin positif)." },
        { "tipe": "formula_block", "latex": "\\sin 150^\\circ = \\sin(180^\\circ - 30^\\circ)" },
        { "tipe": "formula_block", "latex": "= \\sin 30^\\circ = \\dfrac{1}{2}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "trig-02-06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 210^\\circ$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{\\sqrt{3}}{2}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{3}}{2}$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$210^\\circ = 180^\\circ + 30^\\circ$ (kuadran III, cos negatif)." },
        { "tipe": "formula_block", "latex": "\\cos 210^\\circ = \\cos(180^\\circ + 30^\\circ)" },
        { "tipe": "formula_block", "latex": "= -\\cos 30^\\circ = -\\dfrac{\\sqrt{3}}{2}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "trig-02-07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\tan 315^\\circ$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$-1$" }],
        [{ "tipe": "paragraph", "text": "1" }],
        [{ "tipe": "paragraph", "text": "$-\\sqrt{3}$" }],
        [{ "tipe": "paragraph", "text": "$\\sqrt{3}$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$315^\\circ = 360^\\circ - 45^\\circ$ (kuadran IV, tan negatif)." },
        { "tipe": "formula_block", "latex": "\\tan 315^\\circ = \\tan(360^\\circ - 45^\\circ)" },
        { "tipe": "formula_block", "latex": "= -\\tan 45^\\circ = -1" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "trig-02-08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin\\theta = \\dfrac{3}{5}$ dan $\\theta$ di kuadran I, maka nilai $\\cos\\theta$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{4}{5}$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas Pythagoras:" },
        { "tipe": "formula_block", "latex": "\\sin^2\\theta + \\cos^2\\theta = 1" },
        { "tipe": "formula_block", "latex": "\\left(\\dfrac{3}{5}\\right)^2 + \\cos^2\\theta = 1" },
        { "tipe": "formula_block", "latex": "\\dfrac{9}{25} + \\cos^2\\theta = 1" },
        { "tipe": "formula_block", "latex": "\\cos^2\\theta = \\dfrac{16}{25}" },
        { "tipe": "paragraph", "text": "Karena $\\theta$ di kuadran I, $\\cos\\theta$ positif:" },
        { "tipe": "formula_block", "latex": "\\cos\\theta = \\dfrac{4}{5}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "trig-02-09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 30^\\circ}{\\cos 60^\\circ}$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "0" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "1" }],
        [{ "tipe": "paragraph", "text": "2" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\sin 30^\\circ = \\dfrac{1}{2}, \\quad \\cos 60^\\circ = \\dfrac{1}{2}" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\sin 30^\\circ}{\\cos 60^\\circ} = \\dfrac{\\frac{1}{2}}{\\frac{1}{2}} = 1" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "trig-02-10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos\\theta = \\dfrac{1}{2}$ dan $\\theta$ di kuadran IV, maka nilai $\\sin\\theta$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{3}}{2}$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{\\sqrt{3}}{2}$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas Pythagoras:" },
        { "tipe": "formula_block", "latex": "\\sin^2\\theta + \\cos^2\\theta = 1" },
        { "tipe": "formula_block", "latex": "\\sin^2\\theta + \\left(\\dfrac{1}{2}\\right)^2 = 1" },
        { "tipe": "formula_block", "latex": "\\sin^2\\theta = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}" },
        { "tipe": "formula_block", "latex": "\\sin\\theta = \\pm\\dfrac{\\sqrt{3}}{2}" },
        { "tipe": "paragraph", "text": "Karena $\\theta$ di kuadran IV, $\\sin\\theta$ negatif:" },
        { "tipe": "formula_block", "latex": "\\sin\\theta = -\\dfrac{\\sqrt{3}}{2}" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
