{
  "id": "statistika-lanjutan-paket-02",
  "nama": "Paket 2 - Regresi Linear",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "deskripsi": "Garis regresi linear dan prediksi",
  "tingkat": "SULIT",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "stal-02-01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Garis regresi linear dinyatakan dengan persamaan..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$y = ax + b$" }],
        [{ "tipe": "paragraph", "text": "$\\hat{y} = a + bx$" }],
        [{ "tipe": "paragraph", "text": "$y^2 = ax + b$" }],
        [{ "tipe": "paragraph", "text": "$y = a - bx^2$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis regresi linear biasanya dinyatakan:" },
        { "tipe": "formula_block", "latex": "\\hat{y} = a + bx" },
        { "tipe": "list", "ordered": false, "items": [
          "$\\hat{y}$ = nilai prediksi",
          "$a$ = intersep (nilai $y$ saat $x = 0$)",
          "$b$ = kemiringan (slope)"
        ]}
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "stal-02-02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Garis regresi $\\hat{y} = 58 + 3x$ memprediksi bahwa setiap kenaikan 1 satuan $x$ akan menaikkan $y$ sebesar..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "3 satuan" }],
        [{ "tipe": "paragraph", "text": "58 satuan" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{3}$ satuan" }],
        [{ "tipe": "paragraph", "text": "Tidak bisa ditentukan" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pada persamaan $\\hat{y} = a + bx$, nilai $b$ menunjukkan **kemiringan (slope)**." },
        { "tipe": "paragraph", "text": "Setiap kenaikan 1 satuan $x$, $y$ naik sebesar $b = 3$ satuan." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "stal-02-03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data $(x, y)$: (1, 3), (2, 5), (3, 7), (4, 9). Persamaan garis regresi yang paling tepat adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\hat{y} = 1 + 2x$" }],
        [{ "tipe": "paragraph", "text": "$\\hat{y} = 2 + x$" }],
        [{ "tipe": "paragraph", "text": "$\\hat{y} = 3x + 1$" }],
        [{ "tipe": "paragraph", "text": "$\\hat{y} = 2x - 1$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Perhatikan pola: setiap $x$ naik 1, $y$ naik 2. Jadi $b = 2$." },
        { "tipe": "paragraph", "text": "Saat $x = 1$, $y = 3$. Substitusi ke $\\hat{y} = a + bx$:" },
        { "tipe": "formula_block", "latex": "3 = a + 2(1) \\Rightarrow a = 1" },
        { "tipe": "formula_block", "latex": "\\hat{y} = 1 + 2x" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "stal-02-04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika persamaan regresi $\\hat{y} = 4 + 2x$ dan $x = 5$, maka nilai prediksi $\\hat{y}$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "10" }],
        [{ "tipe": "paragraph", "text": "12" }],
        [{ "tipe": "paragraph", "text": "14" }],
        [{ "tipe": "paragraph", "text": "16" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\hat{y} = 4 + 2(5)" },
        { "tipe": "formula_block", "latex": "= 4 + 10 = 14" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "stal-02-05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada persamaan regresi dengan **slope negatif** ($b < 0$), hubungan antara $x$ dan $y$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "Korelasi positif" }],
        [{ "tipe": "paragraph", "text": "Korelasi negatif" }],
        [{ "tipe": "paragraph", "text": "Tidak ada korelasi" }],
        [{ "tipe": "paragraph", "text": "Korelasi sempurna" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Interpretasi slope $b$:" },
        { "tipe": "list", "ordered": false, "items": [
          "$b > 0$ → korelasi **positif**",
          "$b < 0$ → korelasi **negatif**",
          "$b = 0$ → tidak ada hubungan linear"
        ]}
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "stal-02-06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data dari 5 siswa:" },
        { "tipe": "list", "ordered": false, "items": [
          "$\\sum x = 30$, $\\sum y = 380$, $\\sum xy = 2400$, $\\sum x^2 = 220$, $n = 5$"
        ]},
        { "tipe": "paragraph", "text": "Nilai slope ($b$) dari regresi linear adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "2" }],
        [{ "tipe": "paragraph", "text": "3" }],
        [{ "tipe": "paragraph", "text": "4" }],
        [{ "tipe": "paragraph", "text": "5" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "b = \\dfrac{n \\sum xy - \\sum x \\sum y}{n \\sum x^2 - (\\sum x)^2}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{5(2400) - (30)(380)}{5(220) - 30^2}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{12000 - 11400}{1100 - 900}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{600}{200} = 3" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "stal-02-07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari data sebelumnya, nilai intersep ($a$) dari regresi linear adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "56" }],
        [{ "tipe": "paragraph", "text": "58" }],
        [{ "tipe": "paragraph", "text": "60" }],
        [{ "tipe": "paragraph", "text": "62" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cari rata-rata dulu:" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{30}{5} = 6, \\quad \\bar{y} = \\dfrac{380}{5} = 76" },
        { "tipe": "paragraph", "text": "Gunakan rumus:" },
        { "tipe": "formula_block", "latex": "a = \\bar{y} - b\\bar{x}" },
        { "tipe": "formula_block", "latex": "= 76 - 3(6) = 76 - 18 = 58" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "stal-02-08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dengan persamaan regresi $\\hat{y} = 58 + 3x$, prediksi nilai $y$ jika $x = 7$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "77" }],
        [{ "tipe": "paragraph", "text": "78" }],
        [{ "tipe": "paragraph", "text": "79" }],
        [{ "tipe": "paragraph", "text": "80" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\hat{y} = 58 + 3(7)" },
        { "tipe": "formula_block", "latex": "= 58 + 21 = 79" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "stal-02-09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Keterbatasan regresi linear antara lain..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "Hanya untuk hubungan linear" }],
        [{ "tipe": "paragraph", "text": "Tidak bisa memprediksi nilai $y$" }],
        [{ "tipe": "paragraph", "text": "Selalu membutuhkan 100 data" }],
        [{ "tipe": "paragraph", "text": "Tidak bisa dihitung dengan rumus" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Keterbatasan regresi linear:" },
        { "tipe": "list", "ordered": false, "items": [
          "Hanya untuk **hubungan linear**",
          "Tidak membuktikan sebab-akibat",
          "Sensitif terhadap outlier",
          "Hati-hati ekstrapolasi (prediksi di luar rentang data)"
        ]}
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "stal-02-10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah penelitian melaporkan $r^2 = 0{,}25$ untuk hubungan jam tidur dan nilai ujian. Interpretasi yang paling tepat adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "Hubungannya sempurna" }],
        [{ "tipe": "paragraph", "text": "Hanya 25% variasi nilai ujian bisa dijelaskan oleh jam tidur" }],
        [{ "tipe": "paragraph", "text": "75% siswa gagal ujian" }],
        [{ "tipe": "paragraph", "text": "Tidak ada hubungan sama sekali" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r^2 = 0{,}25$ berarti **25% variasi nilai ujian** bisa dijelaskan oleh jam tidur." },
        { "tipe": "paragraph", "text": "Sisanya **75%** dipengaruhi faktor lain (motivasi, jam belajar, kemampuan, dll)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
