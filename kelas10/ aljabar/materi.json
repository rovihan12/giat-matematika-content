  "bab": [
    {
      "id": "10-aljabar-bab-01",
      "nomor": 1,
      "judul": "Persamaan Linear Satu Variabel",
      "deskripsi": "Konsep dasar persamaan linear satu variabel",
      "estimasi_menit": 15,
      "konten": [
        {
          "tipe": "heading",
          "level": 2,
          "text": "Pengertian Persamaan Linear"
        },
        {
          "tipe": "paragraph",
          "text": "Persamaan linear satu variabel adalah persamaan yang dapat ditulis dalam bentuk $ax + b = 0$ dengan $a \\neq 0$."
        },
        {
          "tipe": "formula_block",
          "latex": "ax + b = 0 \\quad \\Rightarrow \\quad x = \\frac{-b}{a}"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Sifat-Sifat Persamaan Linear"
        },
        {
          "tipe": "list",
          "ordered": false,
          "items": [
            "Jika $a = b$, maka $a + c = b + c$ untuk setiap $c$",
            "Jika $a = b$, maka $a \\cdot c = b \\cdot c$ untuk $c \\neq 0$",
            "Jika $a = b$ dan $b = c$, maka $a = c$"
          ]
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Contoh Soal"
        },
        {
          "tipe": "example",
          "judul": "Contoh 1",
          "konten": [
            { "tipe": "paragraph", "text": "Selesaikan $3x + 6 = 0$" },
            { "tipe": "formula_block", "latex": "3x = -6" },
            { "tipe": "formula_block", "latex": "x = \\frac{-6}{3} = -2" }
          ]
        },
        {
          "tipe": "heading",
          "level": 2,
          "text": "Simbol Matematika"
        },
        {
          "tipe": "formula_block",
          "latex": "\\sum_{i=1}^{n} x_i = x_1 + x_2 + \\cdots + x_n"
        },
        {
          "tipe": "formula_block",
          "latex": "\\int_{a}^{b} f(x) \\, dx = F(b) - F(a)"
        },
        {
          "tipe": "formula_block",
          "latex": "\\lim_{x \\to \\infty} \\frac{1}{x} = 0"
        }
      ]
    }
  ]
}
