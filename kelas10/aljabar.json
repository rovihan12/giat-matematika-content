  "bab": [
    {
      "id": "10-aljabar-01",
      "nomor": 1,
      "judul": "Persamaan Linear Satu Variabel",
      "deskripsi": "Konsep dasar & penyelesaian persamaan linear",
      "estimasi_menit": 15,
      "konten": [
        {
          "tipe": "heading",
          "level": 2,
          "text": "Pengertian Persamaan Linear"
        },
        {
          "tipe": "paragraph",
          "text": "Persamaan linear satu variabel adalah persamaan yang dapat ditulis dalam bentuk $ax + b = 0$ dengan $a \\neq 0$ dan $x$ adalah variabel."
        },
        {
          "tipe": "formula_block",
          "latex": "ax + b = 0 \\quad \\Rightarrow \\quad x = \\frac{-b}{a}"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Sifat-Sifat Persamaan Linear"
        },
        {
          "tipe": "list",
          "ordered": false,
          "items": [
            "Jika $a = b$, maka $a + c = b + c$ untuk setiap bilangan real $c$.",
            "Jika $a = b$, maka $a \\cdot c = b \\cdot c$ untuk setiap bilangan real $c \\neq 0$.",
            "Jika $a = b$ dan $b = c$, maka $a = c$ (sifat transitif)."
          ]
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Contoh Soal"
        },
        {
          "tipe": "example",
          "judul": "Contoh 1",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Selesaikan persamaan $3x + 6 = 0$."
            },
            {
              "tipe": "paragraph",
              "text": "**Penyelesaian:**"
            },
            {
              "tipe": "formula_block",
              "latex": "3x + 6 = 0"
            },
            {
              "tipe": "formula_block",
              "latex": "3x = -6"
            },
            {
              "tipe": "formula_block",
              "latex": "x = \\frac{-6}{3} = -2"
            },
            {
              "tipe": "paragraph",
              "text": "Jadi, himpunan penyelesaiannya adalah $\\{x \\mid x = -2\\}$."
            }
          ]
        },
        {
          "tipe": "heading",
          "level": 2,
          "text": "Simbol Matematika Lengkap"
        },
        {
          "tipe": "paragraph",
          "text": "Berikut beberapa simbol matematika yang sering digunakan:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\sum_{i=1}^{n} x_i = x_1 + x_2 + \\cdots + x_n"
        },
        {
          "tipe": "formula_block",
          "latex": "\\int_{a}^{b} f(x) \\, dx = F(b) - F(a)"
        },
        {
          "tipe": "formula_block",
          "latex": "\\lim_{x \\to \\infty} \\frac{1}{x} = 0"
        },
        {
          "tipe": "formula_block",
          "latex": "\\sqrt[3]{x^2 + y^2}"
        },
        {
          "tipe": "formula_block",
          "latex": "\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}"
        },
        {
          "tipe": "formula_block",
          "latex": "\\sin^2 \\theta + \\cos^2 \\theta = 1"
        },
        {
          "tipe": "formula_block",
          "latex": "\\vec{v} = \\hat{i} + 2\\hat{j} + 3\\hat{k}"
        }
      ]
    }
  ]
}
