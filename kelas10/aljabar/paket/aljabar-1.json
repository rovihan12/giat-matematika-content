{
  "id": "10-aljabar-1",
  "nama": "Aljabar 1",
  "kelas": 10,
  "kategori": "Aljabar",
  "deskripsi": "Latihan dasar persamaan linear",
  "tingkat": "MUDAH",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "10-aljabar-1-soal-001",
      "pertanyaan": [
        {
          "tipe": "paragraph",
          "text": "Tentukan nilai $x$ dari persamaan $2x + 8 = 0$."
        }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x = -4$" }],
        [{ "tipe": "paragraph", "text": "$x = 4$" }],
        [{ "tipe": "paragraph", "text": "$x = -2$" }],
        [{ "tipe": "paragraph", "text": "$x = 2$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        {
          "tipe": "paragraph",
          "text": "Persamaan awal: $2x + 8 = 0$"
        },
        {
          "tipe": "paragraph",
          "text": "Kurangi kedua ruas dengan 8: $2x = -8$"
        },
        {
          "tipe": "formula_block",
          "latex": "x = \\frac{-8}{2} = -4"
        },
        {
          "tipe": "paragraph",
          "text": "Jadi, nilai $x = -4$."
        }
      ]
    },
    {
      "id": "10-aljabar-1-soal-002",
      "pertanyaan": [
        {
          "tipe": "paragraph",
          "text": "Perhatikan grafik fungsi linear berikut!"
        },
        {
          "tipe": "image",
          "src": "images/kelas10/aljabar/grafik-linear.png",
          "caption": "Grafik $y = f(x)$"
        },
        {
          "tipe": "paragraph",
          "text": "Tentukan titik potong dengan sumbu X."
        }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$(-2, 0)$" }],
        [{ "tipe": "paragraph", "text": "$(0, -2)$" }],
        [{ "tipe": "paragraph", "text": "$(2, 0)$" }],
        [{ "tipe": "paragraph", "text": "$(0, 2)$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        {
          "tipe": "paragraph",
          "text": "Titik potong sumbu X terjadi saat $y = 0$."
        },
        {
          "tipe": "formula_block",
          "latex": "0 = 2x + 4 \\Rightarrow x = -2"
        },
        {
          "tipe": "paragraph",
          "text": "Jadi titik potongnya adalah $(-2, 0)$."
        }
      ]
    }
  ]
}
