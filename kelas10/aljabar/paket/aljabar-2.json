{
  "id": "10-aljabar-2",
  "nama": "Aljabar 2",
  "kelas": 10,
  "kategori": "Aljabar",
  "deskripsi": "Latihan persamaan kuadrat",
  "tingkat": "SEDANG",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "10-aljabar-2-001",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar dari persamaan $x^2 - 5x + 6 = 0$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x_1 = 2, x_2 = 3$" }],
        [{ "tipe": "paragraph", "text": "$x_1 = -2, x_2 = -3$" }],
        [{ "tipe": "paragraph", "text": "$x_1 = 1, x_2 = 6$" }],
        [{ "tipe": "paragraph", "text": "$x_1 = -1, x_2 = 6$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cari dua bilangan yang jumlahnya $-5$ dan hasil kalinya $6$." },
        { "tipe": "paragraph", "text": "Bilangan itu adalah $-2$ dan $-3$." },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 6 = (x - 2)(x - 3) = 0" },
        { "tipe": "paragraph", "text": "Jadi $x_1 = 2$ atau $x_2 = 3$." }
      ]
    },
    {
      "id": "10-aljabar-2-002",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diskriminan dari persamaan $2x^2 + 4x - 6 = 0$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$64$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$16$" }],
        [{ "tipe": "paragraph", "text": "$-32$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus diskriminan: $D = b^2 - 4ac$" },
        { "tipe": "paragraph", "text": "Dengan $a = 2$, $b = 4$, $c = -6$." },
        { "tipe": "formula_block", "latex": "D = 4^2 - 4(2)(-6) = 16 + 48 = 64" }
      ]
    },
    {
      "id": "10-aljabar-2-003",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ adalah akar dari $x^2 - 7x + 10 = 0$, maka $x_1 + x_2$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$-7$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$-10$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menurut rumus Vieta: $x_1 + x_2 = -\\frac{b}{a}$" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\frac{-7}{1} = 7" }
      ]
    },
    {
      "id": "10-aljabar-2-004",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $2$ dan $-5$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x^2 + 3x - 10 = 0$" }],
        [{ "tipe": "paragraph", "text": "$x^2 - 3x - 10 = 0$" }],
        [{ "tipe": "paragraph", "text": "$x^2 + 3x + 10 = 0$" }],
        [{ "tipe": "paragraph", "text": "$x^2 - 3x + 10 = 0$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika akar $p$ dan $q$, persamaannya: $x^2 - (p+q)x + pq = 0$" },
        { "tipe": "paragraph", "text": "Dengan $p = 2$, $q = -5$:" },
        { "tipe": "formula_block", "latex": "p + q = -3, \\quad pq = -10" },
        { "tipe": "formula_block", "latex": "x^2 - (-3)x + (-10) = x^2 + 3x - 10 = 0" }
      ]
    },
    {
      "id": "10-aljabar-2-005",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak dari grafik fungsi $y = x^2 - 4x + 3$ adalah..." }
      ],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$(2, -1)$" }],
        [{ "tipe": "paragraph", "text": "$(-2, 1)$" }],
        [{ "tipe": "paragraph", "text": "$(2, 1)$" }],
        [{ "tipe": "paragraph", "text": "$(-2, -1)$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus titik puncak: $x_p = -\\frac{b}{2a}$" },
        { "tipe": "formula_block", "latex": "x_p = -\\frac{-4}{2(1)} = 2" },
        { "tipe": "paragraph", "text": "Substitusi $x = 2$: $y = 2^2 - 4(2) + 3 = -1$" },
        { "tipe": "paragraph", "text": "Jadi titik puncaknya $(2, -1)$." }
      ]
    }
  ]
}
