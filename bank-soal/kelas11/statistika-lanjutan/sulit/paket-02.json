{
  "id": "bs-k11-stat-lanjut-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "tingkat": "SULIT",
  "deskripsi": "Analisis perubahan statistik & data gabungan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata 20 data adalah 25. Jika setiap data dikurangi 5, rata-ratanya menjadi ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"22"}],
        [{"tipe":"paragraph","text":"25"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami sifat perubahan data terhadap rata-rata ($\\bar{x}$)**" },
        { "tipe": "paragraph", "text": "Rata-rata merupakan ukuran pemusatan data. Jika setiap nilai dalam sekumpulan data ditambah atau dikurangi dengan suatu konstanta $k$, maka nilai rata-ratanya juga akan ikut bertambah atau berkurang sebesar $k$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung rata-rata baru**" },
        { "tipe": "paragraph", "text": "Diketahui rata-rata awal $\\bar{x}_{\\text{awal}} = 25$ dan setiap data dikurangi $k = 5$:" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{baru}} = \\bar{x}_{\\text{awal}} - 5 = 25 - 5 = 20" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-ratanya menjadi **20**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata 12 data adalah 30 dengan varians 25. Jika setiap nilai dikalikan 2, variansnya menjadi ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"25"}],
        [{"tipe":"paragraph","text":"50"}],
        [{"tipe":"paragraph","text":"75"}],
        [{"tipe":"paragraph","text":"100"}],
        [{"tipe":"paragraph","text":"125"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami sifat perubahan data terhadap varians ($S^2$)**" },
        { "tipe": "paragraph", "text": "Varians (ragam) merupakan ukuran penyebaran kuadrat. Jika setiap nilai data dikalikan dengan suatu konstanta $k$, maka variansnya akan dikalikan dengan kuadrat dari konstanta tersebut ($k^2$):" },
        { "tipe": "formula_block", "latex": "S^2_{\\text{baru}} = k^2 \\times S^2_{\\text{awal}}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusi nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui varians awal $S^2_{\\text{awal}} = 25$ dan faktor pengali $k = 2$:" },
        { "tipe": "formula_block", "latex": "S^2_{\\text{baru}} = 2^2 \\times 25 = 4 \\times 25 = 100" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, variansnya menjadi **100**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata nilai 25 siswa adalah 68. Jika 5 siswa dengan rata-rata 80 keluar, rata-rata siswa yang tersisa adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"63"}],
        [{"tipe":"paragraph","text":"64"}],
        [{"tipe":"paragraph","text":"65"}],
        [{"tipe":"paragraph","text":"66"}],
        [{"tipe":"paragraph","text":"67"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah nilai awal (25 siswa)**" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah Nilai}_{\\text{awal}} = 25 \\times 68 = 1700" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah nilai 5 siswa yang keluar**" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah Nilai}_{\\text{keluar}} = 5 \\times 80 = 400" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung total nilai dan banyak siswa yang tersisa**" },
        { "tipe": "paragraph", "text": "• Sisa siswa: $25 - 5 = 20$ siswa" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah Nilai}_{\\text{sisa}} = 1700 - 400 = 1300" },
        { "tipe": "paragraph", "text": "**Langkah 4: Hitung rata-rata siswa yang tersisa**" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{sisa}} = \\dfrac{1300}{20} = 65" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-rata nilai siswa yang tersisa adalah **65**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data: 4, 5, 6, 7, 8, 9, 10. Jika setiap nilai ditambah $k$ sehingga rata-rata menjadi 12, maka $k$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata awal ($\\bar{x}_{\\text{awal}}$)**" },
        { "tipe": "paragraph", "text": "Banyak data $n = 7$, sehingga:" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{awal}} = \\dfrac{4 + 5 + 6 + 7 + 8 + 9 + 10}{7} = \\dfrac{49}{7} = 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan sifat pergeseran rata-rata**" },
        { "tipe": "paragraph", "text": "Jika setiap nilai ditambah konstanta $k$, maka rata-rata baru menjadi $\\bar{x}_{\\text{baru}} = \\bar{x}_{\\text{awal}} + k$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan nilai $k$**" },
        { "tipe": "formula_block", "latex": "7 + k = 12" },
        { "tipe": "formula_block", "latex": "k = 12 - 7 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k = 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data: 3, 4, 5, 6, 8. Nilai $Q_1$, $Q_2$, dan $Q_3$ berturut-turut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4, 5, 6"}],
        [{"tipe":"paragraph","text":"3, 5, 8"}],
        [{"tipe":"paragraph","text":"4, 5, 8"}],
        [{"tipe":"paragraph","text":"3, 5, 6"}],
        [{"tipe":"paragraph","text":"4, 6, 8"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Urutkan data dan tentukan banyak data ($n$)**" },
        { "tipe": "paragraph", "text": "Data sudah terurut: $3, 4, 5, 6, 8$ dengan banyak data $n = 5$ (ganjil)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan Kuartil Tengah ($Q_2$ / Median)**" },
        { "tipe": "paragraph", "text": "Untuk $n = 5$, posisi median berada tepat di tengah (data ke-$3$):" },
        { "tipe": "formula_block", "latex": "Q_2 = x_3 = 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan Kuartil Bawah ($Q_1$) dan Kuartil Atas ($Q_3$)**" },
        { "tipe": "paragraph", "text": "Menggunakan aturan pembagian langsung (data posisi ke-$2$ dan ke-$4$ untuk distribusi diskrit $n=5$):" },
        { "tipe": "paragraph", "text": "• **Kuartil Bawah ($Q_1$):** berada pada posisi ke-$2$, yaitu $x_2 = 4$." },
        { "tipe": "paragraph", "text": "• **Kuartil Atas ($Q_3$):** berada pada posisi ke-$4$, yaitu $x_4 = 6$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $Q_1$, $Q_2$, dan $Q_3$ berturut-turut adalah **4, 5, dan 6**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata sekelompok data adalah 40 dan jangkauannya 30. Jika data terbesar adalah 60, data terkecil adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"25"}],
        [{"tipe":"paragraph","text":"30"}],
        [{"tipe":"paragraph","text":"35"}],
        [{"tipe":"paragraph","text":"40"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi informasi yang diketahui**" },
        { "tipe": "paragraph", "text": "• Jangkauan ($J$) $= 30$" },
        { "tipe": "paragraph", "text": "• Data terbesar ($x_{\\text{maks}}$) $= 60$" },
        { "tipe": "paragraph", "text": "*(Catatan: Informasi rata-rata $= 40$ merupakan pengecoh dan tidak diperlukan untuk mencari jangkauan)*." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus jangkauan**" },
        { "tipe": "formula_block", "latex": "J = x_{\\text{maks}} - x_{\\text{min}}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusi nilai dan selesaikan**" },
        { "tipe": "formula_block", "latex": "30 = 60 - x_{\\text{min}}" },
        { "tipe": "formula_block", "latex": "x_{\\text{min}} = 60 - 30 = 30" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, data terkecilnya adalah **30**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata ujian 30 siswa adalah 65. Jika nilai seorang siswa yang awalnya 80 diperbaiki menjadi 90, rata-rata baru adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"65,0"}],
        [{"tipe":"paragraph","text":"65,3"}],
        [{"tipe":"paragraph","text":"65,5"}],
        [{"tipe":"paragraph","text":"66,0"}],
        [{"tipe":"paragraph","text":"66,3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah nilai awal seluruh siswa**" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah Nilai}_{\\text{awal}} = 30 \\times 65 = 1950" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah nilai setelah perbaikan**" },
        { "tipe": "paragraph", "text": "Kurangi nilai lama ($80$) dan tambahkan nilai baru ($90$):" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah Nilai}_{\\text{baru}} = 1950 - 80 + 90 = 1960" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung rata-rata baru**" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{baru}} = \\dfrac{1960}{30} = 65{,}333\\ldots \\approx 65{,}3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-rata barunya adalah **65,3**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data: 2, 3, 4, 5, 6, 7, 8. Nilai desil ke-3 ($D_3$) adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"3,4"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"4,5"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Urutkan data dan tentukan banyak data ($n$)**" },
        { "tipe": "paragraph", "text": "Data sudah terurut: $2, 3, 4, 5, 6, 7, 8$, sehingga banyak data $n = 7$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan letak posisi Desil ke-3 ($D_3$)**" },
        { "tipe": "formula_block", "latex": "\\text{Letak } D_3 = \\text{data ke-}\\dfrac{3(n + 1)}{10} = \\text{data ke-}\\dfrac{3(7 + 1)}{10} = \\text{data ke-}\\dfrac{24}{10} = \\text{data ke-}2{,}4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $D_3$ dengan interpolasi linear**" },
        { "tipe": "paragraph", "text": "Posisi $2{,}4$ berada di antara data ke-$2$ ($x_2 = 3$) dan data ke-$3$ ($x_3 = 4$):" },
        { "tipe": "formula_block", "latex": "D_3 = x_2 + 0{,}4(x_3 - x_2)" },
        { "tipe": "formula_block", "latex": "D_3 = 3 + 0{,}4(4 - 3) = 3 + 0{,}4(1) = 3{,}4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai desil ke-3 ($D_3$) adalah **3,4**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data: 15, 12, 18, 10, 14, 20, 16, 11 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"13,5"}],
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"14,5"}],
        [{"tipe":"paragraph","text":"15"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Urutkan data dari nilai terkecil ke terbesar**" },
        { "tipe": "paragraph", "text": "Data terurut: $10, 11, 12, 14, 15, 16, 18, 20$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan posisi median**" },
        { "tipe": "paragraph", "text": "Banyak data adalah $n = 8$ (genap), sehingga median merupakan rata-rata dari dua data yang berada tepat di tengah, yaitu data ke-$4$ ($x_4 = 14$) dan data ke-$5$ ($x_5 = 15$)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai median ($Me$)**" },
        { "tipe": "formula_block", "latex": "Me = \\dfrac{x_4 + x_5}{2} = \\dfrac{14 + 15}{2} = \\dfrac{29}{2} = 14{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, median dari data tersebut adalah **14,5**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-stat-lanjut-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata 5 data adalah 12. Jika satu data baru ditambahkan, rata-ratanya menjadi 13. Nilai data baru tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"20"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah nilai awal (5 data)**" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah Nilai}_{\\text{awal}} = 5 \\times 12 = 60" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah nilai setelah 1 data baru ditambahkan (6 data)**" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah Nilai}_{\\text{akhir}} = (5 + 1) \\times 13 = 6 \\times 13 = 78" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung selisih jumlah nilai**" },
        { "tipe": "formula_block", "latex": "x_{\\text{baru}} = 78 - 60 = 18" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai data baru tersebut adalah **18**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
