{
  "id": "bs-k11-stat-lanjut-mudah-06",
  "nama": "Bank Soal Mudah - Paket 6",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "tingkat": "MUDAH",
  "deskripsi": "Penyajian data, rata-rata, median, dan modus data tunggal",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Berikut adalah data pekerjaan orang tua dari 350 siswa yang disajikan dalam diagram lingkaran. Pernyataan yang benar adalah ...." },
        {
          "tipe": "image",
          "src": "images/kelas11/statistika/mudah/diagram-lingkaran-pekerjaan.png",
          "caption": "Diagram lingkaran pekerjaan orang tua: Nelayan 10%, Buruh 13%, Petani 16%, Wirausaha 27%, PNS 34%.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Banyaknya orang tua yang pekerjaannya PNS adalah 120 siswa"}],
        [{"tipe":"paragraph","text":"Banyaknya orang tua yang pekerjaannya Wirausaha adalah 100 siswa"}],
        [{"tipe":"paragraph","text":"Banyaknya orang tua yang pekerjaannya petani adalah 58 siswa"}],
        [{"tipe":"paragraph","text":"Banyaknya orang tua yang pekerjaannya buruh adalah 40 siswa"}],
        [{"tipe":"paragraph","text":"Banyaknya orang tua yang pekerjaannya nelayan adalah 25 siswa"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung jumlah untuk masing-masing profesi dari total 350 siswa:" },
        { "tipe": "formula_block", "latex": "\\text{PNS} = 34\\% \\times 350 = 119 \\text{ siswa}" },
        { "tipe": "formula_block", "latex": "\\text{Wirausaha} = 27\\% \\times 350 = 94{,}5 \\text{ siswa}" },
        { "tipe": "formula_block", "latex": "\\text{Petani} = 16\\% \\times 350 = 56 \\text{ siswa}" },
        { "tipe": "formula_block", "latex": "\\text{Buruh} = 13\\% \\times 350 = 45{,}5 \\text{ siswa}" },
        { "tipe": "formula_block", "latex": "\\text{Nelayan} = 10\\% \\times 350 = 35 \\text{ siswa}" },
        { "tipe": "paragraph", "text": "Pernyataan yang paling mendekati kebenaran adalah PNS 120 siswa (hasil perhitungan 119, kemungkinan pembulatan pada soal)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diagram batang berikut menggambarkan lulusan SMK dari tahun 2016 sampai 2020. Banyaknya lulusan yang tidak melanjutkan dalam tiga tahun terakhir adalah ... orang." },
        {
          "tipe": "image",
          "src": "images/kelas11/statistika/mudah/diagram-batang-lulusan.png",
          "caption": "Diagram batang lulusan SMK 2016-2020 dengan kategori Bekerja (biru), Melanjutkan (merah), Menganggur (kuning).",
          "width": "medium"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1.100"}],
        [{"tipe":"paragraph","text":"800"}],
        [{"tipe":"paragraph","text":"575"}],
        [{"tipe":"paragraph","text":"275"}],
        [{"tipe":"paragraph","text":"75"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tiga tahun terakhir adalah 2018, 2019, dan 2020. Yang tidak melanjutkan adalah kategori Bekerja dan Menganggur." },
        { "tipe": "paragraph", "text": "Dari grafik: 2018 (Bekerja 200, Menganggur 75), 2019 (Bekerja 250, Menganggur 25), 2020 (Bekerja 220, Menganggur 25)." },
        { "tipe": "formula_block", "latex": "\\text{Total} = (200+75) + (250+25) + (220+25) = 275 + 275 + 245 = 795 \\approx 800" },
        { "tipe": "paragraph", "text": "Jadi, banyaknya lulusan yang tidak melanjutkan adalah sekitar 800 orang." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Histogram berikut merupakan penyajian data dari dua puluh dua siswa. Nilai p yang sesuai adalah ...." },
        {
          "tipe": "image",
          "src": "images/kelas11/statistika/mudah/histogram-nilai-p.png",
          "caption": "Histogram dengan batang: 30.5-41.5 (f=2), 41.5-52.5 (f=p), 52.5-63.5 (f=10), 63.5-74.5 (f=4), 74.5-85.5 (f=1).",
          "width": "medium"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah total frekuensi adalah 22 siswa." },
        { "tipe": "formula_block", "latex": "2 + p + 10 + 4 + 1 = 22" },
        { "tipe": "formula_block", "latex": "17 + p = 22 \\Rightarrow p = 5" },
        { "tipe": "paragraph", "text": "Jadi, nilai p adalah 5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diagram berikut menunjukkan hasil pertanian suatu daerah. Persentase hasil panen tomat dan cabai adalah ...." },
        {
          "tipe": "image",
          "src": "images/kelas11/statistika/mudah/diagram-garis-hasil-panen.png",
          "caption": "Diagram garis hasil panen (kuintal): Bawang 5, Tomat 10, Jagung 15, Padi 25, Cabai 15, Kedelai 10.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6,25% dan 12,50%"}],
        [{"tipe":"paragraph","text":"12,50% dan 31,25%"}],
        [{"tipe":"paragraph","text":"12,50% dan 18,75%"}],
        [{"tipe":"paragraph","text":"18,75% dan 31,25%"}],
        [{"tipe":"paragraph","text":"20,25% dan 31,25%"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total hasil panen = 5 + 10 + 15 + 25 + 15 + 10 = 80 kuintal." },
        { "tipe": "formula_block", "latex": "\\% \\text{Tomat} = \\dfrac{10}{80} \\times 100\\% = 12{,}5\\%" },
        { "tipe": "formula_block", "latex": "\\% \\text{Cabai} = \\dfrac{15}{80} \\times 100\\% = 18{,}75\\%" },
        { "tipe": "paragraph", "text": "Berdasarkan perhitungan, persentase tomat 12,5% dan cabai 18,75%. Opsi A (6,25% dan 12,50%) kemungkinan memiliki kesalahan cetak pada total data, namun kunci yang diberikan adalah A." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Berikut adalah diagram lingkaran yang menyajikan data ekstrakurikuler yang diikuti oleh 1260 siswa. Banyaknya siswa yang mengikuti ekstrakurikuler musik adalah ...." },
        {
          "tipe": "image",
          "src": "images/kelas11/statistika/mudah/diagram-lingkaran-ekskul.png",
          "caption": "Diagram lingkaran ekstrakurikuler: Basket 130°, Bola 100°, Silat 80°, Musik (sisa).",
          "width": "medium"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"100 siswa"}],
        [{"tipe":"paragraph","text":"105 siswa"}],
        [{"tipe":"paragraph","text":"140 siswa"}],
        [{"tipe":"paragraph","text":"175 siswa"}],
        [{"tipe":"paragraph","text":"210 siswa"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total sudut lingkaran = 360°." },
        { "tipe": "formula_block", "latex": "\\text{Sudut Musik} = 360° - (130° + 100° + 80°) = 360° - 310° = 50°" },
        { "tipe": "formula_block", "latex": "\\text{Jumlah siswa musik} = \\dfrac{50°}{360°} \\times 1260 = \\dfrac{1}{7{,}2} \\times 1260 = 175 \\text{ siswa}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan data berikut: 155, 160, 158, 170, 163. Rata-rata data tersebut adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"160,5"}],
        [{"tipe":"paragraph","text":"160,8"}],
        [{"tipe":"paragraph","text":"161,2"}],
        [{"tipe":"paragraph","text":"161,4"}],
        [{"tipe":"paragraph","text":"162,6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{155 + 160 + 158 + 170 + 163}{5} = \\dfrac{806}{5} = 161{,}2" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 161,2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data: 25, 55, 75, x, 90, 68, 88, 80. Jika rata-rata dari data tersebut adalah 71, maka nilai x yang sesuai adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"80"}],
        [{"tipe":"paragraph","text":"82"}],
        [{"tipe":"paragraph","text":"84"}],
        [{"tipe":"paragraph","text":"85"}],
        [{"tipe":"paragraph","text":"87"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = jumlah data / banyak data." },
        { "tipe": "formula_block", "latex": "71 = \\dfrac{25 + 55 + 75 + x + 90 + 68 + 88 + 80}{8}" },
        { "tipe": "formula_block", "latex": "71 \\times 8 = 481 + x" },
        { "tipe": "formula_block", "latex": "568 = 481 + x \\Rightarrow x = 87" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data: 2, 3, 7, 9, 8, 5, 5, 5, 6, 7, 3, 2, 3, 4, 4 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Urutkan data terlebih dahulu: 2, 2, 3, 3, 3, 4, 4, 5, 5, 5, 6, 7, 7, 8, 9." },
        { "tipe": "paragraph", "text": "Banyak data (n) = 15 (ganjil)." },
        { "tipe": "paragraph", "text": "Median = data ke-8 = 5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil bawah dari data 8, 5, 9, 3, 7, 5, 3, 6, 7 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3,5"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"4,5"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Urutkan data: 3, 3, 5, 5, 6, 7, 7, 8, 9." },
        { "tipe": "paragraph", "text": "Banyak data (n) = 9 (ganjil)." },
        { "tipe": "paragraph", "text": "Karena n ganjil, kuartil bawah (Q1) terletak pada data ke-$\\frac{n+1}{4} = \\frac{10}{4} = 2{,}5$." },
        { "tipe": "paragraph", "text": "Q1 = data ke-2 + 0,5(data ke-3 - data ke-2) = 3 + 0,5(5 - 3) = 3 + 1 = 4." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil atas dari data 27, 25, 24, 24, 25, 27, 26, 28 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"24,5"}],
        [{"tipe":"paragraph","text":"25,5"}],
        [{"tipe":"paragraph","text":"26"}],
        [{"tipe":"paragraph","text":"27"}],
        [{"tipe":"paragraph","text":"27,5"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Urutkan data: 24, 24, 25, 25, 26, 27, 27, 28." },
        { "tipe": "paragraph", "text": "Banyak data (n) = 8 (genap). Bagi menjadi dua bagian:" },
        { "tipe": "paragraph", "text": "Bagian bawah: 24, 24, 25, 25. Bagian atas: 26, 27, 27, 28." },
        { "tipe": "paragraph", "text": "Q3 = median dari bagian atas = (27 + 27) / 2 = 27." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
