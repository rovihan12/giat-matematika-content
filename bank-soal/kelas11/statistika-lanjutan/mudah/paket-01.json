{
  "id": "bs-k11-stat-lanjut-mudah-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "tingkat": "MUDAH",
  "deskripsi": "Ukuran pemusatan & penyebaran data tunggal",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data: 4, 6, 7, 8, 10. Rata-rata dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = jumlah data / banyak data." },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{4 + 6 + 7 + 8 + 10}{5} = \\dfrac{35}{5} = 7" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 7." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data: 3, 5, 7, 9, 11, 13 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Data sudah terurut dan berjumlah 6 (genap). Median = rata-rata dua data tengah, yaitu data ke-3 dan ke-4." },
        { "tipe": "formula_block", "latex": "Me = \\dfrac{7 + 9}{2} = 8" },
        { "tipe": "paragraph", "text": "Jadi, mediannya adalah 8." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data: 2, 3, 3, 5, 5, 5, 7, 8, 8 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Modus = nilai yang paling sering muncul." },
        { "tipe": "paragraph", "text": "Frekuensi: 2→1, 3→2, 5→3, 7→1, 8→2." },
        { "tipe": "paragraph", "text": "Nilai 5 muncul paling banyak (3 kali). Jadi, modus = 5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jangkauan (range) dari data: 12, 7, 15, 9, 20, 5, 18 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"20"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jangkauan = data terbesar − data terkecil." },
        { "tipe": "formula_block", "latex": "R = 20 - 5 = 15" },
        { "tipe": "paragraph", "text": "Jadi, jangkauannya adalah 15." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil bawah (Q₁) dari data: 3, 4, 5, 6, 7, 8, 9, 10 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"4,5"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"5,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data = 8 (genap). Bagi menjadi dua bagian: bawah = 3, 4, 5, 6 dan atas = 7, 8, 9, 10." },
        { "tipe": "paragraph", "text": "Q₁ = median bagian bawah = (4 + 5) / 2 = 4,5." },
        { "tipe": "paragraph", "text": "Jadi, Q₁ = 4,5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil atas (Q₃) dari data: 2, 4, 6, 8, 10, 12, 14, 16 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"14"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data = 8. Bagi dua: bawah = 2, 4, 6, 8 dan atas = 10, 12, 14, 16." },
        { "tipe": "paragraph", "text": "Q₃ = median bagian atas = (12 + 14) / 2 = 13." },
        { "tipe": "paragraph", "text": "Jadi, Q₃ = 13." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data: 4, 5, 6, 7, 8 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1,0"}],
        [{"tipe":"paragraph","text":"1,2"}],
        [{"tipe":"paragraph","text":"1,4"}],
        [{"tipe":"paragraph","text":"1,6"}],
        [{"tipe":"paragraph","text":"2,0"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = (4 + 5 + 6 + 7 + 8) / 5 = 6." },
        { "tipe": "paragraph", "text": "Simpangan tiap data: |4−6|=2, |5−6|=1, |6−6|=0, |7−6|=1, |8−6|=2." },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{2+1+0+1+2}{5} = \\dfrac{6}{5} = 1{,}2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Varians (ragam) dari data: 2, 4, 6, 8, 10 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = (2 + 4 + 6 + 8 + 10) / 5 = 6." },
        { "tipe": "paragraph", "text": "Jumlah kuadrat simpangan = (−4)² + (−2)² + 0² + 2² + 4² = 16 + 4 + 0 + 4 + 16 = 40." },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{40}{5} = 8" },
        { "tipe": "paragraph", "text": "Jadi, variansnya adalah 8." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan baku dari data: 2, 4, 6, 8, 10 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"√2"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"2√2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"√8"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari soal sebelumnya, varians S² = 8." },
        { "tipe": "formula_block", "latex": "S = \\sqrt{8} = 2\\sqrt{2}" },
        { "tipe": "paragraph", "text": "Jadi, simpangan bakunya adalah 2√2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jangkauan antarkuartil dari data: 3, 5, 7, 8, 10, 12, 14, 15 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data = 8. Bagi dua: bawah = 3, 5, 7, 8; atas = 10, 12, 14, 15." },
        { "tipe": "paragraph", "text": "Q₁ = (5 + 7) / 2 = 6; Q₃ = (12 + 14) / 2 = 13." },
        { "tipe": "formula_block", "latex": "H = Q_3 - Q_1 = 13 - 6 = 7" },
        { "tipe": "paragraph", "text": "Jadi, jangkauan antarkuartilnya adalah 7." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
