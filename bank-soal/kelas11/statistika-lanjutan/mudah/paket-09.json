        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Skor} & f & F_k \\\\ \\hline 30 - 39 & 1 & 1 \\\\ 40 - 49 & 4 & 5 \\\\ 50 - 59 & 8 & 13 \\\\ 60 - 69 & 14 & 27 \\\\ 70 - 79 & 10 & 37 \\\\ 80 - 89 & 3 & 40 \\\\ \\hline \\end{array}" },
