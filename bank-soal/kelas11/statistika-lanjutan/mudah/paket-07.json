{
  "id": "bs-k11-stat-lanjut-mudah-07",
  "nama": "Bank Soal Mudah - Paket 7",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "tingkat": "MUDAH",
  "deskripsi": "Ukuran pemusatan dan penyebaran data tunggal",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel nilai tugas matematika suatu kelas sebagai berikut. Rata-rata nilai tugas kelas tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|c|c|c|c|c|} \\hline \\text{Nilai} & 30 & 40 & 50 & 60 & 70 & 80 \\\\ \\hline \\text{Frekuensi} & 4 & 6 & 7 & 12 & 6 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"56,25"}],
        [{"tipe":"paragraph","text":"56,50"}],
        [{"tipe":"paragraph","text":"56,75"}],
        [{"tipe":"paragraph","text":"57,50"}],
        [{"tipe":"paragraph","text":"57,75"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus rata-rata data berfrekuensi: $\\bar{x} = \\dfrac{\\sum f_i x_i}{\\sum f_i}$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai } (x_i) & f_i & f_i \\cdot x_i \\\\ \\hline 30 & 4 & 120 \\\\ 40 & 6 & 240 \\\\ 50 & 7 & 350 \\\\ 60 & 12 & 720 \\\\ 70 & 6 & 420 \\\\ 80 & 5 & 400 \\\\ \\hline \\text{Jumlah} & 40 & 2250 \\\\ \\hline \\end{array}" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{2250}{40} = 56{,}25" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 56,25." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata berat badan dari dua puluh orang wanita 58 kg, sedangkan rata-rata berat badan dari sepuluh orang pria 85 kg. Rata-rata berat badan ketiga puluh orang tersebut adalah ... kg." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"65"}],
        [{"tipe":"paragraph","text":"67"}],
        [{"tipe":"paragraph","text":"69"}],
        [{"tipe":"paragraph","text":"72"}],
        [{"tipe":"paragraph","text":"75"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus rata-rata gabungan:" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{gab}} = \\dfrac{n_1 \\bar{x}_1 + n_2 \\bar{x}_2}{n_1 + n_2}" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{gab}} = \\dfrac{20(58) + 10(85)}{20 + 10} = \\dfrac{1160 + 850}{30} = \\dfrac{2010}{30} = 67" },
        { "tipe": "paragraph", "text": "Jadi, rata-rata berat badan ketiga puluh orang tersebut adalah 67 kg." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata tinggi badan dari suatu kelompok yang terdiri dari 12 siswa adalah 138 cm. Jika digabung dengan 10 siswa yang lain, rata-rata tinggi badannya menjadi 148 cm. Rata-rata tinggi badan dari 10 siswa yang digabungkan adalah ... cm." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"160"}],
        [{"tipe":"paragraph","text":"155"}],
        [{"tipe":"paragraph","text":"150"}],
        [{"tipe":"paragraph","text":"145"}],
        [{"tipe":"paragraph","text":"140"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total tinggi 12 siswa = $12 \\times 138 = 1656$." },
        { "tipe": "paragraph", "text": "Total tinggi 22 siswa = $22 \\times 148 = 3256$." },
        { "tipe": "paragraph", "text": "Total tinggi 10 siswa = $3256 - 1656 = 1600$." },
        { "tipe": "formula_block", "latex": "\\bar{x}_{10} = \\dfrac{1600}{10} = 160" },
        { "tipe": "paragraph", "text": "Jadi, rata-rata tinggi badan 10 siswa tersebut adalah 160 cm." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data berikut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Data} & \\text{Frekuensi} \\\\ \\hline 5 - 9 & 4 \\\\ 10 - 14 & 5 \\\\ 15 - 19 & 12 \\\\ 20 - 24 & 5 \\\\ 25 - 29 & 3 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"17,0"}],
        [{"tipe":"paragraph","text":"16,5"}],
        [{"tipe":"paragraph","text":"16,0"}],
        [{"tipe":"paragraph","text":"15,5"}],
        [{"tipe":"paragraph","text":"15,0"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus adalah kelas dengan frekuensi tertinggi, yaitu $15 - 19$ dengan $f = 12$." },
        { "tipe": "paragraph", "text": "Tepi bawah $T_b = 14{,}5$; panjang kelas $p = 5$." },
        { "tipe": "formula_block", "latex": "d_1 = 12 - 5 = 7; \\quad d_2 = 12 - 5 = 7" },
        { "tipe": "formula_block", "latex": "Mo = T_b + p \\left( \\dfrac{d_1}{d_1 + d_2} \\right) = 14{,}5 + 5 \\left( \\dfrac{7}{7+7} \\right) = 14{,}5 + 5(0{,}5) = 17{,}0" },
        { "tipe": "paragraph", "text": "Jadi, modusnya adalah 17,0." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jangkauan dari data 20, 25, 72, 56, 65, 63, 54, 30, 85, 87, 80, 38, 72, 75, 48, 62, 80, 52, 40, 22 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"32"}],
        [{"tipe":"paragraph","text":"40"}],
        [{"tipe":"paragraph","text":"55"}],
        [{"tipe":"paragraph","text":"57"}],
        [{"tipe":"paragraph","text":"67"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Data terbesar = 87, data terkecil = 20." },
        { "tipe": "formula_block", "latex": "R = x_{\\max} - x_{\\min} = 87 - 20 = 67" },
        { "tipe": "paragraph", "text": "Jadi, jangkauannya adalah 67." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data tunggal 7, 5, 6, 3, 8, 7 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1,3"}],
        [{"tipe":"paragraph","text":"1,4"}],
        [{"tipe":"paragraph","text":"1,5"}],
        [{"tipe":"paragraph","text":"1,6"}],
        [{"tipe":"paragraph","text":"1,8"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = $\\dfrac{7 + 5 + 6 + 3 + 8 + 7}{6} = \\dfrac{36}{6} = 6$." },
        { "tipe": "paragraph", "text": "Simpangan tiap data: $|7-6|=1$, $|5-6|=1$, $|6-6|=0$, $|3-6|=3$, $|8-6|=2$, $|7-6|=1$." },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{1 + 1 + 0 + 3 + 2 + 1}{6} = \\dfrac{8}{6} = 1{,}33\\ldots \\approx 1{,}4" },
        { "tipe": "paragraph", "text": "Jadi, simpangan rata-ratanya sekitar 1,4." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data 15, 16, 17, 18, 19. Simpangan baku dari data tersebut adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"$\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"1"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = $\\dfrac{15+16+17+18+19}{5} = 17$." },
        { "tipe": "formula_block", "latex": "\\sum (x_i - \\bar{x})^2 = (-2)^2 + (-1)^2 + 0^2 + 1^2 + 2^2 = 4 + 1 + 0 + 1 + 4 = 10" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{10}{5} = 2 \\Rightarrow S = \\sqrt{2}" },
        { "tipe": "paragraph", "text": "Jadi, simpangan bakunya adalah $\\sqrt{2}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Variansi dari data berikut 10, 13, 11, 14, 12 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = $\\dfrac{10+13+11+14+12}{5} = \\dfrac{60}{5} = 12$." },
        { "tipe": "formula_block", "latex": "\\sum (x_i - \\bar{x})^2 = (-2)^2 + 1^2 + (-1)^2 + 2^2 + 0^2 = 4 + 1 + 1 + 4 + 0 = 10" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{10}{5} = 2" },
        { "tipe": "paragraph", "text": "Jadi, variansinya adalah 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan baku dari data: 3, 3, 4, 5, 5 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{5}\\sqrt{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{5}\\sqrt{10}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}\\sqrt{30}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}\\sqrt{35}$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = $\\dfrac{3+3+4+5+5}{5} = \\dfrac{20}{5} = 4$." },
        { "tipe": "formula_block", "latex": "\\sum (x_i - \\bar{x})^2 = (-1)^2 + (-1)^2 + 0^2 + 1^2 + 1^2 = 1 + 1 + 0 + 1 + 1 = 4" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{4}{5} \\Rightarrow S = \\sqrt{\\dfrac{4}{5}} = \\dfrac{2}{\\sqrt{5}} = \\dfrac{2}{5}\\sqrt{5}" },
        { "tipe": "paragraph", "text": "Jadi, simpangan bakunya adalah $\\dfrac{2}{5}\\sqrt{5}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan kuartil dari data 6, 7, 7, 3, 8, 4, 6, 5, 5, 9, 10, 4, 4, 3 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{2}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Urutkan data: 3, 3, 4, 4, 4, 5, 5, 6, 6, 7, 7, 8, 9, 10." },
        { "tipe": "paragraph", "text": "Banyak data = 14 (genap). Median = rata-rata data ke-7 dan ke-8 = (5+6)/2 = 5,5." },
        { "tipe": "paragraph", "text": "Bagian bawah: 3, 3, 4, 4, 4, 5, 5. Q1 = data ke-4 = 4." },
        { "tipe": "paragraph", "text": "Bagian atas: 6, 6, 7, 7, 8, 9, 10. Q3 = data ke-4 dari atas = 7." },
        { "tipe": "formula_block", "latex": "Q_d = \\dfrac{Q_3 - Q_1}{2} = \\dfrac{7 - 4}{2} = \\dfrac{3}{2} = 1{,}5" },
        { "tipe": "paragraph", "text": "Jadi, simpangan kuartilnya adalah $1{,}5$ atau $\\dfrac{3}{2}$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
