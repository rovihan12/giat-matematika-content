{
  "id": "bs-k11-stat-lanjut-mudah-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "tingkat": "MUDAH",
  "deskripsi": "Median, modus, kuartil pada data tunggal",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data: 5, 3, 8, 6, 4, 7, 9 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Urutkan dulu: 3, 4, 5, 6, 7, 8, 9. Banyak data = 7 (ganjil)." },
        { "tipe": "paragraph", "text": "Median = data ke-4 = 6." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data: 4, 5, 4, 6, 7, 4, 5, 8, 9 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Frekuensi: 4→3, 5→2, 6→1, 7→1, 8→1, 9→1." },
        { "tipe": "paragraph", "text": "Nilai 4 paling sering muncul. Jadi, modus = 4." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari data: 8, 6, 7, 9, 10, 5, 11 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{8+6+7+9+10+5+11}{7} = \\dfrac{56}{7} = 8" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 8." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data: 5, 7, 8, 9, 11, 12. Mediannya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"7,5"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"8,5"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"9,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data = 6 (genap). Median = rata-rata data ke-3 dan ke-4." },
        { "tipe": "formula_block", "latex": "Me = \\dfrac{8+9}{2} = 8{,}5" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil bawah (Q₁) dari data: 4, 5, 6, 7, 8, 9, 10, 11, 12 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"5,5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"6,5"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Data urut, banyak data = 9 (ganjil). Median = data ke-5 = 8." },
        { "tipe": "paragraph", "text": "Q₁ = median dari data di bawah median: 4, 5, 6, 7 → Q₁ = (5+6)/2 = 5,5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil atas (Q₃) dari data: 4, 5, 6, 7, 8, 9, 10, 11, 12 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"9,5"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"10,5"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Median = 8. Q₃ = median data di atas median: 9, 10, 11, 12." },
        { "tipe": "formula_block", "latex": "Q_3 = \\dfrac{10+11}{2} = 10{,}5" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data: 3, 5, 7, 9 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"1,5"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"2,5"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = (3 + 5 + 7 + 9) / 4 = 6." },
        { "tipe": "paragraph", "text": "Simpangan tiap data: |3−6|=3, |5−6|=1, |7−6|=1, |9−6|=3." },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{3+1+1+3}{4} = \\dfrac{8}{4} = 2" },
        { "tipe": "paragraph", "text": "Jadi, simpangan rata-ratanya adalah 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Varians dari data: 1, 3, 5, 7, 9 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = (1+3+5+7+9)/5 = 5." },
        { "tipe": "paragraph", "text": "Kuadrat simpangan: (−4)²=16, (−2)²=4, 0²=0, 2²=4, 4²=16 → jumlah = 40." },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{40}{5} = 8" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan baku dari data: 1, 3, 5, 7, 9 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"√2"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"2√2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"4√2"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Varians S² = 8, maka simpangan baku S = √8 = 2√2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jangkauan dari data: 6, 3, 9, 12, 7, 15, 8 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"15"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Data terbesar = 15, data terkecil = 3." },
        { "tipe": "formula_block", "latex": "R = 15 - 3 = 12" },
        { "tipe": "paragraph", "text": "Jadi, jangkauannya adalah 12." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
