      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = (4 + 8 + 12 + 16) / 4 = 10." },
        { "tipe": "paragraph", "text": "Simpangan tiap data: |4−10|=6, |8−10|=2, |12−10|=2, |16−10|=6." },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{6+2+2+6}{4} = \\dfrac{16}{4} = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-stat-lanjut-mudah-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Varians dari data: 4, 6, 8, 10, 12 adalah ..." }
