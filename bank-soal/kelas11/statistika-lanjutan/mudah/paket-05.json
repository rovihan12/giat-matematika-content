        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = (4 + 6 + 8 + 10 + 12) / 5 = 8." },
        { "tipe": "paragraph", "text": "Kuadrat simpangan tiap data: (−4)²=16, (−2)²=4, 0²=0, 2²=4, 4²=16." },
        { "tipe": "paragraph", "text": "Jumlah kuadrat simpangan = 16 + 4 + 0 + 4 + 16 = 40." },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{40}{5} = 8" }
      ],
      "tingkat": "MUDAH"
    },
    {
