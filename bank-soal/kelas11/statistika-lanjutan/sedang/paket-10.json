      "pilihan": [
        [{"tipe":"paragraph","text":"53,5 kg"}],
        [{"tipe":"paragraph","text":"54,2 kg"}],
        [{"tipe":"paragraph","text":"54,5 kg"}],
        [{"tipe":"paragraph","text":"55,0 kg"}],
        [{"tipe":"paragraph","text":"55,5 kg"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 24$. Letak median = data ke-$\\frac{24}{2} = 12$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 47 - 49 & 1 & 1 \\\\ 50 - 52 & 6 & 7 \\\\ 53 - 55 & 6 & 13 \\\\ 56 - 58 & 7 & 20 \\\\ 59 - 61 & 4 & 24 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-12 berada di kelas 53–55. Tepi bawah $T_b = 52{,}5$; panjang kelas $p = 3$; $F_k = 7$; $f = 6$." },
        { "tipe": "formula_block", "latex": "Me = 52{,}5 + 3 \\left( \\dfrac{12 - 7}{6} \\right) = 52{,}5 + 2{,}5 = 55{,}0" },
        { "tipe": "paragraph", "text": "Jadi, mediannya adalah 55,0 kg." }
      ],
      "tingkat": "SEDANG"
    },
