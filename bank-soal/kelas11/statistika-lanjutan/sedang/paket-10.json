        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai median dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 47 - 49 & 1 \\\\ 50 - 52 & 6 \\\\ 53 - 55 & 6 \\\\ 56 - 58 & 7 \\\\ 59 - 61 & 4 \\\\ \\hline \\end{array}"
