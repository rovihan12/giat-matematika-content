      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sqrt{21} \\text{ kg}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{29} \\text{ kg}$"}],
        [{"tipe":"paragraph","text":"$21 \\text{ kg}$"}],
        [{"tipe":"paragraph","text":"$29 \\text{ kg}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{35} \\text{ kg}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan rata-rata sementara $\\bar{x}_s = 50$ dengan $d_i = x_i - 50$:" },
        { "tipe": "formula_block", "latex": "\\bar{x} = 50 + \\dfrac{\\sum f_i d_i}{\\sum f_i} = 50 + \\dfrac{5(-5) + 12(0) + 9(5) + 4(10)}{30} = 50 + \\dfrac{60}{30} = 52" },
        { "tipe": "paragraph", "text": "Varians dihitung dengan rumus:" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{\\sum f_i d_i^2}{\\sum f_i} - \\left( \\dfrac{\\sum f_i d_i}{\\sum f_i} \\right)^2 = \\dfrac{750}{30} - 2^2 = 25 - 4 = 21" },
        { "tipe": "formula_block", "latex": "S = \\sqrt{21}" },
        { "tipe": "paragraph", "text": "Jadi, simpangan bakunya adalah $\\sqrt{21}$ kg." }
      ],
