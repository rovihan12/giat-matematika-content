        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|c|c|c|} \\hline \\text{Berat (kg)} & f & x & d & d^2 \\\\ \\hline 43 - 47 & 5 & 45 & -5 & 25 \\\\ 48 - 52 & 12 & 50 & 0 & 0 \\\\ 53 - 57 & 9 & 55 & 5 & 25 \\\\ 58 - 62 & 4 & 60 & 10 & 100 \\\\ \\hline \\end{array}"
        }
