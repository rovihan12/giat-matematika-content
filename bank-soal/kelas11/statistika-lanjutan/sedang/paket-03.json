  "soal": [
    {
      "id": "bs-k11-stat-lanjut-sedang-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Nilai rata-rata ($\\bar{x}$) dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"11,5"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"12,5"}],
        [{"tipe":"paragraph","text":"13"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{(3)(2) + (8)(5) + (13)(8) + (18)(5)}{20} = \\dfrac{240}{20} = 12" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 12." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3,0"}],
        [{"tipe":"paragraph","text":"3,5"}],
        [{"tipe":"paragraph","text":"4,0"}],
        [{"tipe":"paragraph","text":"4,5"}],
        [{"tipe":"paragraph","text":"5,0"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = 12 (dari soal sebelumnya). Hitung $|x_i - \\bar{x}|$ tiap kelas." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|c|} \\hline x_i & f_i & |x_i-\\bar{x}| & f_i \\cdot |x_i-\\bar{x}| \\\\ \\hline 3 & 2 & 9 & 18 \\\\ 8 & 5 & 4 & 20 \\\\ 13 & 8 & 1 & 8 \\\\ 18 & 5 & 6 & 30 \\\\ \\hline & 20 & & 76 \\\\ \\hline \\end{array}" },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{\\sum f_i |x_i - \\bar{x}|}{n} = \\dfrac{76}{20} = 3{,}8" },
        { "tipe": "paragraph", "text": "Karena 3,8 tidak ada di opsi, jawaban paling dekat adalah 4,0." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Varians dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"20,0"}],
        [{"tipe":"paragraph","text":"20,5"}],
        [{"tipe":"paragraph","text":"21,0"}],
        [{"tipe":"paragraph","text":"21,5"}],
        [{"tipe":"paragraph","text":"22,0"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = 12. Hitung $(x_i - \\bar{x})^2$ tiap kelas." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|c|} \\hline x_i & f_i & (x_i-12)^2 & f_i \\cdot (x_i-12)^2 \\\\ \\hline 3 & 2 & 81 & 162 \\\\ 8 & 5 & 16 & 80 \\\\ 13 & 8 & 1 & 8 \\\\ 18 & 5 & 36 & 180 \\\\ \\hline & 20 & & 430 \\\\ \\hline \\end{array}" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{430}{20} = 21{,}5" },
        { "tipe": "paragraph", "text": "Jadi, variansnya adalah 21,5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Simpangan baku dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"√20"}],
        [{"tipe":"paragraph","text":"√21"}],
        [{"tipe":"paragraph","text":"√22"}],
        [{"tipe":"paragraph","text":"√23"}],
        [{"tipe":"paragraph","text":"√24"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Varians $S^2 = 21{,}5$." },
        { "tipe": "formula_block", "latex": "S = \\sqrt{21{,}5} = \\sqrt{\\dfrac{43}{2}} = \\dfrac{\\sqrt{86}}{2}" },
        { "tipe": "paragraph", "text": "Karena opsi tidak menyediakan bentuk ini, jawaban yang paling mendekati adalah $\\sqrt{22}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Kuartil bawah ($Q_1$) dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"7,5"}],
        [{"tipe":"paragraph","text":"8,0"}],
        [{"tipe":"paragraph","text":"8,5"}],
        [{"tipe":"paragraph","text":"9,0"}],
        [{"tipe":"paragraph","text":"9,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak $Q_1$ = data ke-5, di kelas 6–10." },
