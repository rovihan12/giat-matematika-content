      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai rata-rata dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 40 - 44 & 1 \\\\ 45 - 49 & 2 \\\\ 50 - 54 & 3 \\\\ 55 - 59 & 6 \\\\ 60 - 64 & 7 \\\\ 65 - 69 & 5 \\\\ 70 - 74 & 7 \\\\ 75 - 79 & 9 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"61"}],
        [{"tipe":"paragraph","text":"62"}],
        [{"tipe":"paragraph","text":"63"}],
        [{"tipe":"paragraph","text":"64"}],
        [{"tipe":"paragraph","text":"65"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan titik tengah tiap kelas:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|c|} \\hline \\text{Nilai} & x_i & f_i & f_i x_i \\\\ \\hline 40 - 44 & 42 & 1 & 42 \\\\ 45 - 49 & 47 & 2 & 94 \\\\ 50 - 54 & 52 & 3 & 156 \\\\ 55 - 59 & 57 & 6 & 342 \\\\ 60 - 64 & 62 & 7 & 434 \\\\ 65 - 69 & 67 & 5 & 335 \\\\ 70 - 74 & 72 & 7 & 504 \\\\ 75 - 79 & 77 & 9 & 693 \\\\ \\hline \\text{Jumlah} & & 40 & 2600 \\\\ \\hline \\end{array}" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{2600}{40} = 65" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 65." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Daftar distribusi frekuensi pada tabel berikut merupakan hasil dari suatu tes. Jika 60% siswa dinyatakan lulus, maka nilai terendah yang dinyatakan lulus adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai Ujian} & \\text{Frekuensi} \\\\ \\hline 11 - 20 & 3 \\\\ 21 - 30 & 7 \\\\ 31 - 40 & 10 \\\\ 41 - 50 & 16 \\\\ 51 - 60 & 20 \\\\ 61 - 70 & 14 \\\\ 71 - 80 & 10 \\\\ 81 - 90 & 6 \\\\ 91 - 100 & 4 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"45,0"}],
        [{"tipe":"paragraph","text":"48,5"}],
        [{"tipe":"paragraph","text":"50,5"}],
        [{"tipe":"paragraph","text":"51,0"}],
        [{"tipe":"paragraph","text":"55,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total frekuensi $n = 3+7+10+16+20+14+10+6+4 = 90$." },
        { "tipe": "paragraph", "text": "60% siswa lulus berarti mencari persentil ke-40 ($P_{40}$)." },
        { "tipe": "paragraph", "text": "Letak $P_{40}$ = data ke-$\\frac{40 \\cdot 90}{100} = 36$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 11 - 20 & 3 & 3 \\\\ 21 - 30 & 7 & 10 \\\\ 31 - 40 & 10 & 20 \\\\ 41 - 50 & 16 & 36 \\\\ 51 - 60 & 20 & 56 \\\\ 61 - 70 & 14 & 70 \\\\ 71 - 80 & 10 & 80 \\\\ 81 - 90 & 6 & 86 \\\\ 91 - 100 & 4 & 90 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-36 berada di kelas 41–50." },
        { "tipe": "paragraph", "text": "Tepi bawah $T_b = 40{,}5$; panjang kelas $p = 10$; $F_k$ sebelum = 20; $f = 16$." },
        { "tipe": "formula_block", "latex": "P_{40} = 40{,}5 + 10 \\left( \\dfrac{36 - 20}{16} \\right) = 40{,}5 + 10(1) = 50{,}5" },
        { "tipe": "paragraph", "text": "Jadi, nilai terendah yang lulus adalah 50,5." }
      ],
      "tingkat": "SEDANG"
    },
