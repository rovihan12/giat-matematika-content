        { "tipe": "formula_block", "latex": "P_{25} = 5{,}5 + 5 \\cdot \\dfrac{5 - 2}{5} = 5{,}5 + 3 = 8{,}5" },
        { "tipe": "paragraph", "text": "Jadi, $P_{25} = 8{,}5$." }
