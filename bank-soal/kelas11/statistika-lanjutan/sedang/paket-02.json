      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak $D_2$ = data ke-$\\frac{2n}{10} = \\frac{40}{10} = 4$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 1-5 & 2 & 2 \\\\ 6-10 & 5 & 7 \\\\ 11-15 & 8 & 15 \\\\ 16-20 & 5 & 20 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-4 ada di kelas yang $F_k \\geq 4$, yaitu kelas **6–10** ($F_k = 7 \\geq 4$)." },
        { "tipe": "paragraph", "text": "Jadi, $D_2$ berada di kelas 6–10." }
