  "soal": [
    {
      "id": "bs-k11-stat-lanjut-sedang-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai median dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Interval} & \\text{Frekuensi} \\\\ \\hline 131 - 140 & 6 \\\\ 141 - 150 & 11 \\\\ 151 - 160 & 10 \\\\ 161 - 170 & 10 \\\\ 171 - 180 & 8 \\\\ 181 - 190 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"158,0"}],
        [{"tipe":"paragraph","text":"158,5"}],
        [{"tipe":"paragraph","text":"159,0"}],
        [{"tipe":"paragraph","text":"159,5"}],
        [{"tipe":"paragraph","text":"160,5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 50$. Letak median = data ke-25." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Interval} & f & F_k \\\\ \\hline 131 - 140 & 6 & 6 \\\\ 141 - 150 & 11 & 17 \\\\ 151 - 160 & 10 & 27 \\\\ 161 - 170 & 10 & 37 \\\\ 171 - 180 & 8 & 45 \\\\ 181 - 190 & 5 & 50 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-25 berada di kelas 151–160. Tepi bawah $T_b = 150{,}5$; panjang kelas $p = 10$; $F_k$ sebelum = 17; $f = 10$." },
        { "tipe": "formula_block", "latex": "Me = 150{,}5 + 10 \\left( \\dfrac{25 - 17}{10} \\right) = 150{,}5 + 8 = 158{,}5" },
        { "tipe": "paragraph", "text": "Jadi, mediannya adalah 158,5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai desil ke-5 ($D_5$) dari data tersebut sama dengan ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Q₁"}],
        [{"tipe":"paragraph","text":"Q₂ (median)"}],
        [{"tipe":"paragraph","text":"Q₃"}],
        [{"tipe":"paragraph","text":"Modus"}],
        [{"tipe":"paragraph","text":"Mean"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Desil ke-5 ($D_5$) membagi data menjadi 10 bagian sama besar, dengan letak = data ke-$\\frac{5n}{10} = \\frac{n}{2}$." },
        { "tipe": "paragraph", "text": "Letak ini sama persis dengan letak median ($Q_2$)." },
        { "tipe": "paragraph", "text": "Jadi, $D_5 = Q_2 = \\text{median}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai desil ke-2 ($D_2$) dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6,0"}],
        [{"tipe":"paragraph","text":"6,5"}],
        [{"tipe":"paragraph","text":"7,0"}],
        [{"tipe":"paragraph","text":"7,5"}],
        [{"tipe":"paragraph","text":"8,0"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak $D_2$ = data ke-$\\frac{2 \\cdot 20}{10} = 4$, yang berada di kelas 6–10." },
        { "tipe": "paragraph", "text": "$T_b = 5{,}5$; $p = 5$; $F_k$ sebelum = 2; $f = 5$." },
        { "tipe": "formula_block", "latex": "D_2 = 5{,}5 + 5 \\cdot \\dfrac{4 - 2}{5} = 5{,}5 + 2 = 7{,}5" },
        { "tipe": "paragraph", "text": "Jadi, $D_2 = 7{,}5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai rata-rata dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 40 - 44 & 1 \\\\ 45 - 49 & 2 \\\\ 50 - 54 & 3 \\\\ 55 - 59 & 6 \\\\ 60 - 64 & 7 \\\\ 65 - 69 & 5 \\\\ 70 - 74 & 7 \\\\ 75 - 79 & 9 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"61"}],
        [{"tipe":"paragraph","text":"62"}],
        [{"tipe":"paragraph","text":"63"}],
        [{"tipe":"paragraph","text":"64"}],
        [{"tipe":"paragraph","text":"65"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik tengah tiap kelas: 42, 47, 52, 57, 62, 67, 72, 77. Total frekuensi $n = 40$." },
        { "tipe": "formula_block", "latex": "\\sum f_i x_i = 1(42) + 2(47) + 3(52) + 6(57) + 7(62) + 5(67) + 7(72) + 9(77) = 2600" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{2600}{40} = 65" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 65." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai modus dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 11 - 20 & 1 \\\\ 21 - 30 & 5 \\\\ 31 - 40 & 6 \\\\ 41 - 50 & 9 \\\\ 51 - 60 & 15 \\\\ 61 - 70 & 7 \\\\ 71 - 80 & 4 \\\\ 81 - 90 & 3 \\\\ 91 - 100 & 1 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"54,78"}],
        [{"tipe":"paragraph","text":"55,56"}],
        [{"tipe":"paragraph","text":"57,32"}],
        [{"tipe":"paragraph","text":"58,46"}],
        [{"tipe":"paragraph","text":"59,84"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus = 51–60 (frekuensi terbesar = 15). Tepi bawah $T_b = 50{,}5$; panjang kelas $p = 10$." },
        { "tipe": "formula_block", "latex": "d_1 = 15 - 9 = 6; \\quad d_2 = 15 - 7 = 8" },
        { "tipe": "formula_block", "latex": "Mo = 50{,}5 + 10 \\left( \\dfrac{6}{6+8} \\right) = 50{,}5 + 4{,}2857 = 54{,}7857 \\approx 54{,}78" },
        { "tipe": "paragraph", "text": "Jadi, modusnya adalah 54,78." }
      ],
      "tingkat": "SEDANG"
    },
    {
