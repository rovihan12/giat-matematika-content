        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 40 - 49 & 4 \\\\ 50 - 59 & 7 \\\\ 60 - 69 & 10 \\\\ 70 - 79 & 6 \\\\ 80 - 89 & 3 \\\\ \\hline \\end{array}"
