      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak $D_8$ = data ke-$\\frac{8n}{10} = \\frac{160}{10} = 16$." },
        { "tipe": "paragraph", "text": "$F_k$ kelas 11–15 = 15 (< 16); $F_k$ kelas 16–20 = 20 (≥ 16). Jadi, $D_8$ ada di kelas **16–20**." },
        { "tipe": "paragraph", "text": "$T_b = 15{,}5$; $p = 5$; $F_k$ sblm = 15; $f = 5$." },
