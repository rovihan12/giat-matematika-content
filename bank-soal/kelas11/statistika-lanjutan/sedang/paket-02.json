      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 20$, sehingga letak median ada di data ke-$\\frac{n}{2}$." },
        { "tipe": "formula_block", "latex": "\\text{Letak median} = \\dfrac{20}{2} = 10" },
        { "tipe": "paragraph", "text": "Jadi, letak mediannya adalah data ke-10." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Median dari data tersebut adalah ..." }
