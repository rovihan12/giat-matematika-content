    {
      "id": "bs-k11-stat-lanjut-sedang-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Desil ke-2 ($D_2$) dari data tersebut berada di kelas ..." }
