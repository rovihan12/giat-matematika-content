      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak median = data ke-10, ada di kelas 11–15." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 1-5 & 2 & 2 \\\\ 6-10 & 5 & 7 \\\\ 11-15 & 8 & 15 \\\\ 16-20 & 5 & 20 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "$T_b = 10{,}5$; $p = 5$; $F_k$ sblm = 7; $f = 8$." },
        { "tipe": "formula_block", "latex": "Me = 10{,}5 + 5 \\cdot \\dfrac{10 - 7}{8} = 10{,}5 + 5 \\cdot \\dfrac{3}{8} = 10{,}5 + 1{,}875 = 12{,}375" },
        { "tipe": "paragraph", "text": "Jadi, mediannya adalah 12,375." }
      ],
      "tingkat": "SEDANG"
    },
    {
