      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak $D_2$ = data ke-4, di kelas 6–10." },
        { "tipe": "paragraph", "text": "$T_b = 5{,}5$; $p = 5$; $F_k$ sblm = 2; $f = 5$." },
        { "tipe": "formula_block", "latex": "D_2 = 5{,}5 + 5 \\cdot \\dfrac{4 - 2}{5} = 5{,}5 + 5 \\cdot \\dfrac{2}{5} = 5{,}5 + 2 = 7{,}5" },
        { "tipe": "paragraph", "text": "Jadi, $D_2 = 7{,}5$." }
