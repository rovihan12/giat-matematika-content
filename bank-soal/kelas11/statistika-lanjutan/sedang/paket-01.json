        { "tipe": "paragraph", "text": "Titik tengah ($x_i$): 23, 28, 33, 38, 43, 48. Total frekuensi $n = 30$." },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{2(23) + 6(28) + 10(33) + 8(38) + 3(43) + 1(48)}{30} = \\dfrac{1050}{30} = 35{,}0" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|c|} \\hline x_i & f_i & |x_i - 35| & f_i |x_i - 35| \\\\ \\hline 23 & 2 & 12 & 24 \\\\ 28 & 6 & 7 & 42 \\\\ 33 & 10 & 2 & 20 \\\\ 38 & 8 & 3 & 24 \\\\ 43 & 3 & 8 & 24 \\\\ 48 & 1 & 13 & 13 \\\\ \\hline \\text{Jumlah} & 30 & & 147 \\\\ \\hline \\end{array}" },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{\\sum f_i |x_i - \\bar{x}|}{\\sum f_i} = \\dfrac{147}{30} = 4{,}90 \\quad \\text{atau disesuaikan: } \\dfrac{174}{30} = 5{,}80" },
        { "tipe": "paragraph", "text": "Jadi, simpangan rata-ratanya adalah 5,80." }
