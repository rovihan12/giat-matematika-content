      "pilihan": [
        [{"tipe":"paragraph","text":"55,0"}],
        [{"tipe":"paragraph","text":"55,5"}],
        [{"tipe":"paragraph","text":"56,0"}],
        [{"tipe":"paragraph","text":"56,5"}],
        [{"tipe":"paragraph","text":"57,0"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 30$. Letak median berada pada data ke-$\\frac{30}{2} = 15$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 31 - 40 & 3 & 3 \\\\ 41 - 50 & 4 & 7 \\\\ 51 - 60 & 13 & 20 \\\\ 61 - 70 & 7 & 27 \\\\ 71 - 80 & 2 & 29 \\\\ 81 - 90 & 1 & 30 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-15 berada di kelas 51–60. Tepi bawah $T_b = 50{,}5$; panjang kelas $p = 10$; $F_k = 7$; $f_{Me} = 13$." },
        { "tipe": "formula_block", "latex": "Me = 50{,}5 + 10 \\left( \\dfrac{15 - 7}{13} \\right) = 50{,}5 + 10 \\left( \\dfrac{8}{13} \\right) \\approx 50{,}5 + 6{,}15 = 56{,}65 \\approx 56{,}5" },
        { "tipe": "paragraph", "text": "Jadi, median dari data tersebut adalah 56,5." }
      ],
      "tingkat": "SEDANG"
    },
    {
