  "soal": [
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai rata-rata dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 51 - 55 & 1 \\\\ 56 - 60 & 2 \\\\ 61 - 65 & 4 \\\\ 66 - 70 & 6 \\\\ 71 - 75 & 12 \\\\ 76 - 80 & 14 \\\\ 81 - 85 & 8 \\\\ 86 - 90 & 2 \\\\ 91 - 95 & 1 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"74,5"}],
        [{"tipe":"paragraph","text":"75,0"}],
        [{"tipe":"paragraph","text":"75,5"}],
        [{"tipe":"paragraph","text":"76,0"}],
        [{"tipe":"paragraph","text":"76,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan titik tengah ($x_i$) tiap kelas untuk menghitung rata-rata:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|c|} \\hline \\text{Nilai} & x_i & f_i & f_i x_i \\\\ \\hline 51 - 55 & 53 & 1 & 53 \\\\ 56 - 60 & 58 & 2 & 116 \\\\ 61 - 65 & 63 & 4 & 252 \\\\ 66 - 70 & 68 & 6 & 408 \\\\ 71 - 75 & 73 & 12 & 876 \\\\ 76 - 80 & 78 & 14 & 1092 \\\\ 81 - 85 & 83 & 8 & 664 \\\\ 86 - 90 & 88 & 2 & 176 \\\\ 91 - 95 & 93 & 1 & 93 \\\\ \\hline \\text{Jumlah} & & 50 & 3775 \\\\ \\hline \\end{array}" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{\\sum f_i x_i}{\\sum f_i} = \\dfrac{3775}{50} = 75{,}5" },
        { "tipe": "paragraph", "text": "Jadi, nilai rata-rata dari data tersebut adalah 75,5." }
      ],
      "tingkat": "SEDANG"
    },
    {
