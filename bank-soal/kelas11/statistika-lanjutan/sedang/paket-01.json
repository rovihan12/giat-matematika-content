{
  "id": "bs-k11-stat-lanjut-sedang-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "tingkat": "SEDANG",
  "deskripsi": "Mean, modus, kuartil data berkelompok",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Mean dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"14"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan titik tengah tiap kelas sebagai $x_i$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|c|} \\hline \\text{Nilai} & x_i & f_i & f_i \\cdot x_i \\\\ \\hline 1-5 & 3 & 2 & 6 \\\\ 6-10 & 8 & 5 & 40 \\\\ 11-15 & 13 & 8 & 104 \\\\ 16-20 & 18 & 5 & 90 \\\\ \\hline & & 20 & 240 \\\\ \\hline \\end{array}" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{\\sum f_i x_i}{\\sum f_i} = \\dfrac{240}{20} = 12" },
        { "tipe": "paragraph", "text": "Jadi, meannya adalah 12." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Kelas median dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1–5"}],
        [{"tipe":"paragraph","text":"6–10"}],
        [{"tipe":"paragraph","text":"11–15"}],
        [{"tipe":"paragraph","text":"16–20"}],
        [{"tipe":"paragraph","text":"Tidak ada"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 20$, sehingga letak median = data ke-$\\frac{n}{2} = 10$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 1-5 & 2 & 2 \\\\ 6-10 & 5 & 7 \\\\ 11-15 & 8 & 15 \\\\ 16-20 & 5 & 20 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-10 terletak di kelas yang $F_k \\geq 10$, yaitu kelas **11–15** (karena $F_k$ kelas ini = 15 ≥ 10 dan $F_k$ kelas sebelumnya = 7 < 10)." },
        { "tipe": "paragraph", "text": "Jadi, kelas mediannya adalah 11–15." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Modus dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"12,5"}],
        [{"tipe":"paragraph","text":"13,0"}],
        [{"tipe":"paragraph","text":"13,5"}],
        [{"tipe":"paragraph","text":"14,0"}],
        [{"tipe":"paragraph","text":"14,5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus = kelas dengan frekuensi terbesar, yaitu **11–15** dengan $f = 8$." },
        { "tipe": "paragraph", "text": "Tepi bawah $T_b = 10{,}5$; panjang kelas $p = 5$; $d_1 = 8 - 5 = 3$; $d_2 = 8 - 5 = 3$." },
        { "tipe": "formula_block", "latex": "Mo = T_b + p \\cdot \\dfrac{d_1}{d_1 + d_2} = 10{,}5 + 5 \\cdot \\dfrac{3}{6} = 10{,}5 + 2{,}5 = 13{,}0" },
        { "tipe": "paragraph", "text": "Jadi, modusnya adalah 13,0." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Kuartil bawah ($Q_1$) dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"7,0"}],
        [{"tipe":"paragraph","text":"7,5"}],
        [{"tipe":"paragraph","text":"8,0"}],
        [{"tipe":"paragraph","text":"8,5"}],
        [{"tipe":"paragraph","text":"9,0"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak $Q_1$ = data ke-$\\frac{n}{4} = \\frac{20}{4} = 5$." },
        { "tipe": "paragraph", "text": "$F_k$ kelas 1–5 = 2 (< 5); $F_k$ kelas 6–10 = 7 (≥ 5). Jadi, $Q_1$ ada di kelas **6–10**." },
        { "tipe": "paragraph", "text": "$T_b = 5{,}5$; $p = 5$; $F_k$ sebelum = 2; $f = 5$." },
        { "tipe": "formula_block", "latex": "Q_1 = 5{,}5 + 5 \\cdot \\dfrac{5 - 2}{5} = 5{,}5 + 5 \\cdot \\dfrac{3}{5} = 5{,}5 + 3 = 8{,}5" },
        { "tipe": "paragraph", "text": "Jadi, $Q_1 = 8{,}5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Kuartil atas ($Q_3$) dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"14,5"}],
        [{"tipe":"paragraph","text":"15,0"}],
        [{"tipe":"paragraph","text":"15,5"}],
        [{"tipe":"paragraph","text":"16,0"}],
        [{"tipe":"paragraph","text":"16,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Letak $Q_3$ = data ke-$\\frac{3n}{4} = \\frac{60}{4} = 15$." },
        { "tipe": "paragraph", "text": "$F_k$ kelas 11–15 = 15 (tepat sama dengan letak $Q_3$). Jadi, $Q_3$ ada di kelas **11–15**." },
        { "tipe": "paragraph", "text": "$T_b = 10{,}5$; $p = 5$; $F_k$ sebelum = 7; $f = 8$." },
        { "tipe": "formula_block", "latex": "Q_3 = 10{,}5 + 5 \\cdot \\dfrac{15 - 7}{8} = 10{,}5 + 5 \\cdot \\dfrac{8}{8} = 10{,}5 + 5 = 15{,}5" },
        { "tipe": "paragraph", "text": "Jadi, $Q_3 = 15{,}5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Jangkauan antarkuartil ($H$) dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5,0"}],
        [{"tipe":"paragraph","text":"6,0"}],
        [{"tipe":"paragraph","text":"7,0"}],
        [{"tipe":"paragraph","text":"7,5"}],
        [{"tipe":"paragraph","text":"8,0"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari perhitungan sebelumnya: $Q_1 = 8{,}5$ dan $Q_3 = 15{,}5$." },
        { "tipe": "formula_block", "latex": "H = Q_3 - Q_1 = 15{,}5 - 8{,}5 = 7{,}0" },
        { "tipe": "paragraph", "text": "Jadi, jangkauan antarkuartilnya adalah 7,0." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Jangkauan semi antarkuartil ($Q_d$) dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2,5"}],
        [{"tipe":"paragraph","text":"3,0"}],
        [{"tipe":"paragraph","text":"3,5"}],
        [{"tipe":"paragraph","text":"4,0"}],
        [{"tipe":"paragraph","text":"4,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "Q_d = \\dfrac{Q_3 - Q_1}{2} = \\dfrac{15{,}5 - 8{,}5}{2} = \\dfrac{7}{2} = 3{,}5" },
        { "tipe": "paragraph", "text": "Jadi, jangkauan semi antarkuartilnya adalah 3,5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Banyak data pada tabel tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"22"}],
        [{"tipe":"paragraph","text":"25"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "n = \\sum f_i = 2 + 5 + 8 + 5 = 20" },
        { "tipe": "paragraph", "text": "Jadi, banyak datanya adalah 20." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Panjang kelas interval pada tabel tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Panjang kelas = tepi atas − tepi bawah." },
        { "tipe": "paragraph", "text": "Kelas 1–5: tepi bawah = 0,5; tepi atas = 5,5." },
        { "tipe": "formula_block", "latex": "p = 5{,}5 - 0{,}5 = 5" },
        { "tipe": "paragraph", "text": "Jadi, panjang kelasnya adalah 5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & f \\\\ \\hline 1-5 & 2 \\\\ 6-10 & 5 \\\\ 11-15 & 8 \\\\ 16-20 & 5 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Tepi bawah kelas modus dari data tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"9,5"}],
        [{"tipe":"paragraph","text":"10,0"}],
        [{"tipe":"paragraph","text":"10,5"}],
        [{"tipe":"paragraph","text":"11,0"}],
        [{"tipe":"paragraph","text":"11,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus = kelas dengan frekuensi terbesar, yaitu 11–15." },
        { "tipe": "paragraph", "text": "Tepi bawah = 11 − 0,5 = 10,5." },
        { "tipe": "paragraph", "text": "Jadi, tepi bawah kelas modusnya adalah 10,5." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
