        { "tipe": "formula_block", "latex": "d_1 = 12 - 5 = 7; \\quad d_2 = 12 - 5 = 7" },
        { "tipe": "formula_block", "latex": "Mo = 14{,}5 + 5 \\left( \\dfrac{7}{7+7} \\right) = 14{,}5 + 2{,}5 = 17{,}0" },
