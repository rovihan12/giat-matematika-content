      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai persentil ke-64 ($P_{64}$) dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Skor} & \\text{Frekuensi} \\\\ \\hline 31 - 40 & 3 \\\\ 41 - 50 & 4 \\\\ 51 - 60 & 13 \\\\ 61 - 70 & 7 \\\\ 71 - 80 & 2 \\\\ 81 - 90 & 1 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"59,0"}],
        [{"tipe":"paragraph","text":"59,5"}],
        [{"tipe":"paragraph","text":"60,0"}],
        [{"tipe":"paragraph","text":"60,5"}],
        [{"tipe":"paragraph","text":"61,0"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 30$. Letak $P_{64}$ = data ke-$\\frac{64 \\cdot 30}{100} = 19{,}2$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Skor} & f & F_k \\\\ \\hline 31 - 40 & 3 & 3 \\\\ 41 - 50 & 4 & 7 \\\\ 51 - 60 & 13 & 20 \\\\ 61 - 70 & 7 & 27 \\\\ 71 - 80 & 2 & 29 \\\\ 81 - 90 & 1 & 30 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-19,2 berada di kelas 51–60. Tepi bawah $T_b = 50{,}5$; panjang kelas $p = 10$; $F_k$ sebelum = 7; $f = 13$." },
        { "tipe": "formula_block", "latex": "P_{64} = 50{,}5 + 10 \\left( \\dfrac{19{,}2 - 7}{13} \\right) = 50{,}5 + 10 \\left( \\dfrac{12{,}2}{13} \\right) = 50{,}5 + 9{,}385 = 59{,}885 \\approx 60{,}0" },
        { "tipe": "paragraph", "text": "Jadi, persentil ke-64 adalah sekitar 60,0." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Mean dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 1 - 5 & 2 \\\\ 6 - 10 & 5 \\\\ 11 - 15 & 8 \\\\ 16 - 20 & 5 \\\\ \\hline \\end{array}"
