      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus = 18–21 (frekuensi terbesar = 36). Tepi bawah $T_b = 17{,}5$; panjang kelas $p = 4$." },
        { "tipe": "formula_block", "latex": "d_1 = 36 - 27 = 9; \\quad d_2 = 36 - 25 = 11" },
        { "tipe": "formula_block", "latex": "Mo = 17{,}5 + 4 \\left( \\dfrac{9}{9+11} \\right) = 17{,}5 + 4 \\left( \\dfrac{9}{20} \\right) = 17{,}5 + 1{,}8 = 19{,}3" },
        { "tipe": "paragraph", "text": "Jadi, modusnya adalah 19,3 bulan." }
