  "soal": [
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai rata-rata dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 40 - 44 & 1 \\\\ 45 - 49 & 2 \\\\ 50 - 54 & 3 \\\\ 55 - 59 & 6 \\\\ 60 - 64 & 7 \\\\ 65 - 69 & 5 \\\\ 70 - 74 & 7 \\\\ 75 - 79 & 9 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"61"}],
        [{"tipe":"paragraph","text":"62"}],
        [{"tipe":"paragraph","text":"63"}],
        [{"tipe":"paragraph","text":"64"}],
        [{"tipe":"paragraph","text":"65"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik tengah tiap kelas: 42, 47, 52, 57, 62, 67, 72, 77. Total frekuensi $n = 40$." },
        { "tipe": "formula_block", "latex": "\\sum f_i x_i = 1(42) + 2(47) + 3(52) + 6(57) + 7(62) + 5(67) + 7(72) + 9(77)" },
        { "tipe": "formula_block", "latex": "= 42 + 94 + 156 + 342 + 434 + 335 + 504 + 693 = 2600" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{2600}{40} = 65" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 65." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data pada tabel berikut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Interval} & \\text{Frekuensi} \\\\ \\hline 131 - 140 & 6 \\\\ 141 - 150 & 11 \\\\ 151 - 160 & 8 \\\\ 161 - 170 & 12 \\\\ 171 - 180 & 8 \\\\ 181 - 190 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"158,0"}],
        [{"tipe":"paragraph","text":"158,5"}],
        [{"tipe":"paragraph","text":"159,0"}],
        [{"tipe":"paragraph","text":"159,5"}],
        [{"tipe":"paragraph","text":"160,5"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 50$. Letak median = data ke-25." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Interval} & f & F_k \\\\ \\hline 131 - 140 & 6 & 6 \\\\ 141 - 150 & 11 & 17 \\\\ 151 - 160 & 8 & 25 \\\\ 161 - 170 & 12 & 37 \\\\ 171 - 180 & 8 & 45 \\\\ 181 - 190 & 5 & 50 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-25 berada di kelas 151–160. Tepi bawah $T_b = 150{,}5$; panjang kelas $p = 10$; $F_k$ sebelum = 17; $f = 8$." },
        { "tipe": "formula_block", "latex": "Me = 150{,}5 + 10 \\left( \\dfrac{25 - 17}{8} \\right) = 150{,}5 + 10 = 160{,}5" },
        { "tipe": "paragraph", "text": "Jadi, mediannya adalah 160,5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data berikut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Data} & \\text{Frekuensi} \\\\ \\hline 5 - 9 & 4 \\\\ 10 - 14 & 5 \\\\ 15 - 19 & 12 \\\\ 20 - 24 & 5 \\\\ 25 - 29 & 3 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"17,0"}],
        [{"tipe":"paragraph","text":"16,5"}],
        [{"tipe":"paragraph","text":"16,0"}],
        [{"tipe":"paragraph","text":"15,5"}],
        [{"tipe":"paragraph","text":"15,0"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus = 15–19 (frekuensi terbesar = 12). Tepi bawah $T_b = 14{,}5$; panjang kelas $p = 5$." },
        { "tipe": "formula_block", "latex": "d_1 = 12 - 5 = 7; \\quad d_2 = 12 - 5 = 7" },
        { "tipe": "formula_block", "latex": "Mo = 14{,}5 + 5 \\left( \\dfrac{7}{7+7} \\right) = 14{,}5 + 2{,}5 = 17{,}0" },
        { "tipe": "paragraph", "text": "Jadi, modusnya adalah 17,0." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan daftar distribusi frekuensi pada tabel berikut. Modus dari data di atas adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 11 - 20 & 1 \\\\ 21 - 30 & 5 \\\\ 31 - 40 & 6 \\\\ 41 - 50 & 9 \\\\ 51 - 60 & 15 \\\\ 61 - 70 & 7 \\\\ 71 - 80 & 4 \\\\ 81 - 90 & 3 \\\\ 91 - 100 & 1 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"54,78"}],
        [{"tipe":"paragraph","text":"55,56"}],
        [{"tipe":"paragraph","text":"57,32"}],
        [{"tipe":"paragraph","text":"58,46"}],
        [{"tipe":"paragraph","text":"59,84"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus = 51–60 (frekuensi terbesar = 15). Tepi bawah $T_b = 50{,}5$; panjang kelas $p = 10$." },
        { "tipe": "formula_block", "latex": "d_1 = 15 - 9 = 6; \\quad d_2 = 15 - 7 = 8" },
        { "tipe": "formula_block", "latex": "Mo = 50{,}5 + 10 \\left( \\dfrac{6}{6+8} \\right) = 50{,}5 + 10 \\left( \\dfrac{6}{14} \\right) = 50{,}5 + 4{,}2857 = 54{,}7857 \\approx 54{,}78" },
        { "tipe": "paragraph", "text": "Jadi, modusnya adalah 54,78." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai $n - \\sum f_i$ jika $n$ adalah banyak data adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 40 - 49 & 5 \\\\ 50 - 59 & 10 \\\\ 60 - 69 & 15 \\\\ 70 - 79 & 12 \\\\ 80 - 89 & 8 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"20"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n = \\sum f_i = 5 + 10 + 15 + 12 + 8 = 50$." },
        { "tipe": "formula_block", "latex": "n - \\sum f_i = 50 - 50 = 0" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya 0." }
      ],
      "tingkat": "SEDANG"
    },
    {
