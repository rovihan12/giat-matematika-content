      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Modus data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Usia bayi (bulan)} & \\text{Frekuensi} \\\\ \\hline 10 - 13 & 14 \\\\ 14 - 17 & 27 \\\\ 18 - 21 & 36 \\\\ 22 - 25 & 25 \\\\ 26 - 29 & 18 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"19,3 bulan"}],
