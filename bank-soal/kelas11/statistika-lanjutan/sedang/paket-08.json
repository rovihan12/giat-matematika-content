        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 41 - 45 & 3 \\\\ 46 - 50 & 6 \\\\ 51 - 55 & 10 \\\\ 56 - 60 & 12 \\\\ 61 - 65 & 5 \\\\ 66 - 70 & 4 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"60,0"}],
        [{"tipe":"paragraph","text":"60,5"}],
        [{"tipe":"paragraph","text":"61,0"}],
        [{"tipe":"paragraph","text":"61,5"}],
        [{"tipe":"paragraph","text":"62,0"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 40$. Letak $D_8$ = data ke-$\\frac{8 \\cdot 40}{10} = 32$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 41 - 45 & 3 & 3 \\\\ 46 - 50 & 6 & 9 \\\\ 51 - 55 & 10 & 19 \\\\ 56 - 60 & 12 & 31 \\\\ 61 - 65 & 5 & 36 \\\\ 66 - 70 & 4 & 40 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-32 berada di kelas 61–65. Tepi bawah $T_b = 60{,}5$; panjang kelas $p = 5$; $F_k$ sebelum = 31; $f = 5$." },
        { "tipe": "formula_block", "latex": "D_8 = 60{,}5 + 5 \\left( \\dfrac{32 - 31}{5} \\right) = 60{,}5 + 1 = 61{,}5" },
        { "tipe": "paragraph", "text": "Jadi, desil ke-8 adalah 61,5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai kuartil bawah ($Q_1$) dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 30 - 39 & 3 \\\\ 40 - 49 & 6 \\\\ 50 - 59 & 10 \\\\ 60 - 69 & 10 \\\\ 70 - 79 & 7 \\\\ 80 - 89 & 4 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"50,5"}],
        [{"tipe":"paragraph","text":"51,0"}],
        [{"tipe":"paragraph","text":"51,5"}],
        [{"tipe":"paragraph","text":"52,0"}],
        [{"tipe":"paragraph","text":"52,5"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 40$. Letak $Q_1$ = data ke-$\\frac{40}{4} = 10$." },
        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 30 - 39 & 3 & 3 \\\\ 40 - 49 & 6 & 9 \\\\ 50 - 59 & 10 & 19 \\\\ 60 - 69 & 10 & 29 \\\\ 70 - 79 & 7 & 36 \\\\ 80 - 89 & 4 & 40 \\\\ \\hline \\end{array}" },
        { "tipe": "paragraph", "text": "Data ke-10 berada di kelas 50–59. Tepi bawah $T_b = 49{,}5$; panjang kelas $p = 10$; $F_k$ sebelum = 9; $f = 10$." },
        { "tipe": "formula_block", "latex": "Q_1 = 49{,}5 + 10 \\left( \\dfrac{10 - 9}{10} \\right) = 49{,}5 + 1 = 50{,}5" },
        { "tipe": "paragraph", "text": "Jadi, kuartil bawahnya adalah 50,5." }
