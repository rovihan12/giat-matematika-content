        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{2(3) + 5(8) + 8(13) + 5(18)}{20} = \\dfrac{6 + 40 + 104 + 90}{20} = \\dfrac{240}{20} = 12" },
        { "tipe": "paragraph", "text": "Jadi, meannya adalah 12." }
