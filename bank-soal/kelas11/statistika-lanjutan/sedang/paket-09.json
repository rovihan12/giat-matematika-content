{
  "id": "bs-k11-stat-lanjut-sedang-09",
  "nama": "Bank Soal Sedang - Paket 9",
  "kelas": 11,
  "kategori": "Statistika Lanjutan",
  "tingkat": "SEDANG",
  "deskripsi": "Interpretasi statistik, median, dan kuartil data",
  "versi": "2.0.0",
  "soal": [
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui data berikut: 60, 47, 82, 95, 88, 97, 70, 64, 70, 70, 72, 67, 66, 68, 98, 58, 78, 89, 44, 55, 90, 77, 86, 58, 64, 85, 82, 83, 72, 77, 95, 74, 72, 88, 74, 72, 86, 50, 94, 92, 77, 39, 90, 63, 68, 80, 91, 75, 76, 78. Jika data tersebut dibuat tabel distribusi frekuensi berkelompok dengan aturan Sturgess, maka banyaknya kelas adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak data $n = 50$." },
        { "tipe": "paragraph", "text": "Aturan Sturgess: $k = 1 + 3{,}3 \\log n$." },
        { "tipe": "formula_block", "latex": "k = 1 + 3{,}3 \\log 50 = 1 + 3{,}3(1{,}699) = 1 + 5{,}607 = 6{,}607 \\approx 7" },
        { "tipe": "paragraph", "text": "Jadi, banyaknya kelas adalah 7." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data: 12, 15, 18, 20, 25, 30 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"19"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"21"}],
        [{"tipe":"paragraph","text":"22"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n = 6$ (genap). Median = rata-rata data ke-3 dan ke-4." },
        { "tipe": "formula_block", "latex": "Me = \\dfrac{18 + 20}{2} = 19" },
        { "tipe": "paragraph", "text": "Jadi, mediannya adalah 19." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari data: 5, 7, 8, 10, 12, 18 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"13"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{5+7+8+10+12+18}{6} = \\dfrac{60}{6} = 10" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 10." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data: 4, 6, 8, 10, 12. Jika data ke-3 dinaikkan menjadi 20, rata-ratanya menjadi ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"10,4"}],
        [{"tipe":"paragraph","text":"12"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Data baru: 4, 6, 20, 10, 12 → jumlah = 52." },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{baru}} = \\dfrac{52}{5} = 10{,}4" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya menjadi 10,4." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data tunggal: 5, 5, 6, 7, 7, 7, 8, 9. Nilai modus dan median data tersebut berturut-turut adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5 dan 7"}],
        [{"tipe":"paragraph","text":"7 dan 7"}],
        [{"tipe":"paragraph","text":"7 dan 6,5"}],
        [{"tipe":"paragraph","text":"7 dan 7,5"}],
        [{"tipe":"paragraph","text":"5 dan 6,5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Modus = nilai paling sering = 7 (muncul 3×)." },
        { "tipe": "paragraph", "text": "$n = 8$ (genap). Median = rata-rata data ke-4 dan ke-5 = $(7 + 7)/2 = 7$." },
        { "tipe": "paragraph", "text": "Jadi, modus = 7 dan median = 7." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data: 6, 8, 10, 12 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"1,5"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"2,5"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rata-rata = $(6+8+10+12)/4 = 9$." },
        { "tipe": "paragraph", "text": "Simpangan: 3, 1, 1, 3 → jumlah = 8." },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{8}{4} = 2" },
        { "tipe": "paragraph", "text": "Jadi, simpangan rata-ratanya adalah 2." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data: 10, 12, 15, 18, 20, 25. Nilai jangkauan antarkuartilnya adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi dua: bawah = 10, 12, 15 → $Q_1 = 12$; atas = 18, 20, 25 → $Q_3 = 20$." },
        { "tipe": "formula_block", "latex": "H = Q_3 - Q_1 = 20 - 12 = 8" },
        { "tipe": "paragraph", "text": "Jadi, jangkauan antarkuartilnya adalah 8." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari data: 4, 6, 8, 10, 12, 14 adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{4+6+8+10+12+14}{6} = \\dfrac{54}{6} = 9" },
        { "tipe": "paragraph", "text": "Jadi, rata-ratanya adalah 9." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu data berdistribusi menceng ke kanan (positif). Manakah urutan yang paling mungkin?" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"modus < median < rata-rata"}],
        [{"tipe":"paragraph","text":"rata-rata < median < modus"}],
        [{"tipe":"paragraph","text":"median < rata-rata < modus"}],
        [{"tipe":"paragraph","text":"median < modus < rata-rata"}],
        [{"tipe":"paragraph","text":"rata-rata = median = modus"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Distribusi menceng ke kanan: ekor di kanan panjang, sehingga modus < median < rata-rata." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata 20 siswa adalah 75. Jika 5 siswa dengan rata-rata 60 ditambahkan, rata-rata baru adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"70"}],
        [{"tipe":"paragraph","text":"71"}],
        [{"tipe":"paragraph","text":"72"}],
        [{"tipe":"paragraph","text":"73"}],
        [{"tipe":"paragraph","text":"74"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total 20 siswa = $20 \\times 75 = 1500$." },
        { "tipe": "paragraph", "text": "Total 5 siswa baru = $5 \\times 60 = 300$." },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{baru}} = \\dfrac{1500 + 300}{25} = \\dfrac{1800}{25} = 72" },
        { "tipe": "paragraph", "text": "Jadi, rata-rata barunya 72." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
