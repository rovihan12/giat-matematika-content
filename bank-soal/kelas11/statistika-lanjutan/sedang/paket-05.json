        [{"tipe":"paragraph","text":"35,5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelas modus = 31–35 (frekuensi terbesar = 10)." },
        { "tipe": "paragraph", "text": "Tepi bawah $T_b = 31 - 0{,}5 = 30{,}5$." }
