        { "tipe": "formula_block", "latex": "x_4 = \\dfrac{36 + 40}{2} = 38" },
        { "tipe": "paragraph", "text": "Jadi, titik tengah kelas keempat adalah 38." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-stat-lanjut-sedang-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Rata-rata data tersebut adalah 31,4. Jika setiap nilai dikurangi 1,5, rata-ratanya menjadi ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 21 - 25 & 3 \\\\ 26 - 30 & 7 \\\\ 31 - 35 & 10 \\\\ 36 - 40 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"28,9"}],
        [{"tipe":"paragraph","text":"29,4"}],
        [{"tipe":"paragraph","text":"29,9"}],
        [{"tipe":"paragraph","text":"30,4"}],
        [{"tipe":"paragraph","text":"30,9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika setiap nilai dikurangi $k$, maka rata-rata juga akan berkurang sebesar $k$." },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{baru}} = 31{,}4 - 1{,}5 = 29{,}9" },
        { "tipe": "paragraph", "text": "Jadi, rata-rata baru setelah dikurangi 1,5 adalah 29,9." }
      ],
      "tingkat": "SEDANG"
    }
  ]
