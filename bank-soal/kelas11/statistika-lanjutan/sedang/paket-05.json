        { "tipe": "formula_block", "latex": "\\begin{array}{|c|c|c|} \\hline \\text{Nilai} & f & F_k \\\\ \\hline 21-25 & 3 & 3 \\\\ 26-30 & 7 & 10 \\\\ 31-35 & 10 & 20 \\\\ 36-40 & 5 & 25 \\\\ \\hline \\end{array}" },
