      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Titik tengah kelas keempat dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 21 - 25 & 3 \\\\ 26 - 30 & 7 \\\\ 31 - 35 & 10 \\\\ 36 - 40 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
