    {
      "id": "bs-k11-stat-lanjut-sedang-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Frekuensi kumulatif sampai kelas ketiga dari data tersebut adalah ...." },
        {
          "tipe": "formula_block",
          "latex": "\\begin{array}{|c|c|} \\hline \\text{Nilai} & \\text{Frekuensi} \\\\ \\hline 21 - 25 & 3 \\\\ 26 - 30 & 7 \\\\ 31 - 35 & 10 \\\\ 36 - 40 & 5 \\\\ \\hline \\end{array}"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"10"}],
