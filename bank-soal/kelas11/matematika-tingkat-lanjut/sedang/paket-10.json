  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Matriks, vektor, & teorema sisa",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2 & 1 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 1 & 2 \\\\ 2 & 1 \\end{pmatrix}$. Hasil $A + B$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 5 & 5 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 4 & 5 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 5 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -1 \\\\ 1 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 2 \\\\ 6 & 4 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A + B = \\begin{pmatrix} 2+1 & 1+2 \\\\ 3+2 & 4+1 \\end{pmatrix} = \\begin{pmatrix} 3 & 3 \\\\ 5 & 5 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari matriks $\\begin{pmatrix} 5 & -2 \\\\ 3 & 4 \\end{pmatrix}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"26"}],
        [{"tipe":"paragraph","text":"32"}],
        [{"tipe":"paragraph","text":"-26"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det = (5)(4) - (-2)(3) = 20 + 6 = 26" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - x^2 + 4x - 4$, maka $P(2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 8 - 4 + 8 - 4 = 8" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - x^2 + 4x - 4$, maka $P(1)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 - 1 + 4 - 4 = 0" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2 & 1 \\\\ 1 & 3 \\end{pmatrix}$. Nilai $\\det(A)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det(A) = (2)(3) - (1)(1) = 6 - 1 = 5" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - 3x^2 + 4x - 2$ dibagi $(x - 1)$, sisanya adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 - 3 + 4 - 2 = 0" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar dari $P(x) = x^3 - 2x^2 - 5x + 6$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1, -2, 3"}],
        [{"tipe":"paragraph","text":"-1, 2, 3"}],
        [{"tipe":"paragraph","text":"1, 2, -3"}],
        [{"tipe":"paragraph","text":"1, 2, 3"}],
        [{"tipe":"paragraph","text":"-1, -2, -3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 1$: $P(1) = 1 - 2 - 5 + 6 = 0$ → $(x-1)$ faktor." },
        { "tipe": "paragraph", "text": "Bagi: hasil = $x^2 - x - 6 = (x-3)(x+2)$." },
        { "tipe": "formula_block", "latex": "P(x) = (x-1)(x-3)(x+2)" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^2 + 3x - 1)(x - 2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 + x^2 - 7x + 2$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 - 7x - 2$"}],
        [{"tipe":"paragraph","text":"$x^3 - x^2 + 7x + 2$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 + 7x + 2$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 - 5x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x^2 + 3x - 1)(x-2) = x^3 - 2x^2 + 3x^2 - 6x - x + 2 = x^3 + x^2 - 7x + 2" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 2 & 3 \\\\ 1 & 4 \\end{pmatrix}$, maka $A^T$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 1 \\\\ 3 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 3 \\\\ 1 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 2 \\\\ 4 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 3 \\\\ 1 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 4 \\\\ 2 & 3 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A^T = \\begin{pmatrix} 2 & 1 \\\\ 3 & 4 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^4 - 2x^3 + x^2 - 1$ oleh $(x - 2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 16 - 16 + 4 - 1 = 3" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
