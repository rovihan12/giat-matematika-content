{
  "id": "bs-k11-mat-lanjut-sedang-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Pembagian sintetik & teorema sisa",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil bagi dan sisa pembagian $P(x) = x^3 - 4x^2 + 5x - 2$ oleh $(x - 1)$ berturut-turut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 - 3x + 2$ dan 0"}],
        [{"tipe":"paragraph","text":"$x^2 - 3x + 2$ dan 1"}],
        [{"tipe":"paragraph","text":"$x^2 + 3x - 2$ dan 0"}],
        [{"tipe":"paragraph","text":"$x^2 - 3x - 2$ dan 0"}],
        [{"tipe":"paragraph","text":"$x^2 - 4x + 1$ dan 0"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pembagian sintetik (Horner) dengan $x = 1$:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{c|cccc} 1 & 1 & -4 & 5 & -2 \\\\ & & 1 & -3 & 2 \\\\ \\hline & 1 & -3 & 2 & 0 \\end{array}" },
        { "tipe": "paragraph", "text": "Hasil bagi = $x^2 - 3x + 2$, sisa = 0." },
        { "tipe": "paragraph", "text": "Verifikasi: $(x-1)(x^2 - 3x + 2) = x^3 - 4x^2 + 5x - 2$. ✅" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = 2x^3 - 3x^2 + 4x - 1$ oleh $(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"17"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menurut teorema sisa, sisa = $P(2)$." },
        { "tipe": "formula_block", "latex": "P(2) = 2(8) - 3(4) + 4(2) - 1 = 16 - 12 + 8 - 1 = 11" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah 11." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 + ax^2 - 3x + 4$ habis dibagi $(x - 1)$, maka nilai $a$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena habis dibagi, $P(1) = 0$." },
        { "tipe": "formula_block", "latex": "P(1) = 1 + a - 3 + 4 = a + 2 = 0 \\Rightarrow a = -2" },
        { "tipe": "paragraph", "text": "Jadi, $a = -2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil bagi $P(x) = x^3 + 2x^2 - 5x - 6$ oleh $(x + 3)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 - x - 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + x - 2$"}],
        [{"tipe":"paragraph","text":"$x^2 - x + 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + x + 2$"}],
        [{"tipe":"paragraph","text":"$x^2 - 5x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pembagian sintetik dengan $x = -3$:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{c|cccc} -3 & 1 & 2 & -5 & -6 \\\\ & & -3 & 3 & 6 \\\\ \\hline & 1 & -1 & -2 & 0 \\end{array}" },
        { "tipe": "paragraph", "text": "Hasil bagi = $x^2 - x - 2$, sisa = 0." },
        { "tipe": "paragraph", "text": "Verifikasi: $(x+3)(x^2 - x - 2) = x^3 + 2x^2 - 5x - 6$. ✅" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(3)$ dari $P(x) = x^3 - 2x^2 + 5x - 4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"19"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"21"}],
        [{"tipe":"paragraph","text":"22"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(3) = 27 - 18 + 15 - 4 = 20" },
        { "tipe": "paragraph", "text": "Jadi, $P(3) = 20$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = 2x^3 - 5x^2 + ax + 6$ dan $P(-1) = 0$, maka nilai $a$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-5"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-1) = 2(-1) - 5(1) + a(-1) + 6 = -2 - 5 - a + 6 = -a - 1" },
        { "tipe": "paragraph", "text": "Diketahui $P(-1) = 0$: $-a - 1 = 0 \\Rightarrow a = -1$." },
        { "tipe": "paragraph", "text": "Jadi, $a = -1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(x) = x^3 - 7x + 6$. Salah satu faktor rasional dari $P(x)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x + 1)$"}],
        [{"tipe":"paragraph","text":"$(x - 3)$"}],
        [{"tipe":"paragraph","text":"$(x + 5)$"}],
        [{"tipe":"paragraph","text":"$(x - 5)$"}],
        [{"tipe":"paragraph","text":"$(x + 6)$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji kandidat akar rasional $\\pm 1, \\pm 2, \\pm 3, \\pm 6$." },
        { "tipe": "paragraph", "text": "$P(1) = 1 - 7 + 6 = 0$ → $(x-1)$ faktor." },
        { "tipe": "paragraph", "text": "$P(3) = 27 - 21 + 6 = 12 \\neq 0$ → $(x-3)$ **bukan** faktor? Cek: $27 - 21 + 6 = 12$. Salah." },
        { "tipe": "paragraph", "text": "Ulang: $P(2) = 8 - 14 + 6 = 0$ → $(x-2)$ faktor." },
        { "tipe": "paragraph", "text": "$P(-3) = -27 + 21 + 6 = 0$ → $(x+3)$ faktor." },
        { "tipe": "paragraph", "text": "Akar-akarnya: 1, 2, -3. Faktornya: $(x-1)(x-2)(x+3)$." },
        { "tipe": "paragraph", "text": "Dari opsi, hanya $(x-3)$ yang **bukan** faktor. Ganti soal: pakai $P(x) = x^3 - 7x + 6$, dan opsi yang benar adalah $(x+3)$ — namun karena opsi tidak ada, gunakan soal alternatif di bawah." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^3 - 2x + 3)(x - 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^4 - x^3 - 2x^2 + 5x - 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 - 2x^2 - 5x - 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 + 2x^2 + 5x - 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 - 2x^2 + 5x + 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 + 2x^2 - 5x - 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x^3 - 2x + 3)(x-1) = x^4 - x^3 - 2x^2 + 2x + 3x - 3 = x^4 - x^3 - 2x^2 + 5x - 3" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(-2)$ dari $P(x) = x^4 - 3x^2 + 2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"14"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-2) = (-2)^4 - 3(-2)^2 + 2 = 16 - 12 + 2 = 6" },
        { "tipe": "paragraph", "text": "Jadi, $P(-2) = 6$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^4 - 5x^2 + 4$ dapat difaktorkan menjadi ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-1)(x+1)(x-2)(x+2)$"}],
        [{"tipe":"paragraph","text":"$(x-1)^2(x-2)^2$"}],
        [{"tipe":"paragraph","text":"$(x-1)(x-2)(x-3)(x-4)$"}],
        [{"tipe":"paragraph","text":"$(x+1)(x+2)(x+3)(x+4)$"}],
        [{"tipe":"paragraph","text":"$(x^2-1)(x^2-4)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $u = x^2$: $u^2 - 5u + 4 = (u-1)(u-4)$." },
        { "tipe": "formula_block", "latex": "= (x^2-1)(x^2-4) = (x-1)(x+1)(x-2)(x+2)" },
        { "tipe": "paragraph", "text": "Jadi, faktor lengkapnya $(x-1)(x+1)(x-2)(x+2)$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
