{
  "id": "bs-k11-mat-lanjut-sedang-04",
  "nama": "Bank Soal Sedang - Paket 4",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Matriks dasar & operasi polinomial",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2 & 3 \\\\ 1 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 1 & 0 \\\\ 2 & 3 \\end{pmatrix}$. Hasil $A + B$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 7 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 0 \\\\ 2 & 12 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A + B = \\begin{pmatrix} 2+1 & 3+0 \\\\ 1+2 & 4+3 \\end{pmatrix} = \\begin{pmatrix} 3 & 3 \\\\ 3 & 7 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari matriks $A = \\begin{pmatrix} 3 & 2 \\\\ 4 & 5 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"23"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det(A) = ad - bc = (3)(5) - (2)(4) = 15 - 8 = 7" },
        { "tipe": "paragraph", "text": "Jadi, determinannya adalah 7." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$. Hasil $2A$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 4 \\\\ 6 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 2 \\\\ 3 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 4 \\\\ 6 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 4 \\\\ 6 & 2 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2A = \\begin{pmatrix} 2 \\cdot 1 & 2 \\cdot 2 \\\\ 2 \\cdot 3 & 2 \\cdot 4 \\end{pmatrix} = \\begin{pmatrix} 2 & 4 \\\\ 6 & 8 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Transpose dari matriks $A = \\begin{pmatrix} 1 & 2 & 3 \\\\ 4 & 5 & 6 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 4 \\\\ 2 & 5 \\\\ 3 & 6 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 5 & 6 \\\\ 1 & 2 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 & 3 \\\\ 4 & 5 & 6 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 2 & 1 \\\\ 6 & 5 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 6 & 5 & 4 \\\\ 3 & 2 & 1 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Transpose = tukar baris jadi kolom, kolom jadi baris." },
        { "tipe": "formula_block", "latex": "A^T = \\begin{pmatrix} 1 & 4 \\\\ 2 & 5 \\\\ 3 & 6 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^2 - x + 2) + (2x^2 + 3x - 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^2 + 2x + 1$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 4x + 1$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 2x + 1$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 2x - 1$"}],
        [{"tipe":"paragraph","text":"$x^2 + 2x + 1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x^2 - x + 2) + (2x^2 + 3x - 1) = 3x^2 + 2x + 1" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 2 & 1 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 1 & 2 \\\\ 2 & 1 \\end{pmatrix}$, hasil $A - B$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -1 \\\\ 1 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -1 \\\\ -1 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 1 \\\\ 1 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 5 & 5 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & -1 \\\\ -1 & -3 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A - B = \\begin{pmatrix} 2-1 & 1-2 \\\\ 3-2 & 4-1 \\end{pmatrix} = \\begin{pmatrix} 1 & -1 \\\\ 1 & 3 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari $\\begin{pmatrix} 5 & -2 \\\\ 3 & 4 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"26"}],
        [{"tipe":"paragraph","text":"32"}],
        [{"tipe":"paragraph","text":"-26"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det = (5)(4) - (-2)(3) = 20 + 6 = 26" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - x^2 + 4x - 4$, maka $P(2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 8 - 4 + 8 - 4 = 8" },
        { "tipe": "paragraph", "text": "Jadi, $P(2) = 8$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - x^2 + 4x - 4$, maka $P(1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 - 1 + 4 - 4 = 0" },
        { "tipe": "paragraph", "text": "Jadi, $P(1) = 0$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2 & 1 \\\\ 1 & 3 \\end{pmatrix}$. Nilai $\\det(A)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det(A) = (2)(3) - (1)(1) = 6 - 1 = 5" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
