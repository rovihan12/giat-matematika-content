{
  "id": "bs-k11-mat-lanjut-sedang-08",
  "nama": "Bank Soal Sedang - Paket 8",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Polinomial: operasi, nilai, & teorema sisa",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 5x^4 + 7x^2 - 3x + 5$ dan $g(x) = 4x^4 - 8x^3 + 2x + 10$. Hasil dari $f(x) - g(x)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^4 + 8x^3 + 7x^2 - 5x + 5$"}],
        [{"tipe":"paragraph","text":"$x^4 + 8x^3 + 7x^2 + 5x - 5$"}],
        [{"tipe":"paragraph","text":"$x^4 + 8x^3 + 7x^2 - 5x - 5$"}],
        [{"tipe":"paragraph","text":"$x^4 - 8x^3 + 7x^2 - 5x - 5$"}],
        [{"tipe":"paragraph","text":"$x^4 + 8x^3 - 7x^2 - 5x - 5$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kurangkan suku-suku yang bersesuaian:" },
        { "tipe": "formula_block", "latex": "f(x) - g(x) = (5-4)x^4 + (0-(-8))x^3 + (7-0)x^2 + (-3-2)x + (5-10)" },
        { "tipe": "formula_block", "latex": "= x^4 + 8x^3 + 7x^2 - 5x - 5" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai polinomial $2x^3 - 3x^2 - 6x + 24$ untuk $x = 4$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"85"}],
        [{"tipe":"paragraph","text":"80"}],
        [{"tipe":"paragraph","text":"75"}],
        [{"tipe":"paragraph","text":"70"}],
        [{"tipe":"paragraph","text":"65"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 4$:" },
        { "tipe": "formula_block", "latex": "2(4)^3 - 3(4)^2 - 6(4) + 24 = 2(64) - 3(16) - 24 + 24" },
        { "tipe": "formula_block", "latex": "= 128 - 48 - 24 + 24 = 80" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui polinomial $f(x) = 3x^3 + 2x^2 - 5x - 6$. Nilai $f(-3) + f(2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-26"}],
        [{"tipe":"paragraph","text":"-12"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"26"}],
        [{"tipe":"paragraph","text":"-38"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung $f(-3)$:" },
        { "tipe": "formula_block", "latex": "f(-3) = 3(-27) + 2(9) - 5(-3) - 6 = -81 + 18 + 15 - 6 = -54" },
        { "tipe": "paragraph", "text": "Hitung $f(2)$:" },
        { "tipe": "formula_block", "latex": "f(2) = 3(8) + 2(4) - 5(2) - 6 = 24 + 8 - 10 - 6 = 16" },
        { "tipe": "formula_block", "latex": "f(-3) + f(2) = -54 + 16 = -38" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial berikut ini yang bernilai -172 untuk $x = -4$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 + 3x^2 - 6x + 8$"}],
        [{"tipe":"paragraph","text":"$x^3 + 3x^2 + 6x - 8$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 + 3x^2 - 2x - 8$"}],
        [{"tipe":"paragraph","text":"$x^4 + 4x^3 - 10x^2 + 6x + 12$"}],
        [{"tipe":"paragraph","text":"$x^4 - 2x^3 - 15x^2 + 6x - 12$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji opsi E dengan $x = -4$:" },
        { "tipe": "formula_block", "latex": "(-4)^4 - 2(-4)^3 - 15(-4)^2 + 6(-4) - 12" },
        { "tipe": "formula_block", "latex": "= 256 - 2(-64) - 15(16) - 24 - 12" },
        { "tipe": "formula_block", "latex": "= 256 + 128 - 240 - 24 - 12 = -172" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x^3 + bx^2 + 2$ dan $3f(3) + 2 = 305$, nilai $b = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $3f(3) + 2 = 305$, maka $3f(3) = 303 \\Rightarrow f(3) = 101$." },
        { "tipe": "formula_block", "latex": "f(3) = 5(27) + b(9) + 2 = 135 + 9b + 2 = 137 + 9b" },
        { "tipe": "formula_block", "latex": "137 + 9b = 101 \\Rightarrow 9b = -36 \\Rightarrow b = -4" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui polinomial $f(x) = 3x^4 - 2x^3 + px^2 + qx - 8$. Jika $f(2) = 0$ dan $f(1) = 0$, maka nilai $p = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-73"}],
        [{"tipe":"paragraph","text":"-19"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"19"}],
        [{"tipe":"paragraph","text":"73"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 1$:" },
        { "tipe": "formula_block", "latex": "3(1) - 2(1) + p(1) + q(1) - 8 = 0 \\Rightarrow p + q = 7" },
        { "tipe": "paragraph", "text": "Substitusi $x = 2$:" },
        { "tipe": "formula_block", "latex": "3(16) - 2(8) + p(4) + q(2) - 8 = 0 \\Rightarrow 48 - 16 + 4p + 2q - 8 = 0" },
        { "tipe": "formula_block", "latex": "24 + 4p + 2q = 0 \\Rightarrow 2p + q = -12" },
        { "tipe": "paragraph", "text": "Selesaikan sistem persamaannya dengan mengurangi kedua persamaan:" },
        { "tipe": "formula_block", "latex": "(2p + q) - (p + q) = -12 - 7 \\Rightarrow p = -19" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang merupakan akar persamaan polinomial $x^3 - 4x^2 - 3x + 2 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"-2"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji opsi yang ada:" },
        { "tipe": "paragraph", "text": "Untuk $x = -1$: $(-1)^3 - 4(-1)^2 - 3(-1) + 2 = -1 - 4 + 3 + 2 = 0$." },
        { "tipe": "paragraph", "text": "Jadi, $x = -1$ adalah akar dari persamaan tersebut." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika salah satu akar persamaan polinomial $x^4 - 5x^3 - x^2 + px + 8 = 0$ adalah -2, nilai $p = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"30"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"-10"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = -2$:" },
        { "tipe": "formula_block", "latex": "(-2)^4 - 5(-2)^3 - (-2)^2 + p(-2) + 8 = 0" },
        { "tipe": "formula_block", "latex": "16 - 5(-8) - 4 - 2p + 8 = 0" },
        { "tipe": "formula_block", "latex": "16 + 40 - 4 - 2p + 8 = 0 \\Rightarrow 60 - 2p = 0 \\Rightarrow p = 30" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar persamaan polinomial $x^3 - 3x^2 - 6x + 8 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1, 2, dan 4"}],
        [{"tipe":"paragraph","text":"1, -2, dan -4"}],
        [{"tipe":"paragraph","text":"1, 2, dan -4"}],
        [{"tipe":"paragraph","text":"1, -2, dan 4"}],
        [{"tipe":"paragraph","text":"-1, 2, dan 4"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 1$: $1 - 3 - 6 + 8 = 0$ → $(x-1)$ faktor." },
        { "tipe": "paragraph", "text": "Bagi dengan $(x-1)$: hasil = $x^2 - 2x - 8 = (x-4)(x+2)$." },
        { "tipe": "paragraph", "text": "Jadi, akar-akarnya adalah $x = 1, x = 4, x = -2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar dari suku banyak $x^3 - 3x^2 - 10x + m$ adalah -3. Maka nilai $m$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-24"}],
        [{"tipe":"paragraph","text":"-22"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"22"}],
        [{"tipe":"paragraph","text":"24"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = -3$:" },
        { "tipe": "formula_block", "latex": "(-3)^3 - 3(-3)^2 - 10(-3) + m = 0" },
        { "tipe": "formula_block", "latex": "-27 - 27 + 30 + m = 0 \\Rightarrow -24 + m = 0 \\Rightarrow m = 24" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
