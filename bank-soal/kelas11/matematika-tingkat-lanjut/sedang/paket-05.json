{
  "id": "bs-k11-mat-lanjut-sedang-05",
  "nama": "Bank Soal Sedang - Paket 5",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Campuran polinomial & matriks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - 3x^2 + 4x - 2$ dibagi $(x - 1)$, sisanya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 - 3 + 4 - 2 = 0" },
        { "tipe": "paragraph", "text": "Jadi, sisanya 0, sehingga $(x-1)$ faktor dari $P(x)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar dari $P(x) = x^3 - 2x^2 - 5x + 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1, -2, 3"}],
        [{"tipe":"paragraph","text":"-1, 2, 3"}],
        [{"tipe":"paragraph","text":"1, 2, -3"}],
        [{"tipe":"paragraph","text":"1, 2, 3"}],
        [{"tipe":"paragraph","text":"-1, -2, -3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 1$: $P(1) = 1 - 2 - 5 + 6 = 0$ → $(x-1)$ faktor." },
        { "tipe": "paragraph", "text": "Bagi: hasil = $x^2 - x - 6 = (x-3)(x+2)$." },
        { "tipe": "formula_block", "latex": "P(x) = (x-1)(x-3)(x+2)" },
        { "tipe": "paragraph", "text": "Jadi, akar-akarnya 1, -2, 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^2 + 3x - 1)(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 + x^2 - 7x + 2$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 - 7x - 2$"}],
        [{"tipe":"paragraph","text":"$x^3 - x^2 + 7x + 2$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 + 7x + 2$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 - 5x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x^2 + 3x - 1)(x-2) = x^3 - 2x^2 + 3x^2 - 6x - x + 2 = x^3 + x^2 - 7x + 2" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 2 & 3 \\\\ 1 & 4 \\end{pmatrix}$, maka $A^T$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 1 \\\\ 3 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 3 \\\\ 1 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 2 \\\\ 4 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 3 \\\\ 1 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 4 \\\\ 2 & 3 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A^T = \\begin{pmatrix} 2 & 1 \\\\ 3 & 4 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^4 - 2x^3 + x^2 - 1$ oleh $(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 16 - 16 + 4 - 1 = 3" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 + 3x^2 - 4$, maka $P(1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 + 3 - 4 = 0" },
        { "tipe": "paragraph", "text": "Karena $P(1) = 0$, maka $(x-1)$ adalah faktor dari $P(x)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari $\\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det = (1)(4) - (2)(3) = 4 - 6 = -2" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3A$ jika $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 6 \\\\ 9 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 6 \\\\ 6 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 6 \\\\ 9 & 4 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "3A = \\begin{pmatrix} 3 & 6 \\\\ 9 & 12 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = 2x^3 - 3x^2 + 4x - 5$, maka $P(1)$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 2 - 3 + 4 - 5 = -2" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^3 - 6x^2 + 11x - 6$ memiliki akar-akar $x_1, x_2, x_3$. Nilai $x_1 x_2 x_3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta: hasil kali akar = $-d/a = 6/1 = 6$." },
        { "tipe": "paragraph", "text": "Verifikasi: akar-akarnya 1, 2, 3. Hasil kali = 6. ✅" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
