  "deskripsi": "Matriks, vektor, & fungsi rasional",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$. Determinan dari $A^2$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\det(A) = 1 \\cdot 4 - 2 \\cdot 3 = 4 - 6 = -2$." },
        { "tipe": "paragraph", "text": "Sifat determinan: $\\det(A^2) = (\\det A)^2$." },
        { "tipe": "formula_block", "latex": "\\det(A^2) = (-2)^2 = 4" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui vektor $\\vec{a} = (1, 2)$ dan $\\vec{b} = (3, k)$ tegak lurus. Nilai $k$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\frac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\frac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dua vektor tegak lurus jika dot product-nya nol." },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 1(3) + 2(k) = 0" },
        { "tipe": "formula_block", "latex": "3 + 2k = 0 \\Rightarrow k = -\\frac{3}{2}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika matriks $A = \\begin{pmatrix} 2 & 1 \\\\ 5 & 3 \\end{pmatrix}$, maka invers dari matriks $A$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & -1 \\\\ -5 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -3 & 1 \\\\ 5 & -2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 1 \\\\ 5 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & -1 \\\\ -5 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & -1 \\\\ 5 & -2 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\det(A) = 2(3) - 1(5) = 6 - 5 = 1$." },
        { "tipe": "paragraph", "text": "Rumus invers matriks $2\\times2$: $A^{-1} = \\frac{1}{\\det(A)} \\begin{pmatrix} d & -b \\\\ -c & a \\end{pmatrix}$." },
        { "tipe": "formula_block", "latex": "A^{-1} = \\frac{1}{1} \\begin{pmatrix} 3 & -1 \\\\ -5 & 2 \\end{pmatrix} = \\begin{pmatrix} 3 & -1 \\\\ -5 & 2 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Asimtot tegak dari fungsi $f(x) = \\frac{2x + 3}{2x + 6}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x = -3$"}],
        [{"tipe":"paragraph","text":"$x = 3$"}],
        [{"tipe":"paragraph","text":"$x = -2$"}],
        [{"tipe":"paragraph","text":"$x = 2$"}],
        [{"tipe":"paragraph","text":"$x = -6$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Asimtot tegak terjadi saat penyebut bernilai nol (dan pembilang tidak nol)." },
        { "tipe": "formula_block", "latex": "2x + 6 = 0 \\Rightarrow 2x = -6 \\Rightarrow x = -3" },
        { "tipe": "paragraph", "text": "Cek pembilang: $2(-3) + 3 = -6 + 3 = -3 \\neq 0$." },
        { "tipe": "paragraph", "text": "Jadi, asimtot tegaknya adalah $x = -3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Daerah asal fungsi $f(x) = \\sqrt{\\frac{2x + 6}{x - 3}}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\{x \\mid x < -3 \\text{ atau } x > 3\\}$"}],
        [{"tipe":"paragraph","text":"$\\{x \\mid x \\le -3 \\text{ atau } x > 3\\}$"}],
        [{"tipe":"paragraph","text":"$\\{x \\mid -3 \\le x < 3\\}$"}],
        [{"tipe":"paragraph","text":"$\\{x \\mid x \\ge -3\\}$"}],
        [{"tipe":"paragraph","text":"$\\{x \\mid x \\neq 3\\}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Fungsi akar terdefinisi jika $\\frac{2x + 6}{x - 3} \\ge 0$ dan $x - 3 \\neq 0$." },
        { "tipe": "paragraph", "text": "Pembuat nol: $x = -3$ dan $x = 3$." },
        { "tipe": "paragraph", "text": "Uji interval dengan garis bilangan:" },
        { "tipe": "paragraph", "text": "Untuk $x < -3$: $(\\text{negatif})/(\\text{negatif}) = \\text{positif}$ ✓" },
        { "tipe": "paragraph", "text": "Untuk $-3 < x < 3$: $(\\text{positif})/(\\text{negatif}) = \\text{negatif}$ ✗" },
        { "tipe": "paragraph", "text": "Untuk $x > 3$: $(\\text{positif})/(\\text{positif}) = \\text{positif}$ ✓" },
        { "tipe": "paragraph", "text": "Jadi, domainnya adalah $x \\le -3$ atau $x > 3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui fungsi $f(x) = |x - 3| - 5x$. Jika diubah ke dalam fungsi uraian, bentuknya adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$f(x) = \\begin{cases} -4x - 3, & x < 3 \\\\ -6x + 3, & x \\ge 3 \\end{cases}$"}],
        [{"tipe":"paragraph","text":"$f(x) = \\begin{cases} -4x + 3, & x < 3 \\\\ -6x - 3, & x \\ge 3 \\end{cases}$"}],
        [{"tipe":"paragraph","text":"$f(x) = \\begin{cases} -6x + 3, & x < 3 \\\\ -4x - 3, & x \\ge 3 \\end{cases}$"}],
        [{"tipe":"paragraph","text":"$f(x) = \\begin{cases} -4x - 3, & x \\le 3 \\\\ -6x + 3, & x > 3 \\end{cases}$"}],
        [{"tipe":"paragraph","text":"$f(x) = \\begin{cases} 4x - 3, & x < 3 \\\\ 6x + 3, & x \\ge 3 \\end{cases}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk $x < 3$, maka $|x - 3| = -(x - 3) = -x + 3$:" },
        { "tipe": "formula_block", "latex": "f(x) = (-x + 3) - 5x = -6x + 3" },
        { "tipe": "paragraph", "text": "Untuk $x \\ge 3$, maka $|x - 3| = x - 3$:" },
        { "tipe": "formula_block", "latex": "f(x) = (x - 3) - 5x = -4x - 3" },
        { "tipe": "paragraph", "text": "Jadi, bentuk uraiannya adalah $f(x) = \\begin{cases} -6x + 3, & x < 3 \\\\ -4x - 3, & x \\ge 3 \\end{cases}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui fungsi tangga dengan rumus $f(x) = \\begin{cases} -5, & x \\le -3 \\\\ 1, & -3 < x \\le 1 \\\\ 4, & 1 < x \\le 4 \\\\ 6, & x > 4 \\end{cases}$. Nilai dari $f(-2) + f(1) + 2f(2) + f(5)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"20"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung masing-masing nilai:" },
        { "tipe": "paragraph", "text": "$f(-2) = 1$ (karena $-3 < -2 \\le 1$)" },
        { "tipe": "paragraph", "text": "$f(1) = 1$ (karena $-3 < 1 \\le 1$)" },
        { "tipe": "paragraph", "text": "$f(2) = 4$ (karena $1 < 2 \\le 4$)" },
        { "tipe": "paragraph", "text": "$f(5) = 6$ (karena $5 > 4$)" },
        { "tipe": "formula_block", "latex": "f(-2) + f(1) + 2f(2) + f(5) = 1 + 1 + 2(4) + 6 = 2 + 8 + 6 = 16" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Untuk $a, b$ anggota himpunan bilangan bulat, diberikan fungsi $f(x) = \\begin{cases} ax - 2b, & x \\ge 2 \\\\ ax + b, & x < 2 \\end{cases}$. Jika $f(3) = 4$ dan $f(-6) = -2$, maka nilai $a + b = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk $x = 3 \\ge 2$: $f(3) = a(3) - 2b = 3a - 2b = 4$ ... (1)" },
        { "tipe": "paragraph", "text": "Untuk $x = -6 < 2$: $f(-6) = a(-6) + b = -6a + b = -2 \\Rightarrow b = 6a - 2$ ... (2)" },
        { "tipe": "paragraph", "text": "Substitusi (2) ke (1):" },
        { "tipe": "formula_block", "latex": "3a - 2(6a - 2) = 4 \\Rightarrow 3a - 12a + 4 = 4 \\Rightarrow -9a = 0 \\Rightarrow a = 0" },
        { "tipe": "paragraph", "text": "Substitusi $a = 0$ ke (2): $b = 6(0) - 2 = -2$." },
        { "tipe": "paragraph", "text": "Maka $a + b = 0 + (-2) = -2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 2 & 1 \\\\ 4 & 3 \\end{pmatrix}$. Nilai $\\det(A) - \\det(B)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det(A) = 1(4) - 2(3) = -2" },
        { "tipe": "formula_block", "latex": "\\det(B) = 2(3) - 1(4) = 2" },
        { "tipe": "formula_block", "latex": "\\det(A) - \\det(B) = -2 - 2 = -4" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 2 & 3 \\end{pmatrix}$, maka $\\det(2A)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sifat determinan: $\\det(kA) = k^n \\det(A)$, di mana $n$ adalah ordo matriks." },
        { "tipe": "paragraph", "text": "Untuk matriks $2\\times2$, $\\det(2A) = 2^2 \\det(A) = 4 \\det(A)$." },
        { "tipe": "formula_block", "latex": "\\det(A) = 1(3) - 2(2) = 3 - 4 = -1" },
        { "tipe": "formula_block", "latex": "\\det(2A) = 4(-1) = -4" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
