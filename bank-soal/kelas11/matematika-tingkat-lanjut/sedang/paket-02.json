{
  "id": "bs-k11-mat-lanjut-sedang-02",
  "nama": "Bank Soal Sedang - Paket 2",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Teorema faktor & akar-akar rasional",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar dari $P(x) = x^3 - 6x^2 + 11x - 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1, 2, 3"}],
        [{"tipe":"paragraph","text":"-1, -2, -3"}],
        [{"tipe":"paragraph","text":"1, -2, 3"}],
        [{"tipe":"paragraph","text":"1, 2, -3"}],
        [{"tipe":"paragraph","text":"2, 3, 4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 1$: $P(1) = 1 - 6 + 11 - 6 = 0$ → $(x-1)$ faktor." },
        { "tipe": "paragraph", "text": "Bagi dengan $(x-1)$: hasil = $x^2 - 5x + 6 = (x-2)(x-3)$." },
        { "tipe": "formula_block", "latex": "P(x) = (x-1)(x-2)(x-3)" },
        { "tipe": "paragraph", "text": "Jadi, akar-akarnya 1, 2, 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(x + 2)$ adalah faktor dari $P(x) = x^3 + ax^2 - x - 6$, maka nilai $a$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $(x+2)$ faktor, maka $P(-2) = 0$." },
        { "tipe": "formula_block", "latex": "P(-2) = (-8) + a(4) + 2 - 6 = 4a - 12" },
        { "tipe": "paragraph", "text": "$4a - 12 = 0 \\Rightarrow a = 3$." },
        { "tipe": "paragraph", "text": "Verifikasi: $a = 3$ → $P(-2) = -8 + 12 + 2 - 6 = 0$. ✅" },
        { "tipe": "paragraph", "text": "Jadi, $a = 3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyak akar real dari $P(x) = x^3 - 3x^2 - 4x + 12$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 2$: $P(2) = 8 - 12 - 8 + 12 = 0$ → $(x-2)$ faktor." },
        { "tipe": "paragraph", "text": "Bagi: hasil = $x^2 - x - 6 = (x-3)(x+2)$." },
        { "tipe": "formula_block", "latex": "P(x) = (x-2)(x-3)(x+2)" },
        { "tipe": "paragraph", "text": "Akar-akar: 2, 3, -2. Ada 3 akar real." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^3 - 4x^2 + x + 6$ memiliki akar-akar $x_1, x_2, x_3$. Nilai $x_1 + x_2 + x_3$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dengan teorema Vieta: jumlah akar = $-b/a = -(-4)/1 = 4$." },
        { "tipe": "formula_block", "latex": "x_1 + x_2 + x_3 = 4" },
        { "tipe": "paragraph", "text": "Jadi, jumlah akar-akarnya adalah 4." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Faktorisasi lengkap dari $P(x) = x^4 - 16$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-2)(x+2)(x^2+4)$"}],
        [{"tipe":"paragraph","text":"$(x-2)^2(x+2)^2$"}],
        [{"tipe":"paragraph","text":"$(x-4)(x+4)$"}],
        [{"tipe":"paragraph","text":"$(x-2)(x+2)(x-4)(x+4)$"}],
        [{"tipe":"paragraph","text":"$(x^2-4)(x^2+4)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Selisih kuadrat: $x^4 - 16 = (x^2-4)(x^2+4)$." },
        { "tipe": "formula_block", "latex": "= (x-2)(x+2)(x^2+4)" },
        { "tipe": "paragraph", "text": "$x^2+4$ tidak dapat difaktorkan lagi di bilangan real." },
        { "tipe": "paragraph", "text": "Jadi, faktor lengkap: $(x-2)(x+2)(x^2+4)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 + 2x^2 - 5x + c$ habis dibagi $(x - 1)$, maka nilai $c$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena habis dibagi, $P(1) = 0$." },
        { "tipe": "formula_block", "latex": "P(1) = 1 + 2 - 5 + c = c - 2 = 0 \\Rightarrow c = 2" },
        { "tipe": "paragraph", "text": "Jadi, $c = 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil kali akar-akar dari $P(x) = x^3 - 3x^2 - 4x + 12$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-12"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta: hasil kali akar = $-d/a = -12/1 = -12$." },
        { "tipe": "paragraph", "text": "Verifikasi: akar-akarnya 2, 3, -2. Hasil kali = $2 \\times 3 \\times (-2) = -12$. ✅" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - 2x^2 + 3x - 1$ dibagi $(x + 1)$, sisanya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-7"}],
        [{"tipe":"paragraph","text":"-5"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-1) = (-1)^3 - 2(-1)^2 + 3(-1) - 1 = -1 - 2 - 3 - 1 = -7" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah -7." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $x^3 + 4x^2 + x - 6$ dapat difaktorkan menjadi ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-1)(x+2)(x+3)$"}],
        [{"tipe":"paragraph","text":"$(x+1)(x-2)(x+3)$"}],
        [{"tipe":"paragraph","text":"$(x+1)(x+2)(x-3)$"}],
        [{"tipe":"paragraph","text":"$(x-1)(x-2)(x-3)$"}],
        [{"tipe":"paragraph","text":"$(x-1)(x+1)(x+6)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 1$: $P(1) = 1 + 4 + 1 - 6 = 0$ → $(x-1)$ faktor." },
        { "tipe": "paragraph", "text": "Bagi dengan $(x-1)$: hasil = $x^2 + 5x + 6 = (x+2)(x+3)$." },
        { "tipe": "formula_block", "latex": "= (x-1)(x+2)(x+3)" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ adalah akar-akar dari $2x^2 - 5x + 3 = 0$, maka $x_1 \\cdot x_2$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"1,5"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"2,5"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dengan teorema Vieta: $x_1 \\cdot x_2 = c/a = 3/2 = 1{,}5$." },
        { "tipe": "paragraph", "text": "Verifikasi: $2x^2 - 5x + 3 = (2x-3)(x-1)$ → akar $x=1$ dan $x=3/2$." },
        { "tipe": "paragraph", "text": "Hasil kali = $1 \\times 1{,}5 = 1{,}5$. ✅" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
