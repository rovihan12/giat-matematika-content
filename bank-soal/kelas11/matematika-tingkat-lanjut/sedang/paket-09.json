{
  "id": "bs-k11-mat-lanjut-sedang-09",
  "nama": "Bank Soal Sedang - Paket 9",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Teorema sisa, faktor, & operasi matriks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^3 - 3x^2 + 5x - 1$ dibagi $(x - 2)$, maka sisanya adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"0"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menurut teorema sisa, sisa pembagian oleh $(x - 2)$ adalah $P(2)$." },
        { "tipe": "formula_block", "latex": "P(2) = (2)^3 - 3(2)^2 + 5(2) - 1 = 8 - 12 + 10 - 1 = 5" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $x^3 + 3x^2 + 4x + 23$ oleh $x + 4$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-9"}],
        [{"tipe":"paragraph","text":"-8"}],
        [{"tipe":"paragraph","text":"-7"}],
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-5"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menurut teorema sisa, sisa pembagian oleh $(x + 4)$ adalah $P(-4)$." },
        { "tipe": "formula_block", "latex": "P(-4) = (-4)^3 + 3(-4)^2 + 4(-4) + 23 = -64 + 48 - 16 + 23 = -9" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian polinomial $2x^4 + 3x^3 - x^2 - 8x + 5$ oleh $(x - 2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"41"}],
        [{"tipe":"paragraph","text":"36"}],
        [{"tipe":"paragraph","text":"30"}],
        [{"tipe":"paragraph","text":"25"}],
        [{"tipe":"paragraph","text":"20"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sisa = $P(2)$." },
        { "tipe": "formula_block", "latex": "P(2) = 2(2)^4 + 3(2)^3 - (2)^2 - 8(2) + 5 = 32 + 24 - 4 - 16 + 5 = 41" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil bagi $P(x) = x^3 - 4x^2 + 5x - 2$ oleh $(x - 1)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 - 3x + 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + 3x - 2$"}],
        [{"tipe":"paragraph","text":"$x^2 - 3x - 2$"}],
        [{"tipe":"paragraph","text":"$x^2 - 4x + 1$"}],
        [{"tipe":"paragraph","text":"$x^2 + 3x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan pembagian sintetik (Horner) dengan $x = 1$:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{c|cccc} 1 & 1 & -4 & 5 & -2 \\\\ & & 1 & -3 & 2 \\\\ \\hline & 1 & -3 & 2 & 0 \\end{array}" },
        { "tipe": "paragraph", "text": "Hasil bagi = $x^2 - 3x + 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = 2x^3 - 3x^2 + 4x - 1$ oleh $(x - 2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"17"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sisa = $P(2)$." },
        { "tipe": "formula_block", "latex": "P(2) = 2(8) - 3(4) + 4(2) - 1 = 16 - 12 + 8 - 1 = 11" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil bagi $P(x) = x^3 + 2x^2 - 5x - 6$ oleh $(x + 3)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 - x - 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + x - 2$"}],
        [{"tipe":"paragraph","text":"$x^2 - x + 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + x + 2$"}],
        [{"tipe":"paragraph","text":"$x^2 - 5x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pembagian sintetik dengan $x = -3$:" },
        { "tipe": "formula_block", "latex": "\\begin{array}{c|cccc} -3 & 1 & 2 & -5 & -6 \\\\ & & -3 & 3 & 6 \\\\ \\hline & 1 & -1 & -2 & 0 \\end{array}" },
        { "tipe": "paragraph", "text": "Hasil bagi = $x^2 - x - 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 + ax^2 - 3x + 4$ habis dibagi $(x - 1)$, maka nilai $a$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena habis dibagi, $P(1) = 0$." },
        { "tipe": "formula_block", "latex": "P(1) = 1 + a - 3 + 4 = a + 2 = 0 \\Rightarrow a = -2" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(x) = 2x^3 - 5x^2 + ax + 6$ dan $P(-1) = 0$. Nilai $a$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-5"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-1) = 2(-1)^3 - 5(-1)^2 + a(-1) + 6 = -2 - 5 - a + 6 = -a - 1" },
        { "tipe": "paragraph", "text": "Karena $P(-1) = 0$, maka $-a - 1 = 0 \\Rightarrow a = -1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^3 - 2x + 3)(x - 1)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^4 - x^3 - 2x^2 + 5x - 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 - 2x^2 - 5x - 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 + 2x^2 + 5x - 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 - 2x^2 + 5x + 3$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 + 2x^2 - 5x - 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x^3 - 2x + 3)(x-1) = x^4 - x^3 - 2x^2 + 2x + 3x - 3 = x^4 - x^3 - 2x^2 + 5x - 3" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-mat-lanjut-sedang-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2 & 1 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 1 & 2 \\\\ 2 & 1 \\end{pmatrix}$. Hasil $A - B$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -1 \\\\ 1 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -1 \\\\ -1 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 1 \\\\ 1 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 5 & 5 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & -1 \\\\ -1 & -3 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A - B = \\begin{pmatrix} 2-1 & 1-2 \\\\ 3-2 & 4-1 \\end{pmatrix} = \\begin{pmatrix} 1 & -1 \\\\ 1 & 3 \\end{pmatrix}" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
