  "deskripsi": "Vektor 3D, titik kolinear, & sifat matriks",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui vektor $\\vec{a} = \\vec{i} - 6\\vec{j} - \\vec{k}$, $\\vec{b} = 3\\vec{i} - 2\\vec{j} + \\vec{k}$, dan $\\vec{c} = 4\\vec{i} - 2\\vec{j} + 2\\vec{k}$. Panjang dari vektor $\\vec{d} = 2\\vec{a} - \\vec{b} + 3\\vec{c}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sqrt{386}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{396}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{406}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{416}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{426}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan masing-masing vektor dalam bentuk komponen koordinat**" },
        { "tipe": "paragraph", "text": "• $\\vec{a} = (1, -6, -1)$" },
        { "tipe": "paragraph", "text": "• $\\vec{b} = (3, -2, 1)$" },
        { "tipe": "paragraph", "text": "• $\\vec{c} = (4, -2, 2)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung kombinasi linear untuk mendapatkan vektor $\\vec{d}$**" },
        { "tipe": "formula_block", "latex": "\\vec{d} = 2(1, -6, -1) - (3, -2, 1) + 3(4, -2, 2)" },
        { "tipe": "formula_block", "latex": "\\vec{d} = (2, -12, -2) - (3, -2, 1) + (12, -6, 6)" },
        { "tipe": "formula_block", "latex": "\\vec{d} = (2 - 3 + 12, -12 + 2 - 6, -2 - 1 + 6) = (11, -16, 3)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung panjang vektor $\\vec{d}$**" },
        { "tipe": "formula_block", "latex": "|\\vec{d}| = \\sqrt{11^2 + (-16)^2 + 3^2} = \\sqrt{121 + 256 + 9} = \\sqrt{386}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang vektor $\\vec{d}$ adalah **$\\sqrt{386}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $A(1, 2, 4)$, $B(5, 3, 6)$, dan $C(13, 5, p)$ segaris (kolinear). Nilai $p$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"14"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan vektor $\\overrightarrow{AB}$ dan $\\overrightarrow{BC}$**" },
        { "tipe": "formula_block", "latex": "\\overrightarrow{AB} = B - A = (5 - 1, 3 - 2, 6 - 4) = (4, 1, 2)" },
        { "tipe": "formula_block", "latex": "\\overrightarrow{BC} = C - B = (13 - 5, 5 - 3, p - 6) = (8, 2, p - 6)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan syarat titik-titik segaris (kolinear)**" },
        { "tipe": "paragraph", "text": "Karena $A$, $B$, dan $C$ segaris, maka $\\overrightarrow{BC}$ merupakan kelipatan skalar dari $\\overrightarrow{AB}$ ($\\overrightarrow{BC} = k \\cdot \\overrightarrow{AB}$). Dari komponen pertama dan kedua terlihat bahwa $k = 2$, karena $(8, 2) = 2(4, 1)$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan komponen ketiga untuk mencari nilai $p$**" },
        { "tipe": "formula_block", "latex": "p - 6 = 2(2) = 4 \\Rightarrow p = 4 + 6 = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $p$ adalah **10**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = \\begin{pmatrix} p \\\\ 2 \\\\ -1 \\end{pmatrix}$, $\\vec{b} = \\begin{pmatrix} 4 \\\\ -3 \\\\ 6 \\end{pmatrix}$, dan $\\vec{c} = \\begin{pmatrix} 2 \\\\ 1 \\\\ 0 \\end{pmatrix}$. Jika $\\vec{a}$ tegak lurus $\\vec{b}$, maka hasil dari $(\\vec{a} - 2\\vec{b}) \\cdot (3\\vec{c})$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-12"}],
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"12"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari nilai $p$ menggunakan syarat $\\vec{a} \\perp \\vec{b}$ ($\\vec{a} \\cdot \\vec{b} = 0$)**" },
        { "tipe": "formula_block", "latex": "(p)(4) + (2)(-3) + (-1)(6) = 0" },
        { "tipe": "formula_block", "latex": "4p - 6 - 6 = 0 \\Rightarrow 4p = 12 \\Rightarrow p = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung vektor $(\\vec{a} - 2\\vec{b})$ dan $(3\\vec{c})$**" },
        { "tipe": "formula_block", "latex": "\\vec{a} - 2\\vec{b} = (3, 2, -1) - 2(4, -3, 6) = (3, 2, -1) - (8, -6, 12) = (-5, 8, -13)" },
        { "tipe": "formula_block", "latex": "3\\vec{c} = 3(2, 1, 0) = (6, 3, 0)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil kali titik $(\\vec{a} - 2\\vec{b}) \\cdot (3\\vec{c})$**" },
        { "tipe": "formula_block", "latex": "(\\vec{a} - 2\\vec{b}) \\cdot (3\\vec{c}) = (-5)(6) + (8)(3) + (-13)(0) = -30 + 24 + 0 = -6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil dari $(\\vec{a} - 2\\vec{b}) \\cdot (3\\vec{c})$ adalah **-6**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika vektor $\\vec{a} = x\\vec{i} - 4\\vec{j} + 8\\vec{k}$ tegak lurus vektor $\\vec{b} = 2x\\vec{i} + 2x\\vec{j} - 3\\vec{k}$, maka nilai $x$ yang memenuhi adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4 atau 2"}],
        [{"tipe":"paragraph","text":"-2 atau 6"}],
        [{"tipe":"paragraph","text":"-4 atau -2"}],
        [{"tipe":"paragraph","text":"2 atau 4"}],
        [{"tipe":"paragraph","text":"-8 atau 1"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan syarat dua vektor saling tegak lurus ($\\vec{a} \\cdot \\vec{b} = 0$)**" },
        { "tipe": "formula_block", "latex": "(x)(2x) + (-4)(2x) + (8)(-3) = 0" },
        { "tipe": "formula_block", "latex": "2x^2 - 8x - 24 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan dan faktorkan persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Bagi seluruh suku dengan $2$:" },
        { "tipe": "formula_block", "latex": "x^2 - 4x - 12 = 0" },
        { "tipe": "formula_block", "latex": "(x - 6)(x + 2) = 0 \\Rightarrow x = 6 \\text{ atau } x = -2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **-2 atau 6**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui titik $A(1, 2, 0)$, $B(-2, 5, 6)$, dan $C(-4, 4, -4)$. Titik $P$ membagi $AB$ sehingga $AP : PB = 1 : 2$. Vektor yang diwakili $\\overrightarrow{PC}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-4, 1, -6)$"}],
        [{"tipe":"paragraph","text":"$(-2, 1, -8)$"}],
        [{"tipe":"paragraph","text":"$(-2, 1, 10)$"}],
        [{"tipe":"paragraph","text":"$(2, -1, -10)$"}],
        [{"tipe":"paragraph","text":"$(2, 1, 10)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan koordinat titik $P$ dengan perbandingan pembagian ruas garis $AP : PB = m : n = 1 : 2$**" },
        { "tipe": "formula_block", "latex": "P = \\dfrac{nA + mB}{m + n} = \\dfrac{2(1, 2, 0) + 1(-2, 5, 6)}{1 + 2}" },
        { "tipe": "formula_block", "latex": "P = \\dfrac{(2 - 2, 4 + 5, 0 + 6)}{3} = \\dfrac{(0, 9, 6)}{3} = (0, 3, 2)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung komponen vektor $\\overrightarrow{PC}$**" },
        { "tipe": "formula_block", "latex": "\\overrightarrow{PC} = C - P = (-4, 4, -4) - (0, 3, 2) = (-4 - 0, 4 - 3, -4 - 2) = (-4, 1, -6)" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, vektor yang diwakili $\\overrightarrow{PC}$ adalah **$(-4, 1, -6)$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $|\\vec{a}| = 6$, $|\\vec{b}| = 8$, dan $|\\vec{a} + \\vec{b}| = 2\\sqrt{26}$. Nilai $|\\vec{a} - \\vec{b}|$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2\\sqrt{6}$"}],
        [{"tipe":"paragraph","text":"$4\\sqrt{6}$"}],
        [{"tipe":"paragraph","text":"$6\\sqrt{6}$"}],
        [{"tipe":"paragraph","text":"$8\\sqrt{6}$"}],
        [{"tipe":"paragraph","text":"$10\\sqrt{6}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hukum jajaran genjang (*parallelogram law*) pada vektor**" },
        { "tipe": "formula_block", "latex": "|\\vec{a} + \\vec{b}|^2 + |\\vec{a} - \\vec{b}|^2 = 2(|\\vec{a}|^2 + |\\vec{b}|^2)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui**" },
        { "tipe": "formula_block", "latex": "(2\\sqrt{26})^2 + |\\vec{a} - \\vec{b}|^2 = 2(6^2 + 8^2)" },
        { "tipe": "formula_block", "latex": "104 + |\\vec{a} - \\vec{b}|^2 = 2(36 + 64) = 200" },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan persamaan untuk memperoleh $|\\vec{a} - \\vec{b}|$**" },
        { "tipe": "formula_block", "latex": "|\\vec{a} - \\vec{b}|^2 = 200 - 104 = 96" },
        { "tipe": "formula_block", "latex": "|\\vec{a} - \\vec{b}| = \\sqrt{96} = \\sqrt{16 \\times 6} = 4\\sqrt{6}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $|\\vec{a} - \\vec{b}|$ adalah **$4\\sqrt{6}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Besar sudut antara vektor $\\vec{a} = \\begin{pmatrix} 3 \\\\ 1 \\end{pmatrix}$ dan $\\vec{b} = \\begin{pmatrix} 1 \\\\ 2 \\end{pmatrix}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$30^\\circ$"}],
        [{"tipe":"paragraph","text":"$45^\\circ$"}],
        [{"tipe":"paragraph","text":"$60^\\circ$"}],
        [{"tipe":"paragraph","text":"$90^\\circ$"}],
        [{"tipe":"paragraph","text":"$120^\\circ$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung hasil kali titik dan panjang kedua vektor**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (3)(1) + (1)(2) = 3 + 2 = 5" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{3^2 + 1^2} = \\sqrt{10} \\quad \\text{dan} \\quad |\\vec{b}| = \\sqrt{1^2 + 2^2} = \\sqrt{5}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $\\cos \\theta$**" },
        { "tipe": "formula_block", "latex": "\\cos \\theta = \\dfrac{\\vec{a} \\cdot \\vec{b}}{|\\vec{a}| \\cdot |\\vec{b}|} = \\dfrac{5}{\\sqrt{10} \\cdot \\sqrt{5}} = \\dfrac{5}{\\sqrt{50}} = \\dfrac{5}{5\\sqrt{2}} = \\dfrac{1}{\\sqrt{2}} = \\dfrac{1}{2}\\sqrt{2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan besar sudut $\\theta$**" },
        { "tipe": "paragraph", "text": "Nilai kosinus yang sama dengan $\\dfrac{1}{2}\\sqrt{2}$ pada sudut lancip adalah $\\theta = 45^\\circ$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, besar sudut antara vektor $\\vec{a}$ dan $\\vec{b}$ adalah **$45^\\circ$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{u} = \\begin{pmatrix} 1 \\\\ 2 \\\\ -1 \\end{pmatrix}$ dan $\\vec{v} = \\begin{pmatrix} 1 \\\\ -1 \\\\ 2 \\end{pmatrix}$. Proyeksi skalar $(3\\vec{u} + 2\\vec{v})$ pada $\\vec{u}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{5}{\\sqrt{6}}$"}],
        [{"tipe":"paragraph","text":"$\\frac{10}{\\sqrt{6}}$"}],
        [{"tipe":"paragraph","text":"$\\frac{15}{\\sqrt{6}}$"}],
        [{"tipe":"paragraph","text":"$\\frac{20}{\\sqrt{6}}$"}],
        [{"tipe":"paragraph","text":"$\\frac{25}{\\sqrt{6}}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung vektor $(3\\vec{u} + 2\\vec{v})$**" },
        { "tipe": "formula_block", "latex": "3\\vec{u} + 2\\vec{v} = 3(1, 2, -1) + 2(1, -1, 2) = (3, 6, -3) + (2, -2, 4) = (5, 4, 1)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung hasil kali titik $(3\\vec{u} + 2\\vec{v}) \\cdot \\vec{u}$ dan panjang $|\\vec{u}|$**" },
        { "tipe": "formula_block", "latex": "(3\\vec{u} + 2\\vec{v}) \\cdot \\vec{u} = (5)(1) + (4)(2) + (1)(-1) = 10" },
        { "tipe": "formula_block", "latex": "|\\vec{u}| = \\sqrt{1^2 + 2^2 + (-1)^2} = \\sqrt{1 + 4 + 1} = \\sqrt{6}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Gunakan rumus proyeksi skalar**" },
        { "tipe": "formula_block", "latex": "\\text{Proyeksi skalar} = \\dfrac{(3\\vec{u} + 2\\vec{v}) \\cdot \\vec{u}}{|\\vec{u}|} = \\dfrac{10}{\\sqrt{6}}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, proyeksi skalar $(3\\vec{u} + 2\\vec{v})$ pada $\\vec{u}$ adalah **$\\dfrac{10}{\\sqrt{6}}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan koordinat $A(2, -1, -1)$, $B(14, 3, -9)$, dan $C(5, 0, -3)$. Proyeksi vektor $\\overrightarrow{AB}$ pada $\\overrightarrow{AC}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4(3, 1, -2)$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}(3, 1, -2)$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2}(3, -1, -2)$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}(3, -1, -2)$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2}(-3, 1, -2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan komponen vektor $\\overrightarrow{AB}$ dan $\\overrightarrow{AC}$**" },
        { "tipe": "formula_block", "latex": "\\overrightarrow{AB} = B - A = (14 - 2, 3 - (-1), -9 - (-1)) = (12, 4, -8)" },
        { "tipe": "formula_block", "latex": "\\overrightarrow{AC} = C - A = (5 - 2, 0 - (-1), -3 - (-1)) = (3, 1, -2)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\overrightarrow{AB} \\cdot \\overrightarrow{AC}$ dan $|\\overrightarrow{AC}|^2$**" },
        { "tipe": "formula_block", "latex": "\\overrightarrow{AB} \\cdot \\overrightarrow{AC} = (12)(3) + (4)(1) + (-8)(-2) = 36 + 4 + 16 = 56" },
        { "tipe": "formula_block", "latex": "|\\overrightarrow{AC}|^2 = 3^2 + 1^2 + (-2)^2 = 9 + 1 + 4 = 14" },
        { "tipe": "paragraph", "text": "**Langkah 3: Gunakan rumus proyeksi vektor ortogonal $\\overrightarrow{AB}$ pada $\\overrightarrow{AC}$**" },
        { "tipe": "formula_block", "latex": "\\text{Proyeksi vektor} = \\dfrac{\\overrightarrow{AB} \\cdot \\overrightarrow{AC}}{|\\overrightarrow{AC}|^2} \\cdot \\overrightarrow{AC} = \\dfrac{56}{14}(3, 1, -2) = 4(3, 1, -2)" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, proyeksi vektor $\\overrightarrow{AB}$ pada $\\overrightarrow{AC}$ adalah **$4(3, 1, -2)$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui vektor $\\vec{a} = 2\\vec{i} - 4\\vec{j} - 6\\vec{k}$ dan vektor $\\vec{b} = 2\\vec{i} - 2\\vec{j} + 4\\vec{k}$. Proyeksi vektor ortogonal $\\vec{a}$ pada $\\vec{b}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\frac{1}{6}(2\\vec{i} - 2\\vec{j} + 4\\vec{k})$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{6}(2\\vec{i} - 2\\vec{j} + 4\\vec{k})$"}],
        [{"tipe":"paragraph","text":"$-\\frac{1}{3}(2\\vec{i} - 2\\vec{j} + 4\\vec{k})$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{3}(2\\vec{i} - 2\\vec{j} + 4\\vec{k})$"}],
        [{"tipe":"paragraph","text":"$-\\frac{1}{2}(2\\vec{i} - 2\\vec{j} + 4\\vec{k})$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $\\vec{a} \\cdot \\vec{b}$ dan $|\\vec{b}|^2$**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (2)(2) + (-4)(-2) + (-6)(4) = 4 + 8 - 24 = -12" },
        { "tipe": "formula_block", "latex": "|\\vec{b}|^2 = 2^2 + (-2)^2 + 4^2 = 4 + 4 + 16 = 24" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung proyeksi vektor ortogonal $\\vec{a}$ pada $\\vec{b}$**" },
        { "tipe": "formula_block", "latex": "\\text{Proyeksi vektor} = \\dfrac{\\vec{a} \\cdot \\vec{b}}{|\\vec{b}|^2} \\cdot \\vec{b} = \\dfrac{-12}{24}(2\\vec{i} - 2\\vec{j} + 4\\vec{k}) = -\\dfrac{1}{2}(2\\vec{i} - 2\\vec{j} + 4\\vec{k})" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, proyeksi vektor ortogonal $\\vec{a}$ pada $\\vec{b}$ adalah **$-\\dfrac{1}{2}(2\\vec{i} - 2\\vec{j} + 4\\vec{k})$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
