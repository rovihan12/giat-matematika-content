{
  "id": "bs-k11-mat-lanjut-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Soal campuran tingkat lanjut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2, x_3$ akar-akar $x^3 - 6x^2 + 11x - 6 = 0$, maka nilai $x_1 x_2 x_3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien polinomial kubik**" },
        { "tipe": "paragraph", "text": "Dari $x^3 - 6x^2 + 11x - 6 = 0$ dengan bentuk umum $ax^3 + bx^2 + cx + d = 0$, diperoleh $a = 1$, $b = -6$, $c = 11$, dan $d = -6$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan Teorema Vieta untuk hasil kali ketiga akar**" },
        { "tipe": "formula_block", "latex": "x_1 x_2 x_3 = -\\dfrac{d}{a} = -\\dfrac{-6}{1} = 6" },
        { "tipe": "paragraph", "text": "**Langkah 3: Verifikasi akar-akarnya**" },
        { "tipe": "paragraph", "text": "Akar-akar persamaan tersebut adalah $1$, $2$, dan $3$. Hasil kalinya: $1 \\times 2 \\times 3 = 6$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1 x_2 x_3$ adalah **6**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari matriks $A = \\begin{pmatrix} 3 & 1 \\\\ 2 & 1 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -1 \\\\ -2 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & 1 \\\\ 2 & -3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -1 \\\\ 2 & -3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 1 \\\\ -2 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & -1 \\\\ -2 & 1 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung determinan matriks $A$**" },
        { "tipe": "formula_block", "latex": "\\det(A) = (3)(1) - (1)(2) = 3 - 2 = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus invers matriks berordo $2 \\times 2$**" },
        { "tipe": "formula_block", "latex": "A^{-1} = \\dfrac{1}{\\det(A)} \\begin{pmatrix} d & -b \\\\ -c & a \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang diperoleh**" },
        { "tipe": "formula_block", "latex": "A^{-1} = \\dfrac{1}{1} \\begin{pmatrix} 1 & -1 \\\\ -2 & 3 \\end{pmatrix} = \\begin{pmatrix} 1 & -1 \\\\ -2 & 3 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, invers dari matriks $A$ adalah **$\\begin{pmatrix} 1 & -1 \\\\ -2 & 3 \\end{pmatrix}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Vektor $\\vec{a} = (2, 3, 6)$. Panjangnya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus panjang vektor di ruang tiga dimensi**" },
        { "tipe": "paragraph", "text": "Untuk $\\vec{a} = (x, y, z) = (2, 3, 6)$:" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{x^2 + y^2 + z^2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan komponen dan hitung**" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{2^2 + 3^2 + 6^2} = \\sqrt{4 + 9 + 36} = \\sqrt{49} = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang vektor $\\vec{a}$ adalah **7**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^4 - 5x^3 + 5x^2 + 5x - 6$ memiliki akar $x = 1$ dan $x = -1$, maka $P(x)$ habis dibagi oleh ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x^2 - 1)$"}],
        [{"tipe":"paragraph","text":"$(x^2 + 1)$"}],
        [{"tipe":"paragraph","text":"$(x - 1)^2$"}],
        [{"tipe":"paragraph","text":"$(x + 1)^2$"}],
        [{"tipe":"paragraph","text":"$(x - 2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan faktor linear berdasarkan Teorema Faktor**" },
        { "tipe": "paragraph", "text": "• Karena $x = 1$ merupakan akar, maka $(x - 1)$ adalah faktor dari $P(x)$." },
        { "tipe": "paragraph", "text": "• Karena $x = -1$ merupakan akar, maka $(x + 1)$ adalah faktor dari $P(x)$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan kedua faktor tersebut**" },
        { "tipe": "formula_block", "latex": "(x - 1)(x + 1) = x^2 - 1" },
        { "tipe": "paragraph", "text": "Karena $(x - 1)$ dan $(x + 1)$ merupakan faktor-faktor $P(x)$, hasil kalinya yaitu $(x^2 - 1)$ juga membagi habis $P(x)$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $P(x)$ habis dibagi oleh **$(x^2 - 1)$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (1, 2, 2)$ dan $\\vec{b} = (2, 1, -2)$, maka $\\vec{a} \\cdot \\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung hasil kali titik (*dot product*) $\\vec{a} \\cdot \\vec{b}$**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (1)(2) + (2)(1) + (2)(-2)" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 2 + 2 - 4 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Interpretasi hubungan kedua vektor**" },
        { "tipe": "paragraph", "text": "Karena $\\vec{a} \\cdot \\vec{b} = 0$, kedua vektor tersebut saling tegak lurus." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\vec{a} \\cdot \\vec{b}$ adalah **0**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 1 & 3 \\\\ 2 & 4 \\end{pmatrix}$, maka $\\det(A^2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-16"}],
        [{"tipe":"paragraph","text":"0"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung determinan matriks $A$**" },
        { "tipe": "formula_block", "latex": "\\det(A) = (1)(4) - (3)(2) = 4 - 6 = -2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan sifat determinan perpangkatan matriks**" },
        { "tipe": "formula_block", "latex": "\\det(A^2) = (\\det A)^2 = (-2)^2 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\det(A^2)$ adalah **4**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ akar-akar $x^2 - 5x + 6 = 0$, maka $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{5}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{6}{5}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dengan Teorema Vieta**" },
        { "tipe": "paragraph", "text": "Dari persamaan $x^2 - 5x + 6 = 0$, diperoleh $x_1 + x_2 = 5$ dan $x_1 x_2 = 6$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan substitusikan nilainya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{x_1} + \\dfrac{1}{x_2} = \\dfrac{x_2 + x_1}{x_1 x_2} = \\dfrac{x_1 + x_2}{x_1 x_2}" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{x_1} + \\dfrac{1}{x_2} = \\dfrac{5}{6}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ adalah **$\\dfrac{5}{6}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (4, 3)$, maka vektor satuan dari $\\vec{a}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{4}{5}, \\dfrac{3}{5}\\right)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{3}{5}, \\dfrac{4}{5}\\right)$"}],
        [{"tipe":"paragraph","text":"$(4, 3)$"}],
        [{"tipe":"paragraph","text":"$(5, 5)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{4}{7}, \\dfrac{3}{7}\\right)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung panjang vektor $\\vec{a}$**" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{4^2 + 3^2} = \\sqrt{16 + 9} = \\sqrt{25} = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus vektor satuan ($\\hat{a}$)**" },
        { "tipe": "formula_block", "latex": "\\hat{a} = \\dfrac{\\vec{a}}{|\\vec{a}|} = \\dfrac{1}{5}(4, 3) = \\left(\\dfrac{4}{5}, \\dfrac{3}{5}\\right)" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, vektor satuan dari $\\vec{a}$ adalah **$\\left(\\dfrac{4}{5}, \\dfrac{3}{5}\\right)$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = 2x^4 - 3x^3 + 5x^2 - x + 7$ dibagi $(x - 1)$, sisanya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"14"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan Teorema Sisa**" },
        { "tipe": "paragraph", "text": "Sisa pembagian polinomial $P(x)$ oleh $(x - 1)$ sama dengan nilai $P(1)$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $P(1)$**" },
        { "tipe": "formula_block", "latex": "P(1) = 2(1)^4 - 3(1)^3 + 5(1)^2 - (1) + 7" },
        { "tipe": "formula_block", "latex": "P(1) = 2 - 3 + 5 - 1 + 7 = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, sisa pembagiannya adalah **10**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$, maka $\\det(A^{-1})$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung determinan matriks $A$**" },
        { "tipe": "formula_block", "latex": "\\det(A) = (1)(4) - (2)(3) = 4 - 6 = -2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan sifat determinan invers matriks**" },
        { "tipe": "formula_block", "latex": "\\det(A^{-1}) = \\dfrac{1}{\\det(A)} = \\dfrac{1}{-2} = -\\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\det(A^{-1})$ adalah **$-\\dfrac{1}{2}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
