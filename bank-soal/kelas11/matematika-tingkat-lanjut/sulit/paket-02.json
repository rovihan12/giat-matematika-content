{
  "id": "bs-k11-mat-lanjut-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Perkalian & invers matriks 2×2",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil kali $A \\cdot B$ dengan $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 2 & 0 \\\\ 1 & 3 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 6 \\\\ 10 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 6 \\\\ 10 & 11 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 6 \\\\ 10 & 13 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 8 \\\\ 10 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 6 \\\\ 10 & 12 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A \\cdot B = \\begin{pmatrix} 1 \\cdot 2 + 2 \\cdot 1 & 1 \\cdot 0 + 2 \\cdot 3 \\\\ 3 \\cdot 2 + 4 \\cdot 1 & 3 \\cdot 0 + 4 \\cdot 3 \\end{pmatrix} = \\begin{pmatrix} 4 & 6 \\\\ 10 & 12 \\end{pmatrix}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari matriks $A = \\begin{pmatrix} 2 & 1 \\\\ 5 & 3 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & -1 \\\\ -5 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -3 & 1 \\\\ 5 & -2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 1 \\\\ 5 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & -1 \\\\ -5 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & -1 \\\\ 5 & -2 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\det(A) = 2 \\cdot 3 - 1 \\cdot 5 = 6 - 5 = 1$." },
        { "tipe": "formula_block", "latex": "A^{-1} = \\dfrac{1}{\\det(A)} \\begin{pmatrix} d & -b \\\\ -c & a \\end{pmatrix} = \\begin{pmatrix} 3 & -1 \\\\ -5 & 2 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, inversnya $\\begin{pmatrix} 3 & -1 \\\\ -5 & 2 \\end{pmatrix}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$. Determinan dari $A^2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\det(A) = 1 \\cdot 4 - 2 \\cdot 3 = -2$." },
        { "tipe": "formula_block", "latex": "\\det(A^2) = (\\det A)^2 = (-2)^2 = 4" },
        { "tipe": "paragraph", "text": "Jadi, $\\det(A^2) = 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 2 & 3 \\\\ 1 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 1 & 0 \\\\ 2 & 1 \\end{pmatrix}$, maka $A \\cdot B$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 8 & 3 \\\\ 9 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 8 & 3 \\\\ 9 & 5 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 8 & 3 \\\\ 8 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 9 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 8 & 0 \\\\ 9 & 4 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A \\cdot B = \\begin{pmatrix} 2 \\cdot 1 + 3 \\cdot 2 & 2 \\cdot 0 + 3 \\cdot 1 \\\\ 1 \\cdot 1 + 4 \\cdot 2 & 1 \\cdot 0 + 4 \\cdot 1 \\end{pmatrix} = \\begin{pmatrix} 8 & 3 \\\\ 9 & 4 \\end{pmatrix}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari matriks $A = \\begin{pmatrix} 1 & 2 & 3 \\\\ 4 & 5 & 6 \\\\ 7 & 8 & 10 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi kofaktor baris pertama:" },
        { "tipe": "formula_block", "latex": "\\det = 1 \\cdot (5 \\cdot 10 - 6 \\cdot 8) - 2 \\cdot (4 \\cdot 10 - 6 \\cdot 7) + 3 \\cdot (4 \\cdot 8 - 5 \\cdot 7)" },
        { "tipe": "formula_block", "latex": "= 1 \\cdot (50 - 48) - 2 \\cdot (40 - 42) + 3 \\cdot (32 - 35)" },
        { "tipe": "formula_block", "latex": "= 2 + 4 - 9 = -3" },
        { "tipe": "paragraph", "text": "Jadi, determinannya adalah -3." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 2 & 1 \\\\ 1 & 3 \\end{pmatrix}$, maka $A + B$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 4 & 7 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 4 & 6 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 4 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 7 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 2 \\\\ 4 & 7 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A + B = \\begin{pmatrix} 1+2 & 2+1 \\\\ 3+1 & 4+3 \\end{pmatrix} = \\begin{pmatrix} 3 & 3 \\\\ 4 & 7 \\end{pmatrix}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ dan $I = \\begin{pmatrix} 1 & 0 \\\\ 0 & 1 \\end{pmatrix}$ (identitas), maka $A \\cdot I$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 4 \\\\ 1 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 4 \\\\ 6 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 0 \\\\ 0 & 0 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$A \\cdot I = A$ (sifat identitas matriks)." },
        { "tipe": "formula_block", "latex": "A \\cdot I = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari matriks $A = \\begin{pmatrix} 3 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 1 & 0 & 3 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"17"}],
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"19"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi baris pertama:" },
        { "tipe": "formula_block", "latex": "\\det = 3 \\cdot (2 \\cdot 3 - 1 \\cdot 0) - 1 \\cdot (0 \\cdot 3 - 1 \\cdot 1) + 0" },
        { "tipe": "formula_block", "latex": "= 3 \\cdot 6 - 1 \\cdot (-1) = 18 + 1 = 19" },
        { "tipe": "paragraph", "text": "Jadi, determinannya adalah 19." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 4 & 2 \\\\ 3 & 1 \\end{pmatrix}$, maka $\\det(A^T)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\det(A) = 4 \\cdot 1 - 2 \\cdot 3 = 4 - 6 = -2$." },
        { "tipe": "paragraph", "text": "Sifat: $\\det(A^T) = \\det(A)$." },
        { "tipe": "paragraph", "text": "Jadi, $\\det(A^T) = -2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 2 & 3 \\\\ 4 & 5 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 1 & 2 \\\\ 2 & 1 \\end{pmatrix}$, maka $\\det(A \\cdot B)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"36"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\det(A) = 2 \\cdot 5 - 3 \\cdot 4 = 10 - 12 = -2$." },
        { "tipe": "paragraph", "text": "$\\det(B) = 1 \\cdot 1 - 2 \\cdot 2 = 1 - 4 = -3$." },
        { "tipe": "formula_block", "latex": "\\det(A \\cdot B) = \\det(A) \\cdot \\det(B) = (-2)(-3) = 6" },
        { "tipe": "paragraph", "text": "Jadi, $\\det(A \\cdot B) = 6$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
