{
  "id": "bs-k11-mat-lanjut-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Polinomial derajat tinggi & akar-akar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar dari $P(x) = x^4 - 5x^2 + 4 = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $u = x^2$: $u^2 - 5u + 4 = 0$." },
        { "tipe": "formula_block", "latex": "(u-1)(u-4) = 0 \\Rightarrow u = 1 \\text{ atau } u = 4" },
        { "tipe": "paragraph", "text": "$x^2 = 1 \\Rightarrow x = \\pm 1$; $x^2 = 4 \\Rightarrow x = \\pm 2$." },
        { "tipe": "paragraph", "text": "Akar-akarnya: $\\pm 1, \\pm 2$. Jadi, salah satunya adalah $-2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2, x_3$ adalah akar-akar dari $2x^3 - 5x^2 - 4x + 3 = 0$, maka nilai $x_1 + x_2 + x_3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{5}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{2}$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta: $x_1 + x_2 + x_3 = -\\dfrac{b}{a}$." },
        { "tipe": "formula_block", "latex": "= -\\dfrac{-5}{2} = \\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "Jadi, jumlah akar-akarnya adalah $\\dfrac{5}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(x) = x^4 + ax^3 + bx^2 + cx + d$. Jika akar-akarnya $x_1, x_2, x_3, x_4$ dan $x_1 x_2 x_3 x_4 = -6$, maka nilai $d$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta untuk polinomial berderajat 4:" },
        { "tipe": "formula_block", "latex": "x_1 x_2 x_3 x_4 = \\dfrac{d}{a}" },
        { "tipe": "paragraph", "text": "Dengan $a = 1$ dan hasil kali $= -6$, maka $d = -6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil bagi $P(x) = x^4 - 3x^3 + 8x^2 - 10x + 8$ oleh $(x^2 - 2x + 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 - x + 4$"}],
        [{"tipe":"paragraph","text":"$x^2 + x - 4$"}],
        [{"tipe":"paragraph","text":"$x^2 - x - 4$"}],
        [{"tipe":"paragraph","text":"$x^2 + x + 4$"}],
        [{"tipe":"paragraph","text":"$x^2 - 2x + 4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji dengan mengalikan $(x^2 - 2x + 2)(x^2 - x + 4)$:" },
        { "tipe": "formula_block", "latex": "= x^4 - x^3 + 4x^2 - 2x^3 + 2x^2 - 8x + 2x^2 - 2x + 8" },
        { "tipe": "formula_block", "latex": "= x^4 - 3x^3 + 8x^2 - 10x + 8" },
        { "tipe": "paragraph", "text": "Cocok dengan $P(x)$. Jadi, hasil baginya $x^2 - x + 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(x) = x^4 - 4x^3 + 3x^2 + 4x - 4$. Jika $P(1) = 0$ dan $P(-1) = 0$, maka dua faktor dari $P(x)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-1)$ dan $(x+1)$"}],
        [{"tipe":"paragraph","text":"$(x-2)$ dan $(x+2)$"}],
        [{"tipe":"paragraph","text":"$(x-3)$ dan $(x+3)$"}],
        [{"tipe":"paragraph","text":"$(x-1)$ dan $(x-2)$"}],
        [{"tipe":"paragraph","text":"$(x+1)$ dan $(x+2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(1) = 0 \\Rightarrow (x-1)$ faktor." },
        { "tipe": "paragraph", "text": "$P(-1) = 0 \\Rightarrow (x+1)$ faktor." },
        { "tipe": "paragraph", "text": "Jadi, dua faktornya adalah $(x-1)$ dan $(x+1)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ adalah akar-akar dari $x^2 - 5x + 6 = 0$, maka nilai $x_1^2 + x_2^2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"25"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 + x_2 = 5$, $x_1 x_2 = 6$." },
        { "tipe": "formula_block", "latex": "x_1^2 + x_2^2 = (x_1 + x_2)^2 - 2 x_1 x_2 = 25 - 12 = 13" },
        { "tipe": "paragraph", "text": "Jadi, nilainya adalah 13." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyak akar real dari $P(x) = x^3 - 3x^2 + 4x - 2 = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 1$: $P(1) = 1 - 3 + 4 - 2 = 0$ → $(x-1)$ faktor." },
        { "tipe": "paragraph", "text": "Bagi: hasil = $x^2 - 2x + 2$. Diskriminan $= 4 - 8 = -4 < 0$ → akar kompleks." },
        { "tipe": "paragraph", "text": "Jadi, hanya 1 akar real, yaitu $x = 1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 + 2x^2 - 5x - 6$, maka nilai $P(-1) + P(1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-12"}],
        [{"tipe":"paragraph","text":"-8"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(-1) = -1 + 2 + 5 - 6 = 0$." },
        { "tipe": "paragraph", "text": "$P(1) = 1 + 2 - 5 - 6 = -8$." },
        { "tipe": "formula_block", "latex": "P(-1) + P(1) = 0 + (-8) = -8" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya adalah -8." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^5 - x^4 - 5x^3 + x^2 + 8x + 4$ memiliki akar $x = -1$ berulang. Derajat dari $(x+1)^2$ sebagai faktor adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $(x+1)^2$ muncul sebagai faktor, maka derajat faktornya adalah 2." },
        { "tipe": "paragraph", "text": "Verifikasi: $P(-1) = -1 - 1 + 5 + 1 - 8 + 4 = 0$." },
        { "tipe": "paragraph", "text": "Bagi dua kali dengan $(x+1)$: hasilnya $x^3 - 3x^2 + 2x + 4$ (tidak habis lagi)." },
        { "tipe": "paragraph", "text": "Jadi, derajat faktornya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^4 - 3x^3 + 2x^2 + ax + b$ habis dibagi oleh $(x^2 - 1)$, maka nilai $a + b$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x^2 - 1)$ faktor → $P(1) = 0$ dan $P(-1) = 0$." },
        { "tipe": "paragraph", "text": "$P(1) = 1 - 3 + 2 + a + b = a + b = 0$." },
        { "tipe": "paragraph", "text": "$P(-1) = 1 + 3 + 2 - a + b = 6 - a + b = 0 \\Rightarrow -a + b = -6$." },
        { "tipe": "paragraph", "text": "Selesaikan: $a + b = 0$, $-a + b = -6$ → $b = -3$, $a = 3$." },
        { "tipe": "paragraph", "text": "Jadi, $a + b = 3 + (-3) = 0$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
