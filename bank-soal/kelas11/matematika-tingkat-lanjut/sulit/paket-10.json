{
  "id": "bs-k11-mat-lanjut-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Soal campuran tingkat lanjut: polinomial, matriks, & vektor",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^3 - 4x^2 + x + 6$ memiliki akar-akar $x_1, x_2, x_3$. Nilai $x_1 \\cdot x_2 + x_2 \\cdot x_3 + x_1 \\cdot x_3$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta derajat 3: $x_1 x_2 + x_2 x_3 + x_1 x_3 = \\frac{c}{a}$." },
        { "tipe": "formula_block", "latex": "= \\frac{1}{1} = 1" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^4 - 3x^3 + 2x^2 - 5x + 6$ dibagi $(x - 1)$, maka sisa pembagiannya adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 - 3 + 2 - 5 + 6 = 1" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 2 & 3 \\end{pmatrix}$, maka $\\det(2A)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk matriks $2\\times2$, $\\det(kA) = k^2 \\det(A)$." },
        { "tipe": "formula_block", "latex": "\\det(A) = 1(3) - 2(2) = -1" },
        { "tipe": "formula_block", "latex": "\\det(2A) = 2^2(-1) = -4" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (1, 2)$ dan $\\vec{b} = (3, k)$ tegak lurus, maka nilai $k$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\frac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\frac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 1(3) + 2(k) = 3 + 2k = 0 \\Rightarrow k = -\\frac{3}{2}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^3 + ax^2 + bx + c$ memiliki akar 1, 2, dan 3. Nilai $a$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(x) = (x-1)(x-2)(x-3) = x^3 - 6x^2 + 11x - 6$." },
        { "tipe": "paragraph", "text": "Bandingkan dengan $x^3 + ax^2 + bx + c$: $a = -6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 2 & 1 \\\\ 4 & 3 \\end{pmatrix}$, maka $\\det(A) - \\det(B)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det(A) = 1(4) - 2(3) = -2" },
        { "tipe": "formula_block", "latex": "\\det(B) = 2(3) - 1(4) = 2" },
        { "tipe": "formula_block", "latex": "\\det(A) - \\det(B) = -2 - 2 = -4" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Vektor $\\vec{a} = (2, 1)$ dan $\\vec{b} = (1, -2)$. Hasil $\\vec{a} \\cdot \\vec{b}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 2(1) + 1(-2) = 0" },
        { "tipe": "paragraph", "text": "Kedua vektor tegak lurus." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ akar-akar $x^2 - 7x + 12 = 0$, maka $x_1^2 + x_2^2$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"23"}],
        [{"tipe":"paragraph","text":"24"}],
        [{"tipe":"paragraph","text":"25"}],
        [{"tipe":"paragraph","text":"26"}],
        [{"tipe":"paragraph","text":"49"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 + x_2 = 7$; $x_1 x_2 = 12$." },
        { "tipe": "formula_block", "latex": "x_1^2 + x_2^2 = (x_1 + x_2)^2 - 2x_1x_2 = 49 - 24 = 25" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (3, 4)$, maka panjang vektor $2\\vec{a}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"25"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{3^2 + 4^2} = 5" },
        { "tipe": "formula_block", "latex": "|2\\vec{a}| = 2|\\vec{a}| = 10" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$. Nilai $\\det(A^{-1})$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"$-\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det(A) = 1(4) - 2(3) = -2" },
        { "tipe": "formula_block", "latex": "\\det(A^{-1}) = \\frac{1}{\\det(A)} = -\\frac{1}{2}" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
