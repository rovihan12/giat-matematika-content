{
  "id": "bs-k11-mat-lanjut-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Soal campuran tingkat lanjut: polinomial, matriks, & vektor",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^3 - 4x^2 + x + 6$ memiliki akar-akar $x_1, x_2, x_3$. Nilai $x_1 \\cdot x_2 + x_2 \\cdot x_3 + x_1 \\cdot x_3$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien polinomial kubik**" },
        { "tipe": "paragraph", "text": "Dari $P(x) = x^3 - 4x^2 + x + 6$ dengan bentuk umum $ax^3 + bx^2 + cx + d = 0$, diperoleh $a = 1$, $b = -4$, $c = 1$, dan $d = 6$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan Teorema Vieta untuk jumlah hasil kali dua akar**" },
        { "tipe": "formula_block", "latex": "x_1 x_2 + x_2 x_3 + x_1 x_3 = \\dfrac{c}{a} = \\dfrac{1}{1} = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1 \\cdot x_2 + x_2 \\cdot x_3 + x_1 \\cdot x_3$ adalah **1**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^4 - 3x^3 + 2x^2 - 5x + 6$ dibagi $(x - 1)$, maka sisa pembagiannya adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan Teorema Sisa**" },
        { "tipe": "paragraph", "text": "Sisa pembagian polinomial $P(x)$ oleh $(x - 1)$ sama dengan nilai $P(1)$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $P(1)$**" },
        { "tipe": "formula_block", "latex": "P(1) = (1)^4 - 3(1)^3 + 2(1)^2 - 5(1) + 6" },
        { "tipe": "formula_block", "latex": "P(1) = 1 - 3 + 2 - 5 + 6 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, sisa pembagiannya adalah **1**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 2 & 3 \\end{pmatrix}$, maka $\\det(2A)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung determinan matriks $A$**" },
        { "tipe": "formula_block", "latex": "\\det(A) = (1)(3) - (2)(2) = 3 - 4 = -1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan sifat perkalian skalar pada determinan matriks ordo $2 \\times 2$**" },
        { "tipe": "paragraph", "text": "Untuk matriks persegi berordo $n \\times n$ berlaku $\\det(kA) = k^n \\det(A)$. Karena $n = 2$ dan $k = 2$:" },
        { "tipe": "formula_block", "latex": "\\det(2A) = 2^2 \\cdot \\det(A) = 4(-1) = -4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\det(2A)$ adalah **-4**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (1, 2)$ dan $\\vec{b} = (3, k)$ tegak lurus, maka nilai $k$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\frac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\frac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan syarat dua vektor saling tegak lurus ($\\vec{a} \\cdot \\vec{b} = 0$)**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (1)(3) + (2)(k) = 3 + 2k = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk memperoleh nilai $k$**" },
        { "tipe": "formula_block", "latex": "2k = -3 \\Rightarrow k = -\\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ adalah **$-\\dfrac{3}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = x^3 + ax^2 + bx + c$ memiliki akar 1, 2, dan 3. Nilai $a$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun bentuk faktor polinomial dari akar-akarnya**" },
        { "tipe": "formula_block", "latex": "P(x) = (x - 1)(x - 2)(x - 3)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jabarkan perkalian faktor-faktor tersebut**" },
        { "tipe": "formula_block", "latex": "P(x) = (x^2 - 3x + 2)(x - 3) = x^3 - 6x^2 + 11x - 6" },
        { "tipe": "paragraph", "text": "**Langkah 3: Bandingkan koefisien $x^2$ dengan $x^3 + ax^2 + bx + c$**" },
        { "tipe": "paragraph", "text": "Diperoleh koefisien $x^2$ adalah $a = -6$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ adalah **-6**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 2 & 1 \\\\ 4 & 3 \\end{pmatrix}$, maka $\\det(A) - \\det(B)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung determinan matriks $A$ dan matriks $B$**" },
        { "tipe": "formula_block", "latex": "\\det(A) = (1)(4) - (2)(3) = 4 - 6 = -2" },
        { "tipe": "formula_block", "latex": "\\det(B) = (2)(3) - (1)(4) = 6 - 4 = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung selisih $\\det(A) - \\det(B)$**" },
        { "tipe": "formula_block", "latex": "\\det(A) - \\det(B) = (-2) - 2 = -4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\det(A) - \\det(B)$ adalah **-4**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Vektor $\\vec{a} = (2, 1)$ dan $\\vec{b} = (1, -2)$. Hasil $\\vec{a} \\cdot \\vec{b}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung hasil kali titik (*dot product*) $\\vec{a} \\cdot \\vec{b}$**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (2)(1) + (1)(-2) = 2 - 2 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Catatan hubungan vektor**" },
        { "tipe": "paragraph", "text": "Karena $\\vec{a} \\cdot \\vec{b} = 0$, kedua vektor saling tegak lurus." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil $\\vec{a} \\cdot \\vec{b}$ adalah **0**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ akar-akar $x^2 - 7x + 12 = 0$, maka $x_1^2 + x_2^2$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"23"}],
        [{"tipe":"paragraph","text":"24"}],
        [{"tipe":"paragraph","text":"25"}],
        [{"tipe":"paragraph","text":"26"}],
        [{"tipe":"paragraph","text":"49"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar menggunakan Teorema Vieta**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 7x + 12 = 0$ ($a = 1, b = -7, c = 12$), diperoleh $x_1 + x_2 = 7$ dan $x_1 x_2 = 12$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x_1^2 + x_2^2$**" },
        { "tipe": "formula_block", "latex": "x_1^2 + x_2^2 = (x_1 + x_2)^2 - 2x_1 x_2 = (7)^2 - 2(12) = 49 - 24 = 25" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1^2 + x_2^2$ adalah **25**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (3, 4)$, maka panjang vektor $2\\vec{a}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"25"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung panjang vektor $\\vec{a}$**" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{3^2 + 4^2} = \\sqrt{9 + 16} = \\sqrt{25} = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung panjang vektor $2\\vec{a}$**" },
        { "tipe": "formula_block", "latex": "|2\\vec{a}| = 2|\\vec{a}| = 2 \\times 5 = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang vektor $2\\vec{a}$ adalah **10**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$. Nilai $\\det(A^{-1})$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"$-\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung determinan matriks $A$**" },
        { "tipe": "formula_block", "latex": "\\det(A) = (1)(4) - (2)(3) = 4 - 6 = -2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan sifat determinan invers matriks**" },
        { "tipe": "formula_block", "latex": "\\det(A^{-1}) = \\dfrac{1}{\\det(A)} = \\dfrac{1}{-2} = -\\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\det(A^{-1})$ adalah **$-\\dfrac{1}{2}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
