{
  "id": "bs-k11-mat-lanjut-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Vektor: dot product, panjang, & sudut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui vektor $\\vec{a} = (3, 4)$ dan $\\vec{b} = (1, 2)$. Hasil $\\vec{a} \\cdot \\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"15"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus hasil kali titik (*dot product*) dua vektor**" },
        { "tipe": "paragraph", "text": "Untuk $\\vec{a} = (a_1, a_2)$ dan $\\vec{b} = (b_1, b_2)$, berlaku $\\vec{a} \\cdot \\vec{b} = a_1 b_1 + a_2 b_2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusi komponen vektor dan hitung**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (3)(1) + (4)(2) = 3 + 8 = 11" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil $\\vec{a} \\cdot \\vec{b}$ adalah **11**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang vektor $\\vec{a} = (6, 8)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus panjang (modulus) vektor di bidang**" },
        { "tipe": "paragraph", "text": "Untuk vektor $\\vec{a} = (x, y)$, panjang vektornya adalah $|\\vec{a}| = \\sqrt{x^2 + y^2}$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusi nilai komponen dan hitung**" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = \\sqrt{100} = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang vektor $\\vec{a}$ adalah **10**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = (1, 0)$ dan $\\vec{b} = (1, 1)$. Sudut antara $\\vec{a}$ dan $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0°"}],
        [{"tipe":"paragraph","text":"30°"}],
        [{"tipe":"paragraph","text":"45°"}],
        [{"tipe":"paragraph","text":"60°"}],
        [{"tipe":"paragraph","text":"90°"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung hasil kali titik ($\\vec{a} \\cdot \\vec{b}$) dan panjang masing-masing vektor**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (1)(1) + (0)(1) = 1" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{1^2 + 0^2} = 1 \\quad \\text{dan} \\quad |\\vec{b}| = \\sqrt{1^2 + 1^2} = \\sqrt{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus kosinus sudut antara dua vektor**" },
        { "tipe": "formula_block", "latex": "\\cos \\theta = \\dfrac{\\vec{a} \\cdot \\vec{b}}{|\\vec{a}| \\cdot |\\vec{b}|} = \\dfrac{1}{1 \\cdot \\sqrt{2}} = \\dfrac{1}{\\sqrt{2}} = \\dfrac{1}{2}\\sqrt{2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan besar sudut $\\theta$**" },
        { "tipe": "paragraph", "text": "Nilai $\\cos \\theta = \\dfrac{1}{2}\\sqrt{2}$ untuk sudut lancip dipenuhi oleh $\\theta = 45^\\circ$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, sudut antara $\\vec{a}$ dan $\\vec{b}$ adalah **45°**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Vektor $\\vec{a} = (2, -3)$ dan $\\vec{b} = (4, 1)$. Hasil $2\\vec{a} - \\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"(0, -7)"}],
        [{"tipe":"paragraph","text":"(0, 7)"}],
        [{"tipe":"paragraph","text":"(0, -6)"}],
        [{"tipe":"paragraph","text":"(0, 6)"}],
        [{"tipe":"paragraph","text":"(6, -7)"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kalikan vektor $\\vec{a}$ dengan skalar $2$**" },
        { "tipe": "formula_block", "latex": "2\\vec{a} = 2(2, -3) = (4, -6)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kurangkan komponen-komponen $2\\vec{a}$ dengan $\\vec{b}$**" },
        { "tipe": "formula_block", "latex": "2\\vec{a} - \\vec{b} = (4, -6) - (4, 1) = (4 - 4, -6 - 1) = (0, -7)" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil $2\\vec{a} - \\vec{b}$ adalah **(0, -7)**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (3, 4)$ dan $\\vec{b} = (4, -3)$, maka $\\vec{a} \\cdot \\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-12"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"25"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung hasil kali titik (*dot product*) $\\vec{a} \\cdot \\vec{b}$**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (3)(4) + (4)(-3) = 12 + (-12) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Interpretasi geometris**" },
        { "tipe": "paragraph", "text": "Karena $\\vec{a} \\cdot \\vec{b} = 0$, maka $\\cos \\theta = 0$ ($\\theta = 90^\\circ$), yang berarti kedua vektor saling tegak lurus." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\vec{a} \\cdot \\vec{b}$ adalah **0**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang vektor $\\vec{a} = (1, 2, 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus panjang vektor di ruang tiga dimensi ($\\mathbb{R}^3$)**" },
        { "tipe": "paragraph", "text": "Untuk vektor $\\vec{a} = (x, y, z)$, panjang vektornya adalah $|\\vec{a}| = \\sqrt{x^2 + y^2 + z^2}$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusi nilai komponen dan hitung**" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{1^2 + 2^2 + 2^2} = \\sqrt{1 + 4 + 4} = \\sqrt{9} = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang vektor $\\vec{a}$ adalah **3**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Vektor $\\vec{a} = (2, 3)$ dan $\\vec{b} = (1, 5)$. Proyeksi skalar $\\vec{a}$ pada $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{17}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{15}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{13}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{11}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{7}{\\sqrt{26}}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung dot product $\\vec{a} \\cdot \\vec{b}$ dan panjang vektor $\\vec{b}$**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (2)(1) + (3)(5) = 2 + 15 = 17" },
        { "tipe": "formula_block", "latex": "|\\vec{b}| = \\sqrt{1^2 + 5^2} = \\sqrt{1 + 25} = \\sqrt{26}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus proyeksi skalar ortogonal $\\vec{a}$ pada $\\vec{b}$**" },
        { "tipe": "formula_block", "latex": "\\text{Proyeksi skalar} = \\dfrac{\\vec{a} \\cdot \\vec{b}}{|\\vec{b}|} = \\dfrac{17}{\\sqrt{26}}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, proyeksi skalar $\\vec{a}$ pada $\\vec{b}$ adalah **$\\dfrac{17}{\\sqrt{26}}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (2, -1)$ dan $\\vec{b} = (1, 3)$, nilai $\\cos \\theta$ antara kedua vektor adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{\\sqrt{50}}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{\\sqrt{5}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\sqrt{50}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\sqrt{5}}$"}],
        [{"tipe":"paragraph","text":"$0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $\\vec{a} \\cdot \\vec{b}$, $|\\vec{a}|$, dan $|\\vec{b}|$**" },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = (2)(1) + (-1)(3) = 2 - 3 = -1" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{2^2 + (-1)^2} = \\sqrt{4 + 1} = \\sqrt{5}" },
        { "tipe": "formula_block", "latex": "|\\vec{b}| = \\sqrt{1^2 + 3^2} = \\sqrt{1 + 9} = \\sqrt{10}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke rumus $\\cos \\theta$**" },
        { "tipe": "formula_block", "latex": "\\cos \\theta = \\dfrac{\\vec{a} \\cdot \\vec{b}}{|\\vec{a}| \\cdot |\\vec{b}|} = \\dfrac{-1}{\\sqrt{5} \\cdot \\sqrt{10}} = -\\dfrac{1}{\\sqrt{50}}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos \\theta$ antara kedua vektor adalah **$-\\dfrac{1}{\\sqrt{50}}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik $A(1, 2)$ dan $B(4, 6)$. Panjang vektor $\\overrightarrow{AB}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan komponen vektor posisi $\\overrightarrow{AB}$**" },
        { "tipe": "formula_block", "latex": "\\overrightarrow{AB} = B - A = (4 - 1, 6 - 2) = (3, 4)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung panjang vektor $\\overrightarrow{AB}$**" },
        { "tipe": "formula_block", "latex": "|\\overrightarrow{AB}| = \\sqrt{3^2 + 4^2} = \\sqrt{9 + 16} = \\sqrt{25} = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang vektor $\\overrightarrow{AB}$ adalah **5**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (x, 4)$ dan $|\\vec{a}| = 5$, maka nilai $x$ positif adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus panjang vektor dan kuadratkan kedua ruas**" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{x^2 + 4^2} = 5" },
        { "tipe": "formula_block", "latex": "x^2 + 16 = 25" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $x$**" },
        { "tipe": "formula_block", "latex": "x^2 = 25 - 16 = 9 \\Rightarrow x = \\pm 3" },
        { "tipe": "paragraph", "text": "Karena yang diminta adalah nilai $x$ yang positif, maka dipilih $x = 3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ positif adalah **3**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
