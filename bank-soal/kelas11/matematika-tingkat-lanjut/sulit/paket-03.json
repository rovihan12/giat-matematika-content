{
  "id": "bs-k11-mat-lanjut-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Vektor: dot product, panjang, & sudut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui vektor $\\vec{a} = (3, 4)$ dan $\\vec{b} = (1, 2)$. Hasil $\\vec{a} \\cdot \\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"15"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 3 \\cdot 1 + 4 \\cdot 2 = 3 + 8 = 11" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya 11." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang vektor $\\vec{a} = (6, 8)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = \\sqrt{100} = 10" },
        { "tipe": "paragraph", "text": "Jadi, panjangnya 10." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = (1, 0)$ dan $\\vec{b} = (1, 1)$. Sudut antara $\\vec{a}$ dan $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0°"}],
        [{"tipe":"paragraph","text":"30°"}],
        [{"tipe":"paragraph","text":"45°"}],
        [{"tipe":"paragraph","text":"60°"}],
        [{"tipe":"paragraph","text":"90°"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\vec{a} \\cdot \\vec{b} = 1 \\cdot 1 + 0 \\cdot 1 = 1$." },
        { "tipe": "paragraph", "text": "$|\\vec{a}| = 1$, $|\\vec{b}| = \\sqrt{2}$." },
        { "tipe": "formula_block", "latex": "\\cos \\theta = \\dfrac{1}{1 \\cdot \\sqrt{2}} = \\dfrac{\\sqrt{2}}{2} \\Rightarrow \\theta = 45°" },
        { "tipe": "paragraph", "text": "Jadi, sudutnya 45°." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Vektor $\\vec{a} = (2, -3)$ dan $\\vec{b} = (4, 1)$. Hasil $2\\vec{a} - \\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"(0, -7)"}],
        [{"tipe":"paragraph","text":"(0, 7)"}],
        [{"tipe":"paragraph","text":"(0, -6)"}],
        [{"tipe":"paragraph","text":"(0, 6)"}],
        [{"tipe":"paragraph","text":"(6, -7)"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2\\vec{a} = (4, -6)" },
        { "tipe": "formula_block", "latex": "2\\vec{a} - \\vec{b} = (4 - 4, -6 - 1) = (0, -7)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (3, 4)$ dan $\\vec{b} = (4, -3)$, maka $\\vec{a} \\cdot \\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-12"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"25"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 3 \\cdot 4 + 4 \\cdot (-3) = 12 - 12 = 0" },
        { "tipe": "paragraph", "text": "Karena dot product = 0, kedua vektor tegak lurus." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang vektor $\\vec{a} = (1, 2, 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{1^2 + 2^2 + 2^2} = \\sqrt{1 + 4 + 4} = \\sqrt{9} = 3" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Vektor $\\vec{a} = (2, 3)$ dan $\\vec{b} = (1, 5)$. Proyeksi skalar $\\vec{a}$ pada $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{17}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{15}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{13}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{11}{\\sqrt{26}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{7}{\\sqrt{26}}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Proyeksi skalar $\\vec{a}$ pada $\\vec{b}$: $\\dfrac{\\vec{a} \\cdot \\vec{b}}{|\\vec{b}|}$." },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 2 \\cdot 1 + 3 \\cdot 5 = 17; \\quad |\\vec{b}| = \\sqrt{1 + 25} = \\sqrt{26}" },
        { "tipe": "formula_block", "latex": "\\text{Proyeksi skalar} = \\dfrac{17}{\\sqrt{26}}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (2, -1)$ dan $\\vec{b} = (1, 3)$, nilai $\\cos \\theta$ antara kedua vektor adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{\\sqrt{50}}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{\\sqrt{5}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\sqrt{50}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\sqrt{5}}$"}],
        [{"tipe":"paragraph","text":"$0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\vec{a} \\cdot \\vec{b} = 2 \\cdot 1 + (-1) \\cdot 3 = 2 - 3 = -1$." },
        { "tipe": "paragraph", "text": "$|\\vec{a}| = \\sqrt{4 + 1} = \\sqrt{5}$; $|\\vec{b}| = \\sqrt{1 + 9} = \\sqrt{10}$." },
        { "tipe": "formula_block", "latex": "\\cos \\theta = \\dfrac{-1}{\\sqrt{5} \\cdot \\sqrt{10}} = \\dfrac{-1}{\\sqrt{50}}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik $A(1, 2)$ dan $B(4, 6)$. Panjang vektor $\\overrightarrow{AB}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\overrightarrow{AB} = (4 - 1, 6 - 2) = (3, 4)$." },
        { "tipe": "formula_block", "latex": "|\\overrightarrow{AB}| = \\sqrt{3^2 + 4^2} = \\sqrt{9 + 16} = 5" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-mat-lanjut-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (x, 4)$ dan $|\\vec{a}| = 5$, maka nilai $x$ positif adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\sqrt{x^2 + 4^2} = 5 \\Rightarrow x^2 + 16 = 25 \\Rightarrow x^2 = 9" },
        { "tipe": "paragraph", "text": "$x = \\pm 3$. Nilai $x$ positif = 3." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
