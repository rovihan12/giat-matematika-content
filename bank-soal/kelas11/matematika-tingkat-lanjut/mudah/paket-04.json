  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Derajat polinomial $P(x) = 6x^2 - 4x + 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"0"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pangkat tertinggi variabel $x$ adalah 2." },
        { "tipe": "paragraph", "text": "Jadi, derajatnya adalah 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(4)$ dari $P(x) = x^2 - 5x + 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"8"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(4) = 4^2 - 5(4) + 6 = 16 - 20 + 6 = 2" },
        { "tipe": "paragraph", "text": "Jadi, $P(4) = 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x + 3)(x^2 - x + 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 + 2x^2 - x + 6$"}],
        [{"tipe":"paragraph","text":"$x^3 + 2x^2 + x + 6$"}],
        [{"tipe":"paragraph","text":"$x^3 - 2x^2 - x + 6$"}],
        [{"tipe":"paragraph","text":"$x^3 + 2x^2 - x - 6$"}],
        [{"tipe":"paragraph","text":"$x^3 + 2x^2 + 5x + 6$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x+3)(x^2 - x + 2) = x^3 - x^2 + 2x + 3x^2 - 3x + 6 = x^3 + 2x^2 - x + 6" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $x^3 + 2x^2 - x + 6$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Koefisien $x$ dari $P(x) = 3x^3 - 2x^2 + 5x - 9$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-9"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"1"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Suku yang memuat $x$ adalah $5x$, jadi koefisiennya adalah 5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = 2x^3 - x^2 + 4x - 3$ oleh $(x - 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 2(1)^3 - (1)^2 + 4(1) - 3 = 2 - 1 + 4 - 3 = 2" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 + ax^2 - 2x + 8$ dan $P(2) = 20$, maka $a$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 8 + 4a - 4 + 8 = 4a + 12" },
        { "tipe": "paragraph", "text": "Diketahui $P(2) = 20$, maka $4a + 12 = 20 \\Rightarrow 4a = 8 \\Rightarrow a = 2$." },
        { "tipe": "paragraph", "text": "Jadi, $a = 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Faktor dari $P(x) = x^2 - 7x + 12$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-3)(x-4)$"}],
        [{"tipe":"paragraph","text":"$(x+3)(x+4)$"}],
        [{"tipe":"paragraph","text":"$(x-2)(x-6)$"}],
        [{"tipe":"paragraph","text":"$(x+2)(x+6)$"}],
        [{"tipe":"paragraph","text":"$(x-1)(x-12)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cari dua bilangan yang jumlahnya $-7$ dan hasil kalinya $12$: yaitu $-3$ dan $-4$." },
        { "tipe": "formula_block", "latex": "x^2 - 7x + 12 = (x-3)(x-4)" },
        { "tipe": "paragraph", "text": "Cek: $(x-3)(x-4) = x^2 - 4x - 3x + 12 = x^2 - 7x + 12$. Benar." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(2)$ dari $P(x) = x^4 - 3x^2 + 2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"8"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 2^4 - 3(2)^2 + 2 = 16 - 12 + 2 = 6" },
        { "tipe": "paragraph", "text": "Jadi, $P(2) = 6$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2x - 1)(x^2 + 3x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^3 + 5x^2 - 7x + 2$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 5x^2 + x - 2$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 5x^2 - 7x - 2$"}],
        [{"tipe":"paragraph","text":"$2x^3 - 5x^2 - 7x + 2$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 5x^2 + 7x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(2x-1)(x^2+3x-2) = 2x^3 + 6x^2 - 4x - x^2 - 3x + 2 = 2x^3 + 5x^2 - 7x + 2" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $2x^3 + 5x^2 - 7x + 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(x - 2)$ faktor dari $P(x) = x^3 - 5x^2 + ax - 6$, maka $a$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena $(x-2)$ faktor, maka $P(2) = 0$." },
        { "tipe": "formula_block", "latex": "P(2) = 8 - 20 + 2a - 6 = 2a - 18 = 0 \\Rightarrow a = 9" },
        { "tipe": "paragraph", "text": "Jadi, $a = 9$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
