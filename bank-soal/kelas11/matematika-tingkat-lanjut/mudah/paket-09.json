{
  "id": "bs-k11-mat-lanjut-mudah-09",
  "nama": "Bank Soal Mudah - Paket 9",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Vektor, matriks, & trigonometri dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui vektor $\\vec{a} = (3, 4)$ dan $\\vec{b} = (1, 2)$. Hasil $\\vec{a} \\cdot \\vec{b}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"13"}],
        [{"tipe":"paragraph","text":"15"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dot product $\\vec{a} \\cdot \\vec{b} = a_1b_1 + a_2b_2$." },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 3(1) + 4(2) = 3 + 8 = 11" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2 & 3 \\\\ 1 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 1 & 0 \\\\ 2 & 3 \\end{pmatrix}$. Hasil $A + B$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 7 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 3 \\\\ 3 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 0 \\\\ 2 & 12 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Penjumlahan matriks dilakukan dengan menjumlahkan elemen yang bersesuaian." },
        { "tipe": "formula_block", "latex": "A + B = \\begin{pmatrix} 2+1 & 3+0 \\\\ 1+2 & 4+3 \\end{pmatrix} = \\begin{pmatrix} 3 & 3 \\\\ 3 & 7 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari matriks $A = \\begin{pmatrix} 3 & 2 \\\\ 4 & 5 \\end{pmatrix}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"23"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk matriks $\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}$, determinannya adalah $ad - bc$." },
        { "tipe": "formula_block", "latex": "\\det(A) = 3(5) - 2(4) = 15 - 8 = 7" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$. Hasil $2A$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 4 \\\\ 6 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 2 \\\\ 3 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 4 \\\\ 6 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 4 \\\\ 6 & 2 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Perkalian skalar dengan matriks dilakukan dengan mengalikan setiap elemen matriks dengan skalar tersebut." },
        { "tipe": "formula_block", "latex": "2A = 2\\begin{pmatrix} 1 & 2 \\\\ 3 & 4 \\end{pmatrix} = \\begin{pmatrix} 2 & 4 \\\\ 6 & 8 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Transpose dari matriks $A = \\begin{pmatrix} 1 & 2 & 3 \\\\ 4 & 5 & 6 \\end{pmatrix}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 4 \\\\ 2 & 5 \\\\ 3 & 6 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 4 & 5 & 6 \\\\ 1 & 2 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 & 3 \\\\ 4 & 5 & 6 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 3 & 2 & 1 \\\\ 6 & 5 & 4 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 6 & 5 & 4 \\\\ 3 & 2 & 1 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Transpose matriks adalah menukar baris menjadi kolom dan kolom menjadi baris." },
        { "tipe": "formula_block", "latex": "A^T = \\begin{pmatrix} 1 & 4 \\\\ 2 & 5 \\\\ 3 & 6 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyaknya anggota himpunan penyelesaian dari persamaan trigonometri $\\sin x = \\frac{1}{2}$ untuk $0^\\circ \\le x \\le 360^\\circ$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin x = \\frac{1}{2}$ dipenuhi oleh $x = 30^\\circ$ dan $x = 150^\\circ$ pada interval $0^\\circ \\le x \\le 360^\\circ$." },
        { "tipe": "paragraph", "text": "Jadi, ada 2 anggota himpunan penyelesaian." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga sembarang dengan $\\angle A = 30^\\circ$, $\\angle B = 45^\\circ$, dan panjang sisi $a = 10$. Maka panjang sisi $b$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$10\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$10\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$\\frac{10 \\sin 45^\\circ}{\\sin 30^\\circ}$"}],
        [{"tipe":"paragraph","text":"$\\frac{10 \\sin 30^\\circ}{\\sin 45^\\circ}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan sinus: $\\frac{a}{\\sin A} = \\frac{b}{\\sin B}$." },
        { "tipe": "formula_block", "latex": "\\frac{10}{\\sin 30^\\circ} = \\frac{b}{\\sin 45^\\circ}" },
        { "tipe": "formula_block", "latex": "b = \\frac{10 \\sin 45^\\circ}{\\sin 30^\\circ} = \\frac{10 \\cdot \\frac{\\sqrt{2}}{2}}{\\frac{1}{2}} = 10\\sqrt{2}" },
        { "tipe": "paragraph", "text": "Jadi, panjang sisi $b$ adalah $10\\sqrt{2}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga lancip $ABC$ diketahui panjang sisi $AC = 3$ cm, $AB = \\sqrt{5}$ cm, dan $\\cos B = \\frac{4}{5}$, maka $\\cos C = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{\\sqrt{5}}{5}$"}],
        [{"tipe":"paragraph","text":"$\\frac{2\\sqrt{5}}{5}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3\\sqrt{5}}{5}$"}],
        [{"tipe":"paragraph","text":"$\\frac{4\\sqrt{5}}{5}$"}],
        [{"tipe":"paragraph","text":"$\\frac{\\sqrt{5}}{10}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena $\\cos B = \\frac{4}{5}$, maka $\\sin B = \\sqrt{1 - \\left(\\frac{4}{5}\\right)^2} = \\frac{3}{5}$." },
        { "tipe": "paragraph", "text": "Gunakan aturan sinus untuk mencari $\\sin C$:" },
        { "tipe": "formula_block", "latex": "\\frac{AC}{\\sin B} = \\frac{AB}{\\sin C} \\Rightarrow \\frac{3}{\\frac{3}{5}} = \\frac{\\sqrt{5}}{\\sin C} \\Rightarrow 5 = \\frac{\\sqrt{5}}{\\sin C} \\Rightarrow \\sin C = \\frac{\\sqrt{5}}{5}" },
        { "tipe": "paragraph", "text": "Karena segitiga $ABC$ lancip, nilai $\\cos C$ bernilai positif:" },
        { "tipe": "formula_block", "latex": "\\cos C = \\sqrt{1 - \\sin^2 C} = \\sqrt{1 - \\left(\\frac{\\sqrt{5}}{5}\\right)^2} = \\sqrt{1 - \\frac{5}{25}} = \\sqrt{\\frac{20}{25}} = \\frac{2\\sqrt{5}}{5}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$, jika sudut $A = 30^\\circ$, sudut $B = 45^\\circ$, dan sisi $AC = 12$ cm maka panjang sisi $BC$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4\\sqrt{2}$ cm"}],
        [{"tipe":"paragraph","text":"$4\\sqrt{3}$ cm"}],
        [{"tipe":"paragraph","text":"$4\\sqrt{6}$ cm"}],
        [{"tipe":"paragraph","text":"$6\\sqrt{2}$ cm"}],
        [{"tipe":"paragraph","text":"$6\\sqrt{6}$ cm"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan sinus: $\\frac{BC}{\\sin A} = \\frac{AC}{\\sin B}$." },
        { "tipe": "formula_block", "latex": "\\frac{BC}{\\sin 30^\\circ} = \\frac{12}{\\sin 45^\\circ}" },
        { "tipe": "formula_block", "latex": "BC = \\frac{12 \\cdot \\sin 30^\\circ}{\\sin 45^\\circ} = \\frac{12 \\cdot \\frac{1}{2}}{\\frac{1}{2}\\sqrt{2}} = \\frac{6}{\\frac{1}{2}\\sqrt{2}} = \\frac{12}{\\sqrt{2}} = 6\\sqrt{2} \\text{ cm}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 20^\\circ \\sin 40^\\circ \\sin 80^\\circ$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{1}{8}$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{\\sqrt{3}}{8}$"}],
        [{"tipe":"paragraph","text":"$\\frac{\\sqrt{3}}{4}$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas trigonometri: $\\sin x \\sin(60^\\circ - x) \\sin(60^\\circ + x) = \\frac{1}{4} \\sin 3x$." },
        { "tipe": "paragraph", "text": "Untuk $x = 20^\\circ$:" },
        { "tipe": "formula_block", "latex": "\\sin 20^\\circ \\sin(60^\\circ - 20^\\circ) \\sin(60^\\circ + 20^\\circ) = \\sin 20^\\circ \\sin 40^\\circ \\sin 80^\\circ" },
        { "tipe": "formula_block", "latex": "= \\frac{1}{4} \\sin(3 \\cdot 20^\\circ) = \\frac{1}{4} \\sin 60^\\circ = \\frac{1}{4} \\left(\\frac{\\sqrt{3}}{2}\\right) = \\frac{\\sqrt{3}}{8}" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
