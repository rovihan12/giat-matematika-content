{
  "id": "bs-k11-mat-lanjut-mudah-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Polinomial: derajat, nilai, & operasi dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Derajat dari polinomial $P(x) = 3x^4 - 2x^3 + 5x - 7$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat polinomial = pangkat tertinggi variabel $x$." },
        { "tipe": "paragraph", "text": "Pada $P(x) = 3x^4 - 2x^3 + 5x - 7$, pangkat tertinggi adalah 4." },
        { "tipe": "paragraph", "text": "Jadi, derajatnya adalah 4." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(2)$ dari $P(x) = x^3 - 4x^2 + 3x + 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 2^3 - 4(2)^2 + 3(2) + 1 = 8 - 16 + 6 + 1 = -1" },
        { "tipe": "paragraph", "text": "Jadi, $P(2) = -1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Koefisien $x^3$ dari polinomial $5x^4 - 3x^3 + 2x^2 - x + 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Suku dengan variabel $x^3$ adalah $-3x^3$." },
        { "tipe": "paragraph", "text": "Sehingga koefisiennya adalah $-3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2x^2 + 3x - 1) + (x^2 - 4x + 5)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^2 - x + 4$"}],
        [{"tipe":"paragraph","text":"$3x^2 + x + 4$"}],
        [{"tipe":"paragraph","text":"$3x^2 - x - 4$"}],
        [{"tipe":"paragraph","text":"$x^2 - x + 4$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 7x + 4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan suku-suku sejenis." },
        { "tipe": "formula_block", "latex": "(2x^2 + x^2) + (3x - 4x) + (-1 + 5) = 3x^2 - x + 4" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $3x^2 - x + 4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(3x^2 - x + 2) - (x^2 + 4x - 3)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^2 - 5x + 5$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 5x + 5$"}],
        [{"tipe":"paragraph","text":"$2x^2 - 5x - 5$"}],
        [{"tipe":"paragraph","text":"$4x^2 - 5x + 5$"}],
        [{"tipe":"paragraph","text":"$2x^2 - 3x + 5$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(3x^2 - x + 2) - (x^2 + 4x - 3) = 3x^2 - x^2 - x - 4x + 2 + 3 = 2x^2 - 5x + 5" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $2x^2 - 5x + 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2x(x^2 - 3x + 4)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^3 - 6x^2 + 8x$"}],
        [{"tipe":"paragraph","text":"$2x^3 - 3x^2 + 4x$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 6x^2 + 8x$"}],
        [{"tipe":"paragraph","text":"$2x^2 - 6x + 8$"}],
        [{"tipe":"paragraph","text":"$2x^3 - 6x^2 - 8x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2x(x^2 - 3x + 4) = 2x \\cdot x^2 - 2x \\cdot 3x + 2x \\cdot 4 = 2x^3 - 6x^2 + 8x" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $2x^3 - 6x^2 + 8x$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tetap (konstanta) dari polinomial $4x^3 - 2x^2 + 7x - 9$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"-9"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Suku tetap adalah suku yang tidak memuat variabel, yaitu $-9$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^2 + 2x - 3$, maka nilai $P(-1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-1) = (-1)^2 + 2(-1) - 3 = 1 - 2 - 3 = -4" },
        { "tipe": "paragraph", "text": "Jadi, $P(-1) = -4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Derajat dari hasil kali $P(x) = (x^2 + 1)(x^3 - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"1"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat hasil kali = jumlah derajat kedua faktor = 2 + 3 = 5." },
        { "tipe": "paragraph", "text": "Jadi, derajatnya adalah 5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(0)$ dari $P(x) = 3x^3 - 5x^2 + 2x + 8$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"-8"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(0)$ sama dengan suku tetap polinomial." },
        { "tipe": "paragraph", "text": "Suku tetap dari $P(x) = 3x^3 - 5x^2 + 2x + 8$ adalah 8." },
        { "tipe": "paragraph", "text": "Jadi, $P(0) = 8$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
