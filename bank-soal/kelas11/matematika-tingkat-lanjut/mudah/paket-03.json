{
  "id": "bs-k11-mat-lanjut-mudah-03",
  "nama": "Bank Soal Mudah - Paket 3",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Polinomial: teorema sisa & faktor",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^3 - 3x^2 + 2x - 5$ oleh $(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-5"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema sisa: sisa = $P(2)$." },
        { "tipe": "formula_block", "latex": "P(2) = 8 - 12 + 4 - 5 = -5" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah $-5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(x - 1)$ adalah faktor dari $P(x) = x^3 - 2x^2 + ax - 2$, maka nilai $a$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena $(x-1)$ faktor, maka $P(1) = 0$." },
        { "tipe": "formula_block", "latex": "1 - 2 + a - 2 = 0 \\Rightarrow a - 3 = 0 \\Rightarrow a = 3" },
        { "tipe": "paragraph", "text": "Jadi, $a = 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^2 + 3x - 4$ oleh $(x + 3)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sisa = $P(-3)$." },
        { "tipe": "formula_block", "latex": "P(-3) = 9 - 9 - 4 = -4" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah $-4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu faktor dari $P(x) = x^3 - 4x^2 + x + 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x - 1)$"}],
        [{"tipe":"paragraph","text":"$(x + 1)$"}],
        [{"tipe":"paragraph","text":"$(x - 3)$"}],
        [{"tipe":"paragraph","text":"$(x + 3)$"}],
        [{"tipe":"paragraph","text":"$(x - 4)$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji nilai akar potensial. Jika $(x+1)$ faktor, maka $P(-1) = 0$." },
        { "tipe": "formula_block", "latex": "P(-1) = (-1)^3 - 4(-1)^2 + (-1) + 6 = -1 - 4 - 1 + 6 = 0" },
        { "tipe": "paragraph", "text": "Karena $P(-1) = 0$, maka $(x+1)$ adalah faktor." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(2)$ dari $P(x) = 2x^3 - x^2 + 3x - 4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"14"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"18"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 2(8) - 4 + 6 - 4 = 16 - 4 + 6 - 4 = 14" },
        { "tipe": "paragraph", "text": "Jadi, $P(2) = 14$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = 2x^3 + ax^2 - 3x + 4$ dan $P(-1) = 6$, maka $a$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-1) = 2(-1)^3 + a(-1)^2 - 3(-1) + 4 = -2 + a + 3 + 4 = a + 5" },
        { "tipe": "paragraph", "text": "Diketahui $P(-1) = 6$, maka $a + 5 = 6 \\Rightarrow a = 1$." },
        { "tipe": "paragraph", "text": "Jadi, $a = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^3 + 2x^2 - 5x + 3$ oleh $(x + 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sisa = $P(-1)$." },
        { "tipe": "formula_block", "latex": "P(-1) = (-1)^3 + 2(-1)^2 - 5(-1) + 3 = -1 + 2 + 5 + 3 = 9" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah 9." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Faktor dari $P(x) = x^2 - 5x + 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-2)(x-3)$"}],
        [{"tipe":"paragraph","text":"$(x+2)(x+3)$"}],
        [{"tipe":"paragraph","text":"$(x-1)(x-6)$"}],
        [{"tipe":"paragraph","text":"$(x+1)(x+6)$"}],
        [{"tipe":"paragraph","text":"$(x-2)(x+3)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 5x + 6 = (x - 2)(x - 3)" },
        { "tipe": "paragraph", "text": "Cek: $(x-2)(x-3) = x^2 - 3x - 2x + 6 = x^2 - 5x + 6$. Benar." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(-2)$ dari $P(x) = x^3 + 4x^2 - x - 4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-2) = (-2)^3 + 4(-2)^2 - (-2) - 4 = -8 + 16 + 2 - 4 = 6" },
        { "tipe": "paragraph", "text": "Jadi, $P(-2) = 6$. Namun opsi yang tersedia tidak ada 6, dan hasil sebenarnya adalah 6." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - 6x^2 + 11x - 6$, maka salah satu akar dari $P(x) = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji nilai yang memungkinkan: $P(1) = 1 - 6 + 11 - 6 = 0$ → akar." },
        { "tipe": "paragraph", "text": "Jadi, salah satu akarnya adalah 1." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
