{
  "id": "bs-k11-mat-lanjut-mudah-06",
  "nama": "Bank Soal Mudah - Paket 6",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Trigonometri dasar & relasi sudut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perbandingan trigonometri yang ekuivalen dengan $\\tan \\alpha \\cdot \\sin \\alpha + \\cos \\alpha$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sec \\alpha$"}],
        [{"tipe":"paragraph","text":"$\\sin \\alpha$"}],
        [{"tipe":"paragraph","text":"$\\csc \\alpha$"}],
        [{"tipe":"paragraph","text":"$\\cot \\alpha$"}],
        [{"tipe":"paragraph","text":"$\\cos \\alpha$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah $\\tan \\alpha$ menjadi $\\frac{\\sin \\alpha}{\\cos \\alpha}$:" },
        { "tipe": "formula_block", "latex": "\\tan \\alpha \\cdot \\sin \\alpha + \\cos \\alpha = \\left(\\frac{\\sin \\alpha}{\\cos \\alpha}\\right) \\sin \\alpha + \\cos \\alpha" },
        { "tipe": "formula_block", "latex": "= \\frac{\\sin^2 \\alpha}{\\cos \\alpha} + \\frac{\\cos^2 \\alpha}{\\cos \\alpha} = \\frac{\\sin^2 \\alpha + \\cos^2 \\alpha}{\\cos \\alpha}" },
        { "tipe": "paragraph", "text": "Karena $\\sin^2 \\alpha + \\cos^2 \\alpha = 1$, maka:" },
        { "tipe": "formula_block", "latex": "= \\frac{1}{\\cos \\alpha} = \\sec \\alpha" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\frac{1 - \\sin^2 x}{\\cos x} + \\cos x$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\tan x$"}],
        [{"tipe":"paragraph","text":"$\\cos x + \\tan x$"}],
        [{"tipe":"paragraph","text":"$\\sec x$"}],
        [{"tipe":"paragraph","text":"$2 \\cos x$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{\\cos x}$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\sin^2 x = \\cos^2 x$:" },
        { "tipe": "formula_block", "latex": "\\frac{\\cos^2 x}{\\cos x} + \\cos x = \\cos x + \\cos x = 2 \\cos x" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\cos 45^\\circ = \\sin x$. Nilai $x$ yang memenuhi di kuadran pertama adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$30^\\circ$"}],
        [{"tipe":"paragraph","text":"$45^\\circ$"}],
        [{"tipe":"paragraph","text":"$60^\\circ$"}],
        [{"tipe":"paragraph","text":"$90^\\circ$"}],
        [{"tipe":"paragraph","text":"$0^\\circ$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas sudut berpenyiku: $\\cos \\alpha = \\sin(90^\\circ - \\alpha)$." },
        { "tipe": "paragraph", "text": "Maka $\\cos 45^\\circ = \\sin(90^\\circ - 45^\\circ) = \\sin 45^\\circ$." },
        { "tipe": "paragraph", "text": "Jadi, $x = 45^\\circ$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\sin(270^\\circ + \\alpha) - \\sin(270^\\circ - \\alpha) + \\sin(180^\\circ + \\alpha)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sin \\alpha$"}],
        [{"tipe":"paragraph","text":"$\\cos \\alpha$"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"$-\\sin \\alpha$"}],
        [{"tipe":"paragraph","text":"$-\\cos \\alpha$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sederhanakan masing-masing suku:" },
        { "tipe": "paragraph", "text": "$\\sin(270^\\circ + \\alpha) = -\\cos \\alpha$" },
        { "tipe": "paragraph", "text": "$\\sin(270^\\circ - \\alpha) = -\\cos \\alpha$" },
        { "tipe": "paragraph", "text": "$\\sin(180^\\circ + \\alpha) = -\\sin \\alpha$" },
        { "tipe": "paragraph", "text": "Substitusi kembali:" },
        { "tipe": "formula_block", "latex": "(-\\cos \\alpha) - (-\\cos \\alpha) + (-\\sin \\alpha) = -\\cos \\alpha + \\cos \\alpha - \\sin \\alpha = -\\sin \\alpha" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika diketahui fungsi $y = 10 \\sin x - 4$, maka amplitudo dari fungsi tersebut adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"14"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bentuk umum fungsi sinus adalah $y = A \\sin(bx) + c$, di mana $|A|$ adalah amplitudo." },
        { "tipe": "paragraph", "text": "Dari $y = 10 \\sin x - 4$, koefisien $\\sin x$ adalah 10." },
        { "tipe": "paragraph", "text": "Jadi, amplitudonya adalah $|10| = 10$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin A = \\frac{3}{5}$ dan $\\sin B = \\frac{7}{25}$, dengan A sudut lancip dan B sudut tumpul. Nilai $\\cos(A + B)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\frac{44}{125}$"}],
        [{"tipe":"paragraph","text":"$\\frac{44}{125}$"}],
        [{"tipe":"paragraph","text":"$-\\frac{117}{125}$"}],
        [{"tipe":"paragraph","text":"$\\frac{117}{125}$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{125}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena A lancip, $\\cos A = \\sqrt{1 - (3/5)^2} = \\sqrt{16/25} = 4/5$." },
        { "tipe": "paragraph", "text": "Karena B tumpul, $\\cos B = -\\sqrt{1 - (7/25)^2} = -\\sqrt{576/625} = -24/25$." },
        { "tipe": "formula_block", "latex": "\\cos(A + B) = \\cos A \\cos B - \\sin A \\sin B" },
        { "tipe": "formula_block", "latex": "= \\left(\\frac{4}{5}\\right)\\left(-\\frac{24}{25}\\right) - \\left(\\frac{3}{5}\\right)\\left(\\frac{7}{25}\\right)" },
        { "tipe": "formula_block", "latex": "= -\\frac{96}{125} - \\frac{21}{125} = -\\frac{117}{125}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga PQR dengan $\\angle Q = 90^\\circ$, $PQ = 6$, dan $QR = 8$. Nilai $\\sin P$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{3}{5}$"}],
        [{"tipe":"paragraph","text":"$\\frac{4}{5}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$\\frac{5}{8}$"}],
        [{"tipe":"paragraph","text":"$\\frac{6}{10}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Segitiga PQR siku-siku di Q. Sisi miring PR dapat dicari dengan Pythagoras:" },
        { "tipe": "formula_block", "latex": "PR = \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = 10" },
        { "tipe": "paragraph", "text": "$\\sin P = \\frac{\\text{sisi di depan } P}{\\text{sisi miring}} = \\frac{QR}{PR} = \\frac{8}{10} = \\frac{4}{5}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam segitiga ABC, diketahui $a = 3$, $b = 8$, dan $\\angle C = 60^\\circ$. Panjang sisi $c$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"$6\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"$8\\sqrt{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan kosinus:" },
        { "tipe": "formula_block", "latex": "c^2 = a^2 + b^2 - 2ab \\cos C" },
        { "tipe": "formula_block", "latex": "c^2 = 3^2 + 8^2 - 2(3)(8) \\cos 60^\\circ" },
        { "tipe": "formula_block", "latex": "c^2 = 9 + 64 - 48 \\left(\\frac{1}{2}\\right) = 73 - 24 = 49" },
        { "tipe": "formula_block", "latex": "c = \\sqrt{49} = 7" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi pertumbuhan bakteri diberikan oleh $N(t) = 200 \\cdot 2^t$. Jika $t$ dalam jam, kapan jumlah bakteri mencapai 3200?" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3 jam"}],
        [{"tipe":"paragraph","text":"4 jam"}],
        [{"tipe":"paragraph","text":"5 jam"}],
        [{"tipe":"paragraph","text":"6 jam"}],
        [{"tipe":"paragraph","text":"7 jam"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $N(t) = 3200$:" },
        { "tipe": "formula_block", "latex": "200 \\cdot 2^t = 3200" },
        { "tipe": "formula_block", "latex": "2^t = \\frac{3200}{200} = 16" },
        { "tipe": "paragraph", "text": "Karena $2^4 = 16$, maka $t = 4$ jam." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $^5\\log 3 = p$, maka nilai dari $^{15}\\log 81$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{4p}{p + 1}$"}],
        [{"tipe":"paragraph","text":"$\\frac{4p}{p - 1}$"}],
        [{"tipe":"paragraph","text":"$\\frac{p + 1}{4p}$"}],
        [{"tipe":"paragraph","text":"$4(1 + p)$"}],
        [{"tipe":"paragraph","text":"$4(1 - p)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat logaritma:" },
        { "tipe": "formula_block", "latex": "^{15}\\log 81 = \\frac{\\log 81}{\\log 15} = \\frac{\\log 3^4}{\\log(3 \\cdot 5)} = \\frac{4 \\log 3}{\\log 3 + \\log 5}" },
        { "tipe": "paragraph", "text": "Diketahui $^5\\log 3 = p$, maka $\\frac{\\log 3}{\\log 5} = p \\Rightarrow \\log 3 = p \\log 5$." },
        { "tipe": "paragraph", "text": "Substitusi:" },
        { "tipe": "formula_block", "latex": "= \\frac{4(p \\log 5)}{p \\log 5 + \\log 5} = \\frac{4p \\log 5}{(p + 1)\\log 5} = \\frac{4p}{p + 1}" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
