{
  "id": "bs-k11-mat-lanjut-mudah-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Polinomial: campuran konsep dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Derajat polinomial $P(x) = 2x^6 - x^3 + 5x - 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat polinomial ditentukan oleh pangkat tertinggi variabel $x$." },
        { "tipe": "paragraph", "text": "Pada $P(x) = 2x^6 - x^3 + 5x - 1$, pangkat tertinggi adalah 6." },
        { "tipe": "paragraph", "text": "Jadi, derajatnya adalah 6." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(3)$ dari $P(x) = x^2 - 4x + 3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(3) = 3^2 - 4(3) + 3 = 9 - 12 + 3 = 0" },
        { "tipe": "paragraph", "text": "Jadi, $P(3) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Koefisien $x^2$ dari $P(x) = 3x^4 - 2x^2 + 7x - 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"1"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Suku yang memuat variabel $x^2$ adalah $-2x^2$." },
        { "tipe": "paragraph", "text": "Koefisiennya adalah $-2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^2 + 2x - 3) + (2x^2 - x + 5)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^2 + x + 2$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 3x + 2$"}],
        [{"tipe":"paragraph","text":"$3x^2 + x + 8$"}],
        [{"tipe":"paragraph","text":"$x^2 + x + 2$"}],
        [{"tipe":"paragraph","text":"$3x^2 - x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan suku-suku sejenis." },
        { "tipe": "formula_block", "latex": "(x^2 + 2x - 3) + (2x^2 - x + 5) = 3x^2 + x + 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^3 + x^2 - 4x + 2$ oleh $(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menurut teorema sisa, sisa pembagian oleh $(x - 2)$ adalah $P(2)$." },
        { "tipe": "formula_block", "latex": "P(2) = 2^3 + 2^2 - 4(2) + 2 = 8 + 4 - 8 + 2 = 6" },
        { "tipe": "paragraph", "text": "Jadi, sisanya adalah 6." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Faktor dari $x^3 - 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-1)(x^2+x+1)$"}],
        [{"tipe":"paragraph","text":"$(x+1)(x^2-x+1)$"}],
        [{"tipe":"paragraph","text":"$(x-1)(x^2-x+1)$"}],
        [{"tipe":"paragraph","text":"$(x+1)(x^2+x+1)$"}],
        [{"tipe":"paragraph","text":"$(x-1)^3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas selisih kubus: $a^3 - b^3 = (a-b)(a^2 + ab + b^2)$." },
        { "tipe": "formula_block", "latex": "x^3 - 1 = (x-1)(x^2 + x + 1)" },
        { "tipe": "paragraph", "text": "Jadi, faktor-faktornya adalah $(x-1)(x^2 + x + 1)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^2 + bx + c$ dengan $P(1) = 0$ dan $P(2) = 3$, maka nilai $b$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 1$: $1 + b + c = 0 \\Rightarrow b + c = -1$." },
        { "tipe": "paragraph", "text": "Substitusi $x = 2$: $4 + 2b + c = 3 \\Rightarrow 2b + c = -1$." },
        { "tipe": "paragraph", "text": "Kurangkan kedua persamaan: $(2b + c) - (b + c) = -1 - (-1)$." },
        { "tipe": "formula_block", "latex": "b = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai $b = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(-1)$ dari $P(x) = 3x^3 + 2x^2 - x + 5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-1) = 3(-1)^3 + 2(-1)^2 - (-1) + 5 = -3 + 2 + 1 + 5 = 5" },
        { "tipe": "paragraph", "text": "Jadi, $P(-1) = 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x - 3)^3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 - 9x^2 + 27x - 27$"}],
        [{"tipe":"paragraph","text":"$x^3 - 6x^2 + 9x - 27$"}],
        [{"tipe":"paragraph","text":"$x^3 - 3x^2 + 3x - 27$"}],
        [{"tipe":"paragraph","text":"$x^3 - 9x^2 + 9x - 27$"}],
        [{"tipe":"paragraph","text":"$x^3 - 27$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas kubus selisih: $(a-b)^3 = a^3 - 3a^2 b + 3ab^2 - b^3$." },
        { "tipe": "formula_block", "latex": "(x-3)^3 = x^3 - 3x^2(3) + 3x(3)^2 - 3^3 = x^3 - 9x^2 + 27x - 27" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $x^3 - 9x^2 + 27x - 27$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = 2x^3 - x^2 + 3x - 4$, maka nilai $P(0) + P(1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(0)$ sama dengan suku tetap, yaitu $-4$." },
        { "tipe": "paragraph", "text": "$P(1) = 2(1)^3 - (1)^2 + 3(1) - 4 = 2 - 1 + 3 - 4 = 0$." },
        { "tipe": "formula_block", "latex": "P(0) + P(1) = -4 + 0 = -4" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya adalah $-4$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
