{
  "id": "bs-k11-mat-lanjut-mudah-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Polinomial: operasi & nilai suku banyak",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Derajat dari $Q(x) = 7x^5 - x^3 + 4x - 2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"1"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat = pangkat tertinggi variabel $x$." },
        { "tipe": "paragraph", "text": "Pangkat tertinggi pada $Q(x) = 7x^5 - x^3 + 4x - 2$ adalah 5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(3)$ dari $P(x) = 2x^2 - 5x + 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(3) = 2(9) - 5(3) + 1 = 18 - 15 + 1 = 4" },
        { "tipe": "paragraph", "text": "Jadi, $P(3) = 4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Koefisien $x^2$ dari $P(x) = -x^4 + 4x^2 - 3x + 7$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Suku $x^2$ adalah $4x^2$, jadi koefisiennya 4." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^2 + 2x + 1)(x - 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 + x^2 - x - 1$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 + x - 1$"}],
        [{"tipe":"paragraph","text":"$x^3 - x^2 + x - 1$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2 - x + 1$"}],
        [{"tipe":"paragraph","text":"$x^3 - x^2 - x + 1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x^2 + 2x + 1)(x - 1) = x^3 - x^2 + 2x^2 - 2x + x - 1 = x^3 + x^2 - x - 1" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $x^3 + x^2 - x - 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tetap dari $P(x) = 5x^4 - 3x^2 + 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"-6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Suku tetap adalah 6 (tidak mengandung $x$)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - 2x + 1$, maka $P(1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 - 2 + 1 = 0" },
        { "tipe": "paragraph", "text": "Jadi, $P(1) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3x^2(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^3 - 6x^2$"}],
        [{"tipe":"paragraph","text":"$3x^3 + 6x^2$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 6x$"}],
        [{"tipe":"paragraph","text":"$3x^3 - 2$"}],
        [{"tipe":"paragraph","text":"$3x^3 - 6x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "3x^2(x - 2) = 3x^2 \\cdot x - 3x^2 \\cdot 2 = 3x^3 - 6x^2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Derajat hasil penjumlahan $(x^3 + 2x) + (x^2 + 5)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hasil penjumlahannya adalah $x^3 + x^2 + 2x + 5$." },
        { "tipe": "paragraph", "text": "Pangkat tertinggi = 3, jadi derajatnya 3." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(-2)$ dari $P(x) = x^2 - 3x + 5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"11"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"-5"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(-2) = (-2)^2 - 3(-2) + 5 = 4 + 6 + 5 = 15" },
        { "tipe": "paragraph", "text": "Jadi, $P(-2) = 15$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial $P(x) = 4x^3 - 2x^2 + x - 6$ memiliki suku banyak sebanyak ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Suku-sukunya: $4x^3$, $-2x^2$, $x$, dan $-6$." },
        { "tipe": "paragraph", "text": "Jumlahnya ada 4 suku." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
