{
  "id": "bs-k11-mat-lanjut-mudah-10",
  "nama": "Bank Soal Mudah - Paket 10",
  "kelas": 11,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Matriks: ordo, jenis, & kesamaan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Elemen matriks kolom ke tiga baris ke dua pada matriks $W = \\begin{pmatrix} 1 & 2 & -4 \\\\ 0 & -8 & -9 \\\\ 5 & 6 & -3 \\end{pmatrix}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"-8"}],
        [{"tipe":"paragraph","text":"-9"}],
        [{"tipe":"paragraph","text":"-3"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Baris ke dua adalah $(0, -8, -9)$." },
        { "tipe": "paragraph", "text": "Kolom ke tiga dari baris tersebut adalah elemen ketiga, yaitu $-9$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Berapakah ordo matriks berikut? $S = \\begin{pmatrix} 1 & 3 & 2 & 2 & 2 \\\\ 2 & 3 & 4 & 6 & 7 \\\\ 3 & 4 & 5 & 1 & 2 \\end{pmatrix}$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5\\times3$"}],
        [{"tipe":"paragraph","text":"$3\\times5$"}],
        [{"tipe":"paragraph","text":"$5\\times5$"}],
        [{"tipe":"paragraph","text":"$4\\times5$"}],
        [{"tipe":"paragraph","text":"$3\\times4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ordo matriks ditentukan oleh jumlah baris $\\times$ jumlah kolom." },
        { "tipe": "paragraph", "text": "Matriks $S$ memiliki 3 baris dan 5 kolom." },
        { "tipe": "paragraph", "text": "Jadi, ordonya adalah $3\\times5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks berikut termasuk matriks .... $V = \\begin{pmatrix} 4 \\\\ 5 \\\\ 1 \\end{pmatrix}$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Tegak"}],
        [{"tipe":"paragraph","text":"Berdiri"}],
        [{"tipe":"paragraph","text":"Datar"}],
        [{"tipe":"paragraph","text":"Baris"}],
        [{"tipe":"paragraph","text":"Kolom"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Matriks $V$ hanya memiliki 1 kolom dan 3 baris." },
        { "tipe": "paragraph", "text": "Matriks yang hanya memiliki satu kolom disebut matriks kolom." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks $A = \\begin{pmatrix} 2a + b & c \\\\ a & 2d \\end{pmatrix}$ dan $B = \\begin{pmatrix} 24 & 4 \\\\ 6 & 10 \\end{pmatrix}$. Jika $A = B$, berapakah nilai $10d - 2b$ ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"24"}],
        [{"tipe":"paragraph","text":"-24"}],
        [{"tipe":"paragraph","text":"25"}],
        [{"tipe":"paragraph","text":"-25"}],
        [{"tipe":"paragraph","text":"26"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari kesamaan matriks $A = B$:" },
        { "tipe": "paragraph", "text": "Elemen baris 2 kolom 1: $a = 6$." },
        { "tipe": "paragraph", "text": "Elemen baris 2 kolom 2: $2d = 10 \\Rightarrow d = 5$." },
        { "tipe": "paragraph", "text": "Elemen baris 1 kolom 1: $2a + b = 24 \\Rightarrow 2(6) + b = 24 \\Rightarrow 12 + b = 24 \\Rightarrow b = 12$." },
        { "tipe": "paragraph", "text": "Maka $10d - 2b = 10(5) - 2(12) = 50 - 24 = 26$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika matriks $K = \\begin{pmatrix} 1 & -3 \\\\ 9 & -6 \\end{pmatrix}$ dan $M = \\begin{pmatrix} -1 & 33 \\\\ 8 & 6 \\end{pmatrix}$ maka $K + M$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -2 & 36 \\\\ 17 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 30 \\\\ 17 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & -30 \\\\ 9 & -6 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 30 \\\\ 17 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 30 \\\\ 17 & 0 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan elemen yang bersesuaian:" },
        { "tipe": "formula_block", "latex": "K + M = \\begin{pmatrix} 1+(-1) & -3+33 \\\\ 9+8 & -6+6 \\end{pmatrix} = \\begin{pmatrix} 0 & 30 \\\\ 17 & 0 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari soal nomor 5, tentukan $M - K$ ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -2 & 36 \\\\ 1 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -2 & 36 \\\\ -1 & 12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -2 & 36 \\\\ 17 & 8 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & -36 \\\\ 17 & -12 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -2 & 36 \\\\ 17 & -12 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "M - K = \\begin{pmatrix} -1-1 & 33-(-3) \\\\ 8-9 & 6-(-6) \\end{pmatrix} = \\begin{pmatrix} -2 & 36 \\\\ -1 & 12 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks $Z = \\begin{pmatrix} -2 & 3 \\\\ 5 & -6 \\end{pmatrix}$, tentukan $3Z!$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -6 & 9 \\\\ 15 & -18 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -6 & 6 \\\\ -15 & -18 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -6 & 9 \\\\ 15 & -18 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -6 & 6 \\\\ 15 & 18 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 6 & 9 \\\\ -15 & -18 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan setiap elemen matriks dengan 3:" },
        { "tipe": "formula_block", "latex": "3Z = \\begin{pmatrix} 3(-2) & 3(3) \\\\ 3(5) & 3(-6) \\end{pmatrix} = \\begin{pmatrix} -6 & 9 \\\\ 15 & -18 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Transpose matriks $Z = \\begin{pmatrix} 1 & 2 & 2 \\\\ 0 & 0 & 2 \\\\ 5 & 6 & 3 \\end{pmatrix}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 & 5 \\\\ 2 & 0 & 6 \\\\ 2 & 2 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 & 5 \\\\ 2 & 0 & 6 \\\\ 2 & 2 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 & 5 \\\\ 2 & 2 & 3 \\\\ 2 & 2 & 6 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 & 5 \\\\ 0 & 0 & 6 \\\\ 2 & 2 & 3 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 & 5 \\\\ 2 & 0 & 6 \\\\ 2 & 2 & 3 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Transpose menukar baris menjadi kolom:" },
        { "tipe": "paragraph", "text": "Baris 1: $(1, 2, 2) \\to$ Kolom 1." },
        { "tipe": "paragraph", "text": "Baris 2: $(0, 0, 2) \\to$ Kolom 2." },
        { "tipe": "paragraph", "text": "Baris 3: $(5, 6, 3) \\to$ Kolom 3." },
        { "tipe": "formula_block", "latex": "Z^T = \\begin{pmatrix} 1 & 0 & 5 \\\\ 2 & 0 & 6 \\\\ 2 & 2 & 3 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tentukan determinan matriks $P = \\begin{pmatrix} 2 & 5 \\\\ 4 & 3 \\end{pmatrix}$ ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-12"}],
        [{"tipe":"paragraph","text":"-13"}],
        [{"tipe":"paragraph","text":"-14"}],
        [{"tipe":"paragraph","text":"-15"}],
        [{"tipe":"paragraph","text":"-16"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\det(P) = 2(3) - 5(4) = 6 - 20 = -14" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-mat-lanjut-mudah-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Determinan dari matriks segitiga atas $Q = \\begin{pmatrix} 1 & 2 & 3 \\\\ 0 & 4 & 5 \\\\ 0 & 0 & 6 \\end{pmatrix}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"18"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"24"}],
        [{"tipe":"paragraph","text":"30"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk matriks segitiga (baik atas maupun bawah), determinan sama dengan hasil kali elemen-elemen pada diagonal utamanya." },
        { "tipe": "formula_block", "latex": "\\det(Q) = 1 \\times 4 \\times 6 = 24" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
