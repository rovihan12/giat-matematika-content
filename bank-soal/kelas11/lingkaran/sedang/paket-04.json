        [ { "tipe": "paragraph", "text": "$22{,}4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$25{,}12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$28{,}6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$31{,}4$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = 2 \\cdot 3{,}14 \\cdot 20 = 125{,}6$ cm" },
        { "tipe": "paragraph", "text": "$Panjang\\ busur = \\dfrac{72°}{360°} \\cdot 125{,}6 = \\dfrac{1}{5} \\cdot 125{,}6 = 25{,}12$ cm" }
