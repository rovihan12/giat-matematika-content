        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk segitiga sama sisi: $r = \\dfrac{s\\sqrt{3}}{6}$." },
        { "tipe": "paragraph", "text": "$r = \\dfrac{12\\sqrt{3}}{6} = 2\\sqrt{3}$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segitiga sama sisi dengan sisi $12$ cm. Jari-jari lingkaran luarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk segitiga sama sisi: $R = \\dfrac{s\\sqrt{3}}{3}$." },
        { "tipe": "paragraph", "text": "$R = \\dfrac{12\\sqrt{3}}{3} = 4\\sqrt{3}$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran dalam segitiga dengan sisi $13$ cm, $14$ cm, $15$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
