  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang lingkaran dalam dan luar segitiga",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-s-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran dalam segitiga dengan sisi $9$ cm, $12$ cm, $15$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = \\dfrac{9 + 12 + 15}{2} = 18$" },
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot 9 \\cdot 12 = 54$ cm²" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{L}{s} = \\dfrac{54}{18} = 3$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran luar segitiga dengan sisi $6$ cm, $8$ cm, $10$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Segitiga siku-siku (karena $6^2 + 8^2 = 10^2$), maka jari-jari lingkaran luar $= \\dfrac{\\text{hipotenusa}}{2}$." },
        { "tipe": "paragraph", "text": "$R = \\dfrac{10}{2} = 5$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segitiga sama sisi dengan sisi $12$ cm. Jari-jari lingkaran dalamnya adalah..." }
