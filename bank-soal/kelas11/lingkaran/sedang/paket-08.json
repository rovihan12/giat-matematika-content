      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = \\dfrac{13 + 14 + 15}{2} = 21$" },
        { "tipe": "paragraph", "text": "$L = \\sqrt{s(s-a)(s-b)(s-c)} = \\sqrt{21 \\cdot 8 \\cdot 7 \\cdot 6}$" },
        { "tipe": "paragraph", "text": "$= \\sqrt{7056} = 84$ cm²" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{84}{21} = 4$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
