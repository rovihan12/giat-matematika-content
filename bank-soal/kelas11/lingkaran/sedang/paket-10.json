{
  "id": "bs-k11-ling-s-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran tentang garis singgung, lingkaran dalam segitiga, segi empat siklik, dan tembereng",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan jari-jari $10$ cm dan $2$ cm, jarak pusat $17$ cm. Panjang garis singgung persekutuan LUAR adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13$ cm" } ],
        [ { "tipe": "paragraph", "text": "$14$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15$ cm" } ],
        [ { "tipe": "paragraph", "text": "$16$ cm" } ],
        [ { "tipe": "paragraph", "text": "$17$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GSPL^2 = d^2 - (R - r)^2 = 17^2 - (10 - 2)^2$" },
        { "tipe": "paragraph", "text": "$= 289 - 64 = 225$" },
        { "tipe": "paragraph", "text": "$GSPL = 15$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran dalam segitiga dengan sisi $7$ cm, $24$ cm, $25$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = \\dfrac{7 + 24 + 25}{2} = 28$" },
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot 7 \\cdot 24 = 84$ cm²" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{L}{s} = \\dfrac{84}{28} = 3$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segi empat siklik $ABCD$ dengan $\\angle A = 75^\\circ$ dan $\\angle B = 85^\\circ$. Besar $\\angle D$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$85^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$90^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$95^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$100^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$105^\\circ$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sifat segi empat siklik: $\\angle B + \\angle D = 180^\\circ$." },
        { "tipe": "paragraph", "text": "$\\angle D = 180^\\circ - 85^\\circ = 95^\\circ$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas tembereng lingkaran dengan jari-jari $14$ cm dan sudut pusat $60^\\circ$ adalah... ($\\pi = \\dfrac{22}{7}$, $\\sqrt{3} = 1{,}732$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$17{,}8$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$20{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$24{,}3$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$30{,}8$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$35{,}2$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{\\text{juring}} = \\dfrac{60^\\circ}{360^\\circ} \\cdot \\dfrac{22}{7} \\cdot 196 = \\dfrac{1}{6} \\cdot 616 \\approx 102{,}67$ cm²." },
        { "tipe": "paragraph", "text": "$L_{\\triangle} = \\dfrac{1}{2} \\cdot 14 \\cdot 14 \\cdot \\sin 60^\\circ = 98 \\cdot \\dfrac{1}{2}\\sqrt{3} = 49\\sqrt{3} \\approx 49 \\cdot 1{,}732 = 84{,}87$ cm²." },
        { "tipe": "paragraph", "text": "$L_{\\text{tembereng}} = 102{,}67 - 84{,}87 = 17{,}80$ cm²." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua tali busur berpotongan di dalam lingkaran. Busur yang berhadapan besarnya $60^\\circ$ dan $80^\\circ$. Sudut yang terbentuk di antara tali busur adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$50^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$60^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$70^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$80^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$140^\\circ$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle = \\dfrac{1}{2}(60^\\circ + 80^\\circ) = \\dfrac{1}{2}(140^\\circ) = 70^\\circ$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran luar segitiga dengan sisi $9$ cm, $12$ cm, $15$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$7{,}5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$9$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Segitiga siku-siku (karena $9^2 + 12^2 = 15^2$)." },
        { "tipe": "paragraph", "text": "Jari-jari lingkaran luar $= \\dfrac{\\text{hipotenusa}}{2} = \\dfrac{15}{2} = 7{,}5$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran bersinggungan luar dengan jari-jari $9$ cm dan $6$ cm. Jarak kedua pusat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15$ cm" } ],
        [ { "tipe": "paragraph", "text": "$18$ cm" } ],
        [ { "tipe": "paragraph", "text": "$54$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bersinggungan luar: $d = R + r = 9 + 6 = 15$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas juring dengan sudut pusat $108^\\circ$ dan jari-jari $10$ cm adalah... ($\\pi = 3{,}14$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$78{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$94{,}2$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$125{,}6$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$157$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$314$ cm²" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{\\text{total}} = 3{,}14 \\cdot 100 = 314$ cm²." },
        { "tipe": "paragraph", "text": "$L_{\\text{juring}} = \\dfrac{108^\\circ}{360^\\circ} \\cdot 314 = \\dfrac{3}{10} \\cdot 314 = 94{,}2$ cm²." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segitiga sama sisi dengan sisi $24$ cm. Jari-jari lingkaran luarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$24$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk segitiga sama sisi: $R = \\dfrac{s\\sqrt{3}}{3}$." },
        { "tipe": "paragraph", "text": "$R = \\dfrac{24\\sqrt{3}}{3} = 8\\sqrt{3}$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-ling-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang busur lingkaran dengan jari-jari $21$ cm dan sudut pusat $240^\\circ$ adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$44$ cm" } ],
        [ { "tipe": "paragraph", "text": "$66$ cm" } ],
        [ { "tipe": "paragraph", "text": "$88$ cm" } ],
        [ { "tipe": "paragraph", "text": "$110$ cm" } ],
        [ { "tipe": "paragraph", "text": "$132$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = 2 \\cdot \\dfrac{22}{7} \\cdot 21 = 132$ cm." },
        { "tipe": "paragraph", "text": "$\\text{Panjang busur} = \\dfrac{240^\\circ}{360^\\circ} \\cdot 132 = \\dfrac{2}{3} \\cdot 132 = 88$ cm." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
