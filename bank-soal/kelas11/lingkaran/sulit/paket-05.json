{
  "id": "bs-k11-ling-t-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit campuran semua materi lingkaran",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-t-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan jari-jari $12$ cm dan $5$ cm. Jika jarak pusat $25$ cm, maka panjang GSPL adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$ cm" } ],
        [ { "tipe": "paragraph", "text": "$22$ cm" } ],
        [ { "tipe": "paragraph", "text": "$24$ cm" } ],
        [ { "tipe": "paragraph", "text": "$26$ cm" } ],
        [ { "tipe": "paragraph", "text": "$28$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GSPL^2 = 25^2 - (12 - 5)^2 = 625 - 49 = 576$" },
        { "tipe": "paragraph", "text": "$GSPL = 24$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran berjari-jari $9$ cm dan $6$ cm. Jarak pusat $17$ cm. Panjang GSPD adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$7$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$9$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GSPD^2 = 17^2 - (9 + 6)^2 = 289 - 225 = 64$" },
        { "tipe": "paragraph", "text": "$GSPD = 8$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segi empat siklik $ABCD$ dengan $\\angle A = (2x + 10)°$ dan $\\angle C = (3x - 30)°$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(2x + 10) + (3x - 30) = 180$" },
        { "tipe": "paragraph", "text": "$5x - 20 = 180 \\Rightarrow 5x = 200 \\Rightarrow x = 40$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran dalam segitiga dengan sisi $8$ cm, $15$ cm, dan $17$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = 20$, $L = 60$, $r = 3$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas tembereng lingkaran dengan jari-jari $21$ cm dan sudut pusat $90°$ adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$126$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$220{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$346{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$441$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$490$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{juring} = 346{,}5$ cm², $L_{\\triangle} = 220{,}5$ cm²" },
        { "tipe": "paragraph", "text": "$L_{tembereng} = 346{,}5 - 220{,}5 = 126$ cm²" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua tali busur berpotongan di luar lingkaran. Busur besar $= 130°$, busur kecil $= 50°$. Sudut yang terbentuk adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30°$" } ],
        [ { "tipe": "paragraph", "text": "$40°$" } ],
        [ { "tipe": "paragraph", "text": "$50°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ],
        [ { "tipe": "paragraph", "text": "$90°$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle = \\dfrac{1}{2}(130° - 50°) = 40°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segitiga sama sisi dengan sisi $12$ cm. Jari-jari lingkaran dalamnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r = \\dfrac{s\\sqrt{3}}{6} = \\dfrac{12\\sqrt{3}}{6} = 2\\sqrt{3}$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segitiga sama sisi dengan sisi $12$ cm. Jari-jari lingkaran luarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$R = \\dfrac{s\\sqrt{3}}{3} = \\dfrac{12\\sqrt{3}}{3} = 4\\sqrt{3}$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran luar segitiga dengan sisi $5$ cm, $12$ cm, dan $13$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5{,}5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6{,}5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$7{,}5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$13$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Segitiga siku-siku → $R = \\dfrac{13}{2} = 6{,}5$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang busur lingkaran dengan diameter $42$ cm dan sudut pusat $120°$ adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$22$ cm" } ],
        [ { "tipe": "paragraph", "text": "$44$ cm" } ],
        [ { "tipe": "paragraph", "text": "$66$ cm" } ],
        [ { "tipe": "paragraph", "text": "$88$ cm" } ],
        [ { "tipe": "paragraph", "text": "$132$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = \\dfrac{22}{7} \\cdot 42 = 132$ cm" },
        { "tipe": "paragraph", "text": "$Panjang\\ busur = \\dfrac{120°}{360°} \\cdot 132 = 44$ cm" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
