{
  "id": "bs-k11-ling-t-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang kombinasi GSPL/GSPD, sudut pusat-keliling, dan luas juring/tembereng",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-t-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan jari-jari $9$ cm dan $4$ cm. Jika jarak kedua pusat $13$ cm, maka panjang garis singgung persekutuan luarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$11$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$13$ cm" } ],
        [ { "tipe": "paragraph", "text": "$14$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GSPL^2 = 13^2 - (9 - 4)^2 = 169 - 25 = 144$" },
        { "tipe": "paragraph", "text": "$GSPL = 12$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan jari-jari $7$ cm dan $3$ cm. Jika jarak kedua pusat $25$ cm, maka panjang garis singgung persekutuan dalamnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$ cm" } ],
        [ { "tipe": "paragraph", "text": "$22$ cm" } ],
        [ { "tipe": "paragraph", "text": "$24$ cm" } ],
        [ { "tipe": "paragraph", "text": "$26$ cm" } ],
        [ { "tipe": "paragraph", "text": "$28$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GSPD^2 = 25^2 - (7 + 3)^2 = 625 - 100 = 525$" },
        { "tipe": "paragraph", "text": "$GSPD = \\sqrt{525} \\approx 22{,}91$ cm (Tidak ada di opsi)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sudut pusat $\\angle AOB = 120°$ dan sudut keliling $\\angle ACB$ menghadap busur yang sama. Besar $\\angle ACB$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30°$" } ],
        [ { "tipe": "paragraph", "text": "$40°$" } ],
        [ { "tipe": "paragraph", "text": "$50°$" } ],
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle ACB = \\dfrac{1}{2} \\cdot \\angle AOB$" },
        { "tipe": "paragraph", "text": "$\\angle ACB = \\dfrac{1}{2} \\cdot 120° = 60°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran dalam segitiga dengan sisi $8$ cm, $15$ cm, dan $17$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = \\dfrac{8 + 15 + 17}{2} = 20$" },
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot 8 \\cdot 15 = 60$ cm²" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{60}{20} = 3$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas juring lingkaran dengan sudut pusat $150°$ dan jari-jari $12$ cm adalah... ($\\pi = 3{,}14$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$125{,}6$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$150{,}72$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$188{,}4$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$226{,}08$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$452{,}16$ cm²" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{total} = 3{,}14 \\cdot 144 = 452{,}16$ cm²" },
        { "tipe": "paragraph", "text": "$L_{juring} = \\dfrac{150°}{360°} \\cdot 452{,}16 = \\dfrac{5}{12} \\cdot 452{,}16 = 188{,}4$ cm²" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segi empat siklik $ABCD$ dengan $\\angle A = 80°$ dan $\\angle B = 70°$. Besar $\\angle D$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$100°$" } ],
        [ { "tipe": "paragraph", "text": "$110°$" } ],
        [ { "tipe": "paragraph", "text": "$120°$" } ],
        [ { "tipe": "paragraph", "text": "$130°$" } ],
        [ { "tipe": "paragraph", "text": "$140°$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sifat segi empat siklik: $\\angle B + \\angle D = 180°$" },
        { "tipe": "paragraph", "text": "$\\angle D = 180° - 70° = 110°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran bersinggungan luar dengan jari-jari $10$ cm dan $6$ cm. Jarak kedua pusat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$16$ cm" } ],
        [ { "tipe": "paragraph", "text": "$20$ cm" } ],
        [ { "tipe": "paragraph", "text": "$60$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bersinggungan luar: $d = R + r = 10 + 6 = 16$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran luar segitiga dengan sisi $7$ cm, $24$ cm, dan $25$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12{,}5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$14$ cm" } ],
        [ { "tipe": "paragraph", "text": "$25$ cm" } ],
        [ { "tipe": "paragraph", "text": "$50$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Segitiga siku-siku (karena $7^2 + 24^2 = 25^2$)." },
        { "tipe": "paragraph", "text": "$R = \\dfrac{25}{2} = 12{,}5$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua tali busur berpotongan di dalam lingkaran. Busur yang berhadapan $70°$ dan $90°$. Sudut yang terbentuk di antara tali busur adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$50°$" } ],
        [ { "tipe": "paragraph", "text": "$70°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ],
        [ { "tipe": "paragraph", "text": "$90°$" } ],
        [ { "tipe": "paragraph", "text": "$160°$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle = \\dfrac{1}{2}(70° + 90°) = \\dfrac{1}{2}(160°) = 80°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas tembereng lingkaran dengan jari-jari $10$ cm dan sudut pusat $90°$ adalah... ($\\pi = 3{,}14$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$28{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$30{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$32{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$35{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$50$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{juring} = \\dfrac{90°}{360°} \\cdot 3{,}14 \\cdot 100 = 78{,}5$ cm²" },
        { "tipe": "paragraph", "text": "$L_{\\triangle} = \\dfrac{1}{2} \\cdot 10 \\cdot 10 = 50$ cm²" },
        { "tipe": "paragraph", "text": "$L_{tembereng} = 78{,}5 - 50 = 28{,}5$ cm²" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
