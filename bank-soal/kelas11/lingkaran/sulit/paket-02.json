{
  "id": "bs-k11-ling-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang unsur lingkaran dan sudut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan gambar berikut. Jika $\\angle AOB = 80°$ (sudut pusat) dan $\\angle ACB$ adalah sudut keliling yang menghadap busur $AB$, besar $\\angle ACB$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas11/lingkaran/sulit/sudut-pusat-dan-keliling.png",
          "caption": "Lingkaran dengan pusat O. Titik A, B pada lingkaran, titik C di busur besar. Sudut pusat AOB = 80°, sudut keliling ACB menghadap busur AB yang sama.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ],
        [ { "tipe": "paragraph", "text": "$160°$" } ],
        [ { "tipe": "paragraph", "text": "$20°$" } ],
        [ { "tipe": "paragraph", "text": "$100°$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sudut pusat = 2 × sudut keliling (menghadap busur sama)." },
        { "tipe": "paragraph", "text": "$\\angle ACB = \\dfrac{1}{2} \\cdot 80° = 40°$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran yang berdiameter titik $A(1, 2)$ dan $B(5, 6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(x - 3)^2 + (y - 4)^2 = 8$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 3)^2 + (y - 4)^2 = 4$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 3)^2 + (y - 4)^2 = 16$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 1)^2 + (y - 2)^2 = 8$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 5)^2 + (y - 6)^2 = 8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pusat = titik tengah $AB = (3, 4)$." },
        { "tipe": "paragraph", "text": "$r = \\dfrac{1}{2}\\sqrt{(5-1)^2 + (6-2)^2} = \\dfrac{1}{2}\\sqrt{32} = \\sqrt{8}$." },
        { "tipe": "paragraph", "text": "$(x - 3)^2 + (y - 4)^2 = 8$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang busur lingkaran dengan sudut pusat $90°$ dan jari-jari $14$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$22$ cm" } ],
        [ { "tipe": "paragraph", "text": "$11$ cm" } ],
        [ { "tipe": "paragraph", "text": "$44$ cm" } ],
        [ { "tipe": "paragraph", "text": "$33$ cm" } ],
        [ { "tipe": "paragraph", "text": "$28$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$= \\dfrac{90°}{360°} \\cdot 2 \\cdot \\dfrac{22}{7} \\cdot 14 = \\dfrac{1}{4} \\cdot 88 = 22$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas juring dengan sudut pusat $120°$ dan jari-jari $21$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$462$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$231$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$924$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$154$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$308$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$= \\dfrac{120°}{360°} \\cdot \\dfrac{22}{7} \\cdot 21^2 = \\dfrac{1}{3} \\cdot \\dfrac{22}{7} \\cdot 441$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{3} \\cdot 22 \\cdot 63 = 462$ cm²." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik $P(2, k)$ terletak pada lingkaran $x^2 + y^2 = 13$. Nilai $k$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{17}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{11}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4 + k^2 = 13 \\Rightarrow k^2 = 9 \\Rightarrow k = 3$ (positif)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui dua lingkaran dengan jari-jari $5$ cm dan $2$ cm, serta jarak pusat $25$ cm. Panjang garis singgung persekutuan dalamnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$ cm" } ],
        [ { "tipe": "paragraph", "text": "$25$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{625}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{574}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{649}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = \\sqrt{25^2 - (5 + 2)^2} = \\sqrt{625 - 49} = \\sqrt{576} = 24$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung lingkaran $x^2 + y^2 - 4x + 6y - 12 = 0$ di titik $(5, 1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x + 4y = 19$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 3y = 23$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 4y = 11$" } ],
        [ { "tipe": "paragraph", "text": "$x + y = 6$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 3y = 13$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek: $25 + 1 - 20 + 6 - 12 = 0$ ✓" },
        { "tipe": "paragraph", "text": "Garis singgung: $xx_1 + yy_1 + \\dfrac{A(x + x_1)}{2} + \\dfrac{B(y + y_1)}{2} + C = 0$" },
        { "tipe": "paragraph", "text": "$5x + y - 2(x + 5) + 3(y + 1) - 12 = 0$" },
        { "tipe": "paragraph", "text": "$3x + 4y - 19 = 0 \\Rightarrow 3x + 4y = 19$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Lingkaran $x^2 + y^2 - 2x + 4y - 4 = 0$ memiliki jari-jari..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{5}$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{7}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 1)^2 - 1 + (y + 2)^2 - 4 = 4$" },
        { "tipe": "paragraph", "text": "$(x - 1)^2 + (y + 2)^2 = 9$" },
        { "tipe": "paragraph", "text": "$r = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran bersinggungan dalam. Jari-jari lingkaran besar $14$ cm dan jarak kedua pusat $4$ cm. Jari-jari lingkaran kecil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$18$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$7$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bersinggungan dalam: $d = R - r$." },
        { "tipe": "paragraph", "text": "$4 = 14 - r \\Rightarrow r = 10$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran dengan pusat $(2, -3)$ dan menyinggung sumbu-$x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(x - 2)^2 + (y + 3)^2 = 9$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 2)^2 + (y + 3)^2 = 4$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 2)^2 + (y + 3)^2 = 3$" } ],
        [ { "tipe": "paragraph", "text": "$(x + 2)^2 + (y - 3)^2 = 9$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 2)^2 + (y + 3)^2 = 16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menyinggung sumbu-$x$: $r = |y_{pusat}| = 3$." },
        { "tipe": "paragraph", "text": "$(x - 2)^2 + (y + 3)^2 = 9$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
