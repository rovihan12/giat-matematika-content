{
  "id": "bs-k11-kfi-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang invers fungsi rasional dan komposisi bertingkat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x - 1}{x + 3}$, maka $f^{-1}(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(1)$: nilai $x$ saat $f(x) = 1$." },
        { "tipe": "paragraph", "text": "$\\dfrac{2x - 1}{x + 3} = 1 \\Rightarrow 2x - 1 = x + 3$" },
        { "tipe": "paragraph", "text": "$x = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4x + 1$ dengan domain $x \\geq -2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x + 2)^2 - 3 \\Rightarrow y + 3 = (x + 2)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -2$: $x + 2 = \\sqrt{y + 3}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = -2 + \\sqrt{x + 3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 1$ dan $g(x) = \\dfrac{x + 3}{2}$, maka $(f \\circ g)(5) - (g \\circ f)(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(5) = f(4) = 7$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(5) = g(9) = 6$" },
        { "tipe": "paragraph", "text": "$7 - 6 = 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x + 1}{2x - 5}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 1}{2x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 1}{2x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 1}{2x + 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 1}{3 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 1}{2x - 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{3x + 1}{2x - 5} \\Rightarrow y(2x - 5) = 3x + 1$" },
        { "tipe": "paragraph", "text": "$2xy - 5y = 3x + 1 \\Rightarrow 2xy - 3x = 5y + 1$" },
        { "tipe": "paragraph", "text": "$x(2y - 3) = 5y + 1 \\Rightarrow x = \\dfrac{5y + 1}{2y - 3}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{5x + 1}{2x - 3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 6x + 5$ dengan domain $x \\geq 3$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{x - 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 3)^2 - 4 \\Rightarrow y + 4 = (x - 3)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 3$: $x - 3 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 3 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x + 3$ dan $g(x) = x^2 - 1$. Nilai $x$ jika $(f \\circ g)(x) = 19$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$-4$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$0$ saja" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(x^2 - 1) = 2(x^2 - 1) + 3 = 2x^2 + 1$" },
        { "tipe": "paragraph", "text": "$2x^2 + 1 = 19 \\Rightarrow 2x^2 = 18 \\Rightarrow x^2 = 9$" },
        { "tipe": "paragraph", "text": "$x = \\pm 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4}{x - 2}$ dan $g(x) = x + 3$, nilai $(g \\circ f)(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(6) = \\dfrac{4}{6 - 2} = \\dfrac{4}{4} = 1$" },
        { "tipe": "paragraph", "text": "$g(f(6)) = g(1) = 1 + 3 = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$ dan $(g \\circ f)(x) = 9x^2 - 12x + 8$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 8$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 + 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(3x - 2) = 9x^2 - 12x + 8$. Misal $u = 3x - 2 \\Rightarrow x = \\dfrac{u + 2}{3}$." },
        { "tipe": "paragraph", "text": "$g(u) = 9 \\cdot \\dfrac{(u+2)^2}{9} - 12 \\cdot \\dfrac{u+2}{3} + 8$" },
        { "tipe": "paragraph", "text": "$= (u + 2)^2 - 4(u + 2) + 8$" },
        { "tipe": "paragraph", "text": "$= u^2 + 4u + 4 - 4u - 8 + 8 = u^2 + 4$" },
        { "tipe": "paragraph", "text": "$g(x) = x^2 + 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x}{x - 1}$ dan $f^{-1}(x)$ adalah inversnya, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(3)$: nilai $x$ saat $f(x) = 3$." },
        { "tipe": "paragraph", "text": "$\\dfrac{x}{x - 1} = 3 \\Rightarrow x = 3(x - 1)$" },
        { "tipe": "paragraph", "text": "$x = 3x - 3 \\Rightarrow 2x = 3 \\Rightarrow x = \\dfrac{3}{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 1}{2}$ dan $g(x) = 3x - 1$, nilai $(f^{-1} \\circ g^{-1})(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 2x - 1$; $g^{-1}(x) = \\dfrac{x + 1}{3}$" },
        { "tipe": "paragraph", "text": "$g^{-1}(5) = \\dfrac{5 + 1}{3} = 2$" },
        { "tipe": "paragraph", "text": "$f^{-1}(2) = 2(2) - 1 = 3$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
