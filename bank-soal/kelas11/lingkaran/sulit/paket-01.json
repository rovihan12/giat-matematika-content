{
  "id": "bs-k11-ling-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang persamaan lingkaran dan garis singgung",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran dengan pusat $(-2, 3)$ dan jari-jari $5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(x + 2)^2 + (y - 3)^2 = 25$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 2)^2 + (y + 3)^2 = 25$" } ],
        [ { "tipe": "paragraph", "text": "$(x + 2)^2 + (y - 3)^2 = 5$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 2)^2 + (y - 3)^2 = 25$" } ],
        [ { "tipe": "paragraph", "text": "$(x + 2)^2 - (y - 3)^2 = 25$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran pusat $(a, b)$ jari-jari $r$: $(x - a)^2 + (y - b)^2 = r^2$." },
        { "tipe": "paragraph", "text": "Dengan $a = -2$, $b = 3$, $r = 5$: $(x + 2)^2 + (y - 3)^2 = 25$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan gambar berikut. Persamaan garis singgung lingkaran di titik $A$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas11/lingkaran/sulit/lingkaran-pusat-0-0-r5-titik-A-3-4.png",
          "caption": "Lingkaran berpusat di O(0,0) dengan jari-jari 5. Titik A(3,4) terletak pada lingkaran. Garis singgung di titik A.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x + 4y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 3y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 4y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 3y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$3x + 4y = 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis singgung di titik $(x_1, y_1)$ pada lingkaran $x^2 + y^2 = r^2$: $x \\cdot x_1 + y \\cdot y_1 = r^2$." },
        { "tipe": "paragraph", "text": "Substitusi $A(3, 4)$: $3x + 4y = 25$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pusat dan jari-jari lingkaran $x^2 + y^2 - 6x + 8y - 11 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(3, -4)$ dan $r = 6$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, 4)$ dan $r = 6$" } ],
        [ { "tipe": "paragraph", "text": "$(3, -4)$ dan $r = 36$" } ],
        [ { "tipe": "paragraph", "text": "$(3, -4)$ dan $r = \\sqrt{11}$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, -4)$ dan $r = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x^2 - 6x) + (y^2 + 8y) = 11$" },
        { "tipe": "paragraph", "text": "$(x - 3)^2 - 9 + (y + 4)^2 - 16 = 11$" },
        { "tipe": "paragraph", "text": "$(x - 3)^2 + (y + 4)^2 = 36$" },
        { "tipe": "paragraph", "text": "Pusat $(3, -4)$ dan $r = 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung lingkaran $x^2 + y^2 = 20$ yang melalui titik $(4, 2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4x + 2y = 20$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 4y = 20$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 2y = 10$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 4y = 20$" } ],
        [ { "tipe": "paragraph", "text": "$x + 2y = 10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek: $4^2 + 2^2 = 16 + 4 = 20$ ✓ (pada lingkaran)." },
        { "tipe": "paragraph", "text": "$x \\cdot 4 + y \\cdot 2 = 20 \\Rightarrow 4x + 2y = 20$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang garis singgung persekutuan luar dua lingkaran dengan jari-jari $8$ cm dan $3$ cm serta jarak pusat $13$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$13$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{194}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{170}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\sqrt{d^2 - (R - r)^2} = \\sqrt{13^2 - (8 - 3)^2} = \\sqrt{169 - 25} = \\sqrt{144} = 12$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang garis singgung persekutuan dalam dua lingkaran dengan jari-jari $7$ cm dan $3$ cm serta jarak pusat $26$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$ cm" } ],
        [ { "tipe": "paragraph", "text": "$25$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{676}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{576}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$20$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = \\sqrt{d^2 - (R + r)^2} = \\sqrt{26^2 - (7 + 3)^2} = \\sqrt{676 - 100} = \\sqrt{576} = 24$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan gambar berikut. Jika sudut pusat $\\angle AOB = 120°$ dan jari-jari lingkaran $21$ cm, panjang busur $AB$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas11/lingkaran/sulit/lingkaran-sudut-pusat-120-r21.png",
          "caption": "Lingkaran dengan pusat O, jari-jari 21 cm, sudut pusat AOB = 120°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$44$ cm" } ],
        [ { "tipe": "paragraph", "text": "$42$ cm" } ],
        [ { "tipe": "paragraph", "text": "$22$ cm" } ],
        [ { "tipe": "paragraph", "text": "$77$ cm" } ],
        [ { "tipe": "paragraph", "text": "$33$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Panjang busur = $\\dfrac{\\alpha}{360°} \\cdot 2\\pi r$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{120°}{360°} \\cdot 2 \\cdot \\dfrac{22}{7} \\cdot 21 = \\dfrac{1}{3} \\cdot 132 = 44$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah lingkaran memiliki persamaan $x^2 + y^2 + 4x - 6y - 12 = 0$. Jari-jari lingkaran tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{12}$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{25}$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 2)^2 - 4 + (y - 3)^2 - 9 = 12$" },
        { "tipe": "paragraph", "text": "$(x + 2)^2 + (y - 3)^2 = 25$" },
        { "tipe": "paragraph", "text": "$r = 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Garis $y = 2x + k$ menyinggung lingkaran $x^2 + y^2 = 20$. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k = \\pm 10$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 5$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 20$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 4$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 15$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $y = 2x + k$: $x^2 + (2x + k)^2 = 20$" },
        { "tipe": "paragraph", "text": "$5x^2 + 4kx + (k^2 - 20) = 0$" },
        { "tipe": "paragraph", "text": "$D = 0 \\Rightarrow 16k^2 - 20(k^2 - 20) = 0$" },
        { "tipe": "paragraph", "text": "$-4k^2 + 400 = 0 \\Rightarrow k^2 = 100 \\Rightarrow k = \\pm 10$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah lingkaran berpusat di $(2, -1)$ dan menyinggung garis $3x + 4y - 5 = 0$. Jari-jari lingkaran adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r = \\dfrac{|3(2) + 4(-1) - 5|}{\\sqrt{3^2 + 4^2}} = \\dfrac{|-3|}{5} = \\dfrac{3}{5}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
