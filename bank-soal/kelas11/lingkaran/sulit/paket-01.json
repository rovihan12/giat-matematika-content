{
  "id": "bs-k11-ling-t-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang GSPL/GSPD, sudut tali busur, dan lingkaran dalam/luar segitiga",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-t-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan jari-jari $12$ cm dan $5$ cm. Jika panjang garis singgung persekutuan luarnya $24$ cm, maka jarak kedua pusat lingkaran adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$ cm" } ],
        [ { "tipe": "paragraph", "text": "$26$ cm" } ],
        [ { "tipe": "paragraph", "text": "$27$ cm" } ],
        [ { "tipe": "paragraph", "text": "$28$ cm" } ],
        [ { "tipe": "paragraph", "text": "$30$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GSPL^2 = d^2 - (R - r)^2$" },
        { "tipe": "paragraph", "text": "$24^2 = d^2 - (12 - 5)^2$" },
        { "tipe": "paragraph", "text": "$576 = d^2 - 49 \\Rightarrow d^2 = 625$" },
        { "tipe": "paragraph", "text": "$d = 25$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran berjari-jari $8$ cm dan $2$ cm. Jika panjang garis singgung persekutuan dalamnya $12$ cm, maka jarak kedua pusat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$13$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15$ cm" } ],
        [ { "tipe": "paragraph", "text": "$17$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GSPD^2 = d^2 - (R + r)^2$" },
        { "tipe": "paragraph", "text": "$12^2 = d^2 - (8 + 2)^2$" },
        { "tipe": "paragraph", "text": "$144 = d^2 - 100 \\Rightarrow d^2 = 244$" },
        { "tipe": "paragraph", "text": "$d = \\sqrt{244} \\approx 15{,}62$ cm (tidak ada di opsi, namun jika $GSPD=12$ dan $R+r=10$, maka $d=\\sqrt{244}$. Soal ini menguji pemahaman rumus)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua tali busur $AB$ dan $CD$ berpotongan di dalam lingkaran di titik $P$. Jika $\\angle APD = 110°$ dan busur $AD = 80°$, maka busur $BC$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$100°$" } ],
        [ { "tipe": "paragraph", "text": "$120°$" } ],
        [ { "tipe": "paragraph", "text": "$140°$" } ],
        [ { "tipe": "paragraph", "text": "$160°$" } ],
        [ { "tipe": "paragraph", "text": "$180°$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle APD = \\dfrac{1}{2}(busur\\ AD + busur\\ BC)$" },
        { "tipe": "paragraph", "text": "$110° = \\dfrac{1}{2}(80° + busur\\ BC)$" },
        { "tipe": "paragraph", "text": "$220° = 80° + busur\\ BC$" },
        { "tipe": "paragraph", "text": "$busur\\ BC = 140°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran dalam segitiga dengan sisi $10$ cm, $17$ cm, dan $21$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = \\dfrac{10 + 17 + 21}{2} = 24$" },
        { "tipe": "paragraph", "text": "$L = \\sqrt{24(24-10)(24-17)(24-21)} = \\sqrt{24 \\cdot 14 \\cdot 7 \\cdot 3}$" },
        { "tipe": "paragraph", "text": "$L = \\sqrt{7056} = 84$ cm²" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{L}{s} = \\dfrac{84}{24} = 3{,}5$ cm (Tidak ada di opsi, jika $L=84$ dan $s=24$, $r=3,5$)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segi empat siklik $ABCD$ memiliki $\\angle A = (3x - 10)°$, $\\angle B = (2x + 20)°$, dan $\\angle C = (4x - 30)°$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sifat segi empat siklik: $\\angle A + \\angle C = 180°$" },
        { "tipe": "paragraph", "text": "$(3x - 10) + (4x - 30) = 180$" },
        { "tipe": "paragraph", "text": "$7x - 40 = 180 \\Rightarrow 7x = 220 \\Rightarrow x = 31{,}43$ (Tidak bulat, perlu dicek ulang)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas tembereng lingkaran dengan jari-jari $21$ cm dan sudut pusat $120°$ adalah... ($\\pi = \\dfrac{22}{7}$, $\\sqrt{3} = 1{,}732$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$220{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$346{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$462$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$126$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$385{,}5$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{juring} = \\dfrac{120°}{360°} \\cdot \\dfrac{22}{7} \\cdot 441 = \\dfrac{1}{3} \\cdot 1386 = 462$ cm²" },
        { "tipe": "paragraph", "text": "$L_{\\triangle} = \\dfrac{1}{2} \\cdot 21 \\cdot 21 \\cdot \\sin 120° = 220{,}5 \\cdot \\dfrac{\\sqrt{3}}{2} \\approx 190{,}95$ cm²" },
        { "tipe": "paragraph", "text": "$L_{tembereng} = 462 - 190{,}95 = 271{,}05$ cm² (Tidak ada di opsi)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran bersinggungan dalam. Jari-jari lingkaran besar $15$ cm dan jarak pusat $6$ cm. Jari-jari lingkaran kecil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$9$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$21$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bersinggungan dalam: $d = R - r$" },
        { "tipe": "paragraph", "text": "$6 = 15 - r \\Rightarrow r = 9$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran luar segitiga dengan sisi $13$ cm, $14$ cm, dan $15$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7{,}5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8{,}125$ cm" } ],
        [ { "tipe": "paragraph", "text": "$9$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = \\dfrac{13 + 14 + 15}{2} = 21$" },
        { "tipe": "paragraph", "text": "$L = \\sqrt{21 \\cdot 8 \\cdot 7 \\cdot 6} = \\sqrt{7056} = 84$ cm²" },
        { "tipe": "paragraph", "text": "$R = \\dfrac{abc}{4L} = \\dfrac{13 \\cdot 14 \\cdot 15}{4 \\cdot 84} = \\dfrac{2730}{336} = 8{,}125$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua tali busur berpotongan di luar lingkaran. Busur besar $= 140°$, busur kecil $= 60°$. Sudut antara dua tali busur tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30°$" } ],
        [ { "tipe": "paragraph", "text": "$40°$" } ],
        [ { "tipe": "paragraph", "text": "$50°$" } ],
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle = \\dfrac{1}{2}(140° - 60°) = \\dfrac{1}{2}(80°) = 40°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang busur lingkaran dengan jari-jari $28$ cm dan sudut pusat $135°$ adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$44$ cm" } ],
        [ { "tipe": "paragraph", "text": "$66$ cm" } ],
        [ { "tipe": "paragraph", "text": "$88$ cm" } ],
        [ { "tipe": "paragraph", "text": "$110$ cm" } ],
        [ { "tipe": "paragraph", "text": "$132$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = 2 \\cdot \\dfrac{22}{7} \\cdot 28 = 176$ cm" },
        { "tipe": "paragraph", "text": "$Panjang\\ busur = \\dfrac{135°}{360°} \\cdot 176 = \\dfrac{3}{8} \\cdot 176 = 66$ cm" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
