{
  "id": "bs-k11-ling-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang lingkaran, persamaan, dan geometri analitik",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran dengan pusat $(0, 0)$ dan menyinggung garis $3x + 4y - 10 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 = 10$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 = 25$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 = 100$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r = \\dfrac{|3(0) + 4(0) - 10|}{\\sqrt{3^2 + 4^2}} = \\dfrac{|-10|}{5} = 2$." },
        { "tipe": "paragraph", "text": "$r^2 = 4$; persamaan $x^2 + y^2 = 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan jari-jari $9$ cm dan $4$ cm bersinggungan luar. Panjang garis singgung persekutuan luarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$13$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{65}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{97}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bersinggungan luar: $d = R + r = 9 + 4 = 13$." },
        { "tipe": "paragraph", "text": "$L = \\sqrt{d^2 - (R - r)^2} = \\sqrt{13^2 - (9 - 4)^2}$." },
        { "tipe": "paragraph", "text": "$= \\sqrt{169 - 25} = \\sqrt{144} = 12$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik $A(-3, 4)$ pada lingkaran $x^2 + y^2 = 25$. Persamaan garis singgung di $A$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3x + 4y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$3x + 4y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$-3x - 4y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 3y = 25$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 4y = 25$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek: $(-3)^2 + 4^2 = 9 + 16 = 25$ ✓ pada lingkaran." },
        { "tipe": "paragraph", "text": "Garis singgung: $x \\cdot x_1 + y \\cdot y_1 = r^2$." },
        { "tipe": "paragraph", "text": "$x \\cdot (-3) + y \\cdot 4 = 25 \\Rightarrow -3x + 4y = 25$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Lingkaran $x^2 + y^2 - 4x + 6y - 12 = 0$ memiliki jari-jari..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{12}$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{13}$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x^2 - 4x) + (y^2 + 6y) = 12$." },
        { "tipe": "paragraph", "text": "$(x - 2)^2 - 4 + (y + 3)^2 - 9 = 12$." },
        { "tipe": "paragraph", "text": "$(x - 2)^2 + (y + 3)^2 = 25$." },
        { "tipe": "paragraph", "text": "$r = \\sqrt{25} = 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika garis $y = x + c$ menyinggung lingkaran $x^2 + y^2 = 18$, nilai $c$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$3\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{18}$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $y = x + c$ ke $x^2 + y^2 = 18$:" },
        { "tipe": "paragraph", "text": "$x^2 + (x + c)^2 = 18$." },
        { "tipe": "paragraph", "text": "$2x^2 + 2cx + c^2 - 18 = 0$." },
        { "tipe": "paragraph", "text": "Syarat menyinggung: $D = 0$." },
        { "tipe": "paragraph", "text": "$4c^2 - 8(c^2 - 18) = 0$." },
        { "tipe": "paragraph", "text": "$4c^2 - 8c^2 + 144 = 0 \\Rightarrow -4c^2 = -144$." },
        { "tipe": "paragraph", "text": "$c^2 = 36 \\Rightarrow c = 6$ (positif)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sudut keliling yang menghadap diameter lingkaran besarnya..." },
        {
          "tipe": "image",
          "src": "images/kelas11/lingkaran/sulit/sudut-keliling-menghadap-diameter.png",
          "caption": "Lingkaran dengan diameter AB. Titik C berada pada lingkaran. Sudut ACB menghadap diameter AB.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$90^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$45^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$180^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$60^\\circ$" } ],
        [ { "tipe": "paragraph", "text": "$120^\\circ$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Diameter membentuk sudut pusat $180^\\circ$." },
        { "tipe": "paragraph", "text": "Sudut keliling = $\\dfrac{1}{2} \\cdot 180^\\circ = 90^\\circ$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Garis $y = 2x + k$ menyinggung lingkaran $x^2 + y^2 = 20$. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k = \\pm 10$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 5$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 20$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 2\\sqrt{5}$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jarak pusat $(0,0)$ ke garis $2x - y + k = 0$ = jari-jari." },
        { "tipe": "paragraph", "text": "$\\dfrac{|2(0) - 0 + k|}{\\sqrt{2^2 + (-1)^2}} = \\sqrt{20}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{|k|}{\\sqrt{5}} = 2\\sqrt{5}$." },
        { "tipe": "paragraph", "text": "$|k| = 2\\sqrt{5} \\cdot \\sqrt{5} = 2 \\cdot 5 = 10$." },
        { "tipe": "paragraph", "text": "$k = \\pm 10$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran melalui titik $A(1, 0)$, $B(0, 1)$, dan $C(-1, 0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 = 2$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 1)^2 + y^2 = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + (y - 1)^2 = 1$" } ],
        [ { "tipe": "paragraph", "text": "$(x + 1)^2 + y^2 = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ketiga titik berjarak 1 satuan dari pusat $(0, 0)$." },
        { "tipe": "paragraph", "text": "Cek: $1^2 + 0 = 1$; $0 + 1 = 1$; $(-1)^2 + 0 = 1$." },
        { "tipe": "paragraph", "text": "Jadi persamaan lingkaran $x^2 + y^2 = 1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran $x^2 + y^2 = 16$ dan $x^2 + y^2 - 8x + 12 = 0$. Kedudukan kedua lingkaran adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Saling lepas di luar" } ],
        [ { "tipe": "paragraph", "text": "Bersinggungan dalam" } ],
        [ { "tipe": "paragraph", "text": "Berpotongan" } ],
        [ { "tipe": "paragraph", "text": "Bersinggungan luar" } ],
        [ { "tipe": "paragraph", "text": "Konsentris" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Lingkaran 1: pusat $(0, 0)$, $r_1 = 4$." },
        { "tipe": "paragraph", "text": "Lingkaran 2: $(x - 4)^2 + y^2 = 4$, pusat $(4, 0)$, $r_2 = 2$." },
        { "tipe": "paragraph", "text": "Jarak pusat $d = \\sqrt{(4 - 0)^2 + 0^2} = 4$." },
        { "tipe": "paragraph", "text": "$r_1 - r_2 = 2$; $r_1 + r_2 = 6$." },
        { "tipe": "paragraph", "text": "Karena $r_1 - r_2 < d < r_1 + r_2$ (yaitu $2 < 4 < 6$) → **berpotongan**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang garis singgung persekutuan luar dua lingkaran yang bersinggungan luar dengan jari-jari $6$ cm dan $2$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{48}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{40}$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bersinggungan luar: $d = R + r = 6 + 2 = 8$." },
        { "tipe": "paragraph", "text": "$L = \\sqrt{d^2 - (R - r)^2} = \\sqrt{8^2 - (6 - 2)^2}$." },
        { "tipe": "paragraph", "text": "$= \\sqrt{64 - 16} = \\sqrt{48}$ cm." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
