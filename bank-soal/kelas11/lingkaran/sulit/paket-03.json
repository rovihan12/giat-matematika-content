{
  "id": "bs-k11-ling-t-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang sudut pusat-keliling, segi empat siklik, dan garis singgung",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-t-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sudut keliling $\\angle ACB = 40°$. Besar sudut pusat $\\angle AOB$ yang menghadap busur yang sama adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20°$" } ],
        [ { "tipe": "paragraph", "text": "$40°$" } ],
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ],
        [ { "tipe": "paragraph", "text": "$100°$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle AOB = 2 \\cdot \\angle ACB = 2 \\cdot 40° = 80°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan jari-jari $15$ cm dan $5$ cm. Jika panjang GSPL $24$ cm, maka jarak kedua pusat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$ cm" } ],
        [ { "tipe": "paragraph", "text": "$25$ cm" } ],
        [ { "tipe": "paragraph", "text": "$26$ cm" } ],
        [ { "tipe": "paragraph", "text": "$27$ cm" } ],
        [ { "tipe": "paragraph", "text": "$28$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$24^2 = d^2 - (15 - 5)^2$" },
        { "tipe": "paragraph", "text": "$576 = d^2 - 100 \\Rightarrow d^2 = 676$" },
        { "tipe": "paragraph", "text": "$d = 26$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segi empat siklik $PQRS$ dengan $\\angle P = 2x°$ dan $\\angle R = (3x + 20)°$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle P + \\angle R = 180°$" },
        { "tipe": "paragraph", "text": "$2x + 3x + 20 = 180$" },
        { "tipe": "paragraph", "text": "$5x = 160 \\Rightarrow x = 32$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran dalam segitiga dengan sisi $9$ cm, $12$ cm, dan $15$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$s = \\dfrac{9 + 12 + 15}{2} = 18$" },
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot 9 \\cdot 12 = 54$ cm²" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{54}{18} = 3$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas tembereng lingkaran dengan jari-jari $14$ cm dan sudut pusat $90°$ adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$56$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$98$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$112$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$154$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$252$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{juring} = \\dfrac{90°}{360°} \\cdot \\dfrac{22}{7} \\cdot 196 = 154$ cm²" },
        { "tipe": "paragraph", "text": "$L_{\\triangle} = \\dfrac{1}{2} \\cdot 14 \\cdot 14 = 98$ cm²" },
        { "tipe": "paragraph", "text": "$L_{tembereng} = 154 - 98 = 56$ cm²" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua tali busur berpotongan di luar lingkaran. Busur besar $= 120°$, busur kecil $= 40°$. Sudut antara dua tali busur tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30°$" } ],
        [ { "tipe": "paragraph", "text": "$40°$" } ],
        [ { "tipe": "paragraph", "text": "$50°$" } ],
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle = \\dfrac{1}{2}(120° - 40°) = \\dfrac{1}{2}(80°) = 40°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran luar segitiga dengan sisi $6$ cm, $8$ cm, dan $10$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Segitiga siku-siku → $R = \\dfrac{10}{2} = 5$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang busur lingkaran dengan jari-jari $20$ cm dan sudut pusat $72°$ adalah... ($\\pi = 3{,}14$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20{,}8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$22{,}4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$25{,}12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$28{,}6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$31{,}4$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = 2 \\cdot 3{,}14 \\cdot 20 = 125{,}6$ cm" },
        { "tipe": "paragraph", "text": "$Panjang\\ busur = \\dfrac{72°}{360°} \\cdot 125{,}6 = 25{,}12$ cm" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Segi empat siklik $ABCD$ memiliki $\\angle A = 70°$ dan $\\angle B = 80°$. Besar $\\angle D$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ],
        [ { "tipe": "paragraph", "text": "$100°$" } ],
        [ { "tipe": "paragraph", "text": "$110°$" } ],
        [ { "tipe": "paragraph", "text": "$120°$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle D = 180° - \\angle B = 180° - 80° = 100°$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-t-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas juring dengan sudut pusat $240°$ dan jari-jari $21$ cm adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$462$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$616$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$924$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$1.155$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$1.386$ cm²" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{total} = \\dfrac{22}{7} \\cdot 441 = 1.386$ cm²" },
        { "tipe": "paragraph", "text": "$L_{juring} = \\dfrac{240°}{360°} \\cdot 1.386 = 924$ cm²" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
