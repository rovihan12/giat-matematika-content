{
  "id": "bs-k11-kfi-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang komposisi bertingkat dan aplikasi fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 3}{x - 4}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x - 3}{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 3}{4 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{2 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 4}{x - 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{2x + 3}{x - 4} \\Rightarrow xy - 4y = 2x + 3$" },
        { "tipe": "paragraph", "text": "$xy - 2x = 4y + 3 \\Rightarrow x(y - 2) = 4y + 3$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{4y + 3}{y - 2}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{4x + 3}{x - 2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2x - 3$ dengan domain $x \\geq 1$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 1)^2 - 4 \\Rightarrow y + 4 = (x - 1)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 1$: $x - 1 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 1 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 2$, $g(x) = 2x - 1$, dan $h(x) = x^2$, nilai $(f \\circ g \\circ h)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$h(3) = 9$" },
        { "tipe": "paragraph", "text": "$g(9) = 17$" },
        { "tipe": "paragraph", "text": "$f(17) = 19$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 1}{x - 2}$, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(3)$: nilai $x$ saat $f(x) = 3$." },
        { "tipe": "paragraph", "text": "$\\dfrac{2x + 1}{x - 2} = 3 \\Rightarrow 2x + 1 = 3x - 6 \\Rightarrow x = 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 3$ dan $(f \\circ g)(x) = 8x + 5$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 4 \\cdot g(x) - 3 = 8x + 5$" },
        { "tipe": "paragraph", "text": "$4 \\cdot g(x) = 8x + 8 \\Rightarrow g(x) = 2x + 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 6x + 5$ dengan domain $x \\geq -3$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x + 3)^2 - 4 \\Rightarrow y + 4 = (x + 3)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -3$: $x + 3 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = -3 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x$ dan $g(x) = x^2 - 1$, nilai $(f \\circ g)(1) - (g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(1) = f(0) = 0$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(1) = g(1) = 0$" },
        { "tipe": "paragraph", "text": "$0 - 0 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4x - 5}{2x + 3}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 5}{4 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 5}{4 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 5}{3 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 5}{2x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 5}{2x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{4x - 5}{2x + 3} \\Rightarrow 2xy + 3y = 4x - 5$" },
        { "tipe": "paragraph", "text": "$2xy - 4x = -3y - 5 \\Rightarrow x = \\dfrac{3y + 5}{4 - 2y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{3x + 5}{4 - 2x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2$ dan $g(x) = x + 1$, maka $(f \\circ g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 4$" },
        { "tipe": "paragraph", "text": "$g(4) = 5$" },
        { "tipe": "paragraph", "text": "$f(5) = 25$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 1$ dan $g(x) = x^2$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 3$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(3) = 9$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
