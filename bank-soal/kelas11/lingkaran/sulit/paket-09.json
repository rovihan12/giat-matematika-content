{
  "id": "bs-k11-ling-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 11,
  "kategori": "Lingkaran",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang garis singgung persekutuan dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-ling-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan gambar berikut. Dua lingkaran dengan jari-jari $R = 8$ cm dan $r = 3$ cm. Jarak pusat $d = 13$ cm. Panjang garis singgung persekutuan luar $AB$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas11/lingkaran/sulit/garis-singgung-persekutuan-luar.png",
          "caption": "Dua lingkaran dengan pusat P dan Q. Jari-jari besar R = 8 cm dan kecil r = 3 cm. Jarak pusat PQ = 13 cm. Garis AB menyinggung kedua lingkaran di sisi luar.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$13$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{170}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$AB = \\sqrt{d^2 - (R - r)^2} = \\sqrt{13^2 - 5^2} = \\sqrt{169 - 25} = \\sqrt{144} = 12$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan gambar berikut. Dua lingkaran dengan jari-jari $R = 7$ cm dan $r = 3$ cm. Jarak pusat $d = 26$ cm. Panjang garis singgung persekutuan dalam $CD$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas11/lingkaran/sulit/garis-singgung-persekutuan-dalam.png",
          "caption": "Dua lingkaran dengan pusat P dan Q. Jari-jari 7 cm dan 3 cm. Jarak pusat PQ = 26 cm. Garis CD menyinggung kedua lingkaran di sisi dalam (menyilang).",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$ cm" } ],
        [ { "tipe": "paragraph", "text": "$25$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{576}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{676}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$20$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$CD = \\sqrt{d^2 - (R + r)^2} = \\sqrt{26^2 - 10^2} = \\sqrt{676 - 100} = \\sqrt{576} = 24$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran yang berpusat di $(3, -2)$ dan melalui titik $(6, 2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(x - 3)^2 + (y + 2)^2 = 25$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 3)^2 + (y + 2)^2 = 16$" } ],
        [ { "tipe": "paragraph", "text": "$(x + 3)^2 + (y - 2)^2 = 25$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 3)^2 + (y + 2)^2 = 5$" } ],
        [ { "tipe": "paragraph", "text": "$(x - 3)^2 + (y - 2)^2 = 25$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r^2 = (6 - 3)^2 + (2 + 2)^2 = 9 + 16 = 25$." },
        { "tipe": "paragraph", "text": "$(x - 3)^2 + (y + 2)^2 = 25$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah taman berbentuk lingkaran dengan diameter $28$ m. Di tengah taman akan dibuat kolam berbentuk lingkaran dengan diameter $14$ m. Luas taman di luar kolam adalah... ($\\pi = \\dfrac{22}{7}$)" },
        {
          "tipe": "image",
          "src": "images/kelas11/lingkaran/sulit/taman-dengan-kolam.png",
          "caption": "Taman berbentuk lingkaran besar (diameter 28 m) dengan kolam lingkaran kecil di tengahnya (diameter 14 m). Area hijau = taman di luar kolam.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$462$ m²" } ],
        [ { "tipe": "paragraph", "text": "$616$ m²" } ],
        [ { "tipe": "paragraph", "text": "$154$ m²" } ],
        [ { "tipe": "paragraph", "text": "$308$ m²" } ],
        [ { "tipe": "paragraph", "text": "$500$ m²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Luas taman: $\\dfrac{22}{7} \\cdot 14^2 = 616$ m²." },
        { "tipe": "paragraph", "text": "Luas kolam: $\\dfrac{22}{7} \\cdot 7^2 = 154$ m²." },
        { "tipe": "paragraph", "text": "Luas di luar kolam $= 616 - 154 = 462$ m²." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Lingkaran $x^2 + y^2 + px + qy - 5 = 0$ melalui titik $(1, 1)$ dan $(2, 3)$. Nilai $p + q$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $(1, 1)$: $1 + 1 + p + q - 5 = 0 \\Rightarrow p + q = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang garis singgung dari titik $B(7, 1)$ ke lingkaran $x^2 + y^2 = 25$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{17}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{41}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$OB^2 = 7^2 + 1^2 = 50$." },
        { "tipe": "paragraph", "text": "$L = \\sqrt{OB^2 - r^2} = \\sqrt{50 - 25} = \\sqrt{25} = 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan lingkaran yang melalui titik $(0, 0)$, $(4, 0)$, dan $(0, 6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 - 4x - 6y = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 + 4x + 6y = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 - 4x + 6y = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 + 4x - 6y = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + y^2 - 8x - 12y = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bentuk umum: $x^2 + y^2 + Ax + By + C = 0$." },
        { "tipe": "paragraph", "text": "Melalui $(0,0)$: $C = 0$." },
        { "tipe": "paragraph", "text": "Melalui $(4,0)$: $16 + 4A = 0 \\Rightarrow A = -4$." },
        { "tipe": "paragraph", "text": "Melalui $(0,6)$: $36 + 6B = 0 \\Rightarrow B = -6$." },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 + y^2 - 4x - 6y = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar garis $y = kx + 3$ menyinggung lingkaran $x^2 + y^2 = 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k = 0$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 1$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 2$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\pm 9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi: $x^2 + (kx + 3)^2 = 9$." },
        { "tipe": "paragraph", "text": "$(1 + k^2)x^2 + 6kx = 0$." },
        { "tipe": "paragraph", "text": "$D = 0 \\Rightarrow 36k^2 = 0 \\Rightarrow k = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua lingkaran dengan persamaan $x^2 + y^2 = 25$ dan $x^2 + y^2 - 12x + 35 = 0$. Jarak antara kedua pusat lingkaran adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Lingkaran 1: pusat $(0, 0)$." },
        { "tipe": "paragraph", "text": "Lingkaran 2: $(x - 6)^2 + y^2 = 1$, pusat $(6, 0)$." },
        { "tipe": "paragraph", "text": "Jarak pusat $= 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-ling-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung lingkaran $x^2 + y^2 = 10$ di titik $(1, 3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x + 3y = 10$" } ],
        [ { "tipe": "paragraph", "text": "$3x + y = 10$" } ],
        [ { "tipe": "paragraph", "text": "$x - 3y = 10$" } ],
        [ { "tipe": "paragraph", "text": "$3x - y = 10$" } ],
        [ { "tipe": "paragraph", "text": "$x + y = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek: $1 + 9 = 10$ ✓" },
        { "tipe": "paragraph", "text": "$x \\cdot 1 + y \\cdot 3 = 10 \\Rightarrow x + 3y = 10$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
