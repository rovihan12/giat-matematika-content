      "pilihan": [
        [ { "tipe": "paragraph", "text": "$154$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$308$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$462$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$616$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$924$ cm²" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\pi r^2 = \\dfrac{1}{2} \\cdot \\dfrac{22}{7} \\cdot 196$" },
