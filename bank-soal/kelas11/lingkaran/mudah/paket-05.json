      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jari-jari lingkaran $8$ cm. Panjang garis singgung dari titik berjarak $17$ cm dari pusat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$13$ cm" } ],
        [ { "tipe": "paragraph", "text": "$14$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15$ cm" } ],
        [ { "tipe": "paragraph", "text": "$16$ cm" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$GS^2 = 17^2 - 8^2 = 289 - 64 = 225$" },
        { "tipe": "paragraph", "text": "$GS = 15$ cm" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas lingkaran yang kelilingnya $132$ cm adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.386$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$2.772$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$5.544$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$8.316$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$11.088$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = 2\\pi r \\Rightarrow 132 = 2 \\cdot \\dfrac{22}{7} \\cdot r$" },
        { "tipe": "paragraph", "text": "$132 = \\dfrac{44}{7}r \\Rightarrow r = 21$ cm" },
        { "tipe": "paragraph", "text": "$L = \\dfrac{22}{7} \\cdot 441 = 1.386$ cm²" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang busur lingkaran dengan jari-jari $21$ cm dan sudut pusat $60°$ adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11$ cm" } ],
        [ { "tipe": "paragraph", "text": "$22$ cm" } ],
        [ { "tipe": "paragraph", "text": "$33$ cm" } ],
        [ { "tipe": "paragraph", "text": "$44$ cm" } ],
        [ { "tipe": "paragraph", "text": "$66$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = 2 \\cdot \\dfrac{22}{7} \\cdot 21 = 132$ cm" },
        { "tipe": "paragraph", "text": "$Panjang\\ busur = \\dfrac{60°}{360°} \\cdot 132 = \\dfrac{1}{6} \\cdot 132 = 22$ cm" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas juring dengan sudut pusat $72°$ dan jari-jari $10$ cm adalah... ($\\pi = 3{,}14$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15{,}7$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$31{,}4$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$62{,}8$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$78{,}5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$157$ cm²" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{total} = 3{,}14 \\cdot 100 = 314$ cm²" },
        { "tipe": "paragraph", "text": "$L_{juring} = \\dfrac{72°}{360°} \\cdot 314 = \\dfrac{1}{5} \\cdot 314 = 62{,}8$ cm²" }
      ],
      "tingkat": "MUDAH"
    }
  ]
