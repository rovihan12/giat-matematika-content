        [ { "tipe": "paragraph", "text": "$132$ cm" } ],
        [ { "tipe": "paragraph", "text": "$264$ cm" } ],
        [ { "tipe": "paragraph", "text": "$462$ cm" } ],
        [ { "tipe": "paragraph", "text": "$924$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$K = \\pi d = \\dfrac{22}{7} \\cdot 42 = 132$ cm" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas setengah lingkaran dengan jari-jari $14$ cm adalah... ($\\pi = \\dfrac{22}{7}$)" }
