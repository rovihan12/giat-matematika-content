      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas tembereng kecil pada lingkaran dengan jari-jari $14$ cm dan sudut pusat $90°$ adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$42$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$56$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$98$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$112$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$154$ cm²" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L_{juring} = \\dfrac{90°}{360°} \\cdot \\dfrac{22}{7} \\cdot 196 = \\dfrac{1}{4} \\cdot 616 = 154$ cm²" },
        { "tipe": "paragraph", "text": "$L_{\\triangle} = \\dfrac{1}{2} \\cdot 14 \\cdot 14 = 98$ cm²" },
        { "tipe": "paragraph", "text": "$L_{tembereng} = 154 - 98 = 56$ cm²" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sudut pusat $\\angle POR = 80°$ dan sudut keliling $\\angle PQR$ menghadap busur PR. Besar $\\angle PQR$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20°$" } ],
        [ { "tipe": "paragraph", "text": "$40°$" } ],
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$80°$" } ],
        [ { "tipe": "paragraph", "text": "$160°$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\angle PQR = \\dfrac{1}{2} \\cdot 80° = 40°$" }
