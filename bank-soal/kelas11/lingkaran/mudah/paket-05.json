      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas seperempat lingkaran dengan jari-jari $28$ cm adalah... ($\\pi = \\dfrac{22}{7}$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$308$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$462$ cm²" } ],
