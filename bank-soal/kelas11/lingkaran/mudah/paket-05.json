        { "tipe": "paragraph", "text": "$= \\dfrac{1}{4} \\cdot 2.464 = 616$ cm²" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-ling-m-05-q04",
      "pertanyaan": [
