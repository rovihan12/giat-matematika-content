  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran akhir: komposisi, invers, dan domain fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-m-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 6x - 3$ dan $g(x) = x + 4$, nilai $(f \\circ g)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(1) = 5$" },
        { "tipe": "paragraph", "text": "$f(g(1)) = f(5) = 6(5) - 3 = 27$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 5$ dan $g(x) = 2x + 1$, nilai $(g \\circ f)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(3) = 9 - 5 = 4$" },
        { "tipe": "paragraph", "text": "$g(f(3)) = g(4) = 2(4) + 1 = 9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 4$ dan $g(x) = x - 7$, nilai $(f \\circ g)(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(5) = 5 - 7 = -2$" },
        { "tipe": "paragraph", "text": "$f(g(5)) = f(-2) = 2(-2) + 4 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Domain dari $f(x) = \\dfrac{7}{2x - 6}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\neq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\neq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\neq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Penyebut $\\neq 0$: $2x - 6 \\neq 0 \\Rightarrow x \\neq 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x$ dan $g(x) = x^2 - 2$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = 4 - 2 = 2$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(2) = 5(2) = 10$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2 - 3x$, nilai $f^{-1}(8)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2 - 3x = 8 \\Rightarrow -3x = 6 \\Rightarrow x = -2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{x}{3} - 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x + 6$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$3(x - 2)$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 2}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{x}{3} - 2 \\Rightarrow \\dfrac{x}{3} = y + 2 \\Rightarrow x = 3y + 6$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 3x + 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = x - 5$, nilai $(f \\circ g)(3) + (g \\circ f)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(3) = f(-2) = -3$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(3) = g(7) = 2$" },
        { "tipe": "paragraph", "text": "$-3 + 2 = -1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 1$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1 - x}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 4x - 1 \\Rightarrow 4x = y + 1 \\Rightarrow x = \\dfrac{y + 1}{4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 1}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\sqrt{x + 1}$, maka $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sqrt{x + 1} = 3 \\Rightarrow x + 1 = 9 \\Rightarrow x = 8$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
