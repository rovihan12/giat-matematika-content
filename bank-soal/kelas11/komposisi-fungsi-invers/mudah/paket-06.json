{
  "id": "bs-k11-kfi-m-06",
  "nama": "Bank Soal Mudah - Paket 6",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang notasi fungsi, nilai fungsi, dan domain dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-m-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 1$, nilai $f(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(5) = 3(5) - 1 = 15 - 1 = 14$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x$, nilai $f(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(3) = 3^2 + 2(3) = 9 + 6 = 15$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Domain dari $f(x) = \\dfrac{5}{x - 2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\neq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\neq -2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Penyebut tidak boleh nol: $x - 2 \\neq 0 \\Rightarrow x \\neq 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 7$ dan $f(a) = 15$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2a + 7 = 15 \\Rightarrow 2a = 8 \\Rightarrow a = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 1$ dan $g(x) = 3x$, nilai $(f + g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 4 - 1 = 3$; $g(2) = 6$" },
        { "tipe": "paragraph", "text": "$(f + g)(2) = 3 + 6 = 9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x + 1$ dan $g(x) = x - 3$, nilai $(f - g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 9$; $g(2) = -1$" },
        { "tipe": "paragraph", "text": "$(f - g)(2) = 9 - (-1) = 10$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x$ dan $g(x) = x - 2$, nilai $(f \\cdot g)(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(4) = 12$; $g(4) = 2$" },
        { "tipe": "paragraph", "text": "$(f \\cdot g)(4) = 12 \\cdot 2 = 24$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = 6x - 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 5$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5 - x}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$6x - 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 6x - 5 \\Rightarrow 6x = y + 5 \\Rightarrow x = \\dfrac{y + 5}{6}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 5}{6}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 4}{5}$, maka $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(2)$: nilai $x$ saat $f(x) = 2$." },
        { "tipe": "paragraph", "text": "$\\dfrac{x + 4}{5} = 2 \\Rightarrow x + 4 = 10 \\Rightarrow x = 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 7 - 3x$, nilai $f^{-1}(-2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$7 - 3x = -2 \\Rightarrow 3x = 9 \\Rightarrow x = 3$" },
        { "tipe": "paragraph", "text": "$f^{-1}(-2) = 3$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
