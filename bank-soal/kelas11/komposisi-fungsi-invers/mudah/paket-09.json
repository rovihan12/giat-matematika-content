    {
      "id": "bs-k11-kfi-m-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = 9x - 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$9x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4 - x}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$9x - 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 9x - 4 \\Rightarrow 9x = y + 4 \\Rightarrow x = \\dfrac{y + 4}{9}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 4}{9}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
