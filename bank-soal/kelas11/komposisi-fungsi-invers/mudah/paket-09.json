        [ { "tipe": "paragraph", "text": "$-10$" } ],
        [ { "tipe": "paragraph", "text": "$-8$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = 2 - 4 = -2$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(-2) = 7(-2) + 2 = -12$" }
