{
  "id": "bs-k11-kfi-m-04",
  "nama": "Bank Soal Mudah - Paket 4",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang domain, range, dan sifat invers",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-m-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Domain dari $f(x) = \\sqrt{x - 2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Isi akar $\\geq 0$: $x - 2 \\geq 0 \\Rightarrow x \\geq 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = x - 4$, nilai $(f \\circ g)(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(0) = -4$" },
        { "tipe": "paragraph", "text": "$f(g(0)) = f(-4) = -8 + 1 = -7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 4$ dan $g(x) = x + 2$, nilai $(f \\circ g)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(1) = 3$" },
        { "tipe": "paragraph", "text": "$f(g(1)) = f(3) = 9 - 4 = 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x$ dan $g(x) = x^2 + 1$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$39$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 6$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(6) = 36 + 1 = 37$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x - 3$ dan $g(x) = 2x + 1$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = 5$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(5) = 25 - 3 = 22$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x - 1$ dan $g(x) = 2x + 3$, nilai $(g \\circ f)(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(4) = 3$" },
        { "tipe": "paragraph", "text": "$g(f(4)) = g(3) = 6 + 3 = 9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2$ dan $g(x) = 3x - 1$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = 5$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(5) = 25$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $f^{-1}(5)$ jika $f(x) = 2x - 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2x - 3 = 5 \\Rightarrow 2x = 8 \\Rightarrow x = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^3$, nilai $f^{-1}(27)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^3 = 27 \\Rightarrow x = \\sqrt[3]{27} = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x + 2$, nilai $f^{-1}(10)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4x + 2 = 10 \\Rightarrow 4x = 8 \\Rightarrow x = 2$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
