{
  "id": "bs-k11-kfi-m-08",
  "nama": "Bank Soal Mudah - Paket 8",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang domain, range, dan sifat dasar invers fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-m-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Domain dari $f(x) = \\sqrt{x - 5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 5$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Isi akar $\\geq 0$: $x - 5 \\geq 0 \\Rightarrow x \\geq 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$ dan $g(x) = x + 5$, nilai $(f \\circ g)(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(0) = 5$" },
        { "tipe": "paragraph", "text": "$f(g(0)) = f(5) = 3(5) - 2 = 13$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 9$ dan $g(x) = x - 1$, nilai $(f \\circ g)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(3) = 2$" },
        { "tipe": "paragraph", "text": "$f(g(3)) = f(2) = 4 - 9 = -5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x$ dan $g(x) = x^2 + 3$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 4$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(4) = 16 + 3 = 19$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 6x + 1$ dan $g(x) = 2x - 3$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = 1$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(1) = 6 + 1 = 7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 6$ dan $g(x) = 3x - 4$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 8$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(8) = 3(8) - 4 = 20$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = 10x + 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$10x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3 - x}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$10x + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 10x + 3 \\Rightarrow 10x = y - 3 \\Rightarrow x = \\dfrac{y - 3}{10}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x - 3}{10}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $f^{-1}(6)$ jika $f(x) = 4x - 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4x - 2 = 6 \\Rightarrow 4x = 8 \\Rightarrow x = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^3$, nilai $f^{-1}(64)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^3 = 64 \\Rightarrow x = \\sqrt[3]{64} = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x + 5$, nilai $f^{-1}(20)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5x + 5 = 20 \\Rightarrow 5x = 15 \\Rightarrow x = 3$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
