  "soal": [
    {
      "id": "bs-k11-kfi-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$ dan $g(x) = x - 1$, nilai $(f \\circ g)(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(4) = 3$" },
        { "tipe": "paragraph", "text": "$f(g(4)) = f(3) = 6 + 3 = 9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = 2x - 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 8}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x - 8}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = 2x + 8$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{8 - x}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = 2x - 8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 2x - 8 \\Rightarrow 2x = y + 8 \\Rightarrow x = \\dfrac{y + 8}{2}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 8}{2}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2$ dan $g(x) = x - 3$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = -1$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(-1) = 1 + 2 = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 1$, nilai $f^{-1}(7)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3x + 1 = 7 \\Rightarrow 3x = 6 \\Rightarrow x = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x$ dan $g(x) = x + 2$, nilai $(g \\circ f)(3)$ adalah..." }
