      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k11-kfi-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Domain dari $f(x) = \\dfrac{2}{x + 4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\neq -4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\neq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > -4$" } ],
        [ { "tipe": "paragraph", "text": "$x < -4$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Penyebut $\\neq 0$: $x + 4 \\neq 0 \\Rightarrow x \\neq -4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
