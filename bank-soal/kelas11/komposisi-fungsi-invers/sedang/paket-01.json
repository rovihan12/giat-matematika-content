{
  "id": "bs-k11-kfi-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang rumus komposisi fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = 3x - 2$, rumus $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$6x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$5x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$5x + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(g(x)) = 2(3x - 2) + 1$" },
        { "tipe": "paragraph", "text": "$= 6x - 4 + 1 = 6x - 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 3$ dan $g(x) = x^2 - 1$, rumus $(g \\circ f)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 6x + 8$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 6x + 9$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 3x + 8$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 6x + 8$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 6x - 8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = g(f(x)) = (x + 3)^2 - 1$" },
        { "tipe": "paragraph", "text": "$= x^2 + 6x + 9 - 1 = x^2 + 6x + 8$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x$ dan $g(x) = x - 4$, nilai $(f \\circ g)^{-1}(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 3(x - 4) = 3x - 12$" },
        { "tipe": "paragraph", "text": "$(f \\circ g)^{-1}(6)$: $3x - 12 = 6 \\Rightarrow 3x = 18 \\Rightarrow x = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2$ dan $g(x) = x + 1$, nilai $(f \\circ g)(3) - (g \\circ f)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(3) = f(4) = 16$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(3) = g(9) = 10$" },
        { "tipe": "paragraph", "text": "$16 - 10 = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 3$ dan $(f \\circ g)(x) = 4x + 1$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 4$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 2 \\cdot g(x) - 3 = 4x + 1$" },
        { "tipe": "paragraph", "text": "$2 \\cdot g(x) = 4x + 4 \\Rightarrow g(x) = 2x + 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x + 2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$5x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 - x}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x}{5} - 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 5x + 2 \\Rightarrow 5x = y - 2 \\Rightarrow x = \\dfrac{y - 2}{5}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x - 2}{5}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{2x + 1}{x - 3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 1}{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 1}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 1}{x + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{2x + 1}{x - 3} \\Rightarrow y(x - 3) = 2x + 1$" },
        { "tipe": "paragraph", "text": "$yx - 3y = 2x + 1 \\Rightarrow yx - 2x = 3y + 1$" },
        { "tipe": "paragraph", "text": "$x(y - 2) = 3y + 1 \\Rightarrow x = \\dfrac{3y + 1}{y - 2}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{3x + 1}{x - 2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4x + 4$ dan $g(x) = x - 2$, nilai $(f \\circ g)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(3) = 1$" },
        { "tipe": "paragraph", "text": "$f(g(3)) = f(1) = 1 + 4 + 4 = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(g \\circ f)(x) = 6x - 5$ dan $g(x) = 2x + 1$, maka $f(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$3x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 5$" } ],
        [ { "tipe": "paragraph", "text": "$6x - 6$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(f(x)) = 2 \\cdot f(x) + 1 = 6x - 5$" },
        { "tipe": "paragraph", "text": "$2 \\cdot f(x) = 6x - 6 \\Rightarrow f(x) = 3x - 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\sqrt{x + 3}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 3$ dengan $x \\geq 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 3$ dengan $x \\geq 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3$ dengan $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{\\sqrt{x + 3}}$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3$ dengan $x \\leq 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\sqrt{x + 3} \\Rightarrow y^2 = x + 3 \\Rightarrow x = y^2 - 3$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = x^2 - 3$ dengan $x \\geq 0$ (karena range $f$ adalah $\\geq 0$)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
