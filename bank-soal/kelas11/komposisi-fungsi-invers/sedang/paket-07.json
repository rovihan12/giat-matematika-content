{
  "id": "bs-k11-kfi-s-07",
  "nama": "Bank Soal Sedang - Paket 7",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang invers komposisi dan persamaan fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x + 1$ dan $g(x) = 2x - 3$, rumus $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10x - 14$" } ],
        [ { "tipe": "paragraph", "text": "$10x + 14$" } ],
        [ { "tipe": "paragraph", "text": "$10x - 16$" } ],
        [ { "tipe": "paragraph", "text": "$7x - 14$" } ],
        [ { "tipe": "paragraph", "text": "$7x + 14$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(2x - 3) = 5(2x - 3) + 1$" },
        { "tipe": "paragraph", "text": "$= 10x - 15 + 1 = 10x - 14$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{4x + 1}{2x - 3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{2x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 1}{2x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x - 1}{2x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{4x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{4 - 2x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{4x + 1}{2x - 3} \\Rightarrow y(2x - 3) = 4x + 1$" },
        { "tipe": "paragraph", "text": "$2xy - 3y = 4x + 1 \\Rightarrow 2xy - 4x = 3y + 1$" },
        { "tipe": "paragraph", "text": "$x(2y - 4) = 3y + 1 \\Rightarrow x = \\dfrac{3y + 1}{2y - 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{3x + 1}{2x - 4}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$ dan $g(x) = x^2 + 1$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 4$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(4) = 16 + 1 = 17$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 3x + 2$, nilai $f^{-1}(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$0$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$2$ atau $3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 3x + 2 = 0 \\Rightarrow (x - 1)(x - 2) = 0$" },
        { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$ dan $(g \\circ f)(x) = 6x + 11$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$3x + 5$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2x + 3) = 6x + 11$. Misal $u = 2x + 3 \\Rightarrow x = \\dfrac{u - 3}{2}$." },
        { "tipe": "paragraph", "text": "$g(u) = 6 \\cdot \\dfrac{u - 3}{2} + 11 = 3(u - 3) + 11 = 3u + 2$" },
        { "tipe": "paragraph", "text": "$g(x) = 3x + 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x - 3}{2x + 1}$ untuk $x \\neq -\\dfrac{1}{2}$, nilai $f^{-1}(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{2x + 1} = 0 \\Rightarrow x - 3 = 0 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 1$ dan $g(x) = x + 4$, nilai $(f \\circ g)^{-1}(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 3(x + 4) - 1 = 3x + 11$" },
        { "tipe": "paragraph", "text": "$3x + 11 = 5 \\Rightarrow 3x = -6 \\Rightarrow x = -2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\sqrt{x - 4}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 4$ dengan $x \\geq 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4$ dengan $x \\geq 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 4$ dengan $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{\\sqrt{x - 4}}$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4$ dengan $x \\geq 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\sqrt{x - 4} \\Rightarrow y^2 = x - 4 \\Rightarrow x = y^2 + 4$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = x^2 + 4$ dengan $x \\geq 0$ (range $f$ adalah $\\geq 0$)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 2$ dan $g(x) = 2x - 5$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = -1$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(-1) = 3(-1) + 2 = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 5$ dan $g(x) = x - 2$, nilai $(f \\circ g)(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(0) = -2$" },
        { "tipe": "paragraph", "text": "$f(g(0)) = f(-2) = 4 - 5 = -1$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
