{
  "id": "bs-k11-kfi-s-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang invers fungsi rasional dan akar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{3x - 1}{x + 2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 1}{3 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 1}{3 + x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{3x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 1}{x - 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{3x - 1}{x + 2} \\Rightarrow y(x + 2) = 3x - 1$" },
        { "tipe": "paragraph", "text": "$yx + 2y = 3x - 1 \\Rightarrow yx - 3x = -2y - 1$" },
        { "tipe": "paragraph", "text": "$x(y - 3) = -2y - 1 \\Rightarrow x = \\dfrac{-2y - 1}{y - 3} = \\dfrac{2y + 1}{3 - y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{2x + 1}{3 - x}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4$ untuk $x \\geq 0$, nilai $f^{-1}(13)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + 4 = 13 \\Rightarrow x^2 = 9$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 0$: $x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 6x + 8$, nilai minimum dari $f$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(x) = (x - 3)^2 - 1$" },
        { "tipe": "paragraph", "text": "Nilai minimum saat $x = 3$: $f(3) = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 5$ dan $g(x) = x^2 + 1$, nilai $(g \\circ f)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(3) = 1$" },
        { "tipe": "paragraph", "text": "$g(f(3)) = g(1) = 1 + 1 = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 2$, nilai $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 - x}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x}{3} - 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 3x + 2 \\Rightarrow 3x = y - 2 \\Rightarrow x = \\dfrac{y - 2}{3}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x - 2}{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x + 1$ dan $(f \\circ g)(x) = 8x - 3$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 4$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 4$" } ],
        [ { "tipe": "paragraph", "text": "$8x + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 4 \\cdot g(x) + 1 = 8x - 3$" },
        { "tipe": "paragraph", "text": "$4 \\cdot g(x) = 8x - 4 \\Rightarrow g(x) = 2x - 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2}{x - 1}$ untuk $x \\neq 1$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(2)$: nilai $x$ saat $f(x) = 2$." },
        { "tipe": "paragraph", "text": "$\\dfrac{2}{x - 1} = 2 \\Rightarrow x - 1 = 1 \\Rightarrow x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 3$, nilai $f^{-1}(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$0$ atau $5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + 2x - 3 = 5$" },
        { "tipe": "paragraph", "text": "$x^2 + 2x - 8 = 0$" },
        { "tipe": "paragraph", "text": "$(x + 4)(x - 2) = 0 \\Rightarrow x = -4$ atau $x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x - 3$ dan $g(x) = x + 2$, nilai $(f \\circ g)^{-1}(22)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 5(x + 2) - 3 = 5x + 7$" },
        { "tipe": "paragraph", "text": "$5x + 7 = 22 \\Rightarrow 5x = 15 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x - 2$ dan $g(x) = x^2 + 3x$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 0$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(0) = 0 + 0 = 0$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
