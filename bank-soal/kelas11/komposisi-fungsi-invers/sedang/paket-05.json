{
  "id": "bs-k11-kfi-s-05",
  "nama": "Bank Soal Sedang - Paket 5",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran komposisi & invers lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 2$ dan $g(x) = 2x - 1$, rumus $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$6x - 5$" } ],
        [ { "tipe": "paragraph", "text": "$5x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(2x - 1) = 3(2x - 1) + 2$" },
        { "tipe": "paragraph", "text": "$= 6x - 3 + 2 = 6x - 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{2x + 3}{4x - 1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{4x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{4x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{2x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{2 - 4x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{2 - 4x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{2x + 3}{4x - 1} \\Rightarrow y(4x - 1) = 2x + 3$" },
        { "tipe": "paragraph", "text": "$4xy - y = 2x + 3 \\Rightarrow 4xy - 2x = y + 3$" },
        { "tipe": "paragraph", "text": "$x(4y - 2) = y + 3 \\Rightarrow x = \\dfrac{y + 3}{4y - 2}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 3}{4x - 2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2$ dan $g(x) = 3x + 1$, nilai $(f \\circ g)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(1) = 4$" },
        { "tipe": "paragraph", "text": "$f(g(1)) = f(4) = 16 - 2 = 14$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x - 3$ dan $g(x) = 2x + 7$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 7$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(7) = 14 + 7 = 21$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = 7 - 2x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{7 - x}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x - 7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{7 + x}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = 2x - 7$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{1}{7 - 2x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = 7 - 2x \\Rightarrow 2x = 7 - y \\Rightarrow x = \\dfrac{7 - y}{2}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{7 - x}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = x^2 - 3$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 5$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(5) = 25 - 3 = 22$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x}{x - 2}$ untuk $x \\neq 2$, nilai $f^{-1}(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(6)$: nilai $x$ saat $f(x) = 6$." },
        { "tipe": "paragraph", "text": "$\\dfrac{3x}{x - 2} = 6 \\Rightarrow 3x = 6x - 12 \\Rightarrow 3x = 12 \\Rightarrow x = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(f \\circ g)(x) = 6x + 5$ dan $g(x) = 3x - 1$, maka $f(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x + 7$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 7$" } ],
        [ { "tipe": "paragraph", "text": "$3x + 5$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 7$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = f(3x - 1) = 6x + 5$." },
        { "tipe": "paragraph", "text": "Misal $u = 3x - 1 \\Rightarrow x = \\dfrac{u + 1}{3}$." },
        { "tipe": "paragraph", "text": "$f(u) = 6 \\cdot \\dfrac{u + 1}{3} + 5 = 2(u + 1) + 5 = 2u + 7$" },
        { "tipe": "paragraph", "text": "$f(x) = 2x + 7$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 3$ untuk $x \\geq -1$, nilai $f^{-1}(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + 2x - 3 = 5 \\Rightarrow x^2 + 2x - 8 = 0$" },
        { "tipe": "paragraph", "text": "$(x + 4)(x - 2) = 0 \\Rightarrow x = -4$ atau $x = 2$." },
        { "tipe": "paragraph", "text": "Karena domain $x \\geq -1$: $x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x + 3$ dan $g(x) = x - 5$, nilai $(f \\circ g)^{-1}(-1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 4(x - 5) + 3 = 4x - 17$" },
        { "tipe": "paragraph", "text": "$4x - 17 = -1 \\Rightarrow 4x = 16 \\Rightarrow x = 4$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
