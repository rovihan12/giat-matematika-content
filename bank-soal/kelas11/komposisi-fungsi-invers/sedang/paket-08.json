{
  "id": "bs-k11-kfi-s-08",
  "nama": "Bank Soal Sedang - Paket 8",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang komposisi bertingkat dan invers fungsi pecahan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = 3x - 4$, rumus $(g \\circ f)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$6x - 7$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$5x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$5x - 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = g(2x + 1) = 3(2x + 1) - 4$" },
        { "tipe": "paragraph", "text": "$= 6x + 3 - 4 = 6x - 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{6x - 1}{2x + 5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 1}{6 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 1}{6 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6x + 1}{2x - 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 5}{6x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 1}{2x - 6}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{6x - 1}{2x + 5} \\Rightarrow y(2x + 5) = 6x - 1$" },
        { "tipe": "paragraph", "text": "$2xy + 5y = 6x - 1 \\Rightarrow 2xy - 6x = -5y - 1$" },
        { "tipe": "paragraph", "text": "$x(2y - 6) = -5y - 1 \\Rightarrow x = \\dfrac{5y + 1}{6 - 2y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{5x + 1}{6 - 2x}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2x$ dan $g(x) = x + 3$, nilai $(f \\circ g)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(1) = 4$" },
        { "tipe": "paragraph", "text": "$f(g(1)) = f(4) = 16 - 8 = 8$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 3$ dan $(g \\circ f)(x) = 4x - 7$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2x - 3) = 4x - 7$. Misal $u = 2x - 3 \\Rightarrow x = \\dfrac{u + 3}{2}$." },
        { "tipe": "paragraph", "text": "$g(u) = 4 \\cdot \\dfrac{u + 3}{2} - 7 = 2(u + 3) - 7 = 2u - 1$" },
        { "tipe": "paragraph", "text": "$g(x) = 2x - 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x + 2}{x - 4}$ untuk $x \\neq 4$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-12$" } ],
        [ { "tipe": "paragraph", "text": "$-11$" } ],
        [ { "tipe": "paragraph", "text": "$-10$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ],
        [ { "tipe": "paragraph", "text": "$-8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{3x + 2}{x - 4} = 2 \\Rightarrow 3x + 2 = 2x - 8$" },
        { "tipe": "paragraph", "text": "$x = -10$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x + 1$ dan $g(x) = x - 3$, nilai $(f \\circ g)^{-1}(9)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 4(x - 3) + 1 = 4x - 11$" },
        { "tipe": "paragraph", "text": "$4x - 11 = 9 \\Rightarrow 4x = 20 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4x + 4$, nilai minimum dari $f$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(x) = (x + 2)^2$" },
        { "tipe": "paragraph", "text": "Nilai minimum saat $x = -2$: $f(-2) = 0$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x - 2$ dan $g(x) = 3x + 1$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 8$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(8) = 24 + 1 = 25$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2}{x + 3}$ untuk $x \\neq -3$, nilai $f^{-1}(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2}{x + 3} = 1 \\Rightarrow x + 3 = 2 \\Rightarrow x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(f \\circ g)(x) = 5x - 4$ dan $f(x) = 2x + 3$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$5x - 7$" } ],
        [ { "tipe": "paragraph", "text": "$5x + 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 2 \\cdot g(x) + 3 = 5x - 4$" },
        { "tipe": "paragraph", "text": "$2 \\cdot g(x) = 5x - 7 \\Rightarrow g(x) = \\dfrac{5x - 7}{2}$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
