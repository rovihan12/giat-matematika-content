{
  "id": "bs-k11-kfi-s-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran akhir: komposisi, invers, dan aplikasi fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x + 2$ dan $g(x) = x^2 - 3x$, rumus $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4x^2 - 12x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 - 12x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 + 12x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 - 3x + 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(x^2 - 3x) = 4(x^2 - 3x) + 2$" },
        { "tipe": "paragraph", "text": "$= 4x^2 - 12x + 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{8x - 3}{2x + 1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{8 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{2 + 8x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8x + 3}{2x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{8x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{8x + 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{8x - 3}{2x + 1} \\Rightarrow y(2x + 1) = 8x - 3$" },
        { "tipe": "paragraph", "text": "$2xy + y = 8x - 3 \\Rightarrow 2xy - 8x = -y - 3$" },
        { "tipe": "paragraph", "text": "$x(2y - 8) = -y - 3 \\Rightarrow x = \\dfrac{y + 3}{8 - 2y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 3}{8 - 2x}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$ dan $g(x) = x^2 + x - 1$, nilai $(g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(1) = 1$" },
        { "tipe": "paragraph", "text": "$g(f(1)) = g(1) = 1 + 1 - 1 = 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 6x + 5$, nilai $f^{-1}(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$ atau $5$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $5$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $-5$" } ],
        [ { "tipe": "paragraph", "text": "$2$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 6x + 5 = 0 \\Rightarrow (x - 1)(x - 5) = 0$" },
        { "tipe": "paragraph", "text": "$x = 1$ atau $x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 5$ dan $(g \\circ f)(x) = 4x + 9$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2x + 5) = 4x + 9$. Misal $u = 2x + 5 \\Rightarrow x = \\dfrac{u - 5}{2}$." },
        { "tipe": "paragraph", "text": "$g(u) = 4 \\cdot \\dfrac{u - 5}{2} + 9 = 2(u - 5) + 9 = 2u - 1$" },
        { "tipe": "paragraph", "text": "$g(x) = 2x - 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5x - 1$ dan $g(x) = x + 4$, nilai $(f \\circ g)^{-1}(14)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 5(x + 4) - 1 = 5x + 19$" },
        { "tipe": "paragraph", "text": "$5x + 19 = 14 \\Rightarrow 5x = -5 \\Rightarrow x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4x}{x - 2}$ untuk $x \\neq 2$, nilai $f^{-1}(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{4x}{x - 2} = 6 \\Rightarrow 4x = 6x - 12$" },
        { "tipe": "paragraph", "text": "$2x = 12 \\Rightarrow x = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x + 1$ untuk $x \\geq -1$, nilai $f^{-1}(16)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 1)^2 = 16 \\Rightarrow x + 1 = 4$ (karena $x \\geq -1$)" },
        { "tipe": "paragraph", "text": "$x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 3$ dan $g(x) = 3x + 1$, nilai $(f \\circ g)(0) + (g \\circ f)(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-11$" } ],
        [ { "tipe": "paragraph", "text": "$-10$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ],
        [ { "tipe": "paragraph", "text": "$-8$" } ],
        [ { "tipe": "paragraph", "text": "$-7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(0) = f(1) = -1$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(0) = g(-3) = -8$" },
        { "tipe": "paragraph", "text": "$-1 + (-8) = -9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 3}{x - 1}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 3}{x + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{x - 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{2x + 3}{x - 1} \\Rightarrow y(x - 1) = 2x + 3$" },
        { "tipe": "paragraph", "text": "$xy - y = 2x + 3 \\Rightarrow xy - 2x = y + 3$" },
        { "tipe": "paragraph", "text": "$x(y - 2) = y + 3 \\Rightarrow x = \\dfrac{y + 3}{y - 2}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 3}{x - 2}$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
