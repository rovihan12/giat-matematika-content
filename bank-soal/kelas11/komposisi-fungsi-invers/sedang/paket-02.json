{
  "id": "bs-k11-kfi-s-02",
  "nama": "Bank Soal Sedang - Paket 2",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang sifat komposisi dan invers fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x - 1$ dan $g(x) = x^2 + 2$, rumus $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 1$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 1$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 3$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(g(x)) = (x^2 + 2) - 1 = x^2 + 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 5$ dan $g(x) = x - 3$, nilai $(f \\circ g)^{-1}(7)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 2(x - 3) + 5 = 2x - 1$" },
        { "tipe": "paragraph", "text": "$2x - 1 = 7 \\Rightarrow 2x = 8 \\Rightarrow x = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{x - 4}{2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = 2x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = 2x - 4$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 4}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x - 4}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$f^{-1}(x) = 4x + 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{x - 4}{2} \\Rightarrow 2y = x - 4 \\Rightarrow x = 2y + 4$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 2x + 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$ dan $g(x) = x + 4$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = 6$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(6) = 3(6) - 2 = 16$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$ dan $g(x) = x^2$, maka $(g \\circ f)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4x^2 + 12x + 9$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 + 6x + 9$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 + 12x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 3$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = g(f(x)) = (2x + 3)^2$" },
        { "tipe": "paragraph", "text": "$= 4x^2 + 12x + 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{1}{x}$ dan $g(x) = x + 2$, nilai $(f \\circ g)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(3) = 5$" },
        { "tipe": "paragraph", "text": "$f(g(3)) = f(5) = \\dfrac{1}{5}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2x + 3$, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$2$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$1$ saja" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(x) = 3 \\Rightarrow x^2 - 2x + 3 = 3$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x = 0 \\Rightarrow x(x - 2) = 0$" },
        { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$, $g(x) = 5x - 1$, dan $(f \\circ g)(a) = 31$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = f(g(a)) = 2(5a - 1) + 3 = 10a + 1$" },
        { "tipe": "paragraph", "text": "$10a + 1 = 31 \\Rightarrow 10a = 30 \\Rightarrow a = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x + 2}{x - 1}$, nilai $f^{-1}(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(4)$: nilai $x$ saat $f(x) = 4$." },
        { "tipe": "paragraph", "text": "$\\dfrac{3x + 2}{x - 1} = 4 \\Rightarrow 3x + 2 = 4x - 4$" },
        { "tipe": "paragraph", "text": "$x = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(f \\circ g)(x) = 4x + 7$ dan $f(x) = 2x + 1$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 6$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 6$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 2 \\cdot g(x) + 1 = 4x + 7$" },
        { "tipe": "paragraph", "text": "$2 \\cdot g(x) = 4x + 6 \\Rightarrow g(x) = 2x + 3$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
