{
  "id": "bs-k11-kfi-s-04",
  "nama": "Bank Soal Sedang - Paket 4",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang invers fungsi komposisi & aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = x - 4$, rumus $(g \\circ f)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 5$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 5$" } ],
        [ { "tipe": "paragraph", "text": "$x - 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = g(f(x)) = (2x + 1) - 4 = 2x - 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 1$ dan $g(x) = 2x - 3$, nilai $(f \\circ g)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2) = 1$" },
        { "tipe": "paragraph", "text": "$f(g(2)) = f(1) = 1 + 1 = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{4x - 3}{2x + 1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{4 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{4 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{2x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{2x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{2x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{4x - 3}{2x + 1} \\Rightarrow y(2x + 1) = 4x - 3$" },
        { "tipe": "paragraph", "text": "$2xy + y = 4x - 3 \\Rightarrow 2xy - 4x = -y - 3$" },
        { "tipe": "paragraph", "text": "$x(2y - 4) = -y - 3 \\Rightarrow x = \\dfrac{y + 3}{4 - 2y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 3}{4 - 2x}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 1$ dan $f^{-1}(x) = \\dfrac{x - 1}{3}$, nilai $f^{-1}(10)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(10) = \\dfrac{10 - 1}{3} = \\dfrac{9}{3} = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$ dan $g(x) = x^2$, nilai $(f \\circ g)(2) + (g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(2) = f(4) = 11$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(2) = g(7) = 49$" },
        { "tipe": "paragraph", "text": "Jumlah $= 60$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 4$ dan $g(x) = x + 2$, nilai $(f \\circ g)(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(0) = 2$" },
        { "tipe": "paragraph", "text": "$f(g(0)) = f(2) = 4 - 4 = 0$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 3}{2}$, nilai $f^{-1}(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(5)$: nilai $x$ saat $f(x) = 5$." },
        { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{2} = 5 \\Rightarrow x + 3 = 10 \\Rightarrow x = 7$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 5$ dan $(g \\circ f)(x) = 8x - 13$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(f(x)) = g(4x - 5) = 8x - 13$." },
        { "tipe": "paragraph", "text": "Misal $u = 4x - 5 \\Rightarrow x = \\dfrac{u + 5}{4}$." },
        { "tipe": "paragraph", "text": "$g(u) = 8 \\cdot \\dfrac{u + 5}{4} - 13 = 2(u + 5) - 13$" },
        { "tipe": "paragraph", "text": "$= 2u + 10 - 13 = 2u - 3$" },
        { "tipe": "paragraph", "text": "$g(x) = 2x - 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2$ untuk $x \\geq 0$, nilai $f^{-1}(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + 2 = 6 \\Rightarrow x^2 = 4$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 0$: $x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 4$, $g(x) = x + 1$, dan $(f \\circ g)(a) = 14$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = f(a + 1) = 3(a + 1) - 4 = 3a - 1$" },
        { "tipe": "paragraph", "text": "$3a - 1 = 14 \\Rightarrow 3a = 15 \\Rightarrow a = 5$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
