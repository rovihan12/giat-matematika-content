{
  "id": "bs-k11-kfi-s-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang rumus komposisi dan invers fungsi rasional",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-s-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 1$ dan $g(x) = 2x + 5$, rumus $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8x + 19$" } ],
        [ { "tipe": "paragraph", "text": "$8x + 9$" } ],
        [ { "tipe": "paragraph", "text": "$8x - 19$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 19$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(2x + 5) = 4(2x + 5) - 1$" },
        { "tipe": "paragraph", "text": "$= 8x + 20 - 1 = 8x + 19$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x - 2$ dan $g(x) = x^2 + 4x$, rumus $(g \\circ f)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 4x - 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = g(x - 2) = (x - 2)^2 + 4(x - 2)$" },
        { "tipe": "paragraph", "text": "$= x^2 - 4x + 4 + 4x - 8 = x^2 - 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Invers dari $f(x) = \\dfrac{5x - 2}{x + 3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 2}{5 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 2}{5 + x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 2}{x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{5x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 2}{x - 5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{5x - 2}{x + 3} \\Rightarrow y(x + 3) = 5x - 2$" },
        { "tipe": "paragraph", "text": "$xy + 3y = 5x - 2 \\Rightarrow xy - 5x = -3y - 2$" },
        { "tipe": "paragraph", "text": "$x(y - 5) = -3y - 2 \\Rightarrow x = \\dfrac{3y + 2}{5 - y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{3x + 2}{5 - x}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 7$ dan $(f \\circ g)(x) = 6x + 1$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$3x - 4$" } ],
        [ { "tipe": "paragraph", "text": "$3x + 8$" } ],
        [ { "tipe": "paragraph", "text": "$6x + 8$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 2 \\cdot g(x) - 7 = 6x + 1$" },
        { "tipe": "paragraph", "text": "$2 \\cdot g(x) = 6x + 8 \\Rightarrow g(x) = 3x + 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 4$ dan $g(x) = x^2 - 1$, nilai $(f \\circ g)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(3) = 9 - 1 = 8$" },
        { "tipe": "paragraph", "text": "$f(g(3)) = f(8) = 2(8) + 4 = 20$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x}{x - 1}$ dan $x \\neq 1$, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2x}{x - 1} = 3 \\Rightarrow 2x = 3x - 3 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 5$ dan $g(x) = x - 2$, nilai $(g \\circ f)^{-1}(9)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = g(3x + 5) = 3x + 3$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)^{-1}(9)$: $3x + 3 = 9 \\Rightarrow 3x = 6 \\Rightarrow x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2$ untuk $x \\geq 0$, nilai $f^{-1}(11)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + 2 = 11 \\Rightarrow x^2 = 9$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 0$: $x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 3$ dan $g(x) = x^2 + x$, nilai $(g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(1) = 4 - 3 = 1$" },
        { "tipe": "paragraph", "text": "$g(f(1)) = g(1) = 1 + 1 = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k11-kfi-s-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(g \\circ f)(x) = 8x + 3$ dan $g(x) = 2x - 5$, maka $f(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 4$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 8$" } ],
        [ { "tipe": "paragraph", "text": "$8x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(f(x)) = 2 \\cdot f(x) - 5 = 8x + 3$" },
        { "tipe": "paragraph", "text": "$2 \\cdot f(x) = 8x + 8 \\Rightarrow f(x) = 4x + 4$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
