{
  "id": "bs-k11-kfi-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang aplikasi komposisi dan invers fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x - 2}{x + 4}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 2}{3 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x - 2}{3 + x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 2}{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 4}{3 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 2}{x - 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(x + 4)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{3x - 2}{x + 4} \\Rightarrow y(x + 4) = 3x - 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "xy + 4y = 3x - 2 \\Rightarrow xy - 3x = -4y - 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan sederhanakan tanda negatif**" },
        { "tipe": "formula_block", "latex": "x(y - 3) = -(4y + 2) \\Rightarrow x = \\dfrac{-(4y + 2)}{y - 3} = \\dfrac{4y + 2}{3 - y}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{4x + 2}{3 - x}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{4x + 2}{3 - x}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x - 1}{x - 2}$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(2) = x \\iff f(x) = 2$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{3x - 1}{x - 2} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan linear untuk $x$**" },
        { "tipe": "formula_block", "latex": "3x - 1 = 2(x - 2) \\Rightarrow 3x - 1 = 2x - 4" },
        { "tipe": "formula_block", "latex": "3x - 2x = -4 + 1 \\Rightarrow x = -3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(2)$ adalah **$-3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $h(x) = x + 1$, $g(x) = x^2 - 3$, dan $f(x) = 2x + 1$, nilai $(f \\circ g \\circ h)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Evaluasi fungsi terdalam $h(1)$**" },
        { "tipe": "formula_block", "latex": "h(1) = 1 + 1 = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Evaluasi fungsi tengah $g(h(1)) = g(2)$**" },
        { "tipe": "formula_block", "latex": "g(2) = 2^2 - 3 = 4 - 3 = 1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Evaluasi fungsi terluar $f(g(h(1))) = f(1)$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g \\circ h)(1) = f(1) = 2(1) + 1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(f \\circ g \\circ h)(1)$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{5x + 3}{2x - 1}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{2x - 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{2x + 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 5}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{5 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{5 - 2x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(2x - 1)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{5x + 3}{2x - 1} \\Rightarrow y(2x - 1) = 5x + 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "2xy - y = 5x + 3 \\Rightarrow 2xy - 5x = y + 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan nyatakan dalam bentuk $x = \\dots$**" },
        { "tipe": "formula_block", "latex": "x(2y - 5) = y + 3 \\Rightarrow x = \\dfrac{y + 3}{2y - 5}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{x + 3}{2x - 5}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{x + 3}{2x - 5}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 2}{x - 3}$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(2) = x \\iff f(x) = 2$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{x + 2}{x - 3} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan untuk $x$**" },
        { "tipe": "formula_block", "latex": "x + 2 = 2(x - 3) \\Rightarrow x + 2 = 2x - 6" },
        { "tipe": "formula_block", "latex": "2 + 6 = 2x - x \\Rightarrow x = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(2)$ adalah **$8$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 4x + 5$ dengan domain $x \\geq 2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x - 1}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk fungsi kuadrat menjadi kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 - 4x + 5 = (x - 2)^2 - 4 + 5 = (x - 2)^2 + 1" },
        { "tipe": "formula_block", "latex": "(x - 2)^2 = y - 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ambil akar kuadrat dengan memperhatikan domain $x \\geq 2$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 2$, maka $x - 2 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x - 2 = \\sqrt{y - 1} \\Rightarrow x = 2 + \\sqrt{y - 1}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = 2 + \\sqrt{x - 1}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$2 + \\sqrt{x - 1}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + a$ dan $f^{-1}(3) = 5$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk invers menjadi bentuk fungsi asal**" },
        { "tipe": "paragraph", "text": "Berdasarkan definisi fungsi invers, $f^{-1}(3) = 5$ ekuivalen dengan $f(5) = 3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 5$ ke $f(x) = 2x + a$**" },
        { "tipe": "formula_block", "latex": "f(5) = 2(5) + a = 3 \\Rightarrow 10 + a = 3 \\Rightarrow a = -7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ adalah **$-7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x - 1}{3x + 2}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 1}{2 - 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 1}{2 + 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 1}{3x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 1}{3 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{2 - x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(3x + 2)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{2x - 1}{3x + 2} \\Rightarrow y(3x + 2) = 2x - 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "3xy + 2y = 2x - 1 \\Rightarrow 3xy - 2x = -2y - 1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan sederhanakan tanda negatif**" },
        { "tipe": "formula_block", "latex": "x(3y - 2) = -(2y + 1) \\Rightarrow x = \\dfrac{-(2y + 1)}{3y - 2} = \\dfrac{2y + 1}{2 - 3y}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{2x + 1}{2 - 3x}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{2x + 1}{2 - 3x}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2$ dan $g(x) = \\sqrt{x - 2}$, nilai $(g \\circ f)(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{34}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{38}$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai fungsi bagian dalam $f(6)$**" },
        { "tipe": "formula_block", "latex": "f(6) = 6^2 + 2 = 36 + 2 = 38" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan hasil $f(6)$ ke dalam fungsi $g(x)$**" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(6) = g(f(6)) = g(38) = \\sqrt{38 - 2} = \\sqrt{36} = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(g \\circ f)(6)$ adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = x^2 + 2$, nilai $x$ jika $(g \\circ f)(x) = 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{2}$ atau $\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun persamaan komposisi $(g \\circ f)(x) = 6$**" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(x) = g(f(x)) = (2x + 1)^2 + 2 = (4x^2 + 4x + 1) + 2 = 4x^2 + 4x + 3" },
        { "tipe": "formula_block", "latex": "4x^2 + 4x + 3 = 6 \\Rightarrow 4x^2 + 4x - 3 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan atau gunakan rumus kuadrat untuk mencari nilai $x$**" },
        { "tipe": "formula_block", "latex": "(2x - 1)(2x + 3) = 0" },
        { "tipe": "formula_block", "latex": "2x - 1 = 0 \\Rightarrow x = \\dfrac{1}{2} \\quad \\text{atau} \\quad 2x + 3 = 0 \\Rightarrow x = -\\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$-\\dfrac{3}{2}$ atau $\\dfrac{1}{2}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
