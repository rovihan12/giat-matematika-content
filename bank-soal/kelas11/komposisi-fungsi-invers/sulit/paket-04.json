{
  "id": "bs-k11-kfi-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang aplikasi komposisi dan invers fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x - 2}{x + 4}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 2}{3 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x - 2}{3 + x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 2}{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 4}{3 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 2}{x - 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{3x - 2}{x + 4} \\Rightarrow xy + 4y = 3x - 2$" },
        { "tipe": "paragraph", "text": "$xy - 3x = -4y - 2 \\Rightarrow x(y - 3) = -4y - 2$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{4y + 2}{3 - y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{4x + 2}{3 - x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x - 1}{x - 2}$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(2)$: nilai $x$ saat $f(x) = 2$." },
        { "tipe": "paragraph", "text": "$\\dfrac{3x - 1}{x - 2} = 2 \\Rightarrow 3x - 1 = 2x - 4$" },
        { "tipe": "paragraph", "text": "$x = -3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $h(x) = x + 1$, $g(x) = x^2 - 3$, dan $f(x) = 2x + 1$, nilai $(f \\circ g \\circ h)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$h(1) = 2$" },
        { "tipe": "paragraph", "text": "$g(h(1)) = g(2) = 4 - 3 = 1$" },
        { "tipe": "paragraph", "text": "$f(g(h(1))) = f(1) = 2(1) + 1 = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{5x + 3}{2x - 1}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{2x - 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{2x + 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 5}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 3}{5 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 3}{5 - 2x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{5x + 3}{2x - 1} \\Rightarrow 2xy - y = 5x + 3$" },
        { "tipe": "paragraph", "text": "$2xy - 5x = y + 3 \\Rightarrow x(2y - 5) = y + 3$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{y + 3}{2y - 5}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 3}{2x - 5}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 2}{x - 3}$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{x - 3} = 2 \\Rightarrow x + 2 = 2x - 6 \\Rightarrow x = 8$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 4x + 5$ dengan domain $x \\geq 2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x - 1}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 2)^2 + 1 \\Rightarrow y - 1 = (x - 2)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 2$: $x - 2 = \\sqrt{y - 1}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 2 + \\sqrt{x - 1}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + a$ dan $f^{-1}(3) = 5$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(3) = 5$ berarti $f(5) = 3$." },
        { "tipe": "paragraph", "text": "$f(5) = 2(5) + a = 10 + a = 3$" },
        { "tipe": "paragraph", "text": "$a = -7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x - 1}{3x + 2}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 1}{2 - 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 1}{2 + 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 1}{3x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 1}{3 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{2 - x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{2x - 1}{3x + 2} \\Rightarrow 3xy + 2y = 2x - 1$" },
        { "tipe": "paragraph", "text": "$3xy - 2x = -2y - 1 \\Rightarrow x(3y - 2) = -2y - 1$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{2y + 1}{2 - 3y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{2x + 1}{2 - 3x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2$ dan $g(x) = \\sqrt{x - 2}$, nilai $(g \\circ f)(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{34}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{38}$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(6) = 36 + 2 = 38$" },
        { "tipe": "paragraph", "text": "$g(38) = \\sqrt{38 - 2} = \\sqrt{36} = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = x^2 + 2$, nilai $x$ jika $(g \\circ f)(x) = 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{2}$ atau $\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = (2x + 1)^2 + 2 = 4x^2 + 4x + 3$" },
        { "tipe": "paragraph", "text": "$4x^2 + 4x + 3 = 6 \\Rightarrow 4x^2 + 4x - 3 = 0$" },
        { "tipe": "paragraph", "text": "Diskriminan $= 16 + 48 = 64$; $\\sqrt{64} = 8$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{-4 \\pm 8}{8}$ → $x = \\dfrac{1}{2}$ atau $x = -\\dfrac{3}{2}$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
