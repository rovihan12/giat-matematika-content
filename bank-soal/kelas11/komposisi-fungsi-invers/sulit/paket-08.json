{
  "id": "bs-k11-kfi-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang komposisi fungsi bertingkat, invers, dan domain",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 10x + 21$ dengan domain $x \\geq 5$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$5 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-5 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$5 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-5 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 5)^2 - 4 \\Rightarrow y + 4 = (x - 5)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 5$: $x - 5 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 5 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{9x - 4}{2x + 7}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{7x + 4}{9 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7x - 4}{9 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9x + 4}{2x - 7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 7}{9x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7x + 4}{2x - 9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{9x - 4}{2x + 7} \\Rightarrow y(2x + 7) = 9x - 4$" },
        { "tipe": "paragraph", "text": "$2xy + 7y = 9x - 4 \\Rightarrow 2xy - 9x = -7y - 4$" },
        { "tipe": "paragraph", "text": "$x(2y - 9) = -7y - 4 \\Rightarrow x = \\dfrac{7y + 4}{9 - 2y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{7x + 4}{9 - 2x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$, $g(x) = 3x - 2$, dan $h(x) = x^2 + 1$, nilai $(h \\circ g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(1) = 3$" },
        { "tipe": "paragraph", "text": "$g(3) = 7$" },
        { "tipe": "paragraph", "text": "$h(7) = 49 + 1 = 50$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 3x - 2$ dan $(g \\circ f)(x) = 6x^2 - 8x + 5$. Rumus $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}x^2 + \\dfrac{4}{3}x + \\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}x^2 - \\dfrac{4}{3}x + \\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 4x + 7$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}x^2 + \\dfrac{4}{3}x - \\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}x^2 + \\dfrac{2}{3}x + \\dfrac{7}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(3x - 2) = 6x^2 - 8x + 5$. Misal $u = 3x - 2 \\Rightarrow x = \\dfrac{u + 2}{3}$." },
        { "tipe": "paragraph", "text": "$g(u) = 6\\left(\\dfrac{u + 2}{3}\\right)^2 - 8\\left(\\dfrac{u + 2}{3}\\right) + 5$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{6(u + 2)^2}{9} - \\dfrac{8(u + 2)}{3} + 5$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{2}{3}(u^2 + 4u + 4) - \\dfrac{8}{3}u - \\dfrac{16}{3} + 5$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{2}{3}u^2 + \\dfrac{8}{3}u + \\dfrac{8}{3} - \\dfrac{8}{3}u - \\dfrac{16}{3} + \\dfrac{15}{3}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{2}{3}u^2 + \\dfrac{7}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 2}{2x - 1}$, nilai $f^{-1}(-1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{2x - 1} = -1 \\Rightarrow x + 2 = -2x + 1$" },
        { "tipe": "paragraph", "text": "$3x = -1 \\Rightarrow x = -\\dfrac{1}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 6x + 5$ dengan domain $x \\geq 3$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 3)^2 - 4 \\Rightarrow y + 4 = (x - 3)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 3$: $x - 3 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 3 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 2$ dan $(f \\circ g)(x) = 2x^2 + 4x + 5$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x^2 + 4x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 4x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 4x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 3x + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = g(x) + 2 = 2x^2 + 4x + 5$" },
        { "tipe": "paragraph", "text": "$g(x) = 2x^2 + 4x + 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x + 1}{x - 2}$, nilai $f^{-1}(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{x - 2} = 4 \\Rightarrow 3x + 1 = 4x - 8$" },
        { "tipe": "paragraph", "text": "$x = 9$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$, $g(x) = x^2 - 1$, dan $h(x) = \\dfrac{1}{x + 1}$, nilai $(h \\circ g \\circ f)(-1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(-1) = 1$" },
        { "tipe": "paragraph", "text": "$g(1) = 0$" },
        { "tipe": "paragraph", "text": "$h(0) = \\dfrac{1}{0 + 1} = 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 8$ dengan domain $x \\geq -1$, nilai $f^{-1}(7)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 1)^2 - 9 = 7 \\Rightarrow (x + 1)^2 = 16$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -1$: $x + 1 = 4 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
