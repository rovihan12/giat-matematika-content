{
  "id": "bs-k11-kfi-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang invers fungsi rasional dan komposisi bertingkat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x - 1}{x + 3}$, maka $f^{-1}(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hubungan invers $f^{-1}(1) = x \\iff f(x) = 1$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2x - 1}{x + 3} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan linear untuk $x$**" },
        { "tipe": "formula_block", "latex": "2x - 1 = 1(x + 3) \\Rightarrow 2x - x = 3 + 1 \\Rightarrow x = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(1)$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4x + 1$ dengan domain $x \\geq -2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah fungsi kuadrat ke bentuk kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 + 4x + 1 = (x + 2)^2 - 4 + 1 = (x + 2)^2 - 3" },
        { "tipe": "formula_block", "latex": "(x + 2)^2 = y + 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan untuk $x$ dengan memperhatikan domain $x \\geq -2$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -2$, maka $x + 2 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x + 2 = \\sqrt{y + 3} \\Rightarrow x = -2 + \\sqrt{y + 3}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = -2 + \\sqrt{x + 3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$-2 + \\sqrt{x + 3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 1$ dan $g(x) = \\dfrac{x + 3}{2}$, maka $(f \\circ g)(5) - (g \\circ f)(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai $(f \\circ g)(5)$**" },
        { "tipe": "formula_block", "latex": "g(5) = \\dfrac{5 + 3}{2} = \\dfrac{8}{2} = 4" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(5) = f(4) = 2(4) - 1 = 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $(g \\circ f)(5)$**" },
        { "tipe": "formula_block", "latex": "f(5) = 2(5) - 1 = 9" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(5) = g(9) = \\dfrac{9 + 3}{2} = \\dfrac{12}{2} = 6" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung selisih kedua nilai komposisi**" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(5) - (g \\circ f)(5) = 7 - 6 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(f \\circ g)(5) - (g \\circ f)(5)$ adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x + 1}{2x - 5}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 1}{2x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 1}{2x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 1}{2x + 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 1}{3 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 1}{2x - 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(2x - 5)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{3x + 1}{2x - 5} \\Rightarrow y(2x - 5) = 3x + 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kumpulkan suku yang memuat $x$ ke satu ruas**" },
        { "tipe": "formula_block", "latex": "2xy - 5y = 3x + 1 \\Rightarrow 2xy - 3x = 5y + 1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan nyatakan dalam bentuk $x = \\dots$**" },
        { "tipe": "formula_block", "latex": "x(2y - 3) = 5y + 1 \\Rightarrow x = \\dfrac{5y + 1}{2y - 3}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{5x + 1}{2x - 3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{5x + 1}{2x - 3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 6x + 5$ dengan domain $x \\geq 3$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{x - 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah fungsi kuadrat ke bentuk kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 - 6x + 5 = (x - 3)^2 - 9 + 5 = (x - 3)^2 - 4" },
        { "tipe": "formula_block", "latex": "(x - 3)^2 = y + 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ambil akar kuadrat dengan memperhatikan domain $x \\geq 3$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 3$, maka $x - 3 \\geq 0$, sehingga:" },
        { "tipe": "formula_block", "latex": "x - 3 = \\sqrt{y + 4} \\Rightarrow x = 3 + \\sqrt{y + 4}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = 3 + \\sqrt{x + 4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$3 + \\sqrt{x + 4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x + 3$ dan $g(x) = x^2 - 1$. Nilai $x$ jika $(f \\circ g)(x) = 19$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$-4$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$0$ saja" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun rumus $(f \\circ g)(x)$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(x) = f(g(x)) = f(x^2 - 1) = 2(x^2 - 1) + 3 = 2x^2 - 2 + 3 = 2x^2 + 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan dengan $19$ dan selesaikan persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "2x^2 + 1 = 19 \\Rightarrow 2x^2 = 18 \\Rightarrow x^2 = 9" },
        { "tipe": "formula_block", "latex": "x = \\pm \\sqrt{9} = \\pm 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$-3$ atau $3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4}{x - 2}$ dan $g(x) = x + 3$, nilai $(g \\circ f)(6)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai fungsi bagian dalam $f(6)$**" },
        { "tipe": "formula_block", "latex": "f(6) = \\dfrac{4}{6 - 2} = \\dfrac{4}{4} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan hasil $f(6)$ ke dalam fungsi $g(x)$**" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(6) = g(f(6)) = g(1) = 1 + 3 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(g \\circ f)(6)$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$ dan $(g \\circ f)(x) = 9x^2 - 12x + 8$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 8$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 + 4$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $u = f(x) = 3x - 2$, lalu nyatakan $x$ dalam $u$**" },
        { "tipe": "formula_block", "latex": "u = 3x - 2 \\Rightarrow 3x = u + 2 \\Rightarrow x = \\dfrac{u + 2}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = \\dfrac{u + 2}{3}$ ke dalam $(g \\circ f)(x) = g(u)$**" },
        { "tipe": "formula_block", "latex": "g(u) = 9\\left(\\dfrac{u + 2}{3}\\right)^2 - 12\\left(\\dfrac{u + 2}{3}\\right) + 8" },
        { "tipe": "formula_block", "latex": "g(u) = 9 \\cdot \\dfrac{(u + 2)^2}{9} - 4(u + 2) + 8 = (u + 2)^2 - 4(u + 2) + 8" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jabarkan dan sederhanakan bentuk aljabarnya**" },
        { "tipe": "formula_block", "latex": "g(u) = (u^2 + 4u + 4) - (4u + 8) + 8 = u^2 + 4" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $u$ menjadi $x$**" },
        { "tipe": "formula_block", "latex": "g(x) = x^2 + 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus fungsi $g(x)$ adalah **$x^2 + 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x}{x - 1}$ dan $f^{-1}(x)$ adalah inversnya, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(3) = x \\iff f(x) = 3$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{x}{x - 1} = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan untuk $x$**" },
        { "tipe": "formula_block", "latex": "x = 3(x - 1) \\Rightarrow x = 3x - 3" },
        { "tipe": "formula_block", "latex": "2x = 3 \\Rightarrow x = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(3)$ adalah **$\\dfrac{3}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 1}{2}$ dan $g(x) = 3x - 1$, nilai $(f^{-1} \\circ g^{-1})(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rumus fungsi invers $f^{-1}(x)$ dan $g^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{x + 1}{2} \\Rightarrow 2y = x + 1 \\Rightarrow x = 2y - 1 \\Rightarrow f^{-1}(x) = 2x - 1" },
        { "tipe": "formula_block", "latex": "y = 3x - 1 \\Rightarrow 3x = y + 1 \\Rightarrow x = \\dfrac{y + 1}{3} \\Rightarrow g^{-1}(x) = \\dfrac{x + 1}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $(f^{-1} \\circ g^{-1})(5) = f^{-1}(g^{-1}(5))$**" },
        { "tipe": "formula_block", "latex": "g^{-1}(5) = \\dfrac{5 + 1}{3} = \\dfrac{6}{3} = 2" },
        { "tipe": "formula_block", "latex": "f^{-1}(g^{-1}(5)) = f^{-1}(2) = 2(2) - 1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(f^{-1} \\circ g^{-1})(5)$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
