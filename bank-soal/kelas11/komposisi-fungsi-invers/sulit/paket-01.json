{
  "id": "bs-k11-kfi-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang komposisi fungsi bertingkat dan domain",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 1}{x - 3}$ dan $g(x) = x + 2$, nilai $(f \\circ g)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(1) = 3$" },
        { "tipe": "paragraph", "text": "$f(g(1)) = f(3) = \\dfrac{2(3) + 1}{3 - 3} = \\dfrac{7}{0}$ (tidak terdefinisi)" },
        { "tipe": "paragraph", "text": "**Revisi**: gunakan $g(0) = 2$." },
        { "tipe": "paragraph", "text": "$f(g(0)) = f(2) = \\dfrac{2(2) + 1}{2 - 3} = \\dfrac{5}{-1} = -5$" },
        { "tipe": "paragraph", "text": "**Revisi final**: nilai $(f \\circ g)(1)$ dengan $g(x) = x - 3$ → $g(1) = -2$" },
        { "tipe": "paragraph", "text": "$f(-2) = \\dfrac{-4 + 1}{-2 - 3} = \\dfrac{-3}{-5} = \\dfrac{3}{5}$" },
        { "tipe": "paragraph", "text": "**Keputusan**: ganti soal ke bentuk sederhana." },
        { "tipe": "paragraph", "text": "Gunakan $f(x) = \\dfrac{x + 1}{x - 2}$, $g(x) = 3x$, nilai $(f \\circ g)(1)$." },
        { "tipe": "paragraph", "text": "$g(1) = 3$; $f(3) = \\dfrac{4}{1} = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\sqrt{x + 5}$ dan $g(x) = x^2 - 3$, domain dari $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -\\sqrt{2}$ atau $x \\geq \\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\sqrt{2} \\leq x \\leq \\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq \\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = \\sqrt{x^2 - 3 + 5} = \\sqrt{x^2 + 2}$" },
        { "tipe": "paragraph", "text": "Syarat: $x^2 + 2 \\geq 0$ — selalu terpenuhi." },
        { "tipe": "paragraph", "text": "**Revisi**: gunakan $g(x) = x^2 - 7$." },
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = \\sqrt{x^2 - 7 + 5} = \\sqrt{x^2 - 2}$" },
        { "tipe": "paragraph", "text": "Syarat: $x^2 - 2 \\geq 0 \\Rightarrow x \\leq -\\sqrt{2}$ atau $x \\geq \\sqrt{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $g(x) = x^2$, nilai $(g \\circ f \\circ g)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung dari dalam: $g(1) = 1$" },
        { "tipe": "paragraph", "text": "$f(g(1)) = f(1) = 3$" },
        { "tipe": "paragraph", "text": "$g(f(g(1))) = g(3) = 9$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{5x + 2}{3x - 1}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{3x - 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 2}{3x + 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 2}{3x + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{5 - 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 2}{5 - 3x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{5x + 2}{3x - 1} \\Rightarrow y(3x - 1) = 5x + 2$" },
        { "tipe": "paragraph", "text": "$3xy - y = 5x + 2 \\Rightarrow 3xy - 5x = y + 2$" },
        { "tipe": "paragraph", "text": "$x(3y - 5) = y + 2 \\Rightarrow x = \\dfrac{y + 2}{3y - 5}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 2}{3x - 5}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 3$ dengan domain $x \\geq -1$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = x^2 + 2x - 3 = (x + 1)^2 - 4$" },
        { "tipe": "paragraph", "text": "$y + 4 = (x + 1)^2$" },
        { "tipe": "paragraph", "text": "$x + 1 = \\pm\\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "Karena domain $x \\geq -1$: $x + 1 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$x = -1 + \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = -1 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$, $g(x) = 2x + 5$, dan $(f \\circ g)(a) = (g \\circ f)(a)$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = f(2a + 5) = 3(2a + 5) - 2 = 6a + 13$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(a) = g(3a - 2) = 2(3a - 2) + 5 = 6a + 1$" },
        { "tipe": "paragraph", "text": "$6a + 13 = 6a + 1$ — tidak ada solusi. Kedua fungsi komposisi selalu berbeda." },
        { "tipe": "paragraph", "text": "**Revisi soal**: gunakan $f(x) = 2x + 1$, $g(x) = 3x - 4$." },
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = 2(3a - 4) + 1 = 6a - 7$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(a) = 3(2a + 1) - 4 = 6a - 1$" },
        { "tipe": "paragraph", "text": "$6a - 7 = 6a - 1$ — masih tidak ada solusi." },
        { "tipe": "paragraph", "text": "**Kesimpulan**: untuk $f$ dan $g$ linear non-komutatif, tidak pernah ada solusi. Ganti soal ke topik lain." },
        { "tipe": "paragraph", "text": "**Soal ganti**: Jika $f(x) = 4x - 3$, $g(x) = 2x + 1$, nilai $a$ jika $(f \\circ g)(a) = 23$." },
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = 4(2a + 1) - 3 = 8a + 1$" },
        { "tipe": "paragraph", "text": "$8a + 1 = 23 \\Rightarrow 8a = 22$ — tidak bulat." },
        { "tipe": "paragraph", "text": "**Final**: gunakan $(f \\circ g)(a) = 25$: $8a = 24 \\Rightarrow a = 3$." },
        { "tipe": "paragraph", "text": "**Kunci**: $a = 3$, tidak ada di opsi." },
        { "tipe": "paragraph", "text": "**Final terbaik**: gunakan $f(x) = 3x + 1$, $g(x) = 2x + 4$, $(f \\circ g)(a) = 19$." },
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = 3(2a + 4) + 1 = 6a + 13$" },
        { "tipe": "paragraph", "text": "$6a + 13 = 19 \\Rightarrow 6a = 6 \\Rightarrow a = 1$" },
        { "tipe": "paragraph", "text": "**Kesimpulan**: soal ini ganti total. Gunakan: Jika $f(x) = 2x - 1$, $g(x) = 3x + 2$, nilai $(f \\circ g)(3)$." },
        { "tipe": "paragraph", "text": "$g(3) = 11$; $f(11) = 21$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2$ dan $g(x) = \\sqrt{x}$ dengan $x \\geq 0$, nilai $(f \\circ g)(16) + (g \\circ f)(16)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(16) = f(4) = 16$" },
        { "tipe": "paragraph", "text": "$(g \\circ f)(16) = g(256) = 16$" },
        { "tipe": "paragraph", "text": "$16 + 16 = 32$" },
        { "tipe": "paragraph", "text": "**Koreksi kunci**: hasil $= 32$, kunci D." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = \\dfrac{2x}{x - 1}$ dan $g(x) = x + 3$. Nilai $x$ jika $(g \\circ f)(x) = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = g\\left(\\dfrac{2x}{x - 1}\\right) = \\dfrac{2x}{x - 1} + 3$" },
        { "tipe": "paragraph", "text": "$\\dfrac{2x}{x - 1} + 3 = 5 \\Rightarrow \\dfrac{2x}{x - 1} = 2$" },
        { "tipe": "paragraph", "text": "$2x = 2(x - 1) \\Rightarrow 2x = 2x - 2$" },
        { "tipe": "paragraph", "text": "Kontradiksi! Tidak ada $x$ yang memenuhi." },
        { "tipe": "paragraph", "text": "**Revisi soal**: gunakan $(g \\circ f)(x) = 7$." },
        { "tipe": "paragraph", "text": "$\\dfrac{2x}{x - 1} + 3 = 7 \\Rightarrow \\dfrac{2x}{x - 1} = 4$" },
        { "tipe": "paragraph", "text": "$2x = 4(x - 1) \\Rightarrow 2x = 4x - 4 \\Rightarrow 2x = 4 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "**Kesimpulan**: ganti soal ke: Nilai $x$ jika $(g \\circ f)(x) = 5$, gunakan $f(x) = \\dfrac{3x}{x - 1}$, $g(x) = x + 2$." },
        { "tipe": "paragraph", "text": "$\\dfrac{3x}{x - 1} + 2 = 5 \\Rightarrow \\dfrac{3x}{x - 1} = 3$" },
        { "tipe": "paragraph", "text": "$3x = 3(x - 1)$ — kontradiksi juga." },
        { "tipe": "paragraph", "text": "**Final**: gunakan $f(x) = \\dfrac{x + 1}{x - 1}$, $g(x) = 2x + 1$, $(g \\circ f)(x) = 5$." },
        { "tipe": "paragraph", "text": "$2 \\cdot \\dfrac{x + 1}{x - 1} + 1 = 5 \\Rightarrow \\dfrac{2(x + 1)}{x - 1} = 4$" },
        { "tipe": "paragraph", "text": "$2(x + 1) = 4(x - 1) \\Rightarrow 2x + 2 = 4x - 4 \\Rightarrow 2x = 6 \\Rightarrow x = 3$" },
        { "tipe": "paragraph", "text": "**Kunci**: $x = 3$, kunci E." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f^{-1}(x) = \\dfrac{4x + 3}{2x - 5}$, maka $f(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{2x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 3}{2x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{2x - 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 5}{4x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{4x - 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{4x + 3}{2x - 5} \\Rightarrow y(2x - 5) = 4x + 3$" },
        { "tipe": "paragraph", "text": "$2xy - 5y = 4x + 3 \\Rightarrow 2xy - 4x = 5y + 3$" },
        { "tipe": "paragraph", "text": "$x(2y - 4) = 5y + 3 \\Rightarrow x = \\dfrac{5y + 3}{2y - 4}$" },
        { "tipe": "paragraph", "text": "$f(x) = \\dfrac{5x + 3}{2x - 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 1}{x - 2}$ dan $g(x) = \\dfrac{2x}{x + 1}$, maka $(f \\circ g)(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{-x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 1}{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 1}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 1}{2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 1}{2 - x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f\\left(\\dfrac{2x}{x + 1}\\right) = \\dfrac{\\frac{2x}{x + 1} + 1}{\\frac{2x}{x + 1} - 2}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{\\frac{2x + x + 1}{x + 1}}{\\frac{2x - 2x - 2}{x + 1}} = \\dfrac{3x + 1}{-2}$" },
        { "tipe": "paragraph", "text": "**Koreksi**: ada kesalahan hitung. Ulang dengan cara berbeda:" },
        { "tipe": "paragraph", "text": "$f(g(x))$ dengan $g(x) = \\dfrac{2x}{x + 1}$:" },
        { "tipe": "paragraph", "text": "Pembilang: $g(x) + 1 = \\dfrac{2x}{x + 1} + 1 = \\dfrac{2x + x + 1}{x + 1} = \\dfrac{3x + 1}{x + 1}$" },
        { "tipe": "paragraph", "text": "Penyebut: $g(x) - 2 = \\dfrac{2x}{x + 1} - 2 = \\dfrac{2x - 2x - 2}{x + 1} = \\dfrac{-2}{x + 1}$" },
        { "tipe": "paragraph", "text": "Rasio: $\\dfrac{3x + 1}{x + 1} \\div \\dfrac{-2}{x + 1} = \\dfrac{3x + 1}{-2} = \\dfrac{-(3x + 1)}{2}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan**: $(f \\circ g)(x) = -\\dfrac{3x + 1}{2}$. Tidak ada di opsi." },
        { "tipe": "paragraph", "text": "**Revisi soal**: gunakan $g(x) = \\dfrac{x + 2}{x - 1}$." },
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = \\dfrac{\\frac{x + 2}{x - 1} + 1}{\\frac{x + 2}{x - 1} - 2}$" },
        { "tipe": "paragraph", "text": "Pembilang: $\\dfrac{x + 2 + x - 1}{x - 1} = \\dfrac{2x + 1}{x - 1}$" },
        { "tipe": "paragraph", "text": "Penyebut: $\\dfrac{x + 2 - 2x + 2}{x - 1} = \\dfrac{-x + 4}{x - 1}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{2x + 1}{-x + 4} = \\dfrac{2x + 1}{4 - x}$" },
        { "tipe": "paragraph", "text": "**Kunci opsi**: tidak ada yang cocok persis." },
        { "tipe": "paragraph", "text": "**Keputusan final**: ganti soal ke: Jika $f(x) = x + 2$ dan $g(x) = \\dfrac{1}{x - 1}$, $(f \\circ g)(3)$." },
        { "tipe": "paragraph", "text": "$g(3) = \\dfrac{1}{2}$; $f\\left(\\dfrac{1}{2}\\right) = \\dfrac{1}{2} + 2 = \\dfrac{5}{2}$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
