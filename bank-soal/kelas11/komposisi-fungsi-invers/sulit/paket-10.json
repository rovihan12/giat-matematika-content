{
  "id": "bs-k11-kfi-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang komposisi bertingkat, invers kuadrat, dan analisis fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 14x + 45$ dengan domain $x \\geq 7$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$7 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-7 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$7 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-7 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk fungsi kuadrat menjadi kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 - 14x + 45 = (x - 7)^2 - 49 + 45 = (x - 7)^2 - 4" },
        { "tipe": "formula_block", "latex": "(x - 7)^2 = y + 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ambil akar kuadrat dengan memperhatikan domain $x \\geq 7$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 7$, maka $x - 7 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x - 7 = \\sqrt{y + 4} \\Rightarrow x = 7 + \\sqrt{y + 4}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = 7 + \\sqrt{x + 4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$7 + \\sqrt{x + 4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{5x - 3}{2x + 9}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9x + 3}{5 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9x - 3}{5 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{2x - 9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 9}{5x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9x + 3}{2x - 5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(2x + 9)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{5x - 3}{2x + 9} \\Rightarrow y(2x + 9) = 5x - 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "2xy + 9y = 5x - 3 \\Rightarrow 2xy - 5x = -9y - 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan sederhanakan tanda negatif**" },
        { "tipe": "formula_block", "latex": "x(2y - 5) = -(9y + 3) \\Rightarrow x = \\dfrac{-(9y + 3)}{2y - 5} = \\dfrac{9y + 3}{5 - 2y}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{9x + 3}{5 - 2x}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{9x + 3}{5 - 2x}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$, $g(x) = x^2 + 1$, dan $h(x) = 2x + 5$, nilai $(h \\circ g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Evaluasi fungsi terdalam $f(1)$**" },
        { "tipe": "formula_block", "latex": "f(1) = 3(1) - 2 = 3 - 2 = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Evaluasi fungsi tengah $g(f(1)) = g(1)$**" },
        { "tipe": "formula_block", "latex": "g(1) = 1^2 + 1 = 1 + 1 = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Evaluasi fungsi terluar $h(g(f(1))) = h(2)$**" },
        { "tipe": "formula_block", "latex": "(h \\circ g \\circ f)(1) = h(2) = 2(2) + 5 = 4 + 5 = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(h \\circ g \\circ f)(1)$ adalah **$9$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 3$ dan $(g \\circ f)(x) = 8x^2 - 12x + 7$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}x^2 + \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}x^2 - \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}x^2 + \\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 5$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $u = f(x) = 4x - 3$, lalu nyatakan $x$ dalam $u$**" },
        { "tipe": "formula_block", "latex": "u = 4x - 3 \\Rightarrow 4x = u + 3 \\Rightarrow x = \\dfrac{u + 3}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = \\dfrac{u + 3}{4}$ ke dalam $(g \\circ f)(x) = g(u)$**" },
        { "tipe": "formula_block", "latex": "g(u) = 8\\left(\\dfrac{u + 3}{4}\\right)^2 - 12\\left(\\dfrac{u + 3}{4}\\right) + 7" },
        { "tipe": "formula_block", "latex": "g(u) = 8 \\cdot \\dfrac{(u + 3)^2}{16} - 3(u + 3) + 7 = \\dfrac{1}{2}(u + 3)^2 - 3(u + 3) + 7" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jabarkan dan sederhanakan suku-suku sejenis**" },
        { "tipe": "formula_block", "latex": "g(u) = \\dfrac{1}{2}(u^2 + 6u + 9) - 3u - 9 + 7 = \\dfrac{1}{2}u^2 + 3u + \\dfrac{9}{2} - 3u - 2 = \\dfrac{1}{2}u^2 + \\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $u$ menjadi $x$**" },
        { "tipe": "formula_block", "latex": "g(x) = \\dfrac{1}{2}x^2 + \\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus fungsi $g(x)$ adalah **$\\dfrac{1}{2}x^2 + \\dfrac{5}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 7}{3x - 1}$, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(3) = x \\iff f(x) = 3$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2x + 7}{3x - 1} = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan linear untuk $x$**" },
        { "tipe": "formula_block", "latex": "2x + 7 = 3(3x - 1) \\Rightarrow 2x + 7 = 9x - 3" },
        { "tipe": "formula_block", "latex": "7 + 3 = 9x - 2x \\Rightarrow 7x = 10 \\Rightarrow x = \\dfrac{10}{7}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(3)$ adalah **$\\dfrac{10}{7}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 8x + 7$ dengan domain $x \\geq 4$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4 + \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$4 - \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$-4 + \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$4 + \\sqrt{x - 9}$" } ],
        [ { "tipe": "paragraph", "text": "$-4 - \\sqrt{x + 9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk fungsi kuadrat menjadi kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 - 8x + 7 = (x - 4)^2 - 16 + 7 = (x - 4)^2 - 9" },
        { "tipe": "formula_block", "latex": "(x - 4)^2 = y + 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ambil akar kuadrat dengan memperhatikan domain $x \\geq 4$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 4$, maka $x - 4 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x - 4 = \\sqrt{y + 9} \\Rightarrow x = 4 + \\sqrt{y + 9}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = 4 + \\sqrt{x + 9}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$4 + \\sqrt{x + 9}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 3$ dan $(f \\circ g)(x) = 4x^2 - 2x + 1$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x^2 - x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 2x + 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan $(f \\circ g)(x)$ menggunakan rumus $f(x) = 2x - 3$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(x) = f(g(x)) = 2 \\cdot g(x) - 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan dengan $4x^2 - 2x + 1$ lalu selesaikan untuk $g(x)$**" },
        { "tipe": "formula_block", "latex": "2 \\cdot g(x) - 3 = 4x^2 - 2x + 1 \\Rightarrow 2 \\cdot g(x) = 4x^2 - 2x + 4" },
        { "tipe": "formula_block", "latex": "g(x) = \\dfrac{4x^2 - 2x + 4}{2} = 2x^2 - x + 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus fungsi $g(x)$ adalah **$2x^2 - x + 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{8x - 5}{3x + 2}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 5}{8 - 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 5}{8 + 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8x + 5}{3x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 2}{8x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 5}{3x - 8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(3x + 2)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{8x - 5}{3x + 2} \\Rightarrow y(3x + 2) = 8x - 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "3xy + 2y = 8x - 5 \\Rightarrow 3xy - 8x = -2y - 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan sederhanakan tanda negatif**" },
        { "tipe": "formula_block", "latex": "x(3y - 8) = -(2y + 5) \\Rightarrow x = \\dfrac{-(2y + 5)}{3y - 8} = \\dfrac{2y + 5}{8 - 3y}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{2x + 5}{8 - 3x}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{2x + 5}{8 - 3x}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 1$, $g(x) = x^2 - 2x$, dan $(f \\circ g)(a) = 10$, nilai $a$ yang memenuhi adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$-4$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$1$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$2$ atau $3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun persamaan komposisi $(f \\circ g)(a) = 10$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(a) = f(g(a)) = 3(a^2 - 2a) + 1 = 3a^2 - 6a + 1" },
        { "tipe": "formula_block", "latex": "3a^2 - 6a + 1 = 10 \\Rightarrow 3a^2 - 6a - 9 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan dan faktorkan persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Bagi kedua ruas dengan $3$:" },
        { "tipe": "formula_block", "latex": "a^2 - 2a - 3 = 0 \\Rightarrow (a - 3)(a + 1) = 0" },
        { "tipe": "formula_block", "latex": "a = 3 \\quad \\text{atau} \\quad a = -1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ yang memenuhi adalah **$-1$ atau $3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 15$ dengan domain $x \\geq -1$, nilai $f^{-1}(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(0) = x \\iff f(x) = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 + 2x - 15 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah ke bentuk kuadrat sempurna dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "(x + 1)^2 - 16 = 0 \\Rightarrow (x + 1)^2 = 16" },
        { "tipe": "paragraph", "text": "**Langkah 3: Pilih nilai $x$ yang memenuhi domain $x \\geq -1$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -1$, maka $x + 1 \\geq 0$, sehingga diambil akar positif:" },
        { "tipe": "formula_block", "latex": "x + 1 = 4 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(0)$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
