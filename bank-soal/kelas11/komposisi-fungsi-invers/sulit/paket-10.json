{
  "id": "bs-k11-kfi-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang komposisi bertingkat, invers kuadrat, dan analisis fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 14x + 45$ dengan domain $x \\geq 7$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$7 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-7 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$7 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-7 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 7)^2 - 4 \\Rightarrow y + 4 = (x - 7)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 7$: $x - 7 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 7 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{5x - 3}{2x + 9}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9x + 3}{5 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9x - 3}{5 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{2x - 9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 9}{5x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9x + 3}{2x - 5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{5x - 3}{2x + 9} \\Rightarrow y(2x + 9) = 5x - 3$" },
        { "tipe": "paragraph", "text": "$2xy + 9y = 5x - 3 \\Rightarrow 2xy - 5x = -9y - 3$" },
        { "tipe": "paragraph", "text": "$x(2y - 5) = -9y - 3 \\Rightarrow x = \\dfrac{9y + 3}{5 - 2y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{9x + 3}{5 - 2x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 2$, $g(x) = x^2 + 1$, dan $h(x) = 2x + 5$, nilai $(h \\circ g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(1) = 1$" },
        { "tipe": "paragraph", "text": "$g(1) = 2$" },
        { "tipe": "paragraph", "text": "$h(2) = 9$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 3$ dan $(g \\circ f)(x) = 8x^2 - 12x + 7$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}x^2 + \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}x^2 - \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}x^2 + \\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 5$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(4x - 3) = 8x^2 - 12x + 7$. Misal $u = 4x - 3 \\Rightarrow x = \\dfrac{u + 3}{4}$." },
        { "tipe": "paragraph", "text": "$g(u) = 8\\left(\\dfrac{u + 3}{4}\\right)^2 - 12\\left(\\dfrac{u + 3}{4}\\right) + 7$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}(u + 3)^2 - 3(u + 3) + 7$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}(u^2 + 6u + 9) - 3u - 9 + 7$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}u^2 + 3u + \\dfrac{9}{2} - 3u - 2 = \\dfrac{1}{2}u^2 + \\dfrac{5}{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 7}{3x - 1}$, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2x + 7}{3x - 1} = 3 \\Rightarrow 2x + 7 = 9x - 3$" },
        { "tipe": "paragraph", "text": "$7x = 10 \\Rightarrow x = \\dfrac{10}{7}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 8x + 7$ dengan domain $x \\geq 4$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4 + \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$4 - \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$-4 + \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$4 + \\sqrt{x - 9}$" } ],
        [ { "tipe": "paragraph", "text": "$-4 - \\sqrt{x + 9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 4)^2 - 9 \\Rightarrow y + 9 = (x - 4)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 4$: $x - 4 = \\sqrt{y + 9}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 4 + \\sqrt{x + 9}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 3$ dan $(f \\circ g)(x) = 4x^2 - 2x + 1$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x^2 - x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 2x + 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 2 \\cdot g(x) - 3 = 4x^2 - 2x + 1$" },
        { "tipe": "paragraph", "text": "$2 \\cdot g(x) = 4x^2 - 2x + 4$" },
        { "tipe": "paragraph", "text": "$g(x) = 2x^2 - x + 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{8x - 5}{3x + 2}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 5}{8 - 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 5}{8 + 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8x + 5}{3x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 2}{8x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 5}{3x - 8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{8x - 5}{3x + 2} \\Rightarrow y(3x + 2) = 8x - 5$" },
        { "tipe": "paragraph", "text": "$3xy + 2y = 8x - 5 \\Rightarrow 3xy - 8x = -2y - 5$" },
        { "tipe": "paragraph", "text": "$x(3y - 8) = -2y - 5 \\Rightarrow x = \\dfrac{2y + 5}{8 - 3y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{2x + 5}{8 - 3x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 1$, $g(x) = x^2 - 2x$, dan $(f \\circ g)(a) = 10$, nilai $a$ yang memenuhi adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$-4$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$1$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$2$ atau $3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = 3(a^2 - 2a) + 1 = 3a^2 - 6a + 1$" },
        { "tipe": "paragraph", "text": "$3a^2 - 6a + 1 = 10 \\Rightarrow 3a^2 - 6a - 9 = 0$" },
        { "tipe": "paragraph", "text": "$a^2 - 2a - 3 = 0 \\Rightarrow (a - 3)(a + 1) = 0$" },
        { "tipe": "paragraph", "text": "$a = 3$ atau $a = -1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 15$ dengan domain $x \\geq -1$, nilai $f^{-1}(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 1)^2 - 16 = 0 \\Rightarrow (x + 1)^2 = 16$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -1$: $x + 1 = 4 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
