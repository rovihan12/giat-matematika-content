{
  "id": "bs-k11-kfi-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang invers fungsi kuadrat berdomain terbatas dan komposisi bertingkat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 8x + 12$ dengan domain $x \\geq 4$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$4 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-4 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$4 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-4 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 4)^2 - 4 \\Rightarrow y + 4 = (x - 4)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 4$: $x - 4 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 4 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{5x - 7}{3x + 2}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 7}{5 - 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 7}{5 + 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 7}{3x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 7}{3x - 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x - 7}{3x + 5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{5x - 7}{3x + 2} \\Rightarrow y(3x + 2) = 5x - 7$" },
        { "tipe": "paragraph", "text": "$3xy + 2y = 5x - 7 \\Rightarrow 3xy - 5x = -2y - 7$" },
        { "tipe": "paragraph", "text": "$x(3y - 5) = -2y - 7 \\Rightarrow x = \\dfrac{2y + 7}{5 - 3y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{2x + 7}{5 - 3x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$, $g(x) = x - 3$, dan $h(x) = x^2$, nilai $(h \\circ g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 5$" },
        { "tipe": "paragraph", "text": "$g(5) = 2$" },
        { "tipe": "paragraph", "text": "$h(2) = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^2 + 2x - 3$ dengan domain $x \\geq -1$. Nilai $f^{-1}(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 1)^2 - 4 = 5 \\Rightarrow (x + 1)^2 = 9$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -1$: $x + 1 = 3 \\Rightarrow x = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 1}{x - 2}$ dan $g(x) = 3x + 1$, nilai $x$ jika $(g \\circ f)(x) = 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(g \\circ f)(x) = 3 \\cdot \\dfrac{x + 1}{x - 2} + 1 = 7$" },
        { "tipe": "paragraph", "text": "$3 \\cdot \\dfrac{x + 1}{x - 2} = 6 \\Rightarrow \\dfrac{x + 1}{x - 2} = 2$" },
        { "tipe": "paragraph", "text": "$x + 1 = 2x - 4 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f^{-1}(x) = \\dfrac{3x - 4}{x + 1}$, maka $f(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 4}{3 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 4}{3 + x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 4}{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 4}{x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 4}{x + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{3x - 4}{x + 1} \\Rightarrow y(x + 1) = 3x - 4$" },
        { "tipe": "paragraph", "text": "$xy + y = 3x - 4 \\Rightarrow xy - 3x = -y - 4$" },
        { "tipe": "paragraph", "text": "$x(y - 3) = -y - 4 \\Rightarrow x = \\dfrac{y + 4}{3 - y}$" },
        { "tipe": "paragraph", "text": "$f(x) = \\dfrac{x + 4}{3 - x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 4x + 3$ dengan domain $x \\geq 2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x + 1}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 2)^2 - 1 \\Rightarrow y + 1 = (x - 2)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 2$: $x - 2 = \\sqrt{y + 1}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 2 + \\sqrt{x + 1}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 5$ dan $(f \\circ g)(x) = 12x^2 - 4x + 3$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x^2 - x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 + x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 - x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 - 2x + 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(g(x)) = 4 \\cdot g(x) - 5 = 12x^2 - 4x + 3$" },
        { "tipe": "paragraph", "text": "$4 \\cdot g(x) = 12x^2 - 4x + 8$" },
        { "tipe": "paragraph", "text": "$g(x) = 3x^2 - x + 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x - 3}{x + 4}$, nilai $f^{-1}(-1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2x - 3}{x + 4} = -1 \\Rightarrow 2x - 3 = -x - 4$" },
        { "tipe": "paragraph", "text": "$3x = -1 \\Rightarrow x = -\\dfrac{1}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$ dan $g(x) = x^2 - 2x$, nilai $x$ jika $(f \\circ g)(x) = 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$0$ atau $3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = 2(x^2 - 2x) + 3 = 2x^2 - 4x + 3$" },
        { "tipe": "paragraph", "text": "$2x^2 - 4x + 3 = 9 \\Rightarrow 2x^2 - 4x - 6 = 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 3 = 0 \\Rightarrow (x - 3)(x + 1) = 0$" },
        { "tipe": "paragraph", "text": "$x = 3$ atau $x = -1$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
