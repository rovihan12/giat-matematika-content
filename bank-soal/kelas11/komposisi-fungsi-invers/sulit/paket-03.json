{
  "id": "bs-k11-kfi-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang komposisi bertingkat dan aplikasi fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 3}{x - 4}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x - 3}{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2x + 3}{4 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{2 - x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 4}{x - 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(x - 4)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{2x + 3}{x - 4} \\Rightarrow y(x - 4) = 2x + 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "xy - 4y = 2x + 3 \\Rightarrow xy - 2x = 4y + 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan nyatakan dalam bentuk $x = \\dots$**" },
        { "tipe": "formula_block", "latex": "x(y - 2) = 4y + 3 \\Rightarrow x = \\dfrac{4y + 3}{y - 2}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{4x + 3}{x - 2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{4x + 3}{x - 2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2x - 3$ dengan domain $x \\geq 1$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk fungsi kuadrat menjadi kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 - 2x - 3 = (x - 1)^2 - 1 - 3 = (x - 1)^2 - 4" },
        { "tipe": "formula_block", "latex": "(x - 1)^2 = y + 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan untuk $x$ dengan memperhatikan domain $x \\geq 1$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 1$, maka $x - 1 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x - 1 = \\sqrt{y + 4} \\Rightarrow x = 1 + \\sqrt{y + 4}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = 1 + \\sqrt{x + 4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$1 + \\sqrt{x + 4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 2$, $g(x) = 2x - 1$, dan $h(x) = x^2$, nilai $(f \\circ g \\circ h)(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai fungsi terdalam $h(3)$**" },
        { "tipe": "formula_block", "latex": "h(3) = 3^2 = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai fungsi tengah $g(h(3)) = g(9)$**" },
        { "tipe": "formula_block", "latex": "g(9) = 2(9) - 1 = 18 - 1 = 17" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai fungsi terluar $f(g(h(3))) = f(17)$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g \\circ h)(3) = f(17) = 17 + 2 = 19" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(f \\circ g \\circ h)(3)$ adalah **$19$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 1}{x - 2}$, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(3) = x \\iff f(x) = 3$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2x + 1}{x - 2} = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan linear untuk $x$**" },
        { "tipe": "formula_block", "latex": "2x + 1 = 3(x - 2) \\Rightarrow 2x + 1 = 3x - 6" },
        { "tipe": "formula_block", "latex": "1 + 6 = 3x - 2x \\Rightarrow x = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(3)$ adalah **$7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4x - 3$ dan $(f \\circ g)(x) = 8x + 5$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x + 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 2$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 4$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan $(f \\circ g)(x)$ menggunakan rumus $f(x) = 4x - 3$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(x) = f(g(x)) = 4 \\cdot g(x) - 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan dengan $8x + 5$ lalu selesaikan untuk $g(x)$**" },
        { "tipe": "formula_block", "latex": "4 \\cdot g(x) - 3 = 8x + 5 \\Rightarrow 4 \\cdot g(x) = 8x + 8" },
        { "tipe": "formula_block", "latex": "g(x) = \\dfrac{8x + 8}{4} = 2x + 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus fungsi $g(x)$ adalah **$2x + 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 6x + 5$ dengan domain $x \\geq -3$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk fungsi kuadrat ke bentuk kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 + 6x + 5 = (x + 3)^2 - 9 + 5 = (x + 3)^2 - 4" },
        { "tipe": "formula_block", "latex": "(x + 3)^2 = y + 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan untuk $x$ dengan memperhatikan domain $x \\geq -3$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -3$, maka $x + 3 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x + 3 = \\sqrt{y + 4} \\Rightarrow x = -3 + \\sqrt{y + 4}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = -3 + \\sqrt{x + 4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$-3 + \\sqrt{x + 4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x$ dan $g(x) = x^2 - 1$, nilai $(f \\circ g)(1) - (g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai $(f \\circ g)(1)$**" },
        { "tipe": "formula_block", "latex": "g(1) = 1^2 - 1 = 0 \\Rightarrow (f \\circ g)(1) = f(0) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $(g \\circ f)(1)$**" },
        { "tipe": "formula_block", "latex": "f(1) = 1 \\Rightarrow (g \\circ f)(1) = g(1) = 1^2 - 1 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung selisih kedua nilai komposisi**" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(1) - (g \\circ f)(1) = 0 - 0 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(f \\circ g)(1) - (g \\circ f)(1)$ adalah **$0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4x - 5}{2x + 3}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 5}{4 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 5}{4 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 5}{3 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x + 5}{2x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x - 5}{2x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(2x + 3)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{4x - 5}{2x + 3} \\Rightarrow y(2x + 3) = 4x - 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "2xy + 3y = 4x - 5 \\Rightarrow 2xy - 4x = -3y - 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan sederhanakan tanda negatif**" },
        { "tipe": "formula_block", "latex": "x(2y - 4) = -(3y + 5) \\Rightarrow x = \\dfrac{-(3y + 5)}{2y - 4} = \\dfrac{3y + 5}{4 - 2y}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{3x + 5}{4 - 2x}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{3x + 5}{4 - 2x}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2$ dan $g(x) = x + 1$, maka $(f \\circ g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai fungsi terdalam $f(2)$**" },
        { "tipe": "formula_block", "latex": "f(2) = 2^2 = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai fungsi tengah $g(f(2)) = g(4)$**" },
        { "tipe": "formula_block", "latex": "g(4) = 4 + 1 = 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai fungsi terluar $f(g(f(2))) = f(5)$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g \\circ f)(2) = f(5) = 5^2 = 25" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(f \\circ g \\circ f)(2)$ adalah **$25$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 1$ dan $g(x) = x^2$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai fungsi bagian dalam $f(2)$**" },
        { "tipe": "formula_block", "latex": "f(2) = 2 + 1 = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan hasil $f(2)$ ke dalam fungsi $g(x)$**" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(2) = g(f(2)) = g(3) = 3^2 = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(g \\circ f)(2)$ adalah **$9$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
