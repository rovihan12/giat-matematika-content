{
  "id": "bs-k11-kfi-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang komposisi & invers fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4x - 3}{2x + 5}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{4 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 3}{4 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{5 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{2x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x - 3}{5 + 2x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = f(x)$ dan kalikan dengan penyebut $(2x + 5)$**" },
        { "tipe": "formula_block", "latex": "y = \\dfrac{4x - 3}{2x + 5} \\Rightarrow y(2x + 5) = 4x - 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kelompokkan suku yang memuat $x$ di satu ruas**" },
        { "tipe": "formula_block", "latex": "2xy + 5y = 4x - 3 \\Rightarrow 2xy - 4x = -5y - 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan $x$ dan sederhanakan tanda negatif**" },
        { "tipe": "formula_block", "latex": "x(2y - 4) = -(5y + 3) \\Rightarrow x = \\dfrac{-(5y + 3)}{2y - 4} = \\dfrac{5y + 3}{4 - 2y}" },
        { "tipe": "paragraph", "text": "**Langkah 4: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = \\dfrac{5x + 3}{4 - 2x}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$\\dfrac{5x + 3}{4 - 2x}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2x + 3$ dengan domain $x \\geq 1$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$1 - \\sqrt{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 + \\sqrt{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 - \\sqrt{x - 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk fungsi kuadrat menjadi kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 - 2x + 3 = (x - 1)^2 - 1 + 3 = (x - 1)^2 + 2" },
        { "tipe": "formula_block", "latex": "(x - 1)^2 = y - 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ambil akar kuadrat dengan memperhatikan domain $x \\geq 1$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 1$, maka $x - 1 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x - 1 = \\sqrt{y - 2} \\Rightarrow x = 1 + \\sqrt{y - 2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk mendapatkan $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = 1 + \\sqrt{x - 2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$1 + \\sqrt{x - 2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$, $g(x) = x - 1$, dan $h(x) = x^2$, nilai $(h \\circ g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Evaluasi fungsi terdalam $f(1)$**" },
        { "tipe": "formula_block", "latex": "f(1) = 2(1) + 3 = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Evaluasi fungsi tengah $g(f(1)) = g(5)$**" },
        { "tipe": "formula_block", "latex": "g(5) = 5 - 1 = 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Evaluasi fungsi terluar $h(g(f(1))) = h(4)$**" },
        { "tipe": "formula_block", "latex": "(h \\circ g \\circ f)(1) = h(4) = 4^2 = 16" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(h \\circ g \\circ f)(1)$ adalah **$16$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f^{-1}(x) = \\dfrac{x + 2}{x - 3}$, nilai $f^{-1}(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan langsung $x = 4$ ke rumus $f^{-1}(x)$ yang sudah diketahui**" },
        { "tipe": "formula_block", "latex": "f^{-1}(4) = \\dfrac{4 + 2}{4 - 3} = \\dfrac{6}{1} = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(4)$ adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 4}{2x - 3}$, nilai $f^{-1}(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(1) = x \\iff f(x) = 1$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{x + 4}{2x - 3} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan untuk $x$**" },
        { "tipe": "formula_block", "latex": "x + 4 = 1(2x - 3) \\Rightarrow x + 4 = 2x - 3" },
        { "tipe": "formula_block", "latex": "4 + 3 = 2x - x \\Rightarrow x = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(1)$ adalah **$7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4x + 1$ dengan domain $x \\geq -2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk fungsi kuadrat menjadi kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "y = x^2 + 4x + 1 = (x + 2)^2 - 4 + 1 = (x + 2)^2 - 3" },
        { "tipe": "formula_block", "latex": "(x + 2)^2 = y + 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ambil akar kuadrat dengan memperhatikan domain $x \\geq -2$**" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -2$, maka $x + 2 \\geq 0$, sehingga diambil akar kuadrat positif:" },
        { "tipe": "formula_block", "latex": "x + 2 = \\sqrt{y + 3} \\Rightarrow x = -2 + \\sqrt{y + 3}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $y$ menjadi $x$ untuk memperoleh $f^{-1}(x)$**" },
        { "tipe": "formula_block", "latex": "f^{-1}(x) = -2 + \\sqrt{x + 3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, $f^{-1}(x)$ adalah **$-2 + \\sqrt{x + 3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x}{x - 3}$ dan $g(x) = x + 1$, nilai $(f \\circ g)^{-1}(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rumus fungsi komposisi $(f \\circ g)(x)$**" },
        { "tipe": "formula_block", "latex": "(f \\circ g)(x) = f(g(x)) = f(x + 1) = \\dfrac{2(x + 1)}{(x + 1) - 3} = \\dfrac{2x + 2}{x - 2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan sifat invers $(f \\circ g)^{-1}(4) = x \\iff (f \\circ g)(x) = 4$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2x + 2}{x - 2} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kalikan silang dan selesaikan persamaan untuk $x$**" },
        { "tipe": "formula_block", "latex": "2x + 2 = 4(x - 2) \\Rightarrow 2x + 2 = 4x - 8" },
        { "tipe": "formula_block", "latex": "2 + 8 = 4x - 2x \\Rightarrow 2x = 10 \\Rightarrow x = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(f \\circ g)^{-1}(4)$ adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $(g \\circ f)(x) = 4x + 3$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $u = f(x) = 2x + 1$, lalu nyatakan $x$ dalam $u$**" },
        { "tipe": "formula_block", "latex": "u = 2x + 1 \\Rightarrow 2x = u - 1 \\Rightarrow x = \\dfrac{u - 1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = \\dfrac{u - 1}{2}$ ke dalam $(g \\circ f)(x) = g(u)$**" },
        { "tipe": "formula_block", "latex": "g(u) = 4\\left(\\dfrac{u - 1}{2}\\right) + 3 = 2(u - 1) + 3 = 2u - 2 + 3 = 2u + 1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ganti variabel $u$ menjadi $x$ untuk mendapatkan $g(x)$**" },
        { "tipe": "formula_block", "latex": "g(x) = 2x + 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus fungsi $g(x)$ adalah **$2x + 1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x - 2}{x + 1}$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat invers $f^{-1}(2) = x \\iff f(x) = 2$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{3x - 2}{x + 1} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan silang dan selesaikan persamaan untuk $x$**" },
        { "tipe": "formula_block", "latex": "3x - 2 = 2(x + 1) \\Rightarrow 3x - 2 = 2x + 2" },
        { "tipe": "formula_block", "latex": "3x - 2x = 2 + 2 \\Rightarrow x = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f^{-1}(2)$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 1$ dan $g(x) = 3x$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai fungsi bagian dalam $f(2)$**" },
        { "tipe": "formula_block", "latex": "f(2) = 2 + 1 = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan hasil $f(2)$ ke dalam fungsi $g(x)$**" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(2) = g(f(2)) = g(3) = 3(3) = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(g \\circ f)(2)$ adalah **$9$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
