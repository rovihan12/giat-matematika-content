{
  "id": "bs-k11-kfi-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang komposisi & invers fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4x - 3}{2x + 5}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{4 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 3}{4 + 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 3}{5 - 2x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 3}{2x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x - 3}{5 + 2x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{4x - 3}{2x + 5} \\Rightarrow 2xy + 5y = 4x - 3$" },
        { "tipe": "paragraph", "text": "$2xy - 4x = -5y - 3 \\Rightarrow x(2y - 4) = -5y - 3$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{5y + 3}{4 - 2y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{5x + 3}{4 - 2x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2x + 3$ dengan domain $x \\geq 1$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$1 - \\sqrt{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 + \\sqrt{x - 2}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 - \\sqrt{x - 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 1)^2 + 2 \\Rightarrow y - 2 = (x - 1)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 1$: $x - 1 = \\sqrt{y - 2}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 1 + \\sqrt{x - 2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 3$, $g(x) = x - 1$, dan $h(x) = x^2$, nilai $(h \\circ g \\circ f)(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(1) = 5$" },
        { "tipe": "paragraph", "text": "$g(f(1)) = g(5) = 4$" },
        { "tipe": "paragraph", "text": "$h(g(f(1))) = h(4) = 16$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f^{-1}(x) = \\dfrac{x + 2}{x - 3}$, nilai $f^{-1}(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(4) = \\dfrac{4 + 2}{4 - 3} = \\dfrac{6}{1} = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{x + 4}{2x - 3}$, nilai $f^{-1}(1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(1)$: nilai $x$ saat $f(x) = 1$." },
        { "tipe": "paragraph", "text": "$\\dfrac{x + 4}{2x - 3} = 1 \\Rightarrow x + 4 = 2x - 3 \\Rightarrow x = 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4x + 1$ dengan domain $x \\geq -2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x + 2)^2 - 3 \\Rightarrow y + 3 = (x + 2)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -2$: $x + 2 = \\sqrt{y + 3}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = -2 + \\sqrt{x + 3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x}{x - 3}$ dan $g(x) = x + 1$, nilai $(f \\circ g)^{-1}(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(x) = f(x + 1) = \\dfrac{2(x + 1)}{x + 1 - 3} = \\dfrac{2x + 2}{x - 2}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{2x + 2}{x - 2} = 4 \\Rightarrow 2x + 2 = 4x - 8$" },
        { "tipe": "paragraph", "text": "$2x = 10 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x + 1$ dan $(g \\circ f)(x) = 4x + 3$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x - 1$" } ],
        [ { "tipe": "paragraph", "text": "$2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$4x + 1$" } ],
        [ { "tipe": "paragraph", "text": "$4x - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2x + 1) = 4x + 3$. Misal $u = 2x + 1 \\Rightarrow x = \\dfrac{u - 1}{2}$." },
        { "tipe": "paragraph", "text": "$g(u) = 4 \\cdot \\dfrac{u - 1}{2} + 3 = 2(u - 1) + 3 = 2u + 1$" },
        { "tipe": "paragraph", "text": "$g(x) = 2x + 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{3x - 2}{x + 1}$, nilai $f^{-1}(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f^{-1}(2)$: nilai $x$ saat $f(x) = 2$." },
        { "tipe": "paragraph", "text": "$\\dfrac{3x - 2}{x + 1} = 2 \\Rightarrow 3x - 2 = 2x + 2 \\Rightarrow x = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x + 1$ dan $g(x) = 3x$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 3$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(3) = 9$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
