{
  "id": "bs-k11-kfi-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7",
  "kelas": 11,
  "kategori": "Komposisi Fungsi dan Fungsi Invers",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang invers fungsi rasional, komposisi bertingkat, dan domain fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k11-kfi-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 4x - 5$ dengan domain $x \\geq -2$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 - \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{x + 9}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 + \\sqrt{x - 9}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{x + 9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x + 2)^2 - 9 \\Rightarrow y + 9 = (x + 2)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -2$: $x + 2 = \\sqrt{y + 9}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = -2 + \\sqrt{x + 9}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{7x + 4}{3x - 5}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 4}{3x - 7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x - 4}{3x + 7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7x - 4}{3x + 5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4x + 5}{7x - 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5x + 4}{7 - 3x}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{7x + 4}{3x - 5} \\Rightarrow y(3x - 5) = 7x + 4$" },
        { "tipe": "paragraph", "text": "$3xy - 5y = 7x + 4 \\Rightarrow 3xy - 7x = 5y + 4$" },
        { "tipe": "paragraph", "text": "$x(3y - 7) = 5y + 4 \\Rightarrow x = \\dfrac{5y + 4}{3y - 7}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{5x + 4}{3x - 7}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x - 1$, $g(x) = 2x + 5$, dan $h(x) = x^2$, nilai $(f \\circ g \\circ h)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$h(2) = 4$" },
        { "tipe": "paragraph", "text": "$g(4) = 13$" },
        { "tipe": "paragraph", "text": "$f(13) = 3(13) - 1 = 38$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x - 3$ dan $(g \\circ f)(x) = 4x^2 - 16x + 18$, maka $g(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 2x - 3$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 2x + 3$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$g(2x - 3) = 4x^2 - 16x + 18$. Misal $u = 2x - 3 \\Rightarrow x = \\dfrac{u + 3}{2}$." },
        { "tipe": "paragraph", "text": "$g(u) = 4 \\cdot \\dfrac{(u + 3)^2}{4} - 16 \\cdot \\dfrac{u + 3}{2} + 18$" },
        { "tipe": "paragraph", "text": "$= (u^2 + 6u + 9) - 8(u + 3) + 18$" },
        { "tipe": "paragraph", "text": "$= u^2 - 2u + 3$" },
        { "tipe": "paragraph", "text": "$g(x) = x^2 - 2x + 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{4x + 1}{2x - 3}$, nilai $f^{-1}(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{4x + 1}{2x - 3} = 3 \\Rightarrow 4x + 1 = 6x - 9$" },
        { "tipe": "paragraph", "text": "$2x = 10 \\Rightarrow x = 10$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 2x - 3$ dengan domain $x \\geq 1$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 - \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 + \\sqrt{x + 4}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{x - 4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1 - \\sqrt{x + 4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = (x - 1)^2 - 4 \\Rightarrow y + 4 = (x - 1)^2$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq 1$: $x - 1 = \\sqrt{y + 4}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = 1 + \\sqrt{x + 4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{2x + 5}{x - 1}$ dan $g(x) = x^2$, nilai $(g \\circ f)(2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$81$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$121$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = \\dfrac{4 + 5}{1} = 9$" },
        { "tipe": "paragraph", "text": "$g(f(2)) = g(9) = 81$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x + 2$ dan $g(x) = x - 1$, nilai $a$ jika $(f \\circ g)(a) = 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(f \\circ g)(a) = 3(a - 1) + 2 = 8$" },
        { "tipe": "paragraph", "text": "$3a - 1 = 8 \\Rightarrow 3a = 9 \\Rightarrow a = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\dfrac{6x - 2}{3x + 1}$, maka $f^{-1}(x)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{6 - 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 2}{6 + 3x}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6x + 2}{3x - 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x + 2}{3x - 6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x - 2}{3x + 6}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$y = \\dfrac{6x - 2}{3x + 1} \\Rightarrow y(3x + 1) = 6x - 2$" },
        { "tipe": "paragraph", "text": "$3xy + y = 6x - 2 \\Rightarrow 3xy - 6x = -y - 2$" },
        { "tipe": "paragraph", "text": "$x(3y - 6) = -y - 2 \\Rightarrow x = \\dfrac{y + 2}{6 - 3y}$" },
        { "tipe": "paragraph", "text": "$f^{-1}(x) = \\dfrac{x + 2}{6 - 3x}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k11-kfi-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 6x + 5$ dengan domain $x \\geq -3$, nilai $f^{-1}(0)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 3)^2 - 4 = 0 \\Rightarrow (x + 3)^2 = 4$" },
        { "tipe": "paragraph", "text": "Karena $x \\geq -3$: $x + 3 = 2 \\Rightarrow x = -1$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
