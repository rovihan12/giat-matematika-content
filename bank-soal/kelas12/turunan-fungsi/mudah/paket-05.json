        [{"tipe":"paragraph","text":"$192x$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 16x^3 \\Rightarrow f''(x) = 48x^2" },
