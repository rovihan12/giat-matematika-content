    {
      "id": "bs-k12-turunan-mudah-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^3 - x$, maka nilai $x$ yang memenuhi $f'(x) = 2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x = 0$"}],
        [{"tipe":"paragraph","text":"$x = 1$"}],
        [{"tipe":"paragraph","text":"$x = 2$"}],
        [{"tipe":"paragraph","text":"$x = 3$"}],
        [{"tipe":"paragraph","text":"$x = -1$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 1 = 2 \\Rightarrow 3x^2 = 3 \\Rightarrow x^2 = 1" },
        { "tipe": "paragraph", "text": "Maka $x = \\pm 1$. Dari opsi, nilai yang sesuai adalah $x = 1$." }
      ],
      "tingkat": "MUDAH"
    },
