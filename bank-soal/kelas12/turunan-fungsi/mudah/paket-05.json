        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 4x^3 - 6x + 2 \\Rightarrow f'(1) = 4 - 6 + 2 = 0" },
        { "tipe": "paragraph", "text": "Jadi, $f'(1) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
