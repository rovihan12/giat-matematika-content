      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = 8x^3 - 2x^2 + 5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$24x^2 - 4x$"}],
        [{"tipe":"paragraph","text":"$24x^2 - 4x + 5$"}],
        [{"tipe":"paragraph","text":"$24x^2 + 4x$"}],
        [{"tipe":"paragraph","text":"$8x^2 - 4x$"}],
        [{"tipe":"paragraph","text":"$24x^3 - 4x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 24x^2 - 4x" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 24x^2 - 4x$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^4 - 3x^2 + 2x$, maka $f'(1)$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
