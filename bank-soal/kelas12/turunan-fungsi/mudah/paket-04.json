    {
      "id": "bs-k12-turunan-mudah-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^3$, maka nilai $x$ yang memenuhi $f'(x) = 12$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x = 1$"}],
        [{"tipe":"paragraph","text":"$x = 2$"}],
        [{"tipe":"paragraph","text":"$x = 3$"}],
        [{"tipe":"paragraph","text":"$x = 4$"}],
        [{"tipe":"paragraph","text":"$x = 6$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 = 12 \\Rightarrow x^2 = 4 \\Rightarrow x = \\pm 2" },
        { "tipe": "paragraph", "text": "Dari opsi, nilai yang sesuai adalah $x = 2$." }
      ],
      "tingkat": "MUDAH"
    },
