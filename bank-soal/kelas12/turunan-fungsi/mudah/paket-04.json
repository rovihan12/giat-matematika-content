      "id": "bs-k12-turunan-mudah-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan kedua dari $f(x) = x^3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^2$"}],
        [{"tipe":"paragraph","text":"$6x$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$3x$"}],
        [{"tipe":"paragraph","text":"$6x^2$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 \\Rightarrow f''(x) = 6x" },
        { "tipe": "paragraph", "text": "Jadi, turunan keduanya adalah $6x$." }
      ],
      "tingkat": "MUDAH"
    },
