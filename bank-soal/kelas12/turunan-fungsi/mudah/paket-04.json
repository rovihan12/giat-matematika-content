      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $y = 2x^3 + 5x^2 - 3x$, maka $\\dfrac{dy}{dx}$ di $x = -1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-7$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$13$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 6x^2 + 10x - 3" },
        { "tipe": "formula_block", "latex": "y'(-1) = 6 - 10 - 3 = -7" },
        { "tipe": "paragraph", "text": "Jadi, nilai $\\dfrac{dy}{dx}$ di $x = -1$ adalah $-7$." }
