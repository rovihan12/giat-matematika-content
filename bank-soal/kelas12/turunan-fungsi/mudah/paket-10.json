{
  "id": "bs-k12-turunan-mudah-10",
  "nama": "Bank Soal Mudah - Paket 10",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Turunan fungsi aljabar dan nilai stasioner dasar",
  "versi": "1.4.0",
  "soal": [
    {
      "id": "bs-k12-turunan-mudah-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = 3x^2 - 6x + 5$ naik dalam interval ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x < 1$"}],
        [{"tipe":"paragraph","text":"$x > 1$"}],
        [{"tipe":"paragraph","text":"$x > 2$"}],
        [{"tipe":"paragraph","text":"$x < 2$"}],
        [{"tipe":"paragraph","text":"$x > -1$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 6x - 6 > 0 \\Rightarrow 6x > 6 \\Rightarrow x > 1" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik stasioner dari fungsi $f(x) = x^2 + 4x - 3$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Titik minimum $(-2, -7)$"}],
        [{"tipe":"paragraph","text":"Titik maksimum $(-2, -7)$"}],
        [{"tipe":"paragraph","text":"Titik minimum $(-3, -7)$"}],
        [{"tipe":"paragraph","text":"Titik maksimum $(-3, -7)$"}],
        [{"tipe":"paragraph","text":"Titik maksimum $(-1, 7)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 2x + 4 = 0 \\Rightarrow x = -2" },
        { "tipe": "formula_block", "latex": "f(-2) = 4 - 8 - 3 = -7" },
        { "tipe": "paragraph", "text": "Karena $a > 0$ (parabola terbuka ke atas), maka titik $(-2, -7)$ adalah titik minimum." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum dari $f(x) = x^2 - 6x + 5$ dalam interval $0 \\le x \\le 5$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 2x - 6 = 0 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "Cek titik ujung dan stasioner:" },
        { "tipe": "paragraph", "text": "$f(0) = 5$, $f(3) = 9 - 18 + 5 = -4$, $f(5) = 25 - 30 + 5 = 0$." },
        { "tipe": "paragraph", "text": "Nilai maksimum adalah $5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^3 - 3x^2 - 9x + 5$ turun pada interval ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1 < x < 3$"}],
        [{"tipe":"paragraph","text":"$x < -1$ atau $x > 3$"}],
        [{"tipe":"paragraph","text":"$-3 < x < 1$"}],
        [{"tipe":"paragraph","text":"$x < -3$ atau $x > 1$"}],
        [{"tipe":"paragraph","text":"$0 < x < 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 3x^2 - 6x - 9 < 0" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 3 < 0 \\Rightarrow (x - 3)(x + 1) < 0" },
        { "tipe": "paragraph", "text": "Diperoleh interval $-1 < x < 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 + 2x^2 + 2x - 5$ grafiknya ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Turun dalam interval $-2 < x < 3$"}],
        [{"tipe":"paragraph","text":"Naik dalam interval $-2 < x < 3$"}],
        [{"tipe":"paragraph","text":"Selalu naik"}],
        [{"tipe":"paragraph","text":"Selalu turun"}],
        [{"tipe":"paragraph","text":"Naik dalam interval $x < 2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 4x + 2" },
        { "tipe": "paragraph", "text": "Diskriminan $D = 16 - 24 = -8 < 0$. Karena $a = 3 > 0$ dan $D < 0$, maka $f'(x) > 0$ untuk semua $x$." },
        { "tipe": "paragraph", "text": "Jadi grafik selalu naik." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan pertama dari $y = \\frac{3}{x + \\sqrt{2}}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\frac{3}{(x + \\sqrt{2})^2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{(x + \\sqrt{2})^2}$"}],
        [{"tipe":"paragraph","text":"$-\\frac{3}{2(x + \\sqrt{2})^2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2(x + \\sqrt{2})^2}$"}],
        [{"tipe":"paragraph","text":"$-\\frac{3}{(x + \\sqrt{2})}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan rantai dengan $u = x + \\sqrt{2}$, $y = 3u^{-1}$." },
        { "tipe": "formula_block", "latex": "y' = -3u^{-2} \\cdot 1 = -\\frac{3}{(x + \\sqrt{2})^2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 - 6x^2 + 9x + 2$ turun pada interval ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1 < x < 3$"}],
        [{"tipe":"paragraph","text":"$x < 1$ atau $x > 3$"}],
        [{"tipe":"paragraph","text":"$-1 < x < 3$"}],
        [{"tipe":"paragraph","text":"$x < -3$ atau $x > 1$"}],
        [{"tipe":"paragraph","text":"$0 < x < 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 12x + 9 < 0" },
        { "tipe": "formula_block", "latex": "x^2 - 4x + 3 < 0 \\Rightarrow (x - 3)(x - 1) < 0" },
        { "tipe": "paragraph", "text": "Interval turun adalah $1 < x < 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan pertama dari $f(x) = x^3 - 6x^2 + 9x + 7$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^2 - 12x + 9$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 12x - 9$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 6x + 9$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 12x + 9$"}],
        [{"tipe":"paragraph","text":"$x^2 - 12x + 9$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 12x + 9" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai stasioner untuk fungsi $f(x) = 2x^3 - 3x^2 - 12x + 1$ adalah pada $x = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$ dan $2$"}],
        [{"tipe":"paragraph","text":"$1$ dan $-2$"}],
        [{"tipe":"paragraph","text":"$-1$ dan $-2$"}],
        [{"tipe":"paragraph","text":"$1$ dan $2$"}],
        [{"tipe":"paragraph","text":"$0$ dan $3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 6x^2 - 6x - 12 = 0" },
        { "tipe": "formula_block", "latex": "x^2 - x - 2 = 0 \\Rightarrow (x - 2)(x + 1) = 0" },
        { "tipe": "paragraph", "text": "Maka $x = 2$ atau $x = -1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $f(x) = x^3 + 3x^2 - 9x$ dalam interval $-3 \\le x \\le 2$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$25$"}],
        [{"tipe":"paragraph","text":"$27$"}],
        [{"tipe":"paragraph","text":"$29$"}],
        [{"tipe":"paragraph","text":"$31$"}],
        [{"tipe":"paragraph","text":"$33$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 6x - 9 = 0 \\Rightarrow x^2 + 2x - 3 = 0 \\Rightarrow (x+3)(x-1) = 0" },
        { "tipe": "paragraph", "text": "Stasioner di $x = -3$ dan $x = 1$." },
        { "tipe": "paragraph", "text": "$f(-3) = -27 + 27 + 27 = 27$." },
        { "tipe": "paragraph", "text": "$f(1) = 1 + 3 - 9 = -5$." },
        { "tipe": "paragraph", "text": "$f(2) = 8 + 12 - 18 = 2$." },
        { "tipe": "paragraph", "text": "Nilai maksimum adalah $27$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
