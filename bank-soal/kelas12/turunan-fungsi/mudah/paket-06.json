          [{"tipe":"paragraph","text":"$4x + 1$"}]
        ],
        "jawaban_benar": 4,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Jabarkan dulu: $f(x) = 2x^2 + 2x - x - 1 = 2x^2 + x - 1$." },
