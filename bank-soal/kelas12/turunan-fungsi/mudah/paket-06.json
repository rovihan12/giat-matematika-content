      {
        "id": "bs-k12-turunan-mudah-06-q01",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan pertama dari $f(x) = 3x^2 + 5x - 6$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$f'(x) = 6x + 5$"}],
          [{"tipe":"paragraph","text":"$f'(x) = 6x^2 + 5$"}],
          [{"tipe":"paragraph","text":"$f'(x) = 6x^2 + 5x$"}],
          [{"tipe":"paragraph","text":"$f'(x) = 6x - 1$"}],
          [{"tipe":"paragraph","text":"$f'(x) = 6x^2 - 1$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 3(2)x^{2-1} + 5(1)x^{1-1} - 0 = 6x + 5" },
          { "tipe": "paragraph", "text": "Jadi, $f'(x) = 6x + 5$." }
        ],
        "tingkat": "MUDAH"
      },
      {
        "id": "bs-k12-turunan-mudah-06-q02",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan pertama dari $f(x) = 8 + 2x^2 - x^4$ adalah ...." }
