          [{"tipe":"paragraph","text":"$x^4 + x^2 - x$"}],
          [{"tipe":"paragraph","text":"$5x^4 + 3x^2 - 2x$"}]
        ],
        "jawaban_benar": 4,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "y' = (2x)(x^3 - 1) + (x^2 + 1)(3x^2) = 2x^4 - 2x + 3x^4 + 3x^2 = 5x^4 + 3x^2 - 2x" }
        ],
        "tingkat": "MUDAH"
      },
      {
        "id": "bs-k12-turunan-mudah-07-q04",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan $f(x) = (2x - 1)(x + 1)$ adalah ...." }
