    "soal": [
      {
        "id": "bs-k12-turunan-mudah-07-q01",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan fungsi $f(x) = (5x-3)(2x^2+1)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$10x^2 - x - 3$"}],
          [{"tipe":"paragraph","text":"$20x - 1$"}],
          [{"tipe":"paragraph","text":"$30x^2 - 12x + 5$"}],
          [{"tipe":"paragraph","text":"$30x - 12$"}],
          [{"tipe":"paragraph","text":"$5(2x^2+1) + 2x(5x-3)$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Gunakan aturan perkalian: $u = 5x-3$, $v = 2x^2+1$." },
          { "tipe": "formula_block", "latex": "f'(x) = u'v + uv' = 5(2x^2+1) + (5x-3)(4x)" },
          { "tipe": "formula_block", "latex": "= 10x^2 + 5 + 20x^2 - 12x = 30x^2 - 12x + 5" }
        ],
        "tingkat": "MUDAH"
      },
      {
        "id": "bs-k12-turunan-mudah-07-q02",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan fungsi $f(x) = \\sqrt{2x^5 - 6x + 1}$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$10x^4 - 6$"}],
          [{"tipe":"paragraph","text":"$(10x^4 - 6)\\sqrt{2x^5 - 6x + 1}$"}],
          [{"tipe":"paragraph","text":"$\\frac{10x^4 - 6}{2\\sqrt{2x^5 - 6x + 1}}$"}],
          [{"tipe":"paragraph","text":"$\\frac{5x^4 - 6}{\\sqrt{2x^5 - 6x + 1}}$"}],
          [{"tipe":"paragraph","text":"$\\frac{1}{10x^4 - 6}\\sqrt{2x^5 - 6x + 1}$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f(x) = (2x^5 - 6x + 1)^{1/2}" },
          { "tipe": "formula_block", "latex": "f'(x) = \\frac{1}{2}(2x^5 - 6x + 1)^{-1/2} \\cdot (10x^4 - 6) = \\frac{10x^4 - 6}{2\\sqrt{2x^5 - 6x + 1}}" }
        ],
        "tingkat": "MUDAH"
      },
      {
        "id": "bs-k12-turunan-mudah-07-q03",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $y = (x^2 + 1)(x^3 - 1)$, maka $y'$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$5x^3$"}],
          [{"tipe":"paragraph","text":"$3x^2 + 3x$"}],
