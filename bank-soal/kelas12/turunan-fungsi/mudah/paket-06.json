        ],
        "tingkat": "MUDAH"
      },
      {
        "id": "bs-k12-turunan-mudah-07-q05",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan dari $y = (x - 1)(x^2 + x + 1)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$3x$"}],
          [{"tipe":"paragraph","text":"$3x^2$"}],
          [{"tipe":"paragraph","text":"$2x^3$"}],
          [{"tipe":"paragraph","text":"$3x^2 + 1$"}],
