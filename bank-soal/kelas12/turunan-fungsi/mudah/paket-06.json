        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 0 + 2(2)x - 4x^3 = 4x - 4x^3" },
          { "tipe": "paragraph", "text": "Ditulis ulang menjadi $-4x^3 + 4x$." }
        ],
        "tingkat": "MUDAH"
