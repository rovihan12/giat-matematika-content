      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $y = 3x^2$, maka $\\dfrac{dy}{dx}$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x$"}],
        [{"tipe":"paragraph","text":"$6x$"}],
        [{"tipe":"paragraph","text":"$6x^2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$x$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{dy}{dx} = 3 \\cdot 2x = 6x" },
        { "tipe": "paragraph", "text": "Jadi, $\\dfrac{dy}{dx} = 6x$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $y = x^2 + 2x + 1$, maka $y'$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x + 2$"}],
        [{"tipe":"paragraph","text":"$2x + 1$"}],
        [{"tipe":"paragraph","text":"$x + 2$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 2x$"}],
        [{"tipe":"paragraph","text":"$2x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 2x + 2" },
        { "tipe": "paragraph", "text": "Jadi, $y' = 2x + 2$." }
      ],
      "tingkat": "MUDAH"
    },
