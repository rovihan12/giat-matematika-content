  "soal": [
    {
      "id": "bs-k12-turunan-mudah-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = x^5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5x^4$"}],
        [{"tipe":"paragraph","text":"$5x^5$"}],
        [{"tipe":"paragraph","text":"$x^4$"}],
        [{"tipe":"paragraph","text":"$4x^5$"}],
        [{"tipe":"paragraph","text":"$5x^6$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan pangkat: $f(x) = x^n \\Rightarrow f'(x) = n x^{n-1}$." },
        { "tipe": "formula_block", "latex": "f'(x) = 5x^{5-1} = 5x^4" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 5x^4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = x^3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2$"}],
        [{"tipe":"paragraph","text":"$2x^2$"}],
        [{"tipe":"paragraph","text":"$3x^2$"}],
        [{"tipe":"paragraph","text":"$3x^3$"}],
        [{"tipe":"paragraph","text":"$3x$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^{3-1} = 3x^2" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 3x^2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = 7$ (konstanta) adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$7x$"}],
        [{"tipe":"paragraph","text":"$x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Turunan konstanta selalu 0." },
        { "tipe": "formula_block", "latex": "f'(x) = 0" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = 5x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$5x$"}],
        [{"tipe":"paragraph","text":"$x$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(x) = 5x = 5x^1$." },
        { "tipe": "formula_block", "latex": "f'(x) = 5 \\cdot 1 \\cdot x^{0} = 5" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = x^4 + 3x^2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4x^3 + 3x$"}],
        [{"tipe":"paragraph","text":"$4x^3 + 6x$"}],
        [{"tipe":"paragraph","text":"$x^3 + 6x$"}],
        [{"tipe":"paragraph","text":"$4x^3 + 6x^2$"}],
        [{"tipe":"paragraph","text":"$4x^4 + 6x$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 4x^3 + 3 \\cdot 2x^1 = 4x^3 + 6x" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 4x^3 + 6x$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = 2x^3 - 5x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6x^2 - 5$"}],
        [{"tipe":"paragraph","text":"$6x^2 + 5$"}],
        [{"tipe":"paragraph","text":"$6x^2 - 5x$"}],
        [{"tipe":"paragraph","text":"$2x^2 - 5$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 5$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 2 \\cdot 3x^2 - 5 \\cdot 1 = 6x^2 - 5" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 6x^2 - 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = x^6 - 2x^4 + x^2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6x^5 - 8x^3 + 2x$"}],
        [{"tipe":"paragraph","text":"$6x^5 - 8x^3 + x$"}],
        [{"tipe":"paragraph","text":"$6x^5 - 2x^3 + 2x$"}],
        [{"tipe":"paragraph","text":"$x^5 - 8x^3 + 2x$"}],
        [{"tipe":"paragraph","text":"$6x^5 - 8x^3 + 2x^2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 6x^5 - 2 \\cdot 4x^3 + 2x^1 = 6x^5 - 8x^3 + 2x" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 6x^5 - 8x^3 + 2x$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^3$, maka nilai $f'(2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$16$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 \\Rightarrow f'(2) = 3(2)^2 = 3 \\cdot 4 = 12" },
        { "tipe": "paragraph", "text": "Jadi, $f'(2) = 12$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^4 - 2x^2 + 3$, maka nilai $f'(1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 4x^3 - 4x \\Rightarrow f'(1) = 4 - 4 = 0" },
        { "tipe": "paragraph", "text": "Jadi, $f'(1) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-turunan-mudah-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan kedua dari $f(x) = x^4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4x^3$"}],
        [{"tipe":"paragraph","text":"$12x^2$"}],
        [{"tipe":"paragraph","text":"$24x$"}],
        [{"tipe":"paragraph","text":"$24$"}],
        [{"tipe":"paragraph","text":"$12x$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Turunan pertama: $f'(x) = 4x^3$." },
        { "tipe": "formula_block", "latex": "f''(x) = 12x^2" },
        { "tipe": "paragraph", "text": "Jadi, turunan keduanya adalah $12x^2$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
