{
  "id": "bs-k12-turunan-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Optimasi (soal cerita)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah dua bilangan adalah 20. Hasil kali maksimum kedua bilangan tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$75$"}],
        [{"tipe":"paragraph","text":"$80$"}],
        [{"tipe":"paragraph","text":"$96$"}],
        [{"tipe":"paragraph","text":"$100$"}],
        [{"tipe":"paragraph","text":"$120$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan bilangan: $x$ dan $20 - x$." },
        { "tipe": "formula_block", "latex": "P(x) = x(20 - x) = 20x - x^2" },
        { "tipe": "formula_block", "latex": "P'(x) = 20 - 2x = 0 \\Rightarrow x = 10" },
        { "tipe": "formula_block", "latex": "P(10) = 10 \\cdot 10 = 100" },
        { "tipe": "paragraph", "text": "Jadi, hasil kali maksimumnya adalah 100." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Keliling persegi panjang adalah 40 cm. Luas maksimumnya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$80$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$96$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$100$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$120$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$144$ cm$^2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan panjang $p$ dan lebar $l$: $2p + 2l = 40 \\Rightarrow p + l = 20$." },
        { "tipe": "formula_block", "latex": "L = p \\cdot l = p(20 - p) = 20p - p^2" },
        { "tipe": "formula_block", "latex": "L' = 20 - 2p = 0 \\Rightarrow p = 10 \\Rightarrow l = 10" },
        { "tipe": "formula_block", "latex": "L = 10 \\cdot 10 = 100 \\text{ cm}^2" },
        { "tipe": "paragraph", "text": "Jadi, luas maksimumnya adalah 100 cm²." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak tanpa tutup dibuat dari karton berbentuk persegi dengan sisi 12 cm. Jika sudut-sudutnya dipotong persegi dengan sisi $x$, volume maksimum kotak adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$128$ cm$^3$"}],
        [{"tipe":"paragraph","text":"$144$ cm$^3$"}],
        [{"tipe":"paragraph","text":"$216$ cm$^3$"}],
        [{"tipe":"paragraph","text":"$256$ cm$^3$"}],
        [{"tipe":"paragraph","text":"$288$ cm$^3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "V(x) = x(12 - 2x)^2 = x(144 - 48x + 4x^2) = 4x^3 - 48x^2 + 144x" },
        { "tipe": "formula_block", "latex": "V'(x) = 12x^2 - 96x + 144 = 12(x^2 - 8x + 12) = 12(x-2)(x-6)" },
        { "tipe": "paragraph", "text": "Karena $0 < x < 6$, maka $x = 2$." },
        { "tipe": "formula_block", "latex": "V(2) = 2(12 - 4)^2 = 2 \\cdot 64 = 128 \\text{ cm}^3" },
        { "tipe": "paragraph", "text": "Jadi, volume maksimumnya adalah 128 cm³." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah taman berbentuk persegi panjang dengan keliling 60 m. Agar luasnya maksimum, panjang taman tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$10$ m"}],
        [{"tipe":"paragraph","text":"$12$ m"}],
        [{"tipe":"paragraph","text":"$15$ m"}],
        [{"tipe":"paragraph","text":"$20$ m"}],
        [{"tipe":"paragraph","text":"$30$ m"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2(p + l) = 60 \\Rightarrow p + l = 30" },
        { "tipe": "formula_block", "latex": "L = p(30 - p) = 30p - p^2" },
        { "tipe": "formula_block", "latex": "L' = 30 - 2p = 0 \\Rightarrow p = 15" },
        { "tipe": "paragraph", "text": "Jadi, panjang taman = 15 m." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua bilangan memiliki jumlah 24. Nilai minimum dari jumlah kuadrat kedua bilangan tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$288$"}],
        [{"tipe":"paragraph","text":"$320$"}],
        [{"tipe":"paragraph","text":"$360$"}],
        [{"tipe":"paragraph","text":"$400$"}],
        [{"tipe":"paragraph","text":"$432$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bilangan: $x$ dan $24 - x$." },
        { "tipe": "formula_block", "latex": "S(x) = x^2 + (24-x)^2 = x^2 + 576 - 48x + x^2 = 2x^2 - 48x + 576" },
        { "tipe": "formula_block", "latex": "S'(x) = 4x - 48 = 0 \\Rightarrow x = 12" },
        { "tipe": "formula_block", "latex": "S(12) = 144 + 144 = 288" },
        { "tipe": "paragraph", "text": "Jadi, nilai minimumnya adalah 288." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kawat sepanjang 24 cm dibentuk menjadi persegi panjang. Luas maksimumnya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$24$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$30$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$36$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$48$ cm$^2$"}],
        [{"tipe":"paragraph","text":"$64$ cm$^2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2(p+l) = 24 \\Rightarrow p + l = 12" },
        { "tipe": "formula_block", "latex": "L = p(12-p) = 12p - p^2" },
        { "tipe": "formula_block", "latex": "L' = 12 - 2p = 0 \\Rightarrow p = 6 \\Rightarrow l = 6" },
        { "tipe": "formula_block", "latex": "L = 36 \\text{ cm}^2" },
        { "tipe": "paragraph", "text": "Jadi, luas maksimumnya adalah 36 cm²." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil kali maksimum dua bilangan positif dengan jumlah 10 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$16$"}],
        [{"tipe":"paragraph","text":"$20$"}],
        [{"tipe":"paragraph","text":"$25$"}],
        [{"tipe":"paragraph","text":"$30$"}],
        [{"tipe":"paragraph","text":"$36$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(x) = x(10 - x) = 10x - x^2" },
        { "tipe": "formula_block", "latex": "P'(x) = 10 - 2x = 0 \\Rightarrow x = 5" },
        { "tipe": "formula_block", "latex": "P(5) = 5 \\cdot 5 = 25" },
        { "tipe": "paragraph", "text": "Jadi, hasil kali maksimumnya adalah 25." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah tabung tanpa tutup memiliki volume $27\\pi$ cm³. Agar luas permukaan minimum, jari-jari tabung tersebut adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$ cm"}],
        [{"tipe":"paragraph","text":"$2$ cm"}],
        [{"tipe":"paragraph","text":"$3$ cm"}],
        [{"tipe":"paragraph","text":"$4$ cm"}],
        [{"tipe":"paragraph","text":"$6$ cm"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "V = \\pi r^2 t = 27\\pi \\Rightarrow t = \\dfrac{27}{r^2}" },
        { "tipe": "formula_block", "latex": "L = \\pi r^2 + 2\\pi r t = \\pi r^2 + 2\\pi r \\cdot \\dfrac{27}{r^2} = \\pi r^2 + \\dfrac{54\\pi}{r}" },
        { "tipe": "formula_block", "latex": "L'(r) = 2\\pi r - \\dfrac{54\\pi}{r^2} = 0 \\Rightarrow 2r^3 = 54 \\Rightarrow r^3 = 27 \\Rightarrow r = 3" },
        { "tipe": "paragraph", "text": "Jadi, jari-jarinya adalah 3 cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah persegi panjang memiliki luas 64 cm². Keliling minimumnya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$16$ cm"}],
        [{"tipe":"paragraph","text":"$24$ cm"}],
        [{"tipe":"paragraph","text":"$32$ cm"}],
        [{"tipe":"paragraph","text":"$40$ cm"}],
        [{"tipe":"paragraph","text":"$48$ cm"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "p \\cdot l = 64 \\Rightarrow l = \\dfrac{64}{p}" },
        { "tipe": "formula_block", "latex": "K(p) = 2(p + l) = 2\\left(p + \\dfrac{64}{p}\\right)" },
        { "tipe": "formula_block", "latex": "K'(p) = 2\\left(1 - \\dfrac{64}{p^2}\\right) = 0 \\Rightarrow p^2 = 64 \\Rightarrow p = 8" },
        { "tipe": "formula_block", "latex": "l = 8 \\Rightarrow K = 2(8+8) = 32 \\text{ cm}" },
        { "tipe": "paragraph", "text": "Jadi, keliling minimumnya adalah 32 cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah persegi panjang memiliki luas 36 cm². Keliling minimumnya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$12$ cm"}],
        [{"tipe":"paragraph","text":"$18$ cm"}],
        [{"tipe":"paragraph","text":"$24$ cm"}],
        [{"tipe":"paragraph","text":"$36$ cm"}],
        [{"tipe":"paragraph","text":"$48$ cm"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "p \\cdot l = 36 \\Rightarrow l = \\dfrac{36}{p}" },
        { "tipe": "formula_block", "latex": "K(p) = 2(p + l) = 2\\left(p + \\dfrac{36}{p}\\right)" },
        { "tipe": "formula_block", "latex": "K'(p) = 2\\left(1 - \\dfrac{36}{p^2}\\right) = 0 \\Rightarrow p^2 = 36 \\Rightarrow p = 6" },
        { "tipe": "formula_block", "latex": "l = 6 \\Rightarrow K = 2(6+6) = 24 \\text{ cm}" },
        { "tipe": "paragraph", "text": "Jadi, keliling minimumnya adalah 24 cm." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
