{
  "id": "bs-k12-turunan-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Persamaan garis singgung & gradien",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Gradien garis singgung kurva $y = x^2 - 4x + 3$ di titik $x = 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gradien = $y'$ di titik $x$." },
        { "tipe": "formula_block", "latex": "y' = 2x - 4 \\Rightarrow y'(1) = 2 - 4 = -2" },
        { "tipe": "paragraph", "text": "Jadi, gradiennya adalah $-2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Gradien garis singgung kurva $y = x^3 - 3x$ di titik $x = 2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$15$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 3x^2 - 3 \\Rightarrow y'(2) = 3(4) - 3 = 12 - 3 = 9" },
        { "tipe": "paragraph", "text": "Jadi, gradiennya adalah 9." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = x^2 + 2x$ di titik $(1, 3)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = 4x - 1$"}],
        [{"tipe":"paragraph","text":"$y = 4x + 1$"}],
        [{"tipe":"paragraph","text":"$y = 2x + 1$"}],
        [{"tipe":"paragraph","text":"$y = 4x - 3$"}],
        [{"tipe":"paragraph","text":"$y = 2x - 1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 2x + 2 \\Rightarrow m = y'(1) = 4" },
        { "tipe": "paragraph", "text": "Persamaan garis melalui $(1, 3)$ dengan gradien 4:" },
        { "tipe": "formula_block", "latex": "y - 3 = 4(x - 1) \\Rightarrow y = 4x - 1" },
        { "tipe": "paragraph", "text": "Jadi, persamaannya adalah $y = 4x - 1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = x^3 - 2x$ di titik $(2, 4)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = 10x - 16$"}],
        [{"tipe":"paragraph","text":"$y = 10x + 16$"}],
        [{"tipe":"paragraph","text":"$y = 8x - 12$"}],
        [{"tipe":"paragraph","text":"$y = 10x - 20$"}],
        [{"tipe":"paragraph","text":"$y = 12x - 20$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 3x^2 - 2 \\Rightarrow m = y'(2) = 12 - 2 = 10" },
        { "tipe": "formula_block", "latex": "y - 4 = 10(x - 2) \\Rightarrow y = 10x - 16" },
        { "tipe": "paragraph", "text": "Jadi, persamaannya adalah $y = 10x - 16$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Garis singgung kurva $y = x^2 - 3x + 2$ yang sejajar dengan garis $y = x$ memiliki gradien ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis $y = x$ memiliki gradien 1. Garis singgung sejajar → gradiennya juga 1." },
        { "tipe": "formula_block", "latex": "m = y' = 2x - 3 = 1 \\Rightarrow x = 2" },
        { "tipe": "paragraph", "text": "Jadi, gradiennya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik pada kurva $y = x^2 - 4x + 5$ yang memiliki garis singgung dengan gradien 0 adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(2, 1)$"}],
        [{"tipe":"paragraph","text":"$(1, 2)$"}],
        [{"tipe":"paragraph","text":"$(3, 2)$"}],
        [{"tipe":"paragraph","text":"$(0, 5)$"}],
        [{"tipe":"paragraph","text":"$(4, 5)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 2x - 4 = 0 \\Rightarrow x = 2" },
        { "tipe": "formula_block", "latex": "y(2) = 4 - 8 + 5 = 1" },
        { "tipe": "paragraph", "text": "Jadi, titiknya $(2, 1)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Gradien garis singgung kurva $y = x^3 - 6x^2 + 9x - 2$ di titik stasionernya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di titik stasioner, gradien = $y' = 0$." },
        { "tipe": "paragraph", "text": "Jadi, gradiennya adalah 0." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = x^3$ di titik $(1, 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = 3x - 2$"}],
        [{"tipe":"paragraph","text":"$y = 3x + 2$"}],
        [{"tipe":"paragraph","text":"$y = 3x - 3$"}],
        [{"tipe":"paragraph","text":"$y = x - 1$"}],
        [{"tipe":"paragraph","text":"$y = 3x + 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 3x^2 \\Rightarrow m = y'(1) = 3" },
        { "tipe": "formula_block", "latex": "y - 1 = 3(x - 1) \\Rightarrow y = 3x - 2" },
        { "tipe": "paragraph", "text": "Jadi, persamaannya adalah $y = 3x - 2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Garis singgung kurva $y = x^3 - 3x^2 + 4$ di titik $(1, 2)$ memiliki gradien ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 3x^2 - 6x \\Rightarrow m = y'(1) = 3 - 6 = -3" },
        { "tipe": "paragraph", "text": "Jadi, gradiennya adalah $-3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = x^2 - 2x + 3$ di titik dengan absis $x = 3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = 4x - 6$"}],
        [{"tipe":"paragraph","text":"$y = 4x + 6$"}],
        [{"tipe":"paragraph","text":"$y = 2x - 6$"}],
        [{"tipe":"paragraph","text":"$y = 4x - 3$"}],
        [{"tipe":"paragraph","text":"$y = 3x - 6$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y(3) = 9 - 6 + 3 = 6 \\Rightarrow \\text{titik } (3, 6)" },
        { "tipe": "formula_block", "latex": "y' = 2x - 2 \\Rightarrow m = y'(3) = 4" },
        { "tipe": "formula_block", "latex": "y - 6 = 4(x - 3) \\Rightarrow y = 4x - 6" },
        { "tipe": "paragraph", "text": "Jadi, persamaannya adalah $y = 4x - 6$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
