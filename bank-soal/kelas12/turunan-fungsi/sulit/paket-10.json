    },
    {
      "id": "bs-k12-turunan-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x^3 - 3x^2 + 4x$. Nilai $f''(1) = \\ldots$" }
