{
  "id": "bs-k12-turunan-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Nilai ekstrem & titik stasioner",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 4x + 5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 2x - 4 = 0 \\Rightarrow x = 2" },
        { "tipe": "formula_block", "latex": "f(2) = 4 - 8 + 5 = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai minimumnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum dari $f(x) = -x^2 + 6x - 5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = -2x + 6 = 0 \\Rightarrow x = 3" },
        { "tipe": "formula_block", "latex": "f(3) = -9 + 18 - 5 = 4" },
        { "tipe": "paragraph", "text": "Jadi, nilai maksimumnya adalah 4." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik stasioner dari $f(x) = x^3 - 3x^2 - 9x + 5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x = -1$ dan $x = 3$"}],
        [{"tipe":"paragraph","text":"$x = 1$ dan $x = -3$"}],
        [{"tipe":"paragraph","text":"$x = 1$ dan $x = 3$"}],
        [{"tipe":"paragraph","text":"$x = -1$ dan $x = -3$"}],
        [{"tipe":"paragraph","text":"$x = 0$ dan $x = 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x - 9 = 0 \\Rightarrow x^2 - 2x - 3 = 0" },
        { "tipe": "formula_block", "latex": "(x-3)(x+1) = 0 \\Rightarrow x = 3 \\text{ atau } x = -1" },
        { "tipe": "paragraph", "text": "Jadi, titik stasionernya $x = -1$ dan $x = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^3 - 3x^2 + 4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x = 3x(x-2) = 0 \\Rightarrow x = 0 \\text{ atau } x = 2" },
        { "tipe": "paragraph", "text": "Uji $f''(x) = 6x - 6$:" },
        { "tipe": "formula_block", "latex": "f''(0) = -6 < 0 \\Rightarrow x = 0 \\text{ maksimum lokal}" },
        { "tipe": "formula_block", "latex": "f''(2) = 6 > 0 \\Rightarrow x = 2 \\text{ minimum lokal}" },
        { "tipe": "formula_block", "latex": "f(2) = 8 - 12 + 4 = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai minimumnya adalah 0." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum lokal dari $f(x) = x^3 - 3x^2 + 4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari soal sebelumnya, titik stasioner di $x = 0$ dan $x = 2$." },
        { "tipe": "formula_block", "latex": "f(0) = 0 - 0 + 4 = 4" },
        { "tipe": "paragraph", "text": "Karena $f''(0) = -6 < 0$, maka $f(0) = 4$ adalah maksimum lokal." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = 2x^3 - 9x^2 + 12x$ naik pada interval ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x < 1$ atau $x > 2$"}],
        [{"tipe":"paragraph","text":"$1 < x < 2$"}],
        [{"tipe":"paragraph","text":"$x < -1$ atau $x > 2$"}],
        [{"tipe":"paragraph","text":"$-1 < x < 2$"}],
        [{"tipe":"paragraph","text":"$x > 0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 6x^2 - 18x + 12 = 6(x^2 - 3x + 2) = 6(x-1)(x-2)" },
        { "tipe": "paragraph", "text": "Fungsi naik saat $f'(x) > 0$:" },
        { "tipe": "formula_block", "latex": "(x-1)(x-2) > 0 \\Rightarrow x < 1 \\text{ atau } x > 2" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 - 3x^2 + 4$ turun pada interval ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0 < x < 2$"}],
        [{"tipe":"paragraph","text":"$x < 0$ atau $x > 2$"}],
        [{"tipe":"paragraph","text":"$-2 < x < 0$"}],
        [{"tipe":"paragraph","text":"$x < -2$ atau $x > 0$"}],
        [{"tipe":"paragraph","text":"$x > 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x = 3x(x-2)" },
        { "tipe": "paragraph", "text": "Fungsi turun saat $f'(x) < 0$:" },
        { "tipe": "formula_block", "latex": "3x(x-2) < 0 \\Rightarrow 0 < x < 2" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum dari $f(x) = -x^3 + 3x^2 + 9x - 1$ pada interval $[-1, 3]$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$14$"}],
        [{"tipe":"paragraph","text":"$18$"}],
        [{"tipe":"paragraph","text":"$26$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = -3x^2 + 6x + 9 = -3(x^2 - 2x - 3) = -3(x-3)(x+1)" },
        { "tipe": "paragraph", "text": "Titik stasioner: $x = 3$ dan $x = -1$ (keduanya di ujung interval)." },
        { "tipe": "formula_block", "latex": "f(-1) = 1 + 3 - 9 - 1 = -6" },
        { "tipe": "formula_block", "latex": "f(3) = -27 + 27 + 27 - 1 = 26" },
        { "tipe": "paragraph", "text": "Jadi, nilai maksimumnya adalah 26." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^3 - 12x + 5$, nilai minimum lokalnya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-11$"}],
        [{"tipe":"paragraph","text":"$-5$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$21$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 12 = 3(x^2 - 4) = 3(x-2)(x+2)" },
        { "tipe": "paragraph", "text": "Titik stasioner: $x = 2$ dan $x = -2$." },
        { "tipe": "formula_block", "latex": "f''(x) = 6x \\Rightarrow f''(2) = 12 > 0 \\Rightarrow x = 2 \\text{ minimum}" },
        { "tipe": "formula_block", "latex": "f(2) = 8 - 24 + 5 = -11" },
        { "tipe": "paragraph", "text": "Jadi, nilai minimum lokalnya adalah $-11$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = 2x^3 - 6x^2 + 4$ memiliki ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"maksimum lokal di $x = 0$ dan minimum lokal di $x = 2$"}],
        [{"tipe":"paragraph","text":"minimum lokal di $x = 0$ dan maksimum lokal di $x = 2$"}],
        [{"tipe":"paragraph","text":"dua maksimum lokal"}],
        [{"tipe":"paragraph","text":"dua minimum lokal"}],
        [{"tipe":"paragraph","text":"tidak ada titik stasioner"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 6x^2 - 12x = 6x(x-2) \\Rightarrow x = 0, x = 2" },
        { "tipe": "formula_block", "latex": "f''(x) = 12x - 12" },
        { "tipe": "formula_block", "latex": "f''(0) = -12 < 0 \\Rightarrow \\text{maksimum lokal di } x = 0" },
        { "tipe": "formula_block", "latex": "f''(2) = 12 > 0 \\Rightarrow \\text{minimum lokal di } x = 2" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
