    {
      "id": "bs-k12-turunan-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $f(x) = x^3 + 3x^2 - 9x$ dalam interval $-3 \\le x \\le 2$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$25$"}],
        [{"tipe":"paragraph","text":"$27$"}],
        [{"tipe":"paragraph","text":"$29$"}],
        [{"tipe":"paragraph","text":"$31$"}],
        [{"tipe":"paragraph","text":"$33$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 6x - 9 = 0 \\Rightarrow x^2 + 2x - 3 = 0 \\Rightarrow (x+3)(x-1) = 0" },
        { "tipe": "paragraph", "text": "Stasioner di $x=-3$ dan $x=1$." },
        { "tipe": "paragraph", "text": "$f(-3) = -27 + 27 + 27 = 27$." },
        { "tipe": "paragraph", "text": "$f(1) = 1 + 3 - 9 = -5$." },
        { "tipe": "paragraph", "text": "$f(2) = 8 + 12 - 18 = 2$." },
        { "tipe": "paragraph", "text": "Nilai maksimum $= 27$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = 4x^3 - 18x^2 + 15x - 20$ mencapai maksimum untuk nilai $x = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{5}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\frac{5}{2}$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 12x^2 - 36x + 15 = 0" },
        { "tipe": "formula_block", "latex": "4x^2 - 12x + 5 = 0 \\Rightarrow (2x - 1)(2x - 5) = 0" },
        { "tipe": "paragraph", "text": "$x = 1/2$ atau $x = 5/2$." },
        { "tipe": "formula_block", "latex": "f''(x) = 24x - 36" },
        { "tipe": "paragraph", "text": "$f''(1/2) = 12 - 36 = -24 < 0$ (maksimum)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^3 + 6x^2 - 15x$. Fungsi $f(x)$ turun pada interval ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1 < x < 5$"}],
        [{"tipe":"paragraph","text":"$-5 \\le x \\le 1$"}],
        [{"tipe":"paragraph","text":"$-5 < x < 1$"}],
        [{"tipe":"paragraph","text":"$x < -5$ atau $x > 1$"}],
        [{"tipe":"paragraph","text":"$x \\le -5$ atau $x \\ge 3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 12x - 15 < 0" },
        { "tipe": "formula_block", "latex": "x^2 + 4x - 5 < 0 \\Rightarrow (x+5)(x-1) < 0" },
        { "tipe": "paragraph", "text": "Interval turun adalah $-5 < x < 1$." }
      ],
      "tingkat": "SULIT"
    },
    {
