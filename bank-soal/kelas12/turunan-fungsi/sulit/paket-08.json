{
  "id": "bs-k12-turunan-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Optimasi geometri dan analisis fungsi lanjutan",
  "versi": "1.1.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bak air tanpa tutup berbentuk tabung. Jumlah luas selimut dan alas bak air adalah $28\\pi$ m². Volume akan maksimum jika jari-jari alasnya sama dengan ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sqrt{\\frac{7}{3}}$ m"}],
        [{"tipe":"paragraph","text":"$\\sqrt{\\frac{14}{3}}$ m"}],
        [{"tipe":"paragraph","text":"$\\sqrt{\\frac{21}{3}}$ m"}],
        [{"tipe":"paragraph","text":"$\\sqrt{\\frac{28}{3}}$ m"}],
        [{"tipe":"paragraph","text":"$\\sqrt{\\frac{35}{3}}$ m"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Luas selimut + alas $= 2\\pi r t + \\pi r^2 = 28\\pi$." },
        { "tipe": "formula_block", "latex": "2rt + r^2 = 28 \\Rightarrow t = \\frac{28 - r^2}{2r}" },
        { "tipe": "paragraph", "text": "Volume $V = \\pi r^2 t = \\pi r^2 \\cdot \\frac{28 - r^2}{2r} = \\frac{\\pi}{2}(28r - r^3)$." },
        { "tipe": "formula_block", "latex": "V' = \\frac{\\pi}{2}(28 - 3r^2) = 0 \\Rightarrow r^2 = \\frac{28}{3} \\Rightarrow r = \\sqrt{\\frac{28}{3}}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah home industry memproduksi $x$ unit barang dengan biaya $(x^2 - 30x + 125)$ ribu rupiah, dan pendapatan $(60x)$ ribu rupiah. Keuntungan maksimal adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Rp 1.900.000,00"}],
        [{"tipe":"paragraph","text":"Rp 1.150.000,00"}],
        [{"tipe":"paragraph","text":"Rp 550.000,00"}],
        [{"tipe":"paragraph","text":"Rp 300.000,00"}],
        [{"tipe":"paragraph","text":"Rp 100.000,00"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Keuntungan $L = 60x - (x^2 - 30x + 125) = -x^2 + 90x - 125$." },
        { "tipe": "formula_block", "latex": "L' = -2x + 90 = 0 \\Rightarrow x = 45" },
        { "tipe": "formula_block", "latex": "L(45) = -(45)^2 + 90(45) - 125 = 1900" },
        { "tipe": "paragraph", "text": "Keuntungan maksimal Rp 1.900.000,00." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu perusahaan menghasilkan $x$ produk dengan biaya $(9000 + 1000x + 10x^2)$ rupiah. Jika setiap produk dijual Rp5.000,00, laba maksimum adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Rp149.000,00"}],
        [{"tipe":"paragraph","text":"Rp249.000,00"}],
        [{"tipe":"paragraph","text":"Rp391.000,00"}],
        [{"tipe":"paragraph","text":"Rp609.000,00"}],
        [{"tipe":"paragraph","text":"Rp757.000,00"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Laba $L = 5000x - (9000 + 1000x + 10x^2) = -10x^2 + 4000x - 9000$." },
        { "tipe": "formula_block", "latex": "L' = -20x + 4000 = 0 \\Rightarrow x = 200" },
        { "tipe": "formula_block", "latex": "L(200) = -10(40000) + 4000(200) - 9000 = 391000" },
        { "tipe": "paragraph", "text": "Laba maksimum Rp391.000,00." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak tanpa tutup yang alasnya berbentuk persegi, mempunyai volume 4 m³. Agar karton yang diperlukan sedikit mungkin, ukuran panjang, lebar, tinggi berturut-turut adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$ m, $1$ m, $2$ m"}],
        [{"tipe":"paragraph","text":"$2$ m, $2$ m, $1$ m"}],
        [{"tipe":"paragraph","text":"$1$ m, $2$ m, $2$ m"}],
        [{"tipe":"paragraph","text":"$4$ m, $1$ m, $1$ m"}],
        [{"tipe":"paragraph","text":"$1$ m, $1$ m, $4$ m"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal sisi alas $s$, tinggi $t$. $V = s^2 t = 4 \\Rightarrow t = 4/s^2$." },
        { "tipe": "paragraph", "text": "Luas karton $L = s^2 + 4st = s^2 + 16/s$." },
        { "tipe": "formula_block", "latex": "L' = 2s - 16/s^2 = 0 \\Rightarrow s^3 = 8 \\Rightarrow s = 2" },
        { "tipe": "paragraph", "text": "$t = 4/4 = 1$. Ukuran: $2$ m, $2$ m, $1$ m." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Selembar karton berbentuk persegi panjang dengan lebar 5 dm dan panjang 8 dm akan dibuat kotak tanpa tutup. Pada keempat pojok karton dipotong persegi yang sisinya $x$ dm. Ukuran kotak agar volume maksimum adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$10$ dm, $7$ dm, $1$ dm"}],
        [{"tipe":"paragraph","text":"$8$ dm, $5$ dm, $1$ dm"}],
        [{"tipe":"paragraph","text":"$7$ dm, $4$ dm, $2$ dm"}],
        [{"tipe":"paragraph","text":"$7$ dm, $4$ dm, $1$ dm"}],
        [{"tipe":"paragraph","text":"$6$ dm, $3$ dm, $1$ dm"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ukuran: panjang $8-2x$, lebar $5-2x$, tinggi $x$." },
        { "tipe": "paragraph", "text": "$V = (8-2x)(5-2x)x = 40x - 26x^2 + 4x^3$." },
        { "tipe": "formula_block", "latex": "V' = 40 - 52x + 12x^2 = 0 \\Rightarrow 3x^2 - 13x + 10 = 0" },
        { "tipe": "formula_block", "latex": "(3x - 10)(x - 1) = 0 \\Rightarrow x = 1$ (valid)" },
        { "tipe": "paragraph", "text": "Untuk $x=1$: panjang $6$, lebar $3$, tinggi $1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari kawat yang panjangnya 500 meter akan dibuat kerangka balok yang salah satu rusuknya 25 meter. Jika volume balok maksimum, maka panjang rusuk balok lainnya adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$10$ m dan $90$ m"}],
        [{"tipe":"paragraph","text":"$15$ m dan $85$ m"}],
        [{"tipe":"paragraph","text":"$25$ m dan $75$ m"}],
        [{"tipe":"paragraph","text":"$40$ m dan $60$ m"}],
        [{"tipe":"paragraph","text":"$50$ m dan $50$ m"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Panjang kawat $= 4(p + l + t) = 500 \\Rightarrow p + l + t = 125$." },
        { "tipe": "paragraph", "text": "Misal $t = 25$, maka $p + l = 100$." },
        { "tipe": "paragraph", "text": "$V = p \\cdot l \\cdot 25 = 25p(100 - p)$." },
        { "tipe": "paragraph", "text": "Maksimum saat $p = 50$, $l = 50$." },
        { "tipe": "paragraph", "text": "Jadi dua rusuk lainnya $50$ m dan $50$ m." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kerucut memiliki panjang jari-jari $r$ dan tinggi $t$. Jika $r + t = 12$, maka volume maksimal kerucut adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$72\\pi$"}],
        [{"tipe":"paragraph","text":"$\\frac{215}{3}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\frac{225}{3}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\frac{256}{3}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\frac{343}{3}\\pi$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$t = 12 - r$. $V = \\frac{1}{3}\\pi r^2(12 - r) = \\frac{\\pi}{3}(12r^2 - r^3)$." },
        { "tipe": "formula_block", "latex": "V' = \\frac{\\pi}{3}(24r - 3r^2) = 0 \\Rightarrow r = 8" },
        { "tipe": "paragraph", "text": "$t = 4$." },
        { "tipe": "formula_block", "latex": "V = \\frac{1}{3}\\pi(64)(4) = \\frac{256}{3}\\pi" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = x^2 - 4x + 3$ yang tegak lurus garis $x - 2y + 5 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x + y - 2 = 0$"}],
        [{"tipe":"paragraph","text":"$2x - y + 2 = 0$"}],
        [{"tipe":"paragraph","text":"$x + 2y - 2 = 0$"}],
        [{"tipe":"paragraph","text":"$x - 2y + 2 = 0$"}],
        [{"tipe":"paragraph","text":"$2x + y + 2 = 0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis $x - 2y + 5 = 0 \\Rightarrow m_1 = 1/2$. Tegak lurus $m_2 = -2$." },
        { "tipe": "formula_block", "latex": "y' = 2x - 4 = -2 \\Rightarrow x = 1" },
        { "tipe": "formula_block", "latex": "y = 1 - 4 + 3 = 0" },
        { "tipe": "formula_block", "latex": "y - 0 = -2(x - 1) \\Rightarrow 2x + y - 2 = 0" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = \\frac{1}{3}x^3 + ax^2 - 2x + 1$. Fungsi $f(x)$ mempunyai nilai stasioner pada $x = -2$ untuk nilai $a = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = x^2 + 2ax - 2" },
        { "tipe": "formula_block", "latex": "f'(-2) = 4 - 4a - 2 = 2 - 4a = 0 \\Rightarrow a = \\frac{1}{2}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-turunan-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $f(x) = x^3 + 3x^2 - 9x$ dalam interval $-3 \\le x \\le 2$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$25$"}],
        [{"tipe":"paragraph","text":"$27$"}],
        [{"tipe":"paragraph","text":"$29$"}],
        [{"tipe":"paragraph","text":"$31$"}],
        [{"tipe":"paragraph","text":"$33$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 6x - 9 = 0 \\Rightarrow x^2 + 2x - 3 = 0 \\Rightarrow (x+3)(x-1) = 0" },
        { "tipe": "paragraph", "text": "Stasioner di $x=-3$ dan $x=1$." },
        { "tipe": "paragraph", "text": "$f(-3) = -27 + 27 + 27 = 27$." },
        { "tipe": "paragraph", "text": "$f(1) = 1 + 3 - 9 = -5$." },
        { "tipe": "paragraph", "text": "$f(2) = 8 + 12 - 18 = 2$." },
        { "tipe": "paragraph", "text": "Nilai maksimum $= 27$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
