  "kategori": "Turunan Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Turunan lanjutan dan analisis fungsi",
  "versi": "1.2.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sedang-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui fungsi biaya total $C = \\frac{1}{3}Q^3 - \\frac{7}{2}Q^2 + 12Q - 5$. Berapa unit produksi $Q$ agar biaya total mencapai minimum lokal?" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$ unit"}],
        [{"tipe":"paragraph","text":"$2$ unit"}],
        [{"tipe":"paragraph","text":"$3$ unit"}],
        [{"tipe":"paragraph","text":"$4$ unit"}],
        [{"tipe":"paragraph","text":"$5$ unit"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Biaya marginal $MC = C' = Q^2 - 7Q + 12 = 0$." },
        { "tipe": "formula_block", "latex": "(Q - 3)(Q - 4) = 0 \\Rightarrow Q = 3 \\text{ atau } Q = 4" },
        { "tipe": "paragraph", "text": "Uji turunan kedua: $C'' = 2Q - 7$." },
        { "tipe": "paragraph", "text": "Untuk $Q = 3 \\Rightarrow C''(3) = -1 < 0$ (maksimum lokal)." },
        { "tipe": "paragraph", "text": "Untuk $Q = 4 \\Rightarrow C''(4) = 1 > 0$ (minimum lokal)." },
        { "tipe": "paragraph", "text": "Jadi, biaya total mencapai minimum lokal saat produksi $4$ unit." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^3 + 3x^2 - 9x + 2$. Nilai $f'(1) = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 6x - 9" },
        { "tipe": "formula_block", "latex": "f'(1) = 3 + 6 - 9 = 0" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^3 - 6x^2 + 9x + 1$. Nilai $f'(3) = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 12x + 9" },
        { "tipe": "formula_block", "latex": "f'(3) = 27 - 36 + 9 = 0" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^5$. Nilai $f''(1) = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$20$"}],
        [{"tipe":"paragraph","text":"$60$"}],
        [{"tipe":"paragraph","text":"$120$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 5x^4 \\Rightarrow f''(x) = 20x^3" },
        { "tipe": "formula_block", "latex": "f''(1) = 20" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = \\frac{3x + 2}{2x - 3}$. Nilai $f'(1) = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-13$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$13$"}],
        [{"tipe":"paragraph","text":"$26$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = \\frac{-13}{(2x-3)^2}" },
        { "tipe": "formula_block", "latex": "f'(1) = \\frac{-13}{(2-3)^2} = \\frac{-13}{1} = -13" }
      ],
      "tingkat": "SEDANG"
    },
    {
