        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-08-q06",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Fungsi $f(x) = (x-1)(x^2 + 7x - 29)$ naik pada interval ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-6 < x < 2$"}],
          [{"tipe":"paragraph","text":"$-2 < x < 6$"}],
          [{"tipe":"paragraph","text":"$x < 2$ atau $x > 6$"}],
          [{"tipe":"paragraph","text":"$x < -6$ atau $x > 2$"}],
          [{"tipe":"paragraph","text":"$x < -2$ atau $x > 6$"}]
        ],
        "jawaban_benar": 4,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Jabarkan: $f(x) = x^3 + 6x^2 - 36x + 29$." },
          { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 12x - 36 > 0" },
          { "tipe": "formula_block", "latex": "x^2 + 4x - 12 > 0 \\Rightarrow (x + 6)(x - 2) > 0" },
          { "tipe": "paragraph", "text": "Interval naik adalah $x < -6$ atau $x > 2$." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-08-q07",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x^3 - 3x^2 - 12x + 1$ dalam interval $-2 \\le x \\le 3$, mencapai maksimum pada titik $x = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-2$"}],
          [{"tipe":"paragraph","text":"$-1$"}],
          [{"tipe":"paragraph","text":"$1$"}],
          [{"tipe":"paragraph","text":"$2$"}],
          [{"tipe":"paragraph","text":"$3$"}]
        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 6x^2 - 6x - 12 = 0 \\Rightarrow x^2 - x - 2 = 0 \\Rightarrow (x-2)(x+1) = 0" },
          { "tipe": "paragraph", "text": "Stasioner di $x=-1$ dan $x=2$." },
          { "tipe": "paragraph", "text": "Cek nilai ujung interval dan stasioner:" },
          { "tipe": "paragraph", "text": "$f(-2) = -16 - 12 + 24 + 1 = -3$." },
          { "tipe": "paragraph", "text": "$f(-1) = -2 - 3 + 12 + 1 = 8$." },
          { "tipe": "paragraph", "text": "$f(2) = 16 - 12 - 24 + 1 = -19$." },
          { "tipe": "paragraph", "text": "$f(3) = 54 - 27 - 36 + 1 = -8$." },
          { "tipe": "paragraph", "text": "Nilai maksimum tercapai pada $x = -1$ (dengan nilai $8$)." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-08-q08",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Nilai stasioner untuk fungsi $f(x) = -x^3 + 6x^2 - 12x + 5$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-3$"}],
          [{"tipe":"paragraph","text":"$2$"}],
          [{"tipe":"paragraph","text":"$3$"}],
          [{"tipe":"paragraph","text":"$4$"}],
          [{"tipe":"paragraph","text":"$5$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = -3x^2 + 12x - 12 = -3(x^2 - 4x + 4) = -3(x-2)^2" },
          { "tipe": "paragraph", "text": "$f'(x) = 0 \\Rightarrow x = 2$." },
          { "tipe": "formula_block", "latex": "f(2) = -(2)^3 + 6(2)^2 - 12(2) + 5 = -8 + 24 - 24 + 5 = -3" },
          { "tipe": "paragraph", "text": "Nilai stasionernya adalah $-3$." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-08-q09",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Grafik $y = x^4 - 4x$ turun untuk $x$ yang memenuhi ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$x < 0$"}],
          [{"tipe":"paragraph","text":"$0 < x < 1$"}],
          [{"tipe":"paragraph","text":"$x > 1$"}],
          [{"tipe":"paragraph","text":"$x < 1$"}],
          [{"tipe":"paragraph","text":"$x > 0$"}]
        ],
        "jawaban_benar": 3,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "y' = 4x^3 - 4 = 4(x^3 - 1)" },
          { "tipe": "paragraph", "text": "Turun saat $y' < 0 \\Rightarrow x^3 - 1 < 0 \\Rightarrow x < 1$." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-08-q10",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 + 2x^2 + 2x - 5$ grafiknya ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"Turun dalam interval $-2 < x < 3$"}],
          [{"tipe":"paragraph","text":"Naik dalam interval $-2 < x < 3$"}],
          [{"tipe":"paragraph","text":"Selalu naik"}],
          [{"tipe":"paragraph","text":"Selalu turun"}],
          [{"tipe":"paragraph","text":"Naik dalam interval $x < 2$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 4x + 2" },
          { "tipe": "paragraph", "text": "Diskriminan $D = 16 - 24 = -8 < 0$. Karena $a = 3 > 0$ dan $D < 0$, maka $f'(x) > 0$ untuk semua $x$." },
          { "tipe": "paragraph", "text": "Jadi grafik selalu naik." }
        ],
        "tingkat": "SEDANG"
      }
    ]
  },
  {
    "id": "bs-k12-turunan-sedang-09",
    "nama": "Bank Soal Sedang - Paket 9",
    "kelas": 12,
    "kategori": "Turunan Fungsi",
    "tingkat": "SEDANG",
    "deskripsi": "Aplikasi turunan: optimasi sederhana",
    "versi": "1.1.0",
    "soal": [
      {
        "id": "bs-k12-turunan-sedang-09-q01",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Jumlah dua buah bilangan sama dengan 150. Jika perkalian salah satu bilangan dengan kuadrat bilangan lainnya maksimum, bilangan-bilangan itu adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$25$ dan $125$"}],
          [{"tipe":"paragraph","text":"$50$ dan $100$"}],
          [{"tipe":"paragraph","text":"$75$ dan $75$"}],
          [{"tipe":"paragraph","text":"$100$ dan $50$"}],
          [{"tipe":"paragraph","text":"$125$ dan $25$"}]
        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Misal bilangan $x$ dan $150 - x$. Maksimumkan $P = x(150 - x)^2$." },
          { "tipe": "formula_block", "latex": "P' = (150 - x)^2 + x \\cdot 2(150 - x)(-1) = (150 - x)(150 - x - 2x) = (150 - x)(150 - 3x)" },
          { "tipe": "paragraph", "text": "$P' = 0 \\Rightarrow x = 150$ atau $x = 50$." },
          { "tipe": "paragraph", "text": "Jika $x=50$, bilangan lainnya $100$. Jadi bilangannya $50$ dan $100$." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-09-q02",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Dua buah bilangan bulat positif mempunyai hasil kali 100. Supaya jumlah kedua bilangan itu sekecil-kecilnya, maka selisih kedua bilangan itu adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$48$"}],
          [{"tipe":"paragraph","text":"$21$"}],
          [{"tipe":"paragraph","text":"$0$"}],
          [{"tipe":"paragraph","text":"$55$"}],
          [{"tipe":"paragraph","text":"$3$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Misal bilangan $x$ dan $100/x$. Minimumkan $S = x + 100/x$." },
          { "tipe": "formula_block", "latex": "S' = 1 - 100/x^2 = 0 \\Rightarrow x^2 = 100 \\Rightarrow x = 10" },
          { "tipe": "paragraph", "text": "Kedua bilangan adalah $10$ dan $10$. Selisihnya $0$." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-09-q03",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Untuk memproduksi $x$ potong pakaian jadi dalam 1 hari diperlukan biaya produksi $(x^2 + 8x + 15)$ ribu rupiah, sedangkan harga jual per potong $(40 - x)$ ribu rupiah. Keuntungan maksimum yang diperoleh per hari adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$110$ ribu rupiah"}],
          [{"tipe":"paragraph","text":"$113$ ribu rupiah"}],
          [{"tipe":"paragraph","text":"$111$ ribu rupiah"}],
          [{"tipe":"paragraph","text":"$115$ ribu rupiah"}],
          [{"tipe":"paragraph","text":"$120$ ribu rupiah"}]
        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Pendapatan $= x(40 - x) = 40x - x^2$." },
          { "tipe": "paragraph", "text": "Keuntungan $L = (40x - x^2) - (x^2 + 8x + 15) = -2x^2 + 32x - 15$." },
          { "tipe": "formula_block", "latex": "L' = -4x + 32 = 0 \\Rightarrow x = 8" },
          { "tipe": "formula_block", "latex": "L(8) = -2(64) + 32(8) - 15 = -128 + 256 - 15 = 113" },
          { "tipe": "paragraph", "text": "Keuntungan maksimum adalah $113$ ribu rupiah." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-09-q04",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Sebuah home industry memproduksi $x$ unit barang dengan biaya yang dinyatakan $(x^2 - 30x + 125)$ ribu rupiah, dan pendapatan setelah barang tersebut habis terjual adalah $(60x)$ ribu rupiah. Keuntungan maksimal home industry tersebut adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"Rp 1.900.000,00"}],
          [{"tipe":"paragraph","text":"Rp 1.150.000,00"}],
          [{"tipe":"paragraph","text":"Rp 550.000,00"}],
          [{"tipe":"paragraph","text":"Rp 300.000,00"}],
          [{"tipe":"paragraph","text":"Rp 100.000,00"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Keuntungan $L = 60x - (x^2 - 30x + 125) = -x^2 + 90x - 125$." },
          { "tipe": "formula_block", "latex": "L' = -2x + 90 = 0 \\Rightarrow x = 45" },
          { "tipe": "formula_block", "latex": "L(45) = -(45)^2 + 90(45) - 125 = -2025 + 4050 - 125 = 1900" },
          { "tipe": "paragraph", "text": "Keuntungan maksimal adalah Rp 1.900.000,00." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-09-q05",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Suatu perusahaan menghasilkan $x$ produk dengan biaya sebesar $(9000 + 1000x + 10x^2)$ rupiah. Jika semua hasil produk perusahaan tersebut habis dijual dengan harga Rp5.000,00 untuk satu produknya, maka laba maksimum yang dapat diperoleh perusahaan tersebut adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"Rp149.000,00"}],
          [{"tipe":"paragraph","text":"Rp249.000,00"}],
          [{"tipe":"paragraph","text":"Rp391.000,00"}],
          [{"tipe":"paragraph","text":"Rp609.000,00"}],
          [{"tipe":"paragraph","text":"Rp757.000,00"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Pendapatan $= 5000x$." },
          { "tipe": "paragraph", "text": "Laba $L = 5000x - (9000 + 1000x + 10x^2) = -10x^2 + 4000x - 9000$." },
          { "tipe": "formula_block", "latex": "L' = -20x + 4000 = 0 \\Rightarrow x = 200" },
          { "tipe": "formula_block", "latex": "L(200) = -10(40000) + 4000(200) - 9000 = -400000 + 800000 - 9000 = 391000" },
          { "tipe": "paragraph", "text": "Laba maksimum adalah Rp391.000,00." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-09-q06",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Sebuah kotak tanpa tutup yang alasnya berbentuk persegi, mempunyai volume 4 m³ terbuat dari selembar karton. Agar karton yang diperlukan sedikit mungkin, maka ukuran panjang, lebar, dan tinggi kotak berturut-turut adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$2$ m, $1$ m, $2$ m"}],
          [{"tipe":"paragraph","text":"$2$ m, $2$ m, $1$ m"}],
          [{"tipe":"paragraph","text":"$1$ m, $2$ m, $2$ m"}],
          [{"tipe":"paragraph","text":"$4$ m, $1$ m, $1$ m"}],
          [{"tipe":"paragraph","text":"$1$ m, $1$ m, $4$ m"}]
        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Misal sisi alas $s$ dan tinggi $t$. Volume $V = s^2 t = 4 \\Rightarrow t = 4/s^2$." },
          { "tipe": "paragraph", "text": "Luas karton $L = s^2 + 4st = s^2 + 4s(4/s^2) = s^2 + 16/s$." },
          { "tipe": "formula_block", "latex": "L' = 2s - 16/s^2 = 0 \\Rightarrow 2s^3 = 16 \\Rightarrow s^3 = 8 \\Rightarrow s = 2" },
          { "tipe": "paragraph", "text": "Maka $t = 4/4 = 1$. Ukuran: $2$ m, $2$ m, $1$ m." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-09-q07",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Selembar karton berbentuk persegi panjang dengan lebar 5 dm dan panjang 8 dm akan dibuat kotak tanpa tutup. Pada keempat pojok karton dipotong persegi yang sisinya $x$ dm. Ukuran kotak tersebut (panjang, lebar, tinggi) agar volume maksimum berturut-turut adalah ...." }
