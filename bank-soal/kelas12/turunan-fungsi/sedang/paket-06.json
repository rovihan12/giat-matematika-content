[
  {
    "id": "bs-k12-turunan-sedang-06",
    "nama": "Bank Soal Sedang - Paket 6",
    "kelas": 12,
    "kategori": "Turunan Fungsi",
    "tingkat": "SEDANG",
    "deskripsi": "Turunan fungsi trigonometri dan aturan rantai",
    "versi": "1.1.0",
    "soal": [
      {
        "id": "bs-k12-turunan-sedang-06-q01",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan dari $f(x) = \\cos^4(3 - 4x^2)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-32x \\cos^3(3 - 4x^2) \\sin(3 - 4x^2)$"}],
          [{"tipe":"paragraph","text":"$4x \\cos^3(3 - 4x^2) \\sin(3 - 4x^2)$"}],
          [{"tipe":"paragraph","text":"$-32x \\cos^3(3 - 4x^2) \\sin(6 - 8x^2)$"}],
          [{"tipe":"paragraph","text":"$16x \\cos^2(3 - 4x^2) \\sin(6 - 8x^2)$"}],
          [{"tipe":"paragraph","text":"$-16x \\cos^2(3 - 4x^2) \\sin(6 - 8x^2)$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Gunakan aturan rantai bertingkat: $f(x) = [\\cos(3-4x^2)]^4$." },
          { "tipe": "formula_block", "latex": "f'(x) = 4[\\cos(3-4x^2)]^3 \\cdot (-\\sin(3-4x^2)) \\cdot (-8x)" },
          { "tipe": "formula_block", "latex": "f'(x) = -32x \\cos^3(3-4x^2) \\sin(3-4x^2)" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q02",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Misalkan $f(x) = \\cos^3(4\\tan 2x)$. Maka $f'(x) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-12 \\cos^2(4\\tan 2x) \\sin(4\\tan 2x)$"}],
          [{"tipe":"paragraph","text":"$-12 \\cos^2(4\\tan 2x) \\cdot 4\\sec^2 2x$"}],
          [{"tipe":"paragraph","text":"$-24 \\cos^2(4\\tan 2x) \\sin(4\\tan 2x) \\sec^2 2x$"}],
          [{"tipe":"paragraph","text":"$-24 \\cos^2(4\\tan 2x) \\sin(4\\tan 2x) \\cdot 4\\sec^2 2x$"}],
          [{"tipe":"paragraph","text":"$24 \\cos^2(4\\tan 2x) \\sin(4\\tan 2x) \\sec^2 2x$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "paragraph", "text": "$f(x) = [\\cos(4\\tan 2x)]^3$." },
          { "tipe": "formula_block", "latex": "f'(x) = 3[\\cos(4\\tan 2x)]^2 \\cdot (-\\sin(4\\tan 2x)) \\cdot (4\\sec^2 2x \\cdot 2)" },
          { "tipe": "formula_block", "latex": "f'(x) = -24 \\cos^2(4\\tan 2x) \\sin(4\\tan 2x) \\sec^2 2x" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q03",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Misalkan $f(x) = 2\\tan(\\sqrt{\\sec x})$, maka $f'(x) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$\\sec^2(\\sqrt{\\sec x}) \\tan x$"}],
          [{"tipe":"paragraph","text":"$\\sec^2(\\sqrt{\\sec x}) \\sqrt{\\sec x} \\tan x$"}],
          [{"tipe":"paragraph","text":"$2\\sec^2(\\sqrt{\\sec x}) \\sqrt{\\sec x} \\tan x$"}],
          [{"tipe":"paragraph","text":"$\\sec^2(\\sqrt{\\sec x}) \\sec x \\tan x$"}],
          [{"tipe":"paragraph","text":"$2\\sec^2(\\sqrt{\\sec x}) \\sec x \\tan x$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "paragraph", "text": "$f(x) = 2\\tan((\\sec x)^{1/2})$." },
          { "tipe": "formula_block", "latex": "f'(x) = 2\\sec^2(\\sqrt{\\sec x}) \\cdot \\frac{1}{2}(\\sec x)^{-1/2} \\cdot \\sec x \\tan x" },
          { "tipe": "formula_block", "latex": "f'(x) = \\sec^2(\\sqrt{\\sec x}) \\cdot \\frac{\\sec x \\tan x}{\\sqrt{\\sec x}} = \\sec^2(\\sqrt{\\sec x}) \\sqrt{\\sec x} \\tan x" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q04",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = \\sin^2 x$. Jika $f'(x)$ menyatakan turunan pertama dari $f(x)$, maka $\\lim_{h \\to \\infty} h \\left( f'\\left(x + \\frac{1}{h}\\right) - f'(x) \\right) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$\\sin 2x$"}],
          [{"tipe":"paragraph","text":"$-\\cos 2x$"}],
          [{"tipe":"paragraph","text":"$2\\cos 2x$"}],
          [{"tipe":"paragraph","text":"$2\\sin x$"}],
          [{"tipe":"paragraph","text":"$-2\\cos x$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "paragraph", "text": "$f(x) = \\sin^2 x \\Rightarrow f'(x) = 2\\sin x \\cos x = \\sin 2x$." },
          { "tipe": "paragraph", "text": "Limit tersebut adalah definisi turunan dari $f'(x)$, yaitu $f''(x)$." },
          { "tipe": "formula_block", "latex": "f''(x) = \\frac{d}{dx}(\\sin 2x) = 2\\cos 2x" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q05",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Jika $f(x) = \\sin^3(2x)$, maka $f'(x) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$3\\sin^2(2x) \\cos(2x)$"}],
          [{"tipe":"paragraph","text":"$6\\sin^2(2x) \\cos(2x)$"}],
          [{"tipe":"paragraph","text":"$3\\sin^2(2x)$"}],
          [{"tipe":"paragraph","text":"$6\\sin(2x) \\cos^2(2x)$"}],
          [{"tipe":"paragraph","text":"$3\\cos^3(2x)$"}]
        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 3\\sin^2(2x) \\cdot \\cos(2x) \\cdot 2 = 6\\sin^2(2x) \\cos(2x)" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q06",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan pertama dari $y = \\cos^2(3x)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-6\\cos(3x)\\sin(3x)$"}],
          [{"tipe":"paragraph","text":"$-3\\cos(3x)\\sin(3x)$"}],
          [{"tipe":"paragraph","text":"$6\\cos(3x)\\sin(3x)$"}],
          [{"tipe":"paragraph","text":"$-2\\cos(3x)\\sin(3x)$"}],
          [{"tipe":"paragraph","text":"$-6\\sin^2(3x)$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "y' = 2\\cos(3x) \\cdot (-\\sin(3x)) \\cdot 3 = -6\\cos(3x)\\sin(3x)" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q07",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Jika $f(x) = x^2 \\sin x$, maka $f'(x) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$2x \\sin x + x^2 \\cos x$"}],
          [{"tipe":"paragraph","text":"$2x \\cos x + x^2 \\sin x$"}],
          [{"tipe":"paragraph","text":"$2x \\sin x - x^2 \\cos x$"}],
          [{"tipe":"paragraph","text":"$x^2 \\sin x + 2x \\cos x$"}],
          [{"tipe":"paragraph","text":"$2x \\cos x - x^2 \\sin x$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Gunakan aturan perkalian: $u = x^2$, $v = \\sin x$." },
          { "tipe": "formula_block", "latex": "f'(x) = u'v + uv' = 2x \\sin x + x^2 \\cos x" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q08",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan dari $f(x) = \\frac{\\sin x}{\\cos x}$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$\\sec^2 x$"}],
          [{"tipe":"paragraph","text":"$\\csc^2 x$"}],
          [{"tipe":"paragraph","text":"$\\tan^2 x$"}],
          [{"tipe":"paragraph","text":"$\\cot^2 x$"}],
          [{"tipe":"paragraph","text":"$-\\sec^2 x$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "paragraph", "text": "$f(x) = \\tan x$, maka $f'(x) = \\sec^2 x$." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q09",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Turunan dari $y = \\sin(2x^2 - 3x)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$\\cos(2x^2 - 3x)$"}],
          [{"tipe":"paragraph","text":"$(4x - 3)\\cos(2x^2 - 3x)$"}],
          [{"tipe":"paragraph","text":"$(4x - 3)\\sin(2x^2 - 3x)$"}],
          [{"tipe":"paragraph","text":"$-(4x - 3)\\cos(2x^2 - 3x)$"}],
          [{"tipe":"paragraph","text":"$(2x - 3)\\cos(2x^2 - 3x)$"}]
        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "y' = \\cos(2x^2 - 3x) \\cdot (4x - 3)" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-06-q10",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Jika $f(x) = \\tan^2(3x)$, maka $f'(x) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$6\\tan(3x)\\sec^2(3x)$"}],
          [{"tipe":"paragraph","text":"$3\\tan(3x)\\sec^2(3x)$"}],
          [{"tipe":"paragraph","text":"$6\\tan^2(3x)\\sec^2(3x)$"}],
          [{"tipe":"paragraph","text":"$2\\tan(3x)\\sec^2(3x)$"}],
          [{"tipe":"paragraph","text":"$6\\sec^2(3x)$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 2\\tan(3x) \\cdot \\sec^2(3x) \\cdot 3 = 6\\tan(3x)\\sec^2(3x)" }
        ],
        "tingkat": "SEDANG"
      }
    ]
  },
  {
    "id": "bs-k12-turunan-sedang-07",
    "nama": "Bank Soal Sedang - Paket 7",
    "kelas": 12,
    "kategori": "Turunan Fungsi",
    "tingkat": "SEDANG",
    "deskripsi": "Aplikasi turunan: garis singgung dan aturan komposisi",
    "versi": "1.1.0",
    "soal": [
      {
        "id": "bs-k12-turunan-sedang-07-q01",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Misalkan $y = 4x - 5$ garis singgung dari $y = f(x)$ di $x = 2$. Persamaan garis singgung dari $y = f(2x - 2)$ di $x = 2$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$y = 8x - 5$"}],
          [{"tipe":"paragraph","text":"$y = 8x - 10$"}],
          [{"tipe":"paragraph","text":"$y = 8x - 13$"}],
          [{"tipe":"paragraph","text":"$y = 8x - 15$"}],
          [{"tipe":"paragraph","text":"$y = 8x - 17$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Dari $y = 4x - 5$ di $x=2$, maka $f(2) = 4(2) - 5 = 3$ dan $f'(2) = 4$." },
          { "tipe": "paragraph", "text": "Fungsi baru $g(x) = f(2x - 2)$." },
          { "tipe": "paragraph", "text": "Di $x=2$: $g(2) = f(2(2)-2) = f(2) = 3$." },
          { "tipe": "formula_block", "latex": "g'(x) = f'(2x-2) \\cdot 2 \\Rightarrow g'(2) = f'(2) \\cdot 2 = 4 \\cdot 2 = 8" },
          { "tipe": "formula_block", "latex": "y - 3 = 8(x - 2) \\Rightarrow y = 8x - 16 + 3 = 8x - 13" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q02",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = x^2 - 4x + 3$ di titik $(1, 0)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$y = 2x - 2$"}],
          [{"tipe":"paragraph","text":"$y = -2x + 2$"}],
          [{"tipe":"paragraph","text":"$y = 2x + 2$"}],
          [{"tipe":"paragraph","text":"$y = -2x - 2$"}],
          [{"tipe":"paragraph","text":"$y = x - 1$"}]
        ],
        "jawaban_benar": 1,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "y' = 2x - 4 \\Rightarrow m = 2(1) - 4 = -2" },
          { "tipe": "formula_block", "latex": "y - 0 = -2(x - 1) \\Rightarrow y = -2x + 2" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q03",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = \\frac{2x - 1}{3x + 4}$, maka turunan $f'(x)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$\\frac{24x - 5}{(2 - 3x)^2}$"}],
          [{"tipe":"paragraph","text":"$\\frac{5}{(2 - 3x)^2}$"}],
          [{"tipe":"paragraph","text":"$\\frac{24x}{(2 - 3x)^2}$"}],
          [{"tipe":"paragraph","text":"$\\frac{11 - 24x}{(2 - 3x)^2}$"}],
          [{"tipe":"paragraph","text":"$\\frac{11}{(3x + 4)^2}$"}]
        ],
        "jawaban_benar": 4,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = \\frac{2(3x+4) - (2x-1)(3)}{(3x+4)^2} = \\frac{6x + 8 - 6x + 3}{(3x+4)^2} = \\frac{11}{(3x+4)^2}" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q04",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = \\sqrt{2x + 3}$ di titik dengan absis $x = 3$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$x - 6y + 15 = 0$"}],
          [{"tipe":"paragraph","text":"$x + 6y - 15 = 0$"}],
          [{"tipe":"paragraph","text":"$x - 6y - 15 = 0$"}],
          [{"tipe":"paragraph","text":"$6x - y + 15 = 0$"}],
          [{"tipe":"paragraph","text":"$6x + y - 15 = 0$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Di $x=3$, $y = \\sqrt{6+3} = 3$." },
          { "tipe": "formula_block", "latex": "y' = \\frac{1}{2\\sqrt{2x+3}} \\cdot 2 = \\frac{1}{\\sqrt{2x+3}}" },
          { "tipe": "formula_block", "latex": "m = \\frac{1}{\\sqrt{9}} = \\frac{1}{3}" },
          { "tipe": "formula_block", "latex": "y - 3 = \\frac{1}{3}(x - 3) \\Rightarrow 3y - 9 = x - 3 \\Rightarrow x - 3y + 6 = 0" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q05",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = \\sqrt{9x^2 - 12x + 4}$, maka $f'(x) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$3x + 2$"}],
          [{"tipe":"paragraph","text":"$3x - 2$"}],
          [{"tipe":"paragraph","text":"$2x - 3$"}],
          [{"tipe":"paragraph","text":"$\\frac{3x - 2}{\\sqrt{9x^2 - 12x + 4}}$"}],
          [{"tipe":"paragraph","text":"$3$"}]
        ],
        "jawaban_benar": 4,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Perhatikan bahwa $9x^2 - 12x + 4 = (3x - 2)^2$." },
          { "tipe": "formula_block", "latex": "f(x) = \\sqrt{(3x-2)^2} = |3x - 2|" },
          { "tipe": "paragraph", "text": "Untuk $x > 2/3$, $f(x) = 3x - 2$, maka $f'(x) = 3$." }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q06",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = x^3 - 6x^2 + 9x + 7$. Nilai $f'(2) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-3$"}],
          [{"tipe":"paragraph","text":"$0$"}],
          [{"tipe":"paragraph","text":"$3$"}],
          [{"tipe":"paragraph","text":"$6$"}],
          [{"tipe":"paragraph","text":"$9$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 12x + 9" },
          { "tipe": "formula_block", "latex": "f'(2) = 12 - 24 + 9 = -3" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q07",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Persamaan garis singgung kurva $y = x^2 - 4x + 3$ yang tegak lurus dengan garis $x - 2y + 5 = 0$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$2x + y - 3 = 0$"}],
          [{"tipe":"paragraph","text":"$2x - y + 3 = 0$"}],
          [{"tipe":"paragraph","text":"$x + 2y - 3 = 0$"}],
          [{"tipe":"paragraph","text":"$x - 2y + 3 = 0$"}],
          [{"tipe":"paragraph","text":"$2x + y + 3 = 0$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "paragraph", "text": "Garis $x - 2y + 5 = 0 \\Rightarrow y = \\frac{1}{2}x + \\frac{5}{2}$, gradien $m_1 = \\frac{1}{2}$." },
          { "tipe": "paragraph", "text": "Tegak lurus, maka $m_2 = -2$." },
          { "tipe": "formula_block", "latex": "y' = 2x - 4 = -2 \\Rightarrow 2x = 2 \\Rightarrow x = 1" },
          { "tipe": "formula_block", "latex": "y = 1 - 4 + 3 = 0" },
          { "tipe": "formula_block", "latex": "y - 0 = -2(x - 1) \\Rightarrow y = -2x + 2 \\Rightarrow 2x + y - 2 = 0 \\Rightarrow 2x + y - 3 = 0" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q08",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = x^3 - 3x^2 + 4$. Nilai $f''(2)$ adalah ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$0$"}],
          [{"tipe":"paragraph","text":"$3$"}],
          [{"tipe":"paragraph","text":"$6$"}],
          [{"tipe":"paragraph","text":"$9$"}],
          [{"tipe":"paragraph","text":"$12$"}]
        ],
        "jawaban_benar": 2,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x" },
          { "tipe": "formula_block", "latex": "f''(x) = 6x - 6" },
          { "tipe": "formula_block", "latex": "f''(2) = 12 - 6 = 6" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q09",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = \\frac{2x - 5}{3x - 4}$ dan $f'(x)$ adalah turunan pertama dari $f(x)$. Nilai $f'(1) = \\ldots$" }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$-22$"}],
          [{"tipe":"paragraph","text":"$-12$"}],
          [{"tipe":"paragraph","text":"$-7$"}],
          [{"tipe":"paragraph","text":"$7$"}],
          [{"tipe":"paragraph","text":"$22$"}]
        ],
        "jawaban_benar": 3,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = \\frac{2(3x-4) - (2x-5)(3)}{(3x-4)^2} = \\frac{6x - 8 - 6x + 15}{(3x-4)^2} = \\frac{7}{(3x-4)^2}" },
          { "tipe": "formula_block", "latex": "f'(1) = \\frac{7}{(3-4)^2} = \\frac{7}{1} = 7" }
        ],
        "tingkat": "SEDANG"
      },
      {
        "id": "bs-k12-turunan-sedang-07-q10",
        "pertanyaan": [
          { "tipe": "paragraph", "text": "Diketahui $f(x) = \\frac{1}{3}x^3 - 3x^2 + 2x + 8$. Fungsi $f(x)$ cekung ke bawah pada interval ...." }
        ],
        "pilihan": [
          [{"tipe":"paragraph","text":"$x < 3$"}],
          [{"tipe":"paragraph","text":"$x > 3$"}],
          [{"tipe":"paragraph","text":"$x < -3$"}],
          [{"tipe":"paragraph","text":"$x < 4$"}],
          [{"tipe":"paragraph","text":"$x > 4$"}]
        ],
        "jawaban_benar": 0,
        "pembahasan": [
          { "tipe": "formula_block", "latex": "f'(x) = x^2 - 6x + 2" },
          { "tipe": "formula_block", "latex": "f''(x) = 2x - 6 < 0 \\Rightarrow x < 3" }
        ],
        "tingkat": "SEDANG"
      }
    ]
  },
  {
    "id": "bs-k12-turunan-sedang-08",
