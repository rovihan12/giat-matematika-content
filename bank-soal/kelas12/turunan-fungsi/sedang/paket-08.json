{
  "id": "bs-k12-turunan-sedang-08",
  "nama": "Bank Soal Sedang - Paket 8",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Fungsi naik/turun, stasioner, dan titik belok",
  "versi": "1.3.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sedang-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 + 6x^2 - 15x$ turun pada interval ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1 < x < 5$"}],
        [{"tipe":"paragraph","text":"$-5 \\le x \\le 1$"}],
        [{"tipe":"paragraph","text":"$-5 < x < 1$"}],
        [{"tipe":"paragraph","text":"$x < -5$ atau $x > 1$"}],
        [{"tipe":"paragraph","text":"$x \\le -5$ atau $x \\ge 3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 12x - 15 < 0" },
        { "tipe": "formula_block", "latex": "x^2 + 4x - 5 < 0 \\Rightarrow (x+5)(x-1) < 0" },
        { "tipe": "paragraph", "text": "Interval turun adalah $-5 < x < 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = 4x^3 - 18x^2 + 15x - 20$ mencapai maksimum untuk nilai $x = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{5}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\frac{5}{2}$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 12x^2 - 36x + 15 = 0" },
        { "tipe": "formula_block", "latex": "4x^2 - 12x + 5 = 0 \\Rightarrow (2x - 1)(2x - 5) = 0" },
        { "tipe": "paragraph", "text": "$x = 1/2$ atau $x = 5/2$." },
        { "tipe": "formula_block", "latex": "f''(x) = 24x - 36" },
        { "tipe": "paragraph", "text": "$f''(1/2) = 12 - 36 = -24 < 0$ (maksimum)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = \\frac{1}{3}x^3 + ax^2 - 2x + 1$. Fungsi $f(x)$ mempunyai nilai stasioner pada $x = -2$ untuk nilai $a = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = x^2 + 2ax - 2" },
        { "tipe": "formula_block", "latex": "f'(-2) = (-2)^2 + 2a(-2) - 2 = 4 - 4a - 2 = 2 - 4a = 0" },
        { "tipe": "formula_block", "latex": "4a = 2 \\Rightarrow a = \\frac{1}{2}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 - 3x^2 - 45x + 20$ turun pada interval ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3 < x < 5$"}],
        [{"tipe":"paragraph","text":"$3 < x < -5$"}],
        [{"tipe":"paragraph","text":"$-3 < x < -5$"}],
        [{"tipe":"paragraph","text":"$3 < x < 5$"}],
        [{"tipe":"paragraph","text":"$1 < x < 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x - 45 < 0" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 15 < 0 \\Rightarrow (x - 5)(x + 3) < 0" },
        { "tipe": "paragraph", "text": "Interval turun adalah $-3 < x < 5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $f(x) = 5 + 15x + 9x^2 + x^3$ naik untuk $x$ yang memenuhi ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x < 1$ atau $x > 5$"}],
        [{"tipe":"paragraph","text":"$1 < x < 5$"}],
        [{"tipe":"paragraph","text":"$-5 < x < -1$"}],
        [{"tipe":"paragraph","text":"$x < -5$ atau $x > -1$"}],
        [{"tipe":"paragraph","text":"$-5 < x < 1$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 15 + 18x + 3x^2 > 0" },
        { "tipe": "formula_block", "latex": "x^2 + 6x + 5 > 0 \\Rightarrow (x + 5)(x + 1) > 0" },
        { "tipe": "paragraph", "text": "Interval naik adalah $x < -5$ atau $x > -1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = (x-1)(x^2 + 7x - 29)$ naik pada interval ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-6 < x < 2$"}],
        [{"tipe":"paragraph","text":"$-2 < x < 6$"}],
        [{"tipe":"paragraph","text":"$x < 2$ atau $x > 6$"}],
        [{"tipe":"paragraph","text":"$x < -6$ atau $x > 2$"}],
        [{"tipe":"paragraph","text":"$x < -2$ atau $x > 6$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jabarkan: $f(x) = x^3 + 6x^2 - 36x + 29$." },
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 12x - 36 > 0" },
        { "tipe": "formula_block", "latex": "x^2 + 4x - 12 > 0 \\Rightarrow (x + 6)(x - 2) > 0" },
        { "tipe": "paragraph", "text": "Interval naik adalah $x < -6$ atau $x > 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x^3 - 3x^2 - 12x + 1$ dalam interval $-2 \\le x \\le 3$, mencapai maksimum pada titik $x = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 6x^2 - 6x - 12 = 0 \\Rightarrow x^2 - x - 2 = 0 \\Rightarrow (x-2)(x+1) = 0" },
        { "tipe": "paragraph", "text": "Stasioner di $x=-1$ dan $x=2$." },
        { "tipe": "paragraph", "text": "Cek ujung dan stasioner:" },
        { "tipe": "paragraph", "text": "$f(-2) = -16 - 12 + 24 + 1 = -3$." },
        { "tipe": "paragraph", "text": "$f(-1) = -2 - 3 + 12 + 1 = 8$." },
        { "tipe": "paragraph", "text": "$f(2) = 16 - 12 - 24 + 1 = -19$." },
        { "tipe": "paragraph", "text": "$f(3) = 54 - 27 - 36 + 1 = -8$." },
        { "tipe": "paragraph", "text": "Nilai maksimum di $x=-1$ (karena $f(-1)=8$)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 - 3x^2 + 4$ memiliki titik belok di $x = \\ldots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x" },
        { "tipe": "formula_block", "latex": "f''(x) = 6x - 6 = 0 \\Rightarrow x = 1" },
        { "tipe": "paragraph", "text": "Jadi titik belok terjadi di $x=1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^4 - 4x$ turun untuk $x$ yang memenuhi ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x < 0$"}],
        [{"tipe":"paragraph","text":"$0 < x < 1$"}],
        [{"tipe":"paragraph","text":"$x > 1$"}],
        [{"tipe":"paragraph","text":"$x < 1$"}],
        [{"tipe":"paragraph","text":"$x > 0$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "y' = 4x^3 - 4 = 4(x^3 - 1)" },
        { "tipe": "paragraph", "text": "Turun saat $y' < 0 \\Rightarrow x^3 - 1 < 0 \\Rightarrow x < 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 + 2x^2 + 2x - 5$ grafiknya ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"Turun dalam interval $-2 < x < 3$"}],
        [{"tipe":"paragraph","text":"Naik dalam interval $-2 < x < 3$"}],
        [{"tipe":"paragraph","text":"Selalu naik"}],
        [{"tipe":"paragraph","text":"Selalu turun"}],
        [{"tipe":"paragraph","text":"Naik dalam interval $x < 2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 4x + 2" },
        { "tipe": "paragraph", "text": "Diskriminan $D = 16 - 24 = -8 < 0$. Karena $a = 3 > 0$ dan $D < 0$, maka $f'(x) > 0$ untuk semua $x$." },
        { "tipe": "paragraph", "text": "Jadi grafik selalu naik." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
