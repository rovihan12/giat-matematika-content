{
  "id": "bs-k12-turunan-sedang-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Aturan perkalian (product rule)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sedang-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x+1)(x+2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x + 3$"}],
        [{"tipe":"paragraph","text":"$2x + 2$"}],
        [{"tipe":"paragraph","text":"$x + 3$"}],
        [{"tipe":"paragraph","text":"$2x + 1$"}],
        [{"tipe":"paragraph","text":"$2x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan perkalian: $f' = u'v + uv'$ dengan $u = x+1$, $v = x+2$." },
        { "tipe": "formula_block", "latex": "f'(x) = (1)(x+2) + (x+1)(1) = x + 2 + x + 1 = 2x + 3" },
        { "tipe": "paragraph", "text": "Verifikasi dengan ekspansi: $f(x) = x^2 + 3x + 2 \\Rightarrow f'(x) = 2x + 3$. ✅" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (2x+1)(x-3)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4x - 5$"}],
        [{"tipe":"paragraph","text":"$4x + 5$"}],
        [{"tipe":"paragraph","text":"$4x - 1$"}],
        [{"tipe":"paragraph","text":"$2x - 5$"}],
        [{"tipe":"paragraph","text":"$4x - 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 2(x-3) + (2x+1)(1) = 2x - 6 + 2x + 1 = 4x - 5" },
        { "tipe": "paragraph", "text": "Verifikasi: $f(x) = 2x^2 - 5x - 3 \\Rightarrow f'(x) = 4x - 5$. ✅" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x^2+1)(x+2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^2 + 4x + 1$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 4x + 1$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 4x - 1$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 4x + 1$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 2x + 1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 2x(x+2) + (x^2+1)(1) = 2x^2 + 4x + x^2 + 1 = 3x^2 + 4x + 1" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 3x^2 + 4x + 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x^2+3x)(x-1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3x^2 + 4x - 3$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 4x + 3$"}],
        [{"tipe":"paragraph","text":"$3x^2 - 4x - 3$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 4x - 3$"}],
        [{"tipe":"paragraph","text":"$3x^2 + 2x - 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = (2x+3)(x-1) + (x^2+3x)(1) = 2x^2 + x - 3 + x^2 + 3x = 3x^2 + 4x - 3" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 3x^2 + 4x - 3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = x^2(x^3+1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5x^4 + 2x$"}],
        [{"tipe":"paragraph","text":"$5x^4 - 2x$"}],
        [{"tipe":"paragraph","text":"$5x^4 + x$"}],
        [{"tipe":"paragraph","text":"$6x^5 + 2x$"}],
        [{"tipe":"paragraph","text":"$5x^4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 2x(x^3+1) + x^2(3x^2) = 2x^4 + 2x + 3x^4 = 5x^4 + 2x" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 5x^4 + 2x$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x+1)(x+2)(x+3)$ di $x = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$11$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$12$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $f(x) = x^3 + 6x^2 + 11x + 6$." },
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 + 12x + 11 \\Rightarrow f'(0) = 11" },
        { "tipe": "paragraph", "text": "Jadi, $f'(0) = 11$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x^2+1)(x^2-1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4x^3$"}],
        [{"tipe":"paragraph","text":"$4x$"}],
        [{"tipe":"paragraph","text":"$2x^3$"}],
        [{"tipe":"paragraph","text":"$4x^2$"}],
        [{"tipe":"paragraph","text":"$3x^3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sederhanakan: $f(x) = x^4 - 1$." },
        { "tipe": "formula_block", "latex": "f'(x) = 4x^3" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 4x^3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (2x^2+3)(x-1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6x^2 - 4x + 3$"}],
        [{"tipe":"paragraph","text":"$6x^2 + 4x + 3$"}],
        [{"tipe":"paragraph","text":"$6x^2 - 4x - 3$"}],
        [{"tipe":"paragraph","text":"$4x^2 - 4x + 3$"}],
        [{"tipe":"paragraph","text":"$6x^2 - 4x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 4x(x-1) + (2x^2+3)(1) = 4x^2 - 4x + 2x^2 + 3 = 6x^2 - 4x + 3" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 6x^2 - 4x + 3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x^3+2x)(x^2-1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5x^4 + 3x^2 - 2$"}],
        [{"tipe":"paragraph","text":"$5x^4 + 3x^2 + 2$"}],
        [{"tipe":"paragraph","text":"$5x^4 - 3x^2 - 2$"}],
        [{"tipe":"paragraph","text":"$5x^4 + 3x^2$"}],
        [{"tipe":"paragraph","text":"$5x^4 + 4x^2 - 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = (3x^2+2)(x^2-1) + (x^3+2x)(2x)" },
        { "tipe": "formula_block", "latex": "= 3x^4 - 3x^2 + 2x^2 - 2 + 2x^4 + 4x^2 = 5x^4 + 3x^2 - 2" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 5x^4 + 3x^2 - 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = (x^2+x+1)(x+1)$, maka $f'(1)$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$9$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = (2x+1)(x+1) + (x^2+x+1)(1) = 2x^2 + 3x + 1 + x^2 + x + 1 = 3x^2 + 4x + 2" },
        { "tipe": "formula_block", "latex": "f'(1) = 3 + 4 + 2 = 9" },
        { "tipe": "paragraph", "text": "Jadi, $f'(1) = 9$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
