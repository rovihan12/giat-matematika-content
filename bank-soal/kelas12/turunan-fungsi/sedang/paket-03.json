{
  "id": "bs-k12-turunan-sedang-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 12,
  "kategori": "Turunan Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Aturan rantai (chain rule)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-turunan-sedang-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (2x+1)^3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6(2x+1)^2$"}],
        [{"tipe":"paragraph","text":"$3(2x+1)^2$"}],
        [{"tipe":"paragraph","text":"$6(2x+1)^3$"}],
        [{"tipe":"paragraph","text":"$(2x+1)^2$"}],
        [{"tipe":"paragraph","text":"$2(2x+1)^2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan rantai: $f' = n \\cdot u^{n-1} \\cdot u'$ dengan $u = 2x+1$, $u' = 2$." },
        { "tipe": "formula_block", "latex": "f'(x) = 3(2x+1)^2 \\cdot 2 = 6(2x+1)^2" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 6(2x+1)^2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (3x-2)^4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$12(3x-2)^3$"}],
        [{"tipe":"paragraph","text":"$4(3x-2)^3$"}],
        [{"tipe":"paragraph","text":"$3(3x-2)^3$"}],
        [{"tipe":"paragraph","text":"$12(3x-2)^4$"}],
        [{"tipe":"paragraph","text":"$(3x-2)^3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 4(3x-2)^3 \\cdot 3 = 12(3x-2)^3" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 12(3x-2)^3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x^2+1)^3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6x(x^2+1)^2$"}],
        [{"tipe":"paragraph","text":"$3x(x^2+1)^2$"}],
        [{"tipe":"paragraph","text":"$6(x^2+1)^2$"}],
        [{"tipe":"paragraph","text":"$3(x^2+1)^2$"}],
        [{"tipe":"paragraph","text":"$2x(x^2+1)^2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3(x^2+1)^2 \\cdot 2x = 6x(x^2+1)^2" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 6x(x^2+1)^2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = \\sqrt{2x+1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\sqrt{2x+1}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{\\sqrt{2x+1}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2\\sqrt{2x+1}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sqrt{2x+1}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2x+1}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis $f(x) = (2x+1)^{1/2}$." },
        { "tipe": "formula_block", "latex": "f'(x) = \\dfrac{1}{2}(2x+1)^{-1/2} \\cdot 2 = (2x+1)^{-1/2} = \\dfrac{1}{\\sqrt{2x+1}}" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = \\dfrac{1}{\\sqrt{2x+1}}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = \\sqrt{x^2+1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{x}{\\sqrt{x^2+1}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2x}{\\sqrt{x^2+1}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x}{2\\sqrt{x^2+1}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\sqrt{x^2+1}}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{x^2+1}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = \\dfrac{1}{2}(x^2+1)^{-1/2} \\cdot 2x = \\dfrac{x}{\\sqrt{x^2+1}}" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = \\dfrac{x}{\\sqrt{x^2+1}}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x^3+2x)^5$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5(x^3+2x)^4 \\cdot (3x^2+2)$"}],
        [{"tipe":"paragraph","text":"$5(x^3+2x)^4$"}],
        [{"tipe":"paragraph","text":"$(3x^2+2)^5$"}],
        [{"tipe":"paragraph","text":"$5(x^3+2x)^4 \\cdot (x^2+2)$"}],
        [{"tipe":"paragraph","text":"$(x^3+2x)^4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 5(x^3+2x)^4 \\cdot (3x^2+2)" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 5(x^3+2x)^4 \\cdot (3x^2+2)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (1-x)^6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-6(1-x)^5$"}],
        [{"tipe":"paragraph","text":"$6(1-x)^5$"}],
        [{"tipe":"paragraph","text":"$-6(1-x)^6$"}],
        [{"tipe":"paragraph","text":"$-(1-x)^5$"}],
        [{"tipe":"paragraph","text":"$(1-x)^5$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 6(1-x)^5 \\cdot (-1) = -6(1-x)^5" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = -6(1-x)^5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (x^2-3x)^4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4(x^2-3x)^3 \\cdot (2x-3)$"}],
        [{"tipe":"paragraph","text":"$4(x^2-3x)^3$"}],
        [{"tipe":"paragraph","text":"$(2x-3)^4$"}],
        [{"tipe":"paragraph","text":"$4(x^2-3x)^3 \\cdot (x-3)$"}],
        [{"tipe":"paragraph","text":"$(x^2-3x)^3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 4(x^2-3x)^3 \\cdot (2x-3)" },
        { "tipe": "paragraph", "text": "Jadi, $f'(x) = 4(x^2-3x)^3 \\cdot (2x-3)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = \\sqrt{3x+1}$ di $x = 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = \\dfrac{3}{2\\sqrt{3x+1}}" },
        { "tipe": "formula_block", "latex": "f'(1) = \\dfrac{3}{2\\sqrt{4}} = \\dfrac{3}{4}" },
        { "tipe": "paragraph", "text": "Jadi, $f'(1) = \\dfrac{3}{4}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-turunan-sedang-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan dari $f(x) = (2x^2+1)^3$ di $x = 1$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$36$"}],
        [{"tipe":"paragraph","text":"$72$"}],
        [{"tipe":"paragraph","text":"$108$"}],
        [{"tipe":"paragraph","text":"$144$"}],
        [{"tipe":"paragraph","text":"$216$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "f'(x) = 3(2x^2+1)^2 \\cdot 4x = 12x(2x^2+1)^2" },
        { "tipe": "formula_block", "latex": "f'(1) = 12(3)^2 = 12 \\cdot 9 = 108" },
        { "tipe": "paragraph", "text": "Jadi, $f'(1) = 108$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
