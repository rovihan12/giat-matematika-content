{
  "id": "bs-k12-mat-lanjut-sedang-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Fungsi komposisi, fungsi invers, dan vektor",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $g(x) = 2x + 1$ dan $f(x) = \\frac{x+3}{x-2}$. Jika $h(x) = (f \\circ g)(x)$, maka $h^{-1}(x) = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\frac{x-4}{2x-2}, x \\ne 1$"}],
        [{"tipe":"paragraph","text":"$\\frac{x+4}{2x+2}, x \\ne -1$"}],
        [{"tipe":"paragraph","text":"$\\frac{x+2}{4x+2}, x \\ne -\\frac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\frac{x+4}{x-2}, x \\ne 2$"}],
        [{"tipe":"paragraph","text":"$\\frac{x+4}{2x-2}, x \\ne 1$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tentukan fungsi komposisi $h(x) = f(g(x))$ terlebih dahulu:" },
        { "tipe": "formula_block", "latex": "h(x) = f(2x+1) = \\frac{(2x+1)+3}{(2x+1)-2} = \\frac{2x+4}{2x-1}" },
        { "tipe": "paragraph", "text": "Cari inversnya dengan memisalkan $y = \\frac{2x+4}{2x-1}$:" },
        { "tipe": "formula_block", "latex": "y(2x-1) = 2x+4 \\implies 2xy - y = 2x + 4 \\implies 2xy - 2x = y + 4" },
        { "tipe": "formula_block", "latex": "x(2y - 2) = y + 4 \\implies x = \\frac{y+4}{2y-2}" },
        { "tipe": "paragraph", "text": "Jadi, $h^{-1}(x) = \\frac{x+4}{2x-2}$ dengan syarat $x \\ne 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan $|AC| = \\sqrt{5}$. Nilai dari $(\\vec{BC} - \\vec{BA}) \\cdot \\vec{CA}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{5}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$-\\sqrt{5}$"}],
        [{"tipe":"paragraph","text":"$-5$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sederhanakan vektor dengan sifat pengurangan:" },
        { "tipe": "formula_block", "latex": "\\vec{BC} - \\vec{BA} = \\vec{BC} + \\vec{AB} = \\vec{AC}" },
        { "tipe": "paragraph", "text": "Substitusikan ke dalam perkalian titik (dot product):" },
        { "tipe": "formula_block", "latex": "(\\vec{BC} - \\vec{BA}) \\cdot \\vec{CA} = \\vec{AC} \\cdot \\vec{CA}" },
        { "tipe": "paragraph", "text": "Karena $\\vec{CA} = -\\vec{AC}$, maka:" },
        { "tipe": "formula_block", "latex": "\\vec{AC} \\cdot (-\\vec{AC}) = -|\\vec{AC}|^2 = -(\\sqrt{5})^2 = -5" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2x+1 & 3 \\\\ 6x-1 & 5 \\end{pmatrix}$ tidak mempunyai invers. Nilai $x$ yang memenuhi adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Matriks tidak memiliki invers jika determinannya bernilai nol ( singular ):" },
        { "tipe": "formula_block", "latex": "\\det(A) = (2x+1)(5) - (3)(6x-1) = 0" },
        { "tipe": "formula_block", "latex": "10x + 5 - 18x + 3 = 0 \\implies -8x + 8 = 0 \\implies x = 1" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x)$ dibagi $(x+2)$ bersisa $14$ dan $f(x)$ dibagi $(x-4)$ bersisa $-4$, maka $f(x)$ dibagi $(x^2 - 2x - 8)$ bersisa ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3x + 8$"}],
        [{"tipe":"paragraph","text":"$-3x - 8$"}],
        [{"tipe":"paragraph","text":"$2x - 4$"}],
        [{"tipe":"paragraph","text":"$2x + 4$"}],
        [{"tipe":"paragraph","text":"$8x + 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan sisa pembagian adalah $S(x) = ax + b$." },
        { "tipe": "paragraph", "text": "Berdasarkan teorema sisa: $f(-2) = 14$ dan $f(4) = -4$." },
        { "tipe": "formula_block", "latex": "-2a + b = 14" },
        { "tipe": "formula_block", "latex": "4a + b = -4" },
        { "tipe": "paragraph", "text": "Eliminasi $b$ dengan mengurangkan kedua persamaan:" },
        { "tipe": "formula_block", "latex": "-6a = 18 \\implies a = -3" },
        { "tipe": "paragraph", "text": "Substitusi $a = -3$ ke $-2(-3) + b = 14 \\implies 6 + b = 14 \\implies b = 8$." },
        { "tipe": "paragraph", "text": "Jadi, sisa pembagiannya adalah $-3x + 8$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar dari polinomial $x^4 - 5x^2 + 4 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2$, sehingga persamaan menjadi $u^2 - 5u + 4 = 0$:" },
        { "tipe": "formula_block", "latex": "(u-1)(u-4) = 0 \\implies u = 1 \\text{ atau } u = 4" },
        { "tipe": "paragraph", "text": "• Untuk $u=1 \\implies x^2=1 \\implies x = \\pm 1$" },
        { "tipe": "paragraph", "text": "• Untuk $u=4 \\implies x^2=4 \\implies x = \\pm 2$" },
        { "tipe": "paragraph", "text": "Akar-akarnya adalah $1, -1, 2, -2$. Dari pilihan yang ada, $-2$ merupakan salah satu akarnya." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui fungsi permintaan dan penawaran suatu barang berturut-turut adalah $P_d = 12 - 2Q$ dan $P_s = 3 + Q$. Titik keseimbangan pasar terjadi pada saat ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$Q = 3$ dan $P = 6$"}],
        [{"tipe":"paragraph","text":"$Q = 4$ dan $P = 4$"}],
        [{"tipe":"paragraph","text":"$Q = 3$ dan $P = 9$"}],
        [{"tipe":"paragraph","text":"$Q = 4$ dan $P = 7$"}],
        [{"tipe":"paragraph","text":"$Q = 5$ dan $P = 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Keseimbangan pasar terjadi saat $P_d = P_s$:" },
        { "tipe": "formula_block", "latex": "12 - 2Q = 3 + Q \\implies 3Q = 9 \\implies Q = 3" },
        { "tipe": "paragraph", "text": "Substitusikan $Q=3$ ke salah satu fungsi:" },
        { "tipe": "formula_block", "latex": "P = 3 + 3 = 6" },
        { "tipe": "paragraph", "text": "Jadi, titik keseimbangan pasar tercapai pada $Q = 3$ dan $P = 6$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan pertama dari $f(x) = (2x^2 + 3)^4$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4(2x^2 + 3)^3$"}],
        [{"tipe":"paragraph","text":"$16x(2x^2 + 3)^3$"}],
        [{"tipe":"paragraph","text":"$8x(2x^2 + 3)^4$"}],
        [{"tipe":"paragraph","text":"$16x(2x^2 + 3)^4$"}],
        [{"tipe":"paragraph","text":"$4x(2x^2 + 3)^3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan rantai turunan $f'(x) = n \\cdot u^{n-1} \\cdot u'$:" },
        { "tipe": "paragraph", "text": "Misalkan $u = 2x^2 + 3$, maka $u' = 4x$." },
        { "tipe": "formula_block", "latex": "f'(x) = 4(2x^2 + 3)^3 \\cdot (4x) = 16x(2x^2 + 3)^3" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung lingkaran $x^2 + y^2 - 6x + 10y - 46 = 0$ yang sejajar dengan garis $2x + y - 7 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x + y + 19 = 0$"}],
        [{"tipe":"paragraph","text":"$2x - y + 7 = 0$"}],
        [{"tipe":"paragraph","text":"$2x + y - 21 = 0$"}],
        [{"tipe":"paragraph","text":"$2x - y + 13 = 0$"}],
        [{"tipe":"paragraph","text":"$x + 2y + 7 = 0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bentuk baku lingkaran: $(x-3)^2 + (y+5)^2 = 46 + 9 + 25 = 80$." },
        { "tipe": "paragraph", "text": "Pusat $(3, -5)$ dan $r = \\sqrt{80} = 4\\sqrt{5}$." },
        { "tipe": "paragraph", "text": "Garis $2x + y - 7 = 0 \\implies y = -2x + 7$, gradien $m = -2$." },
        { "tipe": "paragraph", "text": "Rumus garis singgung $y - b = m(x - a) \\pm r\\sqrt{m^2+1}$:" },
        { "tipe": "formula_block", "latex": "y + 5 = -2(x - 3) \\pm 4\\sqrt{5}\\sqrt{(-2)^2+1}" },
        { "tipe": "formula_block", "latex": "y + 5 = -2x + 6 \\pm 4\\sqrt{5}\\sqrt{5} = -2x + 6 \\pm 20" },
        { "tipe": "formula_block", "latex": "y = -2x + 1 \\pm 20 \\implies y = -2x + 21 \\text{ atau } y = -2x - 19" },
        { "tipe": "paragraph", "text": "Dalam bentuk umum: $2x + y - 21 = 0$ atau $2x + y + 19 = 0$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim_{x \\to \\infty} \\frac{(2x-1)^3}{(x-1)(x^2+x+1)}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung koefisien pangkat tertinggi ($x^3$) pada pembilang dan penyebut:" },
        { "tipe": "paragraph", "text": "• Pembilang: $(2x-1)^3 = 8x^3 - 12x^2 + 6x - 1 \\implies$ koefisien $x^3$ adalah $8$" },
        { "tipe": "paragraph", "text": "• Penyebut: $(x-1)(x^2+x+1) = x^3 - 1 \\implies$ koefisien $x^3$ adalah $1$" },
        { "tipe": "formula_block", "latex": "\\lim_{x \\to \\infty} \\frac{(2x-1)^3}{(x-1)(x^2+x+1)} = \\frac{8}{1} = 8" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = 2x - 3$ dan $g(x) = x^2 + 1$. Nilai dari $(g \\circ f)(2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung $f(2)$ terlebih dahulu:" },
        { "tipe": "formula_block", "latex": "f(2) = 2(2) - 3 = 4 - 3 = 1" },
        { "tipe": "paragraph", "text": "Substitusikan nilai $f(2)$ ke fungsi $g(x)$:" },
        { "tipe": "formula_block", "latex": "(g \\circ f)(2) = g(f(2)) = g(1) = 1^2 + 1 = 2" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
