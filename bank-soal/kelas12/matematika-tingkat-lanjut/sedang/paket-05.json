{
  "id": "bs-k12-mat-lanjut-sedang-05",
  "nama": "Bank Soal Sedang - Paket 5",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Transformasi dengan matriks & komposisi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks yang merepresentasikan refleksi terhadap sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & 0 \\\\ 0 & -1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Refleksi sumbu-$x$: $(x, y) \\to (x, -y)$." },
        { "tipe": "formula_block", "latex": "M = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, matriksnya $\\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks yang merepresentasikan rotasi $90°$ berlawanan arah jarum jam terhadap titik asal adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 1 \\\\ -1 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & 0 \\\\ 0 & -1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 0 \\\\ 0 & 0 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rotasi $90°$ CCW: $(x, y) \\to (-y, x)$." },
        { "tipe": "formula_block", "latex": "M = \\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, matriksnya $\\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(2, 3)$ oleh matriks $M = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(2, -3)$"}],
        [{"tipe":"paragraph","text":"$(-2, 3)$"}],
        [{"tipe":"paragraph","text":"$(-2, -3)$"}],
        [{"tipe":"paragraph","text":"$(3, 2)$"}],
        [{"tipe":"paragraph","text":"$(-3, -2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "M \\cdot A^T = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix} \\begin{pmatrix} 2 \\\\ 3 \\end{pmatrix} = \\begin{pmatrix} 2 \\\\ -3 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(2, -3)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Komposisi dua refleksi terhadap sumbu-$x$ dan sumbu-$y$ menghasilkan ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"rotasi $180°$"}],
        [{"tipe":"paragraph","text":"translasi"}],
        [{"tipe":"paragraph","text":"dilatasi"}],
        [{"tipe":"paragraph","text":"rotasi $90°$"}],
        [{"tipe":"paragraph","text":"identitas"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Refleksi sumbu-$y$ dilanjutkan refleksi sumbu-$x$ sama dengan rotasi $180°$." },
        { "tipe": "formula_block", "latex": "\\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix} \\begin{pmatrix} -1 & 0 \\\\ 0 & 1 \\end{pmatrix} = \\begin{pmatrix} -1 & 0 \\\\ 0 & -1 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Matriks ini adalah matriks rotasi $180°$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(1, 0)$ oleh rotasi $90°$ CCW terhadap titik asal $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(0, 1)$"}],
        [{"tipe":"paragraph","text":"$(0, -1)$"}],
        [{"tipe":"paragraph","text":"$(-1, 0)$"}],
        [{"tipe":"paragraph","text":"$(1, 1)$"}],
        [{"tipe":"paragraph","text":"$(-1, 1)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix} \\begin{pmatrix} 1 \\\\ 0 \\end{pmatrix} = \\begin{pmatrix} 0 \\\\ 1 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(0, 1)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks dilatasi dengan faktor skala $k$ terhadap titik asal $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} k & 0 \\\\ 0 & k \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & k \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} k & 0 \\\\ 0 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & k \\\\ k & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -k & 0 \\\\ 0 & -k \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dilatasi skala $k$: $(x, y) \\to (kx, ky)$." },
        { "tipe": "formula_block", "latex": "M = \\begin{pmatrix} k & 0 \\\\ 0 & k \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, matriksnya $\\begin{pmatrix} k & 0 \\\\ 0 & k \\end{pmatrix}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(3, 4)$ oleh matriks $\\begin{pmatrix} 2 & 0 \\\\ 0 & 2 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(6, 8)$"}],
        [{"tipe":"paragraph","text":"$(5, 6)$"}],
        [{"tipe":"paragraph","text":"$(1, 2)$"}],
        [{"tipe":"paragraph","text":"$(2, 4)$"}],
        [{"tipe":"paragraph","text":"$(6, 4)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\begin{pmatrix} 2 & 0 \\\\ 0 & 2 \\end{pmatrix} \\begin{pmatrix} 3 \\\\ 4 \\end{pmatrix} = \\begin{pmatrix} 6 \\\\ 8 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(6, 8)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Matriks yang merepresentasikan refleksi terhadap garis $y = x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & -1 \\\\ -1 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Refleksi terhadap garis $y = x$: $(x, y) \\to (y, x)$." },
        { "tipe": "formula_block", "latex": "M = \\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, matriksnya $\\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(5, 2)$ oleh rotasi $180°$ terhadap titik asal $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-5, -2)$"}],
        [{"tipe":"paragraph","text":"$(5, -2)$"}],
        [{"tipe":"paragraph","text":"$(-5, 2)$"}],
        [{"tipe":"paragraph","text":"$(2, 5)$"}],
        [{"tipe":"paragraph","text":"$(-2, -5)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\begin{pmatrix} -1 & 0 \\\\ 0 & -1 \\end{pmatrix} \\begin{pmatrix} 5 \\\\ 2 \\end{pmatrix} = \\begin{pmatrix} -5 \\\\ -2 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(-5, -2)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik $A(1, 0)$ dikenai transformasi berurutan: refleksi terhadap sumbu-$x$ DILANJUTKAN rotasi $90°$ berlawanan arah jarum jam terhadap titik asal. Bayangan akhir titik $A$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(0, -1)$"}],
        [{"tipe":"paragraph","text":"$(0, 1)$"}],
        [{"tipe":"paragraph","text":"$(-1, 0)$"}],
        [{"tipe":"paragraph","text":"$(1, 0)$"}],
        [{"tipe":"paragraph","text":"$(-1, 1)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Langkah 1 — Refleksi sumbu-$x$ terhadap $A(1, 0)$: $A_1 = (1, 0)$." },
        { "tipe": "paragraph", "text": "Langkah 2 — Rotasi $90°$ CCW terhadap $A_1$: gunakan matriks $\\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix}$." },
        { "tipe": "formula_block", "latex": "A' = \\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix} \\begin{pmatrix} 1 \\\\ 0 \\end{pmatrix} = \\begin{pmatrix} 0 \\\\ 1 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, bayangan akhirnya adalah $(0, 1)$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
