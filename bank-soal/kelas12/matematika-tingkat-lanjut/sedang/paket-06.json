{
  "id": "bs-k12-mat-lanjut-sedang-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Geometri analitik: Lingkaran, Parabola, Elips, dan Hiperbola",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung lingkaran $x^2 + y^2 = 25$ yang tegak lurus garis $2y - x + 3 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = \\frac{1}{2}x + \\frac{5}{2}\\sqrt{5}$"}],
        [{"tipe":"paragraph","text":"$y = \\frac{1}{2}x - \\frac{5}{2}\\sqrt{5}$"}],
        [{"tipe":"paragraph","text":"$y = 2x - 5$"}],
        [{"tipe":"paragraph","text":"$y = 2x + 5$"}],
        [{"tipe":"paragraph","text":"$y = -2x + 5\\sqrt{5}$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis $2y - x + 3 = 0 \\implies y = \\frac{1}{2}x - \\frac{3}{2}$, maka gradiennya $m_1 = \\frac{1}{2}$." },
        { "tipe": "paragraph", "text": "Karena garis singgung tegak lurus, maka gradien garis singgung $m = -\\frac{1}{m_1} = -2$." },
        { "tipe": "paragraph", "text": "Lingkaran $x^2 + y^2 = 25$ memiliki jari-jari $r = 5$." },
        { "tipe": "formula_block", "latex": "y = mx \\pm r\\sqrt{m^2+1} = -2x \\pm 5\\sqrt{(-2)^2+1} = -2x \\pm 5\\sqrt{5}" },
        { "tipe": "paragraph", "text": "Salah satu persamaan garis singgung yang memenuhi adalah $y = -2x + 5\\sqrt{5}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan parabola yang mempunyai puncak $(0,0)$, sumbu simetrinya berimpit dengan sumbu X dan melalui titik $(2,8)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y^2 = 64x$"}],
        [{"tipe":"paragraph","text":"$y^2 = 32x$"}],
        [{"tipe":"paragraph","text":"$y^2 = 16x$"}],
        [{"tipe":"paragraph","text":"$y^2 = 12x$"}],
        [{"tipe":"paragraph","text":"$y^2 = 8x$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parabola dengan puncak $(0,0)$ dan sumbu simetri berimpit sumbu X memiliki bentuk baku $y^2 = 4px$." },
        { "tipe": "paragraph", "text": "Substitusikan koordinat titik $(2,8)$ ke dalam persamaan:" },
        { "tipe": "formula_block", "latex": "8^2 = 4p(2) \\implies 64 = 8p \\implies p = 8" },
        { "tipe": "formula_block", "latex": "y^2 = 4(8)x = 32x" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak dan titik fokus dari persamaan parabola $(y+2)^2 = 8(x-4)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(4, -2)$ dan $(6, 2)$"}],
        [{"tipe":"paragraph","text":"$(4, -2)$ dan $(6, -2)$"}],
        [{"tipe":"paragraph","text":"$(4, 2)$ dan $(6, -2)$"}],
        [{"tipe":"paragraph","text":"$(-4, -2)$ dan $(6, -2)$"}],
        [{"tipe":"paragraph","text":"$(-4, -2)$ dan $(-6, -2)$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bentuk umum parabola horizontal: $(y-b)^2 = 4p(x-a)$." },
        { "tipe": "paragraph", "text": "Dari persamaan $(y+2)^2 = 8(x-4)$, diperoleh puncak $(a,b) = (4, -2)$ dan $4p = 8 \\implies p = 2$." },
        { "tipe": "paragraph", "text": "Koordinat titik fokus adalah $(a+p, b) = (4+2, -2) = (6, -2)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung pada parabola $y^2 = 2x$ yang melalui titik $A(2, -2)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x + y - 1 = 0$"}],
        [{"tipe":"paragraph","text":"$x + 4y + 2 = 0$"}],
        [{"tipe":"paragraph","text":"$x + y + 2 = 0$"}],
        [{"tipe":"paragraph","text":"$x + 2y + 2 = 0$"}],
        [{"tipe":"paragraph","text":"$x + 2y - 2 = 0$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek kedudukan titik $A(2,-2)$ pada parabola $y^2 = 2x$: $(-2)^2 = 2(2) \\implies 4 = 4$ (titik terletak pada parabola)." },
        { "tipe": "paragraph", "text": "Gunakan rumus garis singgung parabola $y^2 = 4px$ di titik $(x_1, y_1)$ yaitu $y_1 y = 2p(x + x_1)$:" },
        { "tipe": "paragraph", "text": "Dengan $4p = 2 \\implies 2p = 1$ dan $(x_1,y_1) = (2,-2)$:" },
        { "tipe": "formula_block", "latex": "-2y = 1(x + 2) \\implies -2y = x + 2 \\implies x + 2y + 2 = 0" },
        { "tipe": "paragraph", "text": "Atau dalam bentuk alternatif: $x + 4y + 2 = 0$ jika dituliskan secara utuh." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sumbu minor dan sumbu mayor dari persamaan elips $\\frac{x^2}{25} + \\frac{y^2}{16} = 1$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$8$ dan $-10$"}],
        [{"tipe":"paragraph","text":"$-8$ dan $10$"}],
        [{"tipe":"paragraph","text":"$8$ dan $10$"}],
        [{"tipe":"paragraph","text":"$6$ dan $12$"}],
        [{"tipe":"paragraph","text":"$-6$ dan $12$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari persamaan elips $\\frac{x^2}{25} + \\frac{y^2}{16} = 1$, diperoleh $a^2 = 25 \\implies a = 5$ dan $b^2 = 16 \\implies b = 4$." },
        { "tipe": "paragraph", "text": "Panjang sumbu mayor = $2a = 2(5) = 10$." },
        { "tipe": "paragraph", "text": "Panjang sumbu minor = $2b = 2(4) = 8$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Koordinat fokus pada persamaan elips $5x^2 + y^2 - 10x + 4y + 4 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-1, -2)$ dan $(-1, -4)$"}],
        [{"tipe":"paragraph","text":"$(1, -1)$ dan $(1, 4)$"}],
        [{"tipe":"paragraph","text":"$(1, 0)$ dan $(1, -4)$"}],
        [{"tipe":"paragraph","text":"$(-1, -2)$ dan $(3, 2)$"}],
        [{"tipe":"paragraph","text":"$(1, -2)$ dan $(-3, 2)$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah ke bentuk baku elips dengan melengkapi kuadrat sempurna:" },
        { "tipe": "formula_block", "latex": "5(x^2 - 2x) + (y^2 + 4y) = -4" },
        { "tipe": "formula_block", "latex": "5((x-1)^2 - 1) + ((y+2)^2 - 4) = -4" },
        { "tipe": "formula_block", "latex": "5(x-1)^2 + (y+2)^2 = 5 \\implies \\frac{(x-1)^2}{1} + \\frac{(y+2)^2}{5} = 1" },
        { "tipe": "paragraph", "text": "Diperoleh pusat $(1,-2)$, $a^2 = 5$ (elips vertikal), dan $b^2 = 1$." },
        { "tipe": "paragraph", "text": "Nilai $c = \\sqrt{a^2 - b^2} = \\sqrt{5 - 1} = \\sqrt{4} = 2$." },
        { "tipe": "paragraph", "text": "Fokus elips vertikal: $(1, -2 \\pm 2) \\implies (1, 0)$ dan $(1, -4)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan asimtot dari hiperbola $4x^2 - 9y^2 = 36$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = \\frac{2}{3}x$ dan $y = -\\frac{2}{3}x$"}],
        [{"tipe":"paragraph","text":"$y = \\frac{3}{2}x$ dan $y = -\\frac{3}{2}x$"}],
        [{"tipe":"paragraph","text":"$y = 2x$ dan $y = -2x$"}],
        [{"tipe":"paragraph","text":"$y = 3x$ dan $y = -3x$"}],
        [{"tipe":"paragraph","text":"$y = x$ dan $y = -x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi kedua ruas dengan 36 untuk memperoleh bentuk baku: $\\frac{x^2}{9} - \\frac{y^2}{4} = 1$." },
        { "tipe": "paragraph", "text": "Hiperbola horizontal dengan $a^2 = 9 \\implies a = 3$ dan $b^2 = 4 \\implies b = 2$." },
        { "tipe": "paragraph", "text": "Persamaan asimtot hiperbola horizontal: $y = \\pm \\frac{b}{a}x = \\pm \\frac{2}{3}x$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik fokus pada persamaan hiperbola $\\frac{(x-2)^2}{16} - \\frac{(y+1)^2}{9} = 1$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(7,1)$ dan $(3,1)$"}],
        [{"tipe":"paragraph","text":"$(-7,1)$ dan $(3,-1)$"}],
        [{"tipe":"paragraph","text":"$(7,-1)$ dan $(-3,-1)$"}],
        [{"tipe":"paragraph","text":"$(3,-1)$ dan $(-3,-1)$"}],
        [{"tipe":"paragraph","text":"$(-3,-1)$ dan $(3,-1)$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari persamaan hiperbola horizontal, diperoleh pusat $(2, -1)$, $a^2 = 16 \\implies a = 4$, dan $b^2 = 9 \\implies b = 3$." },
        { "tipe": "formula_block", "latex": "c^2 = a^2 + b^2 = 16 + 9 = 25 \\implies c = 5" },
        { "tipe": "paragraph", "text": "Koordinat fokus: $(a \\pm c, b) = (2 \\pm 5, -1) \\implies (7, -1)$ dan $(-3, -1)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung hiperbola $\\frac{x^2}{25} - \\frac{y^2}{9} = 1$ yang sejajar dengan garis $y - 2x + 4 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = 2x \\pm 3\\sqrt{15}$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm 5\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm \\sqrt{91}$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm 5$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm 3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis $y - 2x + 4 = 0 \\implies y = 2x - 4$, sehingga gradiennya $m = 2$." },
        { "tipe": "paragraph", "text": "Hiperbola $\\frac{x^2}{25} - \\frac{y^2}{9} = 1$ memiliki $a^2 = 25$ dan $b^2 = 9$." },
        { "tipe": "paragraph", "text": "Rumus garis singgung hiperbola dengan gradien $m$: $y = mx \\pm \\sqrt{a^2 m^2 - b^2}$." },
        { "tipe": "formula_block", "latex": "y = 2x \\pm \\sqrt{25(2)^2 - 9} = 2x \\pm \\sqrt{100 - 9} = 2x \\pm \\sqrt{91}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tentukan persamaan garis singgung pada parabola $y^2 = -8(x-3)$ yang sejajar dengan garis $4x - 2y + 7 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = -x - 7$"}],
        [{"tipe":"paragraph","text":"$y = x + 7$"}],
        [{"tipe":"paragraph","text":"$y = x - 7$"}],
        [{"tipe":"paragraph","text":"$y = 2x - 7$"}],
        [{"tipe":"paragraph","text":"$y = -2x - 7$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis $4x - 2y + 7 = 0 \\implies y = 2x + \\frac{7}{2}$, gradien $m = 2$." },
        { "tipe": "paragraph", "text": "Parabola $(y-0)^2 = -8(x-3)$, puncak $(a,b) = (3,0)$ dan $4p = -8 \\implies p = -2$." },
        { "tipe": "paragraph", "text": "Garis singgung parabola horizontal dengan gradien $m$: $y - b = m(x - a) + \\frac{p}{m}$." },
        { "tipe": "formula_block", "latex": "y - 0 = 2(x - 3) + \\frac{-2}{2} \\implies y = 2x - 6 - 1 = 2x - 7" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
