{
  "id": "bs-k12-mat-lanjut-sedang-04",
  "nama": "Bank Soal Sedang - Paket 4",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SEDANG",
  "deskripsi": "Bilangan kompleks lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{1 + i}{1 - i}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$i$"}],
        [{"tipe":"paragraph","text":"$-i$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$1 + i$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan konjugat penyebut:" },
        { "tipe": "formula_block", "latex": "\\dfrac{1+i}{1-i} \\cdot \\dfrac{1+i}{1+i} = \\dfrac{(1+i)^2}{1 - i^2} = \\dfrac{1 + 2i - 1}{2} = \\dfrac{2i}{2} = i" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $i$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modulus dari $z = 1 + i\\sqrt{3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|z| = \\sqrt{1 + 3} = 2" },
        { "tipe": "paragraph", "text": "Jadi, modulusnya 2." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Argumen dari $z = 1 + i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$30°$"}],
        [{"tipe":"paragraph","text":"$45°$"}],
        [{"tipe":"paragraph","text":"$60°$"}],
        [{"tipe":"paragraph","text":"$90°$"}],
        [{"tipe":"paragraph","text":"$0°$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\tan\\theta = \\dfrac{1}{1} = 1 \\Rightarrow \\theta = 45°" },
        { "tipe": "paragraph", "text": "Jadi, argumennya $45°$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk polar dari $z = 1 + i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sqrt{2}(\\cos 45° + i\\sin 45°)$"}],
        [{"tipe":"paragraph","text":"$2(\\cos 45° + i\\sin 45°)$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}(\\cos 30° + i\\sin 30°)$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}(\\cos 60° + i\\sin 60°)$"}],
        [{"tipe":"paragraph","text":"$1(\\cos 45° + i\\sin 45°)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|z| = \\sqrt{2}, \\quad \\theta = 45°" },
        { "tipe": "formula_block", "latex": "z = \\sqrt{2}(\\cos 45° + i\\sin 45°)" },
        { "tipe": "paragraph", "text": "Jadi, bentuk polarnya $\\sqrt{2}(\\cos 45° + i\\sin 45°)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(1 + i)^4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$4i$"}],
        [{"tipe":"paragraph","text":"$-4i$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(1+i)^2 = 2i$, maka $(1+i)^4 = (2i)^2 = 4i^2 = -4$." },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $-4$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modulus dari $z = 3 - 4i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$25$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|z| = \\sqrt{9 + 16} = 5" },
        { "tipe": "paragraph", "text": "Jadi, modulusnya 5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Argumen dari $z = i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0°$"}],
        [{"tipe":"paragraph","text":"$45°$"}],
        [{"tipe":"paragraph","text":"$90°$"}],
        [{"tipe":"paragraph","text":"$180°$"}],
        [{"tipe":"paragraph","text":"$270°$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$z = i = 0 + 1i$, maka $\\tan\\theta = \\dfrac{1}{0} \\to \\theta = 90°$." },
        { "tipe": "paragraph", "text": "Jadi, argumennya $90°$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $i^{100}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$i$"}],
        [{"tipe":"paragraph","text":"$-i$"}],
        [{"tipe":"paragraph","text":"$0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$i^{100} = (i^4)^{25} = 1^{25} = 1$." },
        { "tipe": "paragraph", "text": "Jadi, hasilnya 1." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2 + 3i) + \\overline{(2 + 3i)}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6i$"}],
        [{"tipe":"paragraph","text":"$-6i$"}],
        [{"tipe":"paragraph","text":"$4 + 6i$"}],
        [{"tipe":"paragraph","text":"$0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\overline{2+3i} = 2 - 3i$." },
        { "tipe": "formula_block", "latex": "(2+3i) + (2-3i) = 4" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya 4." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-mat-lanjut-sedang-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $z \\cdot \\bar{z}$ dengan $z = 3 + 4i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$25$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$16$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "z \\cdot \\bar{z} = (3+4i)(3-4i) = 9 - 16i^2 = 9 + 16 = 25" },
        { "tipe": "paragraph", "text": "Sifat: $z \\cdot \\bar{z} = |z|^2 = 25$. Jadi, hasilnya 25." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
