{
  "id": "bs-k12-mat-lanjut-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Vektor 3D: proyeksi ortogonal & sudut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = (3, 4)$ dan $\\vec{b} = (1, 0)$. Proyeksi ortogonal vektor $\\vec{a}$ pada vektor $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(3, 0)$"}],
        [{"tipe":"paragraph","text":"$(4, 0)$"}],
        [{"tipe":"paragraph","text":"$(0, 3)$"}],
        [{"tipe":"paragraph","text":"$(0, 4)$"}],
        [{"tipe":"paragraph","text":"$(1, 0)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus proyeksi ortogonal $\\vec{a}$ pada $\\vec{b}$: $\\vec{p} = \\dfrac{\\vec{a} \\cdot \\vec{b}}{|\\vec{b}|^2} \\vec{b}$." },
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 3(1) + 4(0) = 3, \\quad |\\vec{b}|^2 = 1" },
        { "tipe": "formula_block", "latex": "\\vec{p} = \\dfrac{3}{1} (1, 0) = (3, 0)" },
        { "tipe": "paragraph", "text": "Jadi, proyeksi ortogonalnya adalah $(3, 0)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = (1, 2)$ dan $\\vec{b} = (2, 1)$. Proyeksi ortogonal $\\vec{a}$ pada $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{8}{5}, \\dfrac{4}{5}\\right)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{4}{5}, \\dfrac{8}{5}\\right)$"}],
        [{"tipe":"paragraph","text":"$(2, 1)$"}],
        [{"tipe":"paragraph","text":"$(1, 2)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{6}{5}, \\dfrac{3}{5}\\right)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 1(2) + 2(1) = 4, \\quad |\\vec{b}|^2 = 4 + 1 = 5" },
        { "tipe": "formula_block", "latex": "\\vec{p} = \\dfrac{4}{5}(2, 1) = \\left(\\dfrac{8}{5}, \\dfrac{4}{5}\\right)" },
        { "tipe": "paragraph", "text": "Jadi, proyeksinya adalah $\\left(\\dfrac{8}{5}, \\dfrac{4}{5}\\right)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sudut antara vektor $\\vec{a} = (1, 1, 1)$ dan $\\vec{b} = (1, -1, 0)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$30°$"}],
        [{"tipe":"paragraph","text":"$45°$"}],
        [{"tipe":"paragraph","text":"$60°$"}],
        [{"tipe":"paragraph","text":"$90°$"}],
        [{"tipe":"paragraph","text":"$120°$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 1(1) + 1(-1) + 1(0) = 0" },
        { "tipe": "paragraph", "text": "Karena $\\vec{a} \\cdot \\vec{b} = 0$, maka $\\cos\\theta = 0 \\Rightarrow \\theta = 90°$." },
        { "tipe": "paragraph", "text": "Jadi, sudutnya adalah $90°$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = (2, -1, 2)$ dan $\\vec{b} = (1, 2, 2)$. Nilai $\\cos \\theta$ antara $\\vec{a}$ dan $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{9}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{9}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 2(1) + (-1)(2) + 2(2) = 2 - 2 + 4 = 4" },
        { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{4 + 1 + 4} = 3, \\quad |\\vec{b}| = \\sqrt{1 + 4 + 4} = 3" },
        { "tipe": "formula_block", "latex": "\\cos\\theta = \\dfrac{4}{3 \\cdot 3} = \\dfrac{4}{9}" },
        { "tipe": "paragraph", "text": "Jadi, $\\cos\\theta = \\dfrac{4}{9}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Proyeksi skalar $\\vec{a} = (3, 0, 4)$ pada $\\vec{b} = (1, 0, 0)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{5}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 3(1) + 0 + 0 = 3, \\quad |\\vec{b}| = 1" },
        { "tipe": "formula_block", "latex": "\\text{proyeksi skalar} = \\dfrac{3}{1} = 3" },
        { "tipe": "paragraph", "text": "Jadi, proyeksi skalarnya adalah 3." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Proyeksi ortogonal vektor $\\vec{a} = (3, 4)$ pada vektor $\\vec{b} = (1, 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{7}{2}, \\dfrac{7}{2}\\right)$"}],
        [{"tipe":"paragraph","text":"$(7, 7)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{3}{2}, \\dfrac{3}{2}\\right)$"}],
        [{"tipe":"paragraph","text":"$(3, 4)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{7}{4}, \\dfrac{7}{4}\\right)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 3 + 4 = 7, \\quad |\\vec{b}|^2 = 2" },
        { "tipe": "formula_block", "latex": "\\vec{p} = \\dfrac{7}{2}(1, 1) = \\left(\\dfrac{7}{2}, \\dfrac{7}{2}\\right)" },
        { "tipe": "paragraph", "text": "Jadi, proyeksinya adalah $\\left(\\dfrac{7}{2}, \\dfrac{7}{2}\\right)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\vec{a} = (1, 2, 2)$ dan $\\vec{b} = (2, 1, -2)$, maka $\\cos\\theta$ antara keduanya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 1(2) + 2(1) + 2(-2) = 2 + 2 - 4 = 0" },
        { "tipe": "paragraph", "text": "Karena hasil kali titik = 0, maka $\\cos\\theta = 0$ (kedua vektor tegak lurus)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = (2, 3)$ dan $\\vec{b} = (1, 2)$. Proyeksi ortogonal $\\vec{a}$ pada $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{8}{5}, \\dfrac{16}{5}\\right)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{16}{5}, \\dfrac{8}{5}\\right)$"}],
        [{"tipe":"paragraph","text":"$(8, 16)$"}],
        [{"tipe":"paragraph","text":"$\\left(\\dfrac{4}{5}, \\dfrac{8}{5}\\right)$"}],
        [{"tipe":"paragraph","text":"$(2, 3)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\vec{a} \\cdot \\vec{b} = 2 + 6 = 8, \\quad |\\vec{b}|^2 = 1 + 4 = 5" },
        { "tipe": "formula_block", "latex": "\\vec{p} = \\dfrac{8}{5}(1, 2) = \\left(\\dfrac{8}{5}, \\dfrac{16}{5}\\right)" },
        { "tipe": "paragraph", "text": "Jadi, proyeksinya adalah $\\left(\\dfrac{8}{5}, \\dfrac{16}{5}\\right)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Panjang proyeksi vektor $\\vec{a} = (3, 4)$ pada vektor $\\vec{b} = (1, 0)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$25$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\text{panjang proyeksi} = \\dfrac{|\\vec{a} \\cdot \\vec{b}|}{|\\vec{b}|} = \\dfrac{|3(1) + 4(0)|}{1} = 3" },
        { "tipe": "paragraph", "text": "Jadi, panjang proyeksinya adalah 3." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = (1, 0)$ dan $\\vec{b} = (1, 1)$. Sudut antara $\\vec{a}$ dan $\\vec{b}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0°$"}],
        [{"tipe":"paragraph","text":"$30°$"}],
        [{"tipe":"paragraph","text":"$45°$"}],
        [{"tipe":"paragraph","text":"$60°$"}],
        [{"tipe":"paragraph","text":"$90°$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\cos\\theta = \\dfrac{1 \\cdot 1 + 0 \\cdot 1}{1 \\cdot \\sqrt{2}} = \\dfrac{1}{\\sqrt{2}} = \\dfrac{\\sqrt{2}}{2}" },
        { "tipe": "formula_block", "latex": "\\theta = 45°" },
        { "tipe": "paragraph", "text": "Jadi, sudutnya $45°$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
