{
  "id": "bs-k12-mat-lanjut-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Polinomial lanjutan & teorema Vieta",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(x) = x^3 - 4x^2 + x + 6$ memiliki akar-akar $x_1, x_2, x_3$. Nilai $x_1 x_2 + x_2 x_3 + x_1 x_3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$-6$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta untuk polinomial derajat 3: $x_1 x_2 + x_2 x_3 + x_1 x_3 = \\dfrac{c}{a}$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{1} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilainya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2, x_3$ akar-akar dari $x^3 - 6x^2 + 11x - 6 = 0$, maka $x_1 \\cdot x_2 \\cdot x_3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$-6$"}],
        [{"tipe":"paragraph","text":"$11$"}],
        [{"tipe":"paragraph","text":"$-11$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 x_2 x_3 = -\\dfrac{d}{a} = -\\dfrac{-6}{1} = 6$." },
        { "tipe": "paragraph", "text": "Jadi, hasilnya 6." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar dari $P(x) = x^4 - 5x^2 + 4 = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $u = x^2$: $u^2 - 5u + 4 = 0 \\Rightarrow (u-1)(u-4) = 0$." },
        { "tipe": "paragraph", "text": "$x^2 = 1$ → $x = \\pm 1$; $x^2 = 4$ → $x = \\pm 2$." },
        { "tipe": "paragraph", "text": "Jadi, akar-akarnya $\\pm 1, \\pm 2$. Salah satunya $-2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^3 - 3x^2 - 4x + 12$, maka banyak akar real $P(x) = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$0$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 2$: $8 - 12 - 8 + 12 = 0$ → $(x-2)$ faktor." },
        { "tipe": "formula_block", "latex": "P(x) = (x-2)(x^2 - x - 6) = (x-2)(x-3)(x+2)" },
        { "tipe": "paragraph", "text": "Akar-akarnya: $2, 3, -2$. Ada 3 akar real." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(x) = x^4 - 3x^3 + 2x^2 + ax + b$ habis dibagi oleh $(x^2 - 1)$, maka nilai $a + b$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$-2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x^2 - 1)$ faktor → $P(1) = 0$ dan $P(-1) = 0$." },
        { "tipe": "formula_block", "latex": "P(1) = 1 - 3 + 2 + a + b = a + b = 0" },
        { "tipe": "formula_block", "latex": "P(-1) = 1 + 3 + 2 - a + b = 6 - a + b = 0 \\Rightarrow -a + b = -6" },
        { "tipe": "paragraph", "text": "Selesaikan: $a + b = 0$, $-a + b = -6$ → $b = -3, a = 3$." },
        { "tipe": "paragraph", "text": "Jadi, $a + b = 3 + (-3) = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ akar $x^2 - 5x + 6 = 0$, maka $x_1^3 + x_2^3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$35$"}],
        [{"tipe":"paragraph","text":"$55$"}],
        [{"tipe":"paragraph","text":"$65$"}],
        [{"tipe":"paragraph","text":"$95$"}],
        [{"tipe":"paragraph","text":"$125$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 + x_2 = 5$, $x_1 x_2 = 6$." },
        { "tipe": "formula_block", "latex": "x_1^3 + x_2^3 = (x_1 + x_2)^3 - 3x_1 x_2 (x_1 + x_2)" },
        { "tipe": "formula_block", "latex": "= 125 - 3 \\cdot 6 \\cdot 5 = 125 - 90 = 35" },
        { "tipe": "paragraph", "text": "Jadi, $x_1^3 + x_2^3 = 35$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(x - 2)$ faktor dari $P(x) = x^3 - 5x^2 + ax - 6$, maka nilai $a$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$10$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(2) = 0$:" },
        { "tipe": "formula_block", "latex": "8 - 20 + 2a - 6 = 2a - 18 = 0 \\Rightarrow a = 9" },
        { "tipe": "paragraph", "text": "Jadi, $a = 9$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2, x_3$ akar $x^3 - 2x^2 - x + 2 = 0$, maka $x_1 + x_2 + x_3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$-1$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 + x_2 + x_3 = -\\dfrac{b}{a} = -\\dfrac{-2}{1} = 2$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah akarnya 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^3 - 4x^2 + 5x - 2$ oleh $(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 8 - 16 + 10 - 2 = 0" },
        { "tipe": "paragraph", "text": "Jadi, sisanya 0." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2, x_3$ akar $x^3 - 3x^2 + 2x - 6 = 0$, maka hasil kali akar-akarnya adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-6$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 x_2 x_3 = -\\dfrac{d}{a} = -\\dfrac{-6}{1} = 6$." },
        { "tipe": "paragraph", "text": "Jadi, hasil kalinya 6." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
