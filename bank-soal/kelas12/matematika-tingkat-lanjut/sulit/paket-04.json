{
  "id": "bs-k12-mat-lanjut-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Transformasi geometri lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(1, 2)$ oleh rotasi $90°$ berlawanan arah jarum jam terhadap $O$ dilanjutkan refleksi sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-2, -1)$"}],
        [{"tipe":"paragraph","text":"$(2, 1)$"}],
        [{"tipe":"paragraph","text":"$(-2, 1)$"}],
        [{"tipe":"paragraph","text":"$(2, -1)$"}],
        [{"tipe":"paragraph","text":"$(-1, -2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Langkah 1 — Rotasi $90°$ CCW terhadap $A(1, 2)$: $(x, y) \\to (-y, x)$, sehingga $A_1 = (-2, 1)$." },
        { "tipe": "paragraph", "text": "Langkah 2 — Refleksi sumbu-$x$ terhadap $A_1$: $(x, y) \\to (x, -y)$, sehingga $A_2 = (-2, -1)$." },
        { "tipe": "paragraph", "text": "Verifikasi dengan matriks komposisi:" },
        { "tipe": "formula_block", "latex": "M = R_{\\text{refl}} \\cdot R_{\\text{rot}} = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix} \\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix} = \\begin{pmatrix} 0 & -1 \\\\ -1 & 0 \\end{pmatrix}" },
        { "tipe": "formula_block", "latex": "A' = \\begin{pmatrix} 0 & -1 \\\\ -1 & 0 \\end{pmatrix} \\begin{pmatrix} 1 \\\\ 2 \\end{pmatrix} = \\begin{pmatrix} -2 \\\\ -1 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, bayangan akhirnya adalah $(-2, -1)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(3, 1)$ oleh refleksi garis $y = x$ dilanjutkan rotasi $180°$ terhadap $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-1, -3)$"}],
        [{"tipe":"paragraph","text":"$(1, 3)$"}],
        [{"tipe":"paragraph","text":"$(-3, -1)$"}],
        [{"tipe":"paragraph","text":"$(3, -1)$"}],
        [{"tipe":"paragraph","text":"$(-1, 3)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Langkah 1 — Refleksi garis $y = x$: $A_1 = (1, 3)$." },
        { "tipe": "paragraph", "text": "Langkah 2 — Rotasi $180°$: $A_2 = (-1, -3)$." },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(-1, -3)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(2, 5)$ oleh dilatasi pusat $O$ skala $3$ dilanjutkan translasi $T = \\begin{pmatrix} -1 \\\\ 2 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(5, 17)$"}],
        [{"tipe":"paragraph","text":"$(6, 15)$"}],
        [{"tipe":"paragraph","text":"$(5, 15)$"}],
        [{"tipe":"paragraph","text":"$(6, 17)$"}],
        [{"tipe":"paragraph","text":"$(7, 17)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Langkah 1 — Dilatasi skala 3: $A_1 = (6, 15)$." },
        { "tipe": "paragraph", "text": "Langkah 2 — Translasi: $A_2 = (6 - 1, 15 + 2) = (5, 17)$." },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(5, 17)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Komposisi dua rotasi $90°$ CCW terhadap $O$ ekuivalen dengan ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"rotasi $180°$"}],
        [{"tipe":"paragraph","text":"rotasi $90°$"}],
        [{"tipe":"paragraph","text":"refleksi sumbu-$x$"}],
        [{"tipe":"paragraph","text":"refleksi sumbu-$y$"}],
        [{"tipe":"paragraph","text":"identitas"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix}^2 = \\begin{pmatrix} -1 & 0 \\\\ 0 & -1 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Matriks $\\begin{pmatrix} -1 & 0 \\\\ 0 & -1 \\end{pmatrix}$ adalah matriks rotasi $180°$." },
        { "tipe": "paragraph", "text": "Jadi, komposisinya setara dengan rotasi $180°$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(4, 2)$ oleh refleksi garis $y = -x$ dilanjutkan rotasi $90°$ CCW terhadap $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(4, -2)$"}],
        [{"tipe":"paragraph","text":"$(2, -4)$"}],
        [{"tipe":"paragraph","text":"$(-2, 4)$"}],
        [{"tipe":"paragraph","text":"$(-4, -2)$"}],
        [{"tipe":"paragraph","text":"$(-2, -4)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Langkah 1 — Refleksi $y = -x$: $(x, y) \\to (-y, -x)$, sehingga $A_1 = (-2, -4)$." },
        { "tipe": "paragraph", "text": "Langkah 2 — Rotasi $90°$ CCW: $(x, y) \\to (-y, x)$, sehingga $A_2 = (4, -2)$." },
        { "tipe": "paragraph", "text": "Verifikasi dengan matriks komposisi:" },
        { "tipe": "formula_block", "latex": "M = R_{\\text{rot}} \\cdot R_{\\text{refl}} = \\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix} \\begin{pmatrix} 0 & -1 \\\\ -1 & 0 \\end{pmatrix} = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}" },
        { "tipe": "formula_block", "latex": "A' = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix} \\begin{pmatrix} 4 \\\\ 2 \\end{pmatrix} = \\begin{pmatrix} 4 \\\\ -2 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, bayangan akhirnya $(4, -2)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(1, 2)$ oleh refleksi sumbu-$x$ dilanjutkan refleksi sumbu-$y$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-1, -2)$"}],
        [{"tipe":"paragraph","text":"$(1, -2)$"}],
        [{"tipe":"paragraph","text":"$(-1, 2)$"}],
        [{"tipe":"paragraph","text":"$(1, 2)$"}],
        [{"tipe":"paragraph","text":"$(-2, -1)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Langkah 1 — Refleksi sumbu-$x$: $A_1 = (1, -2)$." },
        { "tipe": "paragraph", "text": "Langkah 2 — Refleksi sumbu-$y$: $A_2 = (-1, -2)$." },
        { "tipe": "paragraph", "text": "Ini ekuivalen dengan rotasi $180°$. Jadi, bayangannya $(-1, -2)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(3, -2)$ oleh translasi $T_1 = \\begin{pmatrix} 2 \\\\ 1 \\end{pmatrix}$ dilanjutkan $T_2 = \\begin{pmatrix} -1 \\\\ 3 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(4, 2)$"}],
        [{"tipe":"paragraph","text":"$(4, 3)$"}],
        [{"tipe":"paragraph","text":"$(5, 2)$"}],
        [{"tipe":"paragraph","text":"$(5, 3)$"}],
        [{"tipe":"paragraph","text":"$(3, 2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Translasi gabungan: $T = T_1 + T_2 = (2-1, 1+3) = (1, 4)$." },
        { "tipe": "formula_block", "latex": "A' = (3 + 1, -2 + 4) = (4, 2)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(4, 2)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(2, 4)$ oleh rotasi $180°$ terhadap $O$ dilanjutkan dilatasi skala $2$ terhadap $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-4, -8)$"}],
        [{"tipe":"paragraph","text":"$(4, 8)$"}],
        [{"tipe":"paragraph","text":"$(-4, 8)$"}],
        [{"tipe":"paragraph","text":"$(4, -8)$"}],
        [{"tipe":"paragraph","text":"$(-2, -4)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Langkah 1 — Rotasi $180°$: $A_1 = (-2, -4)$." },
        { "tipe": "paragraph", "text": "Langkah 2 — Dilatasi skala 2: $A_2 = (-4, -8)$." },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(-4, -8)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Komposisi refleksi terhadap garis $y = x$ dilanjutkan refleksi terhadap sumbu-$x$ adalah matriks ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 1 \\\\ -1 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Matriks refleksi $y = x$: $R_1 = \\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix}$." },
        { "tipe": "paragraph", "text": "Matriks refleksi sumbu-$x$: $R_2 = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix}$." },
        { "tipe": "paragraph", "text": "Komposisi (refleksi $y = x$ DILANJUTKAN refleksi sumbu-$x$) $\\to R_2 \\cdot R_1$." },
        { "tipe": "formula_block", "latex": "R_2 \\cdot R_1 = \\begin{pmatrix} 1 & 0 \\\\ 0 & -1 \\end{pmatrix} \\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix} = \\begin{pmatrix} 0 & 1 \\\\ -1 & 0 \\end{pmatrix}" },
        { "tipe": "paragraph", "text": "Jadi, matriksnya $\\begin{pmatrix} 0 & 1 \\\\ -1 & 0 \\end{pmatrix}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(5, 0)$ oleh rotasi $90°$ searah jarum jam terhadap $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(0, -5)$"}],
        [{"tipe":"paragraph","text":"$(0, 5)$"}],
        [{"tipe":"paragraph","text":"$(-5, 0)$"}],
        [{"tipe":"paragraph","text":"$(5, 0)$"}],
        [{"tipe":"paragraph","text":"$(-5, -5)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rotasi $90°$ CW: $(x, y) \\to (y, -x)$." },
        { "tipe": "formula_block", "latex": "A' = (0, -5)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(0, -5)$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
