{
  "id": "bs-k12-mat-lanjut-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "SULIT",
  "deskripsi": "Kalkulus lanjutan, matriks, dan geometri analitik",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim_{x \\to \\frac{\\pi}{4}} \\frac{\\cos 2x}{\\cos x - \\sin x}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\frac{1}{2}\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas sudut rangkap kosinus $\\cos 2x = \\cos^2 x - \\sin^2 x = (\\cos x - \\sin x)(\\cos x + \\sin x)$:" },
        { "tipe": "formula_block", "latex": "\\lim_{x \\to \\frac{\\pi}{4}} \\frac{(\\cos x - \\sin x)(\\cos x + \\sin x)}{\\cos x - \\sin x}" },
        { "tipe": "paragraph", "text": "Sederhanakan pembuat nol pada pembilang dan penyebut:" },
        { "tipe": "formula_block", "latex": "= \\lim_{x \\to \\frac{\\pi}{4}} (\\cos x + \\sin x) = \\frac{1}{2}\\sqrt{2} + \\frac{1}{2}\\sqrt{2} = \\sqrt{2}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $A = \\begin{pmatrix} 2 & -1 \\\\ 3 & 4 \\end{pmatrix}$ dan $B = \\begin{pmatrix} 5 & 2 \\\\ -3 & 1 \\end{pmatrix}$. Determinan dari matriks $AB$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$11$"}],
        [{"tipe":"paragraph","text":"$22$"}],
        [{"tipe":"paragraph","text":"$44$"}],
        [{"tipe":"paragraph","text":"$121$"}],
        [{"tipe":"paragraph","text":"$242$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat determinan $\\det(AB) = \\det(A) \\cdot \\det(B)$:" },
        { "tipe": "formula_block", "latex": "\\det(A) = (2)(4) - (-1)(3) = 8 + 3 = 11" },
        { "tipe": "formula_block", "latex": "\\det(B) = (5)(1) - (2)(-3) = 5 + 6 = 11" },
        { "tipe": "formula_block", "latex": "\\det(AB) = 11 \\cdot 11 = 121" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan garis singgung hiperbola $\\frac{x^2}{16} - \\frac{y^2}{9} = 1$ yang sejajar dengan garis $2x - y + 5 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = 2x \\pm \\sqrt{55}$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm \\sqrt{73}$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm 5$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm 7$"}],
        [{"tipe":"paragraph","text":"$y = 2x \\pm \\sqrt{7}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Garis $2x - y + 5 = 0 \\implies y = 2x + 5$, sehingga gradien $m = 2$." },
        { "tipe": "paragraph", "text": "Hiperbola $\\frac{x^2}{16} - \\frac{y^2}{9} = 1$ memiliki nilai $a^2 = 16$ dan $b^2 = 9$." },
        { "tipe": "paragraph", "text": "Gunakan rumus garis singgung hiperbola $y = mx \\pm \\sqrt{a^2m^2 - b^2}$:" },
        { "tipe": "formula_block", "latex": "y = 2x \\pm \\sqrt{16(2)^2 - 9} = 2x \\pm \\sqrt{64 - 9} = 2x \\pm \\sqrt{55}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Turunan pertama dari fungsi $f(x) = \\sin^3(2x^2 - 1)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$12x \\sin^2(2x^2-1) \\cos(2x^2-1)$"}],
        [{"tipe":"paragraph","text":"$6x \\sin^2(2x^2-1) \\cos(2x^2-1)$"}],
        [{"tipe":"paragraph","text":"$3 \\sin^2(2x^2-1) \\cos(2x^2-1)$"}],
        [{"tipe":"paragraph","text":"$12x \\sin(2x^2-1) \\cos^2(2x^2-1)$"}],
        [{"tipe":"paragraph","text":"$24x \\sin^2(2x^2-1) \\cos(2x^2-1)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan rantai bertingkat:" },
        { "tipe": "paragraph", "text": "Misalkan $u = \\sin(2x^2-1)$, maka $f(x) = u^3 \\implies f'(x) = 3u^2 \\cdot u'$." },
        { "tipe": "paragraph", "text": "Turunan dari $u$: $u' = \\cos(2x^2-1) \\cdot \\frac{d}{dx}(2x^2-1) = 4x \\cos(2x^2-1)$." },
        { "tipe": "formula_block", "latex": "f'(x) = 3\\sin^2(2x^2-1) \\cdot 4x\\cos(2x^2-1) = 12x \\sin^2(2x^2-1) \\cos(2x^2-1)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim_{x \\to 0} \\frac{1 - \\cos 4x}{x \\tan 2x}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$16$"}],
        [{"tipe":"paragraph","text":"$32$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah $1 - \\cos 4x$ menggunakan identitas trigonometri $1 - \\cos 2A = 2\\sin^2 A$:" },
        { "tipe": "formula_block", "latex": "1 - \\cos 4x = 2\\sin^2 2x" },
        { "tipe": "paragraph", "text": "Substitusikan ke dalam limit dan pisahkan pecahan:" },
        { "tipe": "formula_block", "latex": "\\lim_{x \\to 0} \\frac{2\\sin^2 2x}{x \\tan 2x} = 2 \\cdot \\lim_{x \\to 0} \\left( \\frac{\\sin 2x}{x} \\right) \\cdot \\lim_{x \\to 0} \\left( \\frac{\\sin 2x}{\\tan 2x} \\right)" },
        { "tipe": "paragraph", "text": "Hitung masing-masing nilai limit:" },
        { "tipe": "formula_block", "latex": "= 2 \\cdot 2 \\cdot 1 = 4" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan parabola dengan puncak di $(2, -3)$ dan fokus di $(2, 1)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x-2)^2 = 16(y+3)$"}],
        [{"tipe":"paragraph","text":"$(x-2)^2 = 8(y+3)$"}],
        [{"tipe":"paragraph","text":"$(y+3)^2 = 16(x-2)$"}],
        [{"tipe":"paragraph","text":"$(y+3)^2 = 8(x-2)$"}],
        [{"tipe":"paragraph","text":"$(x+2)^2 = 16(y-3)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Puncak $(2, -3)$ dan fokus $(2, 1)$ memiliki absis sama, maka parabola terbuka ke atas secara vertikal." },
        { "tipe": "paragraph", "text": "Hitung jarak puncak ke fokus ($p$):" },
        { "tipe": "formula_block", "latex": "p = 1 - (-3) = 4" },
        { "tipe": "paragraph", "text": "Gunakan bentuk umum parabola vertikal $(x-a)^2 = 4p(y-b)$:" },
        { "tipe": "formula_block", "latex": "(x-2)^2 = 4(4)(y - (-3)) \\implies (x-2)^2 = 16(y+3)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = x^3 - 3x^2 + 4$. Persamaan garis singgung kurva $y = f(x)$ di titik yang berabsis $x = 2$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$y = 0$"}],
        [{"tipe":"paragraph","text":"$y = 4$"}],
        [{"tipe":"paragraph","text":"$y = 2x - 4$"}],
        [{"tipe":"paragraph","text":"$y = -2x + 4$"}],
        [{"tipe":"paragraph","text":"$y = x + 2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung ordinat titik singgung untuk $x = 2$:" },
        { "tipe": "formula_block", "latex": "f(2) = 2^3 - 3(2)^2 + 4 = 8 - 12 + 4 = 0 \\implies (2, 0)" },
        { "tipe": "paragraph", "text": "Hitung gradien $m = f'(2)$:" },
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x \\implies m = 3(2)^2 - 6(2) = 12 - 12 = 0" },
        { "tipe": "paragraph", "text": "Persamaan garis singgung:" },
        { "tipe": "formula_block", "latex": "y - 0 = 0(x - 2) \\implies y = 0" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\det(A) = 2$ dan $A$ adalah matriks berordo $3 \\times 3$, maka nilai dari $\\det(3A)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$18$"}],
        [{"tipe":"paragraph","text":"$24$"}],
        [{"tipe":"paragraph","text":"$54$"}],
        [{"tipe":"paragraph","text":"$216$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat determinan perkalian skalar matriks ordo $n \\times n$, yaitu $\\det(kA) = k^n \\det(A)$:" },
        { "tipe": "paragraph", "text": "Untuk $n = 3$ dan $k = 3$:" },
        { "tipe": "formula_block", "latex": "\\det(3A) = 3^3 \\cdot \\det(A) = 27 \\cdot 2 = 54" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim_{x \\to \\infty} \\left(\\sqrt{x^2 + 6x - 2} - \\sqrt{x^2 - 2x + 3}\\right)$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat limit tak hingga bentuk akar $\\frac{b-d}{2\\sqrt{a}}$:" },
        { "tipe": "formula_block", "latex": "L = \\frac{6 - (-2)}{2\\sqrt{1}} = \\frac{8}{2} = 4" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-mat-lanjut-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui kurva $y = x^3 - 3x^2 + 2$. Titik stasioner (titik kritis) dari kurva tersebut adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(0, 2)$ dan $(2, -2)$"}],
        [{"tipe":"paragraph","text":"$(0, 2)$ dan $(2, 2)$"}],
        [{"tipe":"paragraph","text":"$(1, 0)$ dan $(2, -2)$"}],
        [{"tipe":"paragraph","text":"$(0, 0)$ dan $(2, 2)$"}],
        [{"tipe":"paragraph","text":"$(1, 2)$ dan $(3, 2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cari pembuat nol dari turunan pertama $f'(x) = 0$:" },
        { "tipe": "formula_block", "latex": "f'(x) = 3x^2 - 6x = 3x(x - 2) = 0 \\implies x = 0 \\text{ atau } x = 2" },
        { "tipe": "paragraph", "text": "Substitusikan nilai $x$ ke fungsi awal $f(x)$:" },
        { "tipe": "paragraph", "text": "• Untuk $x = 0 \\implies y = 0^3 - 3(0)^2 + 2 = 2 \\implies (0, 2)$" },
        { "tipe": "paragraph", "text": "• Untuk $x = 2 \\implies y = 2^3 - 3(2)^2 + 2 = 8 - 12 + 2 = -2 \\implies (2, -2)$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
