{
  "id": "bs-k12-mat-lanjut-mudah-08",
  "nama": "Bank Soal Mudah - Paket 8",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Vektor dasar, matriks, dan suku banyak",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui matriks $F = \\begin{pmatrix} 1 & 0 \\\\ 0 & \\frac{1}{2} \\end{pmatrix}$. Invers dari matriks $F$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & 2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 0 \\\\ 0 & -2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 2 & 0 \\\\ 0 & 1 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} -1 & 0 \\\\ 0 & -2 \\end{pmatrix}$"}],
        [{"tipe":"paragraph","text":"$\\begin{pmatrix} 1 & 2 \\\\ 0 & 0 \\end{pmatrix}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk matriks diagonal $\\begin{pmatrix} a & 0 \\\\ 0 & b \\end{pmatrix}$, inversnya adalah $\\begin{pmatrix} 1/a & 0 \\\\ 0 & 1/b \\end{pmatrix}$." },
        { "tipe": "formula_block", "latex": "F^{-1} = \\begin{pmatrix} 1/1 & 0 \\\\ 0 & 1/(1/2) \\end{pmatrix} = \\begin{pmatrix} 1 & 0 \\\\ 0 & 2 \\end{pmatrix}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\vec{AB} = \\begin{pmatrix} 2m \\\\ m+3 \\\\ m \\end{pmatrix}$. Jika panjang vektor $\\vec{AB} = 9$ satuan panjang, maka nilai $m$ yang memenuhi adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-4$ atau $-3$"}],
        [{"tipe":"paragraph","text":"$-4$ atau $3$"}],
        [{"tipe":"paragraph","text":"$-3$ atau $4$"}],
        [{"tipe":"paragraph","text":"$3$ atau $4$"}],
        [{"tipe":"paragraph","text":"$4$ atau $5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus panjang vektor R3:" },
        { "tipe": "formula_block", "latex": "\\sqrt{(2m)^2 + (m+3)^2 + m^2} = 9" },
        { "tipe": "formula_block", "latex": "4m^2 + m^2 + 6m + 9 + m^2 = 81" },
        { "tipe": "formula_block", "latex": "6m^2 + 6m - 72 = 0 \\Rightarrow m^2 + m - 12 = 0" },
        { "tipe": "formula_block", "latex": "(m+4)(m-3) = 0 \\Rightarrow m = -4 \\text{ atau } m = 3" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika matriks $A = \\begin{pmatrix} 2x+1 & 3 \\\\ 6x-1 & 5 \\end{pmatrix}$ tidak mempunyai invers, maka nilai $x = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Matriks tidak memiliki invers jika determinannya bernilai nol ( singular ):" },
        { "tipe": "formula_block", "latex": "\\det(A) = (2x+1)(5) - (3)(6x-1) = 0" },
        { "tipe": "formula_block", "latex": "10x + 5 - 18x + 3 = 0" },
        { "tipe": "formula_block", "latex": "-8x + 8 = 0 \\Rightarrow -8x = -8 \\Rightarrow x = 1" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $f(-3) + f(3)$ jika $f(x) = 3x^3 + 2x^2 - 5x - 6$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-24$"}],
        [{"tipe":"paragraph","text":"$-12$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$24$"}],
        [{"tipe":"paragraph","text":"$80$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hitung $f(-3)$ dan $f(3)$:" },
        { "tipe": "formula_block", "latex": "f(-3) = 3(-3)^3 + 2(-3)^2 - 5(-3) - 6 = -81 + 18 + 15 - 6 = -54" },
        { "tipe": "formula_block", "latex": "f(3) = 3(3)^3 + 2(3)^2 - 5(3) - 6 = 81 + 18 - 15 - 6 = 78" },
        { "tipe": "formula_block", "latex": "f(-3) + f(3) = -54 + 78 = 24" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x^3 - ax^2 + 2x - 5$ dibagi dengan $(x-3)$ memberikan sisa $1$, maka nilai $a$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$11$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Berdasarkan Teorema Sisa, $f(3) = 1$:" },
        { "tipe": "formula_block", "latex": "3(3)^3 - a(3)^2 + 2(3) - 5 = 1" },
        { "tipe": "formula_block", "latex": "81 - 9a + 6 - 5 = 1" },
        { "tipe": "formula_block", "latex": "82 - 9a = 1 \\Rightarrow 9a = 81 \\Rightarrow a = 9" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku banyak $f(x) = x^4 + ax^3 + bx^2 + x - 6$ apabila dibagi oleh $x^2 + x + 1$ menghasilkan sisa $4x - 1$. Nilai dari $a + b = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$11$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-5$"}],
        [{"tipe":"paragraph","text":"$-7$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menggunakan pembagian bersusun, didapatkan hubungan koefisien sisa:" },
        { "tipe": "formula_block", "latex": "(b - a + 1)x + (b - a - 6) = 4x - 1" },
        { "tipe": "paragraph", "text": "Penyelarasan koefisien:" },
        { "tipe": "paragraph", "text": "$b - a + 1 = 4 \\Rightarrow b - a = 3$" },
        { "tipe": "paragraph", "text": "$b - a - 6 = -1 \\Rightarrow b - a = 5$ (sesuai konstanta)" },
        { "tipe": "paragraph", "text": "Dengan mencocokkan suku hasil bagi $x^2 + (a-1)x + (b-a)$, diperoleh nilai $a = 2$ dan $b = -3$, sehingga $a + b = 2 + (-3) = -1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar persamaan polinomial $x^3 - 3x^2 - 6x + 8 = 0$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1, 2$ dan $4$"}],
        [{"tipe":"paragraph","text":"$1, 2$ dan $-4$"}],
        [{"tipe":"paragraph","text":"$1, -2$ dan $4$"}],
        [{"tipe":"paragraph","text":"$1, -2$ dan $-4$"}],
        [{"tipe":"paragraph","text":"$-1, 2$ dan $4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji akar rasional $x=1$:" },
        { "tipe": "formula_block", "latex": "1^3 - 3(1)^2 - 6(1) + 8 = 1 - 3 - 6 + 8 = 0 \\quad (x=1 \\text{ adalah akar})" },
        { "tipe": "paragraph", "text": "Faktorkan persamaan:" },
        { "tipe": "formula_block", "latex": "(x-1)(x^2 - 2x - 8) = 0 \\Rightarrow (x-1)(x-4)(x+2) = 0" },
        { "tipe": "paragraph", "text": "Maka akar-akarnya adalah $1, 4,$ dan $-2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x)$ dibagi $(x+2)$ bersisa $14$ dan $f(x)$ dibagi $(x-4)$ bersisa $-4$, maka $f(x)$ dibagi $(x^2-2x-8)$ bersisa ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3x + 8$"}],
        [{"tipe":"paragraph","text":"$-3x - 8$"}],
        [{"tipe":"paragraph","text":"$2x - 4$"}],
        [{"tipe":"paragraph","text":"$2x + 4$"}],
        [{"tipe":"paragraph","text":"$8x + 3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan sisa pembagian adalah $S(x) = px + q$." },
        { "tipe": "formula_block", "latex": "f(-2) = -2p + q = 14" },
        { "tipe": "formula_block", "latex": "f(4) = 4p + q = -4" },
        { "tipe": "paragraph", "text": "Kurangkan kedua persamaan:" },
        { "tipe": "formula_block", "latex": "-6p = 18 \\Rightarrow p = -3" },
        { "tipe": "paragraph", "text": "Substitusi $p = -3$:" },
        { "tipe": "formula_block", "latex": "4(-3) + q = -4 \\Rightarrow q = 8" },
        { "tipe": "paragraph", "text": "Jadi, sisa pembagian adalah $-3x + 8$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Polinomial berikut ini yang bernilai $-290$ untuk $x = -4$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 + 3x^2 - 6x + 8$"}],
        [{"tipe":"paragraph","text":"$x^3 + 3x^2 + 6x - 8$"}],
        [{"tipe":"paragraph","text":"$x^4 - x^3 + 3x^2 - 2x - 8$"}],
        [{"tipe":"paragraph","text":"$x^4 + 4x^3 - 10x^2 + 6x + 12$"}],
        [{"tipe":"paragraph","text":"$4x^3 - 3x^2 - 2x + 6$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusikan $x = -4$ ke opsi E:" },
        { "tipe": "formula_block", "latex": "f(-4) = 4(-4)^3 - 3(-4)^2 - 2(-4) + 6" },
        { "tipe": "formula_block", "latex": "= 4(-64) - 3(16) + 8 + 6 = -256 - 48 + 14 = -290" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan $|AC| = \\sqrt{5}$. Nilai dari $(\\vec{BC} - \\vec{BA}) \\cdot \\vec{CA}$ adalah ...." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{5}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$-\\sqrt{5}$"}],
        [{"tipe":"paragraph","text":"$-5$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sederhanakan vektor: $\\vec{BC} - \\vec{BA} = \\vec{BC} + \\vec{AB} = \\vec{AC}$." },
        { "tipe": "formula_block", "latex": "\\vec{AC} \\cdot \\vec{CA} = \\vec{AC} \\cdot (-\\vec{AC}) = -|\\vec{AC}|^2" },
        { "tipe": "formula_block", "latex": "= -(\\sqrt{5})^2 = -5" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
