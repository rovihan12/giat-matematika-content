      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-3, -5)$"}],
        [{"tipe":"paragraph","text":"$(3, -5)$"}],
        [{"tipe":"paragraph","text":"$(-3, 5)$"}],
        [{"tipe":"paragraph","text":"$(5, 3)$"}],
        [{"tipe":"paragraph","text":"$(-5, -3)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rotasi $180°$: $(x, y) \\to (-x, -y)$." },
        { "tipe": "formula_block", "latex": "A' = (-3, -5)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(-3, -5)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(2, 3)$ oleh dilatasi dengan pusat $O$ dan faktor skala $2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(4, 6)$"}],
        [{"tipe":"paragraph","text":"$(1, 1{,}5)$"}],
        [{"tipe":"paragraph","text":"$(4, 3)$"}],
        [{"tipe":"paragraph","text":"$(2, 6)$"}],
        [{"tipe":"paragraph","text":"$(2, 3)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dilatasi pusat $O$ skala $k$: $(x, y) \\to (kx, ky)$." },
        { "tipe": "formula_block", "latex": "A' = (2 \\cdot 2, 2 \\cdot 3) = (4, 6)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(4, 6)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(6, 3)$ oleh dilatasi dengan pusat $O$ dan faktor skala $\\dfrac{1}{3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(2, 1)$"}],
        [{"tipe":"paragraph","text":"$(18, 9)$"}],
        [{"tipe":"paragraph","text":"$(2, 3)$"}],
        [{"tipe":"paragraph","text":"$(3, 2)$"}],
        [{"tipe":"paragraph","text":"$(6, 1)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A' = \\left(\\dfrac{1}{3} \\cdot 6, \\dfrac{1}{3} \\cdot 3\\right) = (2, 1)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(2, 1)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(2, 5)$ oleh translasi $T_1 = \\begin{pmatrix} 1 \\\\ 2 \\end{pmatrix}$ dilanjutkan $T_2 = \\begin{pmatrix} 3 \\\\ -1 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(6, 6)$"}],
        [{"tipe":"paragraph","text":"$(6, 4)$"}],
        [{"tipe":"paragraph","text":"$(5, 6)$"}],
        [{"tipe":"paragraph","text":"$(4, 6)$"}],
        [{"tipe":"paragraph","text":"$(6, 8)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Translasi gabungan: $T = T_1 + T_2 = (1+3, 2-1) = (4, 1)$." },
        { "tipe": "formula_block", "latex": "A' = (2+4, 5+1) = (6, 6)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(6, 6)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q10",
