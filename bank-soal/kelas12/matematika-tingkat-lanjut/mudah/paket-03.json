        { "tipe": "formula_block", "latex": "A' = (-2, 1)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(-2, 1)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q06",
      "pertanyaan": [
