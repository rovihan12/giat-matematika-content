        [{"tipe":"paragraph","text":"$(-4, 1)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Refleksi terhadap garis $y = x$: $(x, y) \\to (y, x)$." },
        { "tipe": "formula_block", "latex": "A' = (1, 4)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(1, 4)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(1, 2)$ oleh rotasi $90°$ berlawanan arah jarum jam terhadap titik asal $O$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(-2, 1)$"}],
