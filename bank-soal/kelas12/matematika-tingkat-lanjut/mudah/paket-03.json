  "soal": [
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(3, 4)$ oleh translasi $T = \\begin{pmatrix} 2 \\\\ -1 \\end{pmatrix}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(5, 3)$"}],
        [{"tipe":"paragraph","text":"$(5, 5)$"}],
        [{"tipe":"paragraph","text":"$(1, 3)$"}],
        [{"tipe":"paragraph","text":"$(1, 5)$"}],
        [{"tipe":"paragraph","text":"$(5, -3)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "A' = (3+2, 4-1) = (5, 3)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(5, 3)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q02",
      "pertanyaan": [
