      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(2, -3)$"}],
        [{"tipe":"paragraph","text":"$(-2, 3)$"}],
        [{"tipe":"paragraph","text":"$(-2, -3)$"}],
        [{"tipe":"paragraph","text":"$(3, 2)$"}],
        [{"tipe":"paragraph","text":"$(-3, -2)$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Refleksi terhadap sumbu-$x$: $(x, y) \\to (x, -y)$." },
        { "tipe": "formula_block", "latex": "A' = (2, -3)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(2, -3)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q03",
      "pertanyaan": [
