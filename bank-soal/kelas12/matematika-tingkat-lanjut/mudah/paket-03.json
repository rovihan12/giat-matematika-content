      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Refleksi terhadap sumbu-$y$: $(x, y) \\to (-x, y)$." },
        { "tipe": "formula_block", "latex": "A' = (-3, -2)" },
        { "tipe": "paragraph", "text": "Jadi, bayangannya $(-3, -2)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bayangan titik $A(4, 1)$ oleh refleksi terhadap garis $y = x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(1, 4)$"}],
        [{"tipe":"paragraph","text":"$(-1, -4)$"}],
        [{"tipe":"paragraph","text":"$(4, 1)$"}],
