{
  "id": "bs-k12-mat-lanjut-mudah-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Polinomial & akar-akar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar dari $P(x) = x^2 - 5x + 6 = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x = 2$ dan $x = 3$"}],
        [{"tipe":"paragraph","text":"$x = -2$ dan $x = -3$"}],
        [{"tipe":"paragraph","text":"$x = 1$ dan $x = 6$"}],
        [{"tipe":"paragraph","text":"$x = -1$ dan $x = -6$"}],
        [{"tipe":"paragraph","text":"$x = 2$ dan $x = -3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 5x + 6 = (x-2)(x-3) = 0 \\Rightarrow x = 2 \\text{ atau } x = 3" },
        { "tipe": "paragraph", "text": "Jadi, akar-akarnya $2$ dan $3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ akar-akar dari $x^2 - 7x + 12 = 0$, maka $x_1 + x_2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$-7$"}],
        [{"tipe":"paragraph","text":"$-12$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta: $x_1 + x_2 = -\\dfrac{b}{a} = -\\dfrac{-7}{1} = 7$." },
        { "tipe": "paragraph", "text": "Jadi, $x_1 + x_2 = 7$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ akar-akar dari $x^2 - 7x + 12 = 0$, maka $x_1 \\cdot x_2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$-7$"}],
        [{"tipe":"paragraph","text":"$-12$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Teorema Vieta: $x_1 \\cdot x_2 = \\dfrac{c}{a} = \\dfrac{12}{1} = 12$." },
        { "tipe": "paragraph", "text": "Jadi, $x_1 \\cdot x_2 = 12$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Akar-akar dari $P(x) = x^3 - 6x^2 + 11x - 6 = 0$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1, 2, 3$"}],
        [{"tipe":"paragraph","text":"$-1, -2, -3$"}],
        [{"tipe":"paragraph","text":"$1, -2, 3$"}],
        [{"tipe":"paragraph","text":"$1, 2, -3$"}],
        [{"tipe":"paragraph","text":"$2, 3, 4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = 1$: $1 - 6 + 11 - 6 = 0$." },
        { "tipe": "formula_block", "latex": "P(x) = (x-1)(x^2 - 5x + 6) = (x-1)(x-2)(x-3)" },
        { "tipe": "paragraph", "text": "Jadi, akar-akarnya $1, 2, 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2, x_3$ akar-akar dari $x^3 - 6x^2 + 11x - 6 = 0$, maka $x_1 + x_2 + x_3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$11$"}],
        [{"tipe":"paragraph","text":"$-6$"}],
        [{"tipe":"paragraph","text":"$-11$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 + x_2 + x_3 = -\\dfrac{b}{a} = -\\dfrac{-6}{1} = 6$." },
        { "tipe": "paragraph", "text": "Jadi, $x_1 + x_2 + x_3 = 6$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $P(2)$ dari $P(x) = x^3 - 4x^2 + 5x - 2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(2) = 8 - 16 + 10 - 2 = 0" },
        { "tipe": "paragraph", "text": "Jadi, $P(2) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sisa pembagian $P(x) = x^3 - 3x^2 + 4x - 2$ oleh $(x - 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "P(1) = 1 - 3 + 4 - 2 = 0" },
        { "tipe": "paragraph", "text": "Jadi, sisanya 0." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu faktor dari $P(x) = x^3 - 4x^2 + x + 6$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x - 1)$"}],
        [{"tipe":"paragraph","text":"$(x + 1)$"}],
        [{"tipe":"paragraph","text":"$(x - 3)$"}],
        [{"tipe":"paragraph","text":"$(x + 3)$"}],
        [{"tipe":"paragraph","text":"$(x - 4)$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji $x = -1$: $P(-1) = -1 - 4 - 1 + 6 = 0$ → $(x+1)$ faktor." },
        { "tipe": "paragraph", "text": "Jadi, salah satu faktornya $(x+1)$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(x^2 + 1)(x - 2)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 - 2x^2 + x - 2$"}],
        [{"tipe":"paragraph","text":"$x^3 - 2x^2 - x - 2$"}],
        [{"tipe":"paragraph","text":"$x^3 + 2x^2 + x - 2$"}],
        [{"tipe":"paragraph","text":"$x^3 - 2x^2 + x + 2$"}],
        [{"tipe":"paragraph","text":"$x^3 - 2x + 1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x^2+1)(x-2) = x^3 - 2x^2 + x - 2" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $x^3 - 2x^2 + x - 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1, x_2$ akar-akar $x^2 - 5x + 6 = 0$, maka $x_1^2 + x_2^2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$11$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$13$"}],
        [{"tipe":"paragraph","text":"$14$"}],
        [{"tipe":"paragraph","text":"$25$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Vieta: $x_1 + x_2 = 5$, $x_1 x_2 = 6$." },
        { "tipe": "formula_block", "latex": "x_1^2 + x_2^2 = (x_1 + x_2)^2 - 2x_1 x_2 = 25 - 12 = 13" },
        { "tipe": "paragraph", "text": "Jadi, $x_1^2 + x_2^2 = 13$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
