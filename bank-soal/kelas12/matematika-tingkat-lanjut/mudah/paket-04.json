{
  "id": "bs-k12-mat-lanjut-mudah-04",
  "nama": "Bank Soal Mudah - Paket 4",
  "kelas": 12,
  "kategori": "Matematika Tingkat Lanjut",
  "tingkat": "MUDAH",
  "deskripsi": "Bilangan kompleks dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2 + 3i) + (4 + i)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6 + 4i$"}],
        [{"tipe":"paragraph","text":"$6 + 3i$"}],
        [{"tipe":"paragraph","text":"$2 + 4i$"}],
        [{"tipe":"paragraph","text":"$8 + 4i$"}],
        [{"tipe":"paragraph","text":"$6 + 2i$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(2 + 3i) + (4 + i) = (2+4) + (3+1)i = 6 + 4i" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $6 + 4i$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(5 + 2i) - (3 - i)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2 + 3i$"}],
        [{"tipe":"paragraph","text":"$2 + i$"}],
        [{"tipe":"paragraph","text":"$2 - 3i$"}],
        [{"tipe":"paragraph","text":"$8 + i$"}],
        [{"tipe":"paragraph","text":"$8 + 3i$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(5 + 2i) - (3 - i) = (5-3) + (2-(-1))i = 2 + 3i" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $2 + 3i$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2 + i)(3 + 2i)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4 + 7i$"}],
        [{"tipe":"paragraph","text":"$4 - 7i$"}],
        [{"tipe":"paragraph","text":"$8 + 7i$"}],
        [{"tipe":"paragraph","text":"$6 + 7i$"}],
        [{"tipe":"paragraph","text":"$6 - 7i$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(2+i)(3+2i) = 6 + 4i + 3i + 2i^2 = 6 + 7i - 2 = 4 + 7i" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $4 + 7i$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Konjugat dari $z = 3 - 4i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3 + 4i$"}],
        [{"tipe":"paragraph","text":"$-3 + 4i$"}],
        [{"tipe":"paragraph","text":"$-3 - 4i$"}],
        [{"tipe":"paragraph","text":"$4 - 3i$"}],
        [{"tipe":"paragraph","text":"$4 + 3i$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Konjugat: ganti tanda bagian imajiner." },
        { "tipe": "formula_block", "latex": "\\bar{z} = 3 + 4i" },
        { "tipe": "paragraph", "text": "Jadi, konjugatnya $3 + 4i$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modulus dari $z = 3 + 4i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$25$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|z| = \\sqrt{3^2 + 4^2} = 5" },
        { "tipe": "paragraph", "text": "Jadi, modulusnya adalah 5." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modulus dari $z = 5 - 12i$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$13$"}],
        [{"tipe":"paragraph","text":"$17$"}],
        [{"tipe":"paragraph","text":"$25$"}],
        [{"tipe":"paragraph","text":"$169$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "|z| = \\sqrt{25 + 144} = \\sqrt{169} = 13" },
        { "tipe": "paragraph", "text": "Jadi, modulusnya adalah 13." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $i^{10}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$i$"}],
        [{"tipe":"paragraph","text":"$-i$"}],
        [{"tipe":"paragraph","text":"$0$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "i^{10} = i^{4 \\cdot 2 + 2} = (i^4)^2 \\cdot i^2 = 1 \\cdot (-1) = -1" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $-1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{4 + 2i}{2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2 + i$"}],
        [{"tipe":"paragraph","text":"$2 - i$"}],
        [{"tipe":"paragraph","text":"$4 + i$"}],
        [{"tipe":"paragraph","text":"$4 - i$"}],
        [{"tipe":"paragraph","text":"$2 + 2i$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{4 + 2i}{2} = 2 + i" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $2 + i$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $z = 1 + i$, maka $z^2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2i$"}],
        [{"tipe":"paragraph","text":"$-2i$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$1 + 2i$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(1+i)^2 = 1 + 2i + i^2 = 1 + 2i - 1 = 2i" },
        { "tipe": "paragraph", "text": "Jadi, $z^2 = 2i$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-mat-lanjut-mudah-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $i^{2} + i^{4} + i^{6}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "i^2 = -1, \\quad i^4 = 1, \\quad i^6 = i^{4+2} = i^2 = -1" },
        { "tipe": "formula_block", "latex": "i^2 + i^4 + i^6 = -1 + 1 - 1 = -1" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya adalah $-1$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
