{
  "id": "bs-k12-limit-sedang-07",
  "nama": "Bank Soal Sedang - Paket 7",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Limit aljabar bentuk 0/0 dan limit tak hingga fungsi rasional",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sedang-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -2} \\dfrac{x^2 - 2x - 15}{x + 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-7$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung nilai $x = -2$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -2} \\dfrac{x^2 - 2x - 15}{x + 3} = \\dfrac{(-2)^2 - 2(-2) - 15}{-2 + 3}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{4 + 4 - 15}{1} = -7" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-7$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 5} \\dfrac{2x^2 - 3x - 35}{x^2 - 5x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{17}{5}$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{23}{5}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan pembilang dan penyebut:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 5} \\dfrac{(2x + 7)(x - 5)}{x(x - 5)} = \\lim\\limits_{x \\to 5} \\dfrac{2x + 7}{x}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{2(5) + 7}{5} = \\dfrac{10 + 7}{5} = \\dfrac{17}{5}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{17}{5}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{2+x} - \\sqrt{2-x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{2+x} + \\sqrt{2-x}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(2+x) - (2-x)}{x(\\sqrt{2+x} + \\sqrt{2-x})} = \\lim\\limits_{x \\to 0} \\dfrac{2x}{x(\\sqrt{2+x} + \\sqrt{2-x})}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{2}{\\sqrt{2+x} + \\sqrt{2-x}} = \\dfrac{2}{\\sqrt{2} + \\sqrt{2}} = \\dfrac{2}{2\\sqrt{2}} = \\dfrac{1}{\\sqrt{2}} = \\dfrac{1}{2}\\sqrt{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}\\sqrt{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 9}{\\sqrt{x+1} - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$18$"}],
        [{"tipe":"paragraph","text":"$24$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan dari penyebut, yaitu $(\\sqrt{x+1} + 2)$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} \\dfrac{(x^2 - 9)(\\sqrt{x+1} + 2)}{(\\sqrt{x+1} - 2)(\\sqrt{x+1} + 2)} = \\lim\\limits_{x \\to 3} \\dfrac{(x - 3)(x + 3)(\\sqrt{x+1} + 2)}{(x + 1) - 4}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 3} \\dfrac{(x - 3)(x + 3)(\\sqrt{x+1} + 2)}{x - 3} = \\lim\\limits_{x \\to 3} (x + 3)(\\sqrt{x+1} + 2)" },
        { "tipe": "formula_block", "latex": "= (3 + 3)(\\sqrt{3+1} + 2) = 6 \\cdot (2 + 2) = 24" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 24." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{3x^2 - 14x + 8}{x^2 - 3x - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena derajat pembilang sama dengan derajat penyebut (yaitu 2), limitnya adalah rasio koefisien pangkat tertinggi:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{3x^2 - 14x + 8}{x^2 - 3x - 4} = \\dfrac{3}{1} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{4x^3 - 3x^2 + 1}{(2x - 1)^3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\infty$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jabarkan penyebut: $(2x - 1)^3 = 8x^3 - 12x^2 + 6x - 1$." },
        { "tipe": "paragraph", "text": "Karena derajat pembilang dan penyebut sama-sama 3, limitnya adalah perbandingan koefisien $x^3$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{4x^3 - 3x^2 + 1}{8x^3 - 12x^2 + 6x - 1} = \\dfrac{4}{8} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\dfrac{4}{x^2} - \\dfrac{3}{x} + 2\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Terapkan sifat limit tak hingga untuk setiap suku:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left(\\dfrac{4}{x^2} - \\dfrac{3}{x} + 2\\right) = 0 - 0 + 2 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{x^2 - 2x - 1}{3x^2 + 6x - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi pembilang dan penyebut dengan $x^2$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{1 - \\frac{2}{x} - \\frac{1}{x^2}}{3 + \\frac{6}{x} - \\frac{1}{x^2}} = \\dfrac{1 - 0 - 0}{3 + 0 - 0} = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{10x - 7}{\\sqrt{4x^2 - 7x + 6}}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-5$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi pembilang dan penyebut dengan $x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{10 - \\frac{7}{x}}{\\sqrt{4 - \\frac{7}{x} + \\frac{6}{x^2}}} = \\dfrac{10 - 0}{\\sqrt{4 - 0 + 0}} = \\dfrac{10}{2} = 5" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{4x^2 + 6x + 1} - \\sqrt{4x^2 - 2x + 7}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat limit tak hingga bentuk selisih akar: $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{ax^2+bx+c} - \\sqrt{ax^2+dx+e}\\right) = \\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{6 - (-2)}{2\\sqrt{4}} = \\dfrac{8}{2(2)} = \\dfrac{8}{4} = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
