{
  "id": "bs-k12-limit-sedang-04",
  "nama": "Bank Soal Sedang - Paket 4",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Limit fungsi rasional & sekawan lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sedang-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x+1} - \\sqrt{1-x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{x+1} + \\sqrt{1-x}$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x+1)-(1-x)}{x(\\sqrt{x+1}+\\sqrt{1-x})} = \\dfrac{2x}{x(\\sqrt{x+1}+\\sqrt{1-x})} = \\dfrac{2}{\\sqrt{x+1}+\\sqrt{1-x}}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{2}{1+1} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{4+x} - \\sqrt{4-x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{(4+x)-(4-x)}{x(\\sqrt{4+x}+\\sqrt{4-x})} = \\dfrac{2x}{x(\\sqrt{4+x}+\\sqrt{4-x})} = \\dfrac{2}{\\sqrt{4+x}+\\sqrt{4-x}}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{2}{2+2} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{\\sqrt{x} - 1}{x - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{x}-1}{x-1} = \\dfrac{\\sqrt{x}-1}{(\\sqrt{x}-1)(\\sqrt{x}+1)} = \\dfrac{1}{\\sqrt{x}+1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\dfrac{1}{\\sqrt{x}+1} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\dfrac{\\sqrt{x} - 2}{x^2 - 16}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{32}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{16}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 16 = (x-4)(x+4)" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{x}-2}{(x-4)(x+4)} = \\dfrac{\\sqrt{x}-2}{(\\sqrt{x}-2)(\\sqrt{x}+2)(x+4)} = \\dfrac{1}{(\\sqrt{x}+2)(x+4)}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{1}{(2+2)(4+4)} = \\dfrac{1}{4 \\cdot 8} = \\dfrac{1}{32}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{32}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2+2x} - \\sqrt{x^2-4x}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "= \\dfrac{2 - (-4)}{2\\sqrt{1}} = \\dfrac{6}{2} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{4x^2+5x}}{2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{4 + \\frac{5}{x}}}{2} = \\dfrac{2}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+x} - \\sqrt{1-x}}{\\sin x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rasionalisasi: $\\dfrac{\\sqrt{1+x}-\\sqrt{1-x}}{\\sin x} = \\dfrac{2x}{(\\sqrt{1+x}+\\sqrt{1-x})\\sin x}$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{2}{\\sqrt{1+x}+\\sqrt{1-x}} \\cdot \\dfrac{x}{\\sin x} \\to \\dfrac{2}{1+1} \\cdot 1 = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+2x} - 1}{\\sin 2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{1+2x}-1}{\\sin 2x} \\cdot \\dfrac{\\sqrt{1+2x}+1}{\\sqrt{1+2x}+1} = \\dfrac{2x}{\\sin 2x \\cdot (\\sqrt{1+2x}+1)}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{\\sqrt{1+2x}+1} \\cdot \\dfrac{2x}{\\sin 2x} \\to \\dfrac{1}{2} \\cdot 1 = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan x - \\sin x}{x^3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $\\sin x = \\tan x \\cos x$: $\\tan x - \\sin x = \\tan x(1 - \\cos x)$." },
        { "tipe": "formula_block", "latex": "\\dfrac{\\tan x(1-\\cos x)}{x^3} = \\dfrac{\\tan x}{x} \\cdot \\dfrac{1-\\cos x}{x^2} \\to 1 \\cdot \\dfrac{1}{2} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{4x^2 + 4x} - 2x\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "= \\dfrac{4}{2\\sqrt{4}} = \\dfrac{4}{4} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
