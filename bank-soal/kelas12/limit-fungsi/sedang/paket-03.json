{
  "id": "bs-k12-limit-sedang-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Limit bentuk 0/0 dengan pemfaktoran kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sedang-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^2 - 5x + 6}{x^2 - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2-5x+6}{x^2-4} = \\dfrac{(x-2)(x-3)}{(x-2)(x+2)} = \\dfrac{x-3}{x+2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{x-3}{x+2} = \\dfrac{-1}{4} = -\\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{1}{4}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 9}{x^2 - 5x + 6}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-6$"}],
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2-9}{x^2-5x+6} = \\dfrac{(x-3)(x+3)}{(x-2)(x-3)} = \\dfrac{x+3}{x-2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} \\dfrac{x+3}{x-2} = \\dfrac{6}{1} = 6" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 6." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x^3 - 1}{x^2 - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^3-1}{x^2-1} = \\dfrac{(x-1)(x^2+x+1)}{(x-1)(x+1)} = \\dfrac{x^2+x+1}{x+1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\dfrac{1+1+1}{1+1} = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{3}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^3 - 8}{x^2 - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^3-8}{x^2-4} = \\dfrac{(x-2)(x^2+2x+4)}{(x-2)(x+2)} = \\dfrac{x^2+2x+4}{x+2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{4+4+4}{4} = \\dfrac{12}{4} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -1} \\dfrac{x^3 + 1}{x^2 - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^3+1}{x^2-1} = \\dfrac{(x+1)(x^2-x+1)}{(x-1)(x+1)} = \\dfrac{x^2-x+1}{x-1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -1} \\dfrac{1+1+1}{-2} = \\dfrac{3}{-2} = -\\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{3}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^2 - 4}{x^3 - 8}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2-4}{x^3-8} = \\dfrac{(x-2)(x+2)}{(x-2)(x^2+2x+4)} = \\dfrac{x+2}{x^2+2x+4}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{4}{4+4+4} = \\dfrac{4}{12} = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x^4 - 1}{x - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^4 - 1 = (x^2-1)(x^2+1) = (x-1)(x+1)(x^2+1)" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} (x+1)(x^2+1) = 2 \\cdot 2 = 4" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 4." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^4 - 16}{x - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"24"}],
        [{"tipe":"paragraph","text":"32"}],
        [{"tipe":"paragraph","text":"64"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^4-16 = (x^2-4)(x^2+4) = (x-2)(x+2)(x^2+4)" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} (x+2)(x^2+4) = 4 \\cdot 8 = 32" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 32." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 9}{x^2 - 4x + 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2-9}{x^2-4x+3} = \\dfrac{(x-3)(x+3)}{(x-1)(x-3)} = \\dfrac{x+3}{x-1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} \\dfrac{3+3}{3-1} = \\dfrac{6}{2} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -2} \\dfrac{x^3 + 8}{x^2 - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^3+8}{x^2-4} = \\dfrac{(x+2)(x^2-2x+4)}{(x-2)(x+2)} = \\dfrac{x^2-2x+4}{x-2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -2} \\dfrac{4+4+4}{-4} = \\dfrac{12}{-4} = -3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah -3." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
