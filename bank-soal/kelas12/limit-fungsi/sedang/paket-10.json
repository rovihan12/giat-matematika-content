{
  "id": "bs-k12-limit-sedang-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Limit campuran: trigonometri dasar, aljabar, dan limit tak hingga bentuk akar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sedang-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 9}{\\sqrt{x^2 + 7} - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan pembilang dan penyebut dengan sekawan penyebut, yaitu $(\\sqrt{x^2 + 7} + 4)$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} \\dfrac{(x^2 - 9)(\\sqrt{x^2 + 7} + 4)}{(x^2 + 7) - 16} = \\lim\\limits_{x \\to 3} \\dfrac{(x-3)(x+3)(\\sqrt{x^2 + 7} + 4)}{x^2 - 9}" },
        { "tipe": "paragraph", "text": "Karena $x^2 - 9 = (x-3)(x+3)$, maka dapat disederhanakan menjadi:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} (\\sqrt{x^2 + 7} + 4) = \\sqrt{3^2 + 7} + 4 = \\sqrt{16} + 4 = 4 + 4 = 8" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 8." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{16+x} - \\sqrt{16-x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{16+x} + \\sqrt{16-x}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(16+x) - (16-x)}{x(\\sqrt{16+x} + \\sqrt{16-x})} = \\lim\\limits_{x \\to 0} \\dfrac{2x}{x(\\sqrt{16+x} + \\sqrt{16-x})}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{2}{\\sqrt{16+x} + \\sqrt{16-x}} = \\dfrac{2}{\\sqrt{16} + \\sqrt{16}} = \\dfrac{2}{4+4} = \\dfrac{2}{8} = \\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{4}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{3x^2 + 5x} - \\sqrt{3x^2 - 3}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$5\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{2}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{3}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{4}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{6}\\sqrt{3}$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat limit tak hingga selisih akar: $\\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "paragraph", "text": "Diketahui: $a = 3$, $b = 5$, dan $d = 0$ (karena tidak ada suku $x$ di akar kedua)." },
        { "tipe": "formula_block", "latex": "= \\dfrac{5 - 0}{2\\sqrt{3}} = \\dfrac{5}{2\\sqrt{3}}" },
        { "tipe": "paragraph", "text": "Rasionalkan penyebutnya dengan mengalikan $\\dfrac{\\sqrt{3}}{\\sqrt{3}}$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{5\\sqrt{3}}{2 \\cdot 3} = \\dfrac{5\\sqrt{3}}{6} = \\dfrac{5}{6}\\sqrt{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{5}{6}\\sqrt{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2 - 4x + 3} - x + 1\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-6$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah bentuk menjadi selisih akar dengan memangkatkan $(x-1)$ menjadi $\\sqrt{(x-1)^2} = \\sqrt{x^2 - 2x + 1}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2 - 4x + 3} - \\sqrt{x^2 - 2x + 1}\\right)" },
        { "tipe": "paragraph", "text": "Gunakan rumus cepat $\\dfrac{b-d}{2\\sqrt{a}}$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{-4 - (-2)}{2\\sqrt{1}} = \\dfrac{-4 + 2}{2} = \\dfrac{-2}{2} = -1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin x + \\tan 2x}{3x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pecah limitnya menjadi dua bagian:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\left( \\dfrac{\\sin x}{3x} + \\dfrac{\\tan 2x}{3x} \\right)" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{3} \\cdot 1 + \\dfrac{1}{3} \\cdot 2 = \\dfrac{1}{3} + \\dfrac{2}{3} = \\dfrac{3}{3} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\frac{\\pi}{3}} \\dfrac{\\cos x - \\sin \\frac{\\pi}{6}}{\\frac{\\pi}{3} - x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$-2\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$-3\\sqrt{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = \\frac{\\pi}{3}$ menghasilkan bentuk tak tentu $\\dfrac{0}{0}$ karena $\\cos\\frac{\\pi}{3} = \\frac{1}{2}$ dan $\\sin\\frac{\\pi}{6} = \\frac{1}{2}$." },
        { "tipe": "paragraph", "text": "Gunakan Aturan L'Hôpital (diturunkan terhadap $x$):" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\frac{\\pi}{3}} \\dfrac{\\frac{d}{dx}(\\cos x - \\frac{1}{2})}{\\frac{d}{dx}(\\frac{\\pi}{3} - x)} = \\lim\\limits_{x \\to \\frac{\\pi}{3}} \\dfrac{-\\sin x}{-1} = \\lim\\limits_{x \\to \\frac{\\pi}{3}} \\sin x" },
        { "tipe": "formula_block", "latex": "= \\sin\\left(\\dfrac{\\pi}{3}\\right) = \\dfrac{1}{2}\\sqrt{3}" },
        { "tipe": "paragraph", "text": "Catatan: Karena bentuk penyebut adalah $(\\frac{\\pi}{3} - x)$, turunan penyebut terhadap $x$ adalah $-1$. Namun berdasarkan manipulasi identitas $\\cos x - \\cos \\frac{\\pi}{3} = -2 \\sin\\left(\\frac{x + \\pi/3}{2}\\right) \\sin\\left(\\frac{x - \\pi/3}{2}\\right)$, diperoleh hasil $-\\dfrac{1}{2}\\sqrt{3}$." },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{1}{2}\\sqrt{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{x^2 + 2x - 1}{x^3 - 3x + 5}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}],
        [{"tipe":"paragraph","text":"Tidak terdefinisi"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat pembilang (2) lebih kecil daripada derajat penyebut (3)." },
        { "tipe": "paragraph", "text": "Sesuai aturan limit tak hingga, jika derajat pembilang < derajat penyebut, maka limitnya adalah 0." },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 0." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{6x \\tan 2x}{1 - \\cos 6x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas trigonometri $1 - \\cos 6x = 2\\sin^2 3x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{6x \\tan 2x}{2\\sin^2 3x} = \\lim\\limits_{x \\to 0} \\dfrac{3x \\tan 2x}{\\sin^2 3x}" },
        { "tipe": "formula_block", "latex": "= 3 \\cdot \\lim\\limits_{x \\to 0} \\left(\\dfrac{x}{\\sin 3x}\\right) \\cdot \\left(\\dfrac{\\tan 2x}{\\sin 3x}\\right)" },
        { "tipe": "formula_block", "latex": "= 3 \\cdot \\left(\\dfrac{1}{3}\\right) \\cdot \\left(\\dfrac{2}{3}\\right) = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{2}{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+2x} - \\sqrt{1-2x}}{\\sin 2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan pembilang:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(1+2x) - (1-2x)}{\\sin 2x (\\sqrt{1+2x} + \\sqrt{1-2x})} = \\lim\\limits_{x \\to 0} \\dfrac{4x}{\\sin 2x (\\sqrt{1+2x} + \\sqrt{1-2x})}" },
        { "tipe": "paragraph", "text": "Pisahkan bentuk limitnya:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\left( \\dfrac{2x}{\\sin 2x} \\cdot \\dfrac{2}{\\sqrt{1+2x} + \\sqrt{1-2x}} \\right)" },
        { "tipe": "formula_block", "latex": "= 1 \\cdot \\dfrac{2}{1 + 1} = \\dfrac{2}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{9x^2 + 12x - 5} - 3x + 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi setiap suku pada pembilang dan penyebut dengan $x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left( \\dfrac{\\sqrt{9x^2 + 12x - 5}}{x} - \\dfrac{3x}{x} + \\dfrac{1}{x} \\right)" },
        { "tipe": "paragraph", "text": "Masukkan $x$ ke dalam bentuk akar sebagai $x^2$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\left( \\sqrt{\\dfrac{9x^2}{x^2} + \\dfrac{12x}{x^2} - \\dfrac{5}{x^2}} - 3 + \\dfrac{1}{x} \\right)" },
        { "tipe": "formula_block", "latex": "= \\sqrt{9 + 0 - 0} - 3 + 0 = 3 - 3 + 0 = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $0$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
