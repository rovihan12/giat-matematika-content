{
  "id": "bs-k12-limit-sedang-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Limit aljabar dengan substitusi, pemfaktoran, dan perkalian sekawan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sedang-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -3} (2x + 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-7$"}],
        [{"tipe":"paragraph","text":"$-5$"}],
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan metode substitusi langsung:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -3} (2x + 1) = 2(-3) + 1 = -6 + 1 = -5" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\sqrt{x^2 - 3x + 5}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$9$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung nilai $x = 4$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 4} \\sqrt{x^2 - 3x + 5} = \\sqrt{4^2 - 3(4) + 5} = \\sqrt{16 - 12 + 5} = \\sqrt{9} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^2 - 2x - 3}{x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-7$"}],
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$7$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung nilai $x = 2$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{2^2 - 2(2) - 3}{2 - 3} = \\dfrac{4 - 4 - 3}{-1} = \\dfrac{-3}{-1} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 4x + 3}{x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan pembilangnya:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} \\dfrac{(x-3)(x-1)}{x-3} = \\lim\\limits_{x \\to 3} (x-1) = 3 - 1 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -1} \\dfrac{x^2 + 2x - 3}{3x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung nilai $x = -1$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{(-1)^2 + 2(-1) - 3}{3(-1) - 3} = \\dfrac{1 - 2 - 3}{-3 - 3} = \\dfrac{-4}{-6} = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{2}{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x - 1}{\\sqrt{x} - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan dari penyebut, yaitu $(\\sqrt{x} + 1)$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\dfrac{x - 1}{\\sqrt{x} - 1} \\times \\dfrac{\\sqrt{x} + 1}{\\sqrt{x} + 1}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 1} \\dfrac{(x - 1)(\\sqrt{x} + 1)}{x - 1} = \\lim\\limits_{x \\to 1} (\\sqrt{x} + 1) = \\sqrt{1} + 1 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x^2 + 9} - 3}{x^2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{x^2 + 9} + 3$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(x^2 + 9) - 9}{x^2(\\sqrt{x^2 + 9} + 3)} = \\lim\\limits_{x \\to 0} \\dfrac{x^2}{x^2(\\sqrt{x^2 + 9} + 3)}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{1}{\\sqrt{x^2 + 9} + 3} = \\dfrac{1}{\\sqrt{9} + 3} = \\dfrac{1}{6}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{6}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{4x^2 + 9x + 5}{2x^2 + 3x - 5}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat pembilang = derajat penyebut = 2, maka limit adalah rasio koefisien pangkat tertinggi:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{4x^2 + 9x + 5}{2x^2 + 3x - 5} = \\dfrac{4}{2} = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 8x + 12}{x^2 - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan pembilang dan penyebut:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} \\dfrac{(x-6)(x-2)}{(x-2)(x+2)} = \\lim\\limits_{x \\to 3} \\dfrac{x-6}{x+2}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{3-6}{3+2} = \\dfrac{-3}{5}" },
        { "tipe": "paragraph", "text": "Terdapat kekeliruan pada opsi jawaban. Namun, jika ditinjau dari substitusi langsung $\\dfrac{3^2-8(3)+12}{3^2-4} = \\dfrac{-3}{5}$, hasil yang benar adalah $-\\dfrac{3}{5}$. Mohon koreksi opsi pada sistem Anda menjadi $-\\dfrac{3}{5}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-limit-sedang-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{5x - 7}{\\sqrt{4x^2 - 7x + 6}}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-5$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{2}$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi pembilang dan penyebut dengan $x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{\\frac{5x}{x} - \\frac{7}{x}}{\\sqrt{\\frac{4x^2}{x^2} - \\frac{7x}{x^2} + \\frac{6}{x^2}}} = \\lim\\limits_{x \\to \\infty} \\dfrac{5 - \\frac{7}{x}}{\\sqrt{4 - \\frac{7}{x} + \\frac{6}{x^2}}}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{5 - 0}{\\sqrt{4 - 0 + 0}} = \\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{5}{2}$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
