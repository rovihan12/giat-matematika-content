{
  "id": "bs-k12-limit-mudah-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Limit bentuk 0/0 dengan pemfaktoran",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-mudah-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^2 - x - 2}{x - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - x - 2 = (x-2)(x+1)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-2)(x+1)}{x-2} = x + 1" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} (x+1) = 3" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 5x + 6}{x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 5x + 6 = (x-2)(x-3)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-2)(x-3)}{x-3} = x - 2" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} (x-2) = 1" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -1} \\dfrac{x^2 + 4x + 3}{x + 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 + 4x + 3 = (x+1)(x+3)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x+1)(x+3)}{x+1} = x + 3" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -1} (x+3) = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\dfrac{x^2 - 6x + 8}{x - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 6x + 8 = (x-2)(x-4)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-2)(x-4)}{x-4} = x - 2" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 4} (x-2) = 2" },
        { "tipe": "paragraph", "text": "Jadi, hasil limitnya adalah 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x^3 - 1}{x - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $a^3 - b^3 = (a-b)(a^2 + ab + b^2)$:" },
        { "tipe": "formula_block", "latex": "x^3 - 1 = (x-1)(x^2 + x + 1)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-1)(x^2+x+1)}{x-1} = x^2 + x + 1" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} (1 + 1 + 1) = 3" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^3 - 8}{x - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^3 - 8 = (x-2)(x^2 + 2x + 4)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-2)(x^2+2x+4)}{x-2} = x^2 + 2x + 4" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} (4 + 4 + 4) = 12" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 7x + 12}{x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-3"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 7x + 12 = (x-3)(x-4)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-3)(x-4)}{x-3} = x - 4" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} (x-4) = -1" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -2} \\dfrac{x^2 - 4}{x + 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-6"}],
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 4 = (x-2)(x+2)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-2)(x+2)}{x+2} = x - 2" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -2} (x - 2) = -4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-02-q09",
