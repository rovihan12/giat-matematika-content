      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 + 2x - 3 = (x-1)(x+3)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-1)(x+3)}{x-1} = x + 3" },
