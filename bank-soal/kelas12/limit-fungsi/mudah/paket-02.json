      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - 8x + 15 = (x-3)(x-5)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-3)(x-5)}{x-5} = x - 3" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 5} (x-3) = 2" }
