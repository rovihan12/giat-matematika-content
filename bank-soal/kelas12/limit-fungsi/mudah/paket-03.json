{
  "id": "bs-k12-limit-mudah-03",
  "nama": "Bank Soal Mudah - Paket 3",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Limit dengan perkalian sekawan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-mudah-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x+4} - 2}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{x+4} + 2$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{x+4} - 2}{x} \\cdot \\dfrac{\\sqrt{x+4}+2}{\\sqrt{x+4}+2} = \\dfrac{(x+4)-4}{x(\\sqrt{x+4}+2)} = \\dfrac{x}{x(\\sqrt{x+4}+2)}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{\\sqrt{x+4}+2} \\to \\dfrac{1}{2+2} = \\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{4}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x+9} - 3}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{x+9}-3}{x} \\cdot \\dfrac{\\sqrt{x+9}+3}{\\sqrt{x+9}+3} = \\dfrac{x}{x(\\sqrt{x+9}+3)} = \\dfrac{1}{\\sqrt{x+9}+3}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{1}{3+3} = \\dfrac{1}{6}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\dfrac{x - 4}{\\sqrt{x} - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan sekawan $\\sqrt{x}+2$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{x-4}{\\sqrt{x}-2} \\cdot \\dfrac{\\sqrt{x}+2}{\\sqrt{x}+2} = \\dfrac{(x-4)(\\sqrt{x}+2)}{x-4} = \\sqrt{x}+2" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 4} (\\sqrt{x}+2) = 2 + 2 = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+x} - 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{1+x}-1}{x} \\cdot \\dfrac{\\sqrt{1+x}+1}{\\sqrt{1+x}+1} = \\dfrac{x}{x(\\sqrt{1+x}+1)} = \\dfrac{1}{\\sqrt{1+x}+1}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{1}{1+1} = \\dfrac{1}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x - 2}{\\sqrt{x+2} - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x-2}{\\sqrt{x+2}-2} \\cdot \\dfrac{\\sqrt{x+2}+2}{\\sqrt{x+2}+2} = \\dfrac{(x-2)(\\sqrt{x+2}+2)}{(x+2)-4} = \\dfrac{(x-2)(\\sqrt{x+2}+2)}{x-2}" },
        { "tipe": "formula_block", "latex": "= \\sqrt{x+2}+2 \\to \\sqrt{4}+2 = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x - 3}{\\sqrt{x} - \\sqrt{3}}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$3\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x-3}{\\sqrt{x}-\\sqrt{3}} \\cdot \\dfrac{\\sqrt{x}+\\sqrt{3}}{\\sqrt{x}+\\sqrt{3}} = \\dfrac{(x-3)(\\sqrt{x}+\\sqrt{3})}{x-3} = \\sqrt{x}+\\sqrt{3}" },
        { "tipe": "formula_block", "latex": "\\to \\sqrt{3}+\\sqrt{3} = 2\\sqrt{3}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{4+x} - 2}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{4+x}-2}{x} \\cdot \\dfrac{\\sqrt{4+x}+2}{\\sqrt{4+x}+2} = \\dfrac{x}{x(\\sqrt{4+x}+2)} = \\dfrac{1}{\\sqrt{4+x}+2}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{1}{2+2} = \\dfrac{1}{4}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x - 1}{\\sqrt{x} - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x-1}{\\sqrt{x}-1} \\cdot \\dfrac{\\sqrt{x}+1}{\\sqrt{x}+1} = \\dfrac{(x-1)(\\sqrt{x}+1)}{x-1} = \\sqrt{x}+1" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} (\\sqrt{x}+1) = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{x}{\\sqrt{x+1} - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x}{\\sqrt{x+1}-1} \\cdot \\dfrac{\\sqrt{x+1}+1}{\\sqrt{x+1}+1} = \\dfrac{x(\\sqrt{x+1}+1)}{x} = \\sqrt{x+1}+1" },
        { "tipe": "formula_block", "latex": "\\to \\sqrt{1}+1 = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 5} \\dfrac{\\sqrt{x+4} - 3}{x - 5}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{\\sqrt{x+4}-3}{x-5} \\cdot \\dfrac{\\sqrt{x+4}+3}{\\sqrt{x+4}+3} = \\dfrac{(x+4)-9}{(x-5)(\\sqrt{x+4}+3)} = \\dfrac{x-5}{(x-5)(\\sqrt{x+4}+3)}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{\\sqrt{x+4}+3} \\to \\dfrac{1}{3+3} = \\dfrac{1}{6}" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
