{
  "id": "bs-k12-limit-mudah-10",
  "nama": "Bank Soal Mudah - Paket 10",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Variasi komprehensif limit aljabar, trigonometri dasar, dan limit tak hingga",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-mudah-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\dfrac{2x^2 - 7x - 4}{x - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2x^2 - 7x - 4 = (2x + 1)(x - 4)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(2x + 1)(x - 4)}{x - 4} = 2x + 1" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 4} (2x + 1) = 2(4) + 1 = 9" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin 12x}{\\tan 3x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"12"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin 12x}{\\tan 3x} = \\dfrac{12}{3} = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 5} \\dfrac{x^2 - 25}{x^2 - 3x - 10}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{5}{7}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{7}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{10}{7}$"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"$\\dfrac{12}{7}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2 - 25}{x^2 - 3x - 10} = \\dfrac{(x - 5)(x + 5)}{(x - 5)(x + 2)} = \\dfrac{x + 5}{x + 2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 5} \\dfrac{5 + 5}{5 + 2} = \\dfrac{10}{7}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{12x^2 + 5x - 2}{3x^2 - 4x + 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"12"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat pembilang = derajat penyebut = 2, maka limit sama dengan rasio koefisien pangkat tertinggi:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{12x^2 + 5x - 2}{3x^2 - 4x + 1} = \\dfrac{12}{3} = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{1 - \\cos 8x}{4x^2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"32"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\cos 8x = 2\\sin^2 4x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{2\\sin^2 4x}{4x^2} = \\dfrac{1}{2} \\cdot \\left(\\lim\\limits_{x \\to 0} \\dfrac{\\sin 4x}{x}\\right)^2 = \\dfrac{1}{2} \\cdot (4)^2 = \\dfrac{16}{2} = 8" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 5} \\dfrac{x - 5}{\\sqrt{x-1} - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan penyebut $\\sqrt{x-1} + 2$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{x - 5}{\\sqrt{x-1} - 2} \\cdot \\dfrac{\\sqrt{x-1} + 2}{\\sqrt{x-1} + 2} = \\dfrac{(x - 5)(\\sqrt{x-1} + 2)}{(x - 1) - 4} = \\dfrac{(x - 5)(\\sqrt{x-1} + 2)}{x - 5}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 5} (\\sqrt{x-1} + 2) = \\sqrt{4} + 2 = 2 + 2 = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan 8x + \\tan 2x}{5x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"5"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pecah bentuk limit:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\left( \\dfrac{\\tan 8x}{5x} + \\dfrac{\\tan 2x}{5x} \\right) = \\dfrac{8}{5} + \\dfrac{2}{5} = \\dfrac{10}{5} = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -3} \\dfrac{x^2 - x - 12}{x + 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-7"}],
        [{"tipe":"paragraph","text":"-5"}],
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^2 - x - 12 = (x + 3)(x - 4)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x + 3)(x - 4)}{x + 3} = x - 4" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -3} (x - 4) = -3 - 4 = -7" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{(3x - 1)(2x + 5)}{(x + 4)(x - 2)}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jabarkan pembilang dan penyebut:" },
        { "tipe": "paragraph", "text": "Pembilang: $(3x - 1)(2x + 5) = 6x^2 + 13x - 5$" },
        { "tipe": "paragraph", "text": "Penyebut: $(x + 4)(x - 2) = x^2 + 2x - 8$" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{6x^2 + 13x - 5}{x^2 + 2x - 8} = \\dfrac{6}{1} = 6" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan^2 3x}{x \\sin 9x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\left( \\dfrac{\\tan 3x}{x} \\cdot \\dfrac{\\tan 3x}{\\sin 9x} \\right) = 3 \\cdot \\dfrac{3}{9} = 3 \\cdot \\dfrac{1}{3} = 1" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}