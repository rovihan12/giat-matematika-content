{
  "id": "bs-k12-limit-mudah-06",
  "nama": "Bank Soal Mudah - Paket 6",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Variasi lanjutan limit aljabar bentuk tak tentu dan pemfaktoran khusus",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-mudah-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{2x^2 - 5x - 3}{x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"5"}],
        [{"tipe":"paragraph","text":"7"}],
        [{"tipe":"paragraph","text":"9"}],
        [{"tipe":"paragraph","text":"11"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2x^2 - 5x - 3 = (2x + 1)(x - 3)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(2x + 1)(x - 3)}{x - 3} = 2x + 1" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} (2x + 1) = 2(3) + 1 = 7" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\frac{1}{2}} \\dfrac{2x^2 + x - 1}{2x - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2x^2 + x - 1 = (2x - 1)(x + 1)" },
        { "tipe": "formula_block", "latex": "\\dfrac{(2x - 1)(x + 1)}{2x - 1} = x + 1" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\frac{1}{2}} (x + 1) = \\dfrac{1}{2} + 1 = \\dfrac{3}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -3} \\dfrac{x^2 - 9}{2x^2 + 5x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3}{7}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{6}{7}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{5}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"$\\dfrac{7}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2 - 9}{2x^2 + 5x - 3} = \\dfrac{(x - 3)(x + 3)}{(2x - 1)(x + 3)} = \\dfrac{x - 3}{2x - 1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -3} \\dfrac{x - 3}{2x - 1} = \\dfrac{-3 - 3}{2(-3) - 1} = \\dfrac{-6}{-7} = \\dfrac{6}{7}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^3 - 2x^2}{x - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "x^3 - 2x^2 = x^2(x - 2)" },
        { "tipe": "formula_block", "latex": "\\dfrac{x^2(x - 2)}{x - 2} = x^2" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} x^2 = 2^2 = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\left( \\dfrac{2}{x^2 - 1} - \\dfrac{1}{x - 1} \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{2}{x^2 - 1} - \\dfrac{1}{x - 1} = \\dfrac{2}{(x-1)(x+1)} - \\dfrac{x+1}{(x-1)(x+1)} = \\dfrac{1 - x}{(x-1)(x+1)}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{-(x-1)}{(x-1)(x+1)} = \\dfrac{-1}{x + 1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\dfrac{-1}{x + 1} = \\dfrac{-1}{1 + 1} = -\\dfrac{1}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} (x^3 - 3x^2 + 2x - 1)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-1"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung $x = 2$:" },
        { "tipe": "formula_block", "latex": "(2)^3 - 3(2)^2 + 2(2) - 1 = 8 - 12 + 4 - 1 = -1" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{x^3 - 4x}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"-4"}],
        [{"tipe":"paragraph","text":"-2"}],
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x(x^2 - 4)}{x} = x^2 - 4" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} (x^2 - 4) = 0^2 - 4 = -4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\dfrac{x^2 - 16}{2x - 8}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{(x-4)(x+4)}{2(x-4)} = \\dfrac{x+4}{2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 4} \\dfrac{x+4}{2} = \\dfrac{4+4}{2} = 4" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{(2x - 1)(x + 3)}{x^2 + 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jabarkan pembilang: $(2x - 1)(x + 3) = 2x^2 + 5x - 3$." },
        { "tipe": "paragraph", "text": "Derajat pembilang = derajat penyebut = 2, sehingga limit sama dengan rasio koefisien $x^2$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{2x^2 + 5x - 3}{x^2 + 1} = \\dfrac{2}{1} = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin 4x \\cos 2x}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"0"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin 4x}{x} \\cdot \\lim\\limits_{x \\to 0} \\cos 2x = 4 \\cdot \\cos(0) = 4 \\cdot 1 = 4" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
