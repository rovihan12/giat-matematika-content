{
  "id": "bs-k12-limit-mudah-07",
  "nama": "Bank Soal Mudah - Paket 7",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Variasi lanjutan limit aljabar, trigonometri dasar, dan bentuk akar sederhana",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-mudah-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 5} \\dfrac{2x^2 - 50}{x - 5}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"10"}],
        [{"tipe":"paragraph","text":"15"}],
        [{"tipe":"paragraph","text":"20"}],
        [{"tipe":"paragraph","text":"25"}],
        [{"tipe":"paragraph","text":"30"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "2x^2 - 50 = 2(x^2 - 25) = 2(x - 5)(x + 5)" },
        { "tipe": "formula_block", "latex": "\\dfrac{2(x - 5)(x + 5)}{x - 5} = 2(x + 5)" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 5} 2(x + 5) = 2(5 + 5) = 20" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan 6x}{\\sin 2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"6"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\tan 6x}{\\sin 2x} = \\dfrac{6}{2} = 3" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 3} \\dfrac{x^2 - 9}{x^2 - 2x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2 - 9}{x^2 - 2x - 3} = \\dfrac{(x - 3)(x + 3)}{(x - 3)(x + 1)} = \\dfrac{x + 3}{x + 1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 3} \\dfrac{x + 3}{x + 1} = \\dfrac{3 + 3}{3 + 1} = \\dfrac{6}{4} = \\dfrac{3}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{1 - \\cos 4x}{x^2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"16"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\cos 4x = 2\\sin^2 2x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{2\\sin^2 2x}{x^2} = 2 \\cdot \\left(\\lim\\limits_{x \\to 0} \\dfrac{\\sin 2x}{x}\\right)^2 = 2 \\cdot (2)^2 = 8" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{4x^2 + 3x - 1}}{x + 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi pembilang dan penyebut dengan $x$ (dengan catatan $\\sqrt{x^2} = x$ untuk $x \\to \\infty$):" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{4 + \\frac{3}{x} - \\frac{1}{x^2}}}{1 + \\frac{2}{x}} = \\dfrac{\\sqrt{4 + 0 - 0}}{1 + 0} = \\dfrac{2}{1} = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x^2 + 3x - 4}{x^2 - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{2}$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^2 + 3x - 4}{x^2 - 1} = \\dfrac{(x - 1)(x + 4)}{(x - 1)(x + 1)} = \\dfrac{x + 4}{x + 1}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\dfrac{x + 4}{x + 1} = \\dfrac{1 + 4}{1 + 1} = \\dfrac{5}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{x \\tan 3x}{\\sin^2 x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"2"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"6"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\left( \\dfrac{x}{\\sin x} \\cdot \\dfrac{\\tan 3x}{\\sin x} \\right) = 1 \\cdot 3 = 3" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^2 - 4}{\\sqrt{x+2} - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"8"}],
        [{"tipe":"paragraph","text":"12"}],
        [{"tipe":"paragraph","text":"16"}],
        [{"tipe":"paragraph","text":"20"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan penyebut:" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x-2)(x+2)}{\\sqrt{x+2}-2} \\cdot \\dfrac{\\sqrt{x+2}+2}{\\sqrt{x+2}+2} = \\dfrac{(x-2)(x+2)(\\sqrt{x+2}+2)}{x - 2}" },
        { "tipe": "formula_block", "latex": "= (x + 2)(\\sqrt{x+2} + 2)" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} (2 + 2)(\\sqrt{4} + 2) = 4 \\cdot 4 = 16" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{(3x + 2)^2}{2x^2 - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"3"}],
        [{"tipe":"paragraph","text":"4"}],
        [{"tipe":"paragraph","text":"$\\dfrac{9}{2}$"}],
        [{"tipe":"paragraph","text":"9"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jabarkan pembilang: $(3x + 2)^2 = 9x^2 + 12x + 4$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{9x^2 + 12x + 4}{2x^2 - 1} = \\dfrac{9}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-limit-mudah-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{2x}{\\sin 4x + \\tan 2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"1"}],
        [{"tipe":"paragraph","text":"3"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi pembilang dan penyebut dengan $x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\frac{2x}{x}}{\\frac{\\sin 4x}{x} + \\frac{\\tan 2x}{x}} = \\dfrac{2}{4 + 2} = \\dfrac{2}{6} = \\dfrac{1}{3}" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
