      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin x}{2x} = \\dfrac{1}{2} \\cdot \\lim\\limits_{x \\to 0} \\dfrac{\\sin x}{x} = \\dfrac{1}{2}" }
      ],
      "tingkat": "MUDAH"
    },
    {
