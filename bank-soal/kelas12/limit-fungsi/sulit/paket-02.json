{
  "id": "bs-k12-limit-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit trigonometri identitas kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin 5x - \\sin 3x}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin 5x - \\sin 3x}{x} = 5 - 3 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\cos 5x - \\cos 3x}{x^2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-16$"}],
        [{"tipe":"paragraph","text":"$-8$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan $\\cos A - \\cos B = -2\\sin\\frac{A+B}{2}\\sin\\frac{A-B}{2}$:" },
        { "tipe": "formula_block", "latex": "\\cos 5x - \\cos 3x = -2\\sin 4x \\sin x" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{-2\\sin 4x \\sin x}{x^2} = -2 \\cdot 4 \\cdot 1 = -8" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah -8." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin 4x \\cdot \\sin 3x}{x^2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$24$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin 4x}{x} \\cdot \\dfrac{\\sin 3x}{x} = 4 \\cdot 3 = 12" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 12." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan 5x - \\sin 3x}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\tan 5x}{x} - \\lim\\limits_{x \\to 0} \\dfrac{\\sin 3x}{x} = 5 - 3 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{1 - \\cos 2x}{x \\tan x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "1 - \\cos 2x = 2\\sin^2 x" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{2\\sin^2 x}{x \\tan x} = 2 \\cdot \\lim\\limits_{x \\to 0} \\dfrac{\\sin x}{x} \\cdot \\dfrac{\\sin x}{\\tan x} = 2 \\cdot 1 \\cdot 1 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\cos 4x - 1}{x \\sin 2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\cos 4x - 1 = -2\\sin^2 2x" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{-2\\sin^2 2x}{x \\sin 2x} = -2 \\cdot \\lim\\limits_{x \\to 0} \\dfrac{\\sin 2x}{x} = -2 \\cdot 2 = -4" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah -4." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{1 - \\cos x}{\\tan^2 x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "1 - \\cos x = 2\\sin^2 \\frac{x}{2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{2\\sin^2 \\frac{x}{2}}{\\tan^2 x} = 2 \\cdot \\lim\\limits_{x \\to 0} \\left(\\dfrac{\\sin \\frac{x}{2}}{\\tan x}\\right)^2 = 2 \\cdot \\left(\\dfrac{1/2}{1}\\right)^2 = 2 \\cdot \\dfrac{1}{4} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{x \\cdot \\tan 2x}{1 - \\cos 2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "1 - \\cos 2x = 2\\sin^2 x" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{x \\tan 2x}{2\\sin^2 x} = \\dfrac{1}{2} \\cdot \\lim\\limits_{x \\to 0} \\dfrac{x}{\\sin x} \\cdot \\dfrac{\\tan 2x}{\\sin x}" },
        { "tipe": "paragraph", "text": "Dengan $\\dfrac{\\tan 2x}{\\sin x} = \\dfrac{\\tan 2x}{2x} \\cdot \\dfrac{2x}{\\sin x} \\to 1 \\cdot 2 = 2$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2} \\cdot 1 \\cdot 2 = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan 3x - \\tan x}{\\sin 2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\tan 3x - \\tan x}{\\sin 2x} = \\lim\\limits_{x \\to 0} \\left(\\dfrac{\\tan 3x}{\\sin 2x} - \\dfrac{\\tan x}{\\sin 2x}\\right)" },
        { "tipe": "formula_block", "latex": "= \\dfrac{3}{2} - \\dfrac{1}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\frac{\\pi}{4}} \\dfrac{\\sin x - \\cos x}{1 - \\tan x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{\\sqrt{2}}{2}$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung $x = \\frac{\\pi}{4}$ menghasilkan $\\frac{0}{0}$. Faktorkan penyebut:" },
        { "tipe": "formula_block", "latex": "1 - \\tan x = 1 - \\dfrac{\\sin x}{\\cos x} = \\dfrac{\\cos x - \\sin x}{\\cos x} = \\dfrac{-(\\sin x - \\cos x)}{\\cos x}" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\sin x - \\cos x}{1 - \\tan x} = \\dfrac{(\\sin x - \\cos x) \\cos x}{-(\\sin x - \\cos x)} = -\\cos x" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\frac{\\pi}{4}} (-\\cos x) = -\\dfrac{\\sqrt{2}}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{\\sqrt{2}}{2}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
