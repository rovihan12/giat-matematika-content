{
  "id": "bs-k12-limit-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Aplikasi limit: turunan & kontinuitas",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2$, maka $\\lim\\limits_{h \\to 0} \\dfrac{f(x+h) - f(x)}{h}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$x$"}],
        [{"tipe":"paragraph","text":"$2x$"}],
        [{"tipe":"paragraph","text":"$x^2$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{(x+h)^2 - x^2}{h} = \\dfrac{x^2 + 2xh + h^2 - x^2}{h} = 2x + h" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{h \\to 0} (2x + h) = 2x" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya adalah $2x$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^3$, maka $\\lim\\limits_{h \\to 0} \\dfrac{f(x+h) - f(x)}{h}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2$"}],
        [{"tipe":"paragraph","text":"$2x^2$"}],
        [{"tipe":"paragraph","text":"$3x^2$"}],
        [{"tipe":"paragraph","text":"$3x$"}],
        [{"tipe":"paragraph","text":"$x^3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(x+h)^3 = x^3 + 3x^2h + 3xh^2 + h^3" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x+h)^3 - x^3}{h} = 3x^2 + 3xh + h^2" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{h \\to 0} (3x^2 + 3xh + h^2) = 3x^2" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya adalah $3x^2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = \\begin{cases} x^2 + 1, & x < 1 \\\\ 3x - 1, & x \\geq 1 \\end{cases}$ kontinu di $x = 1$ jika ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$f(1) = 1$"}],
        [{"tipe":"paragraph","text":"$f(1) = 2$"}],
        [{"tipe":"paragraph","text":"$f(1) = 3$"}],
        [{"tipe":"paragraph","text":"$f(1) = 4$"}],
        [{"tipe":"paragraph","text":"Tidak ada nilai yang membuat kontinu"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek limit kiri: $\\lim\\limits_{x \\to 1^-} (x^2+1) = 2$." },
        { "tipe": "paragraph", "text": "Cek limit kanan: $\\lim\\limits_{x \\to 1^+} (3x-1) = 2$." },
        { "tipe": "paragraph", "text": "Kedua limit sama = 2. Agar kontinu, $f(1)$ harus = 2." },
        { "tipe": "paragraph", "text": "Jadi, $f(1) = 2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = \\begin{cases} \\dfrac{x^2 - 4}{x - 2}, & x \\neq 2 \\\\ k, & x = 2 \\end{cases}$ kontinu di $x = 2$ jika $k$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{x^2-4}{x-2} = \\lim\\limits_{x \\to 2} (x+2) = 4" },
        { "tipe": "paragraph", "text": "Agar kontinu, $k = 4$." },
        { "tipe": "paragraph", "text": "Jadi, $k = 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^3 - 8}{x^2 - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{x^3-8}{x^2-4} = \\dfrac{(x-2)(x^2+2x+4)}{(x-2)(x+2)} = \\dfrac{x^2+2x+4}{x+2}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{4+4+4}{4} = \\dfrac{12}{4} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{(1+x)^{10} - 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$20$"}],
        [{"tipe":"paragraph","text":"$100$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan ekspansi binomial: $(1+x)^{10} = 1 + 10x + \\binom{10}{2}x^2 + \\cdots$" },
        { "tipe": "formula_block", "latex": "\\dfrac{(1+x)^{10} - 1}{x} = 10 + \\binom{10}{2}x + \\cdots" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} = 10" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 10." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{(1+2x)^5 - 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$20$"}],
        [{"tipe":"paragraph","text":"$32$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "(1+2x)^5 = 1 + 5(2x) + \\cdots = 1 + 10x + \\cdots" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(1+2x)^5 - 1}{x} = 10" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 10." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt[3]{1+x} - 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan ekspansi binomial $(1+x)^{1/3} = 1 + \\frac{1}{3}x + \\cdots$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{(1+x)^{1/3} - 1}{x} = \\dfrac{1}{3} + \\cdots \\to \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+x} - \\sqrt{1-x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rasionalisasi dengan sekawan $\\sqrt{1+x} + \\sqrt{1-x}$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{(1+x)-(1-x)}{x(\\sqrt{1+x}+\\sqrt{1-x})} = \\dfrac{2x}{x(\\sqrt{1+x}+\\sqrt{1-x})} = \\dfrac{2}{\\sqrt{1+x}+\\sqrt{1-x}}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{2}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+ax} - \\sqrt{1-ax}}{x}$ untuk $a = 4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$16$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\dfrac{(1+ax)-(1-ax)}{x(\\sqrt{1+ax}+\\sqrt{1-ax})} = \\dfrac{2ax}{x(\\sqrt{1+ax}+\\sqrt{1-ax})} = \\dfrac{2a}{\\sqrt{1+ax}+\\sqrt{1-ax}}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{2a}{2} = a = 4" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 4." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
