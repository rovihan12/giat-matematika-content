{
  "id": "bs-k12-limit-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit bentuk 0/0 menggunakan Aturan L'Hôpital dan manipulasi aljabar tingkat lanjut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x^2 - 2x - 3}{x^2 - 5x + 6}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-3$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan pembilang dan penyebut:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\dfrac{(x-3)(x+1)}{(x-3)(x-2)} = \\lim\\limits_{x \\to 1} \\dfrac{x+1}{x-2}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1+1}{1-2} = \\dfrac{2}{-1} = -2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^2 - 4}{x^2 + 2x - 8}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-8$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan Aturan L'Hôpital karena substitusi langsung menghasilkan bentuk $0/0$." },
        { "tipe": "paragraph", "text": "Turunkan pembilang: $\\frac{d}{dx}(x^2 - 4) = 2x$" },
        { "tipe": "paragraph", "text": "Turunkan penyebut: $\\frac{d}{dx}(x^2 + 2x - 8) = 2x + 2$" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{2x}{2x + 2} = \\dfrac{2(2)}{2(2) + 2} = \\dfrac{4}{6} = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{2}{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{2x^2 - 8}{x + 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-8$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung nilai $x = 2$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{2x^2 - 8}{x + 2} = \\dfrac{2(2)^2 - 8}{2 + 2}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{8 - 8}{4} = \\dfrac{0}{4} = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 0." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+3x} - \\sqrt{1-3x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan pembilang $\\sqrt{1+3x} + \\sqrt{1-3x}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(1+3x) - (1-3x)}{x(\\sqrt{1+3x} + \\sqrt{1-3x})} = \\lim\\limits_{x \\to 0} \\dfrac{6x}{x(\\sqrt{1+3x} + \\sqrt{1-3x})}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{6}{\\sqrt{1+3x} + \\sqrt{1-3x}} = \\dfrac{6}{\\sqrt{1}+\\sqrt{1}} = \\dfrac{6}{2} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{2x^2 + 5x - 3} - \\sqrt{2x^2 - x + 1}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$3\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$6\\sqrt{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat selisih akar tak hingga: $\\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "paragraph", "text": "Diketahui: $a = 2$, $b = 5$, dan $d = -1$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{5 - (-1)}{2\\sqrt{2}} = \\dfrac{6}{2\\sqrt{2}} = \\dfrac{3}{\\sqrt{2}}" },
        { "tipe": "paragraph", "text": "Rasionalkan dengan mengalikan $\\dfrac{\\sqrt{2}}{\\sqrt{2}}$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{3\\sqrt{2}}{2} = \\dfrac{3}{2}\\sqrt{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{3}{2}\\sqrt{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\dfrac{x - 1}{\\sqrt[3]{x^2} - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan Aturan L'Hôpital (turunkan pembilang dan penyebut):" },
        { "tipe": "formula_block", "latex": "f(x) = x - 1 \\Rightarrow f'(x) = 1" },
        { "tipe": "formula_block", "latex": "g(x) = x^{2/3} - 1 \\Rightarrow g'(x) = \\dfrac{2}{3}x^{-1/3}" },
        { "tipe": "paragraph", "text": "Substitusi $x=1$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\dfrac{1}{\\frac{2}{3}x^{-1/3}} = \\dfrac{1}{\\frac{2}{3}(1)} = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{3}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{(3x - 2)^2}{(2x + 1)(x - 3)}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{9}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jabarkan pembilang dan penyebut untuk melihat koefisien pangkat tertinggi:" },
        { "tipe": "formula_block", "latex": "\\text{Pembilang} = 9x^2 - 12x + 4" },
        { "tipe": "formula_block", "latex": "\\text{Penyebut} = 2x^2 - 5x - 3" },
        { "tipe": "paragraph", "text": "Karena derajat pembilang sama dengan penyebut (2), limitnya adalah perbandingan koefisien $x^2$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{9x^2 - 12x + 4}{2x^2 - 5x - 3} = \\dfrac{9}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{9}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{x^2 - 4x + 3} - (x - 2) \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah bentuk $(x - 2)$ menjadi bentuk akar: $(x-2) = \\sqrt{(x-2)^2} = \\sqrt{x^2 - 4x + 4}$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{x^2 - 4x + 3} - \\sqrt{x^2 - 4x + 4} \\right)" },
        { "tipe": "paragraph", "text": "Gunakan rumus cepat $\\dfrac{b-d}{2\\sqrt{a}}$ dengan $a=1$, $b=-4$, $d=-4$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{-4 - (-4)}{2\\sqrt{1}} = \\dfrac{0}{2} = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 0." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\dfrac{\\sqrt{x} - 2}{x^2 - 16}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{32}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{16}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan pembilang $\\sqrt{x} + 2$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 4} \\dfrac{(x - 4)}{(x^2 - 16)(\\sqrt{x} + 2)}" },
        { "tipe": "paragraph", "text": "Faktorkan penyebut $x^2 - 16 = (x-4)(x+4)$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 4} \\dfrac{x - 4}{(x-4)(x+4)(\\sqrt{x} + 2)} = \\lim\\limits_{x \\to 4} \\dfrac{1}{(x+4)(\\sqrt{x} + 2)}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{(4+4)(\\sqrt{4} + 2)} = \\dfrac{1}{(8)(4)} = \\dfrac{1}{32}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{32}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{2 - \\sqrt{x+2}}{x^2 - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{16}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{8}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{16}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan pembilang dan penyebut dengan sekawan pembilang, yaitu $(2 + \\sqrt{x+2})$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{4 - (x+2)}{(x^2 - 4)(2 + \\sqrt{x+2})} = \\lim\\limits_{x \\to 2} \\dfrac{2 - x}{(x-2)(x+2)(2 + \\sqrt{x+2})}" },
        { "tipe": "paragraph", "text": "Karena $(2 - x) = -(x - 2)$, kita dapat menyederhanakannya:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 2} \\dfrac{-1}{(x+2)(2 + \\sqrt{x+2})}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{-1}{(2+2)(2 + \\sqrt{4})} = \\dfrac{-1}{(4)(4)} = -\\dfrac{1}{16}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{1}{16}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
