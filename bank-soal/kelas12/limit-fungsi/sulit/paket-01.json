{
  "id": "bs-k12-limit-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit bentuk 1^∞ dan bilangan Euler e",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(1 + \\dfrac{1}{x}\\right)^x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$e$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ini adalah definisi bilangan Euler $e$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left(1 + \\dfrac{1}{x}\\right)^x = e" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $e$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(1 + \\dfrac{2}{x}\\right)^x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$e$"}],
        [{"tipe":"paragraph","text":"$e^2$"}],
        [{"tipe":"paragraph","text":"$2e$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus $\\lim\\limits_{x \\to \\infty} \\left(1 + \\dfrac{k}{x}\\right)^x = e^k$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left(1 + \\dfrac{2}{x}\\right)^x = e^2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $e^2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} (1 + 3x)^{1/x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$e$"}],
        [{"tipe":"paragraph","text":"$e^2$"}],
        [{"tipe":"paragraph","text":"$e^3$"}],
        [{"tipe":"paragraph","text":"$3e$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus $\\lim\\limits_{x \\to 0} (1 + kx)^{1/x} = e^k$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} (1 + 3x)^{1/x} = e^3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $e^3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(1 - \\dfrac{1}{x}\\right)^x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-e$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$1/e$"}],
        [{"tipe":"paragraph","text":"$e$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis $1 - \\dfrac{1}{x} = 1 + \\dfrac{-1}{x}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left(1 + \\dfrac{-1}{x}\\right)^x = e^{-1} = \\dfrac{1}{e}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{e}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{e^{2x} - 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$e$"}],
        [{"tipe":"paragraph","text":"$e^2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan $\\lim\\limits_{x \\to 0} \\dfrac{e^{kx}-1}{x} = k$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{e^{2x}-1}{x} = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{e^{3x} - e^{x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$e$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan $e^x$:" },
        { "tipe": "formula_block", "latex": "\\dfrac{e^{3x}-e^x}{x} = e^x \\cdot \\dfrac{e^{2x}-1}{x}" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} e^x \\cdot \\lim\\limits_{x \\to 0} \\dfrac{e^{2x}-1}{x} = 1 \\cdot 2 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\ln(1+2x)}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$e$"}],
        [{"tipe":"paragraph","text":"$\\ln 2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan $\\lim\\limits_{x \\to 0} \\dfrac{\\ln(1+kx)}{x} = k$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\ln(1+2x)}{x} = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\ln(1+x)}{\\sin x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$e$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\ln(1+x)}{\\sin x} = \\dfrac{\\lim\\limits_{x \\to 0} \\frac{\\ln(1+x)}{x}}{\\lim\\limits_{x \\to 0} \\frac{\\sin x}{x}} = \\dfrac{1}{1} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(1 + \\dfrac{3}{x}\\right)^{2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$e^3$"}],
        [{"tipe":"paragraph","text":"$e^5$"}],
        [{"tipe":"paragraph","text":"$e^6$"}],
        [{"tipe":"paragraph","text":"$2e^3$"}],
        [{"tipe":"paragraph","text":"$3e^2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis $\\left(1 + \\frac{3}{x}\\right)^{2x} = \\left[\\left(1 + \\frac{3}{x}\\right)^x\\right]^2$:" },
        { "tipe": "formula_block", "latex": "= \\left(e^3\\right)^2 = e^6" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $e^6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{e^{5x} - 1}{e^{3x} - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3}{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{e^{5x}-1}{e^{3x}-1} = \\dfrac{5}{3}" },
        { "tipe": "paragraph", "text": "Alasan: $\\dfrac{e^{5x}-1}{x} \\to 5$ dan $\\dfrac{e^{3x}-1}{x} \\to 3$, sehingga hasilnya $\\dfrac{5}{3}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
