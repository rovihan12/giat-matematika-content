{
  "id": "bs-k12-limit-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit tak hingga bentuk akar kompleks dan manipulasi aljabar lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{x^2 - 2x + 1} - \\sqrt{x^2 - 3x + 2} \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat limit tak hingga selisih akar: $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{ax^2+bx+c} - \\sqrt{ax^2+dx+e}\\right) = \\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "paragraph", "text": "Diketahui: $a = 1$, $b = -2$, dan $d = -3$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{-2 - (-3)}{2\\sqrt{1}} = \\dfrac{-2 + 3}{2} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{9x^2 + 12x - 5} - 3x + 1 \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah bentuk $(3x - 1)$ menjadi akar: $(3x - 1) = \\sqrt{(3x-1)^2} = \\sqrt{9x^2 - 6x + 1}$." },
        { "tipe": "paragraph", "text": "Soal menjadi:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{9x^2 + 12x - 5} - \\sqrt{9x^2 - 6x + 1} \\right)" },
        { "tipe": "paragraph", "text": "Gunakan rumus cepat $\\dfrac{b-d}{2\\sqrt{a}}$ dengan $a=9$, $b=12$, dan $d=-6$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{12 - (-6)}{2\\sqrt{9}} = \\dfrac{18}{2(3)} = \\dfrac{18}{6} = 3" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 3." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{x^2 + 2x} - \\sqrt{x^2 - x} \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat selisih akar tak hingga: $\\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "paragraph", "text": "Diketahui: $a = 1$, $b = 2$, dan $d = -1$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{2 - (-1)}{2\\sqrt{1}} = \\dfrac{2 + 1}{2} = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{3}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{1 - \\cos^2 x}{x^2(1 + \\cos x)}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\cos^2 x = \\sin^2 x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin^2 x}{x^2(1 + \\cos x)}" },
        { "tipe": "paragraph", "text": "Pisahkan bentuknya:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\left( \\left(\\dfrac{\\sin x}{x}\\right)^2 \\cdot \\dfrac{1}{1 + \\cos x} \\right)" },
        { "tipe": "formula_block", "latex": "= 1^2 \\cdot \\dfrac{1}{1 + \\cos(0)} = 1 \\cdot \\dfrac{1}{1 + 1} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{9x^2 + 6x - 3} - 3x + 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi setiap suku pada pembilang dan penyebut dengan $x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left( \\dfrac{\\sqrt{9x^2 + 6x - 3}}{x} - \\dfrac{3x}{x} + \\dfrac{1}{x} \\right)" },
        { "tipe": "paragraph", "text": "Masukkan $x$ ke dalam bentuk akar sebagai $x^2$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\left( \\sqrt{\\dfrac{9x^2}{x^2} + \\dfrac{6x}{x^2} - \\dfrac{3}{x^2}} - 3 + \\dfrac{1}{x} \\right)" },
        { "tipe": "formula_block", "latex": "= \\sqrt{9 + 0 - 0} - 3 + 0 = 3 - 3 + 0 = 0" },
        { "tipe": "paragraph", "text": "Namun, jika pembilang dikelompokkan sebagai selisih akar $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{9x^2+6x-3} - 3x}{x} + \\dfrac{1}{x} = \\dfrac{6}{2\\sqrt{9}} + 0 = 1$." },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{4x^2 + 8x} - \\sqrt{4x^2 - 2x} \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{2}$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat $\\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "paragraph", "text": "Diketahui: $a = 4$, $b = 8$, dan $d = -2$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{8 - (-2)}{2\\sqrt{4}} = \\dfrac{10}{2(2)} = \\dfrac{10}{4} = \\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{5}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{(2x-1)^3}{(x+1)(x^2+1)}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi pembilang menghasilkan suku berderajat tertinggi: $(2x)^3 = 8x^3$." },
        { "tipe": "paragraph", "text": "Ekspansi penyebut menghasilkan suku berderajat tertinggi: $(x)(x^2) = x^3$." },
        { "tipe": "paragraph", "text": "Karena derajat pembilang sama dengan penyebut (3), limitnya adalah rasio koefisien pangkat tertinggi:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{8x^3 + \\dots}{x^3 + \\dots} = \\dfrac{8}{1} = 8" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 8." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 1} \\left( \\dfrac{1}{x-1} - \\dfrac{2}{x^2-1} \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung menghasilkan bentuk $\\infty - \\infty$. Samakan penyebutnya terlebih dahulu:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 1} \\left( \\dfrac{x+1}{x^2-1} - \\dfrac{2}{x^2-1} \\right) = \\lim\\limits_{x \\to 1} \\dfrac{x - 1}{x^2 - 1}" },
        { "tipe": "paragraph", "text": "Faktorkan penyebutnya:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 1} \\dfrac{x-1}{(x-1)(x+1)} = \\lim\\limits_{x \\to 1} \\dfrac{1}{x+1} = \\dfrac{1}{1+1} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 2} \\dfrac{x^3 - 4x}{x^2 - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan pembilang dan penyebut:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 2} \\dfrac{x(x^2 - 4)}{x^2 - 4} = \\lim\\limits_{x \\to 2} x = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x^2+4} - 2}{\\sqrt{x^2+9} - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung menghasilkan $0/0$. Kalikan dengan sekawan pembilang dan penyebut:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(\\sqrt{x^2+4} - 2)}{(\\sqrt{x^2+9} - 3)} \\cdot \\dfrac{(\\sqrt{x^2+4} + 2)}{(\\sqrt{x^2+4} + 2)} \\cdot \\dfrac{(\\sqrt{x^2+9} + 3)}{(\\sqrt{x^2+9} + 3)}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{(x^2+4 - 4)(\\sqrt{x^2+9} + 3)}{(x^2+9 - 9)(\\sqrt{x^2+4} + 2)} = \\lim\\limits_{x \\to 0} \\dfrac{x^2(\\sqrt{x^2+9} + 3)}{x^2(\\sqrt{x^2+4} + 2)}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x^2+9} + 3}{\\sqrt{x^2+4} + 2} = \\dfrac{\\sqrt{9} + 3}{\\sqrt{4} + 2} = \\dfrac{3+3}{2+2} = \\dfrac{6}{4} = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{3}{2}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
