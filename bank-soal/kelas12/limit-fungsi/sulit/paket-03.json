{
  "id": "bs-k12-limit-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit bentuk ∞ - ∞ dan akar pangkat tinggi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2 + 5x} - \\sqrt{x^2 + 3x}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{ax^2+bx} - \\sqrt{ax^2+cx}\\right) = \\dfrac{b-c}{2\\sqrt{a}}$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{5-3}{2\\sqrt{1}} = \\dfrac{2}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{4x^2 + 8x} - \\sqrt{4x^2 + 2x}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "= \\dfrac{8-2}{2\\sqrt{4}} = \\dfrac{6}{4} = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{3}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2 + 4x + 3} - x - 2\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis sebagai $\\sqrt{x^2+4x+3} - (x+2)$ lalu rasionalisasi:" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x^2+4x+3) - (x+2)^2}{\\sqrt{x^2+4x+3} + (x+2)} = \\dfrac{-1}{\\sqrt{x^2+4x+3} + x + 2}" },
        { "tipe": "formula_block", "latex": "\\to \\dfrac{-1}{\\infty} = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 0." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2 + x + 1} - \\sqrt{x^2 - x + 1}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "= \\dfrac{1-(-1)}{2\\sqrt{1}} = \\dfrac{2}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{3x^3 - 2x^2 + x}{5x^3 + x^2 - 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3}{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Derajat pembilang = derajat penyebut = 3, maka limit = rasio koefisien pangkat tertinggi." },
        { "tipe": "formula_block", "latex": "= \\dfrac{3}{5}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{3}{5}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{4x^4 + 3x^3}}{2x^2 + x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi dengan $x^2$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{4 + \\frac{3}{x}}}{2 + \\frac{1}{x}} = \\dfrac{2}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{x^2 + 3x}{\\sqrt{x^4 + 2x^2}}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi pembilang & penyebut dengan $x^2$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\dfrac{1 + \\frac{3}{x}}{\\sqrt{1 + \\frac{2}{x^2}}} = \\dfrac{1}{1} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{9x^2 + 6x} - 3x - 1\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis $\\sqrt{9x^2+6x} - 3x - 1 = (\\sqrt{9x^2+6x} - 3x) - 1$." },
        { "tipe": "paragraph", "text": "Dari rumus: $\\lim\\limits_{x \\to \\infty} (\\sqrt{9x^2+6x} - 3x) = \\dfrac{6}{2\\sqrt{9}} = \\dfrac{6}{6} = 1$." },
        { "tipe": "formula_block", "latex": "\\Rightarrow 1 - 1 = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 0." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2 + 2x} - \\sqrt{x^2 - 2x}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "= \\dfrac{2 - (-2)}{2\\sqrt{1}} = \\dfrac{4}{2} = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{x^2 + 3x}}{x + 1}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{1 + \\frac{3}{x}}}{1 + \\frac{1}{x}} = \\dfrac{1}{1} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
