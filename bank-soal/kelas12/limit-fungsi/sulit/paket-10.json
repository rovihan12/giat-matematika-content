{
  "id": "bs-k12-limit-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit bentuk khusus, manipulasi akar pangkat tinggi, dan analisis fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{25x^2 - 9x - 16} - 5x + 3 \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{39}{10}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{21}{10}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{9}{10}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{39}{10}$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelompokkan suku aljabar menjadi selisih akar dengan memangkatkan $(5x - 3)$ menjadi $\\sqrt{(5x-3)^2} = \\sqrt{25x^2 - 30x + 9}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{25x^2 - 9x - 16} - \\sqrt{25x^2 - 30x + 9} \\right)" },
        { "tipe": "paragraph", "text": "Gunakan rumus cepat selisih akar $\\dfrac{b-d}{2\\sqrt{a}}$ dengan $a=25$, $b=-9$, dan $d=-30$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{-9 - (-30)}{2\\sqrt{25}} = \\dfrac{-9 + 30}{2(5)} = \\dfrac{21}{10}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{21}{10}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{6x^2 - x + 7} - \\sqrt{6x^2 + 5x - 1} \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\sqrt{6}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}\\sqrt{6}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}\\sqrt{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat selisih akar tak hingga: $\\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "paragraph", "text": "Diketahui: $a = 6$, $b = -1$, dan $d = 5$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{-1 - 5}{2\\sqrt{6}} = \\dfrac{-6}{2\\sqrt{6}} = -\\dfrac{3}{\\sqrt{6}}" },
        { "tipe": "paragraph", "text": "Rasionalkan penyebut dengan mengalikan $\\dfrac{\\sqrt{6}}{\\sqrt{6}}$:" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{3\\sqrt{6}}{6} = -\\dfrac{1}{2}\\sqrt{6}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{1}{2}\\sqrt{6}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{4x^2 - 2x + 1} - 2x + 1 \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah bentuk $(2x - 1)$ menjadi akar: $(2x-1) = \\sqrt{4x^2 - 4x + 1}$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{4x^2 - 2x + 1} - \\sqrt{4x^2 - 4x + 1} \\right)" },
        { "tipe": "paragraph", "text": "Gunakan rumus cepat $\\dfrac{b-d}{2\\sqrt{a}}$ dengan $a=4$, $b=-2$, dan $d=-4$:" },
        { "tipe": "formula_block", "latex": "= \\dfrac{-2 - (-4)}{2\\sqrt{4}} = \\dfrac{2}{4} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\dfrac{3x}{\\sqrt{x^2+1}} - 2 \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Evaluasi limit pertama: $\\lim\\limits_{x \\to \\infty} \\dfrac{3x}{\\sqrt{x^2+1}}$. Bagi pembilang dan penyebut dengan $x$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\dfrac{3}{\\sqrt{1+\\frac{1}{x^2}}} = \\dfrac{3}{\\sqrt{1+0}} = 3" },
        { "tipe": "paragraph", "text": "Maka limit totalnya:" },
        { "tipe": "formula_block", "latex": "= 3 - 2 = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = \\sqrt{x+2}$, maka $\\lim\\limits_{h \\to 0} \\dfrac{f(x+h) - f(x)}{h}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2\\sqrt{x+2}}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\sqrt{x+2}}$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{x+2}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{x+2}$"}],
        [{"tipe":"paragraph","text":"$0$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ini adalah definisi turunan dari $f(x) = (x+2)^{1/2}$." },
        { "tipe": "formula_block", "latex": "f'(x) = \\dfrac{1}{2}(x+2)^{-1/2} \\cdot 1 = \\dfrac{1}{2\\sqrt{x+2}}" },
        { "tipe": "paragraph", "text": "Atau menggunakan perkalian sekawan:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{h \\to 0} \\dfrac{\\sqrt{x+h+2} - \\sqrt{x+2}}{h} \\cdot \\dfrac{\\sqrt{x+h+2} + \\sqrt{x+2}}{\\sqrt{x+h+2} + \\sqrt{x+2}}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{h \\to 0} \\dfrac{(x+h+2) - (x+2)}{h(\\sqrt{x+h+2} + \\sqrt{x+2})} = \\dfrac{1}{2\\sqrt{x+2}}" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya adalah $\\dfrac{1}{2\\sqrt{x+2}}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin(\\pi x)}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{\\pi}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\pi$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat limit trigonometri dasar $\\lim\\limits_{x \\to 0} \\dfrac{\\sin(ax)}{x} = a$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin(\\pi x)}{x} = \\pi" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\pi$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $f(x) = \\begin{cases} 2x + 1, & x < 2 \\\\ x^2 - 1, & x \\geq 2 \\end{cases}$. Nilai $\\lim\\limits_{x \\to 2} f(x)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"Tidak ada limit"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek limit kiri ($x < 2$): $\\lim\\limits_{x \\to 2^-} (2x+1) = 2(2)+1 = 5$." },
        { "tipe": "paragraph", "text": "Cek limit kanan ($x \\geq 2$): $\\lim\\limits_{x \\to 2^+} (x^2-1) = 2^2-1 = 3$." },
        { "tipe": "paragraph", "text": "Karena limit kiri $\\neq$ limit kanan ($5 \\neq 3$), maka limit fungsi di titik $x=2$ **tidak ada**." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah Tidak ada limit." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{x^2 + x} - x \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{x^2+x} + x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{(x^2+x) - x^2}{\\sqrt{x^2+x} + x} = \\lim\\limits_{x \\to \\infty} \\dfrac{x}{\\sqrt{x^2+x} + x}" },
        { "tipe": "paragraph", "text": "Bagi dengan $x$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to \\infty} \\dfrac{1}{\\sqrt{1 + \\frac{1}{x}} + 1} = \\dfrac{1}{1+1} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+x} - 1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan pembilang $\\sqrt{1+x} + 1$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(1+x) - 1}{x(\\sqrt{1+x} + 1)} = \\lim\\limits_{x \\to 0} \\dfrac{x}{x(\\sqrt{1+x} + 1)}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{1}{\\sqrt{1+x} + 1} = \\dfrac{1}{\\sqrt{1} + 1} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sqrt{4x^2 + 3x - 1} - 2x}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bagi pembilang dan penyebut dengan $x$ (masukkan $x$ ke dalam bentuk akar sebagai $x^2$):" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\left( \\sqrt{\\dfrac{4x^2}{x^2} + \\dfrac{3x}{x^2} - \\dfrac{1}{x^2}} - \\dfrac{2x}{x} \\right) = \\lim\\limits_{x \\to \\infty} \\left( \\sqrt{4 + \\dfrac{3}{x} - \\dfrac{1}{x^2}} - 2 \\right)" },
        { "tipe": "formula_block", "latex": "= \\sqrt{4+0-0} - 2 = 2 - 2 = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $0$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
