{
  "id": "bs-k12-limit-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit trigonometri lanjutan, bentuk tak tentu, dan teorema apit",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan 2x \\cdot \\cos 8x - \\tan 2x}{16x^3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$-6$"}],
        [{"tipe":"paragraph","text":"$-8$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$32$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan pembilang dengan mengeluarkan $\\tan 2x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\tan 2x(\\cos 8x - 1)}{16x^3}" },
        { "tipe": "paragraph", "text": "Gunakan identitas $\\cos 8x - 1 = -2\\sin^2 4x$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{\\tan 2x(-2\\sin^2 4x)}{16x^3} = -\\dfrac{2}{16} \\lim\\limits_{x \\to 0} \\left( \\dfrac{\\tan 2x}{x} \\cdot \\dfrac{\\sin^2 4x}{x^2} \\right)" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{8} \\cdot (2) \\cdot (4)^2 = -\\dfrac{1}{8} \\cdot 2 \\cdot 16 = -4" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\cos^2 x - 1}{x \\tan x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas trigonometri $\\cos^2 x - 1 = -\\sin^2 x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{-\\sin^2 x}{x \\tan x} = -\\lim\\limits_{x \\to 0} \\left( \\dfrac{\\sin x}{x} \\cdot \\dfrac{\\sin x}{\\tan x} \\right)" },
        { "tipe": "formula_block", "latex": "= - (1) \\cdot (1) = -1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin x + \\sin 3x}{2x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pecah limitnya menjadi dua bagian:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sin x}{2x} + \\lim\\limits_{x \\to 0} \\dfrac{\\sin 3x}{2x}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2}(1) + \\dfrac{3}{2}(1) = \\dfrac{1}{2} + \\dfrac{3}{2} = \\dfrac{4}{2} = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\cos 4x - 1}{x \\tan x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-8$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas trigonometri $\\cos 4x - 1 = -2\\sin^2 2x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{-2\\sin^2 2x}{x \\tan x} = -2 \\cdot \\lim\\limits_{x \\to 0} \\left( \\dfrac{\\sin 2x}{x} \\cdot \\dfrac{\\sin 2x}{\\tan x} \\right)" },
        { "tipe": "formula_block", "latex": "= -2 \\cdot (2) \\cdot (2) = -8" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-8$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{1+\\tan x} - \\sqrt{1-\\tan x}}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{1+\\tan x} + \\sqrt{1-\\tan x}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{(1+\\tan x) - (1-\\tan x)}{x(\\sqrt{1+\\tan x} + \\sqrt{1-\\tan x})} = \\lim\\limits_{x \\to 0} \\dfrac{2\\tan x}{x(\\sqrt{1+\\tan x} + \\sqrt{1-\\tan x})}" },
        { "tipe": "formula_block", "latex": "= 2 \\cdot \\lim\\limits_{x \\to 0} \\left( \\dfrac{\\tan x}{x} \\cdot \\dfrac{1}{\\sqrt{1+\\tan x} + \\sqrt{1-\\tan x}} \\right)" },
        { "tipe": "formula_block", "latex": "= 2 \\cdot 1 \\cdot \\dfrac{1}{1 + 1} = \\dfrac{2}{2} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\tan x - \\sin x}{x^3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $\\tan x - \\sin x = \\tan x (1 - \\cos x)$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\tan x (1 - \\cos x)}{x^3}" },
        { "tipe": "paragraph", "text": "Gunakan $1 - \\cos x = 2\\sin^2 \\frac{x}{2}$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\left( \\dfrac{\\tan x}{x} \\cdot \\dfrac{2\\sin^2 \\frac{x}{2}}{x^2} \\right)" },
        { "tipe": "formula_block", "latex": "= 1 \\cdot 2 \\cdot \\left(\\dfrac{1}{2}\\right)^2 = 1 \\cdot 2 \\cdot \\dfrac{1}{4} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\dfrac{\\sin(1/x)}{1/x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = \\dfrac{1}{x}$. Saat $x \\to \\infty$, maka $u \\to 0$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{\\sin(1/x)}{1/x} = \\lim\\limits_{u \\to 0} \\dfrac{\\sin u}{u} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{1 - \\cos x}{x \\sin x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\cos x = 2\\sin^2 \\frac{x}{2}$ dan $\\sin x = 2\\sin \\frac{x}{2}\\cos \\frac{x}{2}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{2\\sin^2 \\frac{x}{2}}{x(2\\sin \\frac{x}{2}\\cos \\frac{x}{2})} = \\lim\\limits_{x \\to 0} \\dfrac{\\sin \\frac{x}{2}}{x \\cos \\frac{x}{2}}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\left( \\dfrac{1}{2} \\cdot \\dfrac{\\sin \\frac{x}{2}}{\\frac{x}{2}} \\cdot \\dfrac{1}{\\cos \\frac{x}{2}} \\right)" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2} \\cdot 1 \\cdot 1 = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sin(\\sin x)}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis ulang fungsinya:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\left( \\dfrac{\\sin(\\sin x)}{\\sin x} \\cdot \\dfrac{\\sin x}{x} \\right)" },
        { "tipe": "paragraph", "text": "Karena $\\sin x \\to 0$ saat $x \\to 0$, maka $\\lim\\limits_{u \\to 0} \\frac{\\sin u}{u} = 1$." },
        { "tipe": "formula_block", "latex": "= 1 \\cdot 1 = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} x^2 \\cdot \\cos \\dfrac{1}{x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}],
        [{"tipe":"paragraph","text":"Tidak ada"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan Teorema Apit (Squeeze Theorem). Kita tahu bahwa nilai $\\cos\\left(\\frac{1}{x}\\right)$ selalu berada di antara $-1$ dan $1$:" },
        { "tipe": "formula_block", "latex": "-1 \\leq \\cos\\left(\\dfrac{1}{x}\\right) \\leq 1" },
        { "tipe": "paragraph", "text": "Kalikan semua ruas dengan $x^2$ (karena $x^2 \\geq 0$, tanda pertidaksamaan tidak berubah):" },
        { "tipe": "formula_block", "latex": "-x^2 \\leq x^2 \\cos\\left(\\dfrac{1}{x}\\right) \\leq x^2" },
        { "tipe": "paragraph", "text": "Karena $\\lim\\limits_{x \\to 0} (-x^2) = 0$ dan $\\lim\\limits_{x \\to 0} (x^2) = 0$, maka berdasarkan Teorema Apit:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} x^2 \\cos\\left(\\dfrac{1}{x}\\right) = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 0." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
