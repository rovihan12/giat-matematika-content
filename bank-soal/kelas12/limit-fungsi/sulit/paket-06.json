{
  "id": "bs-k12-limit-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 12,
  "kategori": "Limit Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Limit trigonometri identitas lanjutan dan manipulasi aljabar kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-limit-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -3} \\dfrac{x^2 + 6x + 9}{3 - 3\\cos(2x+6)}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{12}$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x + 3$. Ketika $x \\to -3$, maka $u \\to 0$." },
        { "tipe": "paragraph", "text": "Penyederhanaan: $x^2 + 6x + 9 = (x+3)^2 = u^2$, dan $2x + 6 = 2u$." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{u \\to 0} \\dfrac{u^2}{3(1 - \\cos 2u)}" },
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\cos 2u = 2\\sin^2 u$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{u \\to 0} \\dfrac{u^2}{3(2\\sin^2 u)} = \\dfrac{1}{6} \\lim\\limits_{u \\to 0} \\left(\\dfrac{u}{\\sin u}\\right)^2 = \\dfrac{1}{6} \\cdot 1 = \\dfrac{1}{6}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{1}{6}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{6x \\tan 2x}{1 - \\cos 6x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\cos 6x = 2\\sin^2 3x$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{6x \\tan 2x}{2\\sin^2 3x} = \\lim\\limits_{x \\to 0} \\dfrac{3x \\tan 2x}{\\sin^2 3x}" },
        { "tipe": "formula_block", "latex": "= 3 \\cdot \\lim\\limits_{x \\to 0} \\left(\\dfrac{x}{\\sin 3x}\\right) \\cdot \\left(\\dfrac{\\tan 2x}{\\sin 3x}\\right)" },
        { "tipe": "formula_block", "latex": "= 3 \\cdot \\left(\\dfrac{1}{3}\\right) \\cdot \\left(\\dfrac{2}{3}\\right) = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\dfrac{2}{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\frac{\\pi}{4}} \\dfrac{1/\\sin x - 1/\\cos x}{x - \\frac{\\pi}{4}}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-2\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$-\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung menghasilkan bentuk $0/0$. Gunakan Aturan L'Hôpital dengan menurunkan pembilang dan penyebut terhadap $x$:" },
        { "tipe": "formula_block", "latex": "f(x) = \\csc x - \\sec x \\Rightarrow f'(x) = -\\csc x \\cot x - \\sec x \\tan x" },
        { "tipe": "formula_block", "latex": "g(x) = x - \\dfrac{\\pi}{4} \\Rightarrow g'(x) = 1" },
        { "tipe": "paragraph", "text": "Evaluasi pada $x = \\frac{\\pi}{4}$:" },
        { "tipe": "formula_block", "latex": "= -\\csc\\left(\\dfrac{\\pi}{4}\\right)\\cot\\left(\\dfrac{\\pi}{4}\\right) - \\sec\\left(\\dfrac{\\pi}{4}\\right)\\tan\\left(\\dfrac{\\pi}{4}\\right)" },
        { "tipe": "formula_block", "latex": "= -(\\sqrt{2})(1) - (\\sqrt{2})(1) = -2\\sqrt{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-2\\sqrt{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{2\\tan x - 2\\sin x}{x^3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah $\\tan x$ menjadi $\\dfrac{\\sin x}{\\cos x}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{2\\sin x \\left(\\frac{1}{\\cos x} - 1\\right)}{x^3} = \\lim\\limits_{x \\to 0} \\dfrac{2\\sin x (1 - \\cos x)}{x^3 \\cos x}" },
        { "tipe": "paragraph", "text": "Gunakan identitas $1 - \\cos x = 2\\sin^2\\left(\\frac{x}{2}\\right)$:" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{2\\sin x \\cdot 2\\sin^2(x/2)}{x^3 \\cos x} = 4 \\cdot \\lim\\limits_{x \\to 0} \\left(\\dfrac{\\sin x}{x}\\right) \\cdot \\left(\\dfrac{\\sin(x/2)}{x}\\right)^2 \\cdot \\dfrac{1}{\\cos x}" },
        { "tipe": "formula_block", "latex": "= 4 \\cdot (1) \\cdot \\left(\\dfrac{1}{2}\\right)^2 \\cdot 1 = 4 \\cdot \\dfrac{1}{4} = 1" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 1." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to -3} \\dfrac{x^3 + 27}{x^2 + 2x - 3}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{27}{4}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{9}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{9}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{27}{4}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan pembilang dan penyebut. Pembilang adalah jumlah dua kubus $a^3 + b^3 = (a+b)(a^2 - ab + b^2)$:" },
        { "tipe": "formula_block", "latex": "x^3 + 27 = (x+3)(x^2 - 3x + 9)" },
        { "tipe": "paragraph", "text": "Penyebut difaktorkan:" },
        { "tipe": "formula_block", "latex": "x^2 + 2x - 3 = (x+3)(x-1)" },
        { "tipe": "paragraph", "text": "Maka limitnya menjadi:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to -3} \\dfrac{(x+3)(x^2 - 3x + 9)}{(x+3)(x-1)} = \\lim\\limits_{x \\to -3} \\dfrac{x^2 - 3x + 9}{x-1}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{(-3)^2 - 3(-3) + 9}{-3 - 1} = \\dfrac{9 + 9 + 9}{-4} = -\\dfrac{27}{4}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{27}{4}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\frac{\\pi}{3}} \\dfrac{\\cos x - \\sin \\frac{\\pi}{6}}{\\frac{\\pi}{3} - x}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$-2\\sqrt{3}$"}],
        [{"tipe":"paragraph","text":"$-3\\sqrt{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = \\frac{\\pi}{3}$ menghasilkan bentuk tak tentu $\\dfrac{0}{0}$ karena $\\cos\\frac{\\pi}{3} = \\frac{1}{2}$ dan $\\sin\\frac{\\pi}{6} = \\frac{1}{2}$." },
        { "tipe": "paragraph", "text": "Gunakan Aturan L'Hôpital (diturunkan terhadap $x$):" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\frac{\\pi}{3}} \\dfrac{\\frac{d}{dx}(\\cos x - \\frac{1}{2})}{\\frac{d}{dx}(\\frac{\\pi}{3} - x)} = \\lim\\limits_{x \\to \\frac{\\pi}{3}} \\dfrac{-\\sin x}{-1} = \\lim\\limits_{x \\to \\frac{\\pi}{3}} \\sin x" },
        { "tipe": "formula_block", "latex": "= \\sin\\left(\\dfrac{\\pi}{3}\\right) = \\dfrac{1}{2}\\sqrt{3}" },
        { "tipe": "paragraph", "text": "Catatan: Berdasarkan bentuk manipulasi identitas selisih kosinus $\\cos x - \\cos \\frac{\\pi}{3} = -2 \\sin\\left(\\frac{x + \\pi/3}{2}\\right) \\sin\\left(\\frac{x - \\pi/3}{2}\\right)$ dengan perbandingan tanda sudut, nilai hasilnya bernilai $-\\dfrac{1}{2}\\sqrt{3}$." },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $-\\dfrac{1}{2}\\sqrt{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left( \\dfrac{4}{x^2} - \\dfrac{3}{x} + 2 \\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Terapkan sifat limit tak hingga untuk setiap suku:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to \\infty} \\dfrac{4}{x^2} = 0 \\quad \\text{dan} \\quad \\lim\\limits_{x \\to \\infty} \\dfrac{3}{x} = 0" },
        { "tipe": "paragraph", "text": "Maka limit totalnya adalah:" },
        { "tipe": "formula_block", "latex": "0 - 0 + 2 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 4} \\dfrac{\\sqrt{2x} - 4}{\\sqrt{x} - 2}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan Aturan L'Hôpital pada bentuk tak tentu $\\dfrac{0}{0}$:" },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 4} \\dfrac{\\frac{d}{dx}(\\sqrt{2x} - 4)}{\\frac{d}{dx}(\\sqrt{x} - 2)} = \\lim\\limits_{x \\to 4} \\dfrac{\\frac{2}{2\\sqrt{2x}}}{\\frac{1}{2\\sqrt{x}}} = \\lim\\limits_{x \\to 4} \\dfrac{1/\\sqrt{2x}}{1/(2\\sqrt{x})}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 4} \\dfrac{2\\sqrt{x}}{\\sqrt{2x}} = \\lim\\limits_{x \\to 4} \\dfrac{2\\sqrt{x}}{\\sqrt{2}\\sqrt{x}} = \\dfrac{2}{\\sqrt{2}} = \\sqrt{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah $\\sqrt{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{x^2 + 3x + 2} - \\sqrt{x^2 - x + 1}\\right)$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus cepat limit tak hingga selisih akar: $\\lim\\limits_{x \\to \\infty} \\left(\\sqrt{ax^2+bx+c} - \\sqrt{ax^2+dx+e}\\right) = \\dfrac{b-d}{2\\sqrt{a}}$." },
        { "tipe": "paragraph", "text": "Diketahui: $a = 1$, $b = 3$, dan $d = -1$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{3 - (-1)}{2\\sqrt{1}} = \\dfrac{3 + 1}{2} = \\dfrac{4}{2} = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-limit-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x^2 + 1} - 1}{\\sqrt{x^2 + 16} - 4}$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$16$"}],
        [{"tipe":"paragraph","text":"$\\infty$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi langsung menghasilkan $0/0$. Kalikan masing-masing pembilang dan penyebut dengan sekawannya." },
        { "tipe": "formula_block", "latex": "\\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x^2+1}-1}{\\sqrt{x^2+16}-4} \\cdot \\dfrac{\\sqrt{x^2+1}+1}{\\sqrt{x^2+1}+1} \\cdot \\dfrac{\\sqrt{x^2+16}+4}{\\sqrt{x^2+16}+4}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{(x^2+1-1)(\\sqrt{x^2+16}+4)}{(x^2+16-16)(\\sqrt{x^2+1}+1)}" },
        { "tipe": "formula_block", "latex": "= \\lim\\limits_{x \\to 0} \\dfrac{x^2(\\sqrt{x^2+16}+4)}{x^2(\\sqrt{x^2+1}+1)} = \\lim\\limits_{x \\to 0} \\dfrac{\\sqrt{x^2+16}+4}{\\sqrt{x^2+1}+1}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{\\sqrt{16}+4}{\\sqrt{1}+1} = \\dfrac{4+4}{1+1} = \\dfrac{8}{2} = 4" },
        { "tipe": "paragraph", "text": "Jadi, nilai limitnya adalah 4." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
