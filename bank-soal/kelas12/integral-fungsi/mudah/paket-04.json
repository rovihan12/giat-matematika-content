{
  "id": "bs-k12-integral-mudah-04",
  "nama": "Bank Soal Mudah - Paket 4",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Integral tentu sederhana",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-mudah-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{2} 3x^2 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$12$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{2} 3x^2 \\, dx = \\left[ x^3 \\right]_{0}^{2} = 8 - 0 = 8" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 8." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{3} 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$12$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{3} 2x \\, dx = \\left[ x^2 \\right]_{1}^{3} = 9 - 1 = 8" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 8." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{1} (2x + 1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{1} (2x + 1) \\, dx = \\left[ x^2 + x \\right]_{0}^{1} = (1 + 1) - 0 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{2} (x^2 + 1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{7}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{10}{3}$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{2} (x^2 + 1) \\, dx = \\left[ \\dfrac{x^3}{3} + x \\right]_{1}^{2}" },
        { "tipe": "formula_block", "latex": "= \\left( \\dfrac{8}{3} + 2 \\right) - \\left( \\dfrac{1}{3} + 1 \\right) = \\dfrac{7}{3} + 1 = \\dfrac{10}{3}" },
        { "tipe": "paragraph", "text": "Jadi, nilainya $\\dfrac{10}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{3} (x^2 - 2x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$-3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{3} (x^2 - 2x) \\, dx = \\left[ \\dfrac{x^3}{3} - x^2 \\right]_{0}^{3} = (9 - 9) - 0 = 0" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 0." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{-1}^{1} x^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{-1}^{1} x^3 \\, dx = \\left[ \\dfrac{x^4}{4} \\right]_{-1}^{1} = \\dfrac{1}{4} - \\dfrac{1}{4} = 0" },
        { "tipe": "paragraph", "text": "Karena $x^3$ fungsi ganjil dan batas simetris, integralnya = 0." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{2} 4x^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$16$"}],
        [{"tipe":"paragraph","text":"$20$"}],
        [{"tipe":"paragraph","text":"$32$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{2} 4x^3 \\, dx = \\left[ x^4 \\right]_{0}^{2} = 16 - 0 = 16" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 16." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{4} \\dfrac{1}{\\sqrt{x}} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{4} x^{-1/2} \\, dx = \\left[ 2\\sqrt{x} \\right]_{1}^{4} = 2(2) - 2(1) = 4 - 2 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{1} (3x^2 + 2x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{1} (3x^2 + 2x) \\, dx = \\left[ x^3 + x^2 \\right]_{0}^{1} = (1 + 1) - 0 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 2." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{3} (2x + 1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$15$"}],
        [{"tipe":"paragraph","text":"$18$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{3} (2x + 1) \\, dx = \\left[ x^2 + x \\right]_{0}^{3} = (9 + 3) - 0 = 12" },
        { "tipe": "paragraph", "text": "Jadi, nilainya 12." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
