      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^3 - x$ adalah fungsi ganjil dan batas simetris, sehingga integralnya 0." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-07-q06",
      "pertanyaan": [
