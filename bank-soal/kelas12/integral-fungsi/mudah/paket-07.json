      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{50}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{28}{3}$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{32}{3}$"}],
        [{"tipe":"paragraph","text":"$10$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{3} (x^2 + 2x) \\, dx = [\\dfrac{1}{3}x^3 + x^2]_{1}^{3} = (9 + 9) - (\\dfrac{1}{3} + 1) = 18 - \\dfrac{4}{3} = \\dfrac{54-4}{3} = \\dfrac{50}{3}" }
      ],
      "tingkat": "MUDAH"
    },
    {
