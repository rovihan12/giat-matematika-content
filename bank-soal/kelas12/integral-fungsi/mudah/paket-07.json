        [{"tipe":"paragraph","text":"$18$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{3} (2x + 1) \\, dx = [x^2 + x]_{1}^{3} = (9+3) - (1+1) = 12 - 2 = 10" }
