      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{32}{3}$"}],
        [{"tipe":"paragraph","text":"$32$"}],
        [{"tipe":"paragraph","text":"$24$"}],
        [{"tipe":"paragraph","text":"$48$"}],
        [{"tipe":"paragraph","text":"$64$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{4} (12t - 4t^2) \\, dt = [6t^2 - \\dfrac{4}{3}t^3]_{0}^{4} = (96 - \\dfrac{256}{3}) = \\dfrac{288-256}{3} = \\dfrac{32}{3}" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{4} \\dfrac{2}{x\\sqrt{x}} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah bentuk: $\\dfrac{2}{x\\sqrt{x}} = 2x^{-3/2}$." },
        { "tipe": "formula_block", "latex": "\\int_{1}^{4} 2x^{-3/2} \\, dx = [\\dfrac{2}{-1/2}x^{-1/2}]_{1}^{4} = [-4x^{-1/2}]_{1}^{4} = -4(\\dfrac{1}{2}) - (-4) = -2 + 4 = 2" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{-1}^{2} (3x - 1)(x + 5) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$45$"}],
        [{"tipe":"paragraph","text":"$37$"}],
        [{"tipe":"paragraph","text":"$51$"}],
        [{"tipe":"paragraph","text":"$41$"}],
        [{"tipe":"paragraph","text":"$15$"}]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $(3x-1)(x+5) = 3x^2 + 14x - 5$." },
        { "tipe": "formula_block", "latex": "\\int_{-1}^{2} (3x^2 + 14x - 5) \\, dx = [x^3 + 7x^2 - 5x]_{-1}^{2} = (8+28-10) - (-1+7+5) = 26 - 11 = 15" }
      ],
      "tingkat": "MUDAH"
    },
    {
