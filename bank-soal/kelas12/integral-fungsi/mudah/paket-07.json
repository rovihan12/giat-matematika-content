      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$15$"}],
        [{"tipe":"paragraph","text":"$5$"}],
        [{"tipe":"paragraph","text":"$-5$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{4} (4x - 5) \\, dx = [2x^2 - 5x]_{1}^{4} = (32-20) - (2-5) = 12 - (-3) = 15" }
