{
  "id": "bs-k12-integral-mudah-10",
  "nama": "Bank Soal Mudah - Paket 10",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Integral bentuk akar dan pangkat rasional",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-mudah-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{1}{x^4} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3x^3} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3x^3} + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4x^4} + C$"}],
        [{"tipe":"paragraph","text":"$\\ln x^4 + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{4}{x^5} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis $\\dfrac{1}{x^4} = x^{-4}$." },
        { "tipe": "formula_block", "latex": "\\int x^{-4} \\, dx = \\dfrac{x^{-3}}{-3} + C = -\\dfrac{1}{3x^3} + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sqrt[3]{x} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3x^{4/3}}{4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^{4/3}}{4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4x^{3/4}}{3} + C$"}],
        [{"tipe":"paragraph","text":"$x^{4/3} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3x^{1/3}}{4} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tulis $\\sqrt[3]{x} = x^{1/3}$." },
        { "tipe": "formula_block", "latex": "\\int x^{1/3} \\, dx = \\dfrac{x^{4/3}}{4/3} + C = \\dfrac{3x^{4/3}}{4} + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (3\\sqrt{x} + 2) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^{3/2} + 2x + C$"}],
        [{"tipe":"paragraph","text":"$2x^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}x^{3/2} + 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}x^{3/2} + 2x + C$"}],
        [{"tipe":"paragraph","text":"$2x^{1/2} + 2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int (3x^{1/2} + 2) \\, dx = 3 \\cdot \\dfrac{2}{3}x^{3/2} + 2x + C = 2x^{3/2} + 2x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\left( \\sqrt{x} + \\dfrac{1}{\\sqrt{x}} \\right) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}x^{3/2} + 2x^{1/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}x^{3/2} + 2x^{1/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}x^{3/2} + \\dfrac{1}{2}x^{1/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}x^{3/2} + 2x^{1/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}x^{2/3} + 2x^{1/2} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int (x^{1/2} + x^{-1/2}) \\, dx = \\dfrac{2}{3}x^{3/2} + 2x^{1/2} + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x + 2)(x - 3) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 - \\dfrac{1}{2}x^2 - 6x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 - \\dfrac{1}{2}x^2 + 6x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 + \\dfrac{1}{2}x^2 - 6x + C$"}],
        [{"tipe":"paragraph","text":"$2x - 1 + C$"}],
        [{"tipe":"paragraph","text":"$x^2 - x - 6 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $(x+2)(x-3) = x^2 - x - 6$." },
        { "tipe": "formula_block", "latex": "\\int (x^2 - x - 6) \\, dx = \\dfrac{1}{3}x^3 - \\dfrac{1}{2}x^2 - 6x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x^2 + 1)^2 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}x^5 + \\dfrac{2}{3}x^3 + x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}x^4 + x^2 + 1 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 + 2x + C$"}],
        [{"tipe":"paragraph","text":"$2x(x^2+1) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}x^5 + \\dfrac{1}{3}x^3 + x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $(x^2+1)^2 = x^4 + 2x^2 + 1$." },
        { "tipe": "formula_block", "latex": "\\int (x^4 + 2x^2 + 1) \\, dx = \\dfrac{1}{5}x^5 + \\dfrac{2}{3}x^3 + x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{x^3 + 2x}{x} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 + 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 + 2 + C$"}],
        [{"tipe":"paragraph","text":"$x^3 + 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}x^2 + 2 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}x^4 + x^2 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sederhanakan: $\\dfrac{x^3 + 2x}{x} = x^2 + 2$." },
        { "tipe": "formula_block", "latex": "\\int (x^2 + 2) \\, dx = \\dfrac{1}{3}x^3 + 2x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (2x + 1)^2 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}x^3 + 2x^2 + x + C$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 2x^2 + x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}(2x+1)^3 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(2x+1)^3 + C$"}],
        [{"tipe":"paragraph","text":"$4x^2 + 4x + 1 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $(2x+1)^2 = 4x^2 + 4x + 1$." },
        { "tipe": "formula_block", "latex": "\\int (4x^2 + 4x + 1) \\, dx = \\dfrac{4}{3}x^3 + 2x^2 + x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{1}{2\\sqrt{x}} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sqrt{x} + C$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{x} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sqrt{x} + C$"}],
        [{"tipe":"paragraph","text":"$4\\sqrt{x} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4\\sqrt{x}} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2} x^{-1/2} \\, dx = \\dfrac{1}{2} \\cdot 2x^{1/2} + C = \\sqrt{x} + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $F'(x) = 2x + 3$ dan $F(1) = 6$, maka $F(x) = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 + 3x + 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + 3x - 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + 3x + 6$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 3x + 1$"}],
        [{"tipe":"paragraph","text":"$x^2 + 3x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "F(x) = \\int (2x + 3) \\, dx = x^2 + 3x + C" },
        { "tipe": "paragraph", "text": "$F(1) = 1 + 3 + C = 6 \\Rightarrow C = 2$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
