      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $F(x) = \\int (2x + 1) \\, dx$ dan $F(1) = 5$, maka $F(x)$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 + x + 3$"}],
        [{"tipe":"paragraph","text":"$x^2 + x + 5$"}],
        [{"tipe":"paragraph","text":"$x^2 + x - 3$"}],
        [{"tipe":"paragraph","text":"$2x^2 + x + 2$"}],
        [{"tipe":"paragraph","text":"$x^2 + x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int (2x + 1) \\, dx = x^2 + x + C" },
        { "tipe": "paragraph", "text": "Syarat $F(1) = 5$: $1 + 1 + C = 5 \\Rightarrow C = 3$." },
        { "tipe": "formula_block", "latex": "F(x) = x^2 + x + 3" }
      ],
      "tingkat": "MUDAH"
    },
