{
  "id": "bs-k12-integral-mudah-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "MUDAH",
  "deskripsi": "Integral tak tentu fungsi aljabar dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-mudah-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{x^4}{4} + C$"}],
        [{"tipe":"paragraph","text":"$x^4 + C$"}],
        [{"tipe":"paragraph","text":"$3x^2 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^3}{3} + C$"}],
        [{"tipe":"paragraph","text":"$4x^3 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan pangkat: $\\int x^n \\, dx = \\dfrac{x^{n+1}}{n+1} + C$." },
        { "tipe": "formula_block", "latex": "\\int x^3 \\, dx = \\dfrac{x^{3+1}}{3+1} + C = \\dfrac{x^4}{4} + C" },
        { "tipe": "paragraph", "text": "Verifikasi: turunan $\\dfrac{x^4}{4}$ = $x^3$. ✅" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x^5 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{x^6}{6} + C$"}],
        [{"tipe":"paragraph","text":"$5x^4 + C$"}],
        [{"tipe":"paragraph","text":"$x^6 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^5}{5} + C$"}],
        [{"tipe":"paragraph","text":"$6x^5 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int x^5 \\, dx = \\dfrac{x^6}{6} + C" },
        { "tipe": "paragraph", "text": "Verifikasi: turunan $\\dfrac{x^6}{6}$ = $x^5$. ✅" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 4 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4x + C$"}],
        [{"tipe":"paragraph","text":"$4 + C$"}],
        [{"tipe":"paragraph","text":"$0 + C$"}],
        [{"tipe":"paragraph","text":"$x + C$"}],
        [{"tipe":"paragraph","text":"$4x^2 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Integral konstanta: $\\int k \\, dx = kx + C$." },
        { "tipe": "formula_block", "latex": "\\int 4 \\, dx = 4x + C" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya $4x + C$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 7x^2 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{7x^3}{3} + C$"}],
        [{"tipe":"paragraph","text":"$7x^3 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^3}{3} + C$"}],
        [{"tipe":"paragraph","text":"$14x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{7x^2}{2} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int 7x^2 \\, dx = 7 \\cdot \\dfrac{x^3}{3} + C = \\dfrac{7x^3}{3} + C" },
        { "tipe": "paragraph", "text": "Verifikasi: turunan $\\dfrac{7x^3}{3}$ = $7x^2$. ✅" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (3x^2 + 2x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^3 + x^2 + C$"}],
        [{"tipe":"paragraph","text":"$3x^3 + x^2 + C$"}],
        [{"tipe":"paragraph","text":"$x^3 + 2x^2 + C$"}],
        [{"tipe":"paragraph","text":"$x^3 + x^2$"}],
        [{"tipe":"paragraph","text":"$6x + 2 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int 3x^2 \\, dx = x^3, \\quad \\int 2x \\, dx = x^2" },
        { "tipe": "formula_block", "latex": "\\int (3x^2 + 2x) \\, dx = x^3 + x^2 + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x^2 - 4x + 5) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{x^3}{3} - 2x^2 + 5x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^3}{3} - 4x^2 + 5x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^3}{3} - 2x^2 + 5 + C$"}],
        [{"tipe":"paragraph","text":"$x^3 - 2x^2 + 5x + C$"}],
        [{"tipe":"paragraph","text":"$2x - 4 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int x^2 \\, dx = \\dfrac{x^3}{3}, \\quad \\int 4x \\, dx = 2x^2, \\quad \\int 5 \\, dx = 5x" },
        { "tipe": "formula_block", "latex": "\\int (x^2 - 4x + 5) \\, dx = \\dfrac{x^3}{3} - 2x^2 + 5x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (6x^2 + 4x - 3) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^3 + 2x^2 - 3x + C$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 4x^2 - 3x + C$"}],
        [{"tipe":"paragraph","text":"$6x^3 + 2x^2 - 3x + C$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 2x^2 - 3 + C$"}],
        [{"tipe":"paragraph","text":"$12x + 4 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int 6x^2 \\, dx = 2x^3, \\quad \\int 4x \\, dx = 2x^2, \\quad \\int 3 \\, dx = 3x" },
        { "tipe": "formula_block", "latex": "\\int (6x^2 + 4x - 3) \\, dx = 2x^3 + 2x^2 - 3x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x^3 + x^2 + x + 1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{x^4}{4} + \\dfrac{x^3}{3} + \\dfrac{x^2}{2} + x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^4}{4} + \\dfrac{x^3}{3} + x^2 + x + C$"}],
        [{"tipe":"paragraph","text":"$4x^3 + 3x^2 + 2x + 1 + C$"}],
        [{"tipe":"paragraph","text":"$x^4 + x^3 + x^2 + x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x^4}{4} + \\dfrac{x^3}{3} + \\dfrac{x^2}{2} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int (x^3 + x^2 + x + 1) \\, dx = \\dfrac{x^4}{4} + \\dfrac{x^3}{3} + \\dfrac{x^2}{2} + x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $F(x) = \\int 2x \\, dx$ dan $F(0) = 3$, maka $F(x)$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x^2 + 3$"}],
        [{"tipe":"paragraph","text":"$x^2 - 3$"}],
        [{"tipe":"paragraph","text":"$x^2 + C$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 3$"}],
        [{"tipe":"paragraph","text":"$x^2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int 2x \\, dx = x^2 + C" },
        { "tipe": "paragraph", "text": "Syarat $F(0) = 3$: $0^2 + C = 3 \\Rightarrow C = 3$." },
        { "tipe": "formula_block", "latex": "F(x) = x^2 + 3" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $F(x) = \\int 6x^2 \\, dx$ dan $F(1) = 5$, maka $F(x)$ = ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^3 + 3$"}],
        [{"tipe":"paragraph","text":"$2x^3 - 3$"}],
        [{"tipe":"paragraph","text":"$2x^3 + 5$"}],
        [{"tipe":"paragraph","text":"$6x^3 + 5$"}],
        [{"tipe":"paragraph","text":"$2x^3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int 6x^2 \\, dx = 2x^3 + C" },
        { "tipe": "paragraph", "text": "Syarat $F(1) = 5$: $2(1)^3 + C = 5 \\Rightarrow C = 3$." },
        { "tipe": "formula_block", "latex": "F(x) = 2x^3 + 3" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
