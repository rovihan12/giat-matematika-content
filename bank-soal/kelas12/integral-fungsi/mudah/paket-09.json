    {
      "id": "bs-k12-integral-mudah-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x+1)(x-1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 - x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 + x + C$"}],
        [{"tipe":"paragraph","text":"$x^3 - x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 - \\dfrac{1}{2}x^2 + C$"}],
        [{"tipe":"paragraph","text":"$2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $(x+1)(x-1) = x^2 - 1$." },
        { "tipe": "formula_block", "latex": "\\int (x^2 - 1) \\, dx = \\dfrac{1}{3}x^3 - x + C" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $F'(x) = 4x + 2$ dan $F(1) = 3$, maka $F(x) = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^2 + 2x - 1$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 2x + 1$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 2x - 3$"}],
        [{"tipe":"paragraph","text":"$4x^2 + 2x - 3$"}],
        [{"tipe":"paragraph","text":"$2x^2 + 2x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "F(x) = \\int (4x + 2) \\, dx = 2x^2 + 2x + C" },
        { "tipe": "paragraph", "text": "$F(1)=3 \\Rightarrow 2+2+C=3 \\Rightarrow C=-1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k12-integral-mudah-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $F'(x) = 6x^2 - 4x$ dan $F(0) = 5$, maka $F(x) = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2x^3 - 2x^2 + 5$"}],
        [{"tipe":"paragraph","text":"$2x^3 - 2x^2 - 5$"}],
        [{"tipe":"paragraph","text":"$2x^3 - 2x^2$"}],
        [{"tipe":"paragraph","text":"$6x^3 - 4x^2 + 5$"}],
        [{"tipe":"paragraph","text":"$2x^3 - 2x^2 + 5x$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "F(x) = \\int (6x^2 - 4x) \\, dx = 2x^3 - 2x^2 + C" },
        { "tipe": "paragraph", "text": "$F(0) = 5 \\Rightarrow C = 5$." }
      ],
      "tingkat": "MUDAH"
    }
