{
  "id": "bs-k12-integral-sedang-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Teknik substitusi aljabar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sedang-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (2x - 3)(x^2 - 3x + 5)^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}(x^2 - 3x + 5)^4 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(x^2 - 3x + 5)^4 + C$"}],
        [{"tipe":"paragraph","text":"$(x^2 - 3x + 5)^4 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}(x^2 - 3x + 5)^4 + C$"}],
        [{"tipe":"paragraph","text":"$4(x^2 - 3x + 5)^4 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2 - 3x + 5$, maka $du = (2x - 3)dx$." },
        { "tipe": "formula_block", "latex": "\\int u^3 \\, du = \\dfrac{1}{4}u^4 + C = \\dfrac{1}{4}(x^2 - 3x + 5)^4 + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 8x(5 - 2x^2)^{15} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{8}(5 - 2x^2)^{16} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}(5 - 2x^2)^{16} + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}(5 - 2x^2)^{16} + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{16}(5 - 2x^2)^{16} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(5 - 2x^2)^{16} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = 5 - 2x^2$, maka $du = -4x \\, dx$, sehingga $8x \\, dx = -2 \\, du$." },
        { "tipe": "formula_block", "latex": "\\int -2 u^{15} \\, du = -2 \\left(\\dfrac{1}{16}u^{16}\\right) + C = -\\dfrac{1}{8}(5 - 2x^2)^{16} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x+1)(x^2 + 2x)^5 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{12}(x^2 + 2x)^6 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}(x^2 + 2x)^6 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}(x^2 + 2x)^6 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(x^2 + 2x)^6 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}(x^2 + 2x)^6 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2 + 2x$, maka $du = (2x + 2)dx = 2(x+1)dx$, sehingga $(x+1)dx = \\dfrac{1}{2}du$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2} u^5 \\, du = \\dfrac{1}{12}u^6 + C = \\dfrac{1}{12}(x^2 + 2x)^6 + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{2x}{x^2 + 3} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\ln(x^2 + 3) + C$"}],
        [{"tipe":"paragraph","text":"$2\\ln(x^2 + 3) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\ln(x^2 + 3) + C$"}],
        [{"tipe":"paragraph","text":"$\\ln(2x) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{x^2 + 3} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2 + 3$, maka $du = 2x \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{du}{u} = \\ln|u| + C = \\ln(x^2 + 3) + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{x^2 + 2}{\\sqrt{x^3 + 6x + 1}} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}\\sqrt{x^3 + 6x + 1} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\sqrt{x^3 + 6x + 1} + C$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{x^3 + 6x + 1} + C$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{x^3 + 6x + 1} + C$"}],
        [{"tipe":"paragraph","text":"$3\\sqrt{x^3 + 6x + 1} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^3 + 6x + 1$, maka $du = (3x^2 + 6)dx = 3(x^2 + 2)dx$, sehingga $(x^2 + 2)dx = \\dfrac{1}{3}du$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{3}u^{-1/2} \\, du = \\dfrac{1}{3} \\cdot 2u^{1/2} + C = \\dfrac{2}{3}\\sqrt{x^3 + 6x + 1} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{3x-2}{(3x^2 - 4x + 5)^5} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{8(3x^2 - 4x + 5)^4} + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4(3x^2 - 4x + 5)^4} + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2(3x^2 - 4x + 5)^4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8(3x^2 - 4x + 5)^4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4(3x^2 - 4x + 5)^4} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = 3x^2 - 4x + 5$, maka $du = (6x - 4)dx = 2(3x - 2)dx$, sehingga $(3x - 2)dx = \\dfrac{1}{2}du$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}u^{-5} \\, du = \\dfrac{1}{2} \\left(\\dfrac{u^{-4}}{-4}\\right) + C = -\\dfrac{1}{8}(3x^2 - 4x + 5)^{-4} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{6x^2}{\\sqrt{x^3 - 4}} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4\\sqrt{x^3 - 4} + C$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{x^3 - 4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sqrt{x^3 - 4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}\\sqrt{x^3 - 4} + C$"}],
        [{"tipe":"paragraph","text":"$6\\sqrt{x^3 - 4} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^3 - 4$, maka $du = 3x^2 \\, dx$, sehingga $6x^2 \\, dx = 2 \\, du$." },
        { "tipe": "formula_block", "latex": "\\int 2u^{-1/2} \\, du = 2(2u^{1/2}) + C = 4\\sqrt{x^3 - 4} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x\\sqrt{x^2 + 9} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}(x^2 + 9)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(x^2 + 9)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$2(x^2 + 9)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}(x^2 + 9)^{1/2} + C$"}],
        [{"tipe":"paragraph","text":"$(x^2 + 9)^{3/2} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2 + 9$, maka $du = 2x \\, dx$, sehingga $x \\, dx = \\dfrac{1}{2}du$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}u^{1/2} \\, du = \\dfrac{1}{2} \\cdot \\dfrac{2}{3}u^{3/2} + C = \\dfrac{1}{3}(x^2 + 9)^{3/2} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 2x(x^2 + 1)^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}(x^2 + 1)^4 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(x^2 + 1)^4 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}(x^2 + 1)^4 + C$"}],
        [{"tipe":"paragraph","text":"$2(x^2 + 1)^4 + C$"}],
        [{"tipe":"paragraph","text":"$4(x^2 + 1)^4 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2 + 1$, maka $du = 2x \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int u^3 \\, du = \\dfrac{1}{4}u^4 + C = \\dfrac{1}{4}(x^2 + 1)^4 + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{4} x\\sqrt{x^2 + 9} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{98}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{100}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{125}{3}$"}],
        [{"tipe":"paragraph","text":"$40$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{92}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = x^2+9$, $du=2x dx$. Batas: $x=0 \\to u=9$; $x=4 \\to u=25$." },
        { "tipe": "formula_block", "latex": "\\int_{9}^{25} \\dfrac{1}{2}u^{1/2} \\, du = [\\dfrac{1}{3}u^{3/2}]_{9}^{25} = \\dfrac{1}{3}(125 - 27) = \\dfrac{98}{3}" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
