{
  "id": "bs-k12-integral-sedang-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Integral substitusi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sedang-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (2x+1)^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{(2x+1)^4}{8} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(2x+1)^4}{4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(2x+1)^4}{2} + C$"}],
        [{"tipe":"paragraph","text":"$(2x+1)^4 + C$"}],
        [{"tipe":"paragraph","text":"$4(2x+1)^4 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = 2x+1$, maka $du = 2 \\, dx \\Rightarrow dx = \\dfrac{du}{2}$." },
        { "tipe": "formula_block", "latex": "\\int u^3 \\cdot \\dfrac{du}{2} = \\dfrac{1}{2} \\cdot \\dfrac{u^4}{4} + C = \\dfrac{u^4}{8} + C" },
        { "tipe": "formula_block", "latex": "= \\dfrac{(2x+1)^4}{8} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (3x-2)^4 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{(3x-2)^5}{15} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(3x-2)^5}{5} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(3x-2)^5}{3} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(3x-2)^4}{15} + C$"}],
        [{"tipe":"paragraph","text":"$15(3x-2)^5 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = 3x-2$, maka $du = 3 \\, dx \\Rightarrow dx = \\dfrac{du}{3}$." },
        { "tipe": "formula_block", "latex": "\\int u^4 \\cdot \\dfrac{du}{3} = \\dfrac{1}{3} \\cdot \\dfrac{u^5}{5} + C = \\dfrac{u^5}{15} + C = \\dfrac{(3x-2)^5}{15} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 2x(x^2+1)^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+1)^4}{4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+1)^4}{2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+1)^4}{8} + C$"}],
        [{"tipe":"paragraph","text":"$2(x^2+1)^4 + C$"}],
        [{"tipe":"paragraph","text":"$4(x^2+1)^4 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2+1$, maka $du = 2x \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int u^3 \\, du = \\dfrac{u^4}{4} + C = \\dfrac{(x^2+1)^4}{4} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 3x^2(x^3+2)^5 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{(x^3+2)^6}{6} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^3+2)^6}{3} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^3+2)^6}{18} + C$"}],
        [{"tipe":"paragraph","text":"$3(x^3+2)^6 + C$"}],
        [{"tipe":"paragraph","text":"$6(x^3+2)^6 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^3+2$, maka $du = 3x^2 \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int u^5 \\, du = \\dfrac{u^6}{6} + C = \\dfrac{(x^3+2)^6}{6} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{2x}{x^2+1} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\ln(x^2+1) + C$"}],
        [{"tipe":"paragraph","text":"$2\\ln(x^2+1) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\ln(x^2+1) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{x^2+1} + C$"}],
        [{"tipe":"paragraph","text":"$\\ln x^2 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2+1$, maka $du = 2x \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{du}{u} = \\ln|u| + C = \\ln(x^2+1) + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{1}{2x+3} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\ln|2x+3| + C$"}],
        [{"tipe":"paragraph","text":"$\\ln|2x+3| + C$"}],
        [{"tipe":"paragraph","text":"$2\\ln|2x+3| + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2x+3} + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{2}{(2x+3)^2} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = 2x+3$, maka $du = 2 \\, dx \\Rightarrow dx = \\dfrac{du}{2}$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{u} \\cdot \\dfrac{du}{2} = \\dfrac{1}{2}\\ln|u| + C = \\dfrac{1}{2}\\ln|2x+3| + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x\\sqrt{x^2+1} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+1)^{3/2}}{3} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+1)^{1/2}}{2} + C$"}],
        [{"tipe":"paragraph","text":"$(x^2+1)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$2(x^2+1)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+1)^{3/2}}{6} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2+1$, maka $du = 2x \\, dx \\Rightarrow x \\, dx = \\dfrac{du}{2}$." },
        { "tipe": "formula_block", "latex": "\\int u^{1/2} \\cdot \\dfrac{du}{2} = \\dfrac{1}{2} \\cdot \\dfrac{u^{3/2}}{3/2} + C = \\dfrac{u^{3/2}}{3} + C = \\dfrac{(x^2+1)^{3/2}}{3} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x+2)(x^2+4x-1)^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+4x-1)^4}{8} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+4x-1)^4}{4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{(x^2+4x-1)^4}{2} + C$"}],
        [{"tipe":"paragraph","text":"$(x^2+4x-1)^4 + C$"}],
        [{"tipe":"paragraph","text":"$4(x^2+4x-1)^4 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2+4x-1$, maka $du = (2x+4) \\, dx = 2(x+2) \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int (x+2) \\cdot u^3 \\, dx = \\int u^3 \\cdot \\dfrac{du}{2} = \\dfrac{1}{2} \\cdot \\dfrac{u^4}{4} + C = \\dfrac{u^4}{8} + C = \\dfrac{(x^2+4x-1)^4}{8} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{1} 2x(x^2+1)^2 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{7}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{3}$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2+1$, maka $du = 2x \\, dx$." },
        { "tipe": "paragraph", "text": "Batas: $x = 0 \\Rightarrow u = 1$; $x = 1 \\Rightarrow u = 2$." },
        { "tipe": "formula_block", "latex": "\\int_{1}^{2} u^2 \\, du = \\left[ \\dfrac{u^3}{3} \\right]_{1}^{2} = \\dfrac{8}{3} - \\dfrac{1}{3} = \\dfrac{7}{3}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{2} (x+1)(x^2+2x)^3 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1024}{4}$"}],
        [{"tipe":"paragraph","text":"$256$"}],
        [{"tipe":"paragraph","text":"$512$"}],
        [{"tipe":"paragraph","text":"$128$"}],
        [{"tipe":"paragraph","text":"$1024$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = x^2+2x$, maka $du = (2x+2) \\, dx = 2(x+1) \\, dx$." },
        { "tipe": "paragraph", "text": "Batas: $x = 0 \\Rightarrow u = 0$; $x = 2 \\Rightarrow u = 8$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{8} u^3 \\cdot \\dfrac{du}{2} = \\dfrac{1}{2} \\left[ \\dfrac{u^4}{4} \\right]_{0}^{8} = \\dfrac{1}{8} \\cdot 4096 = 512" },
        { "tipe": "paragraph", "text": "Ulang: $4096 / 8 = 512$." },
        { "tipe": "paragraph", "text": "Perbaikan: nilai = 512. Opsi B tidak sesuai, opsi C sesuai. Kunci = C (index 2)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
