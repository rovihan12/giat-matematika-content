{
  "id": "bs-k12-integral-sedang-07",
  "nama": "Bank Soal Sedang - Paket 7",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SEDANG",
  "deskripsi": "Integral trigonometri & substitusi trigonometri",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sedang-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^2 x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\sin^3 x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\sin^3 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sin^2 x + C$"}],
        [{"tipe":"paragraph","text":"$\\cos^3 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\cos^3 x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = \\sin x$, maka $du = \\cos x \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int u^2 \\, du = \\dfrac{1}{3}u^3 + C = \\dfrac{1}{3}\\sin^3 x + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^3 x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}\\sin^4 x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}\\sin^4 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\sin^3 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}\\cos^4 x + C$"}],
        [{"tipe":"paragraph","text":"$-2\\sin^4 x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = \\sin x$, maka $du = \\cos x \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int u^3 \\, du = \\dfrac{1}{4}u^4 + C = \\dfrac{1}{4}\\sin^4 x + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin 4x \\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{12}\\cos 6x - \\dfrac{1}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{12}\\cos 6x - \\dfrac{1}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{6}\\cos 6x - \\dfrac{1}{2}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{12}\\cos 6x + \\dfrac{1}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}\\cos 6x - \\dfrac{1}{2}\\cos 2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\sin A \\cos B = \\dfrac{1}{2}[\\sin(A+B) + \\sin(A-B)]$." },
        { "tipe": "formula_block", "latex": "\\sin 4x \\cos 2x = \\dfrac{1}{2}(\\sin 6x + \\sin 2x)" },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}(\\sin 6x + \\sin 2x) \\, dx = \\dfrac{1}{2}(-\\dfrac{1}{6}\\cos 6x - \\dfrac{1}{2}\\cos 2x) + C = -\\dfrac{1}{12}\\cos 6x - \\dfrac{1}{4}\\cos 2x + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\cos^4 2x \\sin 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{10}\\cos^5 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{5}\\cos^5 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{10}\\cos^5 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{10}\\sin^5 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}\\sin^5 2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = \\cos 2x$, maka $du = -2\\sin 2x \\, dx$, sehingga $\\sin 2x \\, dx = -\\dfrac{1}{2}du$." },
        { "tipe": "formula_block", "latex": "\\int u^4 (-\\dfrac{1}{2}du) = -\\dfrac{1}{2} \\cdot \\dfrac{1}{5}u^5 + C = -\\dfrac{1}{10}\\cos^5 2x + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sec^2(3x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\tan(3x) + C$"}],
        [{"tipe":"paragraph","text":"$\\tan(3x) + C$"}],
        [{"tipe":"paragraph","text":"$3\\tan(3x) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\cot(3x) + C$"}],
        [{"tipe":"paragraph","text":"$\\sec(3x) + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = 3x$, maka $du = 3dx \\Rightarrow dx = \\dfrac{1}{3}du$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{3}\\sec^2 u \\, du = \\dfrac{1}{3}\\tan u + C = \\dfrac{1}{3}\\tan(3x) + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\sin 2x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\sin 2x \\cos x = \\dfrac{1}{2}(\\sin 3x + \\sin x)$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} \\dfrac{1}{2}(\\sin 3x + \\sin x) \\, dx = \\dfrac{1}{2}[-\\dfrac{1}{3}\\cos 3x - \\cos x]_{0}^{\\pi/2}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2}[(0 - 0) - (-\\dfrac{1}{3} - 1)] = \\dfrac{1}{2}[\\dfrac{4}{3}] = \\dfrac{2}{3}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/4} 2\\cos 3x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sqrt{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}\\sqrt{3}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $2\\cos A \\cos B = \\cos(A+B) + \\cos(A-B)$." },
        { "tipe": "formula_block", "latex": "2\\cos 3x \\cos x = \\cos 4x + \\cos 2x" },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/4} (\\cos 4x + \\cos 2x) \\, dx = [\\dfrac{1}{4}\\sin 4x + \\dfrac{1}{2}\\sin 2x]_{0}^{\\pi/4} = (0 + \\dfrac{1}{2}(1)) - 0 = \\dfrac{1}{2}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/6} \\sin 4x \\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{7}{24}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Identitas: $\\sin 4x \\cos 2x = \\dfrac{1}{2}(\\sin 6x + \\sin 2x)$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/6} \\dfrac{1}{2}(\\sin 6x + \\sin 2x) \\, dx = \\dfrac{1}{2}[-\\dfrac{1}{6}\\cos 6x - \\dfrac{1}{2}\\cos 2x]_{0}^{\\pi/6}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2}[(-\\dfrac{1}{6}(-1) - \\dfrac{1}{2}(\\dfrac{1}{2})) - (-\\dfrac{1}{6} - \\dfrac{1}{2})] = \\dfrac{1}{2}[\\dfrac{1}{6} - \\dfrac{1}{4} + \\dfrac{2}{3}] = \\dfrac{1}{2}[\\dfrac{7}{12}] = \\dfrac{7}{24}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\sin^3 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin^3 x = \\sin x(1 - \\cos^2 x)$. Misal $u = \\cos x$, $du = -\\sin x dx$." },
        { "tipe": "formula_block", "latex": "\\int_{1}^{0} -(1-u^2) \\, du = \\int_{0}^{1} (1-u^2) \\, du = [u - \\dfrac{1}{3}u^3]_{0}^{1} = 1 - \\dfrac{1}{3} = \\dfrac{2}{3}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (\\sin 2x - \\cos x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}\\cos 2x - \\sin x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\cos 2x - \\sin x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}\\cos 2x + \\sin x + C$"}],
        [{"tipe":"paragraph","text":"$2\\cos 2x - \\sin x + C$"}],
        [{"tipe":"paragraph","text":"$-2\\cos 2x + \\sin x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int \\sin 2x \\, dx = -\\dfrac{1}{2}\\cos 2x, \\quad \\int \\cos x \\, dx = \\sin x" },
        { "tipe": "formula_block", "latex": "\\int (\\sin 2x - \\cos x) \\, dx = -\\dfrac{1}{2}\\cos 2x - \\sin x + C" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
