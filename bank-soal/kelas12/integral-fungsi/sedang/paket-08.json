  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sedang-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x \\sin(2x-1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}x\\cos(2x-1) + \\dfrac{1}{4}\\sin(2x-1) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}x\\cos(2x-1) - \\dfrac{1}{4}\\sin(2x-1) + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}x\\cos(2x-1) - \\dfrac{1}{4}\\sin(2x-1) + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}x\\sin(2x-1) + \\dfrac{1}{4}\\cos(2x-1) + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}x\\cos(2x-1) + \\dfrac{1}{2}\\sin(2x-1) + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=x$, $dv=\\sin(2x-1)dx \\Rightarrow v=-\\dfrac{1}{2}\\cos(2x-1)$." },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{2}x\\cos(2x-1) + \\dfrac{1}{2}\\int \\cos(2x-1) \\, dx" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{2}x\\cos(2x-1) + \\dfrac{1}{4}\\sin(2x-1) + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (3x+1)\\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(3x+1)\\sin 2x + \\dfrac{3}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(3x+1)\\sin 2x - \\dfrac{3}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(3x+1)\\cos 2x + \\dfrac{3}{4}\\sin 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}(3x+1)\\sin 2x + \\dfrac{3}{2}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}(3x+1)\\sin 2x - \\dfrac{1}{4}\\cos 2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=3x+1$, $dv=\\cos 2x dx \\Rightarrow v=\\dfrac{1}{2}\\sin 2x$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2}(3x+1)\\sin 2x - \\int \\dfrac{3}{2}\\sin 2x \\, dx = \\dfrac{1}{2}(3x+1)\\sin 2x + \\dfrac{3}{4}\\cos 2x + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (2x+1)\\sin(3x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}(2x+1)\\cos 3x + \\dfrac{2}{9}\\sin 3x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}(2x+1)\\cos 3x - \\dfrac{2}{9}\\sin 3x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}(2x+1)\\cos 3x - \\dfrac{2}{9}\\sin 3x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}(2x+1)\\cos 3x + \\dfrac{2}{9}\\sin 3x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}(2x+1)\\sin 3x + \\dfrac{2}{9}\\cos 3x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=2x+1$, $dv=\\sin 3x dx \\Rightarrow v=-\\dfrac{1}{3}\\cos 3x$." },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{3}(2x+1)\\cos 3x + \\dfrac{2}{3}\\int \\cos 3x \\, dx = -\\dfrac{1}{3}(2x+1)\\cos 3x + \\dfrac{2}{9}\\sin 3x + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x \\cdot 2^x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{x \\cdot 2^x}{\\ln 2} - \\dfrac{2^x}{(\\ln 2)^2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x \\cdot 2^x}{\\ln 2} + \\dfrac{2^x}{(\\ln 2)^2} + C$"}],
        [{"tipe":"paragraph","text":"$x \\cdot 2^x - 2^x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{x \\cdot 2^x}{2} - \\dfrac{2^x}{4} + C$"}],
        [{"tipe":"paragraph","text":"$x \\cdot 2^x \\ln 2 - 2^x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=x$, $dv=2^x dx \\Rightarrow v=\\dfrac{2^x}{\\ln 2}$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{x \\cdot 2^x}{\\ln 2} - \\int \\dfrac{2^x}{\\ln 2} \\, dx = \\dfrac{x \\cdot 2^x}{\\ln 2} - \\dfrac{2^x}{(\\ln 2)^2} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x^2 \\ln x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 \\ln x - \\dfrac{1}{9}x^3 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 \\ln x + \\dfrac{1}{9}x^3 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}x^3 \\ln x - \\dfrac{1}{3}x^3 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}x^2 \\ln x - \\dfrac{1}{4}x^2 + C$"}],
        [{"tipe":"paragraph","text":"$x^3 \\ln x - \\dfrac{1}{3}x^3 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=\\ln x$, $dv=x^2 dx \\Rightarrow v=\\dfrac{1}{3}x^3$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{3}x^3 \\ln x - \\int \\dfrac{1}{3}x^2 \\, dx = \\dfrac{1}{3}x^3 \\ln x - \\dfrac{1}{9}x^3 + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x \\sqrt{x+1} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{15}(3x-2)(x+1)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{15}(3x+2)(x+1)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{15}(3x-2)(x+1)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{5}(3x-2)(x+1)^{3/2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{15}(3x-2)(x+1)^{3/2} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=x$, $dv=\\sqrt{x+1}dx \\Rightarrow v=\\dfrac{2}{3}(x+1)^{3/2}$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{2}{3}x(x+1)^{3/2} - \\dfrac{2}{3}\\int (x+1)^{3/2} \\, dx = \\dfrac{2}{3}x(x+1)^{3/2} - \\dfrac{4}{15}(x+1)^{5/2} + C" },
        { "tipe": "formula_block", "latex": "= \\dfrac{2}{15}(x+1)^{3/2} \\left[ 5x - 2(x+1) \\right] + C = \\dfrac{2}{15}(3x-2)(x+1)^{3/2} + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int (x^2+1)\\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$(x^2-1)\\sin x + 2x\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$(x^2+1)\\sin x + 2x\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$(x^2-1)\\sin x - 2x\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$(x^2+3)\\sin x - 2x\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$2x\\sin x - (x^2-1)\\cos x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial 1: $u=x^2+1$, $dv=\\cos x dx \\Rightarrow v=\\sin x$." },
        { "tipe": "formula_block", "latex": "= (x^2+1)\\sin x - 2\\int x \\sin x \\, dx" },
        { "tipe": "paragraph", "text": "Parsial 2: $\\int x \\sin x dx = -x\\cos x + \\sin x$." },
        { "tipe": "formula_block", "latex": "= (x^2+1)\\sin x - 2(-x\\cos x + \\sin x) + C = (x^2-1)\\sin x + 2x\\cos x + C" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{2} - 1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{2} + 1$"}],
        [{"tipe":"paragraph","text":"$\\pi - 1$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int x \\cos x \\, dx = x \\sin x + \\cos x" },
        { "tipe": "formula_block", "latex": "[x \\sin x + \\cos x]_{0}^{\\pi/2} = (\\dfrac{\\pi}{2}(1) + 0) - (0 + 1) = \\dfrac{\\pi}{2} - 1" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{e} x \\ln x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{e^2 + 1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{e^2 - 1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{e^2}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{e^2 + 1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{e^2 - 1}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int x \\ln x \\, dx = \\dfrac{1}{2}x^2 \\ln x - \\dfrac{1}{4}x^2" },
        { "tipe": "formula_block", "latex": "[\\dfrac{1}{2}x^2 \\ln x - \\dfrac{1}{4}x^2]_{1}^{e} = (\\dfrac{e^2}{2} - \\dfrac{e^2}{4}) - (0 - \\dfrac{1}{4}) = \\dfrac{e^2}{4} + \\dfrac{1}{4} = \\dfrac{e^2 + 1}{4}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\ln(2x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$x \\ln(2x) - x + C$"}],
        [{"tipe":"paragraph","text":"$x \\ln(2x) + x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{x} + C$"}],
        [{"tipe":"paragraph","text":"$2x \\ln(2x) - 2x + C$"}],
        [{"tipe":"paragraph","text":"$x \\ln(2x) + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=\\ln(2x)$, $dv=dx \\Rightarrow v=x$. Turunan $u$ adalah $\\dfrac{1}{x}$." },
        { "tipe": "formula_block", "latex": "= x \\ln(2x) - \\int x \\cdot \\dfrac{1}{x} \\, dx = x \\ln(2x) - x + C" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
