  "deskripsi": "Integral tentu lanjutan & sifat fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sedang-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{-1}^{2} (x-1)(3x+1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$-5$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $(x-1)(3x+1) = 3x^2 - 2x - 1$." },
        { "tipe": "formula_block", "latex": "\\int_{-1}^{2} (3x^2 - 2x - 1) \\, dx = [x^3 - x^2 - x]_{-1}^{2} = (8-4-2) - (-1-1+1) = 2 - (-1) = 3" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{1} (3x^2 - 16x - 12) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-19$"}],
        [{"tipe":"paragraph","text":"$-21$"}],
        [{"tipe":"paragraph","text":"$19$"}],
        [{"tipe":"paragraph","text":"$21$"}],
        [{"tipe":"paragraph","text":"$-8$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{1} (3x^2 - 16x - 12) \\, dx = [x^3 - 8x^2 - 12x]_{0}^{1} = (1 - 8 - 12) - 0 = -19" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{2}^{4} (-x^2 + 6x - 8) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{32}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{2}^{4} (-x^2 + 6x - 8) \\, dx = [-\\dfrac{1}{3}x^3 + 3x^2 - 8x]_{2}^{4}" },
        { "tipe": "formula_block", "latex": "= (-\\dfrac{64}{3} + 48 - 32) - (-\\dfrac{8}{3} + 12 - 16) = (-\\dfrac{64}{3} + 16) - (-\\dfrac{8}{3} - 4) = -\\dfrac{56}{3} + 20 = \\dfrac{4}{3}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\int_{1}^{p} (x-1)^2 \\, dx = 2\\dfrac{2}{3}$. Nilai $p$ yang memenuhi adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{p} (x^2 - 2x + 1) \\, dx = [\\dfrac{1}{3}x^3 - x^2 + x]_{1}^{p} = \\dfrac{8}{3}" },
        { "tipe": "paragraph", "text": "$(\\dfrac{1}{3}p^3 - p^2 + p) - (\\dfrac{1}{3} - 1 + 1) = \\dfrac{8}{3} \\Rightarrow \\dfrac{1}{3}p^3 - p^2 + p = 3$." },
        { "tipe": "paragraph", "text": "Uji $p=3$: $\\dfrac{27}{3} - 9 + 3 = 9-9+3 = 3$. Benar." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\int_{a}^{3} (3x^2 + 2x + 1) \\, dx = 25$. Nilai $\\dfrac{1}{2}a = \\dots$" }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-1$"}],
        [{"tipe":"paragraph","text":"$-2$"}],
        [{"tipe":"paragraph","text":"$-4$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{a}^{3} (3x^2 + 2x + 1) \\, dx = [x^3 + x^2 + x]_{a}^{3} = (27+9+3) - (a^3+a^2+a) = 39 - (a^3+a^2+a) = 25" },
        { "tipe": "paragraph", "text": "Maka $a^3+a^2+a = 14$. Uji $a=2$: $8+4+2 = 14$. Benar, jadi $a=2$. Maka $\\dfrac{1}{2}a = 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{2} x^2(x+2) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{28}{3}$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{22}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$8$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{2} (x^3 + 2x^2) \\, dx = [\\dfrac{1}{4}x^4 + \\dfrac{2}{3}x^3]_{0}^{2} = (4 + \\dfrac{16}{3}) - 0 = \\dfrac{28}{3}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{1} x^2(x-6) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{7}{4}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{2}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{1} (x^3 - 6x^2) \\, dx = [\\dfrac{1}{4}x^4 - 2x^3]_{0}^{1} = (\\dfrac{1}{4} - 2) - 0 = -\\dfrac{7}{4}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{4} (x^2 - 2x + 2) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{32}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{50}{3}$"}],
        [{"tipe":"paragraph","text":"$16$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{4} (x^2 - 2x + 2) \\, dx = [\\dfrac{1}{3}x^3 - x^2 + 2x]_{1}^{4}" },
        { "tipe": "formula_block", "latex": "= (\\dfrac{64}{3} - 16 + 8) - (\\dfrac{1}{3} - 1 + 2) = (\\dfrac{64}{3} - 8) - (\\dfrac{4}{3}) = \\dfrac{64-4}{3} - 8 = 20 - 8 = 12" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{2} x(x^2-1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{7}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{9}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{4}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{2} (x^3 - x) \\, dx = [\\dfrac{1}{4}x^4 - \\dfrac{1}{2}x^2]_{1}^{2} = (4 - 2) - (\\dfrac{1}{4} - \\dfrac{1}{2}) = 2 - (-\\dfrac{1}{4}) = \\dfrac{9}{4}" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k12-integral-sedang-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{2} (3x^2 - 3x + 7) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$16$"}],
        [{"tipe":"paragraph","text":"$20$"}],
        [{"tipe":"paragraph","text":"$22$"}],
        [{"tipe":"paragraph","text":"$18$"}],
        [{"tipe":"paragraph","text":"$10$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{0}^{2} (3x^2 - 3x + 7) \\, dx = [x^3 - \\dfrac{3}{2}x^2 + 7x]_{0}^{2} = (8 - 6 + 14) - 0 = 16" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
