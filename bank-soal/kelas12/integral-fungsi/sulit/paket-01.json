{
  "id": "bs-k12-integral-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Luas daerah antara kurva & sumbu",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$, sumbu-$x$, dan garis $x = 2$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan batas-batas pengintegralan**" },
        { "tipe": "paragraph", "text": "Kurva $y = x^2$ memotong sumbu-$x$ di titik $x = 0$ dan dibatasi hingga garis $x = 2$, sehingga interval integrasinya adalah $[0, 2]$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun dan hitung integral tentu untuk luas daerah**" },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{2} x^2 \\, dx = \\left[ \\dfrac{x^3}{3} \\right]_{0}^{2}" },
        { "tipe": "formula_block", "latex": "L = \\dfrac{2^3}{3} - \\dfrac{0^3}{3} = \\dfrac{8}{3} - 0 = \\dfrac{8}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$\\dfrac{8}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$, sumbu-$x$, dan garis $x = 3$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan batas-batas pengintegralan**" },
        { "tipe": "paragraph", "text": "Kurva $y = x^2$ memotong sumbu-$x$ di $x = 0$ dan dibatasi oleh garis $x = 3$, sehingga batas bawahnya $0$ dan batas atasnya $3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun dan hitung integral tentu untuk luas daerah**" },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{3} x^2 \\, dx = \\left[ \\dfrac{x^3}{3} \\right]_{0}^{3}" },
        { "tipe": "formula_block", "latex": "L = \\dfrac{3^3}{3} - \\dfrac{0^3}{3} = \\dfrac{27}{3} - 0 = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$9$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = 4 - x^2$ dan sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{32}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{64}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari titik potong kurva dengan sumbu-$x$ ($y = 0$) sebagai batas integral**" },
        { "tipe": "formula_block", "latex": "4 - x^2 = 0 \\Rightarrow (2 - x)(2 + x) = 0 \\Rightarrow x = -2 \\quad \\text{atau} \\quad x = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung integral tentu pada interval $[-2, 2]$ (kurva berada di atas sumbu-$x$)**" },
        { "tipe": "formula_block", "latex": "L = \\int_{-2}^{2} (4 - x^2) \\, dx = \\left[ 4x - \\dfrac{x^3}{3} \\right]_{-2}^{2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan batas atas dan batas bawah**" },
        { "tipe": "formula_block", "latex": "L = \\left( 4(2) - \\dfrac{2^3}{3} \\right) - \\left( 4(-2) - \\dfrac{(-2)^3}{3} \\right)" },
        { "tipe": "formula_block", "latex": "L = \\left( 8 - \\dfrac{8}{3} \\right) - \\left( -8 + \\dfrac{8}{3} \\right) = 16 - \\dfrac{16}{3} = \\dfrac{32}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$\\dfrac{32}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$ dan garis $y = x$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik potong kedua kurva ($y_1 = y_2$) untuk memperoleh batas integral**" },
        { "tipe": "formula_block", "latex": "x^2 = x \\Rightarrow x^2 - x = 0 \\Rightarrow x(x - 1) = 0 \\Rightarrow x = 0 \\quad \\text{atau} \\quad x = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun integral luas daerah dengan mengurangkan kurva atas ($y = x$) dengan kurva bawah ($y = x^2$)**" },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{1} (x - x^2) \\, dx = \\left[ \\dfrac{x^2}{2} - \\dfrac{x^3}{3} \\right]_{0}^{1}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan batas integral dan sederhanakan hasilnya**" },
        { "tipe": "formula_block", "latex": "L = \\left( \\dfrac{1^2}{2} - \\dfrac{1^3}{3} \\right) - 0 = \\dfrac{1}{2} - \\dfrac{1}{3} = \\dfrac{1}{6}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$\\dfrac{1}{6}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$ dan garis $y = 2x$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik potong antara kurva $y = x^2$ dan garis $y = 2x$**" },
        { "tipe": "formula_block", "latex": "x^2 = 2x \\Rightarrow x^2 - 2x = 0 \\Rightarrow x(x - 2) = 0 \\Rightarrow x = 0 \\quad \\text{atau} \\quad x = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun integral tentu pada interval $[0, 2]$ dengan posisi $y = 2x$ di atas $y = x^2$**" },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{2} (2x - x^2) \\, dx = \\left[ x^2 - \\dfrac{x^3}{3} \\right]_{0}^{2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan batas atas dan batas bawah**" },
        { "tipe": "formula_block", "latex": "L = \\left( 2^2 - \\dfrac{2^3}{3} \\right) - 0 = 4 - \\dfrac{8}{3} = \\dfrac{4}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$\\dfrac{4}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$ dan $y = 4$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{32}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{64}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik potong antara kurva $y = x^2$ dan garis $y = 4$**" },
        { "tipe": "formula_block", "latex": "x^2 = 4 \\Rightarrow x = -2 \\quad \\text{atau} \\quad x = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun integral tentu dengan kurva atas $y = 4$ dan kurva bawah $y = x^2$**" },
        { "tipe": "formula_block", "latex": "L = \\int_{-2}^{2} (4 - x^2) \\, dx = \\left[ 4x - \\dfrac{x^3}{3} \\right]_{-2}^{2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Evaluasi hasil integral pada batas $[-2, 2]$**" },
        { "tipe": "formula_block", "latex": "L = \\left( 8 - \\dfrac{8}{3} \\right) - \\left( -8 + \\dfrac{8}{3} \\right) = 16 - \\dfrac{16}{3} = \\dfrac{32}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$\\dfrac{32}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2 - 4x + 3$ dan sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari titik potong kurva dengan sumbu-$x$ ($y = 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 4x + 3 = 0 \\Rightarrow (x - 1)(x - 3) = 0 \\Rightarrow x = 1 \\quad \\text{atau} \\quad x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun integral dengan tanda negatif karena kurva berada di bawah sumbu-$x$ pada interval $[1, 3]$**" },
        { "tipe": "formula_block", "latex": "L = -\\int_{1}^{3} (x^2 - 4x + 3) \\, dx = -\\left[ \\dfrac{x^3}{3} - 2x^2 + 3x \\right]_{1}^{3}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan batas atas dan batas bawah untuk memperoleh nilai luas**" },
        { "tipe": "formula_block", "latex": "L = -\\left[ \\left( \\dfrac{27}{3} - 2(9) + 3(3) \\right) - \\left( \\dfrac{1}{3} - 2(1) + 3(1) \\right) \\right]" },
        { "tipe": "formula_block", "latex": "L = -\\left[ (9 - 18 + 9) - \\left( \\dfrac{1}{3} + 1 \\right) \\right] = -\\left[ 0 - \\dfrac{4}{3} \\right] = \\dfrac{4}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$\\dfrac{4}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^3$ dan sumbu-$x$ pada interval $[0, 2]$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi posisi kurva dan batas pengintegralan**" },
        { "tipe": "paragraph", "text": "Pada interval $[0, 2]$, nilai fungsi $y = x^3 \\ge 0$ (berada di atas sumbu-$x$), dengan batas bawah $0$ dan batas atas $2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung integral tentu untuk luas daerah**" },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{2} x^3 \\, dx = \\left[ \\dfrac{x^4}{4} \\right]_{0}^{2}" },
        { "tipe": "formula_block", "latex": "L = \\dfrac{2^4}{4} - \\dfrac{0^4}{4} = \\dfrac{16}{4} - 0 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh $y = \\sqrt{x}$ dan $y = x^2$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik potong kedua kurva ($y_1 = y_2$)**" },
        { "tipe": "formula_block", "latex": "\\sqrt{x} = x^2 \\Rightarrow x = x^4 \\Rightarrow x(x^3 - 1) = 0 \\Rightarrow x = 0 \\quad \\text{atau} \\quad x = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun integral dengan kurva atas $y = \\sqrt{x} = x^{1/2}$ dan kurva bawah $y = x^2$**" },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{1} \\left(x^{1/2} - x^2\\right) \\, dx = \\left[ \\dfrac{2}{3}x^{3/2} - \\dfrac{x^3}{3} \\right]_{0}^{1}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan batas integral $[0, 1]$**" },
        { "tipe": "formula_block", "latex": "L = \\left( \\dfrac{2}{3}(1)^{3/2} - \\dfrac{1^3}{3} \\right) - 0 = \\dfrac{2}{3} - \\dfrac{1}{3} = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$\\dfrac{1}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = \\sin x$ dan sumbu-$x$ pada interval $[0, \\pi]$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\pi$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rumus integral luas daerah pada interval $[0, \\pi]$**" },
        { "tipe": "paragraph", "text": "Pada interval $[0, \\pi]$, kurva $y = \\sin x$ berada di atas sumbu-$x$ ($\\sin x \\ge 0$), sehingga:" },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{\\pi} \\sin x \\, dx = \\left[ -\\cos x \\right]_{0}^{\\pi}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan batas atas $x = \\pi$ dan batas bawah $x = 0$**" },
        { "tipe": "formula_block", "latex": "L = (-\\cos \\pi) - (-\\cos 0) = -(-1) - (-1) = 1 + 1 = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah tersebut adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
