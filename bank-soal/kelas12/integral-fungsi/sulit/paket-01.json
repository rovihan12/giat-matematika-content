{
  "id": "bs-k12-integral-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Luas daerah antara kurva & sumbu",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$, sumbu-$x$, dan garis $x = 2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{2} x^2 \\, dx = \\left[ \\dfrac{x^3}{3} \\right]_{0}^{2} = \\dfrac{8}{3}" },
        { "tipe": "paragraph", "text": "Jadi, luasnya adalah $\\dfrac{8}{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$, sumbu-$x$, dan garis $x = 3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{9}{2}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{3} x^2 \\, dx = \\left[ \\dfrac{x^3}{3} \\right]_{0}^{3} = \\dfrac{27}{3} = 9" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = 4 - x^2$ dan sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{32}{3}$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$12$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{64}{3}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong dengan sumbu-$x$: $4 - x^2 = 0 \\Rightarrow x = \\pm 2$." },
        { "tipe": "formula_block", "latex": "L = \\int_{-2}^{2} (4 - x^2) \\, dx = \\left[ 4x - \\dfrac{x^3}{3} \\right]_{-2}^{2}" },
        { "tipe": "formula_block", "latex": "= \\left( 8 - \\dfrac{8}{3} \\right) - \\left( -8 + \\dfrac{8}{3} \\right) = 16 - \\dfrac{16}{3} = \\dfrac{32}{3}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$ dan garis $y = x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2 = x \\Rightarrow x(x-1) = 0 \\Rightarrow x = 0, 1$." },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{1} (x - x^2) \\, dx = \\left[ \\dfrac{x^2}{2} - \\dfrac{x^3}{3} \\right]_{0}^{1} = \\dfrac{1}{2} - \\dfrac{1}{3} = \\dfrac{1}{6}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$ dan garis $y = 2x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{10}{3}$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2 = 2x \\Rightarrow x(x-2) = 0 \\Rightarrow x = 0, 2$." },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{2} (2x - x^2) \\, dx = \\left[ x^2 - \\dfrac{x^3}{3} \\right]_{0}^{2} = 4 - \\dfrac{8}{3} = \\dfrac{4}{3}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2$ dan $y = 4$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{32}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{64}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2 = 4 \\Rightarrow x = \\pm 2$." },
        { "tipe": "formula_block", "latex": "L = \\int_{-2}^{2} (4 - x^2) \\, dx = \\left[ 4x - \\dfrac{x^3}{3} \\right]_{-2}^{2} = \\dfrac{32}{3}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2 - 4x + 3$ dan sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{10}{3}$"}],
        [{"tipe":"paragraph","text":"$4$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong dengan sumbu-$x$: $x^2 - 4x + 3 = 0 \\Rightarrow (x-1)(x-3) = 0 \\Rightarrow x = 1, 3$." },
        { "tipe": "paragraph", "text": "Karena kurva di bawah sumbu-$x$ pada interval $[1, 3]$, luas = $-\\int$:" },
        { "tipe": "formula_block", "latex": "L = -\\int_{1}^{3} (x^2 - 4x + 3) \\, dx = -\\left[ \\dfrac{x^3}{3} - 2x^2 + 3x \\right]_{1}^{3}" },
        { "tipe": "formula_block", "latex": "= -\\left[ (9 - 18 + 9) - \\left( \\dfrac{1}{3} - 2 + 3 \\right) \\right] = -\\left[ 0 - \\dfrac{4}{3} \\right] = \\dfrac{4}{3}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^3$ dan sumbu-$x$ pada interval $[0, 2]$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{15}{4}$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{2} x^3 \\, dx = \\left[ \\dfrac{x^4}{4} \\right]_{0}^{2} = \\dfrac{16}{4} = 4" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh $y = \\sqrt{x}$ dan $y = x^2$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $\\sqrt{x} = x^2 \\Rightarrow x = x^4 \\Rightarrow x = 0, 1$." },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{1} (\\sqrt{x} - x^2) \\, dx = \\left[ \\dfrac{2x^{3/2}}{3} - \\dfrac{x^3}{3} \\right]_{0}^{1}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{2}{3} - \\dfrac{1}{3} = \\dfrac{1}{3}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = \\sin x$ dan sumbu-$x$ pada interval $[0, \\pi]$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{2}$"}]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{\\pi} \\sin x \\, dx = \\left[ -\\cos x \\right]_{0}^{\\pi} = -(-1) - (-1) = 2" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
