  "deskripsi": "Campuran Integral Tingkat UN / Ujian Nasional",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{x+2}{x^2+4x-3} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\ln|x^2+4x-3| + C$"}],
        [{"tipe":"paragraph","text":"$\\ln|x^2+4x-3| + C$"}],
        [{"tipe":"paragraph","text":"$2\\ln|x^2+4x-3| + C$"}],
        [{"tipe":"paragraph","text":"$\\sqrt{x^2+4x-3} + C$"}],
        [{"tipe":"paragraph","text":"$6\\sqrt{x^2+4x-3} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = x^2+4x-3$, maka $du = (2x+4)dx = 2(x+2)dx$, sehingga $(x+2)dx = \\dfrac{1}{2}du$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2u} \\, du = \\dfrac{1}{2}\\ln|u| + C = \\dfrac{1}{2}\\ln|x^2+4x-3| + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{2}^{4} (6x^2-6x-1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$74$"}],
        [{"tipe":"paragraph","text":"$72$"}],
        [{"tipe":"paragraph","text":"$68$"}],
        [{"tipe":"paragraph","text":"$64$"}],
        [{"tipe":"paragraph","text":"$76$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{2}^{4} (6x^2-6x-1) \\, dx = [2x^3 - 3x^2 - x]_{2}^{4}" },
        { "tipe": "formula_block", "latex": "= (128 - 48 - 4) - (16 - 12 - 2) = 76 - 2 = 74" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int x(3x-5)^4 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{54}(3x+1)(3x-5)^5 + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{54}(3x+1)(3x-5)^5 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{108}(1-3x)(3x-5)^5 + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{108}(1-3x)(3x-5)^5 + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{54}(1-3x)(3x-5)^5 + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Parsial: $u=x$, $dv=(3x-5)^4dx \\Rightarrow v=\\dfrac{1}{15}(3x-5)^5$." },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{15}x(3x-5)^5 - \\dfrac{1}{15}\\int (3x-5)^5 \\, dx = \\dfrac{1}{15}x(3x-5)^5 - \\dfrac{1}{270}(3x-5)^6 + C" },
        { "tipe": "paragraph", "text": "Faktorkan $\\dfrac{1}{270}(3x-5)^5 [18x - (3x-5)] = \\dfrac{1}{270}(15x+5)(3x-5)^5 + C = \\dfrac{1}{54}(3x+1)(3x-5)^5 + C$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{-1}^{2} (x^2-4x+3) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{22}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{-1}^{2} (x^2-4x+3) \\, dx = [\\dfrac{1}{3}x^3 - 2x^2 + 3x]_{-1}^{2}" },
        { "tipe": "formula_block", "latex": "= (\\dfrac{8}{3} - 8 + 6) - (-\\dfrac{1}{3} - 2 - 3) = \\dfrac{2}{3} - (-\\dfrac{16}{3}) = \\dfrac{18}{3} = 6" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^2 2x \\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}\\sin^3 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}\\sin^3 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}\\sin^3 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\cos^3 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{12}\\sin^3 2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = \\sin 2x$, $du = 2\\cos 2x dx \\Rightarrow \\cos 2x dx = \\dfrac{1}{2}du$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2} u^2 \\, du = \\dfrac{1}{6}u^3 + C = \\dfrac{1}{6}\\sin^3 2x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\dfrac{6x-9}{\\sqrt{x^2-3x-5}} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$6\\sqrt{x^2-3x-5} + C$"}],
        [{"tipe":"paragraph","text":"$3\\sqrt{x^2-3x-5} + C$"}],
        [{"tipe":"paragraph","text":"$2\\sqrt{x^2-3x-5} + C$"}],
        [{"tipe":"paragraph","text":"$18\\sqrt{x^2-3x-5} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}\\sqrt{x^2-3x-5} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = x^2-3x-5$, maka $du = (2x-3)dx$." },
        { "tipe": "paragraph", "text": "Perhatikan $6x-9 = 3(2x-3)$, sehingga pembilangnya adalah $3du$." },
        { "tipe": "formula_block", "latex": "\\int 3u^{-1/2} \\, du = 3(2u^{1/2}) + C = 6\\sqrt{x^2-3x-5} + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 4\\sin 4x \\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\cos 6x - \\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{6}\\cos 6x - \\dfrac{1}{2}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}\\cos 6x - \\dfrac{1}{2}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{6}\\cos 6x + \\dfrac{1}{2}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\cos 6x + \\cos 2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4\\sin 4x \\cos 2x = 2(2\\sin 4x \\cos 2x) = 2(\\sin 6x + \\sin 2x) = 2\\sin 6x + 2\\sin 2x$." },
        { "tipe": "formula_block", "latex": "\\int (2\\sin 6x + 2\\sin 2x) \\, dx = -\\dfrac{1}{3}\\cos 6x - \\cos 2x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} (\\sin 2x \\cos 2x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 2x \\cos 2x = \\dfrac{1}{2}\\sin 4x$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} \\dfrac{1}{2}\\sin 4x \\, dx = [-\\dfrac{1}{8}\\cos 4x]_{0}^{\\pi/2} = -\\dfrac{1}{8}(1 - 1) = 0" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{-1}^{2} (x^3+3x^2+4x+5) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$34\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$33\\dfrac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$32\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$31\\dfrac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$23\\dfrac{3}{4}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{-1}^{2} (x^3+3x^2+4x+5) \\, dx = [\\dfrac{1}{4}x^4 + x^3 + 2x^2 + 5x]_{-1}^{2}" },
        { "tipe": "formula_block", "latex": "= (4 + 8 + 8 + 10) - (\\dfrac{1}{4} - 1 + 2 - 5) = 30 - (-\\dfrac{17}{4}) = 30 + 4.25 = 34.25 = 34\\dfrac{1}{4}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{2} x(x^2-1) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{9}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{7}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{4}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{2} (x^3 - x) \\, dx = [\\dfrac{1}{4}x^4 - \\dfrac{1}{2}x^2]_{1}^{2} = (4 - 2) - (\\dfrac{1}{4} - \\dfrac{1}{2}) = 2 - (-\\dfrac{1}{4}) = \\dfrac{9}{4}" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
