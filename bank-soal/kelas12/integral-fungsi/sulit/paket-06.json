{
  "id": "bs-k12-integral-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Aplikasi Integral: Luas Daerah & Volume Benda Putar",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = -x^3 + x^2 + 2x$ dengan sumbu-$X$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{37}{12}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{45}{12}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{32}{12}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{12}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{13}{12}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong sumbu-X: $-x(x^2 - x - 2) = 0 \\Rightarrow -x(x-2)(x+1) = 0 \\Rightarrow x = -1, 0, 2$." },
        { "tipe": "formula_block", "latex": "L = \\int_{-1}^{0} (-x^3+x^2+2x)dx + \\left| \\int_{0}^{2} (-x^3+x^2+2x)dx \\right|" },
        { "tipe": "paragraph", "text": "Hasil integral pertama = $\\dfrac{5}{12}$ dan integral kedua = $-\\dfrac{8}{3}$ (luas = $\\dfrac{8}{3} = \\dfrac{32}{12}$). Total luas = $\\dfrac{5}{12} + \\dfrac{32}{12} = \\dfrac{37}{12}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar yang terjadi jika daerah yang dibatasi kurva $y = x^2 - 4$, sumbu-$X$, garis $x = 0$, dan $x = 1$ diputar mengelilingi sumbu-$X$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{203}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{103}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{166}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{211}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{243}{15}\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{0}^{1} (x^2 - 4)^2 \\, dx = \\pi \\int_{0}^{1} (x^4 - 8x^2 + 16) \\, dx" },
        { "tipe": "formula_block", "latex": "= \\pi [\\dfrac{1}{5}x^5 - \\dfrac{8}{3}x^3 + 16x]_{0}^{1} = \\pi(\\dfrac{1}{5} - \\dfrac{8}{3} + 16) = \\pi(\\dfrac{3 - 40 + 240}{15}) = \\dfrac{203}{15}\\pi" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang diarsir pada gambar dapat dinyatakan dengan rumus..." },
        {
          "tipe": "image",
          "src": "images/kelas12/integral/sulit/grafik-parabola-garis-1.png",
          "caption": "Grafik kurva parabola y = x^2 - 2x + 1 dan garis lurus y = 7 - x. Daerah yang diarsir berada di antara kedua kurva dari x = 0 hingga perpotongan di x = 3.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\int_{0}^{3} ((7-x) - (x^2-2x+1)) \\, dx$"}],
        [{"tipe":"paragraph","text":"$\\int_{0}^{2} ((7-x) - (x^2-2x+1)) \\, dx$"}],
        [{"tipe":"paragraph","text":"$\\int_{0}^{3} ((x^2-2x+1) - (7-x)) \\, dx$"}],
        [{"tipe":"paragraph","text":"$\\int_{0}^{1} (x^2-2x+1) \\, dx + \\int_{1}^{3} (7-x) \\, dx$"}],
        [{"tipe":"paragraph","text":"$\\int_{0}^{2} ((x^2-2x+1) - (7-x)) \\, dx$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2 - 2x + 1 = 7 - x \\Rightarrow x^2 - x - 6 = 0 \\Rightarrow (x-3)(x+2) = 0$. Batas yang diarsir adalah $x=0$ sampai $x=3$." },
        { "tipe": "paragraph", "text": "Karena garis $y = 7-x$ berada di atas parabola, maka luasnya adalah integral dari (garis - parabola)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar yang terbentuk dari daerah yang di kuadran I yang dibatasi kurva $x = 2\\sqrt{3}y^2$, sumbu-$Y$, dan lingkaran $x^2 + y^2 = 1$, diputar mengelilingi sumbu-$Y$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{23}{60}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{17}{60}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{44}{60}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{60}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{112}{60}\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kurva $x = 2\\sqrt{3}y^2$ dan lingkaran $x^2+y^2=1$. Substitusi $x$: $(2\\sqrt{3}y^2)^2 + y^2 = 1 \\Rightarrow 12y^4 + y^2 - 1 = 0$. Misal $p=y^2$, $12p^2+p-1=0 \\Rightarrow (3p+1)(4p-1)=0 \\Rightarrow p=1/4 \\Rightarrow y = 1/2$." },
        { "tipe": "paragraph", "text": "Volume terhadap sumbu Y: $V = \\pi \\int_{0}^{1/2} [(\\sqrt{1-y^2})^2 - (2\\sqrt{3}y^2)^2] \\, dy$." },
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{0}^{1/2} (1 - y^2 - 12y^4) \\, dy = \\pi [y - \\dfrac{1}{3}y^3 - \\dfrac{12}{5}y^5]_{0}^{1/2}" },
        { "tipe": "formula_block", "latex": "= \\pi (\\dfrac{1}{2} - \\dfrac{1}{24} - \\dfrac{12}{160}) = \\pi (\\dfrac{60}{120} - \\dfrac{5}{120} - \\dfrac{9}{120}) = \\dfrac{46}{120}\\pi = \\dfrac{23}{60}\\pi" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2 + 3x + 4$ dan $y = 1 - x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{7}{4}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{15}{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2+3x+4 = 1-x \\Rightarrow x^2+4x+3=0 \\Rightarrow (x+3)(x+1)=0 \\Rightarrow x=-3, -1$." },
        { "tipe": "formula_block", "latex": "L = \\int_{-3}^{-1} ((1-x) - (x^2+3x+4)) \\, dx = \\int_{-3}^{-1} (-x^2-4x-3) \\, dx" },
        { "tipe": "formula_block", "latex": "= [-\\dfrac{1}{3}x^3 - 2x^2 - 3x]_{-3}^{-1} = (\\dfrac{1}{3}-2+3) - (9-18+9) = \\dfrac{4}{3} - 0 = \\dfrac{4}{3}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar yang terjadi untuk daerah yang dibatasi oleh kurva $y = x^2$ dengan $y = 4x - 3$ diputar $360^\\circ$ mengelilingi sumbu-$X$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$14\\dfrac{5}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$13\\dfrac{11}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$12\\dfrac{11}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$12\\dfrac{7}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$13\\dfrac{4}{15}\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2 = 4x-3 \\Rightarrow x^2-4x+3=0 \\Rightarrow x=1, x=3$." },
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{1}^{3} [(4x-3)^2 - (x^2)^2] \\, dx = \\pi \\int_{1}^{3} (16x^2 - 24x + 9 - x^4) \\, dx" },
        { "tipe": "formula_block", "latex": "= \\pi [\\dfrac{16}{3}x^3 - 12x^2 + 9x - \\dfrac{1}{5}x^5]_{1}^{3}" },
        { "tipe": "paragraph", "text": "Evaluasi batas menghasilkan $\\dfrac{256}{15}\\pi - \\dfrac{41}{15}\\pi = \\dfrac{215}{15}\\pi = 14\\dfrac{5}{15}\\pi$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar yang terbentuk dari daerah di kuadran I yang dibatasi kurva $y = \\sqrt{3}x^2$, lingkaran $x^2 + y^2 = 4$ dan sumbu-$X$, diputar mengelilingi sumbu-$X$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{34}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{32}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{46}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{40}{15}\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{15}\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cari titik potong: $(\\sqrt{3}x^2)^2 + x^2 = 4 \\Rightarrow 3x^4 + x^2 - 4 = 0 \\Rightarrow (3x^2+4)(x^2-1)=0 \\Rightarrow x=1$." },
        { "tipe": "paragraph", "text": "Volume = Volume kerucut/lingkaran dari 1 ke 2 + Volume kurva dari 0 ke 1." },
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{1}^{2} (4-x^2) \\, dx + \\pi \\int_{0}^{1} (\\sqrt{3}x^2)^2 \\, dx" },
        { "tipe": "formula_block", "latex": "= \\pi [4x - \\dfrac{1}{3}x^3]_{1}^{2} + \\pi [\\dfrac{3}{5}x^5]_{0}^{1} = \\pi(8 - \\dfrac{8}{3} - 4 + \\dfrac{1}{3}) + \\dfrac{3}{5}\\pi = \\dfrac{5}{3}\\pi + \\dfrac{3}{5}\\pi = \\dfrac{34}{15}\\pi" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = \\sin x$ dan sumbu-$X$ pada interval $[0, 2\\pi]$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2\\pi$"}],
        [{"tipe":"paragraph","text":"$\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Luas = $\\int_{0}^{\\pi} \\sin x \\, dx - \\int_{\\pi}^{2\\pi} \\sin x \\, dx$." },
        { "tipe": "formula_block", "latex": "= [-\\cos x]_{0}^{\\pi} - [-\\cos x]_{\\pi}^{2\\pi} = (1 - (-1)) - (-1 - 1) = 2 - (-2) = 4" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi oleh kurva $y = x^2 + 2$ dan garis $y = 3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2+2=3 \\Rightarrow x^2=1 \\Rightarrow x=\\pm 1$." },
        { "tipe": "formula_block", "latex": "L = \\int_{-1}^{1} (3 - (x^2+2)) \\, dx = \\int_{-1}^{1} (1 - x^2) \\, dx = [x - \\dfrac{1}{3}x^3]_{-1}^{1} = \\dfrac{2}{3} - (-\\dfrac{2}{3}) = \\dfrac{4}{3}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar yang terjadi bila daerah yang dibatasi oleh kurva $2x = y^2$ pada interval $2 \\le y \\le 4$ diputar mengelilingi sumbu-$Y$ sejauh $360^\\circ$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{248}{5}\\pi$"}],
        [{"tipe":"paragraph","text":"$48\\pi$"}],
        [{"tipe":"paragraph","text":"$24\\pi$"}],
        [{"tipe":"paragraph","text":"$12\\pi$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{48}{5}\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah persamaan menjadi $x = \\dfrac{1}{2}y^2$. Diputar mengelilingi sumbu-Y." },
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{2}^{4} (\\dfrac{1}{2}y^2)^2 \\, dy = \\pi \\int_{2}^{4} \\dfrac{1}{4}y^4 \\, dy = \\pi [\\dfrac{1}{20}y^5]_{2}^{4}" },
        { "tipe": "formula_block", "latex": "= \\pi (\\dfrac{1024}{20} - \\dfrac{32}{20}) = \\dfrac{992}{20}\\pi = \\dfrac{248}{5}\\pi = 49{,}6\\pi" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
