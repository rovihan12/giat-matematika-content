{
  "id": "bs-k12-integral-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Campuran aplikasi integral",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah yang dibatasi kurva $y = x^2 + 2$ dan garis $y = 3$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{16}{3}$"}],
        [{"tipe":"paragraph","text":"$2$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x^2 + 2 = 3 \\Rightarrow x^2 = 1 \\Rightarrow x = \\pm 1$." },
        { "tipe": "formula_block", "latex": "L = \\int_{-1}^{1} (3 - (x^2+2)) \\, dx = \\int_{-1}^{1} (1 - x^2) \\, dx = \\left[ x - \\dfrac{x^3}{3} \\right]_{-1}^{1}" },
        { "tipe": "formula_block", "latex": "= \\left( 1 - \\dfrac{1}{3} \\right) - \\left( -1 + \\dfrac{1}{3} \\right) = \\dfrac{2}{3} + \\dfrac{2}{3} = \\dfrac{4}{3}" },
        { "tipe": "paragraph", "text": "Jadi, luasnya adalah $\\dfrac{4}{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar jika daerah yang dibatasi $y = x^2$, sumbu-$x$, dan $x = 1$ diputar mengelilingi sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2\\pi}{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{2}$"}],
        [{"tipe":"paragraph","text":"$\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{0}^{1} x^4 \\, dx = \\pi \\left[ \\dfrac{x^5}{5} \\right]_{0}^{1} = \\dfrac{\\pi}{5}" },
        { "tipe": "paragraph", "text": "Jadi, volumenya adalah $\\dfrac{\\pi}{5}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi} \\sin^2 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{2}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{4}$"}],
        [{"tipe":"paragraph","text":"$\\pi$"}],
        [{"tipe":"paragraph","text":"$2\\pi$"}],
        [{"tipe":"paragraph","text":"$1$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int \\sin^2 x \\, dx = \\dfrac{x}{2} - \\dfrac{\\sin 2x}{4} + C" },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi} \\sin^2 x \\, dx = \\left[ \\dfrac{x}{2} - \\dfrac{\\sin 2x}{4} \\right]_{0}^{\\pi} = \\dfrac{\\pi}{2} - 0 = \\dfrac{\\pi}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilainya adalah $\\dfrac{\\pi}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas daerah antara kurva $y = \\sin x$ dan sumbu-$x$ pada interval $[0, 2\\pi]$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2\\pi$"}],
        [{"tipe":"paragraph","text":"$\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kurva di atas sumbu-$x$ pada $[0, \\pi]$, di bawah pada $[\\pi, 2\\pi]$." },
        { "tipe": "formula_block", "latex": "L = \\int_{0}^{\\pi} \\sin x \\, dx - \\int_{\\pi}^{2\\pi} \\sin x \\, dx" },
        { "tipe": "formula_block", "latex": "= \\left[ -\\cos x \\right]_{0}^{\\pi} - \\left[ -\\cos x \\right]_{\\pi}^{2\\pi} = 2 - (-2) = 4" },
        { "tipe": "paragraph", "text": "Jadi, luasnya adalah 4." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar jika daerah antara $y = x$ dan $y = x^2$ diputar terhadap sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2\\pi}{15}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{15}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4\\pi}{15}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{8\\pi}{15}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{5}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong: $x = x^2 \\Rightarrow x = 0, 1$." },
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{0}^{1} (x^2 - x^4) \\, dx = \\pi \\left[ \\dfrac{x^3}{3} - \\dfrac{x^5}{5} \\right]_{0}^{1} = \\pi \\left( \\dfrac{1}{3} - \\dfrac{1}{5} \\right) = \\dfrac{2\\pi}{15}" },
        { "tipe": "paragraph", "text": "Jadi, volumenya adalah $\\dfrac{2\\pi}{15}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{1}^{4} \\dfrac{1}{\\sqrt{x}} \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$3$"}],
        [{"tipe":"paragraph","text":"$4$"}],
        [{"tipe":"paragraph","text":"$5$"}]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "\\int_{1}^{4} x^{-1/2} \\, dx = \\left[ 2\\sqrt{x} \\right]_{1}^{4} = 4 - 2 = 2" },
        { "tipe": "paragraph", "text": "Jadi, nilainya adalah 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^3 x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{\\sin^4 x}{4} + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{\\sin^4 x}{4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\cos^4 x}{4} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\sin^2 x}{2} + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\sin^3 x}{3} + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $u = \\sin x$, maka $du = \\cos x \\, dx$." },
        { "tipe": "formula_block", "latex": "\\int u^3 \\, du = \\dfrac{u^4}{4} + C = \\dfrac{\\sin^4 x}{4} + C" },
        { "tipe": "paragraph", "text": "Jadi, hasilnya adalah $\\dfrac{\\sin^4 x}{4} + C$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Volume benda putar jika daerah yang dibatasi $y = 3x$, sumbu-$x$, dan $x = 2$ diputar terhadap sumbu-$x$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$24\\pi$"}],
        [{"tipe":"paragraph","text":"$12\\pi$"}],
        [{"tipe":"paragraph","text":"$48\\pi$"}],
        [{"tipe":"paragraph","text":"$6\\pi$"}],
        [{"tipe":"paragraph","text":"$72\\pi$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "formula_block", "latex": "V = \\pi \\int_{0}^{2} (3x)^2 \\, dx = \\pi \\int_{0}^{2} 9x^2 \\, dx = 9\\pi \\left[ \\dfrac{x^3}{3} \\right]_{0}^{2} = 9\\pi \\cdot \\dfrac{8}{3} = 24\\pi" },
        { "tipe": "paragraph", "text": "Jadi, volumenya adalah $24\\pi$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{1} (3x+1)^2 \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$7$"}],
        [{"tipe":"paragraph","text":"$8$"}],
        [{"tipe":"paragraph","text":"$9$"}],
        [{"tipe":"paragraph","text":"$10$"}],
        [{"tipe":"paragraph","text":"$13$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ekspansi: $(3x+1)^2 = 9x^2 + 6x + 1$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{1} (9x^2 + 6x + 1) \\, dx = \\left[ 3x^3 + 3x^2 + x \\right]_{0}^{1} = 3 + 3 + 1 = 7" },
        { "tipe": "paragraph", "text": "Jadi, nilainya adalah 7." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\sin x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$1$"}],
        [{"tipe":"paragraph","text":"$0$"}],
        [{"tipe":"paragraph","text":"$2$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{4}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Identitas: $\\sin x \\cos x = \\dfrac{\\sin 2x}{2}$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} \\dfrac{\\sin 2x}{2} \\, dx = \\left[ -\\dfrac{\\cos 2x}{4} \\right]_{0}^{\\pi/2} = -\\dfrac{\\cos\\pi}{4} + \\dfrac{\\cos 0}{4} = \\dfrac{1}{4} + \\dfrac{1}{4} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "Jadi, nilainya adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
