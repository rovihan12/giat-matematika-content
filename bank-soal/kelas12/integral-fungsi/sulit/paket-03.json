{
  "id": "bs-k12-integral-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Integral substitusi trigonometri",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^3 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\cos x + \\dfrac{\\cos^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\cos x - \\dfrac{\\cos^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\cos x - \\dfrac{\\cos^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\cos x + \\dfrac{\\cos^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos^3 x}{3} + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pecah pangkat ganjil dan gunakan identitas trigonometri $\\sin^2 x = 1 - \\cos^2 x$**" },
        { "tipe": "formula_block", "latex": "\\int \\sin^3 x \\, dx = \\int \\sin x \\cdot \\sin^2 x \\, dx = \\int \\sin x (1 - \\cos^2 x) \\, dx" },
        { "tipe": "paragraph", "text": "**Langkah 2: Lakukan substitusi $u = \\cos x$ sehingga $du = -\\sin x \\, dx$**" },
        { "tipe": "formula_block", "latex": "\\int (1 - u^2)(-du) = \\int (u^2 - 1) \\, du = \\dfrac{u^3}{3} - u + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\cos x$ ke bentuk semula**" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\cos^3 x}{3} - \\cos x + C = -\\cos x + \\dfrac{\\cos^3 x}{3} + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\cos x + \\dfrac{\\cos^3 x}{3} + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\cos^3 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sin x - \\dfrac{\\sin^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\sin x + \\dfrac{\\sin^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\sin x + \\dfrac{\\sin^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sin^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\cos x - \\dfrac{\\cos^3 x}{3} + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pecah pangkat ganjil dan gunakan identitas $\\cos^2 x = 1 - \\sin^2 x$**" },
        { "tipe": "formula_block", "latex": "\\int \\cos^3 x \\, dx = \\int \\cos x \\cdot \\cos^2 x \\, dx = \\int \\cos x (1 - \\sin^2 x) \\, dx" },
        { "tipe": "paragraph", "text": "**Langkah 2: Lakukan substitusi $u = \\sin x$ sehingga $du = \\cos x \\, dx$**" },
        { "tipe": "formula_block", "latex": "\\int (1 - u^2) \\, du = u - \\dfrac{u^3}{3} + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\sin x$ ke dalam hasil integral**" },
        { "tipe": "formula_block", "latex": "\\sin x - \\dfrac{\\sin^3 x}{3} + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$\\sin x - \\dfrac{\\sin^3 x}{3} + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^4 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x}{8} - \\dfrac{\\sin 2x}{4} + \\dfrac{\\sin 4x}{32} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x}{8} + \\dfrac{\\sin 2x}{4} - \\dfrac{\\sin 4x}{32} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x}{8} - \\dfrac{\\sin 2x}{4} + \\dfrac{\\sin 4x}{32} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3x}{8} - \\dfrac{\\sin 4x}{4} + \\dfrac{\\sin 8x}{32} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{x}{8} + \\dfrac{\\sin 2x}{4} - \\dfrac{\\sin 4x}{32} + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Turunkan pangkat genap dengan identitas sudut rangkap $\\sin^2 x = \\dfrac{1 - \\cos 2x}{2}$**" },
        { "tipe": "formula_block", "latex": "\\sin^4 x = (\\sin^2 x)^2 = \\left( \\dfrac{1 - \\cos 2x}{2} \\right)^2 = \\dfrac{1 - 2\\cos 2x + \\cos^2 2x}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah $\\cos^2 2x = \\dfrac{1 + \\cos 4x}{2}$ dan sederhanakan bentuknya**" },
        { "tipe": "formula_block", "latex": "\\sin^4 x = \\dfrac{1 - 2\\cos 2x + \\dfrac{1 + \\cos 4x}{2}}{4} = \\dfrac{3}{8} - \\dfrac{\\cos 2x}{2} + \\dfrac{\\cos 4x}{8}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Integralkan setiap suku terhadap $x$**" },
        { "tipe": "formula_block", "latex": "\\int \\left( \\dfrac{3}{8} - \\dfrac{\\cos 2x}{2} + \\dfrac{\\cos 4x}{8} \\right) dx = \\dfrac{3x}{8} - \\dfrac{1}{2}\\left(\\dfrac{\\sin 2x}{2}\\right) + \\dfrac{1}{8}\\left(\\dfrac{\\sin 4x}{4}\\right) + C" },
        { "tipe": "formula_block", "latex": "= \\dfrac{3x}{8} - \\dfrac{\\sin 2x}{4} + \\dfrac{\\sin 4x}{32} + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$\\dfrac{3x}{8} - \\dfrac{\\sin 2x}{4} + \\dfrac{\\sin 4x}{32} + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin 2x \\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos 4x}{8} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\cos 4x}{8} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos 4x}{4} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\sin 4x}{8} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos 2x}{4} + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Sederhanakan integran menggunakan identitas sudut rangkap $\\sin 2\\alpha = 2\\sin \\alpha \\cos \\alpha$**" },
        { "tipe": "formula_block", "latex": "\\sin 2x \\cos 2x = \\dfrac{1}{2} (2 \\sin 2x \\cos 2x) = \\dfrac{\\sin 4x}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Integralkan fungsi terhadap $x$ (ingat $\\int \\sin ax \\, dx = -\\dfrac{\\cos ax}{a} + C$)**" },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{\\sin 4x}{2} \\, dx = \\dfrac{1}{2} \\left( -\\dfrac{\\cos 4x}{4} \\right) + C = -\\dfrac{\\cos 4x}{8} + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\dfrac{\\cos 4x}{8} + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin x \\cos^2 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\cos^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos^2 x}{2} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sin^3 x}{3} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\sin^3 x}{3} + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan teknik substitusi dengan memisalkan $u = \\cos x$**" },
        { "tipe": "paragraph", "text": "Turunan dari $u = \\cos x$ adalah $du = -\\sin x \\, dx$, sehingga $\\sin x \\, dx = -du$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke dalam integral dan hitung antiturunannya**" },
        { "tipe": "formula_block", "latex": "\\int \\cos^2 x \\cdot \\sin x \\, dx = \\int u^2 (-du) = -\\int u^2 \\, du = -\\dfrac{u^3}{3} + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\cos x$**" },
        { "tipe": "formula_block", "latex": "-\\dfrac{\\cos^3 x}{3} + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\dfrac{\\cos^3 x}{3} + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\tan x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\ln|\\cos x| + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\ln|\\cos x| + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\ln|\\sec x| + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\tan^2 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\sec^2 x + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah fungsi tangen menggunakan identitas $\\tan x = \\dfrac{\\sin x}{\\cos x}$**" },
        { "tipe": "formula_block", "latex": "\\int \\tan x \\, dx = \\int \\dfrac{\\sin x}{\\cos x} \\, dx" },
        { "tipe": "paragraph", "text": "**Langkah 2: Lakukan substitusi $u = \\cos x$ sehingga $du = -\\sin x \\, dx$**" },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{-du}{u} = -\\int \\dfrac{1}{u} \\, du = -\\ln|u| + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\cos x$**" },
        { "tipe": "formula_block", "latex": "-\\ln|\\cos x| + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\ln|\\cos x| + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\cos 3x \\sin x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos 4x}{8} + \\dfrac{\\cos 2x}{4} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos 4x}{8} - \\dfrac{\\cos 2x}{4} + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\cos 4x}{8} + \\dfrac{\\cos 2x}{4} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\sin 4x}{8} - \\dfrac{\\sin 2x}{4} + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\cos 4x}{4} - \\dfrac{\\cos 2x}{2} + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah perkalian trigonometri ke bentuk selisih dengan rumus $2\\cos A \\sin B = \\sin(A+B) - \\sin(A-B)$**" },
        { "tipe": "formula_block", "latex": "\\cos 3x \\sin x = \\dfrac{\\sin(3x + x) - \\sin(3x - x)}{2} = \\dfrac{\\sin 4x - \\sin 2x}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Integralkan masing-masing suku terhadap $x$**" },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{\\sin 4x - \\sin 2x}{2} \\, dx = \\dfrac{1}{2} \\left( -\\dfrac{\\cos 4x}{4} - \\left(-\\dfrac{\\cos 2x}{2}\\right) \\right) + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan koefisien pecahannya**" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2} \\left( -\\dfrac{\\cos 4x}{4} + \\dfrac{\\cos 2x}{2} \\right) + C = -\\dfrac{\\cos 4x}{8} + \\dfrac{\\cos 2x}{4} + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\dfrac{\\cos 4x}{8} + \\dfrac{\\cos 2x}{4} + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\sin^2 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah integran menggunakan identitas sudut rangkap $\\sin^2 x = \\dfrac{1 - \\cos 2x}{2}$**" },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} \\sin^2 x \\, dx = \\int_{0}^{\\pi/2} \\dfrac{1 - \\cos 2x}{2} \\, dx = \\left[ \\dfrac{x}{2} - \\dfrac{\\sin 2x}{4} \\right]_{0}^{\\pi/2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan batas atas $x = \\dfrac{\\pi}{2}$ dan batas bawah $x = 0$**" },
        { "tipe": "formula_block", "latex": "= \\left( \\dfrac{\\pi/2}{2} - \\dfrac{\\sin \\pi}{4} \\right) - \\left( \\dfrac{0}{2} - \\dfrac{\\sin 0}{4} \\right)" },
        { "tipe": "formula_block", "latex": "= \\left( \\dfrac{\\pi}{4} - 0 \\right) - (0 - 0) = \\dfrac{\\pi}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai integral tentu tersebut adalah **$\\dfrac{\\pi}{4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\cos^2 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah integran menggunakan identitas sudut rangkap $\\cos^2 x = \\dfrac{1 + \\cos 2x}{2}$**" },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} \\cos^2 x \\, dx = \\int_{0}^{\\pi/2} \\dfrac{1 + \\cos 2x}{2} \\, dx = \\left[ \\dfrac{x}{2} + \\dfrac{\\sin 2x}{4} \\right]_{0}^{\\pi/2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan batas atas $x = \\dfrac{\\pi}{2}$ dan batas bawah $x = 0$**" },
        { "tipe": "formula_block", "latex": "= \\left( \\dfrac{\\pi/2}{2} + \\dfrac{\\sin \\pi}{4} \\right) - \\left( \\dfrac{0}{2} + \\dfrac{\\sin 0}{4} \\right)" },
        { "tipe": "formula_block", "latex": "= \\left( \\dfrac{\\pi}{4} + 0 \\right) - (0 + 0) = \\dfrac{\\pi}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai integral tentu tersebut adalah **$\\dfrac{\\pi}{4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\sin 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan hasil antiturunan dari fungsi $\\sin 2x$**" },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} \\sin 2x \\, dx = \\left[ -\\dfrac{\\cos 2x}{2} \\right]_{0}^{\\pi/2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan batas atas $x = \\dfrac{\\pi}{2}$ dan batas bawah $x = 0$**" },
        { "tipe": "formula_block", "latex": "= \\left( -\\dfrac{\\cos \\left(2 \\cdot \\dfrac{\\pi}{2}\\right)}{2} \\right) - \\left( -\\dfrac{\\cos (2 \\cdot 0)}{2} \\right)" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{\\cos \\pi}{2} + \\dfrac{\\cos 0}{2} = -\\dfrac{-1}{2} + \\dfrac{1}{2} = \\dfrac{1}{2} + \\dfrac{1}{2} = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai integral tentu tersebut adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
