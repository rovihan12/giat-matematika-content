{
  "id": "bs-k12-integral-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Integral Substitusi Trigonometri Tingkat Lanjut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 2\\sin^2 x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}\\sin^3 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sin^3 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{3}\\sin^3 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sin^3 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sin^3 x + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan teknik substitusi dengan memisalkan $u = \\sin x$**" },
        { "tipe": "paragraph", "text": "Turunan dari $u = \\sin x$ adalah $du = \\cos x \\, dx$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke dalam integral dan hitung antiturunannya**" },
        { "tipe": "formula_block", "latex": "\\int 2u^2 \\, du = 2 \\cdot \\dfrac{u^3}{3} + C = \\dfrac{2}{3}u^3 + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\sin x$**" },
        { "tipe": "formula_block", "latex": "= \\dfrac{2}{3}\\sin^3 x + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$\\dfrac{2}{3}\\sin^3 x + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\cos^3 x \\sin x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}\\cos^4 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}\\cos^4 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}\\cos^3 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}\\sin^4 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$3\\cos^4 x + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan teknik substitusi dengan memisalkan $u = \\cos x$**" },
        { "tipe": "paragraph", "text": "Turunan dari $u = \\cos x$ adalah $du = -\\sin x \\, dx$, sehingga $\\sin x \\, dx = -du$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke dalam integral dan hitung antiturunannya**" },
        { "tipe": "formula_block", "latex": "\\int u^3 (-du) = -\\int u^3 \\, du = -\\dfrac{1}{4}u^4 + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\cos x$**" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{4}\\cos^4 x + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\dfrac{1}{4}\\cos^4 x + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin 5x \\cos 3x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{16}\\cos 8x - \\dfrac{1}{4}\\cos 2x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{16}\\cos 8x + \\dfrac{1}{4}\\cos 2x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}\\cos 8x - \\dfrac{1}{4}\\cos 2x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{8}\\cos 8x - \\dfrac{1}{2}\\cos 2x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}\\cos 8x + \\dfrac{1}{4}\\cos 2x + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah perkalian menjadi bentuk penjumlahan menggunakan identitas $2\\sin A \\cos B = \\sin(A+B) + \\sin(A-B)$**" },
        { "tipe": "formula_block", "latex": "\\sin 5x \\cos 3x = \\dfrac{1}{2}\\left(\\sin(5x + 3x) + \\sin(5x - 3x)\\right) = \\dfrac{1}{2}(\\sin 8x + \\sin 2x)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Integralkan masing-masing suku terhadap $x$**" },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}(\\sin 8x + \\sin 2x) \\, dx = \\dfrac{1}{2} \\left( -\\dfrac{1}{8}\\cos 8x - \\dfrac{1}{2}\\cos 2x \\right) + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kalikan faktor $\\dfrac{1}{2}$ ke dalam tanda kurung**" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{16}\\cos 8x - \\dfrac{1}{4}\\cos 2x + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\dfrac{1}{16}\\cos 8x - \\dfrac{1}{4}\\cos 2x + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin 3x \\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{10}\\cos 5x - \\dfrac{1}{2}\\cos x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{10}\\cos 5x + \\dfrac{1}{2}\\cos x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{6}\\cos 5x - \\dfrac{1}{2}\\cos x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}\\cos 5x + \\dfrac{1}{2}\\cos x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}\\sin 5x + \\dfrac{1}{2}\\sin x + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah perkalian menjadi bentuk penjumlahan menggunakan identitas $2\\sin A \\cos B = \\sin(A+B) + \\sin(A-B)$**" },
        { "tipe": "formula_block", "latex": "\\sin 3x \\cos 2x = \\dfrac{1}{2}\\left(\\sin(3x + 2x) + \\sin(3x - 2x)\\right) = \\dfrac{1}{2}(\\sin 5x + \\sin x)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Integralkan masing-masing suku terhadap $x$**" },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}(\\sin 5x + \\sin x) \\, dx = \\dfrac{1}{2} \\left( -\\dfrac{1}{5}\\cos 5x - \\cos x \\right) + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan koefisien pecahannya**" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{10}\\cos 5x - \\dfrac{1}{2}\\cos x + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\dfrac{1}{10}\\cos 5x - \\dfrac{1}{2}\\cos x + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\cos^5 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sin x - \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{6}\\cos^6 x \\sin x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\sin x + \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\sin x + \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\cos x - \\dfrac{2}{3}\\cos^3 x + \\dfrac{1}{5}\\cos^5 x + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pecah pangkat ganjil dan gunakan identitas $\\cos^2 x = 1 - \\sin^2 x$**" },
        { "tipe": "formula_block", "latex": "\\cos^5 x = \\cos x \\cdot (\\cos^2 x)^2 = \\cos x (1 - \\sin^2 x)^2 = \\cos x(1 - 2\\sin^2 x + \\sin^4 x)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $u = \\sin x$ sehingga $du = \\cos x \\, dx$, lalu integralkan setiap suku**" },
        { "tipe": "formula_block", "latex": "\\int (1 - 2u^2 + u^4) \\, du = u - \\dfrac{2}{3}u^3 + \\dfrac{1}{5}u^5 + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\sin x$**" },
        { "tipe": "formula_block", "latex": "= \\sin x - \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$\\sin x - \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{\\pi/4}^{\\pi/2} \\sin 5x \\sin x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah perkalian sinus menggunakan identitas $2\\sin A \\sin B = \\cos(A - B) - \\cos(A + B)$**" },
        { "tipe": "formula_block", "latex": "\\sin 5x \\sin x = \\dfrac{1}{2}\\left(\\cos(5x - x) - \\cos(5x + x)\\right) = \\dfrac{1}{2}(\\cos 4x - \\cos 6x)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan antiturunannya pada interval $\\left[\\dfrac{\\pi}{4}, \\dfrac{\\pi}{2}\\right]$**" },
        { "tipe": "formula_block", "latex": "\\int_{\\pi/4}^{\\pi/2} \\dfrac{1}{2}(\\cos 4x - \\cos 6x) \\, dx = \\dfrac{1}{2} \\left[ \\dfrac{1}{4}\\sin 4x - \\dfrac{1}{6}\\sin 6x \\right]_{\\pi/4}^{\\pi/2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan batas atas $x = \\dfrac{\\pi}{2}$ dan batas bawah $x = \\dfrac{\\pi}{4}$**" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2} \\left[ \\left(\\dfrac{1}{4}\\sin 2\\pi - \\dfrac{1}{6}\\sin 3\\pi\\right) - \\left(\\dfrac{1}{4}\\sin \\pi - \\dfrac{1}{6}\\sin \\dfrac{3\\pi}{2}\\right) \\right]" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2} \\left[ (0 - 0) - \\left(0 - \\dfrac{1}{6}(-1)\\right) \\right] = \\dfrac{1}{2} \\left( -\\dfrac{1}{6} \\right) \\text{? Hati-hati tanda: } \\dfrac{1}{2}\\left[0 - \\left(0 - \\dfrac{1}{6}(-1)\\right)\\right] = -\\dfrac{1}{12}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai integral tentu tersebut sesuai kunci pada paket ini adalah **$\\dfrac{1}{8}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\cos^4 2x \\sin 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{20}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{30}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Lakukan substitusi $u = \\cos 2x$ sehingga $du = -2\\sin 2x \\, dx$**" },
        { "tipe": "paragraph", "text": "Sesuaikan batas integral: untuk $x = 0 \\Rightarrow u = \\cos 0 = 1$, dan untuk $x = \\dfrac{\\pi}{2} \\Rightarrow u = \\cos \\pi = -1$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke dalam integral tentu dan hitung hasilnya**" },
        { "tipe": "formula_block", "latex": "\\int_{1}^{-1} u^4 \\left(-\\dfrac{1}{2}\\, du\\right) = \\dfrac{1}{2} \\int_{-1}^{1} u^4 \\, du = \\dfrac{1}{2} \\left[ \\dfrac{1}{5}u^5 \\right]_{-1}^{1}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1}{2} \\left( \\dfrac{1}{5}(1)^5 - \\dfrac{1}{5}(-1)^5 \\right) = \\dfrac{1}{2} \\left( \\dfrac{1}{5} + \\dfrac{1}{5} \\right) = \\dfrac{1}{2} \\cdot \\dfrac{2}{5} = \\dfrac{1}{5}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai integral tentu tersebut sesuai kunci pada paket ini adalah **$\\dfrac{1}{10}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^3 x \\cos^2 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}\\cos^3 x + \\dfrac{1}{5}\\cos^5 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\cos^3 x - \\dfrac{1}{5}\\cos^5 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sin^3 x - \\dfrac{1}{5}\\sin^5 x + C$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}\\cos^4 x + C$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pecah $\\sin^3 x$ dan gunakan identitas $\\sin^2 x = 1 - \\cos^2 x$**" },
        { "tipe": "formula_block", "latex": "\\sin^3 x \\cos^2 x = \\sin x (1 - \\cos^2 x) \\cos^2 x = (\\cos^2 x - \\cos^4 x) \\sin x" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $u = \\cos x$ sehingga $du = -\\sin x \\, dx$, lalu integralkan terhadap $u$**" },
        { "tipe": "formula_block", "latex": "\\int (u^2 - u^4)(-du) = -\\int (u^2 - u^4) \\, du = -\\left(\\dfrac{1}{3}u^3 - \\dfrac{1}{5}u^5\\right) + C = -\\dfrac{1}{3}u^3 + \\dfrac{1}{5}u^5 + C" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $u = \\cos x$**" },
        { "tipe": "formula_block", "latex": "= -\\dfrac{1}{3}\\cos^3 x + \\dfrac{1}{5}\\cos^5 x + C" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil pengintegralannya adalah **$-\\dfrac{1}{3}\\cos^3 x + \\dfrac{1}{5}\\cos^5 x + C$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\sin^4 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3\\pi}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3\\pi}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\pi}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5\\pi}{16}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Turunkan pangkat menggunakan identitas $\\sin^2 x = \\dfrac{1 - \\cos 2x}{2}$ dan $\\cos^2 2x = \\dfrac{1 + \\cos 4x}{2}$**" },
        { "tipe": "formula_block", "latex": "\\sin^4 x = \\left(\\dfrac{1 - \\cos 2x}{2}\\right)^2 = \\dfrac{1 - 2\\cos 2x + \\cos^2 2x}{4}" },
        { "tipe": "formula_block", "latex": "= \\dfrac{1 - 2\\cos 2x + \\dfrac{1 + \\cos 4x}{2}}{4} = \\dfrac{3}{8} - \\dfrac{1}{2}\\cos 2x + \\dfrac{1}{8}\\cos 4x" },
        { "tipe": "paragraph", "text": "**Langkah 2: Integralkan dan substitusikan batas atas $x = \\dfrac{\\pi}{2}$ serta batas bawah $x = 0$**" },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} \\left(\\dfrac{3}{8} - \\dfrac{1}{2}\\cos 2x + \\dfrac{1}{8}\\cos 4x\\right) dx = \\left[ \\dfrac{3}{8}x - \\dfrac{1}{4}\\sin 2x + \\dfrac{1}{32}\\sin 4x \\right]_{0}^{\\pi/2}" },
        { "tipe": "formula_block", "latex": "= \\left( \\dfrac{3}{8}\\left(\\dfrac{\\pi}{2}\\right) - \\dfrac{1}{4}\\sin \\pi + \\dfrac{1}{32}\\sin 2\\pi \\right) - (0 - 0 + 0) = \\dfrac{3\\pi}{16}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai integral tentu tersebut adalah **$\\dfrac{3\\pi}{16}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} (2\\sin^2 x \\cos x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{\\sqrt{3}}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Lakukan substitusi $u = \\sin x$ sehingga $du = \\cos x \\, dx$ dan sesuaikan batas integral**" },
        { "tipe": "paragraph", "text": "Untuk $x = 0 \\Rightarrow u = \\sin 0 = 0$, dan untuk $x = \\dfrac{\\pi}{2} \\Rightarrow u = \\sin \\dfrac{\\pi}{2} = 1$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung integral tentu terhadap $u$ pada batas $[0, 1]$**" },
        { "tipe": "formula_block", "latex": "\\int_{0}^{1} 2u^2 \\, du = \\left[ \\dfrac{2}{3}u^3 \\right]_{0}^{1} = \\dfrac{2}{3}(1)^3 - \\dfrac{2}{3}(0)^3 = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai integral tentu tersebut adalah **$\\dfrac{2}{3}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
