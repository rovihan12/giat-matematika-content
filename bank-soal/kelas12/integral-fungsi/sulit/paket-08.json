{
  "id": "bs-k12-integral-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 12,
  "kategori": "Integral Fungsi",
  "tingkat": "SULIT",
  "deskripsi": "Integral Substitusi Trigonometri Tingkat Lanjut",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k12-integral-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int 2\\sin^2 x \\cos x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}\\sin^3 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\sin^3 x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{2}{3}\\sin^3 x + C$"}],
        [{"tipe":"paragraph","text":"$2\\sin^3 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{2}\\sin^3 x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = \\sin x$, $du = \\cos x dx$." },
        { "tipe": "formula_block", "latex": "\\int 2u^2 \\, du = \\dfrac{2}{3}u^3 + C = \\dfrac{2}{3}\\sin^3 x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\cos^3 x \\sin x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}\\cos^4 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}\\cos^4 x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\cos^3 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{4}\\sin^4 x + C$"}],
        [{"tipe":"paragraph","text":"$3\\cos^4 x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = \\cos x$, $du = -\\sin x dx$." },
        { "tipe": "formula_block", "latex": "\\int -u^3 \\, du = -\\dfrac{1}{4}u^4 + C = -\\dfrac{1}{4}\\cos^4 x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin 5x \\cos 3x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{16}\\cos 8x - \\dfrac{1}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{16}\\cos 8x + \\dfrac{1}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{16}\\cos 8x - \\dfrac{1}{4}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{8}\\cos 8x - \\dfrac{1}{2}\\cos 2x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{16}\\cos 8x + \\dfrac{1}{4}\\cos 2x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 5x \\cos 3x = \\dfrac{1}{2}(\\sin 8x + \\sin 2x)$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}(\\sin 8x + \\sin 2x) \\, dx = \\dfrac{1}{2}(-\\dfrac{1}{8}\\cos 8x - \\dfrac{1}{2}\\cos 2x) + C = -\\dfrac{1}{16}\\cos 8x - \\dfrac{1}{4}\\cos 2x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin 3x \\cos 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{10}\\cos 5x - \\dfrac{1}{2}\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{10}\\cos 5x + \\dfrac{1}{2}\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{6}\\cos 5x - \\dfrac{1}{2}\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{10}\\cos 5x + \\dfrac{1}{2}\\cos x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{10}\\sin 5x + \\dfrac{1}{2}\\sin x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 3x \\cos 2x = \\dfrac{1}{2}(\\sin 5x + \\sin x)$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}(\\sin 5x + \\sin x) \\, dx = \\dfrac{1}{2}(-\\dfrac{1}{5}\\cos 5x - \\cos x) + C = -\\dfrac{1}{10}\\cos 5x - \\dfrac{1}{2}\\cos x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\cos^5 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\sin x - \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{6}\\cos^6 x \\sin x + C$"}],
        [{"tipe":"paragraph","text":"$-\\sin x + \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$"}],
        [{"tipe":"paragraph","text":"$\\sin x + \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$"}],
        [{"tipe":"paragraph","text":"$\\cos x - \\dfrac{2}{3}\\cos^3 x + \\dfrac{1}{5}\\cos^5 x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos^5 x = \\cos x(1-\\sin^2 x)^2 = \\cos x(1 - 2\\sin^2 x + \\sin^4 x)$." },
        { "tipe": "paragraph", "text": "Misal $u = \\sin x$, $du = \\cos x dx$." },
        { "tipe": "formula_block", "latex": "\\int (1 - 2u^2 + u^4) \\, du = u - \\dfrac{2}{3}u^3 + \\dfrac{1}{5}u^5 + C = \\sin x - \\dfrac{2}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{\\pi/4}^{\\pi/2} \\sin 5x \\sin x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{8}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{12}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5}{12}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{2}$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{6}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 5x \\sin x = \\dfrac{1}{2}(\\cos 4x - \\cos 6x)$." },
        { "tipe": "formula_block", "latex": "\\int \\dfrac{1}{2}(\\cos 4x - \\cos 6x) \\, dx = \\dfrac{1}{2}(\\dfrac{1}{4}\\sin 4x - \\dfrac{1}{6}\\sin 6x)" },
        { "tipe": "paragraph", "text": "Evaluasi batas menghasilkan $\\dfrac{1}{8}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\cos^4 2x \\sin 2x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{1}{10}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{5}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{20}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{15}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{30}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = \\cos 2x$, $du = -2\\sin 2x dx$. Batas: $x=0 \\to u=1$; $x=\\pi/2 \\to u=-1$." },
        { "tipe": "formula_block", "latex": "\\int_{1}^{-1} u^4 (-\\dfrac{1}{2}du) = \\dfrac{1}{2} \\int_{-1}^{1} u^4 \\, du = \\dfrac{1}{2} [\\dfrac{1}{5}u^5]_{-1}^{1} = \\dfrac{1}{2}(\\dfrac{1}{5} - (-\\dfrac{1}{5})) = \\dfrac{1}{5}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\int \\sin^3 x \\cos^2 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\cos^3 x + \\dfrac{1}{5}\\cos^5 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\cos^3 x - \\dfrac{1}{5}\\cos^5 x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{3}\\sin^3 x + \\dfrac{1}{5}\\sin^5 x + C$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}\\sin^3 x - \\dfrac{1}{5}\\sin^5 x + C$"}],
        [{"tipe":"paragraph","text":"$-\\dfrac{1}{4}\\cos^4 x + C$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin^3 x \\cos^2 x = \\sin x(1-\\cos^2 x)\\cos^2 x = (\\cos^2 x - \\cos^4 x)\\sin x$." },
        { "tipe": "paragraph", "text": "Misal $u = \\cos x$, $du = -\\sin x dx$." },
        { "tipe": "formula_block", "latex": "\\int -(u^2 - u^4) \\, du = -\\dfrac{1}{3}u^3 + \\dfrac{1}{5}u^5 + C = -\\dfrac{1}{3}\\cos^3 x + \\dfrac{1}{5}\\cos^5 x + C" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} \\sin^4 x \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{3\\pi}{16}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{16}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{3\\pi}{8}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{\\pi}{8}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{5\\pi}{16}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin^4 x = (\\dfrac{1-\\cos 2x}{2})^2 = \\dfrac{1 - 2\\cos 2x + \\cos^2 2x}{4}$." },
        { "tipe": "paragraph", "text": "Substitusi $\\cos^2 2x = \\dfrac{1+\\cos 4x}{2}$ menghasilkan $\\dfrac{3}{8} - \\dfrac{1}{2}\\cos 2x + \\dfrac{1}{8}\\cos 4x$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{\\pi/2} (\\dfrac{3}{8} - \\dfrac{1}{2}\\cos 2x + \\dfrac{1}{8}\\cos 4x) \\, dx = [\\dfrac{3}{8}x - \\dfrac{1}{4}\\sin 2x + \\dfrac{1}{32}\\sin 4x]_{0}^{\\pi/2} = \\dfrac{3\\pi}{16}" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k12-integral-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\int_{0}^{\\pi/2} (2\\sin^2 x \\cos x) \\, dx$ adalah ..." }
      ],
      "pilihan": [
        [{"tipe":"paragraph","text":"$\\dfrac{2}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{1}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{4}{3}$"}],
        [{"tipe":"paragraph","text":"$\\dfrac{2}{\\sqrt{3}}$"}],
        [{"tipe":"paragraph","text":"$1 + \\sqrt{3}$"}]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $u = \\sin x$, $du = \\cos x dx$. Batas $x=0 \\to u=0$; $x=\\pi/2 \\to u=1$." },
        { "tipe": "formula_block", "latex": "\\int_{0}^{1} 2u^2 \\, du = [\\dfrac{2}{3}u^3]_{0}^{1} = \\dfrac{2}{3}" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
