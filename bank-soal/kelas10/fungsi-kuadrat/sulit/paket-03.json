{
  "id": "bs-k10-fk-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan aplikasi fungsi kuadrat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 2x - 8 < 0$ dengan $x$ bilangan bulat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-2, -1, 0, 1, 2, 3, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0, 1, 2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 2, 3\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 4)(x + 2) < 0 \\Rightarrow -2 < x < 4$." },
        { "tipe": "paragraph", "text": "$x$ bulat: $-1, 0, 1, 2, 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x^2 - 9}{x + 1} \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < -1$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $-1 < x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{(x-3)(x+3)}{x+1} \\geq 0$" },
        { "tipe": "paragraph", "text": "Titik kritis: $x = -3$, $x = -1$ (dikecualikan), $x = 3$." },
        { "tipe": "paragraph", "text": "Uji $x = -4$: $\\dfrac{(+)(-)}{-} = + \\geq 0$ ✓" },
        { "tipe": "paragraph", "text": "Uji $x = -2$: $\\dfrac{(-)(+)}{-} = + \\geq 0$ ✓" },
        { "tipe": "paragraph", "text": "Uji $x = 0$: $\\dfrac{(-)(+)}{+} = - < 0$ ✗" },
        { "tipe": "paragraph", "text": "Uji $x = 4$: $\\dfrac{(+)(+)}{+} = + \\geq 0$ ✓" },
        { "tipe": "paragraph", "text": "HP = $-3 \\leq x < -1$ atau $x \\geq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 4 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 6$; $\\alpha\\beta = 4$" },
        { "tipe": "paragraph", "text": "$\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{36 - 8}{4} = \\dfrac{28}{4} = 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 4x + 7$ untuk $0 \\leq x \\leq 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 2$ (dalam interval)." },
        { "tipe": "paragraph", "text": "$f(2) = 4 - 8 + 7 = 3$ (minimum)." },
        { "tipe": "paragraph", "text": "Bandingkan titik ujung: $f(0) = 7$, $f(5) = 25 - 20 + 7 = 12$." },
        { "tipe": "paragraph", "text": "Minimum = 3." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 + (p-1)x + 4 = 0$ memiliki akar-akar positif, nilai $p$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$p \\leq -3$" } ],
        [ { "tipe": "paragraph", "text": "$p \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$p < -3$" } ],
        [ { "tipe": "paragraph", "text": "$p > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < p < 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar positif: $x_1 + x_2 > 0$ dan $x_1 x_2 > 0$ dan $D \\geq 0$." },
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 1 - p > 0 \\Rightarrow p < 1$." },
        { "tipe": "paragraph", "text": "$x_1 x_2 = 4 > 0$ ✓" },
        { "tipe": "paragraph", "text": "$D \\geq 0 \\Rightarrow (p-1)^2 - 16 \\geq 0 \\Rightarrow p \\leq -3$ atau $p \\geq 5$." },
        { "tipe": "paragraph", "text": "Irisan dengan $p < 1$: $p \\leq -3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 3x| = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-4, 1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0, 3\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kasus 1: $x^2 - 3x = 4 \\Rightarrow x^2 - 3x - 4 = 0$" },
        { "tipe": "paragraph", "text": "$(x-4)(x+1) = 0 \\Rightarrow x = 4$ atau $x = -1$." },
        { "tipe": "paragraph", "text": "Kasus 2: $x^2 - 3x = -4 \\Rightarrow x^2 - 3x + 4 = 0$." },
        { "tipe": "paragraph", "text": "$D = 9 - 16 = -7 < 0$ → tidak ada solusi real." },
        { "tipe": "paragraph", "text": "HP = $\\{-1, 4\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2mx + (m+2) = 0$ memiliki akar-akar $\\alpha$ dan $\\beta$ dengan $\\alpha\\beta = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha\\beta = m + 2 = 3 \\Rightarrow m = 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = -x^2 + 6x - 5$ bernilai positif pada interval..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < -1$" } ],
        [ { "tipe": "paragraph", "text": "$x < -5$ atau $x > -1$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(x) > 0 \\Rightarrow -x^2 + 6x - 5 > 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 6x + 5 < 0$" },
        { "tipe": "paragraph", "text": "$(x - 1)(x - 5) < 0 \\Rightarrow 1 < x < 5$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 7x + 10 = 0$, persamaan kuadrat baru dengan akar $\\alpha + 2$ dan $\\beta + 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 11x + 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 11x - 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 11x + 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 11x + 30 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 9x + 28 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 7$; $\\alpha\\beta = 10$" },
        { "tipe": "paragraph", "text": "Jumlah baru: $(\\alpha+2) + (\\beta+2) = 11$" },
        { "tipe": "paragraph", "text": "Hasil kali: $(\\alpha+2)(\\beta+2) = 10 + 14 + 4 = 28$" },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 - 11x + 28 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 5x + 6 > 0$ dan $x^2 - 8x + 15 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 > 0 \\Rightarrow (x-2)(x-3) > 0 \\Rightarrow x < 2$ atau $x > 3$." },
        { "tipe": "paragraph", "text": "$x^2 - 8x + 15 \\leq 0 \\Rightarrow (x-3)(x-5) \\leq 0 \\Rightarrow 3 \\leq x \\leq 5$." },
        { "tipe": "paragraph", "text": "Irisan: $3 < x \\leq 5$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
