{
  "id": "bs-k10-fk-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan aplikasi fungsi kuadrat",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 2x - 8 < 0$ dengan $x$ bilangan bulat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-2, -1, 0, 1, 2, 3, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0, 1, 2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 2, 3\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan bentuk kuadrat untuk mencari pembuat nol.**" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 8 < 0$" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 2) < 0$" },
        { "tipe": "paragraph", "text": "Diperoleh pembuat nol $x = -2$ dan $x = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval penyelesaian.**" },
        { "tipe": "paragraph", "text": "Karena koefisien $x^2$ positif dan tanda pertidaksamaan $< 0$ (selang terbuka), maka daerah penyelesaian berada di antara kedua akar: $-2 < x < 4$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Daftarkan anggota bilangan bulat dalam interval tersebut.**" },
        { "tipe": "paragraph", "text": "Bilangan bulat yang terletak di antara $-2$ dan $4$ (tanpa menyertakan $-2$ dan $4$) adalah $-1, 0, 1, 2, 3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $\\{-1, 0, 1, 2, 3\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x^2 - 9}{x + 1} \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -1$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $-1 < x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pembilang.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{(x - 3)(x + 3)}{x + 1} \\geq 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan titik pembuat nol dan syarat penyebut.**" },
        { "tipe": "paragraph", "text": "Pembuat nol pembilang: $x = -3$ dan $x = 3$ (selang tertutup karena tanda $\\geq$)." },
        { "tipe": "paragraph", "text": "Pembuat nol penyebut: $x = -1$ (selang terbuka karena penyebut tidak boleh nol, $x \\neq -1$)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji tanda pada garis bilangan.**" },
        { "tipe": "paragraph", "text": "Untuk $x < -3$ (misal $x = -4$): $\\dfrac{(-)(-)}{-} = -$ (tidak memenuhi)" },
        { "tipe": "paragraph", "text": "Untuk $-3 < x < -1$ (misal $x = -2$): $\\dfrac{(-)(+)}{-} = +$ (memenuhi $\\geq 0$)" },
        { "tipe": "paragraph", "text": "Untuk $-1 < x < 3$ (misal $x = 0$): $\\dfrac{(-)(+)}{+} = -$ (tidak memenuhi)" },
        { "tipe": "paragraph", "text": "Untuk $x > 3$ (misal $x = 4$): $\\dfrac{(+)(+)}{+} = +$ (memenuhi $\\geq 0$)" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Daerah yang bertanda positif ($\\geq 0$) adalah $-3 \\leq x < -1$ atau $x \\geq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 4 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar (Teorema Vieta).**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 6x + 4 = 0$ ($a = 1$, $b = -6$, $c = 4$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-6}{1} = 6$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{4}{1} = 4$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan ubah menggunakan identitas aljabar.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{(\\alpha + \\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui.**" },
        { "tipe": "paragraph", "text": "$= \\dfrac{(6)^2 - 2(4)}{4} = \\dfrac{36 - 8}{4} = \\dfrac{28}{4} = 7$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah $7$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 4x + 7$ untuk $0 \\leq x \\leq 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari sumbu simetri ($x_p$) dan periksa apakah berada di dalam interval.**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = x^2 - 4x + 7$, diketahui $a = 1 > 0$ (parabola terbuka ke atas) dan $b = -4$." },
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} = -\\dfrac{-4}{2(1)} = 2$" },
        { "tipe": "paragraph", "text": "Karena $x_p = 2$ berada di dalam interval $0 \\leq x \\leq 5$, maka nilai minimum fungsi tercapai di titik puncak tersebut." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai fungsi di titik puncak dan bandingkan dengan batas interval.**" },
        { "tipe": "paragraph", "text": "Nilai di titik puncak: $f(2) = (2)^2 - 4(2) + 7 = 4 - 8 + 7 = 3$" },
        { "tipe": "paragraph", "text": "Nilai di ujung kiri: $f(0) = (0)^2 - 4(0) + 7 = 7$" },
        { "tipe": "paragraph", "text": "Nilai di ujung kanan: $f(5) = (5)^2 - 4(5) + 7 = 25 - 20 + 7 = 12$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai minimum fungsi pada interval tersebut adalah $3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 + (p-1)x + 4 = 0$ memiliki akar-akar positif, nilai $p$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$p \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$p < -3$" } ],
        [ { "tipe": "paragraph", "text": "$p > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < p < 5$" } ],
        [ { "tipe": "paragraph", "text": "$p \\leq -3$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 + (p-1)x + 4 = 0$, diperoleh $a = 1$, $b = p - 1$, dan $c = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan 3 syarat memiliki akar-akar real positif.**" },
        { "tipe": "paragraph", "text": "**Syarat 1 — Memiliki akar real ($D \\geq 0$):**" },
        { "tipe": "paragraph", "text": "$b^2 - 4ac \\geq 0 \\Rightarrow (p-1)^2 - 4(1)(4) \\geq 0$" },
        { "tipe": "paragraph", "text": "$(p-1)^2 - 16 \\geq 0 \\Rightarrow (p - 1 - 4)(p - 1 + 4) \\geq 0$" },
        { "tipe": "paragraph", "text": "$(p - 5)(p + 3) \\geq 0 \\Rightarrow p \\leq -3$ atau $p \\geq 5$" },
        { "tipe": "paragraph", "text": "**Syarat 2 — Jumlah kedua akar positif ($x_1 + x_2 > 0$):**" },
        { "tipe": "paragraph", "text": "$-\\dfrac{b}{a} > 0 \\Rightarrow -(p - 1) > 0 \\Rightarrow 1 - p > 0 \\Rightarrow p < 1$" },
        { "tipe": "paragraph", "text": "**Syarat 3 — Hasil kali kedua akar positif ($x_1 \\cdot x_2 > 0$):**" },
        { "tipe": "paragraph", "text": "$\\dfrac{c}{a} > 0 \\Rightarrow 4 > 0$ (selalu terpenuhi)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan irisan dari semua syarat.**" },
        { "tipe": "paragraph", "text": "Irisan dari $(p \\leq -3 \\text{ atau } p \\geq 5)$ dengan $(p < 1)$ adalah $p \\leq -3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Batas nilai $p$ yang memenuhi adalah $p \\leq -3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 3x| = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-4, 1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0, 3\\}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan definisi persamaan nilai mutlak.**" },
        { "tipe": "paragraph", "text": "Sifat $|f(x)| = a \\iff f(x) = a$ atau $f(x) = -a$, sehingga terbagi menjadi dua kasus." },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan Kasus 1 ($x^2 - 3x = 4$).**" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) = 0 \\Rightarrow x = 4$ atau $x = -1$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan Kasus 2 ($x^2 - 3x = -4$).**" },
        { "tipe": "paragraph", "text": "$x^2 - 3x + 4 = 0$" },
        { "tipe": "paragraph", "text": "Cek diskriminannya: $D = b^2 - 4ac = (-3)^2 - 4(1)(4) = 9 - 16 = -7 < 0$." },
        { "tipe": "paragraph", "text": "Karena $D < 0$, persamaan pada Kasus 2 tidak memiliki akar real." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Gabungan solusi realnya adalah $\\{-1, 4\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2mx + (m+2) = 0$ memiliki akar-akar $\\alpha$ dan $\\beta$ dengan $\\alpha\\beta = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 2mx + (m+2) = 0$, diperoleh $a = 1$, $b = -2m$, dan $c = m + 2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus hasil kali akar (Teorema Vieta).**" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{c}{a} \\Rightarrow 3 = \\dfrac{m + 2}{1}$" },
        { "tipe": "paragraph", "text": "$m + 2 = 3 \\Rightarrow m = 3 - 2 = 1$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $m$ yang memenuhi adalah $1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = -x^2 + 6x - 5$ bernilai positif pada interval..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < -1$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -5$ atau $x > -1$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Bentuk pertidaksamaan sesuai syarat fungsi bernilai positif ($f(x) > 0$).**" },
        { "tipe": "paragraph", "text": "$-x^2 + 6x - 5 > 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan kedua ruas dengan $-1$ agar koefisien $x^2$ positif.**" },
        { "tipe": "paragraph", "text": "Ingat bahwa mengalikan pertidaksamaan dengan bilangan negatif akan membalik arah tanda pertidaksamaan:" },
        { "tipe": "paragraph", "text": "$x^2 - 6x + 5 < 0$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan dan tentukan interval penyelesaian.**" },
        { "tipe": "paragraph", "text": "$(x - 1)(x - 5) < 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $x = 1$ dan $x = 5$. Karena tanda $< 0$, maka daerah penyelesaian berada di antara kedua akar." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Fungsi bernilai positif pada interval $1 < x < 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 7x + 10 = 0$, persamaan kuadrat baru dengan akar $\\alpha + 2$ dan $\\beta + 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 11x - 28 = 0$" },
        [ { "tipe": "paragraph", "text": "$x^2 + 11x + 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 11x + 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 11x + 30 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 9x + 28 = 0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar persamaan awal.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 7x + 10 = 0$ ($a = 1$, $b = -7$, $c = 10$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{-7}{1} = 7$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{10}{1} = 10$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar-akar baru ($x_1 = \\alpha + 2$ dan $x_2 = \\beta + 2$).**" },
        { "tipe": "paragraph", "text": "Jumlah akar baru: $x_1 + x_2 = (\\alpha + 2) + (\\beta + 2) = (\\alpha + \\beta) + 4 = 7 + 4 = 11$" },
        { "tipe": "paragraph", "text": "Hasil kali akar baru: $x_1 \\cdot x_2 = (\\alpha + 2)(\\beta + 2) = \\alpha\\beta + 2(\\alpha + \\beta) + 4 = 10 + 2(7) + 4 = 28$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru.**" },
        { "tipe": "paragraph", "text": "$x^2 - (x_1 + x_2)x + (x_1 \\cdot x_2) = 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 11x + 28 = 0$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Persamaan kuadrat barunya adalah $x^2 - 11x + 28 = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 5x + 6 > 0$ dan $x^2 - 8x + 15 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$3 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Selesaikan pertidaksamaan pertama.**" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 > 0 \\Rightarrow (x - 2)(x - 3) > 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = 2$ dan $x = 3$. Karena tanda $> 0$, penyelesaiannya adalah: $x < 2$ atau $x > 3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan kedua.**" },
        { "tipe": "paragraph", "text": "$x^2 - 8x + 15 \\leq 0 \\Rightarrow (x - 3)(x - 5) \\leq 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = 3$ dan $x = 5$. Karena tanda $\\leq 0$, penyelesaiannya adalah: $3 \\leq x \\leq 5$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Cari irisan dari kedua penyelesaian.**" },
        { "tipe": "paragraph", "text": "Kata hubung **dan** berarti mencari irisan antara $(x < 2 \\text{ atau } x > 3)$ dengan $(3 \\leq x \\leq 5)$." },
        { "tipe": "paragraph", "text": "Perhatikan titik $x = 3$: pada pertidaksamaan pertama $x = 3$ tidak termasuk (selang terbuka $> 3$), sehingga pada irisannya $x = 3$ juga tidak termasuk." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $3 < x \\leq 5$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}