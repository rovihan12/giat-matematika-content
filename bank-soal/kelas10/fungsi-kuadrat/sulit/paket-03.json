{
  "id": "bs-k10-fk-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan aplikasi fungsi kuadrat",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 2x - 8 < 0$ dengan $x$ bilangan bulat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-2, -1, 0, 1, 2, 3, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0, 1, 2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 2, 3\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan bentuk kuadrat untuk mencari pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 8 < 0 \\Rightarrow (x - 4)(x + 2) < 0" },
        { "tipe": "paragraph", "text": "Diperoleh pembuat nol $x = -2$ dan $x = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval penyelesaian**" },
        { "tipe": "paragraph", "text": "Karena koefisien $x^2$ positif dan tanda pertidaksamaan $< 0$ (selang terbuka), daerah penyelesaian berada di antara kedua akar:" },
        { "tipe": "formula_block", "latex": "-2 < x < 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Daftarkan anggota bilangan bulat dalam interval tersebut**" },
        { "tipe": "paragraph", "text": "Bilangan bulat yang terletak di antara $-2$ dan $4$ (tanpa menyertakan $-2$ dan $4$) adalah $-1, 0, 1, 2, 3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{-1, 0, 1, 2, 3\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x^2 - 9}{x + 1} \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -1$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $-1 < x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan bentuk kuadrat pada pembilang**" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x - 3)(x + 3)}{x + 1} \\geq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan titik pembuat nol pembilang dan syarat penyebut**" },
        { "tipe": "paragraph", "text": "Pembuat nol pembilang adalah $x = -3$ dan $x = 3$ (selang tertutup karena tanda $\\geq$), sedangkan pembuat nol penyebut adalah $x = -1$ (selang terbuka karena syarat $x \\neq -1$)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Lakukan uji tanda pada garis bilangan untuk mencari daerah $\\geq 0$**" },
        { "tipe": "formula_block", "latex": "x < -3 \\; (\\text{misal } x = -4) \\Rightarrow \\dfrac{(-)(-)}{(-)} = (-) \\quad [\\text{Tidak memenuhi}]" },
        { "tipe": "formula_block", "latex": "-3 < x < -1 \\; (\\text{misal } x = -2) \\Rightarrow \\dfrac{(-)(+)}{(-)} = (+) \\quad [\\text{Memenuhi}]" },
        { "tipe": "formula_block", "latex": "-1 < x < 3 \\; (\\text{misal } x = 0) \\Rightarrow \\dfrac{(-)(+)}{(+)} = (-) \\quad [\\text{Tidak memenuhi}]" },
        { "tipe": "formula_block", "latex": "x > 3 \\; (\\text{misal } x = 4) \\Rightarrow \\dfrac{(+)(+)}{(+)} = (+) \\quad [\\text{Memenuhi}]" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-3 \\leq x < -1$ atau $x \\geq 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 4 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar (Teorema Vieta)**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 6x + 4 = 0$ ($a = 1$, $b = -6$, $c = 4$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-6}{1} = 6" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{4}{1} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan ubah menggunakan identitas aljabar**" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{(\\alpha + \\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui**" },
        { "tipe": "formula_block", "latex": "\\dfrac{(\\alpha + \\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta} = \\dfrac{(6)^2 - 2(4)}{4} = \\dfrac{36 - 8}{4} = \\dfrac{28}{4} = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah **$7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 4x + 7$ untuk $0 \\leq x \\leq 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari sumbu simetri ($x_p$) dan periksa posisinya terhadap interval**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = x^2 - 4x + 7$, diketahui $a = 1 > 0$ (parabola terbuka ke atas) dan $b = -4$:" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{b}{2a} = -\\dfrac{-4}{2(1)} = 2" },
        { "tipe": "paragraph", "text": "Karena $x_p = 2$ berada di dalam interval $0 \\leq x \\leq 5$, nilai minimum tercapai pada titik puncak tersebut." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai fungsi pada titik puncak dan kedua ujung interval**" },
        { "tipe": "formula_block", "latex": "f(2) = (2)^2 - 4(2) + 7 = 4 - 8 + 7 = 3" },
        { "tipe": "formula_block", "latex": "f(0) = (0)^2 - 4(0) + 7 = 7" },
        { "tipe": "formula_block", "latex": "f(5) = (5)^2 - 4(5) + 7 = 25 - 20 + 7 = 12" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum fungsi pada interval tersebut adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 + (p-1)x + 4 = 0$ memiliki akar-akar positif, nilai $p$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$p \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$p < -3$" } ],
        [ { "tipe": "paragraph", "text": "$p > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < p < 5$" } ],
        [ { "tipe": "paragraph", "text": "$p \\leq -3$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $x^2 + (p-1)x + 4 = 0$, diperoleh $a = 1$, $b = p - 1$, dan $c = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan syarat memiliki akar-akar real ($D \\geq 0$)**" },
        { "tipe": "formula_block", "latex": "b^2 - 4ac \\geq 0 \\Rightarrow (p-1)^2 - 4(1)(4) \\geq 0" },
        { "tipe": "formula_block", "latex": "(p-1)^2 - 16 \\geq 0 \\Rightarrow (p - 5)(p + 3) \\geq 0" },
        { "tipe": "formula_block", "latex": "p \\leq -3 \\quad \\text{atau} \\quad p \\geq 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Terapkan syarat jumlah ($x_1 + x_2 > 0$) dan hasil kali ($x_1 \\cdot x_2 > 0$) akar positif**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 > 0 \\Rightarrow -\\dfrac{b}{a} > 0 \\Rightarrow -(p - 1) > 0 \\Rightarrow p < 1" },
        { "tipe": "formula_block", "latex": "x_1 \\cdot x_2 > 0 \\Rightarrow \\dfrac{c}{a} > 0 \\Rightarrow 4 > 0 \\quad [\\text{Selalu terpenuhi}]" },
        { "tipe": "paragraph", "text": "**Langkah 4: Iriskan ketiga syarat tersebut**" },
        { "tipe": "paragraph", "text": "Irisan dari $(p \\leq -3 \\text{ atau } p \\geq 5)$ dengan $p < 1$ menghasilkan:" },
        { "tipe": "formula_block", "latex": "p \\leq -3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, batas nilai $p$ yang memenuhi adalah **$p \\leq -3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 3x| = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-4, 1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0, 3\\}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan definisi persamaan nilai mutlak**" },
        { "tipe": "paragraph", "text": "Berdasarkan sifat $|f(x)| = a \\iff f(x) = a$ atau $f(x) = -a$, persamaan terbagi menjadi dua kasus." },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan Kasus 1 ($x^2 - 3x = 4$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 4 = 0 \\Rightarrow (x - 4)(x + 1) = 0" },
        { "tipe": "formula_block", "latex": "x = 4 \\quad \\text{atau} \\quad x = -1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan Kasus 2 ($x^2 - 3x = -4$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x + 4 = 0" },
        { "tipe": "paragraph", "text": "Periksa nilai diskriminannya untuk memastikan keberadaan akar real:" },
        { "tipe": "formula_block", "latex": "D = b^2 - 4ac = (-3)^2 - 4(1)(4) = 9 - 16 = -7 < 0" },
        { "tipe": "paragraph", "text": "Karena $D < 0$, persamaan pada Kasus 2 tidak memiliki akar real." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{-1, 4\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2mx + (m+2) = 0$ memiliki akar-akar $\\alpha$ dan $\\beta$ dengan $\\alpha\\beta = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 2mx + (m+2) = 0$, diperoleh $a = 1$, $b = -2m$, dan $c = m + 2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus hasil kali akar (Teorema Vieta)**" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{c}{a} \\Rightarrow 3 = \\dfrac{m + 2}{1}" },
        { "tipe": "formula_block", "latex": "m + 2 = 3 \\Rightarrow m = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ yang memenuhi adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = -x^2 + 6x - 5$ bernilai positif pada interval..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < -1$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -5$ atau $x > -1$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Bentuk pertidaksamaan sesuai syarat fungsi bernilai positif ($f(x) > 0$)**" },
        { "tipe": "formula_block", "latex": "-x^2 + 6x - 5 > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan kedua ruas dengan $-1$ agar koefisien $x^2$ positif**" },
        { "tipe": "paragraph", "text": "Mengalikan pertidaksamaan dengan bilangan negatif membalik arah tanda pertidaksamaan:" },
        { "tipe": "formula_block", "latex": "x^2 - 6x + 5 < 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan dan tentukan interval penyelesaian**" },
        { "tipe": "formula_block", "latex": "(x - 1)(x - 5) < 0" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $x = 1$ dan $x = 5$. Karena tanda $< 0$, daerah penyelesaian berada di antara kedua akar:" },
        { "tipe": "formula_block", "latex": "1 < x < 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, fungsi bernilai positif pada interval **$1 < x < 5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 7x + 10 = 0$, persamaan kuadrat baru dengan akar $\\alpha + 2$ dan $\\beta + 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 11x - 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 11x + 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 11x + 28 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 11x + 30 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 9x + 28 = 0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar persamaan awal**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 7x + 10 = 0$ ($a = 1$, $b = -7$, $c = 10$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-7}{1} = 7" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{10}{1} = 10" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar-akar baru ($x_1 = \\alpha + 2$ dan $x_2 = \\beta + 2$)**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = (\\alpha + 2) + (\\beta + 2) = (\\alpha + \\beta) + 4 = 7 + 4 = 11" },
        { "tipe": "formula_block", "latex": "x_1 \\cdot x_2 = (\\alpha + 2)(\\beta + 2) = \\alpha\\beta + 2(\\alpha + \\beta) + 4 = 10 + 2(7) + 4 = 28" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru**" },
        { "tipe": "formula_block", "latex": "x^2 - (x_1 + x_2)x + (x_1 \\cdot x_2) = 0" },
        { "tipe": "formula_block", "latex": "x^2 - 11x + 28 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat barunya adalah **$x^2 - 11x + 28 = 0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 5x + 6 > 0$ dan $x^2 - 8x + 15 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$3 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Selesaikan pertidaksamaan kuadrat pertama**" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 6 > 0 \\Rightarrow (x - 2)(x - 3) > 0" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $x = 2$ dan $x = 3$. Karena tanda $> 0$, diperoleh interval pertama:" },
        { "tipe": "formula_block", "latex": "x < 2 \\quad \\text{atau} \\quad x > 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan kuadrat kedua**" },
        { "tipe": "formula_block", "latex": "x^2 - 8x + 15 \\leq 0 \\Rightarrow (x - 3)(x - 5) \\leq 0" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $x = 3$ dan $x = 5$. Karena tanda $\\leq 0$, diperoleh interval kedua:" },
        { "tipe": "formula_block", "latex": "3 \\leq x \\leq 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan kedua interval penyelesaian**" },
        { "tipe": "paragraph", "text": "Kata hubung **dan** menunjukkan irisan antara $(x < 2 \\text{ atau } x > 3)$ dengan $3 \\leq x \\leq 5$. Karena $x = 3$ tidak termuat pada pertidaksamaan pertama, diperoleh:" },
        { "tipe": "formula_block", "latex": "3 < x \\leq 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$3 < x \\leq 5$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
