{
  "id": "bs-k10-fk-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang fungsi kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $x^2 - 6x + 4 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar (Teorema Vieta).**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 6x + 4 = 0$ ($a = 1$, $b = -6$, $c = 4$):" },
        { "tipe": "paragraph", "text": "$x_1 + x_2 = -\\dfrac{b}{a} = -\\dfrac{-6}{1} = 6$" },
        { "tipe": "paragraph", "text": "$x_1 x_2 = \\dfrac{c}{a} = \\dfrac{4}{1} = 4$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk aljabar yang ditanyakan.**" },
        { "tipe": "paragraph", "text": "$x_1^2 x_2 + x_1 x_2^2 = x_1 x_2(x_1 + x_2)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui.**" },
        { "tipe": "paragraph", "text": "$= 4 \\cdot 6 = 24$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $x_1^2 x_2 + x_1 x_2^2$ adalah $24$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x + 2 = 0$, nilai $\\alpha^4 + \\beta^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$136$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$104$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 4x + 2 = 0$ ($a = 1$, $b = -4$, $c = 2$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{-4}{1} = 4$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{2}{1} = 2$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $\\alpha^2 + \\beta^2$.**" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = (4)^2 - 2(2) = 16 - 4 = 12$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $\\alpha^4 + \\beta^4$ menggunakan hasil dari Langkah 2.**" },
        { "tipe": "paragraph", "text": "$\\alpha^4 + \\beta^4 = (\\alpha^2 + \\beta^2)^2 - 2(\\alpha\\beta)^2$" },
        { "tipe": "paragraph", "text": "$\\alpha^4 + \\beta^4 = (12)^2 - 2(2)^2 = 144 - 2(4) = 144 - 8 = 136$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $\\alpha^4 + \\beta^4$ adalah $136$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3x - 4 > 0$ dan $x^2 - 5x + 4 < 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$4 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Selesaikan pertidaksamaan pertama.**" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 > 0 \\Rightarrow (x - 4)(x + 1) > 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = -1$ dan $x = 4$. Karena tanda $> 0$, penyelesaiannya adalah: $x < -1$ atau $x > 4$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan kedua.**" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 4 < 0 \\Rightarrow (x - 1)(x - 4) < 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = 1$ dan $x = 4$. Karena tanda $< 0$, penyelesaiannya adalah: $1 < x < 4$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Cari irisan dari kedua penyelesaian.**" },
        { "tipe": "paragraph", "text": "Kata hubung **dan** mengharuskan kita mencari irisan antara $(x < -1 \\text{ atau } x > 4)$ dengan $(1 < x < 4)$." },
        { "tipe": "paragraph", "text": "Kedua interval tersebut tidak memiliki daerah yang saling beririsan (himpunan kosong)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Sistem pertidaksamaan tersebut tidak memiliki solusi." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y = 10$ dan $xy = 21$, nilai $x^2 + y^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$58$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$62$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat jumlah dua suku.**" },
        { "tipe": "paragraph", "text": "$(x + y)^2 = x^2 + 2xy + y^2 \\Rightarrow x^2 + y^2 = (x + y)^2 - 2xy$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x + y = 10$ dan $xy = 21$.**" },
        { "tipe": "paragraph", "text": "$x^2 + y^2 = (10)^2 - 2(21)$" },
        { "tipe": "paragraph", "text": "$x^2 + y^2 = 100 - 42 = 58$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $x^2 + y^2$ adalah $58$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $a$ agar persamaan $x^2 + ax + (a^2 - 9) = 0$ memiliki akar-akar yang saling berlawanan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 0$" } ],
        [ { "tipe": "paragraph", "text": "$a = 1$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami syarat dua akar saling berlawanan.**" },
        { "tipe": "paragraph", "text": "Dua akar saling berlawanan berarti $x_1 = -x_2$, sehingga jumlah kedua akarnya sama dengan nol ($x_1 + x_2 = 0$)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus jumlah akar (Teorema Vieta).**" },
        { "tipe": "paragraph", "text": "Dari $x^2 + ax + (a^2 - 9) = 0$, diketahui koefisien $x^2$ adalah $1$, koefisien $x$ adalah $a$, dan konstanta adalah $a^2 - 9$." },
        { "tipe": "paragraph", "text": "$x_1 + x_2 = -\\dfrac{a}{1} = -a$" },
        { "tipe": "paragraph", "text": "Karena $x_1 + x_2 = 0$, maka $-a = 0 \\Rightarrow a = 0$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Verifikasi keberadaan akar real ($D > 0$).**" },
        { "tipe": "paragraph", "text": "Untuk $a = 0$, persamaan menjadi $x^2 - 9 = 0 \\Rightarrow x = 3$ dan $x = -3$ (terbukti dua akar real yang saling berlawanan)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $a$ yang memenuhi adalah $a = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 4x + 8$ untuk $x \\in \\mathbb{R}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari sumbu simetri ($x_p$) fungsi kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = x^2 - 4x + 8$, diketahui $a = 1 > 0$ (parabola terbuka ke atas sehingga memiliki nilai minimum) dan $b = -4$." },
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} = -\\dfrac{-4}{2(1)} = 2$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke fungsi $f(x)$ untuk mendapatkan nilai minimum.**" },
        { "tipe": "paragraph", "text": "$f_{\\text{min}} = f(2) = (2)^2 - 4(2) + 8$" },
        { "tipe": "paragraph", "text": "$f_{\\text{min}} = 4 - 8 + 8 = 4$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai minimum fungsi tersebut adalah $4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 4|x| - 5 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-5, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-5, -1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 5\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Lakukan pemisalan variabel.**" },
        { "tipe": "paragraph", "text": "Ingat sifat $x^2 = |x|^2$. Misalkan $t = |x|$ dengan syarat $t \\geq 0$, maka persamaan menjadi:" },
        { "tipe": "paragraph", "text": "$t^2 - 4t - 5 = 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan persamaan kuadrat dalam $t$.**" },
        { "tipe": "paragraph", "text": "$(t - 5)(t + 1) = 0$" },
        { "tipe": "paragraph", "text": "Diperoleh $t = 5$ atau $t = -1$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $t = |x|$ dan uji syarat $t \\geq 0$.**" },
        { "tipe": "paragraph", "text": "Untuk $t = -1$: tidak memenuhi karena nilai mutlak tidak pernah negatif ($|x| = -1$ tidak ada solusi)." },
        { "tipe": "paragraph", "text": "Untuk $t = 5$: $|x| = 5 \\Rightarrow x = 5$ atau $x = -5$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $\\{-5, 5\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 7x + 9 = 0$, persamaan kuadrat baru dengan akar $\\alpha^2$ dan $\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 31x + 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 31x - 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 31x + 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 31x + 18 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 18x + 81 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar persamaan awal.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 7x + 9 = 0$ ($a = 1$, $b = -7$, $c = 9$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{-7}{1} = 7$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{9}{1} = 9$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar-akar baru ($x_1 = \\alpha^2$ dan $x_2 = \\beta^2$).**" },
        { "tipe": "paragraph", "text": "Jumlah akar baru: $x_1 + x_2 = \\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = (7)^2 - 2(9) = 49 - 18 = 31$" },
        { "tipe": "paragraph", "text": "Hasil kali akar baru: $x_1 \\cdot x_2 = \\alpha^2 \\beta^2 = (\\alpha\\beta)^2 = (9)^2 = 81$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru.**" },
        { "tipe": "paragraph", "text": "$x^2 - (x_1 + x_2)x + (x_1 \\cdot x_2) = 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 31x + 81 = 0$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Persamaan kuadrat barunya adalah $x^2 - 31x + 81 = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = ax^2 + bx + c$ melalui titik $(1, 0)$, $(3, 0)$, dan $(0, 6)$, nilai $a + b + c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Bentuk persamaan fungsi kuadrat dari dua titik potong sumbu-$x$.**" },
        { "tipe": "paragraph", "text": "Karena grafik memotong sumbu-$x$ di $(1, 0)$ dan $(3, 0)$, gunakan rumus $f(x) = a(x - x_1)(x - x_2)$:" },
        { "tipe": "paragraph", "text": "$f(x) = a(x - 1)(x - 3)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari nilai $a$ dengan mensubstitusikan titik lainnya $(0, 6)$.**" },
        { "tipe": "paragraph", "text": "$f(0) = 6 \\Rightarrow a(0 - 1)(0 - 3) = 6$" },
        { "tipe": "paragraph", "text": "$a(-1)(-3) = 6 \\Rightarrow 3a = 6 \\Rightarrow a = 2$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jabarkan fungsi $f(x)$ dan hitung $a + b + c$.**" },
        { "tipe": "paragraph", "text": "$f(x) = 2(x - 1)(x - 3) = 2(x^2 - 4x + 3) = 2x^2 - 8x + 6$" },
        { "tipe": "paragraph", "text": "Diperoleh $a = 2$, $b = -8$, dan $c = 6$, sehingga $a + b + c = 2 + (-8) + 6 = 0$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $a + b + c$ adalah $0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x - 3 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$170$" } ],
        [ { "tipe": "paragraph", "text": "$160$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ],
        [ { "tipe": "paragraph", "text": "$190$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 5x - 3 = 0$ ($a = 1$, $b = -5$, $c = -3$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{-5}{1} = 5$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{-3}{1} = -3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk $\\alpha^3 + \\beta^3$ menggunakan identitas aljabar.**" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui.**" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (5)^3 - 3(-3)(5)$" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = 125 + 45 = 170$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $\\alpha^3 + \\beta^3$ adalah $170$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
