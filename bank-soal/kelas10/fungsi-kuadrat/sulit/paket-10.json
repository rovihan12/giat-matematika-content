{
  "id": "bs-k10-fk-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang fungsi kuadrat (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $x^2 - 6x + 4 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar (Teorema Vieta)**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 6x + 4 = 0$ ($a = 1$, $b = -6$, $c = 4$), diperoleh:" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{b}{a} = -\\dfrac{-6}{1} = 6" },
        { "tipe": "formula_block", "latex": "x_1 x_2 = \\dfrac{c}{a} = \\dfrac{4}{1} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk aljabar yang ditanyakan**" },
        { "tipe": "formula_block", "latex": "x_1^2 x_2 + x_1 x_2^2 = x_1 x_2(x_1 + x_2)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui**" },
        { "tipe": "formula_block", "latex": "x_1 x_2(x_1 + x_2) = 4 \\cdot 6 = 24" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $x_1^2 x_2 + x_1 x_2^2$ adalah **$24$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x + 2 = 0$, nilai $\\alpha^4 + \\beta^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$136$" } ],
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$104$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 4x + 2 = 0$ ($a = 1$, $b = -4$, $c = 2$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-4}{1} = 4" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{2}{1} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $\\alpha^2 + \\beta^2$ menggunakan identitas aljabar**" },
        { "tipe": "formula_block", "latex": "\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = (4)^2 - 2(2) = 16 - 4 = 12" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $\\alpha^4 + \\beta^4$ menggunakan hasil dari Langkah 2**" },
        { "tipe": "formula_block", "latex": "\\alpha^4 + \\beta^4 = (\\alpha^2 + \\beta^2)^2 - 2(\\alpha\\beta)^2 = (12)^2 - 2(2)^2 = 144 - 8 = 136" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $\\alpha^4 + \\beta^4$ adalah **$136$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3x - 4 > 0$ dan $x^2 - 5x + 4 < 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$4 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > 4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Selesaikan pertidaksamaan kuadrat pertama**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 4 > 0 \\Rightarrow (x - 4)(x + 1) > 0" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $x = -1$ dan $x = 4$. Karena tanda $> 0$, diperoleh interval pertama:" },
        { "tipe": "formula_block", "latex": "x < -1 \\quad \\text{atau} \\quad x > 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan kuadrat kedua**" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 4 < 0 \\Rightarrow (x - 1)(x - 4) < 0" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $x = 1$ dan $x = 4$. Karena tanda $< 0$, diperoleh interval kedua:" },
        { "tipe": "formula_block", "latex": "1 < x < 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan kedua interval penyelesaian**" },
        { "tipe": "paragraph", "text": "Kata hubung **dan** mengharuskan kita mencari irisan antara $(x < -1 \\text{ atau } x > 4)$ dengan $1 < x < 4$. Kedua interval tersebut tidak memiliki daerah yang saling beririsan (himpunan kosong)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, sistem pertidaksamaan tersebut **tidak memiliki solusi**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y = 10$ dan $xy = 21$, nilai $x^2 + y^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$62$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$58$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat jumlah dua suku**" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = x^2 + 2xy + y^2 \\Rightarrow x^2 + y^2 = (x + y)^2 - 2xy" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x + y = 10$ dan $xy = 21$**" },
        { "tipe": "formula_block", "latex": "x^2 + y^2 = (10)^2 - 2(21) = 100 - 42 = 58" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $x^2 + y^2$ adalah **$58$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $a$ agar persamaan $x^2 + ax + (a^2 - 9) = 0$ memiliki akar-akar yang saling berlawanan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 1$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 0$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami syarat dua akar saling berlawanan**" },
        { "tipe": "paragraph", "text": "Dua akar saling berlawanan berarti $x_1 = -x_2$, sehingga jumlah kedua akarnya sama dengan nol ($x_1 + x_2 = 0$)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus jumlah akar (Teorema Vieta)**" },
        { "tipe": "paragraph", "text": "Dari $x^2 + ax + (a^2 - 9) = 0$, diketahui koefisien $x^2$ adalah $1$ dan koefisien $x$ adalah $a$:" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{a}{1} = -a" },
        { "tipe": "formula_block", "latex": "-a = 0 \\Rightarrow a = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Verifikasi keberadaan akar real ($D > 0$)**" },
        { "tipe": "paragraph", "text": "Substitusikan $a = 0$ ke persamaan awal untuk memastikan akarnya real dan saling berlawanan:" },
        { "tipe": "formula_block", "latex": "x^2 - 9 = 0 \\Rightarrow x = 3 \\quad \\text{atau} \\quad x = -3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ yang memenuhi adalah **$a = 0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 4x + 8$ untuk $x \\in \\mathbb{R}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari sumbu simetri ($x_p$) fungsi kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = x^2 - 4x + 8$, diketahui $a = 1 > 0$ (parabola terbuka ke atas sehingga memiliki nilai minimum) dan $b = -4$:" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{b}{2a} = -\\dfrac{-4}{2(1)} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke fungsi $f(x)$ untuk mendapatkan nilai minimum**" },
        { "tipe": "formula_block", "latex": "f_{\\text{min}} = f(2) = (2)^2 - 4(2) + 8 = 4 - 8 + 8 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum fungsi tersebut adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 4|x| - 5 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-1, 1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-5, -1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-5, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 5\\}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Lakukan pemisalan variabel $t = |x|$**" },
        { "tipe": "paragraph", "text": "Dengan menggunakan sifat $x^2 = |x|^2$ dan syarat $t \\geq 0$, persamaan menjadi:" },
        { "tipe": "formula_block", "latex": "t^2 - 4t - 5 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan persamaan kuadrat dalam $t$**" },
        { "tipe": "formula_block", "latex": "(t - 5)(t + 1) = 0 \\Rightarrow t = 5 \\quad \\text{atau} \\quad t = -1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan pemisalan $t = |x|$ dan uji syarat $t \\geq 0$**" },
        { "tipe": "formula_block", "latex": "t = -1 \\Rightarrow |x| = -1 \\quad [\\text{Tidak memenuhi karena } |x| \\geq 0]" },
        { "tipe": "formula_block", "latex": "t = 5 \\Rightarrow |x| = 5 \\Rightarrow x = 5 \\quad \\text{atau} \\quad x = -5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{-5, 5\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 7x + 9 = 0$, persamaan kuadrat baru dengan akar $\\alpha^2$ dan $\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 31x - 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 31x + 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 31x + 18 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 31x + 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 18x + 81 = 0$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar persamaan awal**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 7x + 9 = 0$ ($a = 1$, $b = -7$, $c = 9$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-7}{1} = 7" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{9}{1} = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar-akar baru ($x_1 = \\alpha^2$ dan $x_2 = \\beta^2$)**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = \\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = (7)^2 - 2(9) = 49 - 18 = 31" },
        { "tipe": "formula_block", "latex": "x_1 \\cdot x_2 = \\alpha^2 \\beta^2 = (\\alpha\\beta)^2 = (9)^2 = 81" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru**" },
        { "tipe": "formula_block", "latex": "x^2 - (x_1 + x_2)x + (x_1 \\cdot x_2) = 0" },
        { "tipe": "formula_block", "latex": "x^2 - 31x + 81 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat barunya adalah **$x^2 - 31x + 81 = 0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = ax^2 + bx + c$ melalui titik $(1, 0)$, $(3, 0)$, dan $(0, 6)$, nilai $a + b + c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Bentuk persamaan fungsi kuadrat dari dua titik potong sumbu-$x$**" },
        { "tipe": "paragraph", "text": "Karena grafik memotong sumbu-$x$ di $(1, 0)$ dan $(3, 0)$, gunakan rumus $f(x) = a(x - x_1)(x - x_2)$:" },
        { "tipe": "formula_block", "latex": "f(x) = a(x - 1)(x - 3)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari nilai $a$ dengan mensubstitusikan titik lainnya $(0, 6)$**" },
        { "tipe": "formula_block", "latex": "f(0) = 6 \\Rightarrow a(0 - 1)(0 - 3) = 6" },
        { "tipe": "formula_block", "latex": "3a = 6 \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jabarkan fungsi $f(x)$ dan hitung $a + b + c$**" },
        { "tipe": "formula_block", "latex": "f(x) = 2(x - 1)(x - 3) = 2(x^2 - 4x + 3) = 2x^2 - 8x + 6" },
        { "tipe": "paragraph", "text": "Diperoleh $a = 2$, $b = -8$, dan $c = 6$, sehingga:" },
        { "tipe": "formula_block", "latex": "a + b + c = 2 + (-8) + 6 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $a + b + c$ adalah **$0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x - 3 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$160$" } ],
        [ { "tipe": "paragraph", "text": "$170$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ],
        [ { "tipe": "paragraph", "text": "$190$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 5x - 3 = 0$ ($a = 1$, $b = -5$, $c = -3$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-5}{1} = 5" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{-3}{1} = -3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk $\\alpha^3 + \\beta^3$ menggunakan identitas aljabar**" },
        { "tipe": "formula_block", "latex": "\\alpha^3 + \\beta^3 = (\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui**" },
        { "tipe": "formula_block", "latex": "\\alpha^3 + \\beta^3 = (5)^3 - 3(-3)(5) = 125 + 45 = 170" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $\\alpha^3 + \\beta^3$ adalah **$170$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
