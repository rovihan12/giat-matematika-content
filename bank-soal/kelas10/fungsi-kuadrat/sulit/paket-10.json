{
  "id": "bs-k10-fk-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang fungsi kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $x^2 - 6x + 4 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 6$; $x_1 x_2 = 4$" },
        { "tipe": "paragraph", "text": "$x_1^2 x_2 + x_1 x_2^2 = x_1 x_2(x_1 + x_2) = 4 \\cdot 6 = 24$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x + 2 = 0$, nilai $\\alpha^4 + \\beta^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$136$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$104$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 4$; $\\alpha\\beta = 2$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = (\\alpha+\\beta)^2 - 2\\alpha\\beta = 16 - 4 = 12$" },
        { "tipe": "paragraph", "text": "$\\alpha^4 + \\beta^4 = (\\alpha^2 + \\beta^2)^2 - 2(\\alpha\\beta)^2 = 144 - 8 = 136$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3x - 4 > 0$ dan $x^2 - 5x + 4 < 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$4 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 > 0 \\Rightarrow (x-4)(x+1) > 0 \\Rightarrow x < -1$ atau $x > 4$." },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 4 < 0 \\Rightarrow (x-1)(x-4) < 0 \\Rightarrow 1 < x < 4$." },
        { "tipe": "paragraph", "text": "Irisan: kosong (karena $x > 4$ dan $x < 4$ tidak bertemu)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y = 10$ dan $xy = 21$, nilai $x^2 + y^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$58$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$62$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + y^2 = (x+y)^2 - 2xy = 100 - 42 = 58$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $a$ agar persamaan $x^2 + ax + (a^2 - 9) = 0$ memiliki akar-akar yang saling berlawanan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 0$" } ],
        [ { "tipe": "paragraph", "text": "$a = 1$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar berlawanan: $x_1 = -x_2 \\Rightarrow x_1 + x_2 = 0$." },
        { "tipe": "paragraph", "text": "Dari Vieta: $x_1 + x_2 = -a$." },
        { "tipe": "paragraph", "text": "$-a = 0 \\Rightarrow a = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 4x + 8$ untuk $x \\in \\mathbb{R}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 2$; $f(2) = 4 - 8 + 8 = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 4|x| - 5 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-5, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-5, -1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 5\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $t = |x| \\geq 0$: $t^2 - 4t - 5 = 0$" },
        { "tipe": "paragraph", "text": "$(t - 5)(t + 1) = 0 \\Rightarrow t = 5$ atau $t = -1$." },
        { "tipe": "paragraph", "text": "$t = 5$ (valid), maka $|x| = 5 \\Rightarrow x = \\pm 5$." },
        { "tipe": "paragraph", "text": "$t = -1$ (tidak valid)." },
        { "tipe": "paragraph", "text": "HP = $\\{-5, 5\\}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 7x + 9 = 0$, persamaan kuadrat baru dengan akar $\\alpha^2$ dan $\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 31x + 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 31x - 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 31x + 81 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 31x + 18 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 18x + 81 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 7$; $\\alpha\\beta = 9$" },
        { "tipe": "paragraph", "text": "Jumlah baru: $\\alpha^2 + \\beta^2 = 49 - 18 = 31$" },
        { "tipe": "paragraph", "text": "Hasil kali baru: $(\\alpha\\beta)^2 = 81$" },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 - 31x + 81 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = ax^2 + bx + c$ melalui titik $(1, 0)$, $(3, 0)$, dan $(0, 6)$, nilai $a + b + c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar $x = 1$ dan $x = 3$: $f(x) = a(x-1)(x-3)$." },
        { "tipe": "paragraph", "text": "Substitusi $(0, 6)$: $a(0-1)(0-3) = 6 \\Rightarrow 3a = 6 \\Rightarrow a = 2$." },
        { "tipe": "paragraph", "text": "$f(x) = 2(x-1)(x-3) = 2x^2 - 8x + 6$." },
        { "tipe": "paragraph", "text": "$a + b + c = 2 - 8 + 6 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x - 3 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$170$" } ],
        [ { "tipe": "paragraph", "text": "$160$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ],
        [ { "tipe": "paragraph", "text": "$190$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 5$; $\\alpha\\beta = -3$" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (\\alpha+\\beta)^3 - 3\\alpha\\beta(\\alpha+\\beta)$" },
        { "tipe": "paragraph", "text": "$= 125 - 3(-3)(5) = 125 + 45 = 170$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
