{
  "id": "bs-k10-fk-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang sistem persamaan kuadrat dan akar simetris (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar $x^2 - 7x + k = 0$ adalah tiga kali akar yang lain. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{147}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{21}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{147}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan akar-akar persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Misalkan akar pertama adalah $\\alpha$, maka akar kedua adalah $3\\alpha$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus jumlah akar (Teorema Vieta).**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 7x + k = 0$ ($a = 1$, $b = -7$, $c = k$):" },
        { "tipe": "paragraph", "text": "$\\alpha + 3\\alpha = -\\dfrac{-7}{1} \\Rightarrow 4\\alpha = 7 \\Rightarrow \\alpha = \\dfrac{7}{4}$" },
        { "tipe": "paragraph", "text": "Sehingga akar-akarnya adalah $\\alpha = \\dfrac{7}{4}$ dan $3\\alpha = 3\\left(\\dfrac{7}{4}\\right) = \\dfrac{21}{4}$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $k$ menggunakan rumus hasil kali akar.**" },
        { "tipe": "paragraph", "text": "$k = \\alpha \\cdot (3\\alpha) = \\dfrac{7}{4} \\cdot \\dfrac{21}{4} = \\dfrac{147}{16}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $k$ adalah $\\dfrac{147}{16}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x + 3 = 0$, persamaan kuadrat baru yang akar-akarnya $\\dfrac{1}{\\alpha}$ dan $\\dfrac{1}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x^2 + 5x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 - 5x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 - 5x - 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 5x + 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 + 5x - 1 = 0$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar persamaan awal.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 5x + 3 = 0$ ($a = 1$, $b = -5$, $c = 3$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{-5}{1} = 5$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{3}{1} = 3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar-akar baru ($x_1 = \\dfrac{1}{\\alpha}$ dan $x_2 = \\dfrac{1}{\\beta}$).**" },
        { "tipe": "paragraph", "text": "Jumlah akar baru: $x_1 + x_2 = \\dfrac{1}{\\alpha} + \\dfrac{1}{\\beta} = \\dfrac{\\alpha + \\beta}{\\alpha\\beta} = \\dfrac{5}{3}$" },
        { "tipe": "paragraph", "text": "Hasil kali akar baru: $x_1 \\cdot x_2 = \\dfrac{1}{\\alpha} \\cdot \\dfrac{1}{\\beta} = \\dfrac{1}{\\alpha\\beta} = \\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru.**" },
        { "tipe": "paragraph", "text": "$x^2 - (x_1 + x_2)x + (x_1 \\cdot x_2) = 0$" },
        { "tipe": "paragraph", "text": "$x^2 - \\dfrac{5}{3}x + \\dfrac{1}{3} = 0$" },
        { "tipe": "paragraph", "text": "Kalikan kedua ruas dengan $3$ agar koefisiennya bulat: $3x^2 - 5x + 1 = 0$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Persamaan kuadrat barunya adalah $3x^2 - 5x + 1 = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - (a+3)x + 16 = 0$ memiliki akar kembar positif, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan syarat akar kembar ($D = 0$).**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - (a+3)x + 16 = 0$, diketahui $a_{\\text{koef}} = 1$, $b = -(a+3)$, dan $c = 16$." },
        { "tipe": "paragraph", "text": "$b^2 - 4ac = 0 \\Rightarrow (-(a+3))^2 - 4(1)(16) = 0$" },
        { "tipe": "paragraph", "text": "$(a+3)^2 - 64 = 0 \\Rightarrow (a+3)^2 = 64$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari kemungkinan nilai $a$.**" },
        { "tipe": "paragraph", "text": "$a + 3 = \\pm 8$" },
        { "tipe": "paragraph", "text": "Kemungkinan 1: $a + 3 = 8 \\Rightarrow a = 5$" },
        { "tipe": "paragraph", "text": "Kemungkinan 2: $a + 3 = -8 \\Rightarrow a = -11$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji syarat akar bernilai positif ($x > 0$).**" },
        { "tipe": "paragraph", "text": "Rumus akar kembar adalah $x = -\\dfrac{b}{2a} = \\dfrac{a+3}{2}$." },
        { "tipe": "paragraph", "text": "Untuk $a = 5$: $x = \\dfrac{5+3}{2} = 4 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Untuk $a = -11$: $x = \\dfrac{-11+3}{2} = -4 < 0$ (tidak memenuhi)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $a$ yang memenuhi adalah $5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $p$ agar grafik $y = x^2 - px + 9$ selalu di atas sumbu-$x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$p < -6$ atau $p > 6$" } ],
        [ { "tipe": "paragraph", "text": "$p = 6$" } ],
        [ { "tipe": "paragraph", "text": "$p \\geq 6$" } ],
        [ { "tipe": "paragraph", "text": "$-6 < p < 6$" } ],
        [ { "tipe": "paragraph", "text": "$p \\leq -6$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami syarat grafik selalu di atas sumbu-$x$ (definit positif).**" },
        { "tipe": "paragraph", "text": "Fungsi kuadrat selalu berada di atas sumbu-$x$ jika $a > 0$ dan $D < 0$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Cek nilai koefisien $a$.**" },
        { "tipe": "paragraph", "text": "Pada $y = x^2 - px + 9$, nilai $a = 1 > 0$ (syarat pertama terpenuhi)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan pertidaksamaan diskriminan ($D < 0$).**" },
        { "tipe": "paragraph", "text": "$b^2 - 4ac < 0 \\Rightarrow (-p)^2 - 4(1)(9) < 0$" },
        { "tipe": "paragraph", "text": "$p^2 - 36 < 0 \\Rightarrow (p - 6)(p + 6) < 0$" },
        { "tipe": "paragraph", "text": "Karena tanda $< 0$, penyelesaiannya berada di antara pembuat nol: $-6 < p < 6$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $p$ yang memenuhi adalah $-6 < p < 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 4x - 3 = 0$, nilai $\\alpha^2\\beta + \\alpha\\beta^2 + 2\\alpha\\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$-12$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 + 4x - 3 = 0$ ($a = 1$, $b = 4$, $c = -3$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{4}{1} = -4$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{-3}{1} = -3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan bentuk aljabar yang ditanyakan.**" },
        { "tipe": "paragraph", "text": "$\\alpha^2\\beta + \\alpha\\beta^2 + 2\\alpha\\beta = \\alpha\\beta(\\alpha + \\beta) + 2\\alpha\\beta$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diperoleh.**" },
        { "tipe": "paragraph", "text": "= $(-3)(-4) + 2(-3) = 12 - 6 = 6$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $\\alpha^2\\beta + \\alpha\\beta^2 + 2\\alpha\\beta$ adalah $6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x-1}{x+3} \\leq 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -7$ atau $x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -7$" } ],
        [ { "tipe": "paragraph", "text": "$-7 \\leq x < -3$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pindahkan konstanta $2$ ke ruas kiri dan samakan penyebutnya.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{x - 1}{x + 3} - 2 \\leq 0 \\Rightarrow \\dfrac{(x - 1) - 2(x + 3)}{x + 3} \\leq 0$" },
        { "tipe": "paragraph", "text": "$\\dfrac{x - 1 - 2x - 6}{x + 3} \\leq 0 \\Rightarrow \\dfrac{-x - 7}{x + 3} \\leq 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan pertidaksamaan dengan $-1$ dan balik arah tanda.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{x + 7}{x + 3} \\geq 0$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan titik pembuat nol dan syarat penyebut.**" },
        { "tipe": "paragraph", "text": "Pembuat nol pembilang: $x = -7$ (selang tertutup $\\geq$). Penyebut: $x = -3$ (selang terbuka karena penyebut tidak boleh nol)." },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji tanda atau gunakan sifat interval.**" },
        { "tipe": "paragraph", "text": "Penyelesaian untuk pertidaksamaan bertanda $\\geq 0$ adalah $x \\leq -7$ atau $x > -3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $x \\leq -7$ atau $x > -3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 7x + 3 = 0$ adalah $\\alpha$ dan $\\beta$, nilai $\\alpha^3\\beta + \\alpha\\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$135$" } ],
        [ { "tipe": "paragraph", "text": "$129$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 7x + 3 = 0$ ($a = 1$, $b = -7$, $c = 3$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{-7}{1} = 7$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{3}{1} = 3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jabarkan bentuk $\\alpha^3\\beta + \\alpha\\beta^3$ menggunakan identitas aljabar.**" },
        { "tipe": "paragraph", "text": "$\\alpha^3\\beta + \\alpha\\beta^3 = \\alpha\\beta(\\alpha^2 + \\beta^2)$" },
        { "tipe": "paragraph", "text": "Ingat bahwa $\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta$, sehingga:" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = (7)^2 - 2(3) = 49 - 6 = 43$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai akhir.**" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta(\\alpha^2 + \\beta^2) = 3 \\cdot 43 = 129$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $\\alpha^3\\beta + \\alpha\\beta^3$ adalah $129$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2(m+2)x + 9 = 0$ memiliki dua akar positif berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m > 2$" } ],
        [ { "tipe": "paragraph", "text": "$0 < m < 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 3$" } ],
        [ { "tipe": "paragraph", "text": "$m > 1$" } ],
        [ { "tipe": "paragraph", "text": "$m < -3$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 2(m+2)x + 9 = 0$, diketahui $a = 1$, $b = -2(m+2)$, dan $c = 9$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan 3 syarat memiliki dua akar positif berbeda.**" },
        { "tipe": "paragraph", "text": "**Syarat 1 — Dua akar real berbeda ($D > 0$):**" },
        { "tipe": "paragraph", "text": "$b^2 - 4ac > 0 \\Rightarrow (-2(m+2))^2 - 4(1)(9) > 0$" },
        { "tipe": "paragraph", "text": "$4(m+2)^2 - 36 > 0 \\Rightarrow (m+2)^2 > 9$" },
        { "tipe": "paragraph", "text": "$m + 2 < -3$ atau $m + 2 > 3 \\Rightarrow m < -5$ atau $m > 1$" },
        { "tipe": "paragraph", "text": "**Syarat 2 — Jumlah kedua akar positif ($x_1 + x_2 > 0$):**" },
        { "tipe": "paragraph", "text": "$-\\dfrac{b}{a} > 0 \\Rightarrow 2(m+2) > 0 \\Rightarrow m > -2$" },
        { "tipe": "paragraph", "text": "**Syarat 3 — Hasil kali kedua akar positif ($x_1 \\cdot x_2 > 0$):**" },
        { "tipe": "paragraph", "text": "$\\dfrac{c}{a} > 0 \\Rightarrow 9 > 0$ (selalu terpenuhi)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan irisan dari ketiga syarat.**" },
        { "tipe": "paragraph", "text": "Irisan dari $(m < -5 \\text{ atau } m > 1)$ dengan $(m > -2)$ adalah $m > 1$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $m$ yang memenuhi adalah $m > 1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x^2 - 12x + 7$, nilai $x$ agar $f(x)$ minimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien fungsi kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = 3x^2 - 12x + 7$, diperoleh $a = 3$, $b = -12$, dan $c = 7$. Karena $a > 0$, parabola terbuka ke atas sehingga memiliki nilai minimum." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung pembuat nilai minimum menggunakan rumus sumbu simetri ($x_p$).**" },
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} = -\\dfrac{-12}{2(3)} = \\dfrac{12}{6} = 2$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $x$ agar $f(x)$ mencapai minimum adalah $x = 2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $3x^2 - 9x + 5 = 0$, nilai $\\dfrac{3}{\\alpha} + \\dfrac{3}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{18}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $3x^2 - 9x + 5 = 0$ ($a = 3$, $b = -9$, $c = 5$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-9}{3} = 3$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{5}{3}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut pada bentuk yang ditanyakan.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{3}{\\alpha} + \\dfrac{3}{\\beta} = \\dfrac{3\\beta + 3\\alpha}{\\alpha\\beta} = \\dfrac{3(\\alpha + \\beta)}{\\alpha\\beta}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui.**" },
        { "tipe": "paragraph", "text": "= $\\dfrac{3(3)}{\\dfrac{5}{3}} = \\dfrac{9}{\\dfrac{5}{3}} = 9 \\cdot \\dfrac{3}{5} = \\dfrac{27}{5}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $\\dfrac{3}{\\alpha} + \\dfrac{3}{\\beta}$ adalah $\\dfrac{27}{5}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}