{
  "id": "bs-k10-fk-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang sistem persamaan kuadrat dan akar simetris (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar $x^2 - 7x + k = 0$ adalah tiga kali akar yang lain. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{147}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{21}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{147}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal akar-akar: $\\alpha$ dan $3\\alpha$." },
        { "tipe": "paragraph", "text": "$\\alpha + 3\\alpha = 7 \\Rightarrow 4\\alpha = 7 \\Rightarrow \\alpha = \\dfrac{7}{4}$." },
        { "tipe": "paragraph", "text": "Akar-akarnya adalah $\\dfrac{7}{4}$ dan $\\dfrac{21}{4}$." },
        { "tipe": "paragraph", "text": "Nilai $k = \\alpha \\cdot 3\\alpha = \\dfrac{7}{4} \\cdot \\dfrac{21}{4} = \\dfrac{147}{16}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x + 3 = 0$, persamaan kuadrat baru yang akar-akarnya $\\dfrac{1}{\\alpha}$ dan $\\dfrac{1}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x^2 - 5x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 + 5x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 - 5x - 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 5x + 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 + 5x - 1 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 5$; $\\alpha\\beta = 3$" },
        { "tipe": "paragraph", "text": "Jumlah akar baru: $\\dfrac{1}{\\alpha} + \\dfrac{1}{\\beta} = \\dfrac{5}{3}$" },
        { "tipe": "paragraph", "text": "Hasil kali akar baru: $\\dfrac{1}{\\alpha\\beta} = \\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 - \\dfrac{5}{3}x + \\dfrac{1}{3} = 0 \\Rightarrow 3x^2 - 5x + 1 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - (a+3)x + 16 = 0$ memiliki akar kembar positif, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 0 \\Rightarrow (a+3)^2 - 64 = 0$" },
        { "tipe": "paragraph", "text": "$(a+3)^2 = 64 \\Rightarrow a + 3 = \\pm 8$" },
        { "tipe": "paragraph", "text": "$a = 5$ atau $a = -11$." },
        { "tipe": "paragraph", "text": "Akar kembar $x = \\dfrac{a+3}{2}$. Untuk $a = 5$: $x = 4 > 0$ ✓." },
        { "tipe": "paragraph", "text": "Untuk $a = -11$: $x = -4 < 0$ ✗." },
        { "tipe": "paragraph", "text": "Jadi $a = 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $p$ agar grafik $y = x^2 - px + 9$ selalu di atas sumbu-$x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6 < p < 6$" } ],
        [ { "tipe": "paragraph", "text": "$p < -6$ atau $p > 6$" } ],
        [ { "tipe": "paragraph", "text": "$p = 6$" } ],
        [ { "tipe": "paragraph", "text": "$p \\geq 6$" } ],
        [ { "tipe": "paragraph", "text": "$p \\leq -6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Grafik selalu di atas sumbu-$x$: $D < 0$ dan $a > 0$." },
        { "tipe": "paragraph", "text": "$D < 0 \\Rightarrow p^2 - 36 < 0 \\Rightarrow -6 < p < 6$" },
        { "tipe": "paragraph", "text": "Karena $a = 1 > 0$, syarat terpenuhi." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 4x - 3 = 0$, nilai $\\alpha^2\\beta + \\alpha\\beta^2 + 2\\alpha\\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$-12$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -4$; $\\alpha\\beta = -3$" },
        { "tipe": "paragraph", "text": "$\\alpha^2\\beta + \\alpha\\beta^2 + 2\\alpha\\beta = \\alpha\\beta(\\alpha + \\beta) + 2\\alpha\\beta$" },
        { "tipe": "paragraph", "text": "$= (-3)(-4) + 2(-3) = 12 - 6 = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x-1}{x+3} \\leq 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -7$ atau $x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -7$" } ],
        [ { "tipe": "paragraph", "text": "$-7 \\leq x < -3$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{x-1}{x+3} - 2 \\leq 0 \\Rightarrow \\dfrac{x-1-2x-6}{x+3} \\leq 0$" },
        { "tipe": "paragraph", "text": "$\\dfrac{-x-7}{x+3} \\leq 0 \\Rightarrow \\dfrac{x+7}{x+3} \\geq 0$" },
        { "tipe": "paragraph", "text": "Titik kritis: $x = -7$, $x = -3$ (dikecualikan)." },
        { "tipe": "paragraph", "text": "HP = $x \\leq -7$ atau $x > -3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 7x + 3 = 0$ adalah $\\alpha$ dan $\\beta$, nilai $\\alpha^3\\beta + \\alpha\\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$129$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$135$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 7$; $\\alpha\\beta = 3$" },
        { "tipe": "paragraph", "text": "$\\alpha^3\\beta + \\alpha\\beta^3 = \\alpha\\beta(\\alpha^2 + \\beta^2)$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = 49 - 6 = 43$" },
        { "tipe": "paragraph", "text": "$= 3 \\cdot 43 = 129$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2(m+2)x + 9 = 0$ memiliki dua akar positif berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m > 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 2$" } ],
        [ { "tipe": "paragraph", "text": "$0 < m < 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 3$" } ],
        [ { "tipe": "paragraph", "text": "$m < -3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat dua akar positif berbeda:" },
        { "tipe": "paragraph", "text": "1) $D > 0$: $4(m+2)^2 - 36 > 0 \\Rightarrow (m+2)^2 > 9 \\Rightarrow m < -5$ atau $m > 1$." },
        { "tipe": "paragraph", "text": "2) $x_1 + x_2 > 0$: $2(m+2) > 0 \\Rightarrow m > -2$." },
        { "tipe": "paragraph", "text": "3) $x_1 x_2 > 0$: $9 > 0$ ✓ (otomatis)." },
        { "tipe": "paragraph", "text": "Irisan dari (1) dan (2): $m > 1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x^2 - 12x + 7$, nilai $x$ agar $f(x)$ minimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-12}{6} = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $3x^2 - 9x + 5 = 0$, nilai $\\dfrac{3}{\\alpha} + \\dfrac{3}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{18}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 3$; $\\alpha\\beta = \\dfrac{5}{3}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{3}{\\alpha} + \\dfrac{3}{\\beta} = \\dfrac{3(\\alpha + \\beta)}{\\alpha\\beta} = \\dfrac{9}{5/3} = \\dfrac{27}{5}$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
