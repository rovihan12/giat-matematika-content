{
  "id": "bs-k10-fk-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang fungsi kuadrat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $x^2 - 5x + 3 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 5$; $x_1 x_2 = 3$" },
        { "tipe": "paragraph", "text": "$x_1^2 x_2 + x_1 x_2^2 = x_1 x_2(x_1 + x_2) = 3 \\cdot 5 = 15$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 3x + 1 = 0$, nilai $\\alpha^4 + \\beta^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$47$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 3$; $\\alpha\\beta = 1$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = 9 - 2 = 7$" },
        { "tipe": "paragraph", "text": "$\\alpha^4 + \\beta^4 = (\\alpha^2 + \\beta^2)^2 - 2(\\alpha\\beta)^2 = 49 - 2 = 47$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 2x - 3 > 0$ dan $x^2 - 4x + 3 < 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$3 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 2x - 3 > 0 \\Rightarrow (x-3)(x+1) > 0 \\Rightarrow x < -1$ atau $x > 3$." },
        { "tipe": "paragraph", "text": "$x^2 - 4x + 3 < 0 \\Rightarrow (x-1)(x-3) < 0 \\Rightarrow 1 < x < 3$." },
        { "tipe": "paragraph", "text": "Irisan: kosong (karena $x > 3$ dan $x < 3$ tidak bertemu)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y = 8$ dan $xy = 12$, nilai $x^2 + y^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + y^2 = (x+y)^2 - 2xy = 64 - 24 = 40$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $a$ agar persamaan $x^2 + ax + (a^2 - 4) = 0$ memiliki akar-akar yang saling berlawanan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 0$" } ],
        [ { "tipe": "paragraph", "text": "$a = 1$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar berlawanan: $x_1 = -x_2 \\Rightarrow x_1 + x_2 = 0$." },
        { "tipe": "paragraph", "text": "Dari Vieta: $x_1 + x_2 = -a$." },
        { "tipe": "paragraph", "text": "$-a = 0 \\Rightarrow a = 0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 2x + 3$ untuk $x \\in \\mathbb{R}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 1$; $f(1) = 1 - 2 + 3 = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3|x| - 4 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-4, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-4, -1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 4\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $t = |x| \\geq 0$: $t^2 - 3t - 4 = 0$" },
        { "tipe": "paragraph", "text": "$(t - 4)(t + 1) = 0 \\Rightarrow t = 4$ atau $t = -1$." },
        { "tipe": "paragraph", "text": "$t = 4$ (valid), maka $|x| = 4 \\Rightarrow x = \\pm 4$." },
        { "tipe": "paragraph", "text": "$t = -1$ (tidak valid)." },
        { "tipe": "paragraph", "text": "HP = $\\{-4, 4\\}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x + 6 = 0$, persamaan kuadrat baru dengan akar $\\alpha^2$ dan $\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 13x + 36 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 13x - 36 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 13x + 36 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 13x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 12x + 36 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 5$; $\\alpha\\beta = 6$" },
        { "tipe": "paragraph", "text": "Jumlah baru: $\\alpha^2 + \\beta^2 = 25 - 12 = 13$" },
        { "tipe": "paragraph", "text": "Hasil kali baru: $(\\alpha\\beta)^2 = 36$" },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 - 13x + 36 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = ax^2 + bx + c$ melalui titik $(1, 0)$, $(2, 0)$, dan $(0, 4)$, nilai $a + b + c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar $x = 1$ dan $x = 2$: $f(x) = a(x-1)(x-2)$." },
        { "tipe": "paragraph", "text": "Substitusi $(0, 4)$: $a(0-1)(0-2) = 4 \\Rightarrow 2a = 4 \\Rightarrow a = 2$." },
        { "tipe": "paragraph", "text": "$f(x) = 2x^2 - 6x + 4$." },
        { "tipe": "paragraph", "text": "$a + b + c = 2 - 6 + 4 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x - 3 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$85$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 4$; $\\alpha\\beta = -3$" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (\\alpha+\\beta)^3 - 3\\alpha\\beta(\\alpha+\\beta)$" },
        { "tipe": "paragraph", "text": "$= 64 - 3(-3)(4) = 64 + 36 = 100$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
