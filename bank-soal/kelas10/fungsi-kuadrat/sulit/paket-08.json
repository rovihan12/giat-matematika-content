{
  "id": "bs-k10-fk-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan aplikasi fungsi kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3x - 10 < 0$ dengan $x$ bilangan bulat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2, 3, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-2, -1, 0, 1, 2, 3, 4, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0, 1, 2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 0, 1, 2\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1, 2, 3, 4\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 5)(x + 2) < 0 \\Rightarrow -2 < x < 5$." },
        { "tipe": "paragraph", "text": "$x$ bulat: $-1, 0, 1, 2, 3, 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x^2 - 4}{x - 3} \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $2 \\leq x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{(x-2)(x+2)}{x-3} \\geq 0$" },
        { "tipe": "paragraph", "text": "Titik kritis: $x = -2$, $x = 2$, $x = 3$ (dikecualikan)." },
        { "tipe": "paragraph", "text": "Uji $x = -3$: $\\dfrac{(-)(-)}{-} = - < 0$ ✗" },
        { "tipe": "paragraph", "text": "Uji $x = 0$: $\\dfrac{(-)(+)}{-} = + \\geq 0$ ✓" },
        { "tipe": "paragraph", "text": "Uji $x = 2{,}5$: $\\dfrac{(+)(+)}{-} = - < 0$ ✗" },
        { "tipe": "paragraph", "text": "Uji $x = 4$: $\\dfrac{(+)(+)}{+} = + \\geq 0$ ✓" },
        { "tipe": "paragraph", "text": "HP = $-2 \\leq x \\leq 2$ atau $x > 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 8x + 5 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{54}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{44}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{64}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{34}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 8$; $\\alpha\\beta = 5$" },
        { "tipe": "paragraph", "text": "$\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{64 - 10}{5} = \\dfrac{54}{5}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum dari $f(x) = x^2 - 6x + 11$ untuk $0 \\leq x \\leq 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 3$ (dalam interval)." },
        { "tipe": "paragraph", "text": "$f(3) = 9 - 18 + 11 = 2$ (minimum)." },
        { "tipe": "paragraph", "text": "Bandingkan titik ujung: $f(0) = 11$, $f(6) = 36 - 36 + 11 = 11$." },
        { "tipe": "paragraph", "text": "Minimum = 2." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 + (p-3)x + 9 = 0$ memiliki akar-akar positif, nilai $p$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$p \\leq -3$" } ],
        [ { "tipe": "paragraph", "text": "$p \\geq 9$" } ],
        [ { "tipe": "paragraph", "text": "$p < -3$" } ],
        [ { "tipe": "paragraph", "text": "$p > 9$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < p < 9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar positif: $x_1 + x_2 > 0$ dan $x_1 x_2 > 0$ dan $D \\geq 0$." },
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 3 - p > 0 \\Rightarrow p < 3$." },
        { "tipe": "paragraph", "text": "$x_1 x_2 = 9 > 0$ ✓" },
        { "tipe": "paragraph", "text": "$D \\geq 0 \\Rightarrow (p-3)^2 - 36 \\geq 0 \\Rightarrow p \\leq -3$ atau $p \\geq 9$." },
        { "tipe": "paragraph", "text": "Irisan dengan $p < 3$: $p \\leq -3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 5x| = 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-1, 2, 3, 6\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 6\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 2, 6\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{2, 3, 6\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kasus 1: $x^2 - 5x = 6 \\Rightarrow x^2 - 5x - 6 = 0$" },
        { "tipe": "paragraph", "text": "$(x-6)(x+1) = 0 \\Rightarrow x = 6$ atau $x = -1$." },
        { "tipe": "paragraph", "text": "Kasus 2: $x^2 - 5x = -6 \\Rightarrow x^2 - 5x + 6 = 0$" },
        { "tipe": "paragraph", "text": "$(x-2)(x-3) = 0 \\Rightarrow x = 2$ atau $x = 3$." },
        { "tipe": "paragraph", "text": "HP = $\\{-1, 2, 3, 6\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2mx + (m+6) = 0$ memiliki akar-akar $\\alpha$ dan $\\beta$ dengan $\\alpha\\beta = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha\\beta = m + 6 = 4 \\Rightarrow m = -2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = -x^2 + 8x - 12$ bernilai positif pada interval..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 < x < 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 6$" } ],
        [ { "tipe": "paragraph", "text": "$-6 < x < -2$" } ],
        [ { "tipe": "paragraph", "text": "$x < -6$ atau $x > -2$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(x) > 0 \\Rightarrow -x^2 + 8x - 12 > 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 8x + 12 < 0$" },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 6) < 0 \\Rightarrow 2 < x < 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 9x + 14 = 0$, persamaan kuadrat baru dengan akar $\\alpha + 3$ dan $\\beta + 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 15x + 50 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 15x - 50 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 15x + 50 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 15x + 40 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 9x + 50 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 9$; $\\alpha\\beta = 14$" },
        { "tipe": "paragraph", "text": "Jumlah baru: $(\\alpha+3) + (\\beta+3) = 15$" },
        { "tipe": "paragraph", "text": "Hasil kali: $(\\alpha+3)(\\beta+3) = 14 + 27 + 9 = 50$" },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 - 15x + 50 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 6x + 8 > 0$ dan $x^2 - 9x + 18 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4 < x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 6x + 8 > 0 \\Rightarrow (x-2)(x-4) > 0 \\Rightarrow x < 2$ atau $x > 4$." },
        { "tipe": "paragraph", "text": "$x^2 - 9x + 18 \\leq 0 \\Rightarrow (x-3)(x-6) \\leq 0 \\Rightarrow 3 \\leq x \\leq 6$." },
        { "tipe": "paragraph", "text": "Irisan: $4 < x \\leq 6$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
