{
  "id": "bs-k10-fk-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan tanda fungsi (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\dfrac{x^2 - 7x + 10}{x - 2} \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $2 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$2 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x \\geq 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan: $\\dfrac{(x-2)(x-5)}{x-2} \\leq 0$" },
        { "tipe": "paragraph", "text": "Karena $x \\neq 2$, sederhanakan menjadi $x - 5 \\leq 0 \\Rightarrow x \\leq 5$ dengan $x \\neq 2$." },
        { "tipe": "paragraph", "text": "HP = $x < 2$ atau $2 < x \\leq 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar persamaan $x^2 - 4mx + (4m+5) = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m < -\\dfrac{1}{2}$ atau $m > \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2} < m < \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq -\\dfrac{1}{2}$ atau $m \\geq \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$m > \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$m < -\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D > 0 \\Rightarrow (-4m)^2 - 4(4m+5) > 0$" },
        { "tipe": "paragraph", "text": "$16m^2 - 16m - 20 > 0 \\Rightarrow 4m^2 - 4m - 5 > 0$" },
        { "tipe": "paragraph", "text": "$(2m + 1)(2m - 5) > 0 \\Rightarrow m < -\\dfrac{1}{2}$ atau $m > \\dfrac{5}{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 10x + k = 0$ adalah $\\alpha$ dan $\\beta$ dengan $\\alpha = 4\\beta$, nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 10$; $\\alpha\\beta = k$." },
        { "tipe": "paragraph", "text": "$\\alpha = 4\\beta \\Rightarrow 4\\beta + \\beta = 10 \\Rightarrow \\beta = 2$, $\\alpha = 8$." },
        { "tipe": "paragraph", "text": "$k = \\alpha\\beta = 16$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 6x| < 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 < x < 3 - \\sqrt{2}$ atau $3 + \\sqrt{2} < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$-7 < x^2 - 6x < 7$" },
        { "tipe": "paragraph", "text": "Kasus 1: $x^2 - 6x - 7 < 0 \\Rightarrow (x+1)(x-7) < 0 \\Rightarrow -1 < x < 7$" },
        { "tipe": "paragraph", "text": "Kasus 2: $x^2 - 6x + 7 > 0 \\Rightarrow x < 3 - \\sqrt{2}$ atau $x > 3 + \\sqrt{2}$" },
        { "tipe": "paragraph", "text": "Irisan: $-1 < x < 3 - \\sqrt{2}$ atau $3 + \\sqrt{2} < x < 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + px + q$ memiliki nilai minimum $-9$ di $x = 3$, nilai $p + q$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik puncak $(3, -9)$: $-\\dfrac{p}{2} = 3 \\Rightarrow p = -6$." },
        { "tipe": "paragraph", "text": "Substitusi $(3, -9)$: $9 - 18 + q = -9 \\Rightarrow q = 0$." },
        { "tipe": "paragraph", "text": "$p + q = -6 + 0 = -6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 5x + 4 \\leq 0$ dan $x^2 - 6x + 5 \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$4 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 5x + 4 \\leq 0 \\Rightarrow (x-1)(x-4) \\leq 0 \\Rightarrow 1 \\leq x \\leq 4$" },
        { "tipe": "paragraph", "text": "$x^2 - 6x + 5 \\geq 0 \\Rightarrow (x-1)(x-5) \\geq 0 \\Rightarrow x \\leq 1$ atau $x \\geq 5$" },
        { "tipe": "paragraph", "text": "Irisan: $x = 1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 2 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$160$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$220$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 6$; $\\alpha\\beta = 2$" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)$" },
        { "tipe": "paragraph", "text": "$= 216 - 3(2)(6) = 216 - 36 = 180$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 8x + 12$ memiliki nilai minimum $m$ di $x = p$. Nilai $p + m$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$p = -\\dfrac{-8}{2} = 4$" },
        { "tipe": "paragraph", "text": "$m = 16 - 32 + 12 = -4$" },
        { "tipe": "paragraph", "text": "$p + m = 4 - 4 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 9 \\leq 8x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 9$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 9$" } ],
        [ { "tipe": "paragraph", "text": "$-9 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -9$ atau $x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 8x - 9 \\leq 0$" },
        { "tipe": "paragraph", "text": "$(x - 9)(x + 1) \\leq 0$" },
        { "tipe": "paragraph", "text": "HP = $-1 \\leq x \\leq 9$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar $3x^2 - 6x + 2 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 2$; $x_1 x_2 = \\dfrac{2}{3}$" },
        { "tipe": "paragraph", "text": "$x_1^2 x_2 + x_1 x_2^2 = x_1 x_2 (x_1 + x_2) = \\dfrac{2}{3} \\cdot 2 = \\dfrac{4}{3}$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
