{
  "id": "bs-k10-fk-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan tanda fungsi (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\dfrac{x^2 - 7x + 10}{x - 2} \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $2 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$2 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x \\geq 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pembilang dan tentukan syarat penyebut.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{(x - 2)(x - 5)}{x - 2} \\leq 0$" },
        { "tipe": "paragraph", "text": "Syarat penyebut tidak boleh bernilai nol: $x - 2 \\neq 0 \\Rightarrow x \\neq 2$ (selang terbuka)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan pertidaksamaan.**" },
        { "tipe": "paragraph", "text": "Karena $x \\neq 2$, faktor $(x - 2)$ pada pembilang dan penyebut dapat dicoret:" },
        { "tipe": "paragraph", "text": "$x - 5 \\leq 0 \\Rightarrow x \\leq 5$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Gabungkan hasil dengan syarat penyebut.**" },
        { "tipe": "paragraph", "text": "Interval $x \\leq 5$ harus membuang titik $x = 2$, sehingga terbagi menjadi dua bagian: $x < 2$ atau $2 < x \\leq 5$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $x < 2$ atau $2 < x \\leq 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar persamaan $x^2 - 4mx + (4m+5) = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2} < m < \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$m < -\\dfrac{1}{2}$ atau $m > \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq -\\dfrac{1}{2}$ atau $m \\geq \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$m > \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$m < -\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 4mx + (4m + 5) = 0$, diperoleh $a = 1$, $b = -4m$, dan $c = 4m + 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan syarat dua akar real berbeda ($D > 0$).**" },
        { "tipe": "paragraph", "text": "$b^2 - 4ac > 0$" },
        { "tipe": "paragraph", "text": "$(-4m)^2 - 4(1)(4m + 5) > 0$" },
        { "tipe": "paragraph", "text": "$16m^2 - 16m - 20 > 0$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan dan faktorkan pertidaksamaan.**" },
        { "tipe": "paragraph", "text": "Bagi kedua ruas dengan $4$: $4m^2 - 4m - 5 > 0$" },
        { "tipe": "paragraph", "text": "$(2m + 1)(2m - 5) > 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $m = -\\dfrac{1}{2}$ dan $m = \\dfrac{5}{2}$. Karena tanda pertidaksamaan $> 0$, maka daerah penyelesaian berada di luar kedua batas tersebut." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $m$ yang memenuhi adalah $m < -\\dfrac{1}{2}$ atau $m > \\dfrac{5}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 10x + k = 0$ adalah $\\alpha$ dan $\\beta$ dengan $\\alpha = 4\\beta$, nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jumlah dan hasil kali akar (Teorema Vieta).**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 10x + k = 0$ ($a = 1$, $b = -10$, $c = k$):" },
        { "tipe": "paragraph", "text": "Jumlah akar: $\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-10}{1} = 10$" },
        { "tipe": "paragraph", "text": "Hasil kali akar: $\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{k}{1} = k$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $\\alpha = 4\\beta$ ke persamaan jumlah akar.**" },
        { "tipe": "paragraph", "text": "$4\\beta + \\beta = 10 \\Rightarrow 5\\beta = 10 \\Rightarrow \\beta = 2$" },
        { "tipe": "paragraph", "text": "Maka, $\\alpha = 4(2) = 8$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $k$.**" },
        { "tipe": "paragraph", "text": "$k = \\alpha\\beta = 8 \\cdot 2 = 16$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $k$ adalah $16$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 6x| < 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 3 - \\sqrt{2}$ atau $3 + \\sqrt{2} < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah pertidaksamaan nilai mutlak menjadi pertidaksamaan ganda.**" },
        { "tipe": "paragraph", "text": "Sifat $|f(x)| < a \\iff -a < f(x) < a$, sehingga:" },
        { "tipe": "paragraph", "text": "$-7 < x^2 - 6x < 7$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan bagian kanan ($x^2 - 6x < 7$).**" },
        { "tipe": "paragraph", "text": "$x^2 - 6x - 7 < 0 \\Rightarrow (x + 1)(x - 7) < 0$" },
        { "tipe": "paragraph", "text": "Karena tanda $< 0$, penyelesaiannya adalah: $-1 < x < 7$ ... (Syarat 1)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan bagian kiri ($x^2 - 6x > -7$).**" },
        { "tipe": "paragraph", "text": "$x^2 - 6x + 7 > 0$" },
        { "tipe": "paragraph", "text": "Gunakan rumus ABC untuk mencari pembuat nol:" },
        { "tipe": "paragraph", "text": "$x_{1,2} = \\dfrac{6 \\pm \\sqrt{(-6)^2 - 4(1)(7)}}{2(1)} = \\dfrac{6 \\pm \\sqrt{8}}{2} = \\dfrac{6 \\pm 2\\sqrt{2}}{2} = 3 \\pm \\sqrt{2}$" },
        { "tipe": "paragraph", "text": "Karena tanda $> 0$, penyelesaiannya adalah: $x < 3 - \\sqrt{2}$ atau $x > 3 + \\sqrt{2}$ ... (Syarat 2)" },
        { "tipe": "paragraph", "text": "**Langkah 4: Cari irisan dari Syarat 1 dan Syarat 2.**" },
        { "tipe": "paragraph", "text": "Perhatikan bahwa $\\sqrt{2} \\approx 1{,}41$, sehingga $3 - \\sqrt{2} \\approx 1{,}59$ dan $3 + \\sqrt{2} \\approx 4{,}41$." },
        { "tipe": "paragraph", "text": "Irisan dari $(-1 < x < 7)$ dengan $(x < 1{,}59 \\text{ atau } x > 4{,}41)$ menghasilkan:" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $-1 < x < 3 - \\sqrt{2}$ atau $3 + \\sqrt{2} < x < 7$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + px + q$ memiliki nilai minimum $-9$ di $x = 3$, nilai $p + q$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus sumbu simetri ($x_p$) untuk mencari nilai $p$.**" },
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 + px + q$ memiliki $a = 1$, $b = p$, dan titik puncak $(3, -9)$." },
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} \\Rightarrow 3 = -\\dfrac{p}{2(1)} \\Rightarrow p = -6$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $p = -6$ dan titik $(3, -9)$ ke fungsi untuk mencari $q$.**" },
        { "tipe": "paragraph", "text": "$f(3) = -9$" },
        { "tipe": "paragraph", "text": "$(3)^2 + (-6)(3) + q = -9$" },
        { "tipe": "paragraph", "text": "$9 - 18 + q = -9 \\Rightarrow -9 + q = -9 \\Rightarrow q = 0$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $p + q$.**" },
        { "tipe": "paragraph", "text": "$p + q = -6 + 0 = -6$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $p + q$ adalah $-6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 5x + 4 \\leq 0$ dan $x^2 - 6x + 5 \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$\\{1\\}$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$4 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Selesaikan pertidaksamaan pertama.**" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 4 \\leq 0 \\Rightarrow (x - 1)(x - 4) \\leq 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = 1$ dan $x = 4$. Karena tanda $\\leq 0$, daerahnya berada di antara kedua akar: $1 \\leq x \\leq 4$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan kedua.**" },
        { "tipe": "paragraph", "text": "$x^2 - 6x + 5 \\geq 0 \\Rightarrow (x - 1)(x - 5) \\geq 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = 1$ dan $x = 5$. Karena tanda $\\geq 0$, daerahnya berada di luar kedua akar: $x \\leq 1$ atau $x \\geq 5$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Cari irisan dari kedua penyelesaian.**" },
        { "tipe": "paragraph", "text": "Kata hubung **dan** mengharuskan kita mencari irisan antara $(1 \\leq x \\leq 4)$ dengan $(x \\leq 1 \\text{ atau } x \\geq 5)$. Satu-satunya nilai yang memenuhi keduanya adalah titik batas $x = 1$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $\\{1\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 2 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$160$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$220$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 6x + 2 = 0$ ($a = 1$, $b = -6$, $c = 2$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-6}{1} = 6$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{2}{1} = 2$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk $\\alpha^3 + \\beta^3$ menggunakan identitas aljabar.**" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui.**" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (6)^3 - 3(2)(6)$" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = 216 - 36 = 180$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $\\alpha^3 + \\beta^3$ adalah $180$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 8x + 12$ memiliki nilai minimum $m$ di $x = p$. Nilai $p + m$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari pembuat nilai minimum ($p$) menggunakan rumus sumbu simetri.**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = x^2 - 8x + 12$, diketahui $a = 1$, $b = -8$, dan $c = 12$." },
        { "tipe": "paragraph", "text": "$p = x_p = -\\dfrac{b}{2a} = -\\dfrac{-8}{2(1)} = 4$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 4$ ke fungsi untuk mendapatkan nilai minimum ($m$).**" },
        { "tipe": "paragraph", "text": "$m = f(4) = (4)^2 - 8(4) + 12$" },
        { "tipe": "paragraph", "text": "$m = 16 - 32 + 12 = -4$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $p + m$.**" },
        { "tipe": "paragraph", "text": "$p + m = 4 + (-4) = 0$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $p + m$ adalah $0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 9 \\leq 8x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 9$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 9$" } ],
        [ { "tipe": "paragraph", "text": "$-9 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -9$ atau $x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pindahkan semua suku ke ruas kiri agar ruas kanan bernilai nol.**" },
        { "tipe": "paragraph", "text": "$x^2 - 8x - 9 \\leq 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat untuk mencari pembuat nol.**" },
        { "tipe": "paragraph", "text": "$(x - 9)(x + 1) \\leq 0$" },
        { "tipe": "paragraph", "text": "Diperoleh pembuat nol $x = -1$ dan $x = 9$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan interval penyelesaian.**" },
        { "tipe": "paragraph", "text": "Karena koefisien $x^2$ positif dan tanda pertidaksamaan $\\leq 0$, maka daerah penyelesaian berada di antara kedua akar." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $-1 \\leq x \\leq 9$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar $3x^2 - 6x + 2 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $3x^2 - 6x + 2 = 0$ ($a = 3$, $b = -6$, $c = 2$):" },
        { "tipe": "paragraph", "text": "$x_1 + x_2 = -\\dfrac{b}{a} = -\\dfrac{-6}{3} = 2$" },
        { "tipe": "paragraph", "text": "$x_1 x_2 = \\dfrac{c}{a} = \\dfrac{2}{3}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk aljabar yang ditanyakan.**" },
        { "tipe": "paragraph", "text": "$x_1^2 x_2 + x_1 x_2^2 = x_1 x_2 (x_1 + x_2)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diperoleh.**" },
        { "tipe": "paragraph", "text": "$x_1 x_2 (x_1 + x_2) = \\dfrac{2}{3} \\cdot 2 = \\dfrac{4}{3}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $x_1^2 x_2 + x_1 x_2^2$ adalah $\\dfrac{4}{3}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}