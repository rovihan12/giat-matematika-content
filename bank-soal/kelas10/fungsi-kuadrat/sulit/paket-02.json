{
  "id": "bs-k10-fk-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang sistem persamaan kuadrat dan akar simetris",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar $x^2 - 6x + k = 0$ adalah dua kali akar yang lain. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan kedua akar persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Misalkan akar pertama adalah $\\alpha$, maka akar kedua adalah $2\\alpha$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus jumlah akar (Teorema Vieta)**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 6x + k = 0$ ($a = 1$, $b = -6$, $c = k$), diperoleh:" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{b}{a} \\Rightarrow \\alpha + 2\\alpha = -\\dfrac{-6}{1}" },
        { "tipe": "formula_block", "latex": "3\\alpha = 6 \\Rightarrow \\alpha = 2" },
        { "tipe": "paragraph", "text": "Dengan demikian, akar-akarnya adalah $\\alpha = 2$ dan $2\\alpha = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $k$ menggunakan rumus hasil kali akar**" },
        { "tipe": "formula_block", "latex": "x_1 \\cdot x_2 = \\dfrac{c}{a} \\Rightarrow 2 \\cdot 4 = \\dfrac{k}{1} \\Rightarrow k = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ adalah **$8$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 3x - 4 = 0$, persamaan kuadrat baru yang akar-akarnya $\\dfrac{1}{\\alpha}$ dan $\\dfrac{1}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4x^2 - 3x - 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 + 3x - 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 - 3x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 3x - 4 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$4x^2 + 3x + 1 = 0$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar persamaan awal**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 3x - 4 = 0$ ($a = 1$, $b = -3$, $c = -4$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-3}{1} = 3" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{-4}{1} = -4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar-akar baru ($x_1 = \\dfrac{1}{\\alpha}$ dan $x_2 = \\dfrac{1}{\\beta}$)**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = \\dfrac{1}{\\alpha} + \\dfrac{1}{\\beta} = \\dfrac{\\alpha + \\beta}{\\alpha\\beta} = \\dfrac{3}{-4} = -\\dfrac{3}{4}" },
        { "tipe": "formula_block", "latex": "x_1 \\cdot x_2 = \\dfrac{1}{\\alpha} \\cdot \\dfrac{1}{\\beta} = \\dfrac{1}{\\alpha\\beta} = -\\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru dan bulatkan koefisiennya**" },
        { "tipe": "formula_block", "latex": "x^2 - (x_1 + x_2)x + (x_1 \\cdot x_2) = 0" },
        { "tipe": "formula_block", "latex": "x^2 - \\left(-\\dfrac{3}{4}\\right)x + \\left(-\\dfrac{1}{4}\\right) = 0 \\Rightarrow x^2 + \\dfrac{3}{4}x - \\dfrac{1}{4} = 0" },
        { "tipe": "paragraph", "text": "Kalikan kedua ruas dengan $4$ agar seluruh koefisien menjadi bilangan bulat:" },
        { "tipe": "formula_block", "latex": "4x^2 + 3x - 1 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat barunya adalah **$4x^2 + 3x - 1 = 0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - (a+2)x + 9 = 0$ memiliki akar kembar positif, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan syarat akar kembar ($D = 0$)**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - (a+2)x + 9 = 0$, diketahui koefisien $A = 1$, $B = -(a+2)$, dan $C = 9$:" },
        { "tipe": "formula_block", "latex": "B^2 - 4AC = 0" },
        { "tipe": "formula_block", "latex": "(-(a+2))^2 - 4(1)(9) = 0" },
        { "tipe": "formula_block", "latex": "(a+2)^2 - 36 = 0 \\Rightarrow (a+2)^2 = 36" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan dua kemungkinan nilai $a$**" },
        { "tipe": "formula_block", "latex": "a + 2 = \\pm 6" },
        { "tipe": "formula_block", "latex": "a + 2 = 6 \\Rightarrow a = 4 \\quad \\text{atau} \\quad a + 2 = -6 \\Rightarrow a = -8" },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji syarat akar kembar bernilai positif ($x > 0$)**" },
        { "tipe": "paragraph", "text": "Gunakan rumus akar kembar $x = -\\dfrac{B}{2A} = \\dfrac{a+2}{2}$ untuk kedua nilai $a$:" },
        { "tipe": "formula_block", "latex": "a = 4 \\Rightarrow x = \\dfrac{4+2}{2} = 3 > 0 \\quad [\\text{Memenuhi}]" },
        { "tipe": "formula_block", "latex": "a = -8 \\Rightarrow x = \\dfrac{-8+2}{2} = -3 < 0 \\quad [\\text{Tidak memenuhi}]" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ yang memenuhi adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $p$ agar grafik $y = x^2 + px + 4$ selalu di atas sumbu-$x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$p < -4$ atau $p > 4$" } ],
        [ { "tipe": "paragraph", "text": "$p = 4$" } ],
        [ { "tipe": "paragraph", "text": "$p \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$-4 < p < 4$" } ],
        [ { "tipe": "paragraph", "text": "$p \\leq -4$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami syarat grafik selalu di atas sumbu-$x$ (definit positif)**" },
        { "tipe": "paragraph", "text": "Fungsi kuadrat $y = ax^2 + bx + c$ selalu berada di atas sumbu-$x$ jika memenuhi syarat $a > 0$ (parabola terbuka ke atas) dan $D < 0$ (tidak memotong sumbu-$x$)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Periksa nilai koefisien $a$**" },
        { "tipe": "paragraph", "text": "Pada $y = x^2 + px + 4$, nilai $a = 1 > 0$, sehingga syarat pertama sudah terpenuhi." },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan pertidaksamaan diskriminan ($D < 0$)**" },
        { "tipe": "formula_block", "latex": "b^2 - 4ac < 0" },
        { "tipe": "formula_block", "latex": "p^2 - 4(1)(4) < 0 \\Rightarrow p^2 - 16 < 0" },
        { "tipe": "formula_block", "latex": "(p - 4)(p + 4) < 0" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $p = -4$ dan $p = 4$. Karena tanda pertidaksamaan $< 0$, penyelesaian berada di antara kedua batas:" },
        { "tipe": "formula_block", "latex": "-4 < p < 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $p$ yang memenuhi adalah **$-4 < p < 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 2x - 5 = 0$, nilai $\\alpha^2\\beta + \\alpha\\beta^2 + 3\\alpha\\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-15$" } ],
        [ { "tipe": "paragraph", "text": "$-10$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $x^2 + 2x - 5 = 0$ ($a = 1$, $b = 2$, $c = -5$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{2}{1} = -2" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{-5}{1} = -5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk aljabar yang ditanyakan**" },
        { "tipe": "formula_block", "latex": "\\alpha^2\\beta + \\alpha\\beta^2 + 3\\alpha\\beta = \\alpha\\beta(\\alpha + \\beta) + 3\\alpha\\beta" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diperoleh**" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta(\\alpha + \\beta) + 3\\alpha\\beta = (-5)(-2) + 3(-5) = 10 - 15 = -5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $\\alpha^2\\beta + \\alpha\\beta^2 + 3\\alpha\\beta$ adalah **$-5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x+2}{x-3} \\leq 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pindahkan konstanta $1$ ke ruas kiri dan samakan penyebutnya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{x+2}{x-3} - 1 \\leq 0" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x+2) - (x-3)}{x-3} \\leq 0" },
        { "tipe": "formula_block", "latex": "\\dfrac{x + 2 - x + 3}{x-3} \\leq 0 \\Rightarrow \\dfrac{5}{x-3} \\leq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Analisis tanda pembilang dan penyebut**" },
        { "tipe": "paragraph", "text": "Karena pembilang bernilai positif ($5 > 0$), hasil bagi akan bernilai $\\leq 0$ hanya jika penyebutnya bernilai negatif. Dengan syarat penyebut tidak boleh nol ($x - 3 \\neq 0$), diperoleh:" },
        { "tipe": "formula_block", "latex": "x - 3 < 0 \\Rightarrow x < 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x < 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 5x + 2 = 0$ adalah $\\alpha$ dan $\\beta$, nilai $\\alpha^3\\beta + \\alpha\\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 5x + 2 = 0$ ($a = 1$, $b = -5$, $c = 2$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-5}{1} = 5" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{2}{1} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan bentuk $\\alpha^3\\beta + \\alpha\\beta^3$ menggunakan identitas aljabar**" },
        { "tipe": "formula_block", "latex": "\\alpha^3\\beta + \\alpha\\beta^3 = \\alpha\\beta(\\alpha^2 + \\beta^2) = \\alpha\\beta\\left[(\\alpha + \\beta)^2 - 2\\alpha\\beta\\right]" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui dan hitung hasil akhirnya**" },
        { "tipe": "formula_block", "latex": "\\alpha^3\\beta + \\alpha\\beta^3 = 2\\left[(5)^2 - 2(2)\\right] = 2(25 - 4) = 2(21) = 42" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $\\alpha^3\\beta + \\alpha\\beta^3$ adalah **$42$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2(m+1)x + 4 = 0$ memiliki dua akar positif berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m > 2$" } ],
        [ { "tipe": "paragraph", "text": "$0 < m < 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 3$" } ],
        [ { "tipe": "paragraph", "text": "$m > 1$" } ],
        [ { "tipe": "paragraph", "text": "$m < -3$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 2(m+1)x + 4 = 0$, diketahui $a = 1$, $b = -2(m+1)$, dan $c = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan syarat dua akar real berbeda ($D > 0$)**" },
        { "tipe": "formula_block", "latex": "b^2 - 4ac > 0 \\Rightarrow (-2(m+1))^2 - 4(1)(4) > 0" },
        { "tipe": "formula_block", "latex": "4(m+1)^2 - 16 > 0 \\Rightarrow (m+1)^2 > 4" },
        { "tipe": "formula_block", "latex": "m + 1 < -2 \\quad \\text{atau} \\quad m + 1 > 2 \\Rightarrow m < -3 \\quad \\text{atau} \\quad m > 1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Terapkan syarat jumlah ($x_1 + x_2 > 0$) dan hasil kali ($x_1 \\cdot x_2 > 0$) akar positif**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 > 0 \\Rightarrow -\\dfrac{b}{a} > 0 \\Rightarrow 2(m+1) > 0 \\Rightarrow m > -1" },
        { "tipe": "formula_block", "latex": "x_1 \\cdot x_2 > 0 \\Rightarrow \\dfrac{c}{a} > 0 \\Rightarrow 4 > 0 \\quad [\\text{Selalu terpenuhi}]" },
        { "tipe": "paragraph", "text": "**Langkah 4: Iriskan ketiga syarat tersebut**" },
        { "tipe": "paragraph", "text": "Irisan dari $(m < -3 \\text{ atau } m > 1)$ dengan $m > -1$ menghasilkan:" },
        { "tipe": "formula_block", "latex": "m > 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ yang memenuhi adalah **$m > 1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x^2 - 8x + 5$, nilai $x$ agar $f(x)$ minimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien fungsi kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = 2x^2 - 8x + 5$, diperoleh $a = 2$, $b = -8$, dan $c = 5$. Karena $a > 0$, grafik terbuka ke atas dan mencapai nilai minimum pada sumbu simetrinya." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung pembuat nilai minimum menggunakan rumus sumbu simetri ($x_p$)**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{b}{2a} = -\\dfrac{-8}{2(2)} = \\dfrac{8}{4} = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ agar $f(x)$ minimum adalah **$x = 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $2x^2 - 8x + 5 = 0$, nilai $\\dfrac{2}{\\alpha} + \\dfrac{2}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{16}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Dari $2x^2 - 8x + 5 = 0$ ($a = 2$, $b = -8$, $c = 5$), diperoleh:" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-8}{2} = 4" },
        { "tipe": "formula_block", "latex": "\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut pada bentuk pecahan yang ditanyakan**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{\\alpha} + \\dfrac{2}{\\beta} = \\dfrac{2\\beta + 2\\alpha}{\\alpha\\beta} = \\dfrac{2(\\alpha + \\beta)}{\\alpha\\beta}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diketahui**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2(\\alpha + \\beta)}{\\alpha\\beta} = \\dfrac{2(4)}{\\dfrac{5}{2}} = 8 \\cdot \\dfrac{2}{5} = \\dfrac{16}{5}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari $\\dfrac{2}{\\alpha} + \\dfrac{2}{\\beta}$ adalah **$\\dfrac{16}{5}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
