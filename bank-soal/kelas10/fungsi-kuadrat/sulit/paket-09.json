{
  "id": "bs-k10-fk-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit aplikasi fungsi kuadrat dan optimasi (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kawat panjang 100 cm akan dibuat persegi panjang. Luas maksimum persegi panjang tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$625$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$600$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$650$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$575$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$700$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan hubungan antara panjang ($p$) dan lebar ($l$) dari keliling.**" },
        { "tipe": "paragraph", "text": "$K = 2(p + l) = 100 \\Rightarrow p + l = 50 \\Rightarrow l = 50 - p$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Bentuk fungsi luas $L(p)$ dalam satu variabel.**" },
        { "tipe": "paragraph", "text": "$L(p) = p \\cdot l = p(50 - p) = -p^2 + 50p$" },
        { "tipe": "paragraph", "text": "Dari fungsi kuadrat tersebut, diperoleh $a = -1$, $b = 50$, dan $c = 0$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Cari panjang optimal ($p_{\\text{opt}}$) menggunakan rumus sumbu simetri.**" },
        { "tipe": "paragraph", "text": "$p_{\\text{opt}} = -\\dfrac{b}{2a} = -\\dfrac{50}{2(-1)} = 25\\text{ cm}$" },
        { "tipe": "paragraph", "text": "Maka lebarnya adalah $l = 50 - 25 = 25\\text{ cm}$." },
        { "tipe": "paragraph", "text": "**Langkah 4: Hitung luas maksimum.**" },
        { "tipe": "paragraph", "text": "$L_{\\text{maks}} = p \\cdot l = 25 \\cdot 25 = 625\\text{ cm}^2$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Luas maksimum persegi panjang tersebut adalah $625$ cm²." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah peluru ditembakkan dengan ketinggian $h(t) = 40t - 4t^2$ meter. Tinggi maksimum peluru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$90$ m" } ],
        [ { "tipe": "paragraph", "text": "$100$ m" } ],
        [ { "tipe": "paragraph", "text": "$110$ m" } ],
        [ { "tipe": "paragraph", "text": "$80$ m" } ],
        [ { "tipe": "paragraph", "text": "$120$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien fungsi ketinggian.**" },
        { "tipe": "paragraph", "text": "Ubah urutan suku fungsi menjadi bentuk umum: $h(t) = -4t^2 + 40t$, sehingga diperoleh $a = -4$, $b = 40$, dan $c = 0$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung waktu untuk mencapai tinggi maksimum ($t_p$).**" },
        { "tipe": "paragraph", "text": "$t_p = -\\dfrac{b}{2a} = -\\dfrac{40}{2(-4)} = -\\dfrac{40}{-8} = 5\\text{ detik}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan $t = 5$ ke fungsi $h(t)$ untuk mencari tinggi maksimum.**" },
        { "tipe": "paragraph", "text": "$h_{\\text{maks}} = h(5) = 40(5) - 4(5)^2$" },
        { "tipe": "paragraph", "text": "$h_{\\text{maks}} = 200 - 4(25) = 200 - 100 = 100\\text{ m}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Tinggi maksimum yang dicapai peluru adalah $100$ m." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Biaya produksi $x$ unit barang dinyatakan $C(x) = x^2 - 24x + 200$ (ribu rupiah). Biaya minimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$60$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$64$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$56$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$52$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$48$ ribu" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien fungsi biaya.**" },
        { "tipe": "paragraph", "text": "Dari $C(x) = x^2 - 24x + 200$, diperoleh $a = 1$, $b = -24$, dan $c = 200$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan jumlah unit ($x_p$) agar biaya minimum.**" },
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} = -\\dfrac{-24}{2(1)} = 12\\text{ unit}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan $x = 12$ ke fungsi $C(x)$ untuk mendapatkan biaya minimum.**" },
        { "tipe": "paragraph", "text": "$C_{\\text{min}} = C(12) = (12)^2 - 24(12) + 200$" },
        { "tipe": "paragraph", "text": "$C_{\\text{min}} = 144 - 288 + 200 = 56\\text{ ribu rupiah}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Biaya produksi minimumnya adalah $56$ ribu." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah dua bilangan adalah 40. Jika hasil kali kedua bilangan maksimum, bilangan terkecil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan kedua bilangan tersebut dalam satu variabel.**" },
        { "tipe": "paragraph", "text": "Jika bilangan pertama adalah $x$, karena jumlah keduanya $40$, maka bilangan kedua adalah $40 - x$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun fungsi hasil kali $P(x)$.**" },
        { "tipe": "paragraph", "text": "$P(x) = x(40 - x) = -x^2 + 40x$" },
        { "tipe": "paragraph", "text": "Diperoleh koefisien $a = -1$ dan $b = 40$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan nilai $x$ yang memaksimumkan hasil kali.**" },
        { "tipe": "paragraph", "text": "$x_{\\text{opt}} = -\\dfrac{b}{2a} = -\\dfrac{40}{2(-1)} = 20$" },
        { "tipe": "paragraph", "text": "Maka bilangan pertama adalah $20$ dan bilangan kedua adalah $40 - 20 = 20$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Karena kedua bilangan bernilai sama, bilangan terkecilnya adalah $20$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah roket mainan diluncurkan dengan ketinggian $h(t) = 30t - t^2$ meter. Waktu yang dibutuhkan roket untuk mencapai tanah kembali adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$ detik" } ],
        [ { "tipe": "paragraph", "text": "$35$ detik" } ],
        [ { "tipe": "paragraph", "text": "$20$ detik" } ],
        [ { "tipe": "paragraph", "text": "$40$ detik" } ],
        [ { "tipe": "paragraph", "text": "$30$ detik" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami syarat roket menyentuh tanah.**" },
        { "tipe": "paragraph", "text": "Saat roket berada di permukaan tanah, ketinggiannya sama dengan nol ($h(t) = 0$)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan kuadrat $h(t) = 0$.**" },
        { "tipe": "paragraph", "text": "$30t - t^2 = 0$" },
        { "tipe": "paragraph", "text": "Faktorkan variabel $t$: $t(30 - t) = 0$" },
        { "tipe": "paragraph", "text": "Diperoleh dua nilai waktu: $t = 0$ (saat roket baru diluncurkan) atau $t = 30$ (saat roket jatuh kembali ke tanah)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Waktu yang dibutuhkan roket untuk mencapai tanah kembali adalah $30$ detik." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah taman berbentuk persegi panjang dengan keliling 80 m. Agar luas taman maksimum, panjang taman adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$ m" } ],
        [ { "tipe": "paragraph", "text": "$20$ m" } ],
        [ { "tipe": "paragraph", "text": "$25$ m" } ],
        [ { "tipe": "paragraph", "text": "$30$ m" } ],
        [ { "tipe": "paragraph", "text": "$10$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan lebar ($l$) dalam panjang ($p$) dari rumus keliling.**" },
        { "tipe": "paragraph", "text": "$K = 2(p + l) = 80 \\Rightarrow p + l = 40 \\Rightarrow l = 40 - p$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun fungsi luas taman $L(p)$.**" },
        { "tipe": "paragraph", "text": "$L(p) = p \\cdot l = p(40 - p) = -p^2 + 40p$" },
        { "tipe": "paragraph", "text": "Diperoleh koefisien $a = -1$ dan $b = 40$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung panjang optimal ($p_{\\text{opt}}$) menggunakan rumus sumbu simetri.**" },
        { "tipe": "paragraph", "text": "$p_{\\text{opt}} = -\\dfrac{b}{2a} = -\\dfrac{40}{2(-1)} = 20\\text{ m}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Agar luas taman maksimum, panjang taman haruslah $20$ m." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Keuntungan penjualan $x$ unit barang dinyatakan $P(x) = -3x^2 + 90x - 200$ (ribu rupiah). Keuntungan maksimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$450$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$500$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$475$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$425$ ribu" } ],
        [ { "tipe": "paragraph", "text": "$525$ ribu" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien fungsi keuntungan.**" },
        { "tipe": "paragraph", "text": "Dari $P(x) = -3x^2 + 90x - 200$, diperoleh $a = -3$, $b = 90$, dan $c = -200$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari jumlah unit ($x_p$) yang menghasilkan keuntungan maksimum.**" },
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} = -\\dfrac{90}{2(-3)} = -\\dfrac{90}{-6} = 15\\text{ unit}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan $x = 15$ ke fungsi $P(x)$ untuk mendapatkan keuntungan maksimum.**" },
        { "tipe": "paragraph", "text": "$P_{\\text{maks}} = P(15) = -3(15)^2 + 90(15) - 200$" },
        { "tipe": "paragraph", "text": "$P_{\\text{maks}} = -3(225) + 1350 - 200$" },
        { "tipe": "paragraph", "text": "$P_{\\text{maks}} = -675 + 1350 - 200 = 475\\text{ ribu rupiah}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Keuntungan maksimum yang diperoleh adalah $475$ ribu." }
      ],
      "tingkat": "SULIT"
    },
    {
