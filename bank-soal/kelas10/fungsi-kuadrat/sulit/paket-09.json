        [ { "tipe": "paragraph", "text": "$4000$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$2800$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$3600$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$4400$ cm²" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan lebar ($l$) dalam panjang ($p$) dari rumus keliling.**" },
        { "tipe": "paragraph", "text": "$K = 2(p + l) = 240 \\Rightarrow p + l = 120 \\Rightarrow l = 120 - p$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Bentuk fungsi luas jendela $L(p)$.**" },
        { "tipe": "paragraph", "text": "$L(p) = p \\cdot l = p(120 - p) = -p^2 + 120p$" },
        { "tipe": "paragraph", "text": "Diperoleh koefisien $a = -1$ dan $b = 120$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung panjang optimal ($p_{\\text{opt}}$) menggunakan rumus sumbu simetri.**" },
