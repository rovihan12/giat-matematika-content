{
  "id": "bs-k10-fk-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan tanda fungsi",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\dfrac{x^2 - 5x + 6}{x - 1} \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $2 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x \\leq 2$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$ atau $1 < x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pembilang.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{(x - 2)(x - 3)}{x - 1} \\leq 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan titik pembuat nol dan syarat penyebut.**" },
        { "tipe": "paragraph", "text": "Pembuat nol pembilang: $x = 2$ dan $x = 3$ (selang tertutup karena tanda $\\leq$)." },
        { "tipe": "paragraph", "text": "Pembuat nol penyebut: $x = 1$ (selang terbuka karena penyebut tidak boleh nol, $x \\neq 1$)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji tanda pada garis bilangan.**" },
        { "tipe": "paragraph", "text": "Untuk $x < 1$ (misal $x = 0$): $\\dfrac{(-)(-)}{-} = -$ (memenuhi $\\leq 0$)" },
        { "tipe": "paragraph", "text": "Untuk $1 < x < 2$ (misal $x = 1{,}5$): $\\dfrac{(-)(-)}{+} = +$ (tidak memenuhi)" },
        { "tipe": "paragraph", "text": "Untuk $2 < x < 3$ (misal $x = 2{,}5$): $\\dfrac{(+)(-)}{+} = -$ (memenuhi $\\leq 0$)" },
        { "tipe": "paragraph", "text": "Untuk $x > 3$ (misal $x = 4$): $\\dfrac{(+)(+)}{+} = +$ (tidak memenuhi)" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Daerah yang bertanda negatif ($\\leq 0$) adalah $x < 1$ atau $2 \\leq x \\leq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar persamaan $x^2 - 2mx + (m+2) = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 < m < 2$" } ],
        [ { "tipe": "paragraph", "text": "$m < -1$ atau $m > 2$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq -1$ atau $m \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$m > 2$" } ],
        [ { "tipe": "paragraph", "text": "$m < -1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 2mx + (m + 2) = 0$, diperoleh $a = 1$, $b = -2m$, dan $c = m + 2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan syarat dua akar real berbeda ($D > 0$).**" },
        { "tipe": "paragraph", "text": "$b^2 - 4ac > 0$" },
        { "tipe": "paragraph", "text": "$(-2m)^2 - 4(1)(m + 2) > 0$" },
        { "tipe": "paragraph", "text": "$4m^2 - 4m - 8 > 0$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan dan faktorkan pertidaksamaan.**" },
        { "tipe": "paragraph", "text": "Bagi kedua ruas dengan $4$: $m^2 - m - 2 > 0$" },
        { "tipe": "paragraph", "text": "$(m - 2)(m + 1) > 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol adalah $m = -1$ dan $m = 2$. Karena tanda pertidaksamaan $> 0$, maka daerah penyelesaian berada di luar kedua batas tersebut." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $m$ yang memenuhi adalah $m < -1$ atau $m > 2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 8x + k = 0$ adalah $\\alpha$ dan $\\beta$ dengan $\\alpha = 3\\beta$, nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jumlah dan hasil kali akar (Teorema Vieta).**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 8x + k = 0$ ($a = 1$, $b = -8$, $c = k$):" },
        { "tipe": "paragraph", "text": "Jumlah akar: $\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-8}{1} = 8$" },
        { "tipe": "paragraph", "text": "Hasil kali akar: $\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{k}{1} = k$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $\\alpha = 3\\beta$ ke persamaan jumlah akar.**" },
        { "tipe": "paragraph", "text": "$3\\beta + \\beta = 8 \\Rightarrow 4\\beta = 8 \\Rightarrow \\beta = 2$" },
        { "tipe": "paragraph", "text": "Maka, $\\alpha = 3(2) = 6$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $k$.**" },
        { "tipe": "paragraph", "text": "$k = \\alpha\\beta = 6 \\cdot 2 = 12$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $k$ adalah $12$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 4x| < 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{7} < x < 1$ atau $3 < x < 2 + \\sqrt{7}$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 3$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah pertidaksamaan nilai mutlak menjadi pertidaksamaan ganda.**" },
        { "tipe": "paragraph", "text": "Sifat $|f(x)| < a \\iff -a < f(x) < a$, sehingga:" },
        { "tipe": "paragraph", "text": "$-3 < x^2 - 4x < 3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan bagian kanan ($x^2 - 4x < 3$).**" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 3 < 0$" },
        { "tipe": "paragraph", "text": "Gunakan rumus ABC untuk mencari pembuat nol:" },
        { "tipe": "paragraph", "text": "$x_{1,2} = \\dfrac{4 \\pm \\sqrt{(-4)^2 - 4(1)(-3)}}{2(1)} = \\dfrac{4 \\pm \\sqrt{28}}{2} = 2 \\pm \\sqrt{7}$" },
        { "tipe": "paragraph", "text": "Karena tanda $< 0$, penyelesaiannya adalah: $2 - \\sqrt{7} < x < 2 + \\sqrt{7}$ ... (Syarat 1)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan bagian kiri ($x^2 - 4x > -3$).**" },
        { "tipe": "paragraph", "text": "$x^2 - 4x + 3 > 0 \\Rightarrow (x - 1)(x - 3) > 0$" },
        { "tipe": "paragraph", "text": "Karena tanda $> 0$, penyelesaiannya adalah: $x < 1$ atau $x > 3$ ... (Syarat 2)" },
        { "tipe": "paragraph", "text": "**Langkah 4: Cari irisan dari Syarat 1 dan Syarat 2.**" },
        { "tipe": "paragraph", "text": "Perhatikan bahwa $\\sqrt{7} \\approx 2{,}65$, sehingga $2 - \\sqrt{7} \\approx -0{,}65$ dan $2 + \\sqrt{7} \\approx 4{,}65$." },
        { "tipe": "paragraph", "text": "Irisan dari $(-0{,}65 < x < 4{,}65)$ dengan $(x < 1 \\text{ atau } x > 3)$ menghasilkan:" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $2 - \\sqrt{7} < x < 1$ atau $3 < x < 2 + \\sqrt{7}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + px + q$ memiliki nilai minimum $-4$ di $x = 2$, nilai $p + q$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus sumbu simetri ($x_p$) untuk mencari nilai $p$.**" },
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 + px + q$ memiliki $a = 1$, $b = p$, dan titik puncak $(2, -4)$." },
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} \\Rightarrow 2 = -\\dfrac{p}{2(1)} \\Rightarrow p = -4$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $p = -4$ dan titik $(2, -4)$ ke fungsi untuk mencari $q$.**" },
        { "tipe": "paragraph", "text": "$f(2) = -4$" },
        { "tipe": "paragraph", "text": "$(2)^2 + (-4)(2) + q = -4$" },
        { "tipe": "paragraph", "text": "$4 - 8 + q = -4 \\Rightarrow -4 + q = -4 \\Rightarrow q = 0$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $p + q$.**" },
        { "tipe": "paragraph", "text": "$p + q = -4 + 0 = -4$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $p + q$ adalah $-4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 4x + 3 \\leq 0$ dan $x^2 - 4x - 5 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Selesaikan pertidaksamaan pertama.**" },
        { "tipe": "paragraph", "text": "$x^2 - 4x + 3 \\leq 0$" },
        { "tipe": "paragraph", "text": "$(x - 1)(x - 3) \\leq 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = 1$ dan $x = 3$. Karena tanda $\\leq 0$, daerahnya berada di antara kedua akar: $1 \\leq x \\leq 3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan kedua.**" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 5 \\leq 0$" },
        { "tipe": "paragraph", "text": "$(x - 5)(x + 1) \\leq 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol $x = -1$ dan $x = 5$. Karena tanda $\\leq 0$, daerahnya adalah: $-1 \\leq x \\leq 5$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan irisan dari kedua penyelesaian.**" },
        { "tipe": "paragraph", "text": "Karena kata hubungnya adalah **dan**, kita ambil irisan dari $(1 \\leq x \\leq 3)$ dan $(-1 \\leq x \\leq 5)$, yaitu bagian yang termuat di keduanya." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $1 \\leq x \\leq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x + 1 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$52$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $x^2 - 4x + 1 = 0$ ($a = 1$, $b = -4$, $c = 1$):" },
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-4}{1} = 4$" },
        { "tipe": "paragraph", "text": "$\\alpha\\beta = \\dfrac{c}{a} = \\dfrac{1}{1} = 1$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk $\\alpha^3 + \\beta^3$ menggunakan identitas aljabar.**" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang sudah diketahui.**" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (4)^3 - 3(1)(4)$" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = 64 - 12 = 52$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $\\alpha^3 + \\beta^3$ adalah $52$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 6x + 5$ memiliki nilai minimum $m$ di $x = p$. Nilai $p + m$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari pembuat nilai minimum ($p$) menggunakan rumus sumbu simetri.**" },
        { "tipe": "paragraph", "text": "Dari $f(x) = x^2 - 6x + 5$, diketahui $a = 1$, $b = -6$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "$p = x_p = -\\dfrac{b}{2a} = -\\dfrac{-6}{2(1)} = 3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 3$ ke fungsi untuk mendapatkan nilai minimum ($m$).**" },
        { "tipe": "paragraph", "text": "$m = f(3) = (3)^2 - 6(3) + 5$" },
        { "tipe": "paragraph", "text": "$m = 9 - 18 + 5 = -4$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $p + m$.**" },
        { "tipe": "paragraph", "text": "$p + m = 3 + (-4) = -1$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $p + m$ adalah $-1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 4 \\leq 3x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$-4 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -4$ atau $x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 4$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pindahkan semua suku ke ruas kiri agar ruas kanan bernilai nol.**" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 \\leq 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat untuk mencari pembuat nol.**" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) \\leq 0$" },
        { "tipe": "paragraph", "text": "Diperoleh pembuat nol $x = -1$ dan $x = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan interval penyelesaian.**" },
        { "tipe": "paragraph", "text": "Karena koefisien $x^2$ positif dan tanda pertidaksamaan $\\leq 0$, maka daerah penyelesaian berada di antara kedua akar." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Himpunan penyelesaiannya adalah $-1 \\leq x \\leq 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar $2x^2 - 4x + 1 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan jumlah dan hasil kali akar dari persamaan kuadrat.**" },
        { "tipe": "paragraph", "text": "Dari $2x^2 - 4x + 1 = 0$ ($a = 2$, $b = -4$, $c = 1$):" },
        { "tipe": "paragraph", "text": "$x_1 + x_2 = -\\dfrac{b}{a} = -\\dfrac{-4}{2} = 2$" },
        { "tipe": "paragraph", "text": "$x_1 x_2 = \\dfrac{c}{a} = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk aljabar yang ditanyakan.**" },
        { "tipe": "paragraph", "text": "$x_1^2 x_2 + x_1 x_2^2 = x_1 x_2 (x_1 + x_2)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang sudah diperoleh.**" },
        { "tipe": "paragraph", "text": "$x_1 x_2 (x_1 + x_2) = \\dfrac{1}{2} \\cdot 2 = 1$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai dari $x_1^2 x_2 + x_1 x_2^2$ adalah $1$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}