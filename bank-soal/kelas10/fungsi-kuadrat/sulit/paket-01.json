{
  "id": "bs-k10-fk-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang pertidaksamaan kuadrat dan tanda fungsi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\dfrac{x^2 - 5x + 6}{x - 1} \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $2 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x \\leq 2$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$ atau $1 < x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan: $\\dfrac{(x-2)(x-3)}{x-1} \\leq 0$" },
        { "tipe": "paragraph", "text": "Titik kritis: $x = 1$ (dikecualikan), $x = 2$, $x = 3$." },
        { "tipe": "paragraph", "text": "Uji $x = 0$: $\\dfrac{(-)(-)}{-} = - \\leq 0$ ✓" },
        { "tipe": "paragraph", "text": "Uji $x = 1{,}5$: $\\dfrac{(-)(-)}{+} = + > 0$ ✗" },
        { "tipe": "paragraph", "text": "Uji $x = 2{,}5$: $\\dfrac{(+)(-)}{+} = - \\leq 0$ ✓" },
        { "tipe": "paragraph", "text": "Uji $x = 4$: $\\dfrac{(+)(+)}{+} = + > 0$ ✗" },
        { "tipe": "paragraph", "text": "HP = $x < 1$ atau $2 \\leq x \\leq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar persamaan $x^2 - 2mx + (m+2) = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m < -1$ atau $m > 2$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < m < 2$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq -1$ atau $m \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$m > 2$" } ],
        [ { "tipe": "paragraph", "text": "$m < -1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D > 0 \\Rightarrow (-2m)^2 - 4(m+2) > 0$" },
        { "tipe": "paragraph", "text": "$4m^2 - 4m - 8 > 0 \\Rightarrow m^2 - m - 2 > 0$" },
        { "tipe": "paragraph", "text": "$(m - 2)(m + 1) > 0 \\Rightarrow m < -1$ atau $m > 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 8x + k = 0$ adalah $\\alpha$ dan $\\beta$ dengan $\\alpha = 3\\beta$, nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 8$; $\\alpha\\beta = k$." },
        { "tipe": "paragraph", "text": "$\\alpha = 3\\beta \\Rightarrow 3\\beta + \\beta = 8 \\Rightarrow \\beta = 2$, $\\alpha = 6$." },
        { "tipe": "paragraph", "text": "$k = \\alpha\\beta = 12$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x^2 - 4x| < 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{7} < x < 1$ atau $3 < x < 2 + \\sqrt{7}$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$-3 < x^2 - 4x < 3$" },
        { "tipe": "paragraph", "text": "Kasus 1: $x^2 - 4x - 3 < 0$ → $2 - \\sqrt{7} < x < 2 + \\sqrt{7}$" },
        { "tipe": "paragraph", "text": "Kasus 2: $x^2 - 4x + 3 > 0$ → $(x-1)(x-3) > 0$ → $x < 1$ atau $x > 3$" },
        { "tipe": "paragraph", "text": "Irisan: $2 - \\sqrt{7} < x < 1$ atau $3 < x < 2 + \\sqrt{7}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + px + q$ memiliki nilai minimum $-4$ di $x = 2$, nilai $p + q$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik puncak $(2, -4)$: $-\\dfrac{p}{2} = 2 \\Rightarrow p = -4$." },
        { "tipe": "paragraph", "text": "Substitusi $(2, -4)$: $4 - 8 + q = -4 \\Rightarrow q = 0$." },
        { "tipe": "paragraph", "text": "$p + q = -4 + 0 = -4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 4x + 3 \\leq 0$ dan $x^2 - 4x - 5 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 4x + 3 \\leq 0 \\Rightarrow (x-1)(x-3) \\leq 0 \\Rightarrow 1 \\leq x \\leq 3$" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 5 \\leq 0 \\Rightarrow (x-5)(x+1) \\leq 0 \\Rightarrow -1 \\leq x \\leq 5$" },
        { "tipe": "paragraph", "text": "Irisan: $1 \\leq x \\leq 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x + 1 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$52$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 4$; $\\alpha\\beta = 1$" },
        { "tipe": "paragraph", "text": "$\\alpha^3 + \\beta^3 = (\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)$" },
        { "tipe": "paragraph", "text": "$= 64 - 12 = 52$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 6x + 5$ memiliki nilai minimum $m$ di $x = p$. Nilai $p + m$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$p = -\\dfrac{-6}{2} = 3$" },
        { "tipe": "paragraph", "text": "$m = 9 - 18 + 5 = -4$" },
        { "tipe": "paragraph", "text": "$p + m = 3 - 4 = -1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 4 \\leq 3x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$-4 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -4$ atau $x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 \\leq 0$" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) \\leq 0$" },
        { "tipe": "paragraph", "text": "HP = $-1 \\leq x \\leq 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-fk-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar $2x^2 - 4x + 1 = 0$, nilai $x_1^2 x_2 + x_1 x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 2$; $x_1 x_2 = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$x_1^2 x_2 + x_1 x_2^2 = x_1 x_2 (x_1 + x_2) = \\dfrac{1}{2} \\cdot 2 = 1$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
