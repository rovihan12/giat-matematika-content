      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diskriminan dari persamaan $x^2 - 2x - 15 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$68$" } ],
        [ { "tipe": "paragraph", "text": "$52$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = b^2 - 4ac = (-2)^2 - 4(1)(-15)$" },
