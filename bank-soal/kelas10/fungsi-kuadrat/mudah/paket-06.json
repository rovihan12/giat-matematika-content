      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar persamaan $x^2 - 9x + 20 = 0$, nilai $x_1 + x_2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$-20$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah akar: $x_1 + x_2 = -\\dfrac{b}{a} = -\\dfrac{-9}{1} = 9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar persamaan $x^2 - 9x + 20 = 0$, nilai $x_1 \\cdot x_2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$-20$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hasil kali akar: $x_1 \\cdot x_2 = \\dfrac{c}{a} = \\dfrac{20}{1} = 20$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-2$ dan $6$ adalah..." }
