        [ { "tipe": "paragraph", "text": "$x^2 - 4x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 4x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 4x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 8x + 12 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = -2 + 6 = 4$; $x_1 \\cdot x_2 = -2 \\cdot 6 = -12$" },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 - (x_1 + x_2)x + x_1 x_2 = 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 12 = 0$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
