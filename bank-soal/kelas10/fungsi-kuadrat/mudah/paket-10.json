{
  "id": "bs-k10-fk-m-10",
  "nama": "Bank Soal Mudah - Paket 10",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran tentang fungsi kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 5x + 6$, nilai $f(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(5) = 25 - 25 + 6 = 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 3x - 10$, nilai $f(-4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(-4) = 16 - 12 - 10 = -6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik potong grafik $y = x^2 - 7x + 12$ dengan sumbu-$y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, 12)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -12)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 7)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -7)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 0$: $y = 12$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-5$ dan $2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 3x - 10 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x - 10 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 3x + 10 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x + 10 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 7x + 10 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $= -5 + 2 = -3$; hasil kali $= -10$" },
        { "tipe": "paragraph", "text": "$x^2 - (-3)x + (-10) = 0 \\Rightarrow x^2 + 3x - 10 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = 3x^2 - 12x + 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-12}{6} = 2$" },
        { "tipe": "paragraph", "text": "$y_p = 3(4) - 12(2) + 10 = 12 - 24 + 10 = -2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar $x^2 - 7x + 10 = 0$, nilai $x_1^2 + x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 7$; $x_1 x_2 = 10$" },
        { "tipe": "paragraph", "text": "$x_1^2 + x_2^2 = (x_1 + x_2)^2 - 2x_1 x_2 = 49 - 20 = 29$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 6x + 9$ menyinggung sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(3, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(9, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 9)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 3)^2 = 0 \\Rightarrow x = 3$ (kembar)" },
        { "tipe": "paragraph", "text": "Menyinggung di $(3, 0)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $p$ agar $f(x) = x^2 - 8x + p$ memiliki nilai minimum 2 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 4$; $y_{min} = 16 - 32 + p = p - 16$" },
        { "tipe": "paragraph", "text": "$p - 16 = 2 \\Rightarrow p = 18$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3x^2 - 2x + 1$, nilai $f(1) + f(-2)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(1) = 3 - 2 + 1 = 2$" },
        { "tipe": "paragraph", "text": "$f(-2) = 3(4) - 2(-2) + 1 = 12 + 4 + 1 = 17$" },
        { "tipe": "paragraph", "text": "$f(1) + f(-2) = 2 + 17 = 19$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -3x^2 + 12x - 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{12}{-6} = 2$" },
        { "tipe": "paragraph", "text": "$y_{max} = -3(4) + 12(2) - 5 = -12 + 24 - 5 = 7$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
