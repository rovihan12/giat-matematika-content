{
  "id": "bs-k10-fk-m-08",
  "nama": "Bank Soal Mudah - Paket 8",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang menyusun persamaan kuadrat baru (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $5$ dan $-3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 2x - 15 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x - 15 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 2x + 15 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 15 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 8x + 15 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 5 + (-3) = 2$; $x_1 \\cdot x_2 = 5 \\cdot (-3) = -15$" },
        { "tipe": "paragraph", "text": "$x^2 - (2)x + (-15) = 0 \\Rightarrow x^2 - 2x - 15 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-6$ dan $-2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 8x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 8x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 8x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 8x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 12x + 8 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $= -8$; hasil kali $= 12$" },
        { "tipe": "paragraph", "text": "$x^2 - (-8)x + 12 = 0 \\Rightarrow x^2 + 8x + 12 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar persamaan $x^2 - 6x + 8 = 0$ adalah $\\alpha$ dan $\\beta$, maka nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 6$; $\\alpha \\beta = 8$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = 36 - 16 = 20$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat $3x^2 - 7x + 2 = 0$ memiliki akar $\\alpha$ dan $\\beta$. Nilai $\\alpha + \\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{b}{a} = -\\dfrac{-7}{3} = \\dfrac{7}{3}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat $4x^2 + 3x - 1 = 0$ memiliki akar $\\alpha$ dan $\\beta$. Nilai $\\alpha \\cdot \\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha \\beta = \\dfrac{c}{a} = \\dfrac{-1}{4} = -\\dfrac{1}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x + 4 = 0$, nilai $\\dfrac{1}{\\alpha} + \\dfrac{1}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 5$; $\\alpha \\beta = 4$" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{\\alpha} + \\dfrac{1}{\\beta} = \\dfrac{\\alpha + \\beta}{\\alpha\\beta} = \\dfrac{5}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya 3 kali akar-akar persamaan $x^2 - 4x + 3 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 12x + 27 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 12x + 27 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 12x - 27 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 9 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 - 12x + 9 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar lama: $1$ dan $3$. Akar baru: $3$ dan $9$." },
        { "tipe": "paragraph", "text": "Jumlah $= 12$; hasil kali $= 27$." },
        { "tipe": "paragraph", "text": "$x^2 - 12x + 27 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 3x - 10 = 0$, nilai $\\alpha^2\\beta + \\alpha\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$-30$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$-15$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -3$; $\\alpha \\beta = -10$" },
        { "tipe": "paragraph", "text": "$\\alpha^2\\beta + \\alpha\\beta^2 = \\alpha\\beta(\\alpha + \\beta) = (-10)(-3) = 30$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar persamaan $x^2 - kx + 8 = 0$ adalah 4. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 4$: $16 - 4k + 8 = 0 \\Rightarrow -4k = -24 \\Rightarrow k = 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya berkebalikan dengan akar persamaan $5x^2 - 7x + 2 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2x^2 - 7x + 5 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 7x + 5 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$5x^2 + 7x + 2 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 7x - 5 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$7x^2 - 5x + 2 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika akar $\\alpha, \\beta$, maka akar baru $\\dfrac{1}{\\alpha}, \\dfrac{1}{\\beta}$." },
        { "tipe": "paragraph", "text": "Persamaan baru: $cx^2 + bx + a = 0 \\Rightarrow 2x^2 - 7x + 5 = 0$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
