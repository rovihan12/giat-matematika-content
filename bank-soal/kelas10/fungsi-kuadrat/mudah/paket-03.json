{
  "id": "bs-k10-fk-m-03",
  "nama": "Bank Soal Mudah - Paket 3",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang menyusun persamaan kuadrat baru",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $3$ dan $-2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - x - 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x - 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x + 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x + 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 5x + 6 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 3 + (-2) = 1$; $x_1 \\cdot x_2 = 3 \\cdot (-2) = -6$" },
        { "tipe": "paragraph", "text": "$x^2 - (1)x + (-6) = 0 \\Rightarrow x^2 - x - 6 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-4$ dan $-5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + 9x + 20 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 9x + 20 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 9x - 20 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 9x - 20 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 20x + 9 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $= -9$; hasil kali $= 20$" },
        { "tipe": "paragraph", "text": "$x^2 - (-9)x + 20 = 0 \\Rightarrow x^2 + 9x + 20 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar persamaan $x^2 - 5x + 6 = 0$ adalah $\\alpha$ dan $\\beta$, maka nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 5$; $\\alpha \\beta = 6$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = 25 - 12 = 13$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat $2x^2 - 5x + 1 = 0$ memiliki akar $\\alpha$ dan $\\beta$. Nilai $\\alpha + \\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -\\dfrac{b}{a} = \\dfrac{5}{2}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat $3x^2 + 4x - 2 = 0$ memiliki akar $\\alpha$ dan $\\beta$. Nilai $\\alpha \\cdot \\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha \\beta = \\dfrac{c}{a} = \\dfrac{-2}{3}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 3x - 4 = 0$, nilai $\\dfrac{1}{\\alpha} + \\dfrac{1}{\\beta}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 3$; $\\alpha \\beta = -4$" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{\\alpha} + \\dfrac{1}{\\beta} = \\dfrac{\\alpha + \\beta}{\\alpha\\beta} = \\dfrac{3}{-4} = -\\dfrac{3}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya 2 kali akar-akar persamaan $x^2 - 5x + 6 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 10x + 24 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 10x + 24 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 10x - 24 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 5x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 - 10x + 12 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar lama: $2$ dan $3$. Akar baru: $4$ dan $6$." },
        { "tipe": "paragraph", "text": "Jumlah $= 10$; hasil kali $= 24$." },
        { "tipe": "paragraph", "text": "$x^2 - 10x + 24 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 4x - 5 = 0$, nilai $\\alpha^2\\beta + \\alpha\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$-20$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$-10$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -4$; $\\alpha \\beta = -5$" },
        { "tipe": "paragraph", "text": "$\\alpha^2\\beta + \\alpha\\beta^2 = \\alpha\\beta(\\alpha + \\beta) = (-5)(-4) = 20$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar persamaan $x^2 - kx + 6 = 0$ adalah 2. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 2$: $4 - 2k + 6 = 0 \\Rightarrow -2k = -10 \\Rightarrow k = 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya berkebalikan dengan akar persamaan $2x^2 - 5x + 3 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3x^2 - 5x + 2 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 + 5x + 2 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$2x^2 + 5x + 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$3x^2 - 5x - 2 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$5x^2 - 3x + 2 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika akar $\\alpha, \\beta$, maka akar baru $\\dfrac{1}{\\alpha}, \\dfrac{1}{\\beta}$." },
        { "tipe": "paragraph", "text": "Persamaan baru: $cx^2 + bx + a = 0 \\Rightarrow 3x^2 - 5x + 2 = 0$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
