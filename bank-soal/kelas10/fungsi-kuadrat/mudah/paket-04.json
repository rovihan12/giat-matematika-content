{
  "id": "bs-k10-fk-m-04",
  "nama": "Bank Soal Mudah - Paket 4",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang jenis akar dan diskriminan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 5x + 6 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai diskriminan ($D = b^2 - 4ac$)**" },
        { "tipe": "formula_block", "latex": "D = (-5)^2 - 4(1)(6) = 25 - 24 = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan jenis akar berdasarkan tanda $D$**" },
        { "tipe": "paragraph", "text": "Karena $D = 1 > 0$, persamaan kuadrat memiliki dua akar real berbeda." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan tersebut memiliki akar **real berbeda**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 6x + 9 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai diskriminan ($D = b^2 - 4ac$)**" },
        { "tipe": "formula_block", "latex": "D = (-6)^2 - 4(1)(9) = 36 - 36 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan jenis akar berdasarkan tanda $D$**" },
        { "tipe": "paragraph", "text": "Karena $D = 0$, persamaan kuadrat memiliki akar real kembar ($x = 3$)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan tersebut memiliki akar **real kembar**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 + x + 1 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai diskriminan ($D = b^2 - 4ac$)**" },
        { "tipe": "formula_block", "latex": "D = 1^2 - 4(1)(1) = 1 - 4 = -3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan jenis akar berdasarkan tanda $D$**" },
        { "tipe": "paragraph", "text": "Karena $D = -3 < 0$, persamaan kuadrat memiliki akar imajiner (tidak real)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan tersebut memiliki akar **imajiner**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar persamaan $x^2 - 4x + k = 0$ memiliki akar kembar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar kembar yaitu $D = 0$**" },
        { "tipe": "formula_block", "latex": "D = (-4)^2 - 4(1)(k) = 0 \\Rightarrow 16 - 4k = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $k$**" },
        { "tipe": "formula_block", "latex": "4k = 16 \\Rightarrow k = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ adalah **$4$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 + 2x + m = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m < 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 1$" } ],
        [ { "tipe": "paragraph", "text": "$m = 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\geq 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat dua akar real berbeda yaitu $D > 0$**" },
        { "tipe": "formula_block", "latex": "D = 2^2 - 4(1)(m) > 0 \\Rightarrow 4 - 4m > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan untuk mencari batas $m$**" },
        { "tipe": "formula_block", "latex": "-4m > -4 \\Rightarrow m < 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ yang memenuhi adalah **$m < 1$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diskriminan persamaan $3x^2 - 5x + 2 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien $a = 3$, $b = -5$, dan konstanta $c = 2$**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus diskriminan $D = b^2 - 4ac$." },
        { "tipe": "formula_block", "latex": "D = (-5)^2 - 4(3)(2) = 25 - 24 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, diskriminan persamaan tersebut adalah **$1$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - (k+2)x + 9 = 0$ memiliki akar kembar, nilai $k$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar kembar ($D = 0$)**" },
        { "tipe": "formula_block", "latex": "D = (-(k + 2))^2 - 4(1)(9) = 0 \\Rightarrow (k + 2)^2 - 36 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $k$ positif**" },
        { "tipe": "formula_block", "latex": "(k + 2)^2 = 36 \\Rightarrow k + 2 = \\pm 6 \\Rightarrow k = 4 \\text{ atau } k = -8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ positif yang memenuhi adalah **$4$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 2x - 3 = 0$ memiliki akar-akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$3$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$2$ dan $-1{,}5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan bentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 3 = 0 \\Rightarrow (x - 3)(x + 1) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ dari setiap faktor**" },
        { "tipe": "formula_block", "latex": "x - 3 = 0 \\Rightarrow x = 3 \\qquad \\text{atau} \\qquad x + 1 = 0 \\Rightarrow x = -1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, akar-akar persamaan tersebut adalah **$3$ dan $-1$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai diskriminan $x^2 + 4x + 4 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien $a = 1$, $b = 4$, dan konstanta $c = 4$**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus diskriminan $D = b^2 - 4ac$." },
        { "tipe": "formula_block", "latex": "D = 4^2 - 4(1)(4) = 16 - 16 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai diskriminan persamaan tersebut adalah **$0$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 + kx + 4 = 0$ TIDAK memiliki akar real, nilai $k$ harus..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4 < k < 4$" } ],
        [ { "tipe": "paragraph", "text": "$k < -4$ atau $k > 4$" } ],
        [ { "tipe": "paragraph", "text": "$k = 4$" } ],
        [ { "tipe": "paragraph", "text": "$k > 4$" } ],
        [ { "tipe": "paragraph", "text": "$k < -4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat tidak memiliki akar real yaitu $D < 0$**" },
        { "tipe": "formula_block", "latex": "D = k^2 - 4(1)(4) < 0 \\Rightarrow k^2 - 16 < 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan pertidaksamaan kuadrat dan tentukan interval $k$**" },
        { "tipe": "formula_block", "latex": "(k - 4)(k + 4) < 0 \\Rightarrow -4 < k < 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ harus memenuhi **$-4 < k < 4$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
