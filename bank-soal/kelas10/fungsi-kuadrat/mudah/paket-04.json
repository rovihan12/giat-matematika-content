    },
    {
      "id": "bs-k10-fk-m-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 6x + 9 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 36 - 36 = 0$ → akar real kembar ($x = 3$)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 + x + 1 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 1 - 4 = -3 < 0$ → akar imajiner." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar persamaan $x^2 - 4x + k = 0$ memiliki akar kembar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar kembar: $D = 0$" },
        { "tipe": "paragraph", "text": "$16 - 4k = 0 \\Rightarrow k = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 + 2x + m = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m < 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 1$" } ],
        [ { "tipe": "paragraph", "text": "$m = 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\geq 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D > 0 \\Rightarrow 4 - 4m > 0 \\Rightarrow m < 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diskriminan persamaan $3x^2 - 5x + 2 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = (-5)^2 - 4(3)(2) = 25 - 24 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - (k+2)x + 9 = 0$ memiliki akar kembar, nilai $k$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 0 \\Rightarrow (k+2)^2 - 36 = 0$" },
        { "tipe": "paragraph", "text": "$(k+2)^2 = 36 \\Rightarrow k + 2 = \\pm 6$" },
        { "tipe": "paragraph", "text": "$k = 4$ (positif) atau $k = -8$ (negatif)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 2x - 3 = 0$ memiliki akar-akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$3$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$-3$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$2$ dan $-1{,}5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 3)(x + 1) = 0$" },
        { "tipe": "paragraph", "text": "$x = 3$ atau $x = -1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai diskriminan $x^2 + 4x + 4 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 16 - 16 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 + kx + 4 = 0$ TIDAK memiliki akar real, nilai $k$ harus..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4 < k < 4$" } ],
        [ { "tipe": "paragraph", "text": "$k < -4$ atau $k > 4$" } ],
        [ { "tipe": "paragraph", "text": "$k = 4$" } ],
        [ { "tipe": "paragraph", "text": "$k > 4$" } ],
        [ { "tipe": "paragraph", "text": "$k < -4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tidak punya akar real: $D < 0$" },
        { "tipe": "paragraph", "text": "$k^2 - 16 < 0 \\Rightarrow (k-4)(k+4) < 0 \\Rightarrow -4 < k < 4$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
