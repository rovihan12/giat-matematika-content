{
  "id": "bs-k10-fk-m-07",
  "nama": "Bank Soal Mudah - Paket 7",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang grafik fungsi kuadrat dan titik puncak (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 2x - 8$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(-4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(-4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(8, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan: $(x + 2)(x - 4) = 0$" },
        { "tipe": "paragraph", "text": "Titik potong: $(-2, 0)$ dan $(4, 0)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sumbu simetri grafik $y = x^2 - 8x + 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = -8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sumbu simetri: $x = -\\dfrac{b}{2a} = -\\dfrac{-8}{2} = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = x^2 - 2x - 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, -3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-2}{2} = 1$" },
        { "tipe": "paragraph", "text": "$y_p = 1^2 - 2(1) - 3 = 1 - 2 - 3 = -4$" },
        { "tipe": "paragraph", "text": "Titik puncak = $(1, -4)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 6x + 5$ memotong sumbu-$y$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 6)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -6)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 0$: $y = 0 - 0 + 5 = 5$" },
        { "tipe": "paragraph", "text": "Titik potong: $(0, 5)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = -x^2 + 6x$ terbuka..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Ke atas" } ],
        [ { "tipe": "paragraph", "text": "Ke bawah" } ],
        [ { "tipe": "paragraph", "text": "Ke kanan" } ],
        [ { "tipe": "paragraph", "text": "Ke kiri" } ],
        [ { "tipe": "paragraph", "text": "Tidak dapat ditentukan" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Koefisien $x^2$ adalah $a = -1 < 0$ → parabola terbuka ke bawah." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = x^2 - 4x + 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-4}{2} = 2$" },
        { "tipe": "paragraph", "text": "$y_{min} = 2^2 - 4(2) + 7 = 4 - 8 + 7 = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -x^2 + 2x + 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{2}{-2} = 1$" },
        { "tipe": "paragraph", "text": "$y_{max} = -(1)^2 + 2(1) + 3 = -1 + 2 + 3 = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 6x + 8$ memotong sumbu-$x$ di titik $(4, 0)$ dan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(8, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 2)(x - 4) = 0$" },
        { "tipe": "paragraph", "text": "Titik potong: $(2, 0)$ dan $(4, 0)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan sumbu simetri fungsi $y = 3x^2 - 12x + 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x = -\\dfrac{b}{2a} = -\\dfrac{-12}{6} = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak fungsi $y = x^2 + 4x + 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-2, -1)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, -1)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, -3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{4}{2} = -2$" },
        { "tipe": "paragraph", "text": "$y_p = (-2)^2 + 4(-2) + 3 = 4 - 8 + 3 = -1$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
