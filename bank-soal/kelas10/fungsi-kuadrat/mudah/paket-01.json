        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = -6$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$ atau $x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan: $(x - 2)(x - 3) = 0$" },
        { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
