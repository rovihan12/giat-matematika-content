        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah akar: $x_1 + x_2 = -\\dfrac{b}{a} = -\\dfrac{-7}{1} = 7$" }
