      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diskriminan dari persamaan $x^2 - 6x + 8 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = b^2 - 4ac = (-6)^2 - 4(1)(8)$" },
        { "tipe": "paragraph", "text": "$= 36 - 32 = 4$" }
