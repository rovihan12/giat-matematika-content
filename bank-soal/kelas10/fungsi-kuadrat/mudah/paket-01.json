    {
      "id": "bs-k10-fk-m-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar persamaan $x^2 - 7x + 12 = 0$, nilai $x_1 + x_2$ adalah..." }
