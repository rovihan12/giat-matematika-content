      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar persamaan $x^2 - 7x + 12 = 0$, nilai $x_1 \\cdot x_2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
