{
  "id": "bs-k10-fk-m-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang grafik fungsi kuadrat dan titik puncak",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 4x + 3$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(3, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(-3, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(3, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 0)$ dan $(3, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan: $(x - 1)(x - 3) = 0$" },
        { "tipe": "paragraph", "text": "Titik potong: $(1, 0)$ dan $(3, 0)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sumbu simetri grafik $y = x^2 - 6x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sumbu simetri: $x = -\\dfrac{b}{2a} = -\\dfrac{-6}{2} = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = x^2 - 4x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, -1)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 5)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{b}{2a} = -\\dfrac{-4}{2} = 2$" },
        { "tipe": "paragraph", "text": "$y_p = 2^2 - 4(2) + 5 = 4 - 8 + 5 = 1$" },
        { "tipe": "paragraph", "text": "Titik puncak = $(2, 1)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 + 2x - 3$ memotong sumbu-$y$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, -3)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -2)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 0$: $y = 0 + 0 - 3 = -3$" },
        { "tipe": "paragraph", "text": "Titik potong: $(0, -3)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = -x^2 + 4x$ terbuka..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Ke atas" } ],
        [ { "tipe": "paragraph", "text": "Ke bawah" } ],
        [ { "tipe": "paragraph", "text": "Ke kanan" } ],
        [ { "tipe": "paragraph", "text": "Ke kiri" } ],
        [ { "tipe": "paragraph", "text": "Tidak dapat ditentukan" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Koefisien $x^2$ adalah $a = -1 < 0$ → parabola terbuka ke bawah." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = x^2 - 6x + 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-6}{2} = 3$" },
        { "tipe": "paragraph", "text": "$y_{min} = 3^2 - 6(3) + 10 = 9 - 18 + 10 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -x^2 + 4x - 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{4}{-2} = 2$" },
        { "tipe": "paragraph", "text": "$y_{max} = -(2)^2 + 4(2) - 1 = -4 + 8 - 1 = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 2x - 3$ memotong sumbu-$x$ di titik $(3, 0)$ dan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-1, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 3)(x + 1) = 0$" },
        { "tipe": "paragraph", "text": "Titik potong: $(3, 0)$ dan $(-1, 0)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan sumbu simetri fungsi $y = 2x^2 - 8x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x = -\\dfrac{b}{2a} = -\\dfrac{-8}{4} = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak fungsi $y = x^2 + 6x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-3, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, -5)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{6}{2} = -3$" },
        { "tipe": "paragraph", "text": "$y_p = (-3)^2 + 6(-3) + 5 = 9 - 18 + 5 = -4$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
