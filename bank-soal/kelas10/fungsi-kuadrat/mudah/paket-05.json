{
  "id": "bs-k10-fk-m-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran tentang fungsi kuadrat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 3x + 2$, nilai $f(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(4) = 16 - 12 + 2 = 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 8$, nilai $f(-3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(-3) = 9 - 6 - 8 = -5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik potong grafik $y = x^2 - 5x + 4$ dengan sumbu-$y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 0$: $y = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-1$ dan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 2x - 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x - 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 2x + 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x - 1 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $= 2$; hasil kali $= -3$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 3 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = 2x^2 - 8x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-8}{4} = 2$" },
        { "tipe": "paragraph", "text": "$y_p = 2(4) - 8(2) + 5 = 8 - 16 + 5 = -3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar $x^2 - 8x + 15 = 0$, nilai $x_1^2 + x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = 8$; $x_1 x_2 = 15$" },
        { "tipe": "paragraph", "text": "$x_1^2 + x_2^2 = (x_1 + x_2)^2 - 2x_1 x_2 = 64 - 30 = 34$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 4x + 4$ menyinggung sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 4)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 2)^2 = 0 \\Rightarrow x = 2$ (kembar)" },
        { "tipe": "paragraph", "text": "Menyinggung di $(2, 0)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $p$ agar $f(x) = x^2 - 6x + p$ memiliki nilai minimum 1 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 3$; $y_{min} = 9 - 18 + p = p - 9$" },
        { "tipe": "paragraph", "text": "$p - 9 = 1 \\Rightarrow p = 10$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x^2 - 3x + 1$, nilai $f(2) + f(-1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 8 - 6 + 1 = 3$" },
        { "tipe": "paragraph", "text": "$f(-1) = 2 + 3 + 1 = 6$" },
        { "tipe": "paragraph", "text": "$f(2) + f(-1) = 3 + 6 = 9$" },
        { "tipe": "paragraph", "text": "**Koreksi**: hasil $= 9$. Kunci E." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -2x^2 + 8x - 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{8}{-4} = 2$" },
        { "tipe": "paragraph", "text": "$y_{max} = -2(4) + 16 - 3 = -8 + 16 - 3 = 5$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
