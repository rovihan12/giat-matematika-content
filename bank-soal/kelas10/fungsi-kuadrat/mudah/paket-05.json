{
  "id": "bs-k10-fk-m-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran tentang fungsi kuadrat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 3x + 2$, nilai $f(4)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 4$ ke fungsi $f(x) = x^2 - 3x + 2$**" },
        { "tipe": "formula_block", "latex": "f(4) = 4^2 - 3(4) + 2 = 16 - 12 + 2 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(4)$ adalah **$6$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 + 2x - 8$, nilai $f(-3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = -3$ ke fungsi $f(x) = x^2 + 2x - 8$**" },
        { "tipe": "formula_block", "latex": "f(-3) = (-3)^2 + 2(-3) - 8 = 9 - 6 - 8 = -5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(-3)$ adalah **$-5$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik potong grafik $y = x^2 - 5x + 4$ dengan sumbu-$y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 0$ ke persamaan grafik**" },
        { "tipe": "formula_block", "latex": "y = (0)^2 - 5(0) + 4 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, titik potong grafik dengan sumbu-$y$ adalah **$(0, 4)$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-1$ dan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 2x - 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x - 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 2x + 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 2x + 3 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x - 1 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah dan hasil kali akar-akar ($x_1 = -1$ dan $x_2 = 3$)**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -1 + 3 = 2, \\qquad x_1 \\cdot x_2 = (-1)(3) = -3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat dengan rumus $x^2 - (x_1 + x_2)x + x_1 x_2 = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 3 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat yang dimaksud adalah **$x^2 - 2x - 3 = 0$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = 2x^2 - 8x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-8}{2(2)} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke fungsi untuk mencari nilai minimum ($y_{\\min}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\min} = 2(2)^2 - 8(2) + 5 = 8 - 16 + 5 = -3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum fungsi tersebut adalah **$-3$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar $x^2 - 8x + 15 = 0$, nilai $x_1^2 + x_2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $x_1 + x_2$ dan $x_1 x_2$ dari $x^2 - 8x + 15 = 0$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{-8}{1} = 8, \\qquad x_1 x_2 = \\dfrac{15}{1} = 15" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $x_1^2 + x_2^2$ dengan identitas $(x_1 + x_2)^2 - 2x_1 x_2$**" },
        { "tipe": "formula_block", "latex": "x_1^2 + x_2^2 = 8^2 - 2(15) = 64 - 30 = 34" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1^2 + x_2^2$ adalah **$34$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 4x + 4$ menyinggung sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 4)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan bentuk kuadrat sempurna pada $y = x^2 - 4x + 4$**" },
        { "tipe": "formula_block", "latex": "y = (x - 2)^2 = 0 \\Rightarrow x = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Karena akarnya kembar ($x = 2$), grafik menyinggung sumbu-$x$ di titik **$(2, 0)$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $p$ agar $f(x) = x^2 - 6x + p$ memiliki nilai minimum 1 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari absis puncak ($x_p$) dan nyatakan nilai minimum dalam $p$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-6}{2(1)} = 3 \\Rightarrow y_{\\min} = 3^2 - 6(3) + p = p - 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan nilai minimum dengan $1$ untuk mencari $p$**" },
        { "tipe": "formula_block", "latex": "p - 9 = 1 \\Rightarrow p = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $p$ adalah **$10$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2x^2 - 3x + 1$, nilai $f(2) + f(-1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $f(2)$ dan $f(-1)$**" },
        { "tipe": "formula_block", "latex": "f(2) = 2(2)^2 - 3(2) + 1 = 8 - 6 + 1 = 3" },
        { "tipe": "formula_block", "latex": "f(-1) = 2(-1)^2 - 3(-1) + 1 = 2 + 3 + 1 = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan kedua nilai tersebut**" },
        { "tipe": "formula_block", "latex": "f(2) + f(-1) = 3 + 6 = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2) + f(-1)$ adalah **$9$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -2x^2 + 8x - 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{8}{2(-2)} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke fungsi untuk mencari nilai maksimum ($y_{\\max}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\max} = -2(2)^2 + 8(2) - 3 = -8 + 16 - 3 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai maksimum fungsi tersebut adalah **$5$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
