        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$-25$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 100 - 100 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 + kx + 9 = 0$ TIDAK memiliki akar real, nilai $k$ harus..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6 < k < 6$" } ],
        [ { "tipe": "paragraph", "text": "$k < -6$ atau $k > 6$" } ],
        [ { "tipe": "paragraph", "text": "$k = 6$" } ],
        [ { "tipe": "paragraph", "text": "$k > 6$" } ],
        [ { "tipe": "paragraph", "text": "$k < -6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tidak punya akar real: $D < 0$" },
        { "tipe": "paragraph", "text": "$k^2 - 36 < 0 \\Rightarrow (k-6)(k+6) < 0 \\Rightarrow -6 < k < 6$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
