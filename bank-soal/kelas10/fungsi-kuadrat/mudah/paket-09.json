    {
      "id": "bs-k10-fk-m-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar persamaan $x^2 - 6x + k = 0$ memiliki akar kembar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar kembar: $D = 0$" },
        { "tipe": "paragraph", "text": "$36 - 4k = 0 \\Rightarrow k = 9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2x + m = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m < 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 1$" } ],
        [ { "tipe": "paragraph", "text": "$m = 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\geq 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D > 0 \\Rightarrow 4 - 4m > 0 \\Rightarrow m < 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diskriminan persamaan $2x^2 + 5x - 3 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$-49$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 5^2 - 4(2)(-3) = 25 + 24 = 49$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - (k+1)x + 16 = 0$ memiliki akar kembar, nilai $k$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 0 \\Rightarrow (k+1)^2 - 64 = 0$" },
        { "tipe": "paragraph", "text": "$(k+1)^2 = 64 \\Rightarrow k + 1 = \\pm 8$" },
        { "tipe": "paragraph", "text": "$k = 7$ (positif) atau $k = -9$ (negatif)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 4x - 5 = 0$ memiliki akar-akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$-5$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$5$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$-5$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$4$ dan $-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 5)(x + 1) = 0$" },
        { "tipe": "paragraph", "text": "$x = 5$ atau $x = -1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q09",
