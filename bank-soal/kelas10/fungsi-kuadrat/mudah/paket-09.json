        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 100 - 100 = 0$ → akar real kembar ($x = -5$)." }
