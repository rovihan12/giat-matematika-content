{
  "id": "bs-k10-fk-m-09",
  "nama": "Bank Soal Mudah - Paket 9",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang jenis akar dan diskriminan (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-m-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 8x + 12 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai diskriminan ($D = b^2 - 4ac$)**" },
        { "tipe": "formula_block", "latex": "D = (-8)^2 - 4(1)(12) = 64 - 48 = 16" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan jenis akar berdasarkan tanda $D$**" },
        { "tipe": "paragraph", "text": "Karena $D = 16 > 0$, persamaan kuadrat memiliki dua akar real berbeda." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan tersebut memiliki akar **real berbeda**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 + 10x + 25 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai diskriminan ($D = b^2 - 4ac$)**" },
        { "tipe": "formula_block", "latex": "D = 10^2 - 4(1)(25) = 100 - 100 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan jenis akar berdasarkan tanda $D$**" },
        { "tipe": "paragraph", "text": "Karena $D = 0$, persamaan kuadrat memiliki akar real kembar ($x = -5$)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan tersebut memiliki akar **real kembar**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 2x + 5 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai diskriminan ($D = b^2 - 4ac$)**" },
        { "tipe": "formula_block", "latex": "D = (-2)^2 - 4(1)(5) = 4 - 20 = -16" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan jenis akar berdasarkan tanda $D$**" },
        { "tipe": "paragraph", "text": "Karena $D = -16 < 0$, persamaan kuadrat memiliki akar imajiner (tidak real)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan tersebut memiliki akar **imajiner**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar persamaan $x^2 - 6x + k = 0$ memiliki akar kembar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar kembar yaitu $D = 0$**" },
        { "tipe": "formula_block", "latex": "D = (-6)^2 - 4(1)(k) = 0 \\Rightarrow 36 - 4k = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $k$**" },
        { "tipe": "formula_block", "latex": "4k = 36 \\Rightarrow k = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ adalah **$9$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $m$ agar $x^2 - 2x + m = 0$ memiliki dua akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$m < 1$" } ],
        [ { "tipe": "paragraph", "text": "$m > 1$" } ],
        [ { "tipe": "paragraph", "text": "$m = 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$m \\geq 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat dua akar real berbeda yaitu $D > 0$**" },
        { "tipe": "formula_block", "latex": "D = (-2)^2 - 4(1)(m) > 0 \\Rightarrow 4 - 4m > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan untuk mencari batas $m$**" },
        { "tipe": "formula_block", "latex": "-4m > -4 \\Rightarrow m < 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ yang memenuhi adalah **$m < 1$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diskriminan persamaan $2x^2 + 5x - 3 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$-49$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien $a = 2$, $b = 5$, dan konstanta $c = -3$**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus diskriminan $D = b^2 - 4ac$." },
        { "tipe": "formula_block", "latex": "D = 5^2 - 4(2)(-3) = 25 + 24 = 49" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, diskriminan persamaan tersebut adalah **$49$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - (k+1)x + 16 = 0$ memiliki akar kembar, nilai $k$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar kembar ($D = 0$)**" },
        { "tipe": "formula_block", "latex": "D = (-(k + 1))^2 - 4(1)(16) = 0 \\Rightarrow (k + 1)^2 - 64 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $k$ positif**" },
        { "tipe": "formula_block", "latex": "(k + 1)^2 = 64 \\Rightarrow k + 1 = \\pm 8 \\Rightarrow k = 7 \\text{ atau } k = -9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ positif yang memenuhi adalah **$7$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 4x - 5 = 0$ memiliki akar-akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$-5$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$5$ dan $1$" } ],
        [ { "tipe": "paragraph", "text": "$-5$ dan $-1$" } ],
        [ { "tipe": "paragraph", "text": "$4$ dan $-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan bentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "x^2 - 4x - 5 = 0 \\Rightarrow (x - 5)(x + 1) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ dari setiap faktor**" },
        { "tipe": "formula_block", "latex": "x - 5 = 0 \\Rightarrow x = 5 \\qquad \\text{atau} \\qquad x + 1 = 0 \\Rightarrow x = -1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, akar-akar persamaan tersebut adalah **$5$ dan $-1$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai diskriminan $x^2 - 10x + 25 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$-25$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien $a = 1$, $b = -10$, dan konstanta $c = 25$**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus diskriminan $D = b^2 - 4ac$." },
        { "tipe": "formula_block", "latex": "D = (-10)^2 - 4(1)(25) = 100 - 100 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai diskriminan persamaan tersebut adalah **$0$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-fk-m-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 + kx + 9 = 0$ TIDAK memiliki akar real, nilai $k$ harus..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6 < k < 6$" } ],
        [ { "tipe": "paragraph", "text": "$k < -6$ atau $k > 6$" } ],
        [ { "tipe": "paragraph", "text": "$k = 6$" } ],
        [ { "tipe": "paragraph", "text": "$k > 6$" } ],
        [ { "tipe": "paragraph", "text": "$k < -6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat tidak memiliki akar real yaitu $D < 0$**" },
        { "tipe": "formula_block", "latex": "D = k^2 - 4(1)(9) < 0 \\Rightarrow k^2 - 36 < 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan pertidaksamaan kuadrat dan tentukan interval $k$**" },
        { "tipe": "formula_block", "latex": "(k - 6)(k + 6) < 0 \\Rightarrow -6 < k < 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ harus memenuhi **$-6 < k < 6$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
