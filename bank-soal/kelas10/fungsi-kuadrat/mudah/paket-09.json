    },
    {
      "id": "bs-k10-fk-m-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $x^2 - 2x + 5 = 0$ memiliki akar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Real berbeda" } ],
        [ { "tipe": "paragraph", "text": "Real kembar" } ],
        [ { "tipe": "paragraph", "text": "Imajiner" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada akar" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga akar" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 4 - 20 = -16 < 0$ → akar imajiner." }
