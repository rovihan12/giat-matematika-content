{
  "id": "bs-k10-fk-s-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran tentang fungsi kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 7x + 6$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(-6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(-6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(3, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 1)(x - 6) = 0$" },
        { "tipe": "paragraph", "text": "Titik potong: $(1, 0)$ dan $(6, 0)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = x^2 + 6x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-3, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-6, 5)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{6}{2} = -3$" },
        { "tipe": "paragraph", "text": "$y_p = 9 - 18 + 5 = -4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x - 12 = 0$, nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 4$; $\\alpha\\beta = -12$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = 16 - 2(-12) = 16 + 24 = 40$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar $x^2 - 6x + k = 0$ memiliki akar-akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k < 9$" } ],
        [ { "tipe": "paragraph", "text": "$k > 9$" } ],
        [ { "tipe": "paragraph", "text": "$k = 9$" } ],
        [ { "tipe": "paragraph", "text": "$k \\leq 9$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq 9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D > 0 \\Rightarrow 36 - 4k > 0 \\Rightarrow k < 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-4$ dan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 7x + 12 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $= -1$; hasil kali $= -12$" },
        { "tipe": "paragraph", "text": "$x^2 - (-1)x + (-12) = 0 \\Rightarrow x^2 + x - 12 = 0$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = x^2 - 10x + 30$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 5$" },
        { "tipe": "paragraph", "text": "$y_{min} = 25 - 50 + 30 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 2x - 15 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -5$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 3)(x - 5) \\leq 0$" },
        { "tipe": "paragraph", "text": "HP = $-3 \\leq x \\leq 5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 6x + 8$, nilai $f(1) + f(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(1) = 1 - 6 + 8 = 3$" },
        { "tipe": "paragraph", "text": "$f(5) = 25 - 30 + 8 = 3$" },
        { "tipe": "paragraph", "text": "$f(1) + f(5) = 3 + 3 = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika grafik $y = x^2 - 6x + c$ melalui titik $(1, 5)$, nilai $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $(1, 5)$: $1 - 6 + c = 5 \\Rightarrow c = 10$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 2 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 6$; $\\alpha\\beta = 2$" },
        { "tipe": "paragraph", "text": "$\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{(\\alpha+\\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{36 - 4}{2} = 16$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
