{
  "id": "bs-k10-fk-s-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran tentang fungsi kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 7x + 6$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(-6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(-6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(6, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(3, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan untuk mencari pembuat nol fungsi ($f(x) = 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 7x + 6 = 0 \\Rightarrow (x - 1)(x - 6) = 0 \\Rightarrow x = 1 \\Rightarrow \\text{atau} \\Rightarrow x = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, fungsi memotong sumbu-$x$ di titik **$(1, 0)$ dan $(6, 0)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = x^2 + 6x + 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-3, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-6, 5)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{6}{2(1)} = -3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = -3$ ke fungsi untuk mencari ordinat titik puncak ($y_p$)**" },
        { "tipe": "formula_block", "latex": "y_p = (-3)^2 + 6(-3) + 5 = 9 - 18 + 5 = -4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, titik puncak grafik tersebut adalah **$(-3, -4)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x - 12 = 0$, nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 4x - 12 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-4}{1} = 4 \\Rightarrow \\alpha\\beta = \\dfrac{-12}{1} = -12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\alpha^2 + \\beta^2$ dengan identitas $(\\alpha + \\beta)^2 - 2\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\alpha^2 + \\beta^2 = 4^2 - 2(-12) = 16 + 24 = 40" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^2 + \\beta^2$ adalah **$40$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar $x^2 - 6x + k = 0$ memiliki akar-akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k < 9$" } ],
        [ { "tipe": "paragraph", "text": "$k > 9$" } ],
        [ { "tipe": "paragraph", "text": "$k = 9$" } ],
        [ { "tipe": "paragraph", "text": "$k \\leq 9$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq 9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat dua akar real berbeda yaitu $D > 0$**" },
        { "tipe": "formula_block", "latex": "D = (-6)^2 - 4(1)(k) > 0 \\Rightarrow 36 - 4k > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan untuk mencari batas nilai $k$**" },
        { "tipe": "formula_block", "latex": "-4k > -36 \\Rightarrow k < 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ yang memenuhi adalah **$k < 9$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-4$ dan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 7x + 12 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah dan hasil kali akar-akar ($x_1 = -4$ dan $x_2 = 3$)**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -4 + 3 = -1 \\Rightarrow x_1 \\cdot x_2 = (-4)(3) = -12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat dengan rumus $x^2 - (x_1 + x_2)x + x_1 x_2 = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - (-1)x + (-12) = 0 \\Rightarrow x^2 + x - 12 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat yang dimaksud adalah **$x^2 + x - 12 = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = x^2 - 10x + 30$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-10}{2(1)} = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 5$ ke fungsi untuk mencari nilai minimum ($y_{\\min}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\min} = (5)^2 - 10(5) + 30 = 25 - 50 + 30 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum fungsi tersebut adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 2x - 15 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -5$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pertidaksamaan kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 15 \\leq 0 \\Rightarrow (x + 3)(x - 5) \\leq 0 \\Rightarrow x = -3 \\Rightarrow \\text{atau} \\Rightarrow x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($\\leq 0$)**" },
        { "tipe": "formula_block", "latex": "-3 \\leq x \\leq 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-3 \\leq x \\leq 5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 6x + 8$, nilai $f(1) + f(5)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai $f(1)$ dan $f(5)$**" },
        { "tipe": "formula_block", "latex": "f(1) = (1)^2 - 6(1) + 8 = 1 - 6 + 8 = 3" },
        { "tipe": "formula_block", "latex": "f(5) = (5)^2 - 6(5) + 8 = 25 - 30 + 8 = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan kedua nilai tersebut**" },
        { "tipe": "formula_block", "latex": "f(1) + f(5) = 3 + 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(1) + f(5)$ adalah **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika grafik $y = x^2 - 6x + c$ melalui titik $(1, 5)$, nilai $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan koordinat titik $(1, 5)$ ke persamaan grafik**" },
        { "tipe": "formula_block", "latex": "5 = (1)^2 - 6(1) + c \\Rightarrow 5 = -5 + c" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $c$**" },
        { "tipe": "formula_block", "latex": "c = 5 + 5 = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $c$ adalah **$10$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 2 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 6x + 2 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-6}{1} = 6 \\Rightarrow \\alpha\\beta = \\dfrac{2}{1} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan nyatakan dalam $(\\alpha + \\beta)^2 - 2\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{(\\alpha + \\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diperoleh**" },
        { "tipe": "formula_block", "latex": "\\dfrac{6^2 - 2(2)}{2} = \\dfrac{36 - 4}{2} = 16" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah **$16$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
