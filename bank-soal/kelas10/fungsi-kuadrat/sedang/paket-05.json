{
  "id": "bs-k10-fk-s-05",
  "nama": "Bank Soal Sedang - Paket 5",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran tentang fungsi kuadrat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 6x + 5$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(-5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(-5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(3, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 1)(x - 5) = 0$" },
        { "tipe": "paragraph", "text": "Titik potong: $(1, 0)$ dan $(5, 0)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = x^2 + 2x - 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-1, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, -3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{2}{2} = -1$" },
        { "tipe": "paragraph", "text": "$y_p = 1 - 2 - 3 = -4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 3x - 10 = 0$, nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$39$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$59$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 3$; $\\alpha\\beta = -10$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = 9 - 2(-10) = 9 + 20 = 29$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar $x^2 - 4x + k = 0$ memiliki akar-akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k < 4$" } ],
        [ { "tipe": "paragraph", "text": "$k > 4$" } ],
        [ { "tipe": "paragraph", "text": "$k = 4$" } ],
        [ { "tipe": "paragraph", "text": "$k \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D > 0 \\Rightarrow 16 - 4k > 0 \\Rightarrow k < 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-3$ dan $4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 7x + 12 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $= 1$; hasil kali $= -12$" },
        { "tipe": "paragraph", "text": "$x^2 - x - 12 = 0$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = x^2 - 8x + 20$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = 4$" },
        { "tipe": "paragraph", "text": "$y_{min} = 16 - 32 + 20 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3x - 10 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -5$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 2)(x - 5) \\leq 0$" },
        { "tipe": "paragraph", "text": "HP = $-2 \\leq x \\leq 5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 5x + 6$, nilai $f(2) + f(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(2) = 4 - 10 + 6 = 0$" },
        { "tipe": "paragraph", "text": "$f(3) = 9 - 15 + 6 = 0$" },
        { "tipe": "paragraph", "text": "$f(2) + f(3) = 0$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika grafik $y = x^2 - 4x + c$ melalui titik $(1, 3)$, nilai $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $(1, 3)$: $1 - 4 + c = 3 \\Rightarrow c = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x + 1 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 5$; $\\alpha\\beta = 1$" },
        { "tipe": "paragraph", "text": "$\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{(\\alpha+\\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{25 - 2}{1} = 23$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
