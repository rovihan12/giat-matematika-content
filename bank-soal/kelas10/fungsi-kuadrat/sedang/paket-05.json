{
  "id": "bs-k10-fk-s-05",
  "nama": "Bank Soal Sedang - Paket 5",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran tentang fungsi kuadrat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Fungsi $f(x) = x^2 - 6x + 5$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(-5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(-5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(3, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan untuk mencari pembuat nol fungsi ($f(x) = 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 6x + 5 = 0 \\Rightarrow (x - 1)(x - 5) = 0 \\Rightarrow x = 1 \\Rightarrow \\text{atau} \\Rightarrow x = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, fungsi memotong sumbu-$x$ di titik **$(1, 0)$ dan $(5, 0)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = x^2 + 2x - 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-1, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, -3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{2}{2(1)} = -1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = -1$ ke fungsi untuk mencari ordinat titik puncak ($y_p$)**" },
        { "tipe": "formula_block", "latex": "y_p = (-1)^2 + 2(-1) - 3 = 1 - 2 - 3 = -4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, titik puncak grafik tersebut adalah **$(-1, -4)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 3x - 10 = 0$, nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$39$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$59$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 3x - 10 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-3}{1} = 3 \\Rightarrow \\alpha\\beta = \\dfrac{-10}{1} = -10" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\alpha^2 + \\beta^2$ dengan identitas $(\\alpha + \\beta)^2 - 2\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\alpha^2 + \\beta^2 = 3^2 - 2(-10) = 9 + 20 = 29" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^2 + \\beta^2$ adalah **$29$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $k$ agar $x^2 - 4x + k = 0$ memiliki akar-akar real berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k < 4$" } ],
        [ { "tipe": "paragraph", "text": "$k > 4$" } ],
        [ { "tipe": "paragraph", "text": "$k = 4$" } ],
        [ { "tipe": "paragraph", "text": "$k \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat dua akar real berbeda yaitu $D > 0$**" },
        { "tipe": "formula_block", "latex": "D = (-4)^2 - 4(1)(k) > 0 \\Rightarrow 16 - 4k > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan untuk mencari batas nilai $k$**" },
        { "tipe": "formula_block", "latex": "-4k > -16 \\Rightarrow k < 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ yang memenuhi adalah **$k < 4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $-3$ dan $4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + x + 12 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 7x + 12 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah dan hasil kali akar-akar ($x_1 = -3$ dan $x_2 = 4$)**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -3 + 4 = 1 \\Rightarrow x_1 \\cdot x_2 = (-3)(4) = -12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat dengan rumus $x^2 - (x_1 + x_2)x + x_1 x_2 = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - (1)x + (-12) = 0 \\Rightarrow x^2 - x - 12 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat yang dimaksud adalah **$x^2 - x - 12 = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum fungsi $y = x^2 - 8x + 20$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-8}{2(1)} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 4$ ke fungsi untuk mencari nilai minimum ($y_{\\min}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\min} = (4)^2 - 8(4) + 20 = 16 - 32 + 20 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum fungsi tersebut adalah **$4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3x - 10 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -5$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pertidaksamaan kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 10 \\leq 0 \\Rightarrow (x + 2)(x - 5) \\leq 0 \\Rightarrow x = -2 \\Rightarrow \\text{atau} \\Rightarrow x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($\\leq 0$)**" },
        { "tipe": "formula_block", "latex": "-2 \\leq x \\leq 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-2 \\leq x \\leq 5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 5x + 6$, nilai $f(2) + f(3)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai $f(2)$ dan $f(3)$**" },
        { "tipe": "formula_block", "latex": "f(2) = (2)^2 - 5(2) + 6 = 4 - 10 + 6 = 0" },
        { "tipe": "formula_block", "latex": "f(3) = (3)^2 - 5(3) + 6 = 9 - 15 + 6 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan kedua nilai tersebut**" },
        { "tipe": "formula_block", "latex": "f(2) + f(3) = 0 + 0 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2) + f(3)$ adalah **$0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika grafik $y = x^2 - 4x + c$ melalui titik $(1, 3)$, nilai $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan koordinat titik $(1, 3)$ ke persamaan grafik**" },
        { "tipe": "formula_block", "latex": "3 = (1)^2 - 4(1) + c \\Rightarrow 3 = -3 + c" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $c$**" },
        { "tipe": "formula_block", "latex": "c = 3 + 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $c$ adalah **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x + 1 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 5x + 1 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-5}{1} = 5 \\Rightarrow \\alpha\\beta = \\dfrac{1}{1} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan nyatakan dalam $(\\alpha + \\beta)^2 - 2\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{(\\alpha + \\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diperoleh**" },
        { "tipe": "formula_block", "latex": "\\dfrac{5^2 - 2(1)}{1} = \\dfrac{25 - 2}{1} = 23" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah **$23$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
