{
  "id": "bs-k10-fk-s-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang hubungan akar dan koefisien fungsi kuadrat",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - 7x + 10 = 0$ memiliki akar $\\alpha$ dan $\\beta$ dengan $\\alpha > \\beta$, nilai $\\alpha - \\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan untuk menentukan $\\alpha$ dan $\\beta$ ($\\alpha > \\beta$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 7x + 10 = 0 \\Rightarrow (x - 5)(x - 2) = 0 \\Rightarrow \\alpha = 5, \\quad \\beta = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $\\alpha - \\beta$**" },
        { "tipe": "formula_block", "latex": "\\alpha - \\beta = 5 - 2 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha - \\beta$ adalah **$3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $2x^2 - 6x + 4 = 0$ adalah $\\alpha$ dan $\\beta$, nilai $\\alpha^2\\beta + \\alpha\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $2x^2 - 6x + 4 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-6}{2} = 3, \\qquad \\alpha\\beta = \\dfrac{4}{2} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk $\\alpha^2\\beta + \\alpha\\beta^2 = \\alpha\\beta(\\alpha + \\beta)$ lalu substitusi**" },
        { "tipe": "formula_block", "latex": "\\alpha^2\\beta + \\alpha\\beta^2 = \\alpha\\beta(\\alpha + \\beta) = 2 \\cdot 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^2\\beta + \\alpha\\beta^2$ adalah **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat dengan akar-akar $\\dfrac{2}{3}$ dan $-\\dfrac{1}{2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6x^2 - x - 2 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$6x^2 + x - 2 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$6x^2 - x + 2 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x - 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$6x^2 + x + 2 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah dan hasil kali akar-akar**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{3} + \\left(-\\dfrac{1}{2}\\right) = \\dfrac{4 - 3}{6} = \\dfrac{1}{6}, \\qquad \\dfrac{2}{3} \\cdot \\left(-\\dfrac{1}{2}\\right) = -\\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat dan kalikan kedua ruas dengan $6$**" },
        { "tipe": "formula_block", "latex": "x^2 - \\dfrac{1}{6}x - \\dfrac{1}{3} = 0 \\Rightarrow 6x^2 - x - 2 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat yang dimaksud adalah **$6x^2 - x - 2 = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika salah satu akar $x^2 + (a-2)x - 6 = 0$ adalah $2$, maka nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 2$ ke persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(2)^2 + (a - 2)(2) - 6 = 0 \\Rightarrow 4 + 2a - 4 - 6 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $a$**" },
        { "tipe": "formula_block", "latex": "2a - 6 = 0 \\Rightarrow 2a = 6 \\Rightarrow a = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ adalah **$3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 4x + 2 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 4x + 2 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-4}{1} = 4, \\qquad \\alpha\\beta = \\dfrac{2}{1} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\alpha^3 + \\beta^3$ menggunakan identitas $(\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)$**" },
        { "tipe": "formula_block", "latex": "\\alpha^3 + \\beta^3 = 4^3 - 3(2)(4) = 64 - 24 = 40" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^3 + \\beta^3$ adalah **$40$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 3x - 4 = 0$ adalah $\\alpha$ dan $\\beta$, persamaan kuadrat baru yang akar-akarnya $\\alpha + 1$ dan $\\beta + 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 5x = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 5x + 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 5x - 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x - 4 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 5x + 4 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari persamaan awal $x^2 - 3x - 4 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = 3, \\qquad \\alpha\\beta = -4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar baru $(\\alpha + 1)$ dan $(\\beta + 1)$**" },
        { "tipe": "formula_block", "latex": "(\\alpha + 1) + (\\beta + 1) = (\\alpha + \\beta) + 2 = 3 + 2 = 5" },
        { "tipe": "formula_block", "latex": "(\\alpha + 1)(\\beta + 1) = \\alpha\\beta + (\\alpha + \\beta) + 1 = -4 + 3 + 1 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru**" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 0 = 0 \\Rightarrow x^2 - 5x = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat baru tersebut adalah **$x^2 - 5x = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = -2x^2 + 4x + 1$ memiliki nilai maksimum..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{4}{2(-2)} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 1$ ke fungsi untuk mencari nilai maksimum ($y_{\\max}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\max} = -2(1)^2 + 4(1) + 1 = -2 + 4 + 1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai maksimum fungsi tersebut adalah **$3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar persamaan $x^2 - (p+3)x + 8 = 0$ adalah 2. Nilai $p$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 2$ ke persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(2)^2 - (p + 3)(2) + 8 = 0 \\Rightarrow 12 - 2p - 6 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $p$**" },
        { "tipe": "formula_block", "latex": "6 - 2p = 0 \\Rightarrow 2p = 6 \\Rightarrow p = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $p$ adalah **$3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 4x + 3$, nilai $f(x) = 0$ dipenuhi oleh $x = ...$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $-3$" } ],
        [ { "tipe": "paragraph", "text": "$1$ atau $-3$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$2$ atau $3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan $f(x) = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - 4x + 3 = 0 \\Rightarrow (x - 1)(x - 3) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ dari setiap faktor**" },
        { "tipe": "formula_block", "latex": "x - 1 = 0 \\Rightarrow x = 1 \\qquad \\text{atau} \\qquad x - 3 = 0 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$1$ atau $3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $3x^2 - 12x + 5 = 0$, nilai $x_1 + x_2 + x_1 x_2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{19}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $x_1 + x_2$ dan $x_1 x_2$ dari $3x^2 - 12x + 5 = 0$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{-12}{3} = 4, \\qquad x_1 x_2 = \\dfrac{5}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x_1 + x_2 + x_1 x_2$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 + x_1 x_2 = 4 + \\dfrac{5}{3} = \\dfrac{12 + 5}{3} = \\dfrac{17}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1 + x_2 + x_1 x_2$ adalah **$\\dfrac{17}{3}$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
