{
  "id": "bs-k10-fk-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang fungsi kuadrat dan grafiknya",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 2x - 8$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(-4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(-4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(8, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan untuk mencari pembuat nol fungsi ($y = 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 8 = 0 \\Rightarrow (x + 2)(x - 4) = 0 \\Rightarrow x = -2 \\text{ atau } x = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, grafik memotong sumbu-$x$ di titik **$(-2, 0)$ dan $(4, 0)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = 2x^2 - 8x + 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-8}{2(2)} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke fungsi untuk mencari ordinat titik puncak ($y_p$)**" },
        { "tipe": "formula_block", "latex": "y_p = 2(2)^2 - 8(2) + 3 = 8 - 16 + 3 = -5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, titik puncak grafik tersebut adalah **$(2, -5)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika grafik $y = ax^2 + bx + c$ melalui titik $(0, 6)$, $(1, 3)$, dan $(2, 2)$, maka nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan titik $(0, 6)$ untuk memperoleh nilai $c$**" },
        { "tipe": "formula_block", "latex": "6 = a(0)^2 + b(0) + c \\Rightarrow c = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan titik $(1, 3)$ dan $(2, 2)$ untuk membentuk sistem persamaan**" },
        { "tipe": "formula_block", "latex": "a + b + 6 = 3 \\Rightarrow a + b = -3" },
        { "tipe": "formula_block", "latex": "4a + 2b + 6 = 2 \\Rightarrow 2a + b = -2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Eliminasi $b$ dengan mengurangkan persamaan kedua oleh persamaan pertama**" },
        { "tipe": "formula_block", "latex": "(2a + b) - (a + b) = -2 - (-3) \\Rightarrow a = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ adalah **$1$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $2x^2 - 5x + 1 = 0$, nilai $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $x_1 + x_2$ dan $x_1 x_2$ dari $2x^2 - 5x + 1 = 0$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{-5}{2} = \\dfrac{5}{2}, \\qquad x_1 x_2 = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ menggunakan rumus $\\dfrac{x_1 + x_2}{x_1 x_2}$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{x_1} + \\dfrac{1}{x_2} = \\dfrac{x_1 + x_2}{x_1 x_2} = \\dfrac{5/2}{1/2} = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^2 + 4x - 5$ memotong sumbu-$y$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 0$ ke persamaan grafik**" },
        { "tipe": "formula_block", "latex": "y = (0)^2 + 4(0) - 5 = -5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, grafik memotong sumbu-$y$ di titik **$(0, -5)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 4 = 0$, nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 6x + 4 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-6}{1} = 6, \\qquad \\alpha\\beta = \\dfrac{4}{1} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\alpha^2 + \\beta^2$ dengan identitas $(\\alpha + \\beta)^2 - 2\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = 6^2 - 2(4) = 36 - 8 = 28" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^2 + \\beta^2$ adalah **$28$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -x^2 + 6x - 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{6}{2(-1)} = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 3$ ke fungsi untuk mencari nilai maksimum ($y_{\\max}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\max} = -(3)^2 + 6(3) - 4 = -9 + 18 - 4 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai maksimum fungsi tersebut adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $2 + \\sqrt{3}$ dan $2 - \\sqrt{3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 4x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x - 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 2x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 3 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah dan hasil kali kedua akar**" },
        { "tipe": "formula_block", "latex": "(2 + \\sqrt{3}) + (2 - \\sqrt{3}) = 4, \\qquad (2 + \\sqrt{3})(2 - \\sqrt{3}) = 2^2 - (\\sqrt{3})^2 = 4 - 3 = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat dengan rumus $x^2 - (x_1 + x_2)x + x_1 x_2 = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - 4x + 1 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat yang dimaksud adalah **$x^2 - 4x + 1 = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 - (m - 1)x + 4 = 0$ memiliki akar kembar, nilai $m$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar kembar yaitu $D = 0$**" },
        { "tipe": "formula_block", "latex": "D = (-(m - 1))^2 - 4(1)(4) = 0 \\Rightarrow (m - 1)^2 - 16 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $m$ positif**" },
        { "tipe": "formula_block", "latex": "(m - 1)^2 = 16 \\Rightarrow m - 1 = \\pm 4 \\Rightarrow m = 5 \\text{ atau } m = -3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ positif yang memenuhi adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 3x - 4$ memiliki sumbu simetri..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien $a = 1$ dan $b = -3$**" },
        { "tipe": "paragraph", "text": "Gunakan rumus sumbu simetri $x = -\\dfrac{b}{2a}$." },
        { "tipe": "formula_block", "latex": "x = -\\dfrac{-3}{2(1)} = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan sumbu simetri grafik tersebut adalah **$x = \\dfrac{3}{2}$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
