{
  "id": "bs-k10-fk-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang fungsi kuadrat dan grafiknya",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 2x - 8$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(-4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(-4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(4, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-1, 0)$ dan $(8, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + 2)(x - 4) = 0$" },
        { "tipe": "paragraph", "text": "$x = -2$ atau $x = 4$." },
        { "tipe": "paragraph", "text": "Titik potong: $(-2, 0)$ dan $(4, 0)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = 2x^2 - 8x + 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-8}{4} = 2$" },
        { "tipe": "paragraph", "text": "$y_p = 2(4) - 8(2) + 3 = 8 - 16 + 3 = -5$" },
        { "tipe": "paragraph", "text": "Titik puncak: $(2, -5)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika grafik $y = ax^2 + bx + c$ melalui titik $(0, 6)$, $(1, 3)$, dan $(2, 2)$, maka nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $(0, 6)$: $c = 6$." },
        { "tipe": "paragraph", "text": "Substitusi $(1, 3)$: $a + b + 6 = 3 \\Rightarrow a + b = -3$" },
        { "tipe": "paragraph", "text": "Substitusi $(2, 2)$: $4a + 2b + 6 = 2 \\Rightarrow 4a + 2b = -4 \\Rightarrow 2a + b = -2$" },
        { "tipe": "paragraph", "text": "Kurangkan: $a = 1$, lalu $b = -4$." },
        { "tipe": "paragraph", "text": "Cek: $y = x^2 - 4x + 6$ → titik $(2, 2)$ ✓" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $2x^2 - 5x + 1 = 0$, nilai $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_1 + x_2 = \\dfrac{5}{2}$; $x_1 x_2 = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{x_1} + \\dfrac{1}{x_2} = \\dfrac{x_1 + x_2}{x_1 x_2} = \\dfrac{5/2}{1/2} = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^2 + 4x - 5$ memotong sumbu-$y$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -4)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 0$: $y = -5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 6x + 4 = 0$, nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = 6$; $\\alpha \\beta = 4$" },
        { "tipe": "paragraph", "text": "$\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = 36 - 8 = 28$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -x^2 + 6x - 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{6}{-2} = 3$" },
        { "tipe": "paragraph", "text": "$y_{max} = -(9) + 18 - 4 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $2 + \\sqrt{3}$ dan $2 - \\sqrt{3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 4x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x - 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 2x + 1 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 3 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah: $(2 + \\sqrt{3}) + (2 - \\sqrt{3}) = 4$" },
        { "tipe": "paragraph", "text": "Hasil kali: $(2)^2 - (\\sqrt{3})^2 = 4 - 3 = 1$" },
        { "tipe": "paragraph", "text": "Persamaan: $x^2 - 4x + 1 = 0$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 - (m - 1)x + 4 = 0$ memiliki akar kembar, nilai $m$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$D = 0 \\Rightarrow (m-1)^2 - 16 = 0$" },
        { "tipe": "paragraph", "text": "$(m-1)^2 = 16 \\Rightarrow m - 1 = \\pm 4$" },
        { "tipe": "paragraph", "text": "$m = 5$ atau $m = -3$. Nilai positif = 5." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 3x - 4$ memiliki sumbu simetri..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x = -\\dfrac{b}{2a} = -\\dfrac{-3}{2} = \\dfrac{3}{2}$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
