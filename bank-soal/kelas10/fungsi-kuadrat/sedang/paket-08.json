{
  "id": "bs-k10-fk-s-08",
  "nama": "Bank Soal Sedang - Paket 8",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang hubungan akar dan koefisien fungsi kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 - 8x + 12 = 0$ memiliki akar $\\alpha$ dan $\\beta$ dengan $\\alpha > \\beta$, nilai $\\alpha - \\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan untuk menentukan $\\alpha$ dan $\\beta$ ($\\alpha > \\beta$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 8x + 12 = 0 \\Rightarrow (x - 6)(x - 2) = 0 \\Rightarrow \\alpha = 6 \\Rightarrow \\beta = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $\\alpha - \\beta$**" },
        { "tipe": "formula_block", "latex": "\\alpha - \\beta = 6 - 2 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha - \\beta$ adalah **$4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $3x^2 - 9x + 6 = 0$ adalah $\\alpha$ dan $\\beta$, nilai $\\alpha^2\\beta + \\alpha\\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $3x^2 - 9x + 6 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-9}{3} = 3 \\Rightarrow \\alpha\\beta = \\dfrac{6}{3} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk $\\alpha^2\\beta + \\alpha\\beta^2 = \\alpha\\beta(\\alpha + \\beta)$ lalu substitusi**" },
        { "tipe": "formula_block", "latex": "\\alpha^2\\beta + \\alpha\\beta^2 = \\alpha\\beta(\\alpha + \\beta) = 2 \\cdot 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^2\\beta + \\alpha\\beta^2$ adalah **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat dengan akar-akar $\\dfrac{3}{4}$ dan $-\\dfrac{2}{3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12x^2 - x - 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$12x^2 + x - 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$12x^2 - x + 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - x - 6 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$12x^2 + x + 6 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah dan hasil kali akar-akar**" },
        { "tipe": "formula_block", "latex": "\\dfrac{3}{4} + \\left(-\\dfrac{2}{3}\\right) = \\dfrac{9 - 8}{12} = \\dfrac{1}{12} \\Rightarrow \\dfrac{3}{4} \\cdot \\left(-\\dfrac{2}{3}\\right) = -\\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat dan kalikan kedua ruas dengan $12$**" },
        { "tipe": "formula_block", "latex": "x^2 - \\dfrac{1}{12}x - \\dfrac{1}{2} = 0 \\Rightarrow 12x^2 - x - 6 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat yang dimaksud adalah **$12x^2 - x - 6 = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika salah satu akar $x^2 + (a-3)x - 10 = 0$ adalah $2$, maka nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 2$ ke persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(2)^2 + (a - 3)(2) - 10 = 0 \\Rightarrow 4 + 2a - 6 - 10 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $a$**" },
        { "tipe": "formula_block", "latex": "2a - 12 = 0 \\Rightarrow 2a = 12 \\Rightarrow a = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ adalah **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 5x + 3 = 0$, nilai $\\alpha^3 + \\beta^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$85$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 5x + 3 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-5}{1} = 5 \\Rightarrow \\alpha\\beta = \\dfrac{3}{1} = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\alpha^3 + \\beta^3$ menggunakan identitas $(\\alpha + \\beta)^3 - 3\\alpha\\beta(\\alpha + \\beta)$**" },
        { "tipe": "formula_block", "latex": "\\alpha^3 + \\beta^3 = 5^3 - 3(3)(5) = 125 - 45 = 80" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^3 + \\beta^3$ adalah **$80$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar $x^2 - 4x - 5 = 0$ adalah $\\alpha$ dan $\\beta$, persamaan kuadrat baru yang akar-akarnya $\\alpha + 2$ dan $\\beta + 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 8x + 7 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 8x - 7 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 8x + 7 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 8x + 9 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 4x + 7 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari persamaan awal $x^2 - 4x - 5 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = 4 \\Rightarrow \\alpha\\beta = -5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah dan hasil kali akar baru $(\\alpha + 2)$ dan $(\\beta + 2)$**" },
        { "tipe": "formula_block", "latex": "(\\alpha + 2) + (\\beta + 2) = (\\alpha + \\beta) + 4 = 4 + 4 = 8" },
        { "tipe": "formula_block", "latex": "(\\alpha + 2)(\\beta + 2) = \\alpha\\beta + 2(\\alpha + \\beta) + 4 = -5 + 2(4) + 4 = 7" },
        { "tipe": "paragraph", "text": "**Langkah 3: Susun persamaan kuadrat baru**" },
        { "tipe": "formula_block", "latex": "x^2 - 8x + 7 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat baru tersebut adalah **$x^2 - 8x + 7 = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = -3x^2 + 12x - 5$ memiliki nilai maksimum..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{12}{2(-3)} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke fungsi untuk mencari nilai maksimum ($y_{\\max}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\max} = -3(2)^2 + 12(2) - 5 = -12 + 24 - 5 = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai maksimum fungsi tersebut adalah **$7$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Salah satu akar persamaan $x^2 - (p+2)x + 12 = 0$ adalah 3. Nilai $p$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 3$ ke persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(3)^2 - (p + 2)(3) + 12 = 0 \\Rightarrow 21 - 3p - 6 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $p$**" },
        { "tipe": "formula_block", "latex": "15 - 3p = 0 \\Rightarrow 3p = 15 \\Rightarrow p = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $p$ adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 5x + 4$, nilai $f(x) = 0$ dipenuhi oleh $x = ...$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $-4$" } ],
        [ { "tipe": "paragraph", "text": "$1$ atau $-4$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$2$ atau $4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan $f(x) = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 4 = 0 \\Rightarrow (x - 1)(x - 4) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ dari setiap faktor**" },
        { "tipe": "formula_block", "latex": "x - 1 = 0 \\Rightarrow x = 1 \\Rightarrow \\text{atau} \\Rightarrow x - 4 = 0 \\Rightarrow x = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$1$ atau $4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $4x^2 - 12x + 5 = 0$, nilai $x_1 + x_2 + x_1 x_2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{19}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $x_1 + x_2$ dan $x_1 x_2$ dari $4x^2 - 12x + 5 = 0$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{-12}{4} = 3 \\Rightarrow x_1 x_2 = \\dfrac{5}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x_1 + x_2 + x_1 x_2$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 + x_1 x_2 = 3 + \\dfrac{5}{4} = \\dfrac{12 + 5}{4} = \\dfrac{17}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1 + x_2 + x_1 x_2$ adalah **$\\dfrac{17}{4}$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
