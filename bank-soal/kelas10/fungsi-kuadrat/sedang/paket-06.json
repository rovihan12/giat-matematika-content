{
  "id": "bs-k10-fk-s-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang fungsi kuadrat dan grafiknya (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 7x + 10$ memotong sumbu-$x$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(-5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 0)$ dan $(-5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, 0)$ dan $(5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 0)$ dan $(10, 0)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan untuk mencari pembuat nol fungsi ($y = 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 7x + 10 = 0 \\Rightarrow (x - 2)(x - 5) = 0 \\Rightarrow x = 2 \\text{ atau } x = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, grafik memotong sumbu-$x$ di titik **$(2, 0)$ dan $(5, 0)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Titik puncak grafik $y = 3x^2 - 12x + 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(-2, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, -5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 7)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-12}{2(3)} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke fungsi untuk mencari ordinat titik puncak ($y_p$)**" },
        { "tipe": "formula_block", "latex": "y_p = 3(2)^2 - 12(2) + 7 = 12 - 24 + 7 = -5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, titik puncak grafik tersebut adalah **$(2, -5)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika grafik $y = ax^2 + bx + c$ melalui titik $(0, 4)$, $(1, 1)$, dan $(2, 2)$, maka nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan titik $(0, 4)$ untuk memperoleh nilai $c$**" },
        { "tipe": "formula_block", "latex": "4 = a(0)^2 + b(0) + c \\Rightarrow c = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan titik $(1, 1)$ dan $(2, 2)$ untuk membentuk sistem persamaan**" },
        { "tipe": "formula_block", "latex": "a + b + 4 = 1 \\Rightarrow a + b = -3" },
        { "tipe": "formula_block", "latex": "4a + 2b + 4 = 2 \\Rightarrow 2a + b = -1" },
        { "tipe": "paragraph", "text": "**Langkah 3: Eliminasi $b$ dengan mengurangkan persamaan kedua oleh persamaan pertama**" },
        { "tipe": "formula_block", "latex": "(2a + b) - (a + b) = -1 - (-3) \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ adalah **$2$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ akar-akar $3x^2 - 7x + 2 = 0$, nilai $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $x_1 + x_2$ dan $x_1 x_2$ dari $3x^2 - 7x + 2 = 0$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = -\\dfrac{-7}{3} = \\dfrac{7}{3}, \\qquad x_1 x_2 = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ menggunakan rumus $\\dfrac{x_1 + x_2}{x_1 x_2}$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{x_1} + \\dfrac{1}{x_2} = \\dfrac{x_1 + x_2}{x_1 x_2} = \\dfrac{7/3}{2/3} = \\dfrac{7}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{1}{x_1} + \\dfrac{1}{x_2}$ adalah **$\\dfrac{7}{2}$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^2 - 2x - 15$ memotong sumbu-$y$ di titik..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(0, -15)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 15)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, -2)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 0$ ke persamaan grafik**" },
        { "tipe": "formula_block", "latex": "y = (0)^2 - 2(0) - 15 = -15" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, grafik memotong sumbu-$y$ di titik **$(0, -15)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 - 8x + 12 = 0$, nilai $\\alpha^2 + \\beta^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 - 8x + 12 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -\\dfrac{-8}{1} = 8, \\qquad \\alpha\\beta = \\dfrac{12}{1} = 12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\alpha^2 + \\beta^2$ dengan identitas $(\\alpha + \\beta)^2 - 2\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\alpha^2 + \\beta^2 = (\\alpha + \\beta)^2 - 2\\alpha\\beta = 8^2 - 2(12) = 64 - 24 = 40" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha^2 + \\beta^2$ adalah **$40$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum fungsi $y = -x^2 + 8x - 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{8}{2(-1)} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 4$ ke fungsi untuk mencari nilai maksimum ($y_{\\max}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\max} = -(4)^2 + 8(4) - 10 = -16 + 32 - 10 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai maksimum fungsi tersebut adalah **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat yang akar-akarnya $3 + \\sqrt{2}$ dan $3 - \\sqrt{2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x^2 - 6x + 7 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 + 6x + 7 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 6x - 7 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 3x + 7 = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x^2 - 6x + 9 = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah dan hasil kali kedua akar**" },
        { "tipe": "formula_block", "latex": "(3 + \\sqrt{2}) + (3 - \\sqrt{2}) = 6, \\qquad (3 + \\sqrt{2})(3 - \\sqrt{2}) = 3^2 - (\\sqrt{2})^2 = 9 - 2 = 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat dengan rumus $x^2 - (x_1 + x_2)x + x_1 x_2 = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - 6x + 7 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan kuadrat yang dimaksud adalah **$x^2 - 6x + 7 = 0$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 - (m - 2)x + 9 = 0$ memiliki akar kembar, nilai $m$ positif adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar kembar yaitu $D = 0$**" },
        { "tipe": "formula_block", "latex": "D = (-(m - 2))^2 - 4(1)(9) = 0 \\Rightarrow (m - 2)^2 - 36 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $m$ positif**" },
        { "tipe": "formula_block", "latex": "(m - 2)^2 = 36 \\Rightarrow m - 2 = \\pm 6 \\Rightarrow m = 8 \\text{ atau } m = -4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ positif yang memenuhi adalah **$8$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 5x + 4$ memiliki sumbu simetri..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = -5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi koefisien $a = 1$ dan $b = -5$**" },
        { "tipe": "paragraph", "text": "Gunakan rumus sumbu simetri $x = -\\dfrac{b}{2a}$." },
        { "tipe": "formula_block", "latex": "x = -\\dfrac{-5}{2(1)} = \\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan sumbu simetri grafik tersebut adalah **$x = \\dfrac{5}{2}$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
