{
  "id": "bs-k10-fk-s-07",
  "nama": "Bank Soal Sedang - Paket 7",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang aplikasi fungsi kuadrat dan masalah kontekstual (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dilempar vertikal dengan ketinggian $h(t) = -5t^2 + 30t$ meter. Tinggi maksimum bola adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$ m" } ],
        [ { "tipe": "paragraph", "text": "$45$ m" } ],
        [ { "tipe": "paragraph", "text": "$50$ m" } ],
        [ { "tipe": "paragraph", "text": "$35$ m" } ],
        [ { "tipe": "paragraph", "text": "$30$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$t_p = -\\dfrac{30}{-10} = 3$ detik" },
        { "tipe": "paragraph", "text": "$h_{max} = -5(9) + 30(3) = -45 + 90 = 45$ m" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Keliling persegi panjang 60 cm. Luas maksimumnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$225$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$200$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$250$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$180$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$300$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal panjang $p$, lebar $l$: $2(p + l) = 60 \\Rightarrow p + l = 30$." },
        { "tipe": "paragraph", "text": "$L = p \\cdot l = p(30 - p) = -p^2 + 30p$" },
        { "tipe": "paragraph", "text": "$p_{opt} = -\\dfrac{30}{-2} = 15$; $l = 15$." },
        { "tipe": "paragraph", "text": "$L_{max} = 15 \\cdot 15 = 225$ cm²" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu fungsi keuntungan dinyatakan $P(x) = -x^2 + 12x - 20$ (dalam juta rupiah) dengan $x$ jumlah unit terjual. Keuntungan maksimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$14$ juta" } ],
        [ { "tipe": "paragraph", "text": "$16$ juta" } ],
        [ { "tipe": "paragraph", "text": "$12$ juta" } ],
        [ { "tipe": "paragraph", "text": "$18$ juta" } ],
        [ { "tipe": "paragraph", "text": "$20$ juta" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{12}{-2} = 6$" },
        { "tipe": "paragraph", "text": "$P_{max} = -(36) + 72 - 20 = 16$ juta" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah peluru ditembakkan dengan ketinggian $h(t) = 50t - 5t^2$. Peluru akan kembali ke tanah pada saat $t = ...$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$ detik" } ],
        [ { "tipe": "paragraph", "text": "$10$ detik" } ],
        [ { "tipe": "paragraph", "text": "$12$ detik" } ],
        [ { "tipe": "paragraph", "text": "$5$ detik" } ],
        [ { "tipe": "paragraph", "text": "$15$ detik" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$h(t) = 0 \\Rightarrow 50t - 5t^2 = 0$" },
        { "tipe": "paragraph", "text": "$5t(10 - t) = 0 \\Rightarrow t = 0$ (awal) atau $t = 10$ detik." },
        { "tipe": "paragraph", "text": "Kembali ke tanah pada $t = 10$ detik." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua bilangan jumlahnya 24. Hasil kali maksimumnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$144$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$148$" } ],
        [ { "tipe": "paragraph", "text": "$136$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal bilangan $x$ dan $24 - x$." },
        { "tipe": "paragraph", "text": "$P = x(24 - x) = -x^2 + 24x$" },
        { "tipe": "paragraph", "text": "$x_p = 12$; $P_{max} = 12 \\cdot 12 = 144$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = 3x^2 - 6x + 8$ memiliki nilai minimum..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x_p = -\\dfrac{-6}{6} = 1$" },
        { "tipe": "paragraph", "text": "$y_{min} = 3 - 6 + 8 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat $x^2 - 7x + k = 0$ memiliki akar-akar real jika..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k \\leq \\dfrac{49}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq \\dfrac{49}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\leq \\dfrac{7}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq \\dfrac{7}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\dfrac{49}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Akar real: $D \\geq 0$" },
        { "tipe": "paragraph", "text": "$49 - 4k \\geq 0 \\Rightarrow k \\leq \\dfrac{49}{4}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 2x - 8 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\alpha + \\beta = -2$; $\\alpha\\beta = -8$" },
        { "tipe": "paragraph", "text": "$\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{(\\alpha+\\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta} = \\dfrac{4 + 16}{-8} = -\\dfrac{20}{8} = -\\dfrac{5}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 6x + m$ menyinggung sumbu-$x$. Nilai $m$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Menyinggung: $D = 0$" },
        { "tipe": "paragraph", "text": "$36 - 4m = 0 \\Rightarrow m = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^2 + bx + c$ memiliki titik puncak $(2, -9)$. Nilai $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik puncak $(2, -9)$: $-\\dfrac{b}{2} = 2 \\Rightarrow b = -4$" },
        { "tipe": "paragraph", "text": "Substitusi $(2, -9)$: $4 - 8 + c = -9 \\Rightarrow c = -5$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
