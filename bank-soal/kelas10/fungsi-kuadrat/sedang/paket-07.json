{
  "id": "bs-k10-fk-s-07",
  "nama": "Bank Soal Sedang - Paket 7",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang aplikasi fungsi kuadrat dan masalah kontekstual (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dilempar vertikal dengan ketinggian $h(t) = -5t^2 + 30t$ meter. Tinggi maksimum bola adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$ m" } ],
        [ { "tipe": "paragraph", "text": "$45$ m" } ],
        [ { "tipe": "paragraph", "text": "$50$ m" } ],
        [ { "tipe": "paragraph", "text": "$35$ m" } ],
        [ { "tipe": "paragraph", "text": "$30$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung waktu mencapai titik puncak ($t_p$) menggunakan $t_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "t_p = -\\dfrac{30}{2(-5)} = 3 \\text{ detik}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $t = 3$ ke $h(t)$ untuk mencari tinggi maksimum ($h_{\\max}$)**" },
        { "tipe": "formula_block", "latex": "h_{\\max} = -5(3)^2 + 30(3) = -45 + 90 = 45 \\text{ m}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, tinggi maksimum bola adalah **$45$ m**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Keliling persegi panjang 60 cm. Luas maksimumnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$225$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$200$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$250$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$180$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$300$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan lebar dalam panjang dari keliling $2(p + l) = 60$**" },
        { "tipe": "formula_block", "latex": "p + l = 30 \\Rightarrow l = 30 - p" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun fungsi luas $L(p)$ dan cari nilai maksimumnya**" },
        { "tipe": "formula_block", "latex": "L(p) = p(30 - p) = -p^2 + 30p" },
        { "tipe": "formula_block", "latex": "p_{\\text{opt}} = -\\dfrac{30}{2(-1)} = 15 \\Rightarrow L_{\\max} = 15(30 - 15) = 225 \\text{ cm}^2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas maksimum persegi panjang tersebut adalah **$225$ cm²**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu fungsi keuntungan dinyatakan $P(x) = -x^2 + 12x - 20$ (dalam juta rupiah) dengan $x$ jumlah unit terjual. Keuntungan maksimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$14$ juta" } ],
        [ { "tipe": "paragraph", "text": "$16$ juta" } ],
        [ { "tipe": "paragraph", "text": "$12$ juta" } ],
        [ { "tipe": "paragraph", "text": "$18$ juta" } ],
        [ { "tipe": "paragraph", "text": "$20$ juta" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah unit ($x_p$) untuk keuntungan maksimum dengan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{12}{2(-1)} = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 6$ ke fungsi keuntungan $P(x)$**" },
        { "tipe": "formula_block", "latex": "P_{\\max} = -(6)^2 + 12(6) - 20 = -36 + 72 - 20 = 16 \\text{ juta rupiah}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, keuntungan maksimum adalah **$16$ juta**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah peluru ditembakkan dengan ketinggian $h(t) = 50t - 5t^2$. Peluru akan kembali ke tanah pada saat $t = ...$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$ detik" } ],
        [ { "tipe": "paragraph", "text": "$10$ detik" } ],
        [ { "tipe": "paragraph", "text": "$12$ detik" } ],
        [ { "tipe": "paragraph", "text": "$5$ detik" } ],
        [ { "tipe": "paragraph", "text": "$15$ detik" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Set ketinggian $h(t) = 0$ dan faktorkan persamaannya**" },
        { "tipe": "formula_block", "latex": "50t - 5t^2 = 0 \\Rightarrow 5t(10 - t) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $t$ dari setiap faktor**" },
        { "tipe": "formula_block", "latex": "t = 0 \\text{ (saat ditembakkan)} \\qquad \\text{atau} \\qquad 10 - t = 0 \\Rightarrow t = 10 \\text{ detik}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, peluru kembali ke tanah pada saat **$10$ detik**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua bilangan jumlahnya 24. Hasil kali maksimumnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$144$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$148$" } ],
        [ { "tipe": "paragraph", "text": "$136$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan kedua bilangan adalah $x$ dan $24 - x$, lalu susun fungsi hasil kali $P(x)$**" },
        { "tipe": "formula_block", "latex": "P(x) = x(24 - x) = -x^2 + 24x" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari nilai $x$ puncak dan hitung hasil kali maksimumnya**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{24}{2(-1)} = 12 \\Rightarrow P_{\\max} = 12(24 - 12) = 144" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil kali maksimum kedua bilangan tersebut adalah **$144$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = 3x^2 - 6x + 8$ memiliki nilai minimum..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-6}{2(3)} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 1$ ke fungsi untuk mencari nilai minimum ($y_{\\min}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\min} = 3(1)^2 - 6(1) + 8 = 3 - 6 + 8 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum fungsi tersebut adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat $x^2 - 7x + k = 0$ memiliki akar-akar real jika..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k \\leq \\dfrac{49}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq \\dfrac{49}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\leq \\dfrac{7}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq \\dfrac{7}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\dfrac{49}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar-akar real yaitu $D \\geq 0$**" },
        { "tipe": "formula_block", "latex": "D = (-7)^2 - 4(1)(k) \\geq 0 \\Rightarrow 49 - 4k \\geq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan untuk mencari batas nilai $k$**" },
        { "tipe": "formula_block", "latex": "-4k \\geq -49 \\Rightarrow k \\leq \\dfrac{49}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan memiliki akar-akar real jika **$k \\leq \\dfrac{49}{4}$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 2x - 8 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 + 2x - 8 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -2, \\qquad \\alpha\\beta = -8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan nyatakan dalam $(\\alpha + \\beta)^2 - 2\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{(\\alpha + \\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diperoleh**" },
        { "tipe": "formula_block", "latex": "\\dfrac{(-2)^2 - 2(-8)}{-8} = \\dfrac{4 + 16}{-8} = -\\dfrac{20}{8} = -\\dfrac{5}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah **$-\\dfrac{5}{2}$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 6x + m$ menyinggung sumbu-$x$. Nilai $m$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat menyinggung sumbu-$x$ yaitu $D = 0$**" },
        { "tipe": "formula_block", "latex": "D = (-6)^2 - 4(1)(m) = 0 \\Rightarrow 36 - 4m = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $m$**" },
        { "tipe": "formula_block", "latex": "4m = 36 \\Rightarrow m = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ adalah **$9$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^2 + bx + c$ memiliki titik puncak $(2, -9)$. Nilai $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$-7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan absis titik puncak $x_p = 2$ untuk mencari nilai $b$**" },
        { "tipe": "formula_block", "latex": "-\\dfrac{b}{2(1)} = 2 \\Rightarrow -b = 4 \\Rightarrow b = -4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan titik puncak $(2, -9)$ dan $b = -4$ ke persamaan fungsi**" },
        { "tipe": "formula_block", "latex": "-9 = (2)^2 + (-4)(2) + c \\Rightarrow -9 = 4 - 8 + c \\Rightarrow c = -5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $c$ adalah **$-5$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
