        [ { "tipe": "paragraph", "text": "$2 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq -2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pertidaksamaan kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 6 \\leq 0 \\Rightarrow (x - 2)(x - 3) \\leq 0 \\Rightarrow x = 2 \\Rightarrow \\text{atau} \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($\\leq 0$)**" },
        { "tipe": "formula_block", "latex": "2 \\leq x \\leq 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$2 \\leq x \\leq 3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
