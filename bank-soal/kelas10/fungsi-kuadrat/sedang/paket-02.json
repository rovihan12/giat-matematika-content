{
  "id": "bs-k10-fk-s-02",
  "nama": "Bank Soal Sedang - Paket 2",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang aplikasi fungsi kuadrat dan masalah kontekstual",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dilempar vertikal dengan ketinggian $h(t) = -5t^2 + 20t$ meter. Tinggi maksimum bola adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$ m" } ],
        [ { "tipe": "paragraph", "text": "$20$ m" } ],
        [ { "tipe": "paragraph", "text": "$25$ m" } ],
        [ { "tipe": "paragraph", "text": "$30$ m" } ],
        [ { "tipe": "paragraph", "text": "$35$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung waktu mencapai titik puncak ($t_p$) menggunakan $t_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "t_p = -\\dfrac{20}{2(-5)} = 2 \\text{ detik}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $t = 2$ ke $h(t)$ untuk mencari tinggi maksimum ($h_{\\max}$)**" },
        { "tipe": "formula_block", "latex": "h_{\\max} = -5(2)^2 + 20(2) = -20 + 40 = 20 \\text{ m}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, tinggi maksimum bola adalah **$20$ m**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Keliling persegi panjang 40 cm. Luas maksimumnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$100$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$120$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$140$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$160$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$200$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan lebar dalam panjang dari keliling $2(p + l) = 40$**" },
        { "tipe": "formula_block", "latex": "p + l = 20 \\Rightarrow l = 20 - p" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun fungsi luas $L(p)$ dan cari nilai maksimumnya**" },
        { "tipe": "formula_block", "latex": "L(p) = p(20 - p) = -p^2 + 20p" },
        { "tipe": "formula_block", "latex": "p_{\\text{opt}} = -\\dfrac{20}{2(-1)} = 10 \\Rightarrow L_{\\max} = 10(20 - 10) = 100 \\text{ cm}^2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas maksimum persegi panjang tersebut adalah **$100$ cm²**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu fungsi keuntungan dinyatakan $P(x) = -x^2 + 10x - 16$ (dalam juta rupiah) dengan $x$ jumlah unit terjual. Keuntungan maksimum adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$ juta" } ],
        [ { "tipe": "paragraph", "text": "$8$ juta" } ],
        [ { "tipe": "paragraph", "text": "$9$ juta" } ],
        [ { "tipe": "paragraph", "text": "$10$ juta" } ],
        [ { "tipe": "paragraph", "text": "$11$ juta" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah unit ($x_p$) untuk keuntungan maksimum dengan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{10}{2(-1)} = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 5$ ke fungsi keuntungan $P(x)$**" },
        { "tipe": "formula_block", "latex": "P_{\\max} = -(5)^2 + 10(5) - 16 = -25 + 50 - 16 = 9 \\text{ juta rupiah}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, keuntungan maksimum adalah **$9$ juta**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah peluru ditembakkan dengan ketinggian $h(t) = 40t - 5t^2$. Peluru akan kembali ke tanah pada saat $t = ...$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ detik" } ],
        [ { "tipe": "paragraph", "text": "$6$ detik" } ],
        [ { "tipe": "paragraph", "text": "$8$ detik" } ],
        [ { "tipe": "paragraph", "text": "$10$ detik" } ],
        [ { "tipe": "paragraph", "text": "$12$ detik" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Set ketinggian $h(t) = 0$ dan faktorkan persamaannya**" },
        { "tipe": "formula_block", "latex": "40t - 5t^2 = 0 \\Rightarrow 5t(8 - t) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $t$ dari setiap faktor**" },
        { "tipe": "formula_block", "latex": "t = 0 \\text{ (saat ditembakkan)} \\Rightarrow \\text{atau} \\Rightarrow 8 - t = 0 \\Rightarrow t = 8 \\text{ detik}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, peluru kembali ke tanah pada saat **$8$ detik**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua bilangan jumlahnya 20. Hasil kali maksimumnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$90$" } ],
        [ { "tipe": "paragraph", "text": "$95$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan kedua bilangan adalah $x$ dan $20 - x$, lalu susun fungsi hasil kali $P(x)$**" },
        { "tipe": "formula_block", "latex": "P(x) = x(20 - x) = -x^2 + 20x" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari nilai $x$ puncak dan hitung hasil kali maksimumnya**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{20}{2(-1)} = 10 \\Rightarrow P_{\\max} = 10(20 - 10) = 100" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hasil kali maksimum kedua bilangan tersebut adalah **$100$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = 2x^2 - 4x + 5$ memiliki nilai minimum..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung absis titik puncak ($x_p$) menggunakan $x_p = -\\dfrac{b}{2a}$**" },
        { "tipe": "formula_block", "latex": "x_p = -\\dfrac{-4}{2(2)} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 1$ ke fungsi untuk mencari nilai minimum ($y_{\\min}$)**" },
        { "tipe": "formula_block", "latex": "y_{\\min} = 2(1)^2 - 4(1) + 5 = 2 - 4 + 5 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum fungsi tersebut adalah **$3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan kuadrat $x^2 - 5x + k = 0$ memiliki akar-akar real jika..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$k \\leq \\dfrac{25}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq \\dfrac{25}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\leq \\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k \\geq \\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$k = \\dfrac{25}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat akar-akar real yaitu $D \\geq 0$**" },
        { "tipe": "formula_block", "latex": "D = (-5)^2 - 4(1)(k) \\geq 0 \\Rightarrow 25 - 4k \\geq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan untuk mencari batas nilai $k$**" },
        { "tipe": "formula_block", "latex": "-4k \\geq -25 \\Rightarrow k \\leq \\dfrac{25}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, persamaan memiliki akar-akar real jika **$k \\leq \\dfrac{25}{4}$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\alpha$ dan $\\beta$ akar-akar $x^2 + 3x - 10 = 0$, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{29}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{10}{29}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{29}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{29}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{29}{100}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\alpha + \\beta$ dan $\\alpha\\beta$ dari $x^2 + 3x - 10 = 0$**" },
        { "tipe": "formula_block", "latex": "\\alpha + \\beta = -3, \\Rightarrow \\alpha\\beta = -10" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan nyatakan dalam $\\alpha + \\beta$ serta $\\alpha\\beta$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha} = \\dfrac{\\alpha^2 + \\beta^2}{\\alpha\\beta} = \\dfrac{(\\alpha + \\beta)^2 - 2\\alpha\\beta}{\\alpha\\beta}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai yang telah diperoleh**" },
        { "tipe": "formula_block", "latex": "\\dfrac{(-3)^2 - 2(-10)}{-10} = \\dfrac{9 + 20}{-10} = -\\dfrac{29}{10}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{\\alpha}{\\beta} + \\dfrac{\\beta}{\\alpha}$ adalah **$-\\dfrac{29}{10}$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik fungsi $y = x^2 - 4x + m$ menyinggung sumbu-$x$. Nilai $m$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat menyinggung sumbu-$x$ yaitu $D = 0$**" },
        { "tipe": "formula_block", "latex": "D = (-4)^2 - 4(1)(m) = 0 \\Rightarrow 16 - 4m = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $m$**" },
        { "tipe": "formula_block", "latex": "4m = 16 \\Rightarrow m = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $m$ adalah **$4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^2 + bx + c$ memiliki titik puncak $(3, -4)$. Nilai $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan absis titik puncak $x_p = 3$ untuk mencari nilai $b$**" },
        { "tipe": "formula_block", "latex": "-\\dfrac{b}{2(1)} = 3 \\Rightarrow -b = 6 \\Rightarrow b = -6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan titik puncak $(3, -4)$ dan $b = -6$ ke persamaan fungsi**" },
        { "tipe": "formula_block", "latex": "-4 = (3)^2 + (-6)(3) + c \\Rightarrow -4 = 9 - 18 + c \\Rightarrow c = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $c$ adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
