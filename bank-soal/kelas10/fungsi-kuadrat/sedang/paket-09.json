        [ { "tipe": "paragraph", "text": "$x < 3$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x - 3)(x - 5) < 0$" },
        { "tipe": "paragraph", "text": "HP = $3 < x < 5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $(x - 2)(x + 4) \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -4$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$-4 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik kritis: $x = 2$ dan $x = -4$." },
