{
  "id": "bs-k10-fk-s-09",
  "nama": "Bank Soal Sedang - Paket 9",
  "kelas": 10,
  "kategori": "Fungsi Kuadrat",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang grafik dan pertidaksamaan kuadrat (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-fk-s-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 3x - 10 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < -2$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > -5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pertidaksamaan kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 10 > 0 \\Rightarrow (x + 2)(x - 5) > 0 \\Rightarrow x = -2 \\text{ atau } x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($> 0$)**" },
        { "tipe": "formula_block", "latex": "x < -2 \\quad \\text{atau} \\quad x > 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x < -2$ atau $x > 5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 7x + 12 \\leq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 3$ atau $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$3 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$-4 \\leq x \\leq -3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pertidaksamaan kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 7x + 12 \\leq 0 \\Rightarrow (x - 3)(x - 4) \\leq 0 \\Rightarrow x = 3 \\text{ atau } x = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($\\leq 0$)**" },
        { "tipe": "formula_block", "latex": "3 \\leq x \\leq 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$3 \\leq x \\leq 4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Grafik $y = x^2 - 4x - 5$ berada di bawah sumbu-$x$ untuk..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < 1$" } ],
        [ { "tipe": "paragraph", "text": "$x < -5$ atau $x > 1$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Syarat grafik berada di bawah sumbu-$x$ adalah $y < 0$, lalu faktorkan**" },
        { "tipe": "formula_block", "latex": "x^2 - 4x - 5 < 0 \\Rightarrow (x + 1)(x - 5) < 0 \\Rightarrow x = -1 \\text{ atau } x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval nilai $x$ yang memenuhi**" },
        { "tipe": "formula_block", "latex": "-1 < x < 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, grafik berada di bawah sumbu-$x$ untuk **$-1 < x < 5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3x^2 - 7x - 6 \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -\\dfrac{2}{3}$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{3} \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $x \\geq \\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq \\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pertidaksamaan kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "3x^2 - 7x - 6 \\geq 0 \\Rightarrow (3x + 2)(x - 3) \\geq 0 \\Rightarrow x = -\\dfrac{2}{3} \\text{ atau } x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($\\geq 0$)**" },
        { "tipe": "formula_block", "latex": "x \\leq -\\dfrac{2}{3} \\quad \\text{atau} \\quad x \\geq 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x \\leq -\\dfrac{2}{3}$ atau $x \\geq 3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 + 6x + 9 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\neq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$" } ],
        [ { "tipe": "paragraph", "text": "Semua $x$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada $x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah ke bentuk kuadrat sempurna**" },
        { "tipe": "formula_block", "latex": "x^2 + 6x + 9 > 0 \\Rightarrow (x + 3)^2 > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Analisis nilai kuadrat suatu bilangan real**" },
        { "tipe": "paragraph", "text": "Bentuk $(x + 3)^2$ selalu bernilai lebih besar dari atau sama dengan $0$ untuk semua $x$ real, dan bernilai tepat $0$ hanya ketika $x = -3$. Karena tanda pertidaksamaan ketat ($> 0$), nilai $x = -3$ tidak termasuk." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x \\neq -3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $x^2 - 9 < 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$-9 < x < 9$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > -3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan selisih dua kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 9 < 0 \\Rightarrow (x - 3)(x + 3) < 0 \\Rightarrow x = -3 \\text{ atau } x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($< 0$)**" },
        { "tipe": "formula_block", "latex": "-3 < x < 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$-3 < x < 3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = x^2 - 3x - 10$, nilai $x$ yang membuat $f(x) = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$ dan $5$" } ],
        [ { "tipe": "paragraph", "text": "$2$ dan $-5$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ dan $-5$" } ],
        [ { "tipe": "paragraph", "text": "$2$ dan $5$" } ],
        [ { "tipe": "paragraph", "text": "$1$ dan $10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan $f(x) = 0$**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 10 = 0 \\Rightarrow (x + 2)(x - 5) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ dari setiap faktor**" },
        { "tipe": "formula_block", "latex": "x + 2 = 0 \\Rightarrow x = -2 \\qquad \\text{atau} \\qquad x - 5 = 0 \\Rightarrow x = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$-2$ dan $5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar $x^2 + (k-2)x + 16 = 0$ tidak memiliki akar real, nilai $k$ yang memenuhi adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6 < k < 10$" } ],
        [ { "tipe": "paragraph", "text": "$k < -6$ atau $k > 10$" } ],
        [ { "tipe": "paragraph", "text": "$-10 < k < 6$" } ],
        [ { "tipe": "paragraph", "text": "$k > 10$" } ],
        [ { "tipe": "paragraph", "text": "$k < -6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan syarat tidak memiliki akar real yaitu $D < 0$**" },
        { "tipe": "formula_block", "latex": "D = (k - 2)^2 - 4(1)(16) < 0 \\Rightarrow (k - 2)^2 - 64 < 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan untuk mencari interval nilai $k$**" },
        { "tipe": "formula_block", "latex": "(k - 2)^2 < 64 \\Rightarrow -8 < k - 2 < 8 \\Rightarrow -6 < k < 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ yang memenuhi adalah **$-6 < k < 10$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $x^2 - 8x + 15 < 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pertidaksamaan kuadrat dan tentukan pembuat nol**" },
        { "tipe": "formula_block", "latex": "x^2 - 8x + 15 < 0 \\Rightarrow (x - 3)(x - 5) < 0 \\Rightarrow x = 3 \\text{ atau } x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($< 0$)**" },
        { "tipe": "formula_block", "latex": "3 < x < 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$3 < x < 5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-fk-s-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $(x - 2)(x + 4) \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -4$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$-4 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan pembuat nol (titik kritis) dari $(x - 2)(x + 4) = 0$**" },
        { "tipe": "formula_block", "latex": "x - 2 = 0 \\Rightarrow x = 2 \\qquad \\text{dan} \\qquad x + 4 = 0 \\Rightarrow x = -4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan interval yang memenuhi tanda pertidaksamaan ($\\geq 0$)**" },
        { "tipe": "formula_block", "latex": "x \\leq -4 \\quad \\text{atau} \\quad x \\geq 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x \\leq -4$ atau $x \\geq 2$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
