{
  "id": "bs-k10-trig-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang identitas trigonometri, persamaan, dan geometri analitik (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos\\dfrac{\\pi}{9} \\cdot \\cos\\dfrac{2\\pi}{9} \\cdot \\cos\\dfrac{4\\pi}{9}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas $\\cos \\theta \\cos 2\\theta \\cos 4\\theta = \\dfrac{\\sin 8\\theta}{8\\sin \\theta}$ untuk $\\theta = \\dfrac{\\pi}{9}$**" },
        { "formula_block", "latex": "\\cos\\dfrac{\\pi}{9} \\cdot \\cos\\dfrac{2\\pi}{9} \\cdot \\cos\\dfrac{4\\pi}{9} = \\dfrac{\\sin\\left(\\frac{8\\pi}{9}\\right)}{8\\sin\\left(\\frac{\\pi}{9}\\right)}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan karena $\\sin\\left(\\dfrac{8\\pi}{9}\\right) = \\sin\\left(\\pi - \\dfrac{\\pi}{9}\\right) = \\sin\\dfrac{\\pi}{9}$**" },
        { "formula_block", "latex": "\\dfrac{\\sin\\left(\\frac{\\pi}{9}\\right)}{8\\sin\\left(\\frac{\\pi}{9}\\right)} = \\dfrac{1}{8}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai perkalian tersebut adalah **$\\dfrac{1}{8}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin x - \\cos x = \\dfrac{1}{3}$, maka nilai $\\sin^3 x - \\cos^3 x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{14}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{27}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas untuk memperoleh nilai $\\sin x \\cos x$**" },
        { "formula_block", "latex": "(\\sin x - \\cos x)^2 = \\left(\\dfrac{1}{3}\\right)^2 \\Rightarrow 1 - 2\\sin x \\cos x = \\dfrac{1}{9} \\Rightarrow \\sin x \\cos x = \\dfrac{4}{9}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jabarkan $\\sin^3 x - \\cos^3 x$ lalu substitusikan nilai yang diketahui**" },
        { "formula_block", "latex": "\\sin^3 x - \\cos^3 x = (\\sin x - \\cos x)(1 + \\sin x \\cos x) = \\dfrac{1}{3}\\left(1 + \\dfrac{4}{9}\\right) = \\dfrac{1}{3} \\cdot \\dfrac{13}{9} = \\dfrac{13}{27}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin^3 x - \\cos^3 x$ adalah **$\\dfrac{13}{27}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\tan^2 x - (1+\\sqrt{3})\\tan x + \\sqrt{3} = 0$ untuk $0° \\le x \\le 180°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{45°, 60°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{45°, 135°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 120°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 60°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 135°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan kuadrat dalam $\\tan x$**" },
        { "formula_block", "latex": "\\tan^2 x - (1 + \\sqrt{3})\\tan x + \\sqrt{3} = 0 \\Rightarrow (\\tan x - 1)(\\tan x - \\sqrt{3}) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ pada interval $0° \\le x \\le 180°$**" },
        { "formula_block", "\\tan x = 1 \\Rightarrow x = 45°; \\qquad \\tan x = \\sqrt{3} \\Rightarrow x = 60°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{45°, 60°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga $ABC$ berikut. Jika $a = 8$ cm, $b = 10$ cm, dan $\\angle C = 120°$, maka panjang sisi $c$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-cos-8-10-120.png",
          "caption": "Segitiga ABC dengan sisi a = 8 cm, b = 10 cm, dan sudut C = 120°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2\\sqrt{61}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{51}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{41}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{31}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{21}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $c^2$ dengan aturan cosinus untuk $a = 8$, $b = 10$, dan $\\angle C = 120°$**" },
        { "formula_block", "latex": "c^2 = 8^2 + 10^2 - 2(8)(10)\\cos 120° = 64 + 100 - 160\\left(-\\dfrac{1}{2}\\right) = 164 + 80 = 244" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan akar kuadratnya untuk memperoleh panjang sisi $c$**" },
        { "formula_block", "latex": "c = \\sqrt{244} = \\sqrt{4 \\times 61} = 2\\sqrt{61}\\text{ cm}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang sisi $c$ adalah **$2\\sqrt{61}$ cm**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 80° - \\sin 20°}{\\cos 80° + \\cos 20°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah pembilang dan penyebut menjadi bentuk perkalian**" },
        { "formula_block", "latex": "\\dfrac{\\sin 80° - \\sin 20°}{\\cos 80° + \\cos 20°} = \\dfrac{2\\cos 50° \\sin 30°}{2\\cos 50° \\cos 30°} = \\dfrac{\\sin 30°}{\\cos 30°}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $\\tan 30°$**" },
        { "formula_block", "latex": "\\tan 30° = \\dfrac{1}{3}\\sqrt{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai pecahan tersebut adalah **$\\dfrac{1}{3}\\sqrt{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan \\alpha$ dan $\\tan \\beta$ adalah akar-akar persamaan $x^2 - 4x + 2 = 0$, maka nilai $\\cos^2(\\alpha + \\beta)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{17}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $\\tan(\\alpha + \\beta)$ dari $\\tan \\alpha + \\tan \\beta = 4$ dan $\\tan \\alpha \\tan \\beta = 2$**" },
        { "formula_block", "latex": "\\tan(\\alpha + \\beta) = \\dfrac{\\tan \\alpha + \\tan \\beta}{1 - \\tan \\alpha \\tan \\beta} = \\dfrac{4}{1 - 2} = -4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\cos^2(\\alpha + \\beta)$ menggunakan identitas $\\cos^2 \\theta = \\dfrac{1}{1 + \\tan^2 \\theta}$**" },
        { "formula_block", "latex": "\\cos^2(\\alpha + \\beta) = \\dfrac{1}{1 + (-4)^2} = \\dfrac{1}{1 + 16} = \\dfrac{1}{17}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos^2(\\alpha + \\beta)$ adalah **$\\dfrac{1}{17}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos^2 10° + \\cos^2 50° + \\cos^2 70°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas $\\cos^2 \\theta = \\dfrac{1 + \\cos 2\\theta}{2}$**" },
        { "formula_block", "latex": "\\cos^2 10° + \\cos^2 50° + \\cos^2 70° = \\dfrac{3}{2} + \\dfrac{1}{2}(\\cos 20° + \\cos 100° + \\cos 140°)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $\\cos 20° + \\cos 100° + \\cos 140° = 0$**" },
        { "formula_block", "latex": "\\dfrac{3}{2} + \\dfrac{1}{2}(0) = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai penjumlahan tersebut adalah **$\\dfrac{3}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\cos 3x = \\cos 60°$ untuk $0° \\le x \\le 180°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{20°, 100°, 140°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{20°, 100°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{20°, 140°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 180°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{20°, 60°, 100°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rumus umum penyelesaian dari $\\cos 3x = \\cos 60°$**" },
        { "formula_block", "latex": "3x = \\pm 60° + k \\cdot 360° \\Rightarrow x = 20° + k \\cdot 120° \\text{ atau } x = -20° + k \\cdot 120°" },
        { "tipe": "paragraph", "text": "**Langkah 2: Pilih nilai $x$ untuk $k \\in \\mathbb{Z}$ pada interval $0° \\le x \\le 180°$**" },
        { "formula_block", "latex": "x = \\{20°, 100°, 140°\\}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{20°, 100°, 140°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai maksimum dari fungsi $f(x) = 5\\sin x - 12\\cos x + 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung nilai maksimum bentuk $5\\sin x - 12\\cos x$ menggunakan $\\sqrt{a^2 + b^2}$**" },
        { "formula_block", "latex": "\\sqrt{5^2 + (-12)^2} = \\sqrt{25 + 144} = \\sqrt{169} = 13" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tambahkan konstanta $+7$ untuk memperoleh nilai maksimum $f(x)$**" },
        { "formula_block", "latex": "f_{\\text{maks}} = 13 + 7 = 20" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai maksimum fungsi tersebut adalah **$20$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan $a = 7$ cm, $b = 8$ cm, dan $c = 9$ cm. Nilai $\\cos(A + B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $\\cos C$ menggunakan aturan cosinus dengan $a = 7$, $b = 8$, dan $c = 9$**" },
        { "formula_block", "latex": "\\cos C = \\dfrac{7^2 + 8^2 - 9^2}{2(7)(8)} = \\dfrac{49 + 64 - 81}{112} = \\dfrac{32}{112} = \\dfrac{2}{7}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan hubungan $A + B = 180° - C$ sehingga $\\cos(A + B) = -\\cos C$**" },
        { "formula_block", "latex": "\\cos(A + B) = -\\cos C = -\\dfrac{2}{7}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos(A + B)$ adalah **$-\\dfrac{2}{7}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
