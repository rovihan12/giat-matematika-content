{
  "id": "bs-k10-trig-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style campuran trigonometri",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^2 1^\\circ + \\sin^2 2^\\circ + \\ldots + \\sin^2 89^\\circ$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$44{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$45{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pasangkan $44$ sudut berpenyiku menggunakan $\\sin^2 \\theta + \\sin^2(90^\\circ - \\theta) = 1$ dan tambahkan $\\sin^2 45^\\circ$**" },
        { "formula_block", "latex": "\\sum_{k=1}^{89} \\sin^2 k^\\circ = 44(1) + \\sin^2 45^\\circ = 44 + \\left(\\dfrac{\\sqrt{2}}{2}\\right)^2 = 44 + 0{,}5 = 44{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai penjumlahan tersebut adalah **$44{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin x - \\cos x = \\dfrac{1}{2}$, maka nilai $\\sin^3 x - \\cos^3 x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas untuk memperoleh nilai $\\sin x \\cos x$**" },
        { "formula_block", "latex": "(\\sin x - \\cos x)^2 = \\left(\\dfrac{1}{2}\\right)^2 \\Rightarrow 1 - 2\\sin x \\cos x = \\dfrac{1}{4} \\Rightarrow \\sin x \\cos x = \\dfrac{3}{8}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan selisih pangkat tiga $\\sin^3 x - \\cos^3 x$ lalu substitusikan nilai yang diketahui**" },
        { "formula_block", "latex": "\\sin^3 x - \\cos^3 x = (\\sin x - \\cos x)(1 + \\sin x \\cos x) = \\dfrac{1}{2}\\left(1 + \\dfrac{3}{8}\\right) = \\dfrac{1}{2} \\cdot \\dfrac{11}{8} = \\dfrac{11}{16}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin^3 x - \\cos^3 x$ adalah **$\\dfrac{11}{16}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 0^\\circ + \\cos 1^\\circ + \\cos 2^\\circ + \\ldots + \\cos 180^\\circ$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pasangkan sudut berpelurus menggunakan $\\cos \\theta + \\cos(180^\\circ - \\theta) = 0$ dan perhatikan $\\cos 90^\\circ = 0$**" },
        { "formula_block", "latex": "(\\cos 0^\\circ + \\cos 180^\\circ) + \\sum_{k=1}^{89} (\\cos k^\\circ + \\cos(180^\\circ - k^\\circ)) + \\cos 90^\\circ = 0 + 0 + 0 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai penjumlahan tersebut adalah **$0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan \\alpha$ dan $\\tan \\beta$ adalah akar-akar persamaan $x^2 - 5x + 6 = 0$, maka nilai $\\tan(\\alpha + \\beta)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\tan \\alpha + \\tan \\beta$ dan $\\tan \\alpha \\tan \\beta$ dari $x^2 - 5x + 6 = 0$**" },
        { "formula_block", "latex": "\\tan \\alpha + \\tan \\beta = 5, \\qquad \\tan \\alpha \\cdot \\tan \\beta = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke rumus $\\tan(\\alpha + \\beta)$**" },
        { "formula_block", "latex": "\\tan(\\alpha + \\beta) = \\dfrac{\\tan \\alpha + \\tan \\beta}{1 - \\tan \\alpha \\tan \\beta} = \\dfrac{5}{1 - 6} = -1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\tan(\\alpha + \\beta)$ adalah **$-1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah segitiga memiliki sisi $a = 5$, $b = 6$, dan $c = 7$. Nilai $\\cos C$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-5-6-7.png",
          "caption": "Segitiga ABC dengan a = BC = 5, b = AC = 6, c = AB = 7 (sisi huruf kecil di hadapan sudut huruf besar).",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{7}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan aturan cosinus untuk sudut $C$ dengan $a = 5$, $b = 6$, dan $c = 7$**" },
        { "formula_block", "latex": "\\cos C = \\dfrac{a^2 + b^2 - c^2}{2ab} = \\dfrac{5^2 + 6^2 - 7^2}{2 \\cdot 5 \\cdot 6} = \\dfrac{25 + 36 - 49}{60} = \\dfrac{12}{60} = \\dfrac{1}{5}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos C$ adalah **$\\dfrac{1}{5}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 3x}{\\sin x} - \\dfrac{\\cos 3x}{\\cos x}$ untuk $x$ sembarang (yang terdefinisi) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan $\\sin 3x$ dan $\\cos 3x$, lalu sederhanakan tiap suku**" },
        { "formula_block", "latex": "\\dfrac{\\sin 3x}{\\sin x} - \\dfrac{\\cos 3x}{\\cos x} = (3 - 4\\sin^2 x) - (4\\cos^2 x - 3) = 6 - 4(\\sin^2 x + \\cos^2 x)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan identitas $\\sin^2 x + \\cos^2 x = 1$**" },
        { "formula_block", "latex": "6 - 4(1) = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ekspresi tersebut adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $2\\sin^2 x + \\sin x - 1 = 0$ untuk $0^\\circ \\leq x \\leq 360^\\circ$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{30^\\circ, 150^\\circ, 270^\\circ\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30^\\circ, 150^\\circ\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{90^\\circ, 270^\\circ\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30^\\circ, 90^\\circ, 150^\\circ, 270^\\circ\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30^\\circ, 270^\\circ\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan kuadrat dalam $\\sin x$**" },
        { "formula_block", "latex": "2\\sin^2 x + \\sin x - 1 = 0 \\Rightarrow (2\\sin x - 1)(\\sin x + 1) = 0 \\Rightarrow \\sin x = \\dfrac{1}{2} \\text{ atau } \\sin x = -1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan semua nilai $x$ pada interval $0^\\circ \\leq x \\leq 360^\\circ$**" },
        { "formula_block", "latex": "\\sin x = \\dfrac{1}{2} \\Rightarrow x = 30^\\circ, 150^\\circ; \\qquad \\sin x = -1 \\Rightarrow x = 270^\\circ" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{30^\\circ, 150^\\circ, 270^\\circ\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{1}{\\sin 10^\\circ} - \\dfrac{\\sqrt{3}}{\\cos 10^\\circ}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Samakan penyebut lalu sederhanakan pembilang dan penyebut**" },
        { "formula_block", "latex": "\\dfrac{\\cos 10^\\circ - \\sqrt{3}\\sin 10^\\circ}{\\sin 10^\\circ \\cos 10^\\circ} = \\dfrac{2\\cos(10^\\circ + 60^\\circ)}{\\frac{1}{2}\\sin 20^\\circ} = \\dfrac{2\\cos 70^\\circ}{\\frac{1}{2}\\sin 20^\\circ}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan $\\cos 70^\\circ = \\sin 20^\\circ$ dan sederhanakan**" },
        { "formula_block", "latex": "\\dfrac{2\\sin 20^\\circ}{\\frac{1}{2}\\sin 20^\\circ} = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ekspresi tersebut adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos^2 45^\\circ + \\cos^2 135^\\circ + \\cos^2 225^\\circ + \\cos^2 315^\\circ$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan nilai kuadrat cosinus pada masing-masing sudut ($\\cos^2 \\theta = \\dfrac{1}{2}$)**" },
        { "formula_block", "latex": "\\cos^2 45^\\circ + \\cos^2 135^\\circ + \\cos^2 225^\\circ + \\cos^2 315^\\circ = \\dfrac{1}{2} + \\dfrac{1}{2} + \\dfrac{1}{2} + \\dfrac{1}{2} = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai penjumlahan tersebut adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk paling sederhana dari $\\dfrac{\\sin 4x}{\\sin 2x} - \\dfrac{\\cos 4x}{\\cos 2x}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sec 2x$" } ],
        [ { "tipe": "paragraph", "text": "$\\sec x$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sec 2x$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\tan 2x$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Samakan penyebut dan gunakan identitas $\\sin 4x \\cos 2x - \\cos 4x \\sin 2x = \\sin(4x - 2x) = \\sin 2x$**" },
        { "formula_block", "latex": "\\dfrac{\\sin 4x}{\\sin 2x} - \\dfrac{\\cos 4x}{\\cos 2x} = \\dfrac{\\sin(4x - 2x)}{\\sin 2x \\cos 2x} = \\dfrac{\\sin 2x}{\\sin 2x \\cos 2x} = \\dfrac{1}{\\cos 2x} = \\sec 2x" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bentuk paling sederhananya adalah **$\\sec 2x$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
