{
  "id": "bs-k10-trig-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang identitas trigonometri, persamaan, dan aplikasi segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan x + \\tan y = 5$ dan $\\tan x \\cdot \\tan y = 6$, maka nilai $\\tan(x + y)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus: $\\tan(x + y) = \\dfrac{\\tan x + \\tan y}{1 - \\tan x \\tan y}$." },
        { "tipe": "paragraph", "text": "$\\tan(x + y) = \\dfrac{5}{1 - 6} = \\dfrac{5}{-5} = -1$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 18° \\cdot \\cos 36°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{5}-1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{5}+1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\sin 18° = \\dfrac{\\sqrt{5}-1}{4}$ dan $\\cos 36° = \\dfrac{\\sqrt{5}+1}{4}$." },
        { "tipe": "paragraph", "text": "Kalikan keduanya: $\\sin 18° \\cos 36° = \\left(\\dfrac{\\sqrt{5}-1}{4}\\right)\\left(\\dfrac{\\sqrt{5}+1}{4}\\right)$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{(\\sqrt{5})^2 - 1^2}{16} = \\dfrac{5 - 1}{16} = \\dfrac{4}{16} = \\dfrac{1}{4}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\sin 2x + \\sin x = 0$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{0°, 120°, 180°, 240°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 180°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 180°, 300°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $\\sin 2x = 2\\sin x \\cos x$." },
        { "tipe": "paragraph", "text": "$2\\sin x \\cos x + \\sin x = 0 \\Rightarrow \\sin x (2\\cos x + 1) = 0$." },
        { "tipe": "paragraph", "text": "$\\sin x = 0 \\Rightarrow x = 0°, 180°, 360°$." },
        { "tipe": "paragraph", "text": "$2\\cos x + 1 = 0 \\Rightarrow \\cos x = -\\dfrac{1}{2} \\Rightarrow x = 120°, 240°$." },
        { "tipe": "paragraph", "text": "HP = $\\{0°, 120°, 180°, 240°, 360°\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\sin x + \\cos x = \\dfrac{1}{2}$. Nilai dari $\\sin^4 x + \\cos^4 x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{23}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{29}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{31}{32}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(\\sin x + \\cos x)^2 = \\dfrac{1}{4} \\Rightarrow 1 + 2\\sin x \\cos x = \\dfrac{1}{4} \\Rightarrow \\sin x \\cos x = -\\dfrac{3}{8}$." },
        { "tipe": "paragraph", "text": "$\\sin^4 x + \\cos^4 x = 1 - 2(\\sin x \\cos x)^2$." },
        { "tipe": "paragraph", "text": "$= 1 - 2\\left(-\\dfrac{3}{8}\\right)^2 = 1 - 2\\left(\\dfrac{9}{64}\\right)$." },
        { "tipe": "paragraph", "text": "$= 1 - \\dfrac{18}{64} = \\dfrac{46}{64} = \\dfrac{23}{32}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga $ABC$ berikut. Diketahui $a = 5$ cm, $b = 7$ cm, dan $\\angle C = 120°$. Panjang sisi $c$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-cos-120.png",
          "caption": "Segitiga ABC dengan sisi a = 5 cm, b = 7 cm, dan sudut C = 120°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{109}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{119}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{129}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{139}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{149}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan cosinus: $c^2 = a^2 + b^2 - 2ab \\cos C$." },
        { "tipe": "paragraph", "text": "$c^2 = 5^2 + 7^2 - 2(5)(7)\\cos 120°$." },
        { "tipe": "paragraph", "text": "Ingat $\\cos 120° = -\\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "$c^2 = 25 + 49 - 70\\left(-\\dfrac{1}{2}\\right) = 74 + 35 = 109$." },
        { "tipe": "paragraph", "text": "$c = \\sqrt{109}$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\cos 10° - \\cos 110°}{\\sin 110° - \\sin 10°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus jumlah ke perkalian:" },
        { "tipe": "paragraph", "text": "$\\cos 10° - \\cos 110° = -2\\sin 60° \\sin(-50°) = 2\\sin 60° \\sin 50°$." },
        { "tipe": "paragraph", "text": "$\\sin 110° - \\sin 10° = 2\\cos 60° \\sin 50°$." },
        { "tipe": "paragraph", "text": "Rasio: $\\dfrac{2\\sin 60° \\sin 50°}{2\\cos 60° \\sin 50°} = \\tan 60° = \\sqrt{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos \\alpha = \\dfrac{4}{5}$ dan $\\alpha$ di kuadran IV, maka nilai $\\cos 2\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{25}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\cos 2\\alpha = 2\\cos^2 \\alpha - 1$." },
        { "tipe": "paragraph", "text": "$\\cos 2\\alpha = 2\\left(\\dfrac{4}{5}\\right)^2 - 1 = 2\\left(\\dfrac{16}{25}\\right) - 1$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{32}{25} - \\dfrac{25}{25} = \\dfrac{7}{25}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos^2 20° + \\cos^2 40° + \\cos^2 80°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan $\\cos^2 \\theta = \\dfrac{1 + \\cos 2\\theta}{2}$." },
        { "tipe": "paragraph", "text": "Jumlahkan: $= \\dfrac{3}{2} + \\dfrac{1}{2}(\\cos 40° + \\cos 80° + \\cos 160°)$." },
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\cos 40° + \\cos 80° + \\cos 160° = 0$." },
        { "tipe": "paragraph", "text": "Jadi hasilnya $\\dfrac{3}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan panjang sisi $a = 8$ cm, $b = 6$ cm, dan $\\angle C = 60°$. Luas segitiga tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$24\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$12\\sqrt{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$24\\sqrt{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$48\\sqrt{3}$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} a b \\sin C$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2} (8)(6) \\sin 60° = 24 \\cdot \\dfrac{1}{2}\\sqrt{3} = 12\\sqrt{3}$ cm²." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin x = \\dfrac{3}{5}$ dan $x$ berada di kuadran II, maka nilai $\\tan(x + 45°)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran II: $\\sin x = \\dfrac{3}{5}$ dan $\\cos x = -\\dfrac{4}{5}$." },
        { "tipe": "paragraph", "text": "$\\tan x = -\\dfrac{3}{4}$." },
        { "tipe": "paragraph", "text": "$\\tan(x + 45°) = \\dfrac{\\tan x + 1}{1 - \\tan x} = \\dfrac{-\\frac{3}{4} + 1}{1 - (-\\frac{3}{4})} = \\dfrac{\\frac{1}{4}}{\\frac{7}{4}} = \\dfrac{1}{7}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
