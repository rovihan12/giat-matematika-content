{
  "id": "bs-k10-trig-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang identitas trigonometri, persamaan, dan aplikasi segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan x + \\tan y = 5$ dan $\\tan x \\cdot \\tan y = 6$, maka nilai $\\tan(x + y)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $\\tan x + \\tan y = 5$ dan $\\tan x \\cdot \\tan y = 6$ ke rumus jumlah tangen**" },
        { "formula_block", "latex": "\\tan(x + y) = \\dfrac{\\tan x + \\tan y}{1 - \\tan x \\tan y} = \\dfrac{5}{1 - 6} = \\dfrac{5}{-5} = -1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\tan(x + y)$ adalah **$-1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 18° \\cdot \\cos 36°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{5}-1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{5}+1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kalikan nilai eksak $\\sin 18° = \\dfrac{\\sqrt{5}-1}{4}$ dan $\\cos 36° = \\dfrac{\\sqrt{5}+1}{4}$**" },
        { "formula_block", "latex": "\\sin 18° \\cdot \\cos 36° = \\left(\\dfrac{\\sqrt{5}-1}{4}\\right)\\left(\\dfrac{\\sqrt{5}+1}{4}\\right) = \\dfrac{5 - 1}{16} = \\dfrac{4}{16} = \\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai perkalian tersebut adalah **$\\dfrac{1}{4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\sin 2x + \\sin x = 0$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{0°, 120°, 180°, 240°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 180°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 180°, 300°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah $\\sin 2x$ menjadi $2\\sin x \\cos x$ lalu faktorkan**" },
        { "formula_block", "latex": "2\\sin x \\cos x + \\sin x = 0 \\Rightarrow \\sin x(2\\cos x + 1) = 0 \\Rightarrow \\sin x = 0 \\text{ atau } \\cos x = -\\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan semua nilai $x$ pada interval $0° \\le x \\le 360°$**" },
        { "formula_block", "\\sin x = 0 \\Rightarrow x = 0°, 180°, 360°; \\qquad \\cos x = -\\dfrac{1}{2} \\Rightarrow x = 120°, 240°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{0°, 120°, 180°, 240°, 360°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\sin x + \\cos x = \\dfrac{1}{2}$. Nilai dari $\\sin^4 x + \\cos^4 x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{23}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{29}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{31}{32}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas untuk memperoleh nilai $\\sin x \\cos x$**" },
        { "formula_block", "latex": "(\\sin x + \\cos x)^2 = \\left(\\dfrac{1}{2}\\right)^2 \\Rightarrow 1 + 2\\sin x \\cos x = \\dfrac{1}{4} \\Rightarrow \\sin x \\cos x = -\\dfrac{3}{8}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sin^4 x + \\cos^4 x = 1 - 2(\\sin x \\cos x)^2$**" },
        { "formula_block", "latex": "\\sin^4 x + \\cos^4 x = 1 - 2\\left(-\\dfrac{3}{8}\\right)^2 = 1 - \\dfrac{18}{64} = \\dfrac{23}{32}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin^4 x + \\cos^4 x$ adalah **$\\dfrac{23}{32}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga $ABC$ berikut. Diketahui $a = 5$ cm, $b = 7$ cm, dan $\\angle C = 120°$. Panjang sisi $c$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-cos-120.png",
          "caption": "Segitiga ABC dengan sisi a = 5 cm, b = 7 cm, dan sudut C = 120°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{109}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{119}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{129}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{139}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{149}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $c^2$ menggunakan aturan cosinus dengan $a = 5$, $b = 7$, dan $\\angle C = 120°$**" },
        { "formula_block", "latex": "c^2 = 5^2 + 7^2 - 2(5)(7)\\cos 120° = 25 + 49 - 70\\left(-\\dfrac{1}{2}\\right) = 74 + 35 = 109" },
        { "tipe": "paragraph", "text": "**Langkah 2: Akarkan hasilnya untuk memperoleh panjang sisi $c$**" },
        { "formula_block", "latex": "c = \\sqrt{109}\\text{ cm}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang sisi $c$ adalah **$\\sqrt{109}$ cm**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\cos 10° - \\cos 110°}{\\sin 110° - \\sin 10°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah pembilang dan penyebut menjadi bentuk perkalian**" },
        { "formula_block", "latex": "\\dfrac{\\cos 10° - \\cos 110°}{\\sin 110° - \\sin 10°} = \\dfrac{-2\\sin 60° \\sin(-50°)}{2\\cos 60° \\sin 50°} = \\dfrac{2\\sin 60° \\sin 50°}{2\\cos 60° \\sin 50°}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan faktor yang sama dan hitung $\\tan 60°$**" },
        { "formula_block", "latex": "\\dfrac{\\sin 60°}{\\cos 60°} = \\tan 60° = \\sqrt{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai pecahan tersebut adalah **$\\sqrt{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos \\alpha = \\dfrac{4}{5}$ dan $\\alpha$ di kuadran IV, maka nilai $\\cos 2\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{25}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas sudut ganda $\\cos 2\\alpha = 2\\cos^2 \\alpha - 1$ dengan $\\cos \\alpha = \\dfrac{4}{5}$**" },
        { "formula_block", "latex": "\\cos 2\\alpha = 2\\left(\\dfrac{4}{5}\\right)^2 - 1 = 2\\left(\\dfrac{16}{25}\\right) - 1 = \\dfrac{32}{25} - \\dfrac{25}{25} = \\dfrac{7}{25}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos 2\\alpha$ adalah **$\\dfrac{7}{25}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos^2 20° + \\cos^2 40° + \\cos^2 80°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas $\\cos^2 \\theta = \\dfrac{1 + \\cos 2\\theta}{2}$**" },
        { "formula_block", "latex": "\\cos^2 20° + \\cos^2 40° + \\cos^2 80° = \\dfrac{3}{2} + \\dfrac{1}{2}(\\cos 40° + \\cos 80° + \\cos 160°)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $\\cos 40° + \\cos 80° + \\cos 160° = 0$**" },
        { "formula_block", "latex": "\\dfrac{3}{2} + \\dfrac{1}{2}(0) = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai penjumlahan tersebut adalah **$\\dfrac{3}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan panjang sisi $a = 8$ cm, $b = 6$ cm, dan $\\angle C = 60°$. Luas segitiga tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$24\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$12\\sqrt{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$24\\sqrt{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$48\\sqrt{3}$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung luas segitiga menggunakan $L = \\dfrac{1}{2} a b \\sin C$ dengan $a = 8$, $b = 6$, dan $\\angle C = 60°$**" },
        { "formula_block", "latex": "L = \\dfrac{1}{2}(8)(6)\\sin 60° = 24 \\cdot \\dfrac{1}{2}\\sqrt{3} = 12\\sqrt{3}\\text{ cm}^2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas segitiga tersebut adalah **$12\\sqrt{3}$ cm²**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin x = \\dfrac{3}{5}$ dan $x$ berada di kuadran II, maka nilai $\\tan(x + 45°)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\tan x$ pada kuadran II dari $\\sin x = \\dfrac{3}{5}$ dan $\\cos x = -\\dfrac{4}{5}$**" },
        { "formula_block", "latex": "\\tan x = \\dfrac{\\sin x}{\\cos x} = \\dfrac{\\frac{3}{5}}{-\\frac{4}{5}} = -\\dfrac{3}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\tan(x + 45°)$ menggunakan rumus jumlah tangen**" },
        { "formula_block", "latex": "\\tan(x + 45°) = \\dfrac{\\tan x + 1}{1 - \\tan x} = \\dfrac{-\\frac{3}{4} + 1}{1 - \\left(-\\frac{3}{4}\\right)} = \\dfrac{\\frac{1}{4}}{\\frac{7}{4}} = \\dfrac{1}{7}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\tan(x + 45°)$ adalah **$\\dfrac{1}{7}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
