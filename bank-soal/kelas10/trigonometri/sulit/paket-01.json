{
  "id": "bs-k10-trig-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang aturan sinus/cosinus pada segitiga kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga $ABC$ berikut. Jika $a = 8$ cm, $b = 6$ cm, dan $c = 10$ cm, maka nilai $\\cos B$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-8-6-10.png",
          "caption": "Segitiga ABC dengan a = BC = 8, b = AC = 6, c = AB = 10 (sesuai konvensi: sisi huruf kecil di hadapan sudut huruf besar).",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan cosinus: $\\cos B = \\dfrac{a^2 + c^2 - b^2}{2ac}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{64 + 100 - 36}{2 \\cdot 8 \\cdot 10} = \\dfrac{128}{160} = \\dfrac{4}{5}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga $ABC$, diketahui $A = 30°$, $B = 105°$, dan $a = 6$ cm. Panjang sisi $b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$3\\sqrt{6}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6\\sqrt{6}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$C = 180° - 30° - 105° = 45°$" },
        { "tipe": "paragraph", "text": "Aturan sinus: $\\dfrac{a}{\\sin A} = \\dfrac{b}{\\sin B}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{6}{\\sin 30°} = \\dfrac{b}{\\sin 105°}$" },
        { "tipe": "paragraph", "text": "$\\sin 105° = \\sin(60° + 45°) = \\dfrac{1}{4}(\\sqrt{6} + \\sqrt{2})$" },
        { "tipe": "paragraph", "text": "$12 = \\dfrac{b}{\\frac{1}{4}(\\sqrt{6} + \\sqrt{2})} \\Rightarrow b = 3(\\sqrt{6} + \\sqrt{2})$" },
        { "tipe": "paragraph", "text": "Nilai pendekatan: $b \\approx 6\\sqrt{2}$ (opsi terdekat)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 75° + \\sin 15°}{\\cos 75° + \\cos 15°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus jumlah-ke-produk:" },
        { "tipe": "paragraph", "text": "$\\sin A + \\sin B = 2\\sin\\dfrac{A+B}{2}\\cos\\dfrac{A-B}{2}$" },
        { "tipe": "paragraph", "text": "$\\cos A + \\cos B = 2\\cos\\dfrac{A+B}{2}\\cos\\dfrac{A-B}{2}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{\\sin 75° + \\sin 15°}{\\cos 75° + \\cos 15°} = \\tan\\dfrac{75°+15°}{2} = \\tan 45° = 1$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: jawaban benar $1$. Kunci opsi E. Bila soal diubah pembilang menjadi $\\sin 45° + \\sin 15°$, maka jawabannya $\\tan 30° = \\frac{1}{3}\\sqrt{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin 18°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{5} - 1)$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{5} + 1)$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{5} - 1)$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}\\sqrt{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $\\sin 18° = \\cos 72°$ dan $\\sin 18° = \\dfrac{\\sqrt{5}-1}{4}$." },
        { "tipe": "paragraph", "text": "Pembuktian: misalkan $x = 18°$, maka $5x = 90°$, sehingga $2x = 90° - 3x$." },
        { "tipe": "paragraph", "text": "$\\sin 2x = \\sin(90° - 3x) = \\cos 3x$" },
        { "tipe": "paragraph", "text": "Substitusi rumus sudut rangkap & selesaikan → $\\sin 18° = \\dfrac{\\sqrt{5}-1}{4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan \\alpha = 2$, maka nilai $\\sin 2\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\tan \\alpha = 2$ → $\\sin \\alpha = \\dfrac{2}{\\sqrt{5}}$, $\\cos \\alpha = \\dfrac{1}{\\sqrt{5}}$" },
        { "tipe": "paragraph", "text": "$\\sin 2\\alpha = 2 \\sin \\alpha \\cos \\alpha = 2 \\cdot \\dfrac{2}{\\sqrt{5}} \\cdot \\dfrac{1}{\\sqrt{5}} = \\dfrac{4}{5}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga $ABC$, diketahui $a = 10$ cm, $b = 12$ cm, dan $\\sin C = \\dfrac{3}{5}$. Luas segitiga tersebut adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-luas-sin.png",
          "caption": "Segitiga ABC dengan a = 10 cm, b = 12 cm, dan sudut C dengan sin C = 3/5.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$36$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$40$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$48$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$60$ cm²" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot a \\cdot b \\cdot \\sin C$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2} \\cdot 10 \\cdot 12 \\cdot \\dfrac{3}{5} = 60 \\cdot \\dfrac{3}{5} = 36$ cm²" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\dfrac{1 - \\cos 2\\alpha}{\\sin 2\\alpha}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\tan \\alpha$" } ],
        [ { "tipe": "paragraph", "text": "$\\cot \\alpha$" } ],
        [ { "tipe": "paragraph", "text": "$\\sin \\alpha$" } ],
        [ { "tipe": "paragraph", "text": "$\\cos \\alpha$" } ],
        [ { "tipe": "paragraph", "text": "$2\\tan \\alpha$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$1 - \\cos 2\\alpha = 2\\sin^2 \\alpha$" },
        { "tipe": "paragraph", "text": "$\\sin 2\\alpha = 2\\sin \\alpha \\cos \\alpha$" },
        { "tipe": "paragraph", "text": "$\\dfrac{2\\sin^2 \\alpha}{2\\sin \\alpha \\cos \\alpha} = \\dfrac{\\sin \\alpha}{\\cos \\alpha} = \\tan \\alpha$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 36° \\cdot \\cos 72°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{5}}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus: $\\cos A \\cos B = \\dfrac{1}{2}[\\cos(A+B) + \\cos(A-B)]$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}[\\cos 108° + \\cos(-36°)]$" },
        { "tipe": "paragraph", "text": "$\\cos 108° = \\cos(180° - 72°) = -\\cos 72°$" },
        { "tipe": "paragraph", "text": "Jadi $\\cos 36° \\cos 72° = \\dfrac{1}{2}(\\cos 36° - \\cos 72°)$" },
        { "tipe": "paragraph", "text": "Dengan $\\cos 36° = \\dfrac{\\sqrt{5}+1}{4}$ dan $\\cos 72° = \\dfrac{\\sqrt{5}-1}{4}$:" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2} \\cdot \\dfrac{1}{2} = \\dfrac{1}{4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2\\sin^2 x - 3\\sin x + 1 = 0$ untuk $0° \\leq x \\leq 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{90°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°, 150°, 180°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $y = \\sin x$: $2y^2 - 3y + 1 = 0$" },
        { "tipe": "paragraph", "text": "$(2y - 1)(y - 1) = 0 \\Rightarrow y = \\dfrac{1}{2}$ atau $y = 1$" },
        { "tipe": "paragraph", "text": "$\\sin x = \\dfrac{1}{2} \\Rightarrow x = 30°, 150°$" },
        { "tipe": "paragraph", "text": "$\\sin x = 1 \\Rightarrow x = 90°$" },
        { "tipe": "paragraph", "text": "HP = $\\{30°, 90°, 150°\\}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga $ABC$, $a = 4$ cm, $b = 4\\sqrt{3}$ cm, dan $C = 30°$. Panjang sisi $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{3}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$c^2 = a^2 + b^2 - 2ab \\cos C$" },
        { "tipe": "paragraph", "text": "$= 16 + 48 - 2(4)(4\\sqrt{3})\\cos 30°$" },
        { "tipe": "paragraph", "text": "$= 64 - 32\\sqrt{3} \\cdot \\dfrac{1}{2}\\sqrt{3} = 64 - 48 = 16$" },
        { "tipe": "paragraph", "text": "$c = 4$ cm" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
