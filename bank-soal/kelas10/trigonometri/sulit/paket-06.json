{
  "id": "bs-k10-trig-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang persamaan trigonometri, identitas lanjutan, dan aturan segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari persamaan $2\\cos^2 x + \\cos x - 1 = 0$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{60°, 180°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{180°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $y = \\cos x$, maka $2y^2 + y - 1 = 0$." },
        { "tipe": "paragraph", "text": "Faktorkan: $(2y - 1)(y + 1) = 0 \\Rightarrow y = \\dfrac{1}{2}$ atau $y = -1$." },
        { "tipe": "paragraph", "text": "$\\cos x = \\dfrac{1}{2} \\Rightarrow x = 60°, 300°$." },
        { "tipe": "paragraph", "text": "$\\cos x = -1 \\Rightarrow x = 180°$." },
        { "tipe": "paragraph", "text": "HP = $\\{60°, 180°, 300°\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\sin \\alpha + \\cos \\alpha = \\dfrac{3}{4}$. Nilai dari $\\sin^3 \\alpha + \\cos^3 \\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{117}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{71}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{73}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{75}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{77}{128}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(\\sin \\alpha + \\cos \\alpha)^2 = \\dfrac{9}{16} \\Rightarrow 1 + 2\\sin \\alpha \\cos \\alpha = \\dfrac{9}{16}$." },
        { "tipe": "paragraph", "text": "$2\\sin \\alpha \\cos \\alpha = -\\dfrac{7}{16} \\Rightarrow \\sin \\alpha \\cos \\alpha = -\\dfrac{7}{32}$." },
        { "tipe": "paragraph", "text": "$\\sin^3 \\alpha + \\cos^3 \\alpha = (\\sin \\alpha + \\cos \\alpha)(1 - \\sin \\alpha \\cos \\alpha)$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{3}{4}\\left(1 - \\left(-\\dfrac{7}{32}\\right)\\right) = \\dfrac{3}{4}\\left(\\dfrac{39}{32}\\right) = \\dfrac{117}{128}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 40° \\cdot \\cos 80° \\cdot \\cos 160°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $\\cos \\theta = -\\cos(180° - \\theta)$ untuk $\\cos 160°$." },
        { "tipe": "paragraph", "text": "$\\cos 160° = -\\cos 20°$." },
        { "tipe": "paragraph", "text": "Maka hasilnya $= - (\\cos 20° \\cos 40° \\cos 80°)$." },
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\cos 20° \\cos 40° \\cos 80° = \\dfrac{1}{8}$." },
        { "tipe": "paragraph", "text": "Jadi hasilnya $-\\dfrac{1}{8}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga $ABC$, diketahui $a = 4$ cm, $b = 5$ cm, dan $c = 6$ cm. Nilai $\\sin A$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{7}}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{7}}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{7}}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3\\sqrt{7}}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3\\sqrt{7}}{16}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan cosinus untuk mencari $\\cos A$." },
        { "tipe": "paragraph", "text": "$\\cos A = \\dfrac{b^2 + c^2 - a^2}{2bc} = \\dfrac{25 + 36 - 16}{2 \\cdot 5 \\cdot 6} = \\dfrac{45}{60} = \\dfrac{3}{4}$." },
        { "tipe": "paragraph", "text": "$\\sin A = \\sqrt{1 - \\cos^2 A} = \\sqrt{1 - \\dfrac{9}{16}} = \\sqrt{\\dfrac{7}{16}} = \\dfrac{\\sqrt{7}}{4}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $ABC$ berikut. Jika $AC = 15$ cm dan $\\angle A = 30°$, maka panjang $BC$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-siku-30-15.png",
          "caption": "Segitiga siku-siku ABC, siku-siku di B. AC = 15 cm (sisi miring), sudut A = 30°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$30$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 30° = \\dfrac{BC}{AC}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{2} = \\dfrac{BC}{15} \\Rightarrow BC = \\dfrac{15}{2}$ cm." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\tan 20° \\cdot \\tan 40° \\cdot \\tan 80°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Identitas: $\\tan 20° \\tan 40° \\tan 80° = \\tan 60° = \\sqrt{3}$." },
        { "tipe": "paragraph", "text": "(Bisa dibuktikan dengan menggunakan identitas $\\tan 3\\theta$ pada $\\theta = 20°$.)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos x = \\dfrac{1}{3}$ dan $x$ berada di kuadran IV, maka nilai $\\sin 2x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran IV, $\\sin x$ negatif." },
        { "tipe": "paragraph", "text": "$\\sin x = -\\sqrt{1 - \\left(\\dfrac{1}{3}\\right)^2} = -\\sqrt{1 - \\dfrac{1}{9}} = -\\sqrt{\\dfrac{8}{9}} = -\\dfrac{2\\sqrt{2}}{3}$." },
        { "tipe": "paragraph", "text": "$\\sin 2x = 2 \\sin x \\cos x = 2\\left(-\\dfrac{2\\sqrt{2}}{3}\\right)\\left(\\dfrac{1}{3}\\right) = -\\dfrac{4\\sqrt{2}}{9}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\sin 2x = \\cos x$ untuk $0° \\le x \\le 180°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{90°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 90°, 180°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 2x = \\cos x \\Rightarrow 2\\sin x \\cos x - \\cos x = 0$." },
        { "tipe": "paragraph", "text": "$\\cos x(2\\sin x - 1) = 0$." },
        { "tipe": "paragraph", "text": "$\\cos x = 0 \\Rightarrow x = 90°$." },
        { "tipe": "paragraph", "text": "$2\\sin x - 1 = 0 \\Rightarrow \\sin x = \\dfrac{1}{2} \\Rightarrow x = 30°, 150°$." },
        { "tipe": "paragraph", "text": "HP = $\\{30°, 90°, 150°\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\alpha = \\dfrac{4}{5}$ dan $\\alpha$ di kuadran II, maka nilai $\\sin 3\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{44}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{44}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{117}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{117}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{108}{125}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran II: $\\sin \\alpha = \\dfrac{4}{5}$, $\\cos \\alpha = -\\dfrac{3}{5}$." },
        { "tipe": "paragraph", "text": "$\\sin 3\\alpha = 3\\sin \\alpha - 4\\sin^3 \\alpha$." },
        { "tipe": "paragraph", "text": "$= 3\\left(\\dfrac{4}{5}\\right) - 4\\left(\\dfrac{64}{125}\\right) = \\dfrac{12}{5} - \\dfrac{256}{125} = \\dfrac{300 - 256}{125} = \\dfrac{44}{125}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^4 15° - \\cos^4 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}\\sqrt{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan selisih kuadrat: $(\\sin^2 15° - \\cos^2 15°)(\\sin^2 15° + \\cos^2 15°)$." },
        { "tipe": "paragraph", "text": "$\\sin^2 15° + \\cos^2 15° = 1$." },
        { "tipe": "paragraph", "text": "$\\sin^2 15° - \\cos^2 15° = -\\cos 30° = -\\dfrac{1}{2}\\sqrt{3}$." },
        { "tipe": "paragraph", "text": "Jadi hasilnya $-\\dfrac{1}{2}\\sqrt{3}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
