{
  "id": "bs-k10-trig-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang persamaan trigonometri, identitas lanjutan, dan aturan segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari persamaan $2\\cos^2 x + \\cos x - 1 = 0$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{60°, 180°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{180°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan kuadrat dalam $\\cos x$**" },
        { "formula_block", "latex": "2\\cos^2 x + \\cos x - 1 = 0 \\Rightarrow (2\\cos x - 1)(\\cos x + 1) = 0 \\Rightarrow \\cos x = \\dfrac{1}{2} \\text{ atau } \\cos x = -1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ pada interval $0° \\le x \\le 360°$**" },
        { "formula_block", "latex": "\\cos x = \\dfrac{1}{2} \\Rightarrow x = 60°, 300°; \\qquad \\cos x = -1 \\Rightarrow x = 180°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{60°, 180°, 300°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\sin \\alpha + \\cos \\alpha = \\dfrac{3}{4}$. Nilai dari $\\sin^3 \\alpha + \\cos^3 \\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{117}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{71}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{73}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{75}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{77}{128}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas untuk memperoleh nilai $\\sin \\alpha \\cos \\alpha$**" },
        { "formula_block", "latex": "(\\sin \\alpha + \\cos \\alpha)^2 = \\left(\\dfrac{3}{4}\\right)^2 \\Rightarrow 1 + 2\\sin \\alpha \\cos \\alpha = \\dfrac{9}{16} \\Rightarrow \\sin \\alpha \\cos \\alpha = -\\dfrac{7}{32}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jabarkan $\\sin^3 \\alpha + \\cos^3 \\alpha$ lalu substitusikan nilai yang diketahui**" },
        { "formula_block", "latex": "\\sin^3 \\alpha + \\cos^3 \\alpha = (\\sin \\alpha + \\cos \\alpha)(1 - \\sin \\alpha \\cos \\alpha) = \\dfrac{3}{4}\\left(1 + \\dfrac{7}{32}\\right) = \\dfrac{3}{4} \\cdot \\dfrac{39}{32} = \\dfrac{117}{128}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin^3 \\alpha + \\cos^3 \\alpha$ adalah **$\\dfrac{117}{128}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 40° \\cdot \\cos 80° \\cdot \\cos 160°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan $\\cos 160° = -\\cos(180° - 160°) = -\\cos 20°$ dan identitas perkalian cosinus**" },
        { "formula_block", "latex": "\\cos 40° \\cdot \\cos 80° \\cdot \\cos 160° = -(\\cos 20° \\cos 40° \\cos 80°) = -\\dfrac{\\sin(8 \\times 20°)}{8\\sin 20°}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan dengan $\\sin 160° = \\sin 20°$**" },
        { "formula_block", "latex": "-\\dfrac{\\sin 160°}{8\\sin 20°} = -\\dfrac{\\sin 20°}{8\\sin 20°} = -\\dfrac{1}{8}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai perkalian tersebut adalah **$-\\dfrac{1}{8}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga $ABC$, diketahui $a = 4$ cm, $b = 5$ cm, dan $c = 6$ cm. Nilai $\\sin A$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{7}}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{7}}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{7}}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3\\sqrt{7}}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3\\sqrt{7}}{16}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $\\cos A$ menggunakan aturan cosinus dengan $a = 4$, $b = 5$, dan $c = 6$**" },
        { "formula_block", "latex": "\\cos A = \\dfrac{b^2 + c^2 - a^2}{2bc} = \\dfrac{25 + 36 - 16}{2 \\cdot 5 \\cdot 6} = \\dfrac{45}{60} = \\dfrac{3}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sin A$ menggunakan identitas $\\sin A = \\sqrt{1 - \\cos^2 A}$**" },
        { "formula_block", "latex": "\\sin A = \\sqrt{1 - \\left(\\dfrac{3}{4}\\right)^2} = \\sqrt{\\dfrac{7}{16}} = \\dfrac{\\sqrt{7}}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin A$ adalah **$\\dfrac{\\sqrt{7}}{4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $ABC$ berikut. Jika $AC = 15$ cm dan $\\angle A = 30°$, maka panjang $BC$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-siku-30-15.png",
          "caption": "Segitiga siku-siku ABC, siku-siku di B. AC = 15 cm (sisi miring), sudut A = 30°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$30$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan perbandingan trigonometri $\\sin 30° = \\dfrac{BC}{AC}$ dengan $AC = 15\\text{ cm}$**" },
        { "formula_block", "latex": "\\dfrac{1}{2} = \\dfrac{BC}{15} \\Rightarrow BC = \\dfrac{15}{2}\\text{ cm}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang $BC$ adalah **$\\dfrac{15}{2}$ cm**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\tan 20° \\cdot \\tan 40° \\cdot \\tan 80°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas perkalian tangen $\\tan \\theta \\tan(60° - \\theta)\\tan(60° + \\theta) = \\tan 3\\theta$ untuk $\\theta = 20°$**" },
        { "formula_block", "latex": "\\tan 20° \\cdot \\tan 40° \\cdot \\tan 80° = \\tan(3 \\times 20°) = \\tan 60° = \\sqrt{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai perkalian tersebut adalah **$\\sqrt{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos x = \\dfrac{1}{3}$ dan $x$ berada di kuadran IV, maka nilai $\\sin 2x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2\\sqrt{2}}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\sin x$ pada kuadran IV (bernilai negatif)**" },
        { "formula_block", "latex": "\\sin x = -\\sqrt{1 - \\left(\\dfrac{1}{3}\\right)^2} = -\\sqrt{\\dfrac{8}{9}} = -\\dfrac{2\\sqrt{2}}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sin 2x = 2\\sin x \\cos x$**" },
        { "formula_block", "latex": "\\sin 2x = 2\\left(-\\dfrac{2\\sqrt{2}}{3}\\right)\\left(\\dfrac{1}{3}\\right) = -\\dfrac{4\\sqrt{2}}{9}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin 2x$ adalah **$-\\dfrac{4\\sqrt{2}}{9}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\sin 2x = \\cos x$ untuk $0° \\le x \\le 180°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{90°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 90°, 180°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah $\\sin 2x$ menjadi $2\\sin x \\cos x$ lalu faktorkan**" },
        { "formula_block", "latex": "2\\sin x \\cos x - \\cos x = 0 \\Rightarrow \\cos x(2\\sin x - 1) = 0 \\Rightarrow \\cos x = 0 \\text{ atau } \\sin x = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan semua nilai $x$ pada interval $0° \\le x \\le 180°$**" },
        { "formula_block", "\\cos x = 0 \\Rightarrow x = 90°; \\qquad \\sin x = \\dfrac{1}{2} \\Rightarrow x = 30°, 150°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{30°, 90°, 150°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\alpha = \\dfrac{4}{5}$ dan $\\alpha$ di kuadran II, maka nilai $\\sin 3\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{44}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{44}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{117}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{117}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{108}{125}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas $\\sin 3\\alpha = 3\\sin \\alpha - 4\\sin^3 \\alpha$ dengan $\\sin \\alpha = \\dfrac{4}{5}$**" },
        { "formula_block", "latex": "\\sin 3\\alpha = 3\\left(\\dfrac{4}{5}\\right) - 4\\left(\\dfrac{4}{5}\\right)^3 = \\dfrac{12}{5} - \\dfrac{256}{125} = \\dfrac{300 - 256}{125} = \\dfrac{44}{125}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin 3\\alpha$ adalah **$\\dfrac{44}{125}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^4 15° - \\cos^4 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}\\sqrt{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan sebagai selisih kuadrat dan gunakan $\\sin^2 15° + \\cos^2 15° = 1$**" },
        { "formula_block", "latex": "\\sin^4 15° - \\cos^4 15° = (\\sin^2 15° - \\cos^2 15°)(\\sin^2 15° + \\cos^2 15°) = (-\\cos 30°)(1)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $\\cos 30° = \\dfrac{1}{2}\\sqrt{3}$**" },
        { "formula_block", "latex": "-\\cos 30° = -\\dfrac{1}{2}\\sqrt{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ekspresi tersebut adalah **$-\\dfrac{1}{2}\\sqrt{3}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
