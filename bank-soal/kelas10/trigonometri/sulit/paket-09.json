{
  "id": "bs-k10-trig-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang identitas trigonometri, deret trigonometri, dan aturan segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^2 10° + \\sin^2 20° + \\sin^2 40° + \\sin^2 50° + \\sin^2 70° + \\sin^2 80°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $\\sin^2 \\theta + \\sin^2(90° - \\theta) = \\sin^2 \\theta + \\cos^2 \\theta = 1$." },
        { "tipe": "paragraph", "text": "Pasangkan sudut: $(10°, 80°)$, $(20°, 70°)$, dan $(40°, 50°)$." },
        { "tipe": "paragraph", "text": "Masing-masing pasangan bernilai $1$. Ada 3 pasangan, sehingga totalnya $3 \\cdot 1 = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan \\alpha = \\dfrac{1}{2}$ dan $\\tan \\beta = \\dfrac{1}{3}$, maka nilai $\\alpha + \\beta$ (dalam derajat) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45°$" } ],
        [ { "tipe": "paragraph", "text": "$30°$" } ],
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$75°$" } ],
        [ { "tipe": "paragraph", "text": "$90°$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus: $\\tan(\\alpha + \\beta) = \\dfrac{\\tan \\alpha + \\tan \\beta}{1 - \\tan \\alpha \\tan \\beta}$." },
        { "tipe": "paragraph", "text": "$\\tan(\\alpha + \\beta) = \\dfrac{\\frac{1}{2} + \\frac{1}{3}}{1 - \\frac{1}{2} \\cdot \\frac{1}{3}} = \\dfrac{\\frac{5}{6}}{1 - \\frac{1}{6}} = \\dfrac{\\frac{5}{6}}{\\frac{5}{6}} = 1$." },
        { "tipe": "paragraph", "text": "Karena $\\tan(\\alpha + \\beta) = 1$, maka $\\alpha + \\beta = 45°$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\cos 2x - 3\\cos x + 2 = 0$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{0°, 60°, 300°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 180°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{180°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 360°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas $\\cos 2x = 2\\cos^2 x - 1$." },
        { "tipe": "paragraph", "text": "$2\\cos^2 x - 1 - 3\\cos x + 2 = 0 \\Rightarrow 2\\cos^2 x - 3\\cos x + 1 = 0$." },
        { "tipe": "paragraph", "text": "Faktorkan: $(2\\cos x - 1)(\\cos x - 1) = 0$." },
        { "tipe": "paragraph", "text": "$\\cos x = \\dfrac{1}{2} \\Rightarrow x = 60°, 300°$." },
        { "tipe": "paragraph", "text": "$\\cos x = 1 \\Rightarrow x = 0°, 360°$." },
        { "tipe": "paragraph", "text": "HP = $\\{0°, 60°, 300°, 360°\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan panjang sisi $a = 5$ cm, $b = 6$ cm, dan $\\angle C = 30°$. Luas segitiga tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$15$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$30$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} a b \\sin C$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}(5)(6)\\sin 30° = 15 \\cdot \\dfrac{1}{2} = \\dfrac{15}{2}$ cm²." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 75° + \\sin 15°}{\\cos 75° - \\cos 15°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus jumlah ke perkalian:" },
        { "tipe": "paragraph", "text": "$\\sin 75° + \\sin 15° = 2\\sin 45° \\cos 30°$." },
        { "tipe": "paragraph", "text": "$\\cos 75° - \\cos 15° = -2\\sin 45° \\sin 30°$." },
        { "tipe": "paragraph", "text": "Rasio: $\\dfrac{2\\sin 45° \\cos 30°}{-2\\sin 45° \\sin 30°} = -\\dfrac{\\cos 30°}{\\sin 30°} = -\\cot 30° = -\\sqrt{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\theta = \\dfrac{1}{3}$ dan $\\theta$ di kuadran II, maka nilai $\\sin 3\\theta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{23}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{23}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{17}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\sin 3\\theta = 3\\sin \\theta - 4\\sin^3 \\theta$." },
        { "tipe": "paragraph", "text": "$\\sin 3\\theta = 3\\left(\\dfrac{1}{3}\\right) - 4\\left(\\dfrac{1}{3}\\right)^3$." },
        { "tipe": "paragraph", "text": "$= 1 - 4\\left(\\dfrac{1}{27}\\right) = 1 - \\dfrac{4}{27} = \\dfrac{23}{27}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan sisi $a = 8$ cm, $b = 6$ cm, dan $c = 4$ cm. Nilai $\\cos A$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan cosinus: $\\cos A = \\dfrac{b^2 + c^2 - a^2}{2bc}$." },
        { "tipe": "paragraph", "text": "$\\cos A = \\dfrac{6^2 + 4^2 - 8^2}{2(6)(4)} = \\dfrac{36 + 16 - 64}{48}$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{-12}{48} = -\\dfrac{1}{4}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\tan 10° \\cdot \\tan 50° \\cdot \\tan 70°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\tan 10° \\tan 50° \\tan 70° = \\tan 30° = \\dfrac{1}{3}\\sqrt{3}$." },
        { "tipe": "paragraph", "text": "(Bisa dibuktikan menggunakan identitas $\\tan 3\\theta$ pada $\\theta = 10°$ dan fakta bahwa $\\tan 30° = \\tan(3 \\cdot 10°)$.)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\sin x + \\sqrt{3}\\cos x = 2$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{30°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 330°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ubah bentuk $a\\sin x + b\\cos x = R\\sin(x + \\alpha)$ dengan $R = \\sqrt{a^2+b^2} = \\sqrt{1+3} = 2$." },
        { "tipe": "paragraph", "text": "$\\sin x + \\sqrt{3}\\cos x = 2\\sin(x + 60°)$." },
        { "tipe": "paragraph", "text": "Persamaan menjadi $2\\sin(x + 60°) = 2 \\Rightarrow \\sin(x + 60°) = 1$." },
        { "tipe": "paragraph", "text": "$x + 60° = 90° + k \\cdot 360° \\Rightarrow x = 30° + k \\cdot 360°$." },
        { "tipe": "paragraph", "text": "Untuk $k=0$: $x = 30°$." },
        { "tipe": "paragraph", "text": "HP = $\\{30°\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos x = \\dfrac{3}{5}$ dan $x$ berada di kuadran IV, maka nilai $\\tan 2x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{24}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{12}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran IV: $\\cos x = \\dfrac{3}{5}$, $\\sin x = -\\dfrac{4}{5}$, $\\tan x = -\\dfrac{4}{3}$." },
        { "tipe": "paragraph", "text": "$\\tan 2x = \\dfrac{2\\tan x}{1 - \\tan^2 x}$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{2(-\\frac{4}{3})}{1 - (-\\frac{4}{3})^2} = \\dfrac{-\\frac{8}{3}}{1 - \\frac{16}{9}} = \\dfrac{-\\frac{8}{3}}{-\\frac{7}{9}}$." },
        { "tipe": "paragraph", "text": "$= -\\dfrac{8}{3} \\cdot \\left(-\\dfrac{9}{7}\\right) = \\dfrac{24}{7}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
