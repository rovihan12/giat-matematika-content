{
  "id": "bs-k10-trig-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang identitas trigonometri, deret trigonometri, dan aturan segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^2 10° + \\sin^2 20° + \\sin^2 40° + \\sin^2 50° + \\sin^2 70° + \\sin^2 80°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pasangkan sudut berpenyiku menggunakan $\\sin^2 \\theta + \\sin^2(90° - \\theta) = \\sin^2 \\theta + \\cos^2 \\theta = 1$**" },
        { "formula_block", "latex": "(\\sin^2 10° + \\sin^2 80°) + (\\sin^2 20° + \\sin^2 70°) + (\\sin^2 40° + \\sin^2 50°) = 1 + 1 + 1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai penjumlahan tersebut adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan \\alpha = \\dfrac{1}{2}$ dan $\\tan \\beta = \\dfrac{1}{3}$, maka nilai $\\alpha + \\beta$ (dalam derajat) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45°$" } ],
        [ { "tipe": "paragraph", "text": "$30°$" } ],
        [ { "tipe": "paragraph", "text": "$60°$" } ],
        [ { "tipe": "paragraph", "text": "$75°$" } ],
        [ { "tipe": "paragraph", "text": "$90°$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung $\\tan(\\alpha + \\beta)$ menggunakan rumus jumlah tangen**" },
        { "formula_block", "latex": "\\tan(\\alpha + \\beta) = \\dfrac{\\tan \\alpha + \\tan \\beta}{1 - \\tan \\alpha \\tan \\beta} = \\dfrac{\\frac{1}{2} + \\frac{1}{3}}{1 - \\frac{1}{2} \\cdot \\frac{1}{3}} = \\dfrac{\\frac{5}{6}}{\\frac{5}{6}} = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan besar sudut $\\alpha + \\beta$ dari $\\tan(\\alpha + \\beta) = 1$**" },
        { "formula_block", "latex": "\\alpha + \\beta = 45°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\alpha + \\beta$ adalah **45°**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\cos 2x - 3\\cos x + 2 = 0$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{0°, 60°, 300°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 180°, 360°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{180°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{0°, 360°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $\\cos 2x = 2\\cos^2 x - 1$ lalu faktorkan**" },
        { "formula_block", "latex": "(2\\cos^2 x - 1) - 3\\cos x + 2 = 0 \\Rightarrow 2\\cos^2 x - 3\\cos x + 1 = 0 \\Rightarrow (2\\cos x - 1)(\\cos x - 1) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan semua nilai $x$ pada interval $0° \\le x \\le 360°$**" },
        { "formula_block", "\\cos x = \\dfrac{1}{2} \\Rightarrow x = 60°, 300°; \\qquad \\cos x = 1 \\Rightarrow x = 0°, 360°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{0°, 60°, 300°, 360°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan panjang sisi $a = 5$ cm, $b = 6$ cm, dan $\\angle C = 30°$. Luas segitiga tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$15$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{2}\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$30$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung luas segitiga menggunakan $L = \\dfrac{1}{2} a b \\sin C$ dengan $a = 5$, $b = 6$, dan $\\angle C = 30°$**" },
        { "formula_block", "latex": "L = \\dfrac{1}{2}(5)(6)\\sin 30° = 15 \\cdot \\dfrac{1}{2} = \\dfrac{15}{2}\\text{ cm}^2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas segitiga tersebut adalah **$\\dfrac{15}{2}$ cm²**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 75° + \\sin 15°}{\\cos 75° - \\cos 15°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah pembilang dan penyebut menjadi bentuk perkalian**" },
        { "formula_block", "latex": "\\dfrac{\\sin 75° + \\sin 15°}{\\cos 75° - \\cos 15°} = \\dfrac{2\\sin 45° \\cos 30°}{-2\\sin 45° \\sin 30°} = -\\dfrac{\\cos 30°}{\\sin 30°}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan rasio menjadi $-\\cot 30°$**" },
        { "formula_block", "latex": "-\\cot 30° = -\\sqrt{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai pecahan tersebut adalah **$-\\sqrt{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\theta = \\dfrac{1}{3}$ dan $\\theta$ di kuadran II, maka nilai $\\sin 3\\theta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{23}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{23}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{17}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas $\\sin 3\\theta = 3\\sin \\theta - 4\\sin^3 \\theta$ dengan $\\sin \\theta = \\dfrac{1}{3}$**" },
        { "formula_block", "latex": "\\sin 3\\theta = 3\\left(\\dfrac{1}{3}\\right) - 4\\left(\\dfrac{1}{3}\\right)^3 = 1 - \\dfrac{4}{27} = \\dfrac{23}{27}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin 3\\theta$ adalah **$\\dfrac{23}{27}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan sisi $a = 8$ cm, $b = 6$ cm, dan $c = 4$ cm. Nilai $\\cos A$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan aturan cosinus untuk sudut $A$ dengan $a = 8$, $b = 6$, dan $c = 4$**" },
        { "formula_block", "latex": "\\cos A = \\dfrac{b^2 + c^2 - a^2}{2bc} = \\dfrac{6^2 + 4^2 - 8^2}{2(6)(4)} = \\dfrac{36 + 16 - 64}{48} = \\dfrac{-12}{48} = -\\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos A$ adalah **$-\\dfrac{1}{4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\tan 10° \\cdot \\tan 50° \\cdot \\tan 70°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas perkalian tangen $\\tan \\theta \\tan(60° - \\theta)\\tan(60° + \\theta) = \\tan 3\\theta$ untuk $\\theta = 10°$**" },
        { "formula_block", "latex": "\\tan 10° \\cdot \\tan 50° \\cdot \\tan 70° = \\tan(3 \\times 10°) = \\tan 30° = \\dfrac{1}{3}\\sqrt{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai perkalian tersebut adalah **$\\dfrac{1}{3}\\sqrt{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\sin x + \\sqrt{3}\\cos x = 2$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{30°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 330°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah $\\sin x + \\sqrt{3}\\cos x$ ke bentuk $R\\sin(x + \\alpha)$ dengan $R = \\sqrt{1^2 + (\\sqrt{3})^2} = 2$ dan $\\alpha = 60°$**" },
        { "formula_block", "latex": "2\\sin(x + 60°) = 2 \\Rightarrow \\sin(x + 60°) = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan untuk $0° \\le x \\le 360°$**" },
        { "formula_block", "latex": "x + 60° = 90° + k \\cdot 360° \\Rightarrow x = 30°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{30°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos x = \\dfrac{3}{5}$ dan $x$ berada di kuadran IV, maka nilai $\\tan 2x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{24}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{12}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\tan x = -\\dfrac{4}{3}$ di kuadran IV lalu hitung $\\tan 2x$**" },
        { "formula_block", "latex": "\\tan 2x = \\dfrac{2\\tan x}{1 - \\tan^2 x} = \\dfrac{2\\left(-\\frac{4}{3}\\right)}{1 - \\left(-\\frac{4}{3}\\right)^2} = \\dfrac{-\\frac{8}{3}}{-\\frac{7}{9}} = \\dfrac{24}{7}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\tan 2x$ adalah **$\\dfrac{24}{7}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
