{
  "id": "bs-k10-trig-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang identitas trigonometri lanjutan, persamaan, dan geometri segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\alpha + \\cos \\alpha = \\dfrac{1}{3}$, maka nilai $\\sin 2\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{8}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas persamaan $\\sin \\alpha + \\cos \\alpha = \\dfrac{1}{3}$**" },
        { "formula_block", "latex": "(\\sin \\alpha + \\cos \\alpha)^2 = \\left(\\dfrac{1}{3}\\right)^2 \\Rightarrow \\sin^2 \\alpha + 2\\sin \\alpha \\cos \\alpha + \\cos^2 \\alpha = \\dfrac{1}{9}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan identitas $\\sin^2 \\alpha + \\cos^2 \\alpha = 1$ dan $2\\sin \\alpha \\cos \\alpha = \\sin 2\\alpha$**" },
        { "formula_block", "latex": "1 + \\sin 2\\alpha = \\dfrac{1}{9} \\Rightarrow \\sin 2\\alpha = \\dfrac{1}{9} - 1 = -\\dfrac{8}{9}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin 2\\alpha$ adalah **$-\\dfrac{8}{9}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\tan 65° + \\tan 25°}{1 - \\tan 65° \\tan 25°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\infty$ (tidak terdefinisi)" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus penjumlahan sudut tangen $\\tan(A + B) = \\dfrac{\\tan A + \\tan B}{1 - \\tan A \\tan B}$**" },
        { "formula_block", "latex": "\\dfrac{\\tan 65° + \\tan 25°}{1 - \\tan 65° \\tan 25°} = \\tan(65° + 25°) = \\tan 90°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai $\\tan 90°$ **tidak terdefinisi** ($\\infty$)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2\\sin^2 x - 3\\cos x = 0$ untuk $0° \\le x \\le 360°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{60°, 300°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{120°, 240°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 330°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{60°, 120°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{300°, 240°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $\\sin^2 x = 1 - \\cos^2 x$ dan faktorkan persamaan kuadrat dalam $\\cos x$**" },
        { "formula_block", "latex": "2(1 - \\cos^2 x) - 3\\cos x = 0 \\Rightarrow 2\\cos^2 x + 3\\cos x - 2 = 0 \\Rightarrow (2\\cos x - 1)(\\cos x + 2) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ pada interval $0° \\le x \\le 360°$ (abaikan $\\cos x = -2$)**" },
        { "formula_block", "latex": "\\cos x = \\dfrac{1}{2} \\Rightarrow x = 60°, 300°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$\\{60°, 300°\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan $a = 6$ cm, $b = 8$ cm, dan $c = 10$ cm. Nilai $\\sin A$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Periksa tripel Pythagoras untuk memastikan segitiga siku-siku di $C$**" },
        { "formula_block", "latex": "a^2 + b^2 = 6^2 + 8^2 = 36 + 64 = 100 = 10^2 = c^2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sin A = \\dfrac{\\text{sisi depan } A}{\\text{sisi miring}} = \\dfrac{a}{c}$**" },
        { "formula_block", "latex": "\\sin A = \\dfrac{6}{10} = \\dfrac{3}{5}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\sin A$ adalah **$\\dfrac{3}{5}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $ABC$ berikut. Jika $\\angle A = 45°$ dan $AB = 8\\sqrt{2}$ cm, maka panjang $BC$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sulit/segitiga-siku-45-8.png",
          "caption": "Segitiga siku-siku ABC, siku-siku di B. AB = 8√2 cm, sudut A = 45°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$16$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$16\\sqrt{2}$ cm" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan perbandingan $\\tan 45° = \\dfrac{BC}{AB}$ dengan $AB = 8\\sqrt{2}\\text{ cm}$**" },
        { "formula_block", "latex": "\\tan 45° = \\dfrac{BC}{8\\sqrt{2}} \\Rightarrow 1 = \\dfrac{BC}{8\\sqrt{2}} \\Rightarrow BC = 8\\sqrt{2}\\text{ cm}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, panjang $BC$ adalah **$8\\sqrt{2}$ cm**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 10° \\cdot \\sin 50° \\cdot \\sin 70°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas $\\sin \\theta \\sin(60° - \\theta)\\sin(60° + \\theta) = \\dfrac{1}{4}\\sin 3\\theta$ untuk $\\theta = 10°$**" },
        { "formula_block", "latex": "\\sin 10° \\cdot \\sin 50° \\cdot \\sin 70° = \\dfrac{1}{4}\\sin(3 \\times 10°) = \\dfrac{1}{4}\\sin 30° = \\dfrac{1}{4} \\cdot \\dfrac{1}{2} = \\dfrac{1}{8}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai perkalian tersebut adalah **$\\dfrac{1}{8}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan x = 2$, maka nilai $\\cos 2x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $\\tan x = 2$ ke identitas $\\cos 2x = \\dfrac{1 - \\tan^2 x}{1 + \\tan^2 x}$**" },
        { "formula_block", "latex": "\\cos 2x = \\dfrac{1 - 2^2}{1 + 2^2} = \\dfrac{1 - 4}{1 + 4} = -\\dfrac{3}{5}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos 2x$ adalah **$-\\dfrac{3}{5}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 40° + \\cos 80° + \\cos 160°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jumlah cosinus pada $\\cos 40° + \\cos 80°$**" },
        { "formula_block", "latex": "\\cos 40° + \\cos 80° = 2\\cos 60° \\cos 20° = 2\\left(\\dfrac{1}{2}\\right)\\cos 20° = \\cos 20°" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tambahkan $\\cos 160° = -\\cos 20°$**" },
        { "formula_block", "latex": "\\cos 20° + (-\\cos 20°) = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai penjumlahan tersebut adalah **$0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyaknya solusi dari persamaan $\\sin x = \\dfrac{1}{2}$ untuk $0° \\le x \\le 720°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan semua nilai $x$ pada interval $0° \\le x \\le 720°$ yang memenuhi $\\sin x = \\dfrac{1}{2}$**" },
        { "formula_block", "latex": "x = 30°, 150°, 390°, 510°" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, banyaknya solusi pada interval tersebut adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-trig-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\sin \\theta = \\dfrac{12}{13}$ dan $\\theta$ berada di kuadran II. Nilai $\\cos 3\\theta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2035}{2197}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2035}{2197}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{117}{169}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{117}{169}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $\\cos \\theta$ di kuadran II (bernilai negatif) dari $\\sin \\theta = \\dfrac{12}{13}$**" },
        { "formula_block", "latex": "\\cos \\theta = -\\sqrt{1 - \\left(\\dfrac{12}{13}\\right)^2} = -\\dfrac{5}{13}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\cos 3\\theta = 4\\cos^3 \\theta - 3\\cos \\theta$**" },
        { "formula_block", "latex": "\\cos 3\\theta = 4\\left(-\\dfrac{5}{13}\\right)^3 - 3\\left(-\\dfrac{5}{13}\\right) = -\\dfrac{500}{2197} + \\dfrac{2535}{2197} = \\dfrac{2035}{2197}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\cos 3\\theta$ adalah **$\\dfrac{2035}{2197}$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
