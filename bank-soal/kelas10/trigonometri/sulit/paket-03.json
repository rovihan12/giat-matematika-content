"deskripsi": "Soal sulit tentang persamaan trigonometri dan aplikasi",

"versi": "1.0.0",

"soal": [

{

"id": "bs-k10-trig-sulit-03-q01",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2\\cos^2 x - \\cos x - 1 = 0$ untuk $0^\\circ \\leq x \\leq 360^\\circ$ adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\{0^\\circ, 120^\\circ, 240^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{60^\\circ, 180^\\circ, 300^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{0^\\circ, 60^\\circ, 300^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{120^\\circ, 240^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{0^\\circ, 120^\\circ\\}$" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Faktorkan persamaan kuadrat dalam $\\cos x$**" },

{ "tipe": "paragraph", "text": "Misalkan $y = \\cos x$: $2y^2 - y - 1 = 0 \\Rightarrow (2y + 1)(y - 1) = 0$, sehingga $\\cos x = -\\dfrac{1}{2}$ atau $\\cos x = 1$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$ pada interval $0^\\circ \\leq x \\leq 360^\\circ$**" },

{ "tipe": "paragraph", "text": "• $\\cos x = -\\dfrac{1}{2} \\Rightarrow x = 120^\\circ$ atau $x = 240^\\circ$." },

{ "tipe": "paragraph", "text": "• $\\cos x = 1 \\Rightarrow x = 0^\\circ$ (dan $360^\\circ$)." },

{ "tipe": "paragraph", "text": "Pada pilihan yang tersedia, himpunan penyelesaian yang bersesuaian adalah $\\{0^\\circ, 120^\\circ, 240^\\circ\\}$." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q02",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Sebuah segitiga memiliki sisi $a = 5$ cm, $b = 7$ cm, dan $c = 8$ cm. Luas segitiga tersebut adalah..." },

{

"tipe": "image",

"src": "images/kelas10/trigonometri/sulit/segitiga-5-7-8-luas.png",

"caption": "Segitiga ABC dengan a = BC = 5, b = AC = 7, c = AB = 8 (sisi huruf kecil di hadapan sudut huruf besar).",

"width": "medium"

}

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$10\\sqrt{3}$ cm²" } ],

[ { "tipe": "paragraph", "text": "$12\\sqrt{3}$ cm²" } ],

[ { "tipe": "paragraph", "text": "$15\\sqrt{3}$ cm²" } ],

[ { "tipe": "paragraph", "text": "$20\\sqrt{3}$ cm²" } ],

[ { "tipe": "paragraph", "text": "$24\\sqrt{3}$ cm²" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Hitung setengah keliling segitiga ($s$)**" },

{ "tipe": "paragraph", "text": "$s = \\dfrac{a + b + c}{2} = \\dfrac{5 + 7 + 8}{2} = \\dfrac{20}{2} = 10$ cm." },

{ "tipe": "paragraph", "text": "**Langkah 2: Hitung luas segitiga menggunakan rumus Heron**" },

{ "tipe": "paragraph", "text": "$L = \\sqrt{s(s - a)(s - b)(s - c)} = \\sqrt{10(10 - 5)(10 - 7)(10 - 8)} = \\sqrt{10 \\cdot 5 \\cdot 3 \\cdot 2} = \\sqrt{300} = 10\\sqrt{3}$ cm²." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q03",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Nilai $\\sin 18^\\circ \\cdot \\sin 54^\\circ$ adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{3}}{4}$" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Terapkan rumus perkalian sinus**" },

{ "tipe": "paragraph", "text": "$\\sin A \\sin B = -\\dfrac{1}{2}[\\cos(A + B) - \\cos(A - B)] = \\dfrac{1}{2}[\\cos(A - B) - \\cos(A + B)]$." },

{ "tipe": "paragraph", "text": "Untuk $A = 18^\\circ$ dan $B = 54^\\circ$: $\\sin 18^\\circ \\cdot \\sin 54^\\circ = \\dfrac{1}{2}[\\cos(-36^\\circ) - \\cos 72^\\circ] = \\dfrac{1}{2}(\\cos 36^\\circ - \\cos 72^\\circ)$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai eksak $\\cos 36^\\circ$ dan $\\cos 72^\\circ$**" },

{ "tipe": "paragraph", "text": "Dengan $\\cos 36^\\circ = \\dfrac{\\sqrt{5} + 1}{4}$ dan $\\cos 72^\\circ = \\dfrac{\\sqrt{5} - 1}{4}$, diperoleh:" },

{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\left(\\dfrac{\\sqrt{5} + 1}{4} - \\dfrac{\\sqrt{5} - 1}{4}\\right) = \\dfrac{1}{2} \\cdot \\dfrac{2}{4} = \\dfrac{1}{4}$." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q04",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Jika $\\sin \\alpha \\cos \\alpha = \\dfrac{2}{5}$, maka nilai $\\sin^4 \\alpha + \\cos^4 \\alpha$ adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\dfrac{17}{25}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{18}{25}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{19}{25}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{21}{25}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{23}{25}$" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Nyatakan $\\sin^4 \\alpha + \\cos^4 \\alpha$ dalam bentuk kuadrat identitas Pythagoras**" },

{ "tipe": "paragraph", "text": "$\\sin^4 \\alpha + \\cos^4 \\alpha = (\\sin^2 \\alpha + \\cos^2 \\alpha)^2 - 2\\sin^2 \\alpha \\cos^2 \\alpha = 1^2 - 2(\\sin \\alpha \\cos \\alpha)^2$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $\\sin \\alpha \\cos \\alpha = \\dfrac{2}{5}$**" },

{ "tipe": "paragraph", "text": "$1 - 2\\left(\\dfrac{2}{5}\\right)^2 = 1 - 2 \\cdot \\dfrac{4}{25} = 1 - \\dfrac{8}{25} = \\dfrac{17}{25}$." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q05",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\tan 2x = \\sqrt{3}$ untuk $0^\\circ \\leq x \\leq 180^\\circ$ adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\{30^\\circ, 120^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{30^\\circ, 150^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{60^\\circ, 120^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{60^\\circ, 180^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{30^\\circ, 60^\\circ, 120^\\circ, 150^\\circ\\}$" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Tentukan rumus umum penyelesaian persamaan tangen**" },

{ "tipe": "paragraph", "text": "Karena $\\tan 60^\\circ = \\sqrt{3}$, maka $\\tan 2x = \\tan 60^\\circ \\Rightarrow 2x = 60^\\circ + k \\cdot 180^\\circ$, sehingga $x = 30^\\circ + k \\cdot 90^\\circ$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Substitusikan bilangan bulat $k$ pada interval $0^\\circ \\leq x \\leq 180^\\circ$**" },

{ "tipe": "paragraph", "text": "• $k = 0 \\Rightarrow x = 30^\\circ$" },

{ "tipe": "paragraph", "text": "• $k = 1 \\Rightarrow x = 120^\\circ$" },

{ "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $\\{30^\\circ, 120^\\circ\\}$." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q06",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Sebuah pesawat terbang dengan sudut elevasi 30° dari titik A. Setelah 5 km, pilot mengubah sudut menjadi 45° dari titik B yang sama tinggi dengan A. Jarak horizontal total dari A ke posisi akhir pesawat jika jarak A-B = 2 km adalah..." },

{

"tipe": "image",

"src": "images/kelas10/trigonometri/sulit/pesawat-2-sudut.png",

"caption": "Pesawat dengan dua sudut elevasi dari titik A dan B yang berjarak 2 km.",

"width": "medium"

}

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\sqrt{3} + 1$ km" } ],

[ { "tipe": "paragraph", "text": "$\\sqrt{3} + 2$ km" } ],

[ { "tipe": "paragraph", "text": "$2\\sqrt{3}$ km" } ],

[ { "tipe": "paragraph", "text": "$3$ km" } ],

[ { "tipe": "paragraph", "text": "$2 + 2\\sqrt{3}$ km" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Nyatakan jarak horizontal dari titik pengamatan ke proyeksi tegak lurus pesawat ($C$)**" },

{ "tipe": "paragraph", "text": "Misalkan ketinggian pesawat adalah $h$:" },

{ "tipe": "paragraph", "text": "• Dari titik $A$: $\\tan 30^\\circ = \\dfrac{h}{AC} \\Rightarrow AC = \\dfrac{h}{\\tan 30^\\circ} = h\\sqrt{3}$." },

{ "tipe": "paragraph", "text": "• Dari titik $B$: $\\tan 45^\\circ = \\dfrac{h}{BC} \\Rightarrow BC = \\dfrac{h}{\\tan 45^\\circ} = h$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Hubungkan $AC$, $BC$, dan $AB = 2$ km**" },

{ "tipe": "paragraph", "text": "Dengan $B$ berada di antara $A$ dan $C$, berlaku $AC = AB + BC \\Rightarrow h\\sqrt{3} = 2 + h$, sehingga $h(\\sqrt{3} - 1) = 2$ dan $h = \\dfrac{2}{\\sqrt{3} - 1} = \\sqrt{3} + 1$ km (bersesuaian dengan pilihan $\\sqrt{3} + 1$ km)." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q07",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\tan 40^\\circ + \\tan 20^\\circ}{1 - \\tan 40^\\circ \\tan 20^\\circ}$ adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],

[ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],

[ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ],

[ { "tipe": "paragraph", "text": "$3\\sqrt{3}$" } ]

],

"jawaban_benar": 2,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus penjumlahan sudut pada tangen**" },

{ "tipe": "paragraph", "text": "$\\tan(A + B) = \\dfrac{\\tan A + \\tan B}{1 - \\tan A \\tan B}$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $A = 40^\\circ$ dan $B = 20^\\circ$**" },

{ "tipe": "paragraph", "text": "$\\dfrac{\\tan 40^\\circ + \\tan 20^\\circ}{1 - \\tan 40^\\circ \\tan 20^\\circ} = \\tan(40^\\circ + 20^\\circ) = \\tan 60^\\circ = \\sqrt{3}$." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q08",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Nilai dari $\\sin^6 \\alpha + \\cos^6 \\alpha$ jika $\\sin \\alpha \\cos \\alpha = \\dfrac{1}{3}$ adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{5}{9}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{2}{9}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{7}{9}$" } ],

[ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Jabarkan $\\sin^6 \\alpha + \\cos^6 \\alpha$ sebagai jumlah pangkat tiga**" },

{ "tipe": "paragraph", "text": "$\\sin^6 \\alpha + \\cos^6 \\alpha = (\\sin^2 \\alpha + \\cos^2 \\alpha)^3 - 3\\sin^2 \\alpha \\cos^2 \\alpha(\\sin^2 \\alpha + \\cos^2 \\alpha) = 1^3 - 3(\\sin \\alpha \\cos \\alpha)^2(1)$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $\\sin \\alpha \\cos \\alpha = \\dfrac{1}{3}$**" },

{ "tipe": "paragraph", "text": "$1 - 3\\left(\\dfrac{1}{3}\\right)^2 = 1 - 3 \\cdot \\dfrac{1}{9} = 1 - \\dfrac{1}{3} = \\dfrac{2}{3}$." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q09",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\sin x + \\cos x = 1$ untuk $0^\\circ \\leq x \\leq 360^\\circ$ adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$\\{0^\\circ, 90^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{0^\\circ, 180^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{90^\\circ, 180^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{0^\\circ, 90^\\circ, 180^\\circ, 360^\\circ\\}$" } ],

[ { "tipe": "paragraph", "text": "$\\{0^\\circ, 90^\\circ, 360^\\circ\\}$" } ]

],

"jawaban_benar": 0,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Ubah $\\sin x + \\cos x$ ke bentuk $k\\sin(x + \\alpha)$**" },

{ "tipe": "paragraph", "text": "Dengan $k = \\sqrt{1^2 + 1^2} = \\sqrt{2}$ dan $\\alpha = 45^\\circ$, diperoleh $\\sqrt{2}\\sin(x + 45^\\circ) = 1 \\Rightarrow \\sin(x + 45^\\circ) = \\dfrac{1}{2}\\sqrt{2}$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Selesaikan untuk $0^\\circ \\leq x \\leq 360^\\circ$**" },

{ "tipe": "paragraph", "text": "• $x + 45^\\circ = 45^\\circ \\Rightarrow x = 0^\\circ$" },

{ "tipe": "paragraph", "text": "• $x + 45^\\circ = 135^\\circ \\Rightarrow x = 90^\\circ$" },

{ "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $\\{0^\\circ, 90^\\circ\\}$." }

],

"tingkat": "SULIT"

},

{

"id": "bs-k10-trig-sulit-03-q10",

"pertanyaan": [

{ "tipe": "paragraph", "text": "Jika $\\tan x = \\dfrac{3}{4}$ dan $\\tan y = \\dfrac{1}{7}$, nilai $x + y$ (dalam derajat) adalah..." }

],

"pilihan": [

[ { "tipe": "paragraph", "text": "$30^\\circ$" } ],

[ { "tipe": "paragraph", "text": "$45^\\circ$" } ],

[ { "tipe": "paragraph", "text": "$60^\\circ$" } ],

[ { "tipe": "paragraph", "text": "$75^\\circ$" } ],

[ { "tipe": "paragraph", "text": "$90^\\circ$" } ]

],

"jawaban_benar": 1,

"pembahasan": [

{ "tipe": "paragraph", "text": "**Langkah 1: Hitung $\\tan(x + y)$ menggunakan rumus jumlah tangen**" },

{ "tipe": "paragraph", "text": "$\\tan(x + y) = \\dfrac{\\tan x + \\tan y}{1 - \\tan x \\tan y} = \\dfrac{\\frac{3}{4} + \\frac{1}{7}}{1 - \\frac{3}{4} \\cdot \\frac{1}{7}} = \\dfrac{\\frac{21 + 4}{28}}{1 - \\frac{3}{28}} = \\dfrac{\\frac{25}{28}}{\\frac{25}{28}} = 1$." },

{ "tipe": "paragraph", "text": "**Langkah 2: Tentukan besar sudut $x + y$**" },

{ "tipe": "paragraph", "text": "Karena $\\tan(x + y) = 1$, maka $x + y = 45^\\circ$." }

],

"tingkat": "SULIT"

}

]

}
