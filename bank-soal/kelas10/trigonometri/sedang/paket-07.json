{
  "id": "bs-k10-trig-s-07",
  "nama": "Bank Soal Sedang - Paket 7 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang identitas trigonometri, sudut rangkap, dan persamaan dasar (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-s-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\alpha = \\dfrac{4}{5}$ dan $\\alpha$ berada di kuadran I, maka nilai $\\cos 2\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{9}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{25}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas sudut rangkap: $\\cos 2\\alpha = 1 - 2\\sin^2 \\alpha$." },
        { "tipe": "paragraph", "text": "$\\cos 2\\alpha = 1 - 2\\left(\\dfrac{4}{5}\\right)^2 = 1 - 2\\left(\\dfrac{16}{25}\\right)$." },
        { "tipe": "paragraph", "text": "$= 1 - \\dfrac{32}{25} = \\dfrac{25}{25} - \\dfrac{32}{25} = -\\dfrac{7}{25}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 15° \\cdot \\cos 75°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 - \\sqrt{3}}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 + \\sqrt{3}}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1 - \\sqrt{3}}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{3} - 1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\cos 75° = \\cos(90° - 15°) = \\sin 15°$." },
        { "tipe": "paragraph", "text": "Maka $\\sin 15° \\cdot \\cos 75° = \\sin 15° \\cdot \\sin 15° = \\sin^2 15°$." },
        { "tipe": "paragraph", "text": "Gunakan rumus reduksi pangkat: $\\sin^2 15° = \\dfrac{1 - \\cos 30°}{2} = \\dfrac{1 - \\frac{\\sqrt{3}}{2}}{2} = \\dfrac{2 - \\sqrt{3}}{4}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persamaan $2\\sin^2 x + \\sin x - 1 = 0$ memiliki himpunan penyelesaian untuk $0° \\le x \\le 360°$. Nilai $x$ yang memenuhi adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{30°, 150°, 270°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 150°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{90°, 270°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 270°\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{30°, 90°, 150°\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktorkan persamaan $2\\sin^2 x + \\sin x - 1 = 0$:" },
        { "tipe": "paragraph", "text": "$(2\\sin x - 1)(\\sin x + 1) = 0$" },
        { "tipe": "paragraph", "text": "Maka $\\sin x = \\dfrac{1}{2}$ atau $\\sin x = -1$." },
        { "tipe": "paragraph", "text": "Untuk $\\sin x = \\dfrac{1}{2} \\Rightarrow x = 30°, 150°$." },
        { "tipe": "paragraph", "text": "Untuk $\\sin x = -1 \\Rightarrow x = 270°$." },
        { "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $\\{30°, 150°, 270°\\}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\tan 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3} - 1$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3} + 1$" } ],
        [ { "tipe": "paragraph", "text": "$3 - \\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\tan 15° = \\tan(45° - 30°) = \\dfrac{\\tan 45° - \\tan 30°}{1 + \\tan 45° \\tan 30°}$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{1 - \\frac{1}{3}\\sqrt{3}}{1 + \\frac{1}{3}\\sqrt{3}} = \\dfrac{3 - \\sqrt{3}}{3 + \\sqrt{3}}$." },
        { "tipe": "paragraph", "text": "Rasionalkan penyebut: $\\dfrac{(3 - \\sqrt{3})^2}{9 - 3} = \\dfrac{12 - 6\\sqrt{3}}{6} = 2 - \\sqrt{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga $ABC$ berikut. Jika $a = 4$ cm, $b = 6$ cm, dan $C = 60°$, maka panjang sisi $c$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/segitiga-cos-4-6-60.png",
          "caption": "Segitiga ABC dengan sisi a = 4 cm, b = 6 cm, dan sudut C = 60°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2\\sqrt{7}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{28}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan aturan kosinus: $c^2 = a^2 + b^2 - 2ab \\cos C$." },
        { "tipe": "paragraph", "text": "$c^2 = 4^2 + 6^2 - 2(4)(6)\\cos 60°$." },
        { "tipe": "paragraph", "text": "$= 16 + 36 - 48 \\cdot \\dfrac{1}{2} = 52 - 24 = 28$." },
        { "tipe": "paragraph", "text": "$c = \\sqrt{28} = 2\\sqrt{7}$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 20° \\cos 40° \\cos 80°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan ekspresi dengan $\\dfrac{2\\sin 20°}{2\\sin 20°}$:" },
        { "tipe": "paragraph", "text": "$\\dfrac{2\\sin 20° \\cos 20° \\cos 40° \\cos 80°}{2\\sin 20°} = \\dfrac{\\sin 40° \\cos 40° \\cos 80°}{2\\sin 20°}$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{\\frac{1}{2}\\sin 80° \\cos 80°}{2\\sin 20°} = \\dfrac{\\frac{1}{4}\\sin 160°}{2\\sin 20°}$." },
        { "tipe": "paragraph", "text": "Karena $\\sin 160° = \\sin(180° - 20°) = \\sin 20°$, maka hasil akhirnya adalah $\\dfrac{1}{8}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos \\alpha + \\cos \\beta = 1$ dan $\\cos \\alpha - \\cos \\beta = \\dfrac{1}{3}$, maka nilai $\\cos \\alpha \\cos \\beta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas aljabar: $(\\cos \\alpha + \\cos \\beta)^2 - (\\cos \\alpha - \\cos \\beta)^2 = 4\\cos \\alpha \\cos \\beta$." },
        { "tipe": "paragraph", "text": "$1^2 - \\left(\\dfrac{1}{3}\\right)^2 = 1 - \\dfrac{1}{9} = \\dfrac{8}{9}$." },
        { "tipe": "paragraph", "text": "Maka $4\\cos \\alpha \\cos \\beta = \\dfrac{8}{9} \\Rightarrow \\cos \\alpha \\cos \\beta = \\dfrac{2}{9}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $PQR$ berikut. Jika $PR = 10$ cm dan $\\angle P = 60°$, maka panjang $PQ$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/segitiga-pqr-60.png",
          "caption": "Segitiga siku-siku PQR, siku-siku di Q. PR = 10 cm (sisi miring), sudut P = 60°, cari PQ.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm" } ],
        [ { "tipe": "paragraph", "text": "$20$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos 60° = \\dfrac{PQ}{PR}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{2} = \\dfrac{PQ}{10} \\Rightarrow PQ = 5$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^4 15° + \\cos^4 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan identitas: $\\sin^4 \\alpha + \\cos^4 \\alpha = 1 - 2\\sin^2 \\alpha \\cos^2 \\alpha$." },
        { "tipe": "paragraph", "text": "Karena $\\sin 15° \\cos 15° = \\dfrac{1}{2}\\sin 30° = \\dfrac{1}{4}$," },
        { "tipe": "paragraph", "text": "maka $\\sin^4 15° + \\cos^4 15° = 1 - 2\\left(\\dfrac{1}{4}\\right)^2 = 1 - \\dfrac{2}{16} = 1 - \\dfrac{1}{8} = \\dfrac{7}{8}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\tan \\theta = 2$ dan $\\theta$ berada di kuadran III, maka nilai $\\sin \\theta + \\cos \\theta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3\\sqrt{5}}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3\\sqrt{5}}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{\\sqrt{5}}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{5}}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\sqrt{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\tan \\theta = 2$ → sisi depan = 2, sisi samping = 1, sisi miring = $\\sqrt{2^2 + 1^2} = \\sqrt{5}$." },
        { "tipe": "paragraph", "text": "Di kuadran III, nilai $\\sin$ dan $\\cos$ bernilai negatif." },
        { "tipe": "paragraph", "text": "$\\sin \\theta = -\\dfrac{2}{\\sqrt{5}}$ dan $\\cos \\theta = -\\dfrac{1}{\\sqrt{5}}$." },
        { "tipe": "paragraph", "text": "$\\sin \\theta + \\cos \\theta = -\\dfrac{3}{\\sqrt{5}} = -\\dfrac{3\\sqrt{5}}{5}$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
