{
  "id": "bs-k10-trig-s-06",
  "nama": "Bank Soal Sedang - Paket 6 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang aturan sinus, aturan cosinus, dan luas segitiga (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-trig-s-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga $ABC$ berikut. Jika $A = 45°$, $B = 60°$, dan $a = 8$ cm, maka panjang sisi $b$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/segitiga-sinus-45-60.png",
          "caption": "Segitiga ABC sembarang dengan sudut A = 45°, sudut B = 60°, dan sisi a = 8 cm di hadapan sudut A.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4\\sqrt{6}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{6}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12\\sqrt{2}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan sinus: $\\dfrac{a}{\\sin A} = \\dfrac{b}{\\sin B}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{8}{\\sin 45°} = \\dfrac{b}{\\sin 60°}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{8}{\\frac{1}{2}\\sqrt{2}} = \\dfrac{b}{\\frac{1}{2}\\sqrt{3}}$." },
        { "tipe": "paragraph", "text": "$8\\sqrt{2} = \\dfrac{2b}{\\sqrt{3}} \\Rightarrow b = 4\\sqrt{6}$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $PQR$ dengan panjang sisi $p = 6$ cm, $q = 8$ cm, dan $r = 12$ cm. Nilai $\\cos R$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{11}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{13}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan cosinus: $\\cos R = \\dfrac{p^2 + q^2 - r^2}{2pq}$." },
        { "tipe": "paragraph", "text": "$\\cos R = \\dfrac{6^2 + 8^2 - 12^2}{2 \\cdot 6 \\cdot 8} = \\dfrac{36 + 64 - 144}{96}$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{-44}{96} = -\\dfrac{11}{24}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas segitiga $ABC$ jika diketahui $a = 10$ cm, $b = 14$ cm, dan sudut $C = 150°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$35$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$35\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$70$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$70\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$140$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot a \\cdot b \\cdot \\sin C$." },
        { "tipe": "paragraph", "text": "$\\sin 150° = \\sin(180° - 30°) = \\sin 30° = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot 10 \\cdot 14 \\cdot \\dfrac{1}{2} = 35$ cm²." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\cos 75° \\cdot \\cos 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus: $\\cos A \\cos B = \\dfrac{1}{2}[\\cos(A+B) + \\cos(A-B)]$." },
        { "tipe": "paragraph", "text": "$\\cos 75° \\cos 15° = \\dfrac{1}{2}[\\cos 90° + \\cos 60°]$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}[0 + \\dfrac{1}{2}] = \\dfrac{1}{4}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $ABC$ berikut. Jika panjang $AB = 15$ cm dan $\\angle BAC = 30°$, maka panjang $BC$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/segitiga-siku-30.png",
          "caption": "Segitiga siku-siku ABC, siku-siku di B. AB = 15 cm (sisi samping sudut A), sudut A = 30°, cari BC.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$15\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$30$ cm" } ],
        [ { "tipe": "paragraph", "text": "$7{,}5$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\tan 30° = \\dfrac{BC}{AB}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3} = \\dfrac{BC}{15}$." },
        { "tipe": "paragraph", "text": "$BC = 15 \\cdot \\dfrac{1}{3}\\sqrt{3} = 5\\sqrt{3}$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\sin \\alpha = \\dfrac{7}{25}$ dan $\\alpha$ di kuadran II. Nilai $\\cos \\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{25}{24}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran II, $\\cos \\alpha$ bernilai negatif." },
        { "tipe": "paragraph", "text": "$\\cos^2 \\alpha = 1 - \\sin^2 \\alpha = 1 - \\dfrac{49}{625} = \\dfrac{576}{625}$." },
        { "tipe": "paragraph", "text": "$\\cos \\alpha = -\\dfrac{24}{25}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\tan 50° + \\tan 10°}{1 - \\tan 50° \\tan 10°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus: $\\dfrac{\\tan A + \\tan B}{1 - \\tan A \\tan B} = \\tan(A + B)$." },
        { "tipe": "paragraph", "text": "$= \\tan(50° + 10°) = \\tan 60° = \\sqrt{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah segitiga memiliki sisi $a = 3$ cm, $b = 4$ cm, dan $c = 5$ cm. Luas segitiga tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$24$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$5$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$10$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena $3^2 + 4^2 = 5^2$, segitiga ini siku-siku di hadapan sisi $c = 5$." },
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot a \\cdot b = \\dfrac{1}{2} \\cdot 3 \\cdot 4 = 6$ cm²." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin 105° + \\sin 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{6} + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{6} - \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{6}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus jumlah-sinus: $\\sin A + \\sin B = 2 \\sin\\dfrac{A+B}{2} \\cos\\dfrac{A-B}{2}$." },
        { "tipe": "paragraph", "text": "$\\sin 105° + \\sin 15° = 2 \\sin 60° \\cos 45°$." },
        { "tipe": "paragraph", "text": "$= 2 \\cdot \\dfrac{1}{2}\\sqrt{3} \\cdot \\dfrac{1}{2}\\sqrt{2} = \\dfrac{1}{2}\\sqrt{6}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos \\theta = -\\dfrac{4}{5}$ dan $\\theta$ berada di kuadran III, maka nilai $\\tan \\theta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran III, $\\sin$ negatif dan $\\cos$ negatif, sehingga $\\tan$ positif." },
        { "tipe": "paragraph", "text": "$\\sin \\theta = -\\sqrt{1 - (-4/5)^2} = -\\dfrac{3}{5}$." },
        { "tipe": "paragraph", "text": "$\\tan \\theta = \\dfrac{\\sin \\theta}{\\cos \\theta} = \\dfrac{-3/5}{-4/5} = \\dfrac{3}{4}$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
