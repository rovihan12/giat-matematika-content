{
  "id": "bs-k10-trig-s-02",
  "nama": "Bank Soal Sedang - Paket 2",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang identitas trigonometri dan sudut rangkap",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-trig-s-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin 2\\alpha$ jika $\\sin \\alpha = \\dfrac{5}{13}$ dan $\\alpha$ di kuadran I adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{60}{169}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{100}{169}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{120}{169}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{144}{169}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{169}{120}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin \\alpha = \\dfrac{5}{13}$, $\\alpha$ kuadran I → $\\cos \\alpha = \\dfrac{12}{13}$" },
        { "tipe": "paragraph", "text": "$\\sin 2\\alpha = 2 \\cdot \\dfrac{5}{13} \\cdot \\dfrac{12}{13} = \\dfrac{120}{169}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\cos 2\\alpha$ jika $\\sin \\alpha = \\dfrac{4}{5}$ dan $\\alpha$ di kuadran I adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{25}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos 2\\alpha = 1 - 2\\sin^2 \\alpha = 1 - 2 \\cdot \\dfrac{16}{25} = 1 - \\dfrac{32}{25} = -\\dfrac{7}{25}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\tan 2\\alpha$ jika $\\tan \\alpha = \\dfrac{1}{2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\tan 2\\alpha = \\dfrac{2\\tan \\alpha}{1 - \\tan^2 \\alpha}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{2 \\cdot \\frac{1}{2}}{1 - \\frac{1}{4}} = \\dfrac{1}{\\frac{3}{4}} = \\dfrac{4}{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga berikut. Luas segitiga $ABC$ jika $AB = 10$ cm, $BC = 8$ cm, dan sudut $B = 45°$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/luas-segitiga-2.png",
          "caption": "Segitiga ABC dengan AB = 10 cm, BC = 8 cm, dan sudut B = 45°.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20\\sqrt{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$40\\sqrt{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$80\\sqrt{2}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$40$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$20$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot AB \\cdot BC \\cdot \\sin B$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2} \\cdot 10 \\cdot 8 \\cdot \\sin 45° = 40 \\cdot \\dfrac{1}{2}\\sqrt{2} = 20\\sqrt{2}$ cm²" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\tan 75°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 + \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2 - \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1 + \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1 - \\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\tan 75° = \\tan(45° + 30°) = \\dfrac{\\tan 45° + \\tan 30°}{1 - \\tan 45° \\tan 30°}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1 + \\frac{1}{3}\\sqrt{3}}{1 - \\frac{1}{3}\\sqrt{3}} = \\dfrac{3 + \\sqrt{3}}{3 - \\sqrt{3}} \\cdot \\dfrac{3 + \\sqrt{3}}{3 + \\sqrt{3}}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{(3 + \\sqrt{3})^2}{9 - 3} = \\dfrac{12 + 6\\sqrt{3}}{6} = 2 + \\sqrt{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $2 \\sin 15° \\cos 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus: $2\\sin \\alpha \\cos \\alpha = \\sin 2\\alpha$" },
        { "tipe": "paragraph", "text": "$2 \\sin 15° \\cos 15° = \\sin 30° = \\dfrac{1}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\cos^2 30° - \\sin^2 30°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus: $\\cos^2 \\alpha - \\sin^2 \\alpha = \\cos 2\\alpha$" },
        { "tipe": "paragraph", "text": "$\\cos^2 30° - \\sin^2 30° = \\cos 60° = \\dfrac{1}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin 15° \\cos 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\sqrt{3}}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 15° \\cos 15° = \\dfrac{1}{2} \\sin 30° = \\dfrac{1}{2} \\cdot \\dfrac{1}{2} = \\dfrac{1}{4}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin^2 45° - \\cos^2 45°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin^2 45° - \\cos^2 45° = -\\cos 90° = 0$" },
        { "tipe": "paragraph", "text": "(karena $\\cos 2\\alpha = \\cos^2 \\alpha - \\sin^2 \\alpha$)" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin 105°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{6} + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{6} - \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{6} + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{3} - 1)$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 105° = \\sin(60° + 45°)$" },
        { "tipe": "paragraph", "text": "$= \\sin 60° \\cos 45° + \\cos 60° \\sin 45°$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}\\sqrt{3} \\cdot \\dfrac{1}{2}\\sqrt{2} + \\dfrac{1}{2} \\cdot \\dfrac{1}{2}\\sqrt{2}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{4}(\\sqrt{6} + \\sqrt{2})$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
