{
  "id": "bs-k10-trig-s-09",
  "nama": "Bank Soal Sedang - Paket 9 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang identitas trigonometri, persamaan, dan aturan segitiga (lanjutan)",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-trig-s-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 75° \\cdot \\cos 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 + \\sqrt{3}}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 - \\sqrt{3}}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus: $\\sin A \\cos B = \\dfrac{1}{2}[\\sin(A+B) + \\sin(A-B)]$." },
        { "tipe": "paragraph", "text": "$\\sin 75° \\cos 15° = \\dfrac{1}{2}[\\sin 90° + \\sin 60°]$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}[1 + \\dfrac{1}{2}\\sqrt{3}] = \\dfrac{2 + \\sqrt{3}}{4}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga $ABC$ dengan sisi $a = 7$ cm, $b = 8$ cm, dan sudut $C = 60°$. Panjang sisi $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{57}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{67}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{77}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{87}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{97}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan cosinus: $c^2 = a^2 + b^2 - 2ab \\cos C$." },
        { "tipe": "paragraph", "text": "$c^2 = 7^2 + 8^2 - 2(7)(8)\\cos 60°$." },
        { "tipe": "paragraph", "text": "$= 49 + 64 - 112 \\cdot \\dfrac{1}{2} = 113 - 56 = 57$." },
        { "tipe": "paragraph", "text": "$c = \\sqrt{57}$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\alpha = \\dfrac{3}{5}$ dan $\\alpha$ di kuadran II, maka nilai $\\tan 2\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{24}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{24}{25}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran II: $\\sin \\alpha = \\dfrac{3}{5}$, $\\cos \\alpha = -\\dfrac{4}{5}$, $\\tan \\alpha = -\\dfrac{3}{4}$." },
        { "tipe": "paragraph", "text": "$\\tan 2\\alpha = \\dfrac{2\\tan \\alpha}{1 - \\tan^2 \\alpha}$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{2(-\\frac{3}{4})}{1 - (-\\frac{3}{4})^2} = \\dfrac{-\\frac{3}{2}}{1 - \\frac{9}{16}} = \\dfrac{-\\frac{3}{2}}{\\frac{7}{16}}$." },
        { "tipe": "paragraph", "text": "$= -\\dfrac{3}{2} \\cdot \\dfrac{16}{7} = -\\dfrac{24}{7}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $ABC$ berikut. Jika $AC = 13$ cm dan $BC = 5$ cm, maka nilai $\\sin A$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/segitiga-siku-5-12-13.png",
          "caption": "Segitiga siku-siku ABC, siku-siku di B. Sisi miring AC = 13 cm, sisi tegak BC = 5 cm.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{12}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sisi di hadapan sudut A adalah BC = 5, dan sisi miring adalah AC = 13." },
        { "tipe": "paragraph", "text": "$\\sin A = \\dfrac{BC}{AC} = \\dfrac{5}{13}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\tan 40° + \\tan 20°}{1 - \\tan 40° \\tan 20°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus: $\\dfrac{\\tan A + \\tan B}{1 - \\tan A \\tan B} = \\tan(A + B)$." },
        { "tipe": "paragraph", "text": "$= \\tan(40° + 20°) = \\tan 60° = \\sqrt{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas segitiga $ABC$ jika diketahui $a = 8$ cm, $b = 10$ cm, dan $c = 12$ cm adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15\\sqrt{7}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$20\\sqrt{7}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$25\\sqrt{7}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$30\\sqrt{7}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$10\\sqrt{7}$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan rumus Heron: $s = \\dfrac{8+10+12}{2} = 15$." },
        { "tipe": "paragraph", "text": "$L = \\sqrt{s(s-a)(s-b)(s-c)}$." },
        { "tipe": "paragraph", "text": "$= \\sqrt{15(15-8)(15-10)(15-12)} = \\sqrt{15 \\cdot 7 \\cdot 5 \\cdot 3}$." },
        { "tipe": "paragraph", "text": "$= \\sqrt{1575} = \\sqrt{225 \\cdot 7} = 15\\sqrt{7}$ cm²." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin^2 45° + \\sin^2 30°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin^2 45° = \\left(\\dfrac{1}{2}\\sqrt{2}\\right)^2 = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "$\\sin^2 30° = \\left(\\dfrac{1}{2}\\right)^2 = \\dfrac{1}{4}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{2} + \\dfrac{1}{4} = \\dfrac{3}{4}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga $ABC$, diketahui $A = 30°$, $B = 60°$, dan $a = 4$ cm. Panjang sisi $c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$12$ cm" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sudut $C = 180° - (30° + 60°) = 90°$ (segitiga siku-siku)." },
        { "tipe": "paragraph", "text": "Sisi $c$ adalah sisi miring. Sisi $a = 4$ berada di hadapan sudut $A = 30°$." },
        { "tipe": "paragraph", "text": "$\\sin 30° = \\dfrac{a}{c} \\Rightarrow \\dfrac{1}{2} = \\dfrac{4}{c} \\Rightarrow c = 8$ cm." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 60°}{1 + \\cos 60°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 60° = \\dfrac{1}{2}\\sqrt{3}$ dan $\\cos 60° = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{\\frac{1}{2}\\sqrt{3}}{1 + \\frac{1}{2}} = \\dfrac{\\frac{1}{2}\\sqrt{3}}{\\frac{3}{2}} = \\dfrac{1}{3}\\sqrt{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\cos \\theta = \\dfrac{8}{17}$ dan $\\theta$ berada di kuadran IV, maka nilai $\\tan \\theta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{15}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{8}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{17}{15}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Di kuadran IV, $\\sin$ negatif dan $\\cos$ positif, sehingga $\\tan$ negatif." },
        { "tipe": "paragraph", "text": "$\\cos \\theta = \\dfrac{8}{17}$ → samping = 8, miring = 17." },
        { "tipe": "paragraph", "text": "Depan = $\\sqrt{17^2 - 8^2} = \\sqrt{289 - 64} = \\sqrt{225} = 15$." },
        { "tipe": "paragraph", "text": "$\\tan \\theta = -\\dfrac{15}{8}$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
