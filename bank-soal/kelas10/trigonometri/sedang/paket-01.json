{
  "id": "bs-k10-trig-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang aturan sinus dan cosinus",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-trig-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga sembarang berikut. Jika $A = 30°$, $B = 45°$, dan $a = 10$ cm, maka panjang sisi $b$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/aturan-sinus-1.png",
          "caption": "Segitiga ABC sembarang dengan sudut A = 30°, sudut B = 45°, dan sisi a = 10 cm di hadapan sudut A.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$5\\sqrt{3}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$20$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan sinus: $\\dfrac{a}{\\sin A} = \\dfrac{b}{\\sin B}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{10}{\\sin 30°} = \\dfrac{b}{\\sin 45°}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{10}{1/2} = \\dfrac{b}{\\frac{1}{2}\\sqrt{2}}$" },
        { "tipe": "paragraph", "text": "$20 = \\dfrac{b}{\\frac{1}{2}\\sqrt{2}} \\Rightarrow b = 10\\sqrt{2}$ cm" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Aturan sinus berlaku pada segitiga..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Siku-siku saja" } ],
        [ { "tipe": "paragraph", "text": "Sama sisi saja" } ],
        [ { "tipe": "paragraph", "text": "Sembarang" } ],
        [ { "tipe": "paragraph", "text": "Sama kaki saja" } ],
        [ { "tipe": "paragraph", "text": "Tumpul saja" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan sinus berlaku untuk SEMUA jenis segitiga, termasuk segitiga sembarang." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga berikut. Jika $b = 8$ cm, $c = 10$ cm, dan sudut $A = 60°$, maka panjang sisi $a$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/aturan-cosinus-1.png",
          "caption": "Segitiga ABC dengan sisi b = 8 cm, sisi c = 10 cm, dan sudut A = 60° yang mengapit kedua sisi tersebut.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2\\sqrt{21}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{21}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{2}$ cm" } ],
        [ { "tipe": "paragraph", "text": "$10\\sqrt{2}$ cm" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan cosinus: $a^2 = b^2 + c^2 - 2bc \\cos A$" },
        { "tipe": "paragraph", "text": "$a^2 = 8^2 + 10^2 - 2(8)(10)\\cos 60°$" },
        { "tipe": "paragraph", "text": "$a^2 = 64 + 100 - 160 \\cdot \\dfrac{1}{2} = 164 - 80 = 84$" },
        { "tipe": "paragraph", "text": "$a = \\sqrt{84} = 2\\sqrt{21}$ cm" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Aturan cosinus digunakan ketika diketahui..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Dua sudut dan satu sisi" } ],
        [ { "tipe": "paragraph", "text": "Dua sisi dan sudut yang mengapitnya" } ],
        [ { "tipe": "paragraph", "text": "Tiga sudut" } ],
        [ { "tipe": "paragraph", "text": "Satu sisi dan satu sudut" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada yang benar" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Aturan cosinus dipakai saat diketahui: dua sisi + sudut yang mengapitnya, atau tiga sisi." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada segitiga dengan sisi $a = 6$ cm, $b = 8$ cm, dan $c = 10$ cm, nilai $\\cos C$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/segitiga-6-8-10-cos.png",
          "caption": "Segitiga ABC dengan sisi a = 6, b = 8, c = 10. Cari cos C (sudut di hadapan sisi c).",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos C = \\dfrac{a^2 + b^2 - c^2}{2ab} = \\dfrac{36 + 64 - 100}{2 \\cdot 6 \\cdot 8} = \\dfrac{0}{96} = 0$" },
        { "tipe": "paragraph", "text": "Jadi $C = 90°$ (segitiga siku-siku) — memang $(6, 8, 10)$ tripel Pythagoras." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Luas segitiga dengan sisi $b = 8$ cm, $c = 12$ cm, dan sudut $A = 30°$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/sedang/luas-segitiga-1.png",
          "caption": "Segitiga ABC dengan sisi b = 8, c = 12, dan sudut A = 30° yang mengapit kedua sisi.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$32$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$48$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$24\\sqrt{3}$ cm²" } ],
        [ { "tipe": "paragraph", "text": "$48\\sqrt{3}$ cm²" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$L = \\dfrac{1}{2} \\cdot b \\cdot c \\cdot \\sin A$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2} \\cdot 8 \\cdot 12 \\cdot \\sin 30° = 48 \\cdot \\dfrac{1}{2} = 24$ cm²" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin 75°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{6} + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{6} - \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{6} + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{3} + 1)$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{2} + \\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 75° = \\sin(45° + 30°)$" },
        { "tipe": "paragraph", "text": "$= \\sin 45°\\cos 30° + \\cos 45°\\sin 30°$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}\\sqrt{2} \\cdot \\dfrac{1}{2}\\sqrt{3} + \\dfrac{1}{2}\\sqrt{2} \\cdot \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{4}\\sqrt{6} + \\dfrac{1}{4}\\sqrt{2} = \\dfrac{1}{4}(\\sqrt{6} + \\sqrt{2})$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\cos 15°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{6} + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}(\\sqrt{6} - \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{6} + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}(\\sqrt{3} + 1)$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{2} - \\sqrt{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos 15° = \\cos(45° - 30°)$" },
        { "tipe": "paragraph", "text": "$= \\cos 45°\\cos 30° + \\sin 45°\\sin 30°$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{2}\\sqrt{2} \\cdot \\dfrac{1}{2}\\sqrt{3} + \\dfrac{1}{2}\\sqrt{2} \\cdot \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{4}(\\sqrt{6} + \\sqrt{2})$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\alpha = \\dfrac{3}{5}$ dan $\\alpha$ di kuadran I, nilai $\\sin 2\\alpha$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{48}{25}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin \\alpha = \\dfrac{3}{5}$, $\\alpha$ kuadran I → $\\cos \\alpha = \\dfrac{4}{5}$" },
        { "tipe": "paragraph", "text": "$\\sin 2\\alpha = 2 \\sin \\alpha \\cos \\alpha = 2 \\cdot \\dfrac{3}{5} \\cdot \\dfrac{4}{5} = \\dfrac{24}{25}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-trig-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\cos 2\\alpha$ jika $\\cos \\alpha = \\dfrac{1}{3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{7}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos 2\\alpha = 2\\cos^2 \\alpha - 1$" },
        { "tipe": "paragraph", "text": "$= 2 \\cdot \\dfrac{1}{9} - 1 = \\dfrac{2}{9} - 1 = -\\dfrac{7}{9}$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
