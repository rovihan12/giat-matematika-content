{
  "id": "bs-k10-trig-m-07",
  "nama": "Bank Soal Mudah - Paket 7 (Lanjutan)",
  "kelas": 10,
  "kategori": "Trigonometri",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang identitas trigonometri dasar, relasi sudut, dan segitiga siku-siku (lanjutan)",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-trig-m-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $PQR$ berikut. Nilai $\\cos \\alpha$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/mudah/segitiga-pqr-6-8-10.png",
          "caption": "Segitiga siku-siku PQR dengan sisi tegak 6, sisi datar 8, dan sisi miring 10.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{8}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos \\alpha$ adalah perbandingan sisi samping (datar) terhadap sisi miring." },
        { "tipe": "paragraph", "text": "$\\cos \\alpha = \\dfrac{PQ}{PR} = \\dfrac{8}{10} = \\dfrac{4}{5}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 90° - \\cos 0°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 90° = 1$ dan $\\cos 0° = 1$." },
        { "tipe": "paragraph", "text": "$1 - 1 = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\sin \\theta = \\dfrac{3}{5}$ dan $\\theta$ berada di kuadran I, maka nilai $\\tan \\theta$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin \\theta = \\dfrac{3}{5}$ → depan = 3, miring = 5." },
        { "tipe": "paragraph", "text": "Samping = $\\sqrt{5^2 - 3^2} = \\sqrt{25 - 9} = \\sqrt{16} = 4$." },
        { "tipe": "paragraph", "text": "$\\tan \\theta = \\dfrac{\\text{depan}}{\\text{samping}} = \\dfrac{3}{4}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sin 150°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 150° = \\sin(180° - 30°) = \\sin 30° = \\dfrac{1}{2}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan segitiga siku-siku $ABC$ berikut. Nilai $\\tan \\beta$ adalah..." },
        {
          "tipe": "image",
          "src": "images/kelas10/trigonometri/mudah/segitiga-abc-9-12-15.png",
          "caption": "Segitiga siku-siku ABC dengan sisi tegak 9, sisi datar 12, dan sisi miring 15. Sudut beta berada di antara sisi tegak dan sisi miring.",
          "width": "medium"
        }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{12}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sudut $\\beta$ berada di antara sisi tegak (samping untuk $\\beta$) dan sisi miring." },
        { "tipe": "paragraph", "text": "Sisi depan sudut $\\beta$ adalah sisi datar (12), dan sisi sampingnya adalah sisi tegak (9)." },
        { "tipe": "paragraph", "text": "$\\tan \\beta = \\dfrac{\\text{depan}}{\\text{samping}} = \\dfrac{12}{9} = \\dfrac{4}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\dfrac{\\sin 30°}{\\cos 60°}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin 30° = \\dfrac{1}{2}$ dan $\\cos 60° = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "$\\dfrac{\\frac{1}{2}}{\\frac{1}{2}} = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah tangga bersandar pada dinding membentuk sudut $45°$ dengan tanah. Jika panjang tangga 8 m, tinggi ujung tangga dari tanah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ m" } ],
        [ { "tipe": "paragraph", "text": "$4\\sqrt{2}$ m" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{2}$ m" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{3}$ m" } ],
        [ { "tipe": "paragraph", "text": "$16$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tinggi = $8 \\cdot \\sin 45° = 8 \\cdot \\dfrac{1}{2}\\sqrt{2} = 4\\sqrt{2}$ m." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\cos 120°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\cos 120° = \\cos(180° - 60°) = -\\cos 60° = -\\dfrac{1}{2}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui segitiga siku-siku dengan sisi miring 25 dan sisi datar 7. Nilai $\\sin \\gamma$ (sudut di hadapan sisi datar) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{24}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{24}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sisi tegak = $\\sqrt{25^2 - 7^2} = \\sqrt{625 - 49} = \\sqrt{576} = 24$." },
        { "tipe": "paragraph", "text": "Sudut $\\gamma$ di hadapan sisi datar (7), maka sisi depan = 7 dan miring = 25." },
        { "tipe": "paragraph", "text": "$\\sin \\gamma = \\dfrac{7}{25}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $1 - \\sin^2 45°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ingat identitas $\\sin^2 \\alpha + \\cos^2 \\alpha = 1$, sehingga $1 - \\sin^2 \\alpha = \\cos^2 \\alpha$." },
        { "tipe": "paragraph", "text": "$1 - \\sin^2 45° = \\cos^2 45° = \\left(\\dfrac{1}{2}\\sqrt{2}\\right)^2 = \\dfrac{1}{2}$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
