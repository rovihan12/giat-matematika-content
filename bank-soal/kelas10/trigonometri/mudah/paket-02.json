      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\tan 60° = \\sqrt{3}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\sec 60°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sec 60° = \\dfrac{1}{\\cos 60°} = \\dfrac{1}{1/2} = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\csc 30°$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\csc 30° = \\dfrac{1}{\\sin 30°} = \\dfrac{1}{1/2} = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-trig-m-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sin 30° \\cdot \\cos 60°$ adalah..." }
