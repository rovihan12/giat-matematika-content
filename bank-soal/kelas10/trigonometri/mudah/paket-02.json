        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\sin \\alpha = \\dfrac{6}{10} = \\dfrac{3}{5}$" }
