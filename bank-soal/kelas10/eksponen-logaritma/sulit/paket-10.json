{
  "id": "bs-k10-eks-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $25^{x} - 26 \\cdot 5^{x} + 25 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk persamaan eksponen dengan menjabarkan $25^x = (5^x)^2$**" },
        { "tipe": "formula_block", "latex": "(5^x)^2 - 26 \\cdot 5^x + 25 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 5^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 26y + 25 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 25)(y - 1) = 0 \\Rightarrow y = 25 \\quad \\text{atau} \\quad y = 1" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 5^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 25 \\Rightarrow 5^x = 25 = 5^2 \\Rightarrow x = 2" },
        { "tipe": "formula_block", "latex": "y = 1 \\Rightarrow 5^x = 1 = 5^0 \\Rightarrow x = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 0$ atau $x = 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = a$ dan ${}^2\\log 7 = b$, maka nilai ${}^{21}\\log 56$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{b + 3}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 3b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{3a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{21}\\log 56$ ke basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^{21}\\log 56 = \\dfrac{{}^2\\log 56}{{}^2\\log 21}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 56 = {}^2\\log(2^3 \\cdot 7) = 3 \\cdot {}^2\\log 2 + {}^2\\log 7 = 3 + b" },
        { "tipe": "formula_block", "latex": "{}^2\\log 21 = {}^2\\log(3 \\cdot 7) = {}^2\\log 3 + {}^2\\log 7 = a + b" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{21}\\log 56 = \\dfrac{3 + b}{a + b} = \\dfrac{b + 3}{a + b}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{21}\\log 56$ adalah **$\\dfrac{b + 3}{a + b}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 3x - 2) < 3$ dengan syarat domain $x^2 - 3x - 4 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 < x < -1$ atau $4 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -2$ atau $x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat domain dari soal ($x^2 - 3x - 4 > 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 4 > 0 \\Rightarrow (x - 4)(x + 1) > 0 \\Rightarrow x < -1 \\quad \\text{atau} \\quad x > 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $2 > 1$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x^2 - 3x - 2) < {}^2\\log 2^3 \\Rightarrow x^2 - 3x - 2 < 8" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 10 < 0 \\Rightarrow (x - 5)(x + 2) < 0 \\Rightarrow -2 < x < 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan hasil penyelesaian dengan syarat domain**" },
        { "tipe": "paragraph", "text": "Irisan dari ($x < -1$ atau $x > 4$) dan ($-2 < x < 5$) adalah:" },
        { "tipe": "formula_block", "latex": "-2 < x < -1 \\quad \\text{atau} \\quad 4 < x < 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-2 < x < -1$ atau $4 < x < 5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah populasi bakteri mula-mula 250. Populasi berlipat ganda setiap 6 jam. Populasi setelah 24 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.000$" } ],
        [ { "tipe": "paragraph", "text": "$2.000$" } ],
        [ { "tipe": "paragraph", "text": "$4.000$" } ],
        [ { "tipe": "paragraph", "text": "$8.000$" } ],
        [ { "tipe": "paragraph", "text": "$16.000$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan banyak periode pertumbuhan selama $24$ jam**" },
        { "tipe": "formula_block", "latex": "n = \\dfrac{24\\text{ jam}}{6\\text{ jam}} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung populasi akhir menggunakan rumus pertumbuhan eksponensial $P = P_0 \\cdot 2^n$**" },
        { "tipe": "formula_block", "latex": "P = 250 \\times 2^4 = 250 \\times 16 = 4.000" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, populasi bakteri setelah 24 jam adalah **$4.000$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(x-2) + {}^3\\log(x+2) = {}^3\\log 21$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus untuk setiap logaritma**" },
        { "tipe": "formula_block", "latex": "x - 2 > 0 \\Rightarrow x > 2" },
        { "tipe": "formula_block", "latex": "x + 2 > 0 \\Rightarrow x > -2" },
        { "tipe": "paragraph", "text": "Irisan dari kedua syarat numerus tersebut adalah $x > 2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan ruas kiri menggunakan sifat penjumlahan logaritma**" },
        { "tipe": "formula_block", "latex": "{}^3\\log[(x - 2)(x + 2)] = {}^3\\log 21" },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan numerus kedua ruas dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "(x - 2)(x + 2) = 21 \\Rightarrow x^2 - 4 = 21" },
        { "tipe": "formula_block", "latex": "x^2 = 25 \\Rightarrow x = -5 \\quad \\text{atau} \\quad x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji nilai $x$ terhadap syarat numerus $x > 2$**" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > 2$, maka $x = -5$ tidak memenuhi dan nilai yang valid hanyalah $x = 5$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $3^a \\cdot 9^b = 243$ dan $2^{a+b} = 32$. Nilai $a + 2b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "3^a \\cdot (3^2)^b = 3^5 \\Rightarrow 3^{a + 2b} = 3^5 \\Rightarrow a + 2b = 5" },
        { "tipe": "formula_block", "latex": "2^{a + b} = 2^5 \\Rightarrow a + b = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ambil nilai $a + 2b$ langsung dari persamaan pertama**" },
        { "tipe": "formula_block", "latex": "a + 2b = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a + 2b$ adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 81$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$**" },
        { "tipe": "formula_block", "latex": "{}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 81 = {}^3\\log 81" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^3\\log 81$**" },
        { "tipe": "formula_block", "latex": "{}^3\\log 81 = {}^3\\log 3^4 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 81$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $9^{x} - 12 \\cdot 3^{x} + 27 > 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan $9^x = (3^x)^2$ dan misalkan $y = 3^x$ untuk membentuk pertidaksamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 12y + 27 > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 3)(y - 9) > 0 \\Rightarrow y < 3 \\quad \\text{atau} \\quad y > 9" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke pemisalan awal $y = 3^x$ dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "3^x < 3 = 3^1 \\Rightarrow x < 1" },
        { "tipe": "formula_block", "latex": "3^x > 9 = 3^2 \\Rightarrow x > 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x < 1$ atau $x > 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3^{x} + 3^{-x}$ dan $f(a) = 6$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 6$**" },
        { "tipe": "formula_block", "latex": "f(a) = 3^a + 3^{-a} = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(3^a + 3^{-a})^2 = 6^2" },
        { "tipe": "formula_block", "latex": "(3^a)^2 + 2 \\cdot 3^a \\cdot 3^{-a} + (3^{-a})^2 = 36" },
        { "tipe": "formula_block", "latex": "3^{2a} + 2 \\cdot 3^{a - a} + 3^{-2a} = 36 \\Rightarrow 3^{2a} + 2 + 3^{-2a} = 36" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 3^{2a} + 3^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 3^{2a} + 3^{-2a} = 36 - 2 = 34" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$34$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp12.000.000,00 dibungakan majemuk 5% per tahun. Waktu minimum agar modal menjadi minimal Rp15.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 1{,}25 \\approx 0{,}322$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "12.000.000(1 + 0{,}05)^t \\geq 15.000.000 \\Rightarrow (1{,}05)^t \\geq \\dfrac{15.000.000}{12.000.000} = 1{,}25" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}05}\\log 1{,}25 = \\dfrac{{}^2\\log 1{,}25}{{}^2\\log 1{,}05}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{0{,}322}{0{,}0704} \\approx 4{,}57" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $4{,}57$ tahun dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$5$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
