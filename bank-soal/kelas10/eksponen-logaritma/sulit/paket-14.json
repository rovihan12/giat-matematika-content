{
  "id": "bs-k10-eks-sulit-15",
  "nama": "Bank Soal Sulit - Paket 15",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-15-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x} - 30 \\cdot 3^{x} + 81 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$ atau $x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk persamaan eksponen dengan menjabarkan $9^x = (3^x)^2$**" },
        { "tipe": "formula_block", "latex": "(3^x)^2 - 30 \\cdot 3^x + 81 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 3^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 30y + 81 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 27)(y - 3) = 0 \\Rightarrow y = 27 \\quad \\text{atau} \\quad y = 3" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 3^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 27 \\Rightarrow 3^x = 27 = 3^3 \\Rightarrow x = 3" },
        { "tipe": "formula_block", "latex": "y = 3 \\Rightarrow 3^x = 3 = 3^1 \\Rightarrow x = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 1$ atau $x = 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = a$ dan ${}^2\\log 5 = b$, maka nilai ${}^{40}\\log 75$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{3 + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{3 + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{2 + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{3 + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + 2b}{3 + b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{40}\\log 75$ ke basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^{40}\\log 75 = \\dfrac{{}^2\\log 75}{{}^2\\log 40}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 75 = {}^2\\log(3 \\cdot 5^2) = {}^2\\log 3 + 2 \\cdot {}^2\\log 5 = a + 2b" },
        { "tipe": "formula_block", "latex": "{}^2\\log 40 = {}^2\\log(2^3 \\cdot 5) = 3 \\cdot {}^2\\log 2 + {}^2\\log 5 = 3 + b" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{40}\\log 75 = \\dfrac{a + 2b}{3 + b}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{40}\\log 75$ adalah **$\\dfrac{a + 2b}{3 + b}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 6x - 11) < 4$ dengan syarat domain $x^2 - 6x - 7 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -1$ atau $7 < x < 9$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 7$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < 9$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat domain dari soal ($x^2 - 6x - 7 > 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 6x - 7 > 0 \\Rightarrow (x - 7)(x + 1) > 0 \\Rightarrow x < -1 \\quad \\text{atau} \\quad x > 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $2 > 1$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x^2 - 6x - 11) < {}^2\\log 2^4 \\Rightarrow x^2 - 6x - 11 < 16" },
        { "tipe": "formula_block", "latex": "x^2 - 6x - 27 < 0 \\Rightarrow (x - 9)(x + 3) < 0 \\Rightarrow -3 < x < 9" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan hasil penyelesaian dengan syarat domain**" },
        { "tipe": "paragraph", "text": "Irisan dari ($x < -1$ atau $x > 7$) dan ($-3 < x < 9$) adalah:" },
        { "tipe": "formula_block", "latex": "-3 < x < -1 \\quad \\text{atau} \\quad 7 < x < 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-3 < x < -1$ atau $7 < x < 9$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah zat radioaktif memiliki waktu paruh 25 tahun. Jika massa awal 1.600 gram, massa setelah 100 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$200$ gram" } ],
        [ { "tipe": "paragraph", "text": "$100$ gram" } ],
        [ { "tipe": "paragraph", "text": "$50$ gram" } ],
        [ { "tipe": "paragraph", "text": "$25$ gram" } ],
        [ { "tipe": "paragraph", "text": "$400$ gram" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan data ke rumus peluruhan radioaktif**" },
        { "tipe": "paragraph", "text": "Gunakan rumus $M(t) = M_0 \\left(\\dfrac{1}{2}\\right)^{t/T}$ dengan $M_0 = 1.600$, $T = 25$, dan $t = 100$:" },
        { "tipe": "formula_block", "latex": "M(100) = 1.600 \\left(\\dfrac{1}{2}\\right)^{100/25}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan pangkat dan hitung massa akhir**" },
        { "tipe": "formula_block", "latex": "M(100) = 1.600 \\left(\\dfrac{1}{2}\\right)^4 = 1.600 \\cdot \\dfrac{1}{16} = 100" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, massa zat radioaktif setelah 100 tahun adalah **$100$ gram**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-3) + {}^2\\log(x+2) = {}^2\\log 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus untuk setiap logaritma**" },
        { "tipe": "formula_block", "latex": "x - 3 > 0 \\Rightarrow x > 3" },
        { "tipe": "formula_block", "latex": "x + 2 > 0 \\Rightarrow x > -2" },
        { "tipe": "paragraph", "text": "Irisan dari kedua syarat numerus tersebut adalah $x > 3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan ruas kiri menggunakan sifat penjumlahan logaritma**" },
        { "tipe": "formula_block", "latex": "{}^2\\log[(x - 3)(x + 2)] = {}^2\\log 6" },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan numerus kedua ruas dan selesaikan persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(x - 3)(x + 2) = 6 \\Rightarrow x^2 - x - 6 = 6" },
        { "tipe": "formula_block", "latex": "x^2 - x - 12 = 0 \\Rightarrow (x - 4)(x + 3) = 0" },
        { "tipe": "formula_block", "latex": "x = 4 \\quad \\text{atau} \\quad x = -3" },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji nilai $x$ terhadap syarat numerus $x > 3$**" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > 3$, maka $x = -3$ tidak memenuhi dan nilai yang valid hanyalah $x = 4$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 4^b = 128$ dan $3^{a+b} = 9$. Nilai $a \\cdot b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-15$" } ],
        [ { "tipe": "paragraph", "text": "$-10$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "2^a \\cdot (2^2)^b = 2^7 \\Rightarrow 2^{a + 2b} = 2^7 \\Rightarrow a + 2b = 7" },
        { "tipe": "formula_block", "latex": "3^{a + b} = 3^2 \\Rightarrow a + b = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $a$ untuk mendapatkan nilai $b$, lalu substitusikan untuk mencari $a$**" },
        { "tipe": "formula_block", "latex": "(a + 2b) - (a + b) = 7 - 2 \\Rightarrow b = 5" },
        { "tipe": "formula_block", "latex": "a + 5 = 2 \\Rightarrow a = -3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil kali $a \\cdot b$**" },
        { "tipe": "formula_block", "latex": "a \\cdot b = (-3) \\cdot 5 = -15" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a \\cdot b$ adalah **$-15$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 8 \\cdot {}^8\\log 81$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$**" },
        { "tipe": "formula_block", "latex": "{}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 8 \\cdot {}^8\\log 81 = {}^3\\log 81" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^3\\log 81$**" },
        { "tipe": "formula_block", "latex": "{}^3\\log 81 = {}^3\\log 3^4 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 8 \\cdot {}^8\\log 81$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $9^{x} - 4 \\cdot 3^{x} - 45 > 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan $9^x = (3^x)^2$ dan misalkan $y = 3^x$ untuk membentuk pertidaksamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 4y - 45 > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 9)(y + 5) > 0 \\Rightarrow y < -5 \\quad \\text{atau} \\quad y > 9" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke pemisalan awal $y = 3^x$ dan selesaikan untuk $x$**" },
        { "tipe": "paragraph", "text": "Karena $3^x > 0$ untuk setiap bilangan real $x$, pertidaksamaan $3^x < -5$ tidak memiliki penyelesaian. Penyelesaian berasal dari $3^x > 9$:" },
        { "tipe": "formula_block", "latex": "3^x > 9 = 3^2 \\Rightarrow x > 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x > 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 4^{x} + 4^{-x}$ dan $f(a) = 7$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$47$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ],
        [ { "tipe": "paragraph", "text": "$53$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 7$**" },
        { "tipe": "formula_block", "latex": "f(a) = 4^a + 4^{-a} = 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(4^a + 4^{-a})^2 = 7^2" },
        { "tipe": "formula_block", "latex": "(4^a)^2 + 2 \\cdot 4^a \\cdot 4^{-a} + (4^{-a})^2 = 49" },
        { "tipe": "formula_block", "latex": "4^{2a} + 2 \\cdot 4^{a - a} + 4^{-2a} = 49 \\Rightarrow 4^{2a} + 2 + 4^{-2a} = 49" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 4^{2a} + 4^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 4^{2a} + 4^{-2a} = 49 - 2 = 47" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$47$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-15-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp20.000.000,00 dibungakan majemuk 3% per tahun. Waktu minimum agar modal menjadi minimal Rp23.000.000,00 adalah... (gunakan ${}^2\\log 1{,}03 \\approx 0{,}0427$ dan ${}^2\\log 1{,}15 \\approx 0{,}2016$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "20.000.000(1 + 0{,}03)^t \\geq 23.000.000 \\Rightarrow (1{,}03)^t \\geq \\dfrac{23.000.000}{20.000.000} = 1{,}15" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}03}\\log 1{,}15 = \\dfrac{{}^2\\log 1{,}15}{{}^2\\log 1{,}03}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{0{,}2016}{0{,}0427} \\approx 4{,}72" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $4{,}72$ tahun dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$5$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
