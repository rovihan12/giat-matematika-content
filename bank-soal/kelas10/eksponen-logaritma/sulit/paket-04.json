{
  "id": "bs-k10-eks-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x} - 4 \\cdot 3^{x} + 3 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(3^x)^2 - 4 \\cdot 3^x + 3 = 0$" },
        { "tipe": "paragraph", "text": "Misal $y = 3^x$: $y^2 - 4y + 3 = 0$" },
        { "tipe": "paragraph", "text": "$(y - 3)(y - 1) = 0 \\Rightarrow y = 3$ atau $y = 1$" },
        { "tipe": "paragraph", "text": "$3^x = 3 \\Rightarrow x = 1$; $3^x = 1 \\Rightarrow x = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^3\\log 2 = a$, maka ${}^3\\log 72$ dapat dinyatakan sebagai..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2 + 2a$" } ],
        [ { "tipe": "paragraph", "text": "$2 + 3a$" } ],
        [ { "tipe": "paragraph", "text": "$3 + 2a$" } ],
        [ { "tipe": "paragraph", "text": "$2a + 3$" } ],
        [ { "tipe": "paragraph", "text": "$4a + 2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 72 = {}^3\\log(8 \\cdot 9) = {}^3\\log 8 + {}^3\\log 9$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 2^3 + {}^3\\log 3^2 = 3a + 2 = 2 + 3a$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 4) \\leq 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2\\sqrt{3} \\leq x < -2$ atau $2 < x \\leq 2\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$-2\\sqrt{3} < x < 2\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$x < -2$ atau $x > 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat domain: $x^2 - 4 > 0 \\Rightarrow x < -2$ atau $x > 2$" },
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 4) \\leq 3 \\Rightarrow x^2 - 4 \\leq 8$" },
        { "tipe": "paragraph", "text": "$x^2 \\leq 12 \\Rightarrow -2\\sqrt{3} \\leq x \\leq 2\\sqrt{3}$" },
        { "tipe": "paragraph", "text": "Irisan: $-2\\sqrt{3} \\leq x < -2$ atau $2 < x \\leq 2\\sqrt{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu zat radioaktif memiliki waktu paruh 30 tahun. Jika massa awal 200 gram, massa setelah 90 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$50$ gram" } ],
        [ { "tipe": "paragraph", "text": "$25$ gram" } ],
        [ { "tipe": "paragraph", "text": "$12{,}5$ gram" } ],
        [ { "tipe": "paragraph", "text": "$100$ gram" } ],
        [ { "tipe": "paragraph", "text": "$6{,}25$ gram" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$M(t) = M_0 \\left(\\dfrac{1}{2}\\right)^{t/T}$" },
        { "tipe": "paragraph", "text": "$M(90) = 200 \\left(\\dfrac{1}{2}\\right)^{90/30} = 200 \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "$= 200 \\cdot \\dfrac{1}{8} = 25$ gram" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x} \\cdot 4^{x-1} = 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{5}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^x \\cdot (2^2)^{x-1} = 32$" },
        { "tipe": "paragraph", "text": "$2^x \\cdot 2^{2x-2} = 2^5$" },
        { "tipe": "paragraph", "text": "$2^{3x-2} = 2^5$" },
        { "tipe": "paragraph", "text": "$3x - 2 = 5 \\Rightarrow 3x = 7 \\Rightarrow x = \\dfrac{7}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui ${}^2\\log 3 = a$ dan ${}^2\\log 5 = b$. Nilai ${}^{6}\\log 45$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 + a + b}{a + 1}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^{6}\\log 45 = \\dfrac{{}^2\\log 45}{{}^2\\log 6}$" },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log(9 \\cdot 5) = 2a + b$" },
        { "tipe": "paragraph", "text": "${}^2\\log 6 = {}^2\\log(2 \\cdot 3) = 1 + a$" },
        { "tipe": "paragraph", "text": "Jadi ${}^{6}\\log 45 = \\dfrac{2a + b}{a + 1}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $\\left(\\dfrac{1}{3}\\right)^{2x-1} \\geq \\dfrac{1}{81}$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq \\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq -\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq \\dfrac{3}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{3}\\right)^{2x-1} \\geq \\dfrac{1}{81} = \\left(\\dfrac{1}{3}\\right)^4$" },
        { "tipe": "paragraph", "text": "Karena basis $\\dfrac{1}{3} < 1$, tanda berbalik: $2x - 1 \\leq 4$" },
        { "tipe": "paragraph", "text": "$2x \\leq 5 \\Rightarrow x \\leq \\dfrac{5}{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x$ dan $y$ memenuhi ${}^3\\log(x + y) = 2$ dan ${}^3\\log(x - y) = 1$, maka nilai $x \\cdot y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log(x+y) = 2 \\Rightarrow x + y = 3^2 = 9$" },
        { "tipe": "paragraph", "text": "${}^3\\log(x-y) = 1 \\Rightarrow x - y = 3^1 = 3$" },
        { "tipe": "paragraph", "text": "Jumlahkan kedua persamaan: $2x = 12 \\Rightarrow x = 6$" },
        { "tipe": "paragraph", "text": "Kurangkan kedua persamaan: $2y = 6 \\Rightarrow y = 3$" },
        { "tipe": "paragraph", "text": "Nilai $x \\cdot y = 6 \\cdot 3 = 18$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 8 + {}^3\\log 9 - {}^5\\log 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 8 = {}^2\\log 2^3 = 3$" },
        { "tipe": "paragraph", "text": "${}^3\\log 9 = {}^3\\log 3^2 = 2$" },
        { "tipe": "paragraph", "text": "${}^5\\log 125 = {}^5\\log 5^3 = 3$" },
        { "tipe": "paragraph", "text": "Hasil $= 3 + 2 - 3 = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x_1$ dan $x_2$ adalah akar-akar dari persamaan $x^{{}^3\\log x - 1} = 9$, maka hasil kali $x_1 \\cdot x_2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ambil logaritma berbasis 3 pada kedua ruas:" },
        { "tipe": "paragraph", "text": "${}^3\\log\\left(x^{{}^3\\log x - 1}\\right) = {}^3\\log 9$" },
        { "tipe": "paragraph", "text": "({}^3\\log x - 1) \\cdot {}^3\\log x = 2$" },
        { "tipe": "paragraph", "text": "Misal $y = {}^3\\log x$, maka $(y - 1)y = 2 \\Rightarrow y^2 - y - 2 = 0$" },
        { "tipe": "paragraph", "text": "$(y - 2)(y + 1) = 0 \\Rightarrow y_1 = 2$ atau $y_2 = -1$" },
        { "tipe": "paragraph", "text": "${}^3\\log x_1 = 2 \\Rightarrow x_1 = 3^2 = 9$" },
        { "tipe": "paragraph", "text": "${}^3\\log x_2 = -1 \\Rightarrow x_2 = 3^{-1} = \\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "Hasil kali $x_1 \\cdot x_2 = 9 \\cdot \\dfrac{1}{3} = 3$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}