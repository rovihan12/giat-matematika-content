{
  "id": "bs-k10-eks-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit lanjutan tentang eksponen, logaritma, dan aplikasi kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x} - 3 \\cdot 2^{x+1} + 8 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan eksponen dengan menjabarkan suku $2^{x+1} = 2^1 \\cdot 2^x = 2 \\cdot 2^x$ dan $4^x = (2^x)^2$." },
        { "tipe": "paragraph", "text": "$(2^x)^2 - 3(2 \\cdot 2^x) + 8 = 0 \\Rightarrow (2^x)^2 - 6 \\cdot 2^x + 8 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Lakukan pemisalan $y = 2^x$ untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 6y + 8 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 4)(y - 2) = 0 \\Rightarrow y = 4 \\text{ atau } y = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kembalikan ke pemisalan awal untuk menentukan nilai $x$." },
        { "tipe": "paragraph", "text": "Untuk $y = 4 \\Rightarrow 2^x = 4 = 2^2 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "Untuk $y = 2 \\Rightarrow 2^x = 2 = 2^1 \\Rightarrow x = 1$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 1$ atau $x = 2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 5 = p$ dan ${}^2\\log 7 = q$, maka nilai ${}^{35}\\log 40$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + 3}{p + q}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + 2}{p + q}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{q + 3}{p + q}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + q}{p + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + q}{q + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk ${}^{35}\\log 40$ menggunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "${}^{35}\\log 40 = \\dfrac{{}^2\\log 40}{{}^2\\log 35}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Uraikan numerus $40$ dan $35$ ke dalam faktor primanya yang memuat $5$ dan $7$ ($40 = 8 \\cdot 5 = 2^3 \\cdot 5$ dan $35 = 5 \\cdot 7$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 40 = {}^2\\log(2^3 \\cdot 5) = 3 \\cdot {}^2\\log 2 + {}^2\\log 5 = 3 + p$" },
        { "tipe": "paragraph", "text": "${}^2\\log 35 = {}^2\\log(5 \\cdot 7) = {}^2\\log 5 + {}^2\\log 7 = p + q$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai tersebut ke bentuk pecahan." },
        { "tipe": "paragraph", "text": "${}^{35}\\log 40 = \\dfrac{p + 3}{p + q}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{p + 3}{p + q}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^{\\frac{1}{2}}\\log(x^2 - 3x) > -2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 0$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 0$ atau $3 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 4$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain (numerus harus bernilai positif)." },
        { "tipe": "paragraph", "text": "$x^2 - 3x > 0 \\Rightarrow x(x-3) > 0 \\Rightarrow x < 0 \\text{ atau } x > 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Selesaikan pertidaksamaan logaritma. Karena basis logaritma $\\dfrac{1}{2} < 1$, tanda pertidaksamaan harus dibalik." },
        { "tipe": "paragraph", "text": "$x^2 - 3x < \\left(\\dfrac{1}{2}\\right)^{-2} = 2^2 = 4$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 < 0 \\Rightarrow (x - 4)(x + 1) < 0 \\Rightarrow -1 < x < 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Iriskan hasil penyelesaian dengan syarat domain. Irisan dari $-1 < x < 4$ dengan daerah $x < 0 \\text{ atau } x > 3$ menghasilkan $-1 < x < 0$ atau $3 < x < 4$." },
        { "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $-1 < x < 0$ atau $3 < x < 4$ (pilihan keempat)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah koloni bakteri mula-mula berjumlah 500. Setiap 2 jam populasi bertambah 50% dari populasi sebelumnya. Populasi setelah 8 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2.531$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.500$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.531{,}25$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.400$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.700$ bakteri" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan jumlah periode pertumbuhan $n = \\dfrac{8 \\text{ jam}}{2 \\text{ jam}} = 4$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus pertumbuhan eksponensial dengan pertumbuhan 50% (faktor pengali $1 + 0{,}5 = \\dfrac{3}{2}$)." },
        { "tipe": "paragraph", "text": "$P = 500 \\left(1 + \\dfrac{1}{2}\\right)^4 = 500 \\left(\\dfrac{3}{2}\\right)^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Hitung nilai akhirnya." },
        { "tipe": "paragraph", "text": "$P = 500 \\cdot \\dfrac{81}{16} = \\dfrac{40500}{16} = 2.531{,}25$ bakteri" },
        { "tipe": "paragraph", "text": "Jadi, populasi setelah 8 jam adalah $2.531{,}25$ bakteri (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+3) = {}^4\\log(x^2 + 3x + 9)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Samakan basis logaritma dengan mengubah ${}^4\\log(x^2+3x+9)$ menggunakan sifat $\\dfrac{{}^2\\log(x^2+3x+9)}{{}^2\\log 4} = \\dfrac{{}^2\\log(x^2+3x+9)}{2}$." },
        { "tipe": "paragraph", "text": "${}^2\\log(x+3) = \\dfrac{{}^2\\log(x^2+3x+9)}{2}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan kedua ruas dengan $2$ dan gunakan sifat perpangkatan logaritma ($n \\cdot {}^a\\log b = {}^a\\log b^n$)." },
        { "tipe": "paragraph", "text": "$2 \\cdot {}^2\\log(x+3) = {}^2\\log(x^2+3x+9) \\Rightarrow {}^2\\log(x+3)^2 = {}^2\\log(x^2+3x+9)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan numerusnya." },
        { "tipe": "paragraph", "text": "$(x+3)^2 = x^2 + 3x + 9$" },
        { "tipe": "paragraph", "text": "$x^2 + 6x + 9 = x^2 + 3x + 9 \\Rightarrow 6x = 3x \\Rightarrow 3x = 0 \\Rightarrow x = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Uji nilai $x = 0$ terhadap syarat domain ($x+3 = 3 > 0$ dan $x^2+3x+9 = 9 > 0$, keduanya memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 0$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x$ dan $y$ memenuhi $2^x \\cdot 4^y = 64$ dan $3^x \\cdot 3^y = 81$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah setiap persamaan ke dalam bentuk basis prima yang sama." },
        { "tipe": "paragraph", "text": "$2^x \\cdot (2^2)^y = 2^6 \\Rightarrow 2^x \\cdot 2^{2y} = 2^6 \\Rightarrow 2^{x+2y} = 2^6 \\Rightarrow x + 2y = 6$ (Persamaan 1)" },
        { "tipe": "paragraph", "text": "$3^x \\cdot 3^y = 3^4 \\Rightarrow 3^{x+y} = 3^4 \\Rightarrow x + y = 4$ (Persamaan 2)" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Eliminasi variabel $x$ dengan mengurangkan Persamaan 1 dan Persamaan 2." },
        { "tipe": "paragraph", "text": "$(x + 2y) - (x + y) = 6 - 4 \\Rightarrow y = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai $y = 2$ ke Persamaan 2." },
        { "tipe": "paragraph", "text": "$x + 2 = 4 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Hitung nilai $x + y$." },
        { "tipe": "paragraph", "text": "$x + y = 2 + 2 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x + y$ adalah $4$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$." },
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 8 = {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan bentuk ${}^2\\log 8$." },
        { "tipe": "paragraph", "text": "${}^2\\log 2^3 = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $2^{2x} - 5 \\cdot 2^{x} + 4 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 0$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Lakukan pemisalan $y = 2^x$ (sehingga $2^{2x} = (2^x)^2 = y^2$) untuk membentuk pertidaksamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 5y + 4 \\leq 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Faktorkan bentuk kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 1)(y - 4) \\leq 0 \\Rightarrow 1 \\leq y \\leq 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kembalikan ke pemisalan awal." },
        { "tipe": "paragraph", "text": "$1 \\leq 2^x \\leq 4 \\Rightarrow 2^0 \\leq 2^x \\leq 2^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Samakan pangkatnya karena basis eksponen sama dan lebih dari $1$." },
        { "tipe": "paragraph", "text": "$0 \\leq x \\leq 2$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $0 \\leq x \\leq 2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3^{x} + 3^{-x}$ dan $f(a) = 4$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tuliskan bentuk persamaan dari $f(a) = 4$." },
        { "tipe": "paragraph", "text": "$f(a) = 3^a + 3^{-a} = 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kuadratkan kedua ruas persamaan." },
        { "tipe": "paragraph", "text": "$(3^a + 3^{-a})^2 = 4^2$" },
        { "tipe": "paragraph", "text": "$(3^a)^2 + 2 \\cdot 3^a \\cdot 3^{-a} + (3^{-a})^2 = 16$" },
        { "tipe": "paragraph", "text": "$3^{2a} + 2 \\cdot 3^{a-a} + 3^{-2a} = 16 \\Rightarrow 3^{2a} + 2 + 3^{-2a} = 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan untuk mendapatkan nilai $3^{2a} + 3^{-2a}$." },
        { "tipe": "paragraph", "text": "$3^{2a} + 3^{-2a} = 16 - 2 = 14$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Perhatikan bahwa $f(2a) = 3^{2a} + 3^{-2a} = 14$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $f(2a)$ adalah $14$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp5.000.000,00 diinvestasikan dengan bunga majemuk 8% per tahun. Waktu minimum agar modal menjadi minimal Rp7.000.000,00 adalah... (gunakan ${}^2\\log 1{,}08 \\approx 0{,}111$ dan ${}^2\\log 7 \\approx 2{,}807$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$8$ tahun" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Masukkan data ke dalam rumus bunga majemuk $M_t = M_0(1 + r)^t$." },
        { "tipe": "paragraph", "text": "$5.000.000(1 + 0{,}08)^t \\geq 7.000.000 \\Rightarrow (1{,}08)^t \\geq \\dfrac{7}{5} = 1{,}4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah bentuk pertidaksamaan eksponen ke bentuk logaritma." },
        { "tipe": "paragraph", "text": "$t \\geq {}^1{,}08\\log 1{,}4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan sifat perubahan basis dengan basis $2$." },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log 1{,}4}{{}^2\\log 1{,}08}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Hitung nilai ${}^2\\log 1{,}4 = {}^2\\log\\left(\\dfrac{7}{5}\\right) = {}^2\\log 7 - {}^2\\log 5$. Karena ${}^2\\log 5 \\approx 2{,}322$ (atau menggunakan pendekatan ${}^2\\log 5 = {}^2\\log\\left(\\dfrac{10}{2}\\right) = {}^2\\log 10 - 1 \approx 3{,}322 - 1 = 2{,}322$), maka ${}^2\\log 1{,}4 \\approx 2{,}807 - 2{,}322 = 0{,}485$." },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{0{,}485}{0{,}111} \\approx 4{,}37$ tahun" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "Jadi, waktu minimumnya adalah $5$ tahun (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
