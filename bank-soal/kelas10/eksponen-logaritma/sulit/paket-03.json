{
  "id": "bs-k10-eks-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit lanjutan tentang eksponen, logaritma, dan aplikasi kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x} - 3 \\cdot 2^{x+1} + 8 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan bentuk eksponen menggunakan sifat $a^{m+n} = a^m \\cdot a^n$ dan $4^x = (2^x)^2$**" },
        { "tipe": "formula_block", "latex": "(2^x)^2 - 3(2^1 \\cdot 2^x) + 8 = 0 \\Rightarrow (2^x)^2 - 6 \\cdot 2^x + 8 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 2^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 6y + 8 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 4)(y - 2) = 0 \\Rightarrow y = 4 \\quad \\text{atau} \\quad y = 2" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 2^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 4 \\Rightarrow 2^x = 4 = 2^2 \\Rightarrow x = 2" },
        { "tipe": "formula_block", "latex": "y = 2 \\Rightarrow 2^x = 2 = 2^1 \\Rightarrow x = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 1$ atau $x = 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 5 = p$ dan ${}^2\\log 7 = q$, maka nilai ${}^{35}\\log 40$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + 3}{p + q}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + 2}{p + q}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{q + 3}{p + q}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + q}{p + 3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{p + q}{q + 3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{35}\\log 40$ ke basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^{35}\\log 40 = \\dfrac{{}^2\\log 40}{{}^2\\log 35}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 40 = {}^2\\log(2^3 \\cdot 5) = 3 \\cdot {}^2\\log 2 + {}^2\\log 5 = 3 + p" },
        { "tipe": "formula_block", "latex": "{}^2\\log 35 = {}^2\\log(5 \\cdot 7) = {}^2\\log 5 + {}^2\\log 7 = p + q" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{35}\\log 40 = \\dfrac{p + 3}{p + q}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{35}\\log 40$ adalah **$\\dfrac{p + 3}{p + q}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^{1/2}\\log(x^2 - 3x) > -2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 0$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 0$ atau $3 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 4$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus logaritma (harus bernilai positif)**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x > 0 \\Rightarrow x(x - 3) > 0 \\Rightarrow x < 0 \\quad \\text{atau} \\quad x > 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $\\dfrac{1}{2} < 1$ (tanda dibalik)**" },
        { "tipe": "formula_block", "latex": "x^2 - 3x < \\left(\\dfrac{1}{2}\\right)^{-2} = 2^2 = 4" },
        { "tipe": "formula_block", "latex": "x^2 - 3x - 4 < 0 \\Rightarrow (x - 4)(x + 1) < 0 \\Rightarrow -1 < x < 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan syarat numerus dengan hasil penyelesaian**" },
        { "tipe": "paragraph", "text": "Irisan dari ($x < 0$ atau $x > 3$) dan ($-1 < x < 4$) adalah:" },
        { "tipe": "formula_block", "latex": "-1 < x < 0 \\quad \\text{atau} \\quad 3 < x < 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-1 < x < 0$ atau $3 < x < 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah koloni bakteri mula-mula berjumlah 500. Setiap 2 jam populasi bertambah 50% dari populasi sebelumnya. Populasi setelah 8 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2.531$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.500$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.531{,}25$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.400$ bakteri" } ],
        [ { "tipe": "paragraph", "text": "$2.700$ bakteri" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan banyak periode pertumbuhan selama $8$ jam**" },
        { "tipe": "formula_block", "latex": "n = \\dfrac{8\\text{ jam}}{2\\text{ jam}} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan data ke rumus pertumbuhan eksponensial $P = P_0(1 + r)^n$**" },
        { "tipe": "paragraph", "text": "Dengan $P_0 = 500$, laju pertumbuhan $r = 50\\% = \\dfrac{1}{2}$, dan $n = 4$:" },
        { "tipe": "formula_block", "latex": "P = 500 \\left(1 + \\dfrac{1}{2}\\right)^4 = 500 \\left(\\dfrac{3}{2}\\right)^4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung populasi akhir koloni bakteri**" },
        { "tipe": "formula_block", "latex": "P = 500 \\cdot \\dfrac{81}{16} = \\dfrac{40.500}{16} = 2.531{,}25" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, populasi bakteri setelah 8 jam adalah **$2.531{,}25$ bakteri**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+3) = {}^4\\log(x^2 + 3x + 9)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Samakan basis logaritma kedua ruas menjadi basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x + 3) = \\dfrac{{}^2\\log(x^2 + 3x + 9)}{{}^2\\log 4} = \\dfrac{{}^2\\log(x^2 + 3x + 9)}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan kedua ruas dengan $2$ dan gunakan sifat $n \\cdot {}^a\\log b = {}^a\\log b^n$**" },
        { "tipe": "formula_block", "latex": "2 \\cdot {}^2\\log(x + 3) = {}^2\\log(x^2 + 3x + 9) \\Rightarrow {}^2\\log(x + 3)^2 = {}^2\\log(x^2 + 3x + 9)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan numerus kedua ruas dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "(x + 3)^2 = x^2 + 3x + 9" },
        { "tipe": "formula_block", "latex": "x^2 + 6x + 9 = x^2 + 3x + 9 \\Rightarrow 3x = 0 \\Rightarrow x = 0" },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji $x = 0$ terhadap syarat numerus**" },
        { "tipe": "paragraph", "text": "Untuk $x = 0$, diperoleh $x + 3 = 3 > 0$ dan $x^2 + 3x + 9 = 9 > 0$, sehingga keduanya memenuhi syarat numerus." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x$ dan $y$ memenuhi $2^x \\cdot 4^y = 64$ dan $3^x \\cdot 3^y = 81$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "2^x \\cdot (2^2)^y = 2^6 \\Rightarrow 2^{x + 2y} = 2^6 \\Rightarrow x + 2y = 6" },
        { "tipe": "formula_block", "latex": "3^x \\cdot 3^y = 3^4 \\Rightarrow 3^{x + y} = 3^4 \\Rightarrow x + y = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x + y$ langsung dari persamaan kedua**" },
        { "tipe": "paragraph", "text": "Dari persamaan kedua telah diperoleh $x + y = 4$ (dan jika dilanjutkan eliminasi, diperoleh $y = 2$ serta $x = 2$)." },
        { "tipe": "formula_block", "latex": "x + y = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 8 = {}^2\\log 8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^2\\log 8$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 8 = {}^2\\log 2^3 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 8$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $2^{2x} - 5 \\cdot 2^{x} + 4 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 0$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $y = 2^x$ untuk membentuk pertidaksamaan kuadrat**" },
        { "tipe": "paragraph", "text": "Karena $2^{2x} = (2^x)^2 = y^2$, pertidaksamaan menjadi:" },
        { "tipe": "formula_block", "latex": "y^2 - 5y + 4 \\leq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 1)(y - 4) \\leq 0 \\Rightarrow 1 \\leq y \\leq 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke pemisalan awal $y = 2^x$ dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "1 \\leq 2^x \\leq 4 \\Rightarrow 2^0 \\leq 2^x \\leq 2^2 \\Rightarrow 0 \\leq x \\leq 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$0 \\leq x \\leq 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3^{x} + 3^{-x}$ dan $f(a) = 4$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 4$**" },
        { "tipe": "formula_block", "latex": "f(a) = 3^a + 3^{-a} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(3^a + 3^{-a})^2 = 4^2" },
        { "tipe": "formula_block", "latex": "(3^a)^2 + 2 \\cdot 3^a \\cdot 3^{-a} + (3^{-a})^2 = 16" },
        { "tipe": "formula_block", "latex": "3^{2a} + 2 \\cdot 3^{a - a} + 3^{-2a} = 16 \\Rightarrow 3^{2a} + 2 + 3^{-2a} = 16" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 3^{2a} + 3^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 3^{2a} + 3^{-2a} = 16 - 2 = 14" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$14$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp5.000.000,00 diinvestasikan dengan bunga majemuk 8% per tahun. Waktu minimum agar modal menjadi minimal Rp7.000.000,00 adalah... (gunakan ${}^2\\log 1{,}08 \\approx 0{,}111$, ${}^2\\log 5 \\approx 2{,}322$, dan ${}^2\\log 7 \\approx 2{,}807$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$8$ tahun" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "5.000.000(1 + 0{,}08)^t \\geq 7.000.000 \\Rightarrow (1{,}08)^t \\geq \\dfrac{7}{5}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}08}\\log\\left(\\dfrac{7}{5}\\right) = \\dfrac{{}^2\\log(7/5)}{{}^2\\log 1{,}08} = \\dfrac{{}^2\\log 7 - {}^2\\log 5}{{}^2\\log 1{,}08}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{2{,}807 - 2{,}322}{0{,}111} = \\dfrac{0{,}485}{0{,}111} \\approx 4{,}37" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $4{,}37$ tahun dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$5$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
