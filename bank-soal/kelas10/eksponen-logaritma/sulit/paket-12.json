{
  "id": "bs-k10-eks-sulit-12",
  "nama": "Bank Soal Sulit - Paket 12",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-12-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x} - 12 \\cdot 3^{x} + 27 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk persamaan eksponen dengan menjabarkan $9^x = (3^x)^2$**" },
        { "tipe": "formula_block", "latex": "(3^x)^2 - 12 \\cdot 3^x + 27 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 3^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 12y + 27 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 9)(y - 3) = 0 \\Rightarrow y = 9 \\quad \\text{atau} \\quad y = 3" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 3^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 9 \\Rightarrow 3^x = 9 = 3^2 \\Rightarrow x = 2" },
        { "tipe": "formula_block", "latex": "y = 3 \\Rightarrow 3^x = 3 = 3^1 \\Rightarrow x = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 1$ atau $x = 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 5 = a$ dan ${}^2\\log 3 = b$, maka nilai ${}^{15}\\log 25$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2a}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a}{a - b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{15}\\log 25$ ke basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^{15}\\log 25 = \\dfrac{{}^2\\log 25}{{}^2\\log 15}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 25 = {}^2\\log(5^2) = 2 \\cdot {}^2\\log 5 = 2a" },
        { "tipe": "formula_block", "latex": "{}^2\\log 15 = {}^2\\log(3 \\cdot 5) = {}^2\\log 3 + {}^2\\log 5 = b + a = a + b" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{15}\\log 25 = \\dfrac{2a}{a + b}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{15}\\log 25$ adalah **$\\dfrac{2a}{a + b}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 4x - 4) \\leq 3$ dengan syarat domain $x^2 - 4x - 5 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 \\leq x < -1$ atau $5 < x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < -2$ atau $x > 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat domain dari soal ($x^2 - 4x - 5 > 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 4x - 5 > 0 \\Rightarrow (x - 5)(x + 1) > 0 \\Rightarrow x < -1 \\quad \\text{atau} \\quad x > 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $2 > 1$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x^2 - 4x - 4) \\leq {}^2\\log 2^3 \\Rightarrow x^2 - 4x - 4 \\leq 8" },
        { "tipe": "formula_block", "latex": "x^2 - 4x - 12 \\leq 0 \\Rightarrow (x - 6)(x + 2) \\leq 0 \\Rightarrow -2 \\leq x \\leq 6" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan hasil penyelesaian dengan syarat domain**" },
        { "tipe": "paragraph", "text": "Irisan dari ($x < -1$ atau $x > 5$) dan ($-2 \\leq x \\leq 6$) adalah:" },
        { "tipe": "formula_block", "latex": "-2 \\leq x < -1 \\quad \\text{atau} \\quad 5 < x \\leq 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-2 \\leq x < -1$ atau $5 < x \\leq 6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah populasi serangga mula-mula 320. Populasi berlipat ganda setiap 3 jam. Populasi setelah 15 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5.120$" } ],
        [ { "tipe": "paragraph", "text": "$10.240$" } ],
        [ { "tipe": "paragraph", "text": "$20.480$" } ],
        [ { "tipe": "paragraph", "text": "$40.960$" } ],
        [ { "tipe": "paragraph", "text": "$81.920$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan banyak periode pertumbuhan selama $15$ jam**" },
        { "tipe": "formula_block", "latex": "n = \\dfrac{15\\text{ jam}}{3\\text{ jam}} = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung populasi akhir menggunakan rumus pertumbuhan eksponensial $P = P_0 \\cdot 2^n$**" },
        { "tipe": "formula_block", "latex": "P = 320 \\times 2^5 = 320 \\times 32 = 10.240" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, populasi serangga setelah 15 jam adalah **$10.240$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-2) + {}^2\\log(x+3) = {}^2\\log 24$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus untuk setiap logaritma**" },
        { "tipe": "formula_block", "latex": "x - 2 > 0 \\Rightarrow x > 2" },
        { "tipe": "formula_block", "latex": "x + 3 > 0 \\Rightarrow x > -3" },
        { "tipe": "paragraph", "text": "Irisan dari kedua syarat numerus tersebut adalah $x > 2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan ruas kiri menggunakan sifat penjumlahan logaritma**" },
        { "tipe": "formula_block", "latex": "{}^2\\log[(x - 2)(x + 3)] = {}^2\\log 24" },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan numerus kedua ruas dan selesaikan persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(x - 2)(x + 3) = 24 \\Rightarrow x^2 + x - 6 = 24" },
        { "tipe": "formula_block", "latex": "x^2 + x - 30 = 0 \\Rightarrow (x + 6)(x - 5) = 0" },
        { "tipe": "formula_block", "latex": "x = -6 \\quad \\text{atau} \\quad x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji nilai $x$ terhadap syarat numerus $x > 2$**" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > 2$, maka $x = -6$ tidak memenuhi dan nilai yang valid hanyalah $x = 5$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $3^a \\cdot 9^b = 729$ dan $2^{a+b} = 16$. Nilai $a \\cdot b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "3^a \\cdot (3^2)^b = 3^6 \\Rightarrow 3^{a + 2b} = 3^6 \\Rightarrow a + 2b = 6" },
        { "tipe": "formula_block", "latex": "2^{a + b} = 2^4 \\Rightarrow a + b = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $a$ untuk mendapatkan nilai $b$, lalu substitusikan untuk mencari $a$**" },
        { "tipe": "formula_block", "latex": "(a + 2b) - (a + b) = 6 - 4 \\Rightarrow b = 2" },
        { "tipe": "formula_block", "latex": "a + 2 = 4 \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil kali $a \\cdot b$**" },
        { "tipe": "formula_block", "latex": "a \\cdot b = 2 \\cdot 2 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a \\cdot b$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 32 = {}^2\\log 32" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^2\\log 32$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 32 = {}^2\\log 2^5 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 32$ adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $9^{x} - 28 \\cdot 3^{x} + 27 > 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 0$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan $9^x = (3^x)^2$ dan misalkan $y = 3^x$ untuk membentuk pertidaksamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 28y + 27 > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 27)(y - 1) > 0 \\Rightarrow y < 1 \\quad \\text{atau} \\quad y > 27" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke pemisalan awal $y = 3^x$ dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "3^x < 1 = 3^0 \\Rightarrow x < 0" },
        { "tipe": "formula_block", "latex": "3^x > 27 = 3^3 \\Rightarrow x > 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x < 0$ atau $x > 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2^{x} + 2^{-x}$ dan $f(a) = 6$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 6$**" },
        { "tipe": "formula_block", "latex": "f(a) = 2^a + 2^{-a} = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(2^a + 2^{-a})^2 = 6^2" },
        { "tipe": "formula_block", "latex": "(2^a)^2 + 2 \\cdot 2^a \\cdot 2^{-a} + (2^{-a})^2 = 36" },
        { "tipe": "formula_block", "latex": "2^{2a} + 2 \\cdot 2^{a - a} + 2^{-2a} = 36 \\Rightarrow 2^{2a} + 2 + 2^{-2a} = 36" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 2^{2a} + 2^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 2^{2a} + 2^{-2a} = 36 - 2 = 34" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$34$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp10.000.000,00 dibungakan majemuk 4% per tahun. Waktu minimum agar modal menjadi minimal Rp12.000.000,00 adalah... (gunakan ${}^2\\log 1{,}04 \\approx 0{,}0566$ dan ${}^2\\log 1{,}2 \\approx 0{,}263$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "10.000.000(1 + 0{,}04)^t \\geq 12.000.000 \\Rightarrow (1{,}04)^t \\geq \\dfrac{12.000.000}{10.000.000} = 1{,}2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}04}\\log 1{,}2 = \\dfrac{{}^2\\log 1{,}2}{{}^2\\log 1{,}04}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{0{,}263}{0{,}0566} \\approx 4{,}65" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $4{,}65$ tahun dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$5$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
