{
  "id": "bs-k10-eks-sulit-12",
  "nama": "Bank Soal Sulit - Paket 12",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-12-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x} - 12 \\cdot 3^{x} + 27 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan eksponen dengan menjabarkan suku $9^x = (3^x)^2$." },
        { "tipe": "paragraph", "text": "$(3^x)^2 - 12 \\cdot 3^x + 27 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Lakukan pemisalan $y = 3^x$ untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 12y + 27 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 9)(y - 3) = 0 \\Rightarrow y = 9 \\text{ atau } y = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kembalikan ke pemisalan awal untuk menentukan nilai $x$." },
        { "tipe": "paragraph", "text": "Untuk $y = 9 \\Rightarrow 3^x = 9 = 3^2 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "Untuk $y = 3 \\Rightarrow 3^x = 3 = 3^1 \\Rightarrow x = 1$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 1$ atau $x = 2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 5 = a$ dan ${}^2\\log 3 = b$, maka nilai ${}^{15}\\log 25$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2a}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a}{a - b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk ${}^{15}\\log 25$ menggunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "${}^{15}\\log 25 = \\dfrac{{}^2\\log 25}{{}^2\\log 15}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Uraikan numerus $25$ dan $15$ ke dalam faktor primanya yang memuat $5$ dan $3$ ($25 = 5^2$ dan $15 = 3 \\cdot 5$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 25 = {}^2\\log(5^2) = 2 \\cdot {}^2\\log 5 = 2a$" },
        { "tipe": "paragraph", "text": "${}^2\\log 15 = {}^2\\log(3 \\cdot 5) = {}^2\\log 3 + {}^2\\log 5 = b + a = a + b$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai tersebut ke bentuk pecahan." },
        { "tipe": "paragraph", "text": "${}^{15}\\log 25 = \\dfrac{2a}{a + b}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{2a}{a + b}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 4x - 4) \\leq 3$ dengan syarat domain $x^2 - 4x - 5 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2 \\leq x < -1$ atau $5 < x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-2 \\leq x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < -2$ atau $x > 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain dari soal ($x^2 - 4x - 5 > 0$)." },
        { "tipe": "paragraph", "text": "$(x - 5)(x + 1) > 0 \\Rightarrow x < -1 \\text{ atau } x > 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Selesaikan pertidaksamaan logaritma dengan mengubah konstanta $3$ menjadi ${}^2\\log 2^3 = {}^2\\log 8$." },
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 4x - 4) \\leq {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "Karena basis $2 > 1$, tanda pertidaksamaan tetap:" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 4 \\leq 8 \\Rightarrow x^2 - 4x - 12 \\leq 0$" },
        { "tipe": "paragraph", "text": "$(x - 6)(x + 2) \\leq 0 \\Rightarrow -2 \\leq x \\leq 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Iriskan hasil penyelesaian dengan syarat domain ($x < -1 \\text{ atau } x > 5$). Irisan yang diperoleh adalah $-2 \\leq x < -1$ atau $5 < x \\leq 6$." },
        { "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $-2 \\leq x < -1$ atau $5 < x \\leq 6$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah populasi serangga mula-mula 320. Populasi berlipat ganda setiap 3 jam. Populasi setelah 15 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5.120$" } ],
        [ { "tipe": "paragraph", "text": "$10.240$" } ],
        [ { "tipe": "paragraph", "text": "$20.480$" } ],
        [ { "tipe": "paragraph", "text": "$40.960$" } ],
        [ { "tipe": "paragraph", "text": "$81.920$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan banyak periode pertumbuhan $n = \\dfrac{15 \\text{ jam}}{3 \\text{ jam}} = 5$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung populasi akhir menggunakan rumus pertumbuhan eksponensial $P = P_0 \\cdot 2^n$." },
        { "tipe": "paragraph", "text": "$P = 320 \\times 2^5 = 320 \\times 32 = 10.240$" },
        { "tipe": "paragraph", "text": "Jadi, populasi setelah 15 jam adalah $10.240$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-2) + {}^2\\log(x+3) = {}^2\\log 24$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain ($x - 2 > 0 \\Rightarrow x > 2$ dan $x + 3 > 0 \\Rightarrow x > -3$). Irisan syarat domain adalah $x > 2$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan persamaan logaritma menggunakan sifat penjumlahan logaritma." },
        { "tipe": "paragraph", "text": "${}^2\\log[(x-2)(x+3)] = {}^2\\log 24$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan numerusnya." },
        { "tipe": "paragraph", "text": "$(x - 2)(x + 3) = 24 \\Rightarrow x^2 + x - 6 = 24$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 30 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x + 6)(x - 5) = 0 \\Rightarrow x = -6 \\text{ atau } x = 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 5:</strong> Uji nilai $x$ terhadap syarat domain $x > 2$. Nilai $x = -6$ tidak memenuhi, sehingga yang memenuhi adalah $x = 5$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 5$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $3^a \\cdot 9^b = 729$ dan $2^{a+b} = 16$. Nilai $a \\cdot b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah setiap persamaan ke dalam bentuk basis bilangan prima yang sama ($9 = 3^2$, $729 = 3^6$, dan $16 = 2^4$)." },
        { "tipe": "paragraph", "text": "$3^a \\cdot (3^2)^b = 3^6 \\Rightarrow 3^a \\cdot 3^{2b} = 3^6 \\Rightarrow a + 2b = 6$ (Persamaan 1)" },
        { "tipe": "paragraph", "text": "$2^{a+b} = 2^4 \\Rightarrow a + b = 4$ (Persamaan 2)" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Eliminasi variabel $a$ dengan mengurangkan Persamaan 1 dan Persamaan 2." },
        { "tipe": "paragraph", "text": "$(a + 2b) - (a + b) = 6 - 4 \\Rightarrow b = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai $b = 2$ ke Persamaan 2 untuk mencari nilai $a$." },
        { "tipe": "paragraph", "text": "$a + 2 = 4 \\Rightarrow a = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Hitung nilai hasil kali $a \\cdot b$." },
        { "tipe": "paragraph", "text": "$a \\cdot b = 2 \\cdot 2 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $a \\cdot b$ adalah $4$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$." },
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan bentuk ${}^2\\log 32$." },
        { "tipe": "paragraph", "text": "${}^2\\log 2^5 = 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $9^{x} - 28 \\cdot 3^{x} + 27 > 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 0$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tuliskan bentuk $9^x$ sebagai $(3^x)^2$ dan lakukan pemisalan $y = 3^x$ untuk membentuk pertidaksamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 28y + 27 > 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Faktorkan bentuk kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 27)(y - 1) > 0 \\Rightarrow y < 1 \\text{ atau } y > 27$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kembalikan ke pemisalan awal." },
        { "tipe": "paragraph", "text": "Untuk $y < 1 \\Rightarrow 3^x < 1 = 3^0 \\Rightarrow x < 0$" },
        { "tipe": "paragraph", "text": "Untuk $y > 27 \\Rightarrow 3^x > 27 = 3^3 \\Rightarrow x > 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Gabungkan daerah penyelesaian." },
        { "tipe": "paragraph", "text": "$x < 0$ atau $x > 3$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x < 0$ atau $x > 3$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2^{x} + 2^{-x}$ dan $f(a) = 6$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tuliskan persamaan dari $f(a) = 6$." },
        { "tipe": "paragraph", "text": "$f(a) = 2^a + 2^{-a} = 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kuadratkan kedua ruas persamaan tersebut." },
        { "tipe": "paragraph", "text": "$(2^a + 2^{-a})^2 = 6^2$" },
        { "tipe": "paragraph", "text": "$(2^a)^2 + 2 \\cdot 2^a \\cdot 2^{-a} + (2^{-a})^2 = 36$" },
        { "tipe": "paragraph", "text": "$2^{2a} + 2 \\cdot 2^{a-a} + 2^{-2a} = 36 \\Rightarrow 2^{2a} + 2 + 2^{-2a} = 36$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan untuk mendapatkan nilai $2^{2a} + 2^{-2a}$." },
        { "tipe": "paragraph", "text": "$2^{2a} + 2^{-2a} = 36 - 2 = 34$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Perhatikan bahwa $f(2a) = 2^{2a} + 2^{-2a} = 34$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $f(2a)$ adalah $34$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-12-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp10.000.000,00 dibungakan majemuk 4% per tahun. Waktu minimum agar modal menjadi minimal Rp12.000.000,00 adalah... (gunakan ${}^2\\log 1{,}04 \\approx 0{,}0566$ dan ${}^2\\log 1{,}2 \\approx 0{,}263$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Masukkan data ke dalam rumus bunga majemuk $M_t = M_0(1 + r)^t$." },
        { "tipe": "paragraph", "text": "$10.000.000(1 + 0{,}04)^t \\geq 12.000.000 \\Rightarrow (1{,}04)^t \\geq \\dfrac{12.000.000}{10.000.000} = \\dfrac{12}{10} = 1{,}2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah bentuk pertidaksamaan eksponen ke bentuk logaritma." },
        { "tipe": "paragraph", "text": "$t \\geq {}^1{,}04\\log 1{,}2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log 1{,}2}{{}^2\\log 1{,}04} = \\dfrac{0{,}263}{0{,}0566} \\approx 4{,}65$ tahun" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "Jadi, waktu minimumnya adalah $5$ tahun (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
