{
  "id": "bs-k10-eks-sulit-13",
  "nama": "Bank Soal Sulit - Paket 13",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-13-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x} - 5 \\cdot 2^{x} + 4 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan eksponen dengan menjabarkan suku $4^x = (2^x)^2$." },
        { "tipe": "paragraph", "text": "$(2^x)^2 - 5 \\cdot 2^x + 4 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Lakukan pemisalan $y = 2^x$ untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 5y + 4 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 4)(y - 1) = 0 \\Rightarrow y = 4 \\text{ atau } y = 1$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kembalikan ke pemisalan awal untuk menentukan nilai $x$." },
        { "tipe": "paragraph", "text": "Untuk $y = 4 \\Rightarrow 2^x = 4 = 2^2 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "Untuk $y = 1 \\Rightarrow 2^x = 1 = 2^0 \\Rightarrow x = 0$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 0$ atau $x = 2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = a$ dan ${}^2\\log 5 = b$, maka nilai ${}^{45}\\log 75$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2b + a}{2a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{2b + a}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{b + 2a}{a + 2b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk ${}^{45}\\log 75$ menggunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "${}^{45}\\log 75 = \\dfrac{{}^2\\log 75}{{}^2\\log 45}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Uraikan numerus $75$ dan $45$ ke dalam faktor primanya yang memuat $3$ dan $5$ ($75 = 3 \\cdot 25 = 3 \\cdot 5^2$ dan $45 = 9 \\cdot 5 = 3^2 \\cdot 5$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 75 = {}^2\\log(3 \\cdot 5^2) = {}^2\\log 3 + 2 \\cdot {}^2\\log 5 = a + 2b = 2b + a$" },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log(3^2 \\cdot 5) = 2 \\cdot {}^2\\log 3 + {}^2\\log 5 = 2a + b$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai tersebut ke bentuk pecahan." },
        { "tipe": "paragraph", "text": "${}^{45}\\log 75 = \\dfrac{2b + a}{2a + b}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{2b + a}{2a + b}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 3x - 10) < 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -2$ atau $5 < x < 6$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -2$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain numerus ($x^2 - 3x - 10 > 0$)." },
        { "tipe": "paragraph", "text": "$(x - 5)(x + 2) > 0 \\Rightarrow x < -2 \\text{ atau } x > 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Selesaikan pertidaksamaan logaritma dengan mengubah konstanta $3$ menjadi ${}^2\\log 2^3 = {}^2\\log 8$." },
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 3x - 10) < {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "Karena basis $2 > 1$, tanda pertidaksamaan tetap:" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 10 < 8 \\Rightarrow x^2 - 3x - 18 < 0$" },
        { "tipe": "paragraph", "text": "$(x - 6)(x + 3) < 0 \\Rightarrow -3 < x < 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Iriskan hasil penyelesaian dengan syarat domain ($x < -2 \\text{ atau } x > 5$). Irisan yang diperoleh adalah $-3 < x < -2$ atau $5 < x < 6$." },
        { "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $-3 < x < -2$ atau $5 < x < 6$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah zat radioaktif memiliki waktu paruh 10 tahun. Jika massa awal 800 gram, massa setelah 30 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$200$ gram" } ],
        [ { "tipe": "paragraph", "text": "$100$ gram" } ],
        [ { "tipe": "paragraph", "text": "$50$ gram" } ],
        [ { "tipe": "paragraph", "text": "$25$ gram" } ],
        [ { "tipe": "paragraph", "text": "$400$ gram" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus peluruhan zat radioaktif $M(t) = M_0 \\left(\\dfrac{1}{2}\\right)^{t/T}$ dengan $M_0 = 800$, $T = 10$, dan $t = 30$." },
        { "tipe": "paragraph", "text": "$M(30) = 800 \\left(\\dfrac{1}{2}\\right)^{30/10}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai pangkatnya ($30/10 = 3$)." },
        { "tipe": "paragraph", "text": "$M(30) = 800 \\left(\\dfrac{1}{2}\\right)^3 = 800 \\cdot \\dfrac{1}{8} = 100$ gram" },
        { "tipe": "paragraph", "text": "Jadi, massa setelah 30 tahun adalah $100$ gram (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(x-1) + {}^3\\log(x+2) = {}^3\\log 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain ($x - 1 > 0 \\Rightarrow x > 1$ dan $x + 2 > 0 \\Rightarrow x > -2$). Irisan syarat domain adalah $x > 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan persamaan logaritma menggunakan sifat penjumlahan logaritma." },
        { "tipe": "paragraph", "text": "${}^3\\log[(x-1)(x+2)] = {}^3\\log 10$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan numerusnya." },
        { "tipe": "paragraph", "text": "$(x - 1)(x + 2) = 10 \\Rightarrow x^2 + x - 2 = 10$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x + 4)(x - 3) = 0 \\Rightarrow x = -4 \\text{ atau } x = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 5:</strong> Uji nilai $x$ terhadap syarat domain $x > 1$. Nilai $x = -4$ tidak memenuhi, sehingga yang memenuhi adalah $x = 3$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 3$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 8^b = 256$ dan $3^{a+b} = 81$. Nilai $a \\cdot b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah setiap persamaan ke dalam bentuk basis bilangan prima yang sama ($8 = 2^3$, $256 = 2^8$, dan $81 = 3^4$)." },
        { "tipe": "paragraph", "text": "$2^a \\cdot (2^3)^b = 2^8 \\Rightarrow 2^a \\cdot 2^{3b} = 2^8 \\Rightarrow a + 3b = 8$ (Persamaan 1)" },
        { "tipe": "paragraph", "text": "$3^{a+b} = 3^4 \\Rightarrow a + b = 4$ (Persamaan 2)" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Eliminasi variabel $a$ dengan mengurangkan Persamaan 1 dan Persamaan 2." },
        { "tipe": "paragraph", "text": "$(a + 3b) - (a + b) = 8 - 4 \\Rightarrow 2b = 4 \\Rightarrow b = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai $b = 2$ ke Persamaan 2 untuk mencari nilai $a$." },
        { "tipe": "paragraph", "text": "$a + 2 = 4 \\Rightarrow a = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Hitung nilai hasil kali $a \\cdot b$." },
        { "tipe": "paragraph", "text": "$a \\cdot b = 2 \\cdot 2 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $a \\cdot b$ adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 6 \\cdot {}^6\\log 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$." },
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 6 \\cdot {}^6\\log 64 = {}^2\\log 64$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan bentuk ${}^2\\log 64$." },
        { "tipe": "paragraph", "text": "${}^2\\log 2^6 = 6$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $6$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $4^{x} - 7 \\cdot 2^{x} + 12 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\log_2 3 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$\\log_2 3 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq \\log_2 3$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tuliskan bentuk $4^x$ sebagai $(2^x)^2$ dan lakukan pemisalan $y = 2^x$ untuk membentuk pertidaksamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 7y + 12 \\leq 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Faktorkan bentuk kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 3)(y - 4) \\leq 0 \\Rightarrow 3 \\leq y \\leq 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kembalikan ke pemisalan awal." },
        { "tipe": "paragraph", "text": "$3 \\leq 2^x \\leq 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Ubah bentuk eksponen ke dalam bentuk logaritma untuk menentukan batas nilai $x$." },
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\leq x \\leq {}^2\\log 4 \\Rightarrow {}^2\\log 3 \\leq x \\leq 2$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah ${}^2\\log 3 \\leq x \\leq 2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3^{x} + 3^{-x}$ dan $f(a) = 3$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tuliskan persamaan dari $f(a) = 3$." },
        { "tipe": "paragraph", "text": "$f(a) = 3^a + 3^{-a} = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kuadratkan kedua ruas persamaan tersebut." },
        { "tipe": "paragraph", "text": "$(3^a + 3^{-a})^2 = 3^2$" },
        { "tipe": "paragraph", "text": "$(3^a)^2 + 2 \\cdot 3^a \\cdot 3^{-a} + (3^{-a})^2 = 9$" },
        { "tipe": "paragraph", "text": "$3^{2a} + 2 \\cdot 3^{a-a} + 3^{-2a} = 9 \\Rightarrow 3^{2a} + 2 + 3^{-2a} = 9$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan untuk mendapatkan nilai $3^{2a} + 3^{-2a}$." },
        { "tipe": "paragraph", "text": "$3^{2a} + 3^{-2a} = 9 - 2 = 7$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Perhatikan bahwa $f(2a) = 3^{2a} + 3^{-2a} = 7$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $f(2a)$ adalah $7$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp8.000.000,00 dibungakan majemuk 5% per tahun. Waktu minimum agar modal menjadi minimal Rp9.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 1{,}125 \\approx 0{,}170$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Masukkan data ke dalam rumus bunga majemuk $M_t = M_0(1 + r)^t$." },
        { "tipe": "paragraph", "text": "$8.000.000(1 + 0{,}05)^t \\geq 9.000.000 \\Rightarrow (1{,}05)^t \\geq \\dfrac{9.000.000}{8.000.000} = \\dfrac{9}{8} = 1{,}125$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah bentuk pertidaksamaan eksponen ke bentuk logaritma." },
        { "tipe": "paragraph", "text": "$t \\geq {}^1{,}05\\log 1{,}125$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log 1{,}125}{{}^2\\log 1{,}05} = \\dfrac{0{,}170}{0{,}0704} \\approx 2{,}41$ tahun" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka dibulatkan ke atas menjadi $3$ tahun." },
        { "tipe": "paragraph", "text": "Jadi, waktu minimumnya adalah $3$ tahun (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
