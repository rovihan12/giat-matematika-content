{
  "id": "bs-k10-eks-sulit-13",
  "nama": "Bank Soal Sulit - Paket 13",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-13-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x} - 5 \\cdot 2^{x} + 4 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(2^x)^2 - 5 \\cdot 2^x + 4 = 0$" },
        { "tipe": "paragraph", "text": "Misal $y = 2^x$: $y^2 - 5y + 4 = 0$" },
        { "tipe": "paragraph", "text": "$(y - 4)(y - 1) = 0 \\Rightarrow y = 4$ atau $y = 1$" },
        { "tipe": "paragraph", "text": "$2^x = 4 \\Rightarrow x = 2$; $2^x = 1 \\Rightarrow x = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = a$ dan ${}^2\\log 5 = b$, maka nilai ${}^{45}\\log 75$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2b + a}{2a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{2b + a}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{b + 2a}{a + 2b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^{45}\\log 75 = \\dfrac{{}^2\\log 75}{{}^2\\log 45}$" },
        { "tipe": "paragraph", "text": "${}^2\\log 75 = {}^2\\log(3 \\cdot 25) = a + 2b = 2b + a$" },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log(9 \\cdot 5) = 2a + b$" },
        { "tipe": "paragraph", "text": "Jadi ${}^{45}\\log 75 = \\dfrac{2b + a}{2a + b}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 3x - 10) < 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -2$ atau $5 < x < 6$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -2$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat domain numerus: $x^2 - 3x - 10 > 0 \\Rightarrow (x-5)(x+2) > 0 \\Rightarrow x < -2$ atau $x > 5$" },
        { "tipe": "paragraph", "text": "Pertidaksamaan: ${}^2\\log(x^2 - 3x - 10) < 3 \\Rightarrow x^2 - 3x - 10 < 2^3 = 8$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 18 < 0 \\Rightarrow (x - 6)(x + 3) < 0 \\Rightarrow -3 < x < 6$" },
        { "tipe": "paragraph", "text": "Irisan antara domain dan pertidaksamaan: $-3 < x < -2$ atau $5 < x < 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah zat radioaktif memiliki waktu paruh 10 tahun. Jika massa awal 800 gram, massa setelah 30 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$200$ gram" } ],
        [ { "tipe": "paragraph", "text": "$100$ gram" } ],
        [ { "tipe": "paragraph", "text": "$50$ gram" } ],
        [ { "tipe": "paragraph", "text": "$25$ gram" } ],
        [ { "tipe": "paragraph", "text": "$400$ gram" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$M(t) = M_0 \\left(\\dfrac{1}{2}\\right)^{t/T}$" },
        { "tipe": "paragraph", "text": "$M(30) = 800 \\left(\\dfrac{1}{2}\\right)^{30/10} = 800 \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "$= 800 \\cdot \\dfrac{1}{8} = 100$ gram" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(x-1) + {}^3\\log(x+2) = {}^3\\log 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat: $x > 1$" },
        { "tipe": "paragraph", "text": "${}^3\\log[(x-1)(x+2)] = {}^3\\log 10$" },
        { "tipe": "paragraph", "text": "$(x-1)(x+2) = 10 \\Rightarrow x^2 + x - 2 = 10$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0 \\Rightarrow (x+4)(x-3) = 0$" },
        { "tipe": "paragraph", "text": "Karena $x > 1$, maka $x = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 8^b = 256$ dan $3^{a+b} = 81$. Nilai $a \\cdot b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^a \\cdot 2^{3b} = 2^8 \\Rightarrow a + 3b = 8$" },
        { "tipe": "paragraph", "text": "$3^{a+b} = 3^4 \\Rightarrow a + b = 4$" },
        { "tipe": "paragraph", "text": "Kurangkan: $2b = 4 \\Rightarrow b = 2$, maka $a = 2$" },
        { "tipe": "paragraph", "text": "$a \\cdot b = 2 \\cdot 2 = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 6 \\cdot {}^6\\log 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 6 \\cdot {}^6\\log 64 = {}^2\\log 64$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^6 = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $4^{x} - 7 \\cdot 2^{x} + 12 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\log_2 3 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$\\log_2 3 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq \\log_2 3$ atau $x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $y = 2^x$: $y^2 - 7y + 12 \\leq 0$" },
        { "tipe": "paragraph", "text": "$(y - 3)(y - 4) \\leq 0 \\Rightarrow 3 \\leq y \\leq 4$" },
        { "tipe": "paragraph", "text": "$3 \\leq 2^x \\leq 4$" },
        { "tipe": "paragraph", "text": "$\\log_2 3 \\leq x \\leq 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 3^{x} + 3^{-x}$ dan $f(a) = 3$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(a) = 3^a + 3^{-a} = 3$" },
        { "tipe": "paragraph", "text": "Kuadratkan: $(3^a + 3^{-a})^2 = 9$" },
        { "tipe": "paragraph", "text": "$3^{2a} + 2 + 3^{-2a} = 9$" },
        { "tipe": "paragraph", "text": "$3^{2a} + 3^{-2a} = 7$" },
        { "tipe": "paragraph", "text": "$f(2a) = 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-13-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp8.000.000,00 dibungakan majemuk 5% per tahun. Waktu minimum agar modal menjadi minimal Rp9.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 1{,}125 \\approx 0{,}170$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$8.000.000(1{,}05)^t \\geq 9.000.000$" },
        { "tipe": "paragraph", "text": "$(1{,}05)^t \\geq 1{,}125$" },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log 1{,}125}{{}^2\\log 1{,}05} = \\dfrac{0{,}170}{0{,}0704} \\approx 2{,}41$" },
        { "tipe": "paragraph", "text": "Jadi $t_{\\min} = 3$ tahun" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
