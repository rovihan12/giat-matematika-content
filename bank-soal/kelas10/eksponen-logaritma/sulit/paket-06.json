{
  "id": "bs-k10-eks-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $16^{x} - 5 \\cdot 4^{x} + 4 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan eksponen dengan menjabarkan suku $16^x = (4^x)^2$." },
        { "tipe": "paragraph", "text": "$(4^x)^2 - 5 \\cdot 4^x + 4 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Lakukan pemisalan $y = 4^x$ untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 5y + 4 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 4)(y - 1) = 0 \\Rightarrow y = 4 \\text{ atau } y = 1$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kembalikan ke pemisalan awal untuk menentukan nilai $x$." },
        { "tipe": "paragraph", "text": "Untuk $y = 4 \\Rightarrow 4^x = 4 = 4^1 \\Rightarrow x = 1$" },
        { "tipe": "paragraph", "text": "Untuk $y = 1 \\Rightarrow 4^x = 1 = 4^0 \\Rightarrow x = 0$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 0$ atau $x = 1$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 7 = a$ dan ${}^2\\log 3 = b$, maka nilai ${}^{21}\\log 28$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{b + 2}{a + b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk ${}^{21}\\log 28$ menggunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "${}^{21}\\log 28 = \\dfrac{{}^2\\log 28}{{}^2\\log 21}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Uraikan numerus $28$ dan $21$ ke dalam faktor primanya yang memuat $7$ dan $3$ ($28 = 4 \\cdot 7 = 2^2 \\cdot 7$ dan $21 = 3 \\cdot 7$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 28 = {}^2\\log(2^2 \\cdot 7) = 2 \\cdot {}^2\\log 2 + {}^2\\log 7 = 2 + a$" },
        { "tipe": "paragraph", "text": "${}^2\\log 21 = {}^2\\log(3 \\cdot 7) = {}^2\\log 3 + {}^2\\log 7 = b + a = a + b$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai tersebut ke bentuk pecahan." },
        { "tipe": "paragraph", "text": "${}^{21}\\log 28 = \\dfrac{a + 2}{a + b}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{a + 2}{a + b}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^3\\log(x^2 - 5x + 7) < 1$ dengan syarat $x^2 - 5x + 6 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 < x < 2$ atau $3 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain dari soal ($x^2 - 5x + 6 > 0$)." },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 3) > 0 \\Rightarrow x < 2 \\text{ atau } x > 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Selesaikan pertidaksamaan logaritma dengan mengubah konstanta $1$ menjadi ${}^3\\log 3$." },
        { "tipe": "paragraph", "text": "${}^3\\log(x^2 - 5x + 7) < {}^3\\log 3$" },
        { "tipe": "paragraph", "text": "Karena basis $3 > 1$, tanda pertidaksamaan tetap:" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 7 < 3 \\Rightarrow x^2 - 5x + 4 < 0$" },
        { "tipe": "paragraph", "text": "$(x - 1)(x - 4) < 0 \\Rightarrow 1 < x < 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Iriskan hasil penyelesaian dengan syarat domain ($x < 2 \\text{ atau } x > 3$). Irisan yang memenuhi adalah $1 < x < 2$ atau $3 < x < 4$." },
        { "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $1 < x < 2$ atau $3 < x < 4$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kultur bakteri mula-mula 400 sel. Setiap 3 jam populasi bertambah 100% dari populasi sebelumnya. Populasi setelah 9 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.600$ sel" } ],
        [ { "tipe": "paragraph", "text": "$3.200$ sel" } ],
        [ { "tipe": "paragraph", "text": "$2.400$ sel" } ],
        [ { "tipe": "paragraph", "text": "$4.800$ sel" } ],
        [ { "tipe": "paragraph", "text": "$6.400$ sel" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan banyak periode pertumbuhan $n = \\dfrac{9 \\text{ jam}}{3 \\text{ jam}} = 3$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Pertambahan 100% berarti populasi bertambah sebesar dirinya sendiri, sehingga populasi berlipat ganda menjadi $2$ kali lipat setiap periode." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Hitung populasi akhir menggunakan rumus pertumbuhan eksponensial $P = P_0 \\cdot 2^n$." },
        { "tipe": "paragraph", "text": "$P = 400 \\times 2^3 = 400 \\times 8 = 3.200$ sel" },
        { "tipe": "paragraph", "text": "Jadi, populasi setelah 9 jam adalah $3.200$ sel (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+4) = {}^4\\log(5x + 26)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah basis logaritma ${}^4\\log(5x+26)$ ke basis $2$ menggunakan sifat ${}^{a^n}\\log b = \\dfrac{1}{n} \\cdot {}^a\\log b$." },
        { "tipe": "paragraph", "text": "${}^4\\log(5x+26) = {}^{2^2}\\log(5x+26) = \\dfrac{1}{2} \\cdot {}^2\\log(5x+26)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan kembali ke dalam persamaan." },
        { "tipe": "paragraph", "text": "${}^2\\log(x+4) = \\dfrac{1}{2} \\cdot {}^2\\log(5x+26)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kalikan kedua ruas dengan $2$ dan gunakan sifat perpangkatan logaritma $n \\cdot {}^a\\log b = {}^a\\log b^n$." },
        { "tipe": "paragraph", "text": "$2 \\cdot {}^2\\log(x+4) = {}^2\\log(5x+26) \\Rightarrow {}^2\\log(x+4)^2 = {}^2\\log(5x+26)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Samakan numerusnya." },
        { "tipe": "paragraph", "text": "$(x+4)^2 = 5x + 26 \\Rightarrow x^2 + 8x + 16 = 5x + 26$" },
        { "tipe": "paragraph", "text": "$x^2 + 3x - 10 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 5:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x + 5)(x - 2) = 0 \\Rightarrow x = -5 \\text{ atau } x = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 6:</strong> Uji syarat numerus ($x + 4 > 0 \\Rightarrow x > -4$). Nilai $x = -5$ tidak memenuhi, sehingga nilai yang memenuhi adalah $x = 2$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 2$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x$ dan $y$ memenuhi $3^x \\cdot 9^y = 243$ dan $2^x \\cdot 2^y = 32$. Nilai $x - y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah setiap persamaan ke dalam basis bilangan prima yang sama." },
        { "tipe": "paragraph", "text": "$3^x \\cdot (3^2)^y = 3^5 \\Rightarrow 3^x \\cdot 3^{2y} = 3^5 \\Rightarrow 3^{x+2y} = 3^5 \\Rightarrow x + 2y = 5$ (Persamaan 1)" },
        { "tipe": "paragraph", "text": "$2^x \\cdot 2^y = 2^5 \\Rightarrow 2^{x+y} = 2^5 \\Rightarrow x + y = 5$ (Persamaan 2)" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Eliminasi variabel $x$ dengan mengurangkan Persamaan 1 dan Persamaan 2." },
        { "tipe": "paragraph", "text": "$(x + 2y) - (x + y) = 5 - 5 \\Rightarrow y = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai $y = 0$ ke Persamaan 2 untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$x + 0 = 5 \\Rightarrow x = 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Hitung nilai $x - y$." },
        { "tipe": "paragraph", "text": "$x - y = 5 - 0 = 5$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x - y$ adalah $5$ (pilihan kelima)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$." },
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 16 = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan bentuk ${}^2\\log 16$." },
        { "tipe": "paragraph", "text": "${}^2\\log 2^4 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $9^{x} - 4 \\cdot 3^{x} + 3 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 0$ atau $x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen $9^x = (3^x)^2$ dan lakukan pemisalan $y = 3^x$ untuk membentuk pertidaksamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 4y + 3 \\leq 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Faktorkan bentuk kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 1)(y - 3) \\leq 0 \\Rightarrow 1 \\leq y \\leq 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kembalikan ke pemisalan awal." },
        { "tipe": "paragraph", "text": "$1 \\leq 3^x \\leq 3 \\Rightarrow 3^0 \\leq 3^x \\leq 3^1$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Samakan pangkatnya karena basis eksponen sama dan lebih dari $1$." },
        { "tipe": "paragraph", "text": "$0 \\leq x \\leq 1$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $0 \\leq x \\leq 1$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5^{x} + 5^{-x}$ dan $f(a) = 7$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$47$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ],
        [ { "tipe": "paragraph", "text": "$53$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tuliskan persamaan dari $f(a) = 7$." },
        { "tipe": "paragraph", "text": "$f(a) = 5^a + 5^{-a} = 7$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kuadratkan kedua ruas persamaan." },
        { "tipe": "paragraph", "text": "$(5^a + 5^{-a})^2 = 7^2 \\Rightarrow (5^a)^2 + 2 \\cdot 5^a \\cdot 5^{-a} + (5^{-a})^2 = 49$" },
        { "tipe": "paragraph", "text": "$5^{2a} + 2 \\cdot 5^{a-a} + 5^{-2a} = 49 \\Rightarrow 5^{2a} + 2 + 5^{-2a} = 49$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan untuk mendapatkan nilai $5^{2a} + 5^{-2a}$." },
        { "tipe": "paragraph", "text": "$5^{2a} + 5^{-2a} = 49 - 2 = 47$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Perhatikan bahwa $f(2a) = 5^{2a} + 5^{-2a} = 47$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $f(2a)$ adalah $47$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Investasi Rp4.000.000,00 dengan bunga majemuk 5% per tahun. Waktu minimum agar investasi menjadi minimal Rp6.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 3 \\approx 1{,}585$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$8$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$9$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$10$ tahun" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Masukkan data ke dalam rumus bunga majemuk $M_t = M_0(1 + r)^t$." },
        { "tipe": "paragraph", "text": "$4.000.000(1 + 0{,}05)^t \\geq 6.000.000 \\Rightarrow (1{,}05)^t \\geq \\dfrac{6}{4} = 1{,}5 = \\dfrac{3}{2}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah pertidaksamaan eksponen ke bentuk logaritma." },
        { "tipe": "paragraph", "text": "$t \\geq {}^1{,}05\\log\\left(\\dfrac{3}{2}\\right)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log\\left(\\dfrac{3}{2}\\right)}{{}^2\\log 1{,}05} = \\dfrac{{}^2\\log 3 - {}^2\\log 2}{{}^2\\log 1{,}05} = \\dfrac{1{,}585 - 1}{0{,}0704} = \\dfrac{0{,}585}{0{,}0704} \\approx 8{,}31$ tahun" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka dibulatkan ke atas menjadi $9$ tahun." },
        { "tipe": "paragraph", "text": "Jadi, waktu minimumnya adalah $9$ tahun (pilihan keempat)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
