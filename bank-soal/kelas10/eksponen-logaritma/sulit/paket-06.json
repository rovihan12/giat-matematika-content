{
  "id": "bs-k10-eks-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $16^{x} - 5 \\cdot 4^{x} + 4 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk persamaan eksponen dengan menjabarkan $16^x = (4^x)^2$**" },
        { "tipe": "formula_block", "latex": "(4^x)^2 - 5 \\cdot 4^x + 4 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 4^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 5y + 4 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 4)(y - 1) = 0 \\Rightarrow y = 4 \\quad \\text{atau} \\quad y = 1" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 4^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 4 \\Rightarrow 4^x = 4 = 4^1 \\Rightarrow x = 1" },
        { "tipe": "formula_block", "latex": "y = 1 \\Rightarrow 4^x = 1 = 4^0 \\Rightarrow x = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 0$ atau $x = 1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 7 = a$ dan ${}^2\\log 3 = b$, maka nilai ${}^{21}\\log 28$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{b + 2}{a + b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{21}\\log 28$ ke basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^{21}\\log 28 = \\dfrac{{}^2\\log 28}{{}^2\\log 21}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 28 = {}^2\\log(2^2 \\cdot 7) = 2 \\cdot {}^2\\log 2 + {}^2\\log 7 = 2 + a" },
        { "tipe": "formula_block", "latex": "{}^2\\log 21 = {}^2\\log(3 \\cdot 7) = {}^2\\log 3 + {}^2\\log 7 = b + a = a + b" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{21}\\log 28 = \\dfrac{a + 2}{a + b}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{21}\\log 28$ adalah **$\\dfrac{a + 2}{a + b}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^3\\log(x^2 - 5x + 7) < 1$ dengan syarat $x^2 - 5x + 6 > 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1 < x < 2$ atau $3 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$2 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat domain dari soal ($x^2 - 5x + 6 > 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 6 > 0 \\Rightarrow (x - 2)(x - 3) > 0 \\Rightarrow x < 2 \\quad \\text{atau} \\quad x > 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $3 > 1$**" },
        { "tipe": "formula_block", "latex": "{}^3\\log(x^2 - 5x + 7) < {}^3\\log 3 \\Rightarrow x^2 - 5x + 7 < 3" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 4 < 0 \\Rightarrow (x - 1)(x - 4) < 0 \\Rightarrow 1 < x < 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan hasil penyelesaian dengan syarat domain**" },
        { "tipe": "paragraph", "text": "Irisan dari ($x < 2$ atau $x > 3$) dan ($1 < x < 4$) adalah:" },
        { "tipe": "formula_block", "latex": "1 < x < 2 \\quad \\text{atau} \\quad 3 < x < 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$1 < x < 2$ atau $3 < x < 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kultur bakteri mula-mula 400 sel. Setiap 3 jam populasi bertambah 100% dari populasi sebelumnya. Populasi setelah 9 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.600$ sel" } ],
        [ { "tipe": "paragraph", "text": "$3.200$ sel" } ],
        [ { "tipe": "paragraph", "text": "$2.400$ sel" } ],
        [ { "tipe": "paragraph", "text": "$4.800$ sel" } ],
        [ { "tipe": "paragraph", "text": "$6.400$ sel" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan banyak periode pertumbuhan selama $9$ jam**" },
        { "tipe": "formula_block", "latex": "n = \\dfrac{9\\text{ jam}}{3\\text{ jam}} = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan data ke rumus pertumbuhan eksponensial $P = P_0(1 + r)^n$**" },
        { "tipe": "paragraph", "text": "Pertambahan $100\\%$ berarti $r = 1$, sehingga populasi berlipat ganda menjadi $1 + 1 = 2$ kali lipat setiap periode:" },
        { "tipe": "formula_block", "latex": "P = 400 \\times 2^3 = 400 \\times 8 = 3.200" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, populasi bakteri setelah 9 jam adalah **$3.200$ sel**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+4) = {}^4\\log(5x + 26)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis logaritma ${}^4\\log(5x + 26)$ ke basis $2$ menggunakan sifat ${}^{a^n}\\log b = \\dfrac{1}{n} \\cdot {}^a\\log b$**" },
        { "tipe": "formula_block", "latex": "{}^4\\log(5x + 26) = {}^{2^2}\\log(5x + 26) = \\dfrac{1}{2} \\cdot {}^2\\log(5x + 26)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan kedua ruas dengan $2$ dan gunakan sifat $n \\cdot {}^a\\log b = {}^a\\log b^n$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x + 4) = \\dfrac{1}{2} \\cdot {}^2\\log(5x + 26) \\Rightarrow 2 \\cdot {}^2\\log(x + 4) = {}^2\\log(5x + 26)" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x + 4)^2 = {}^2\\log(5x + 26)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan numerus kedua ruas dan bentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(x + 4)^2 = 5x + 26 \\Rightarrow x^2 + 8x + 16 = 5x + 26" },
        { "tipe": "formula_block", "latex": "x^2 + 3x - 10 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 4: Faktorkan persamaan kuadrat dan uji terhadap syarat numerus $x + 4 > 0$**" },
        { "tipe": "formula_block", "latex": "(x + 5)(x - 2) = 0 \\Rightarrow x = -5 \\quad \\text{atau} \\quad x = 2" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > -4$ (dan $5x + 26 > 0$), maka $x = -5$ tidak memenuhi dan nilai yang valid hanyalah $x = 2$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x$ dan $y$ memenuhi $3^x \\cdot 9^y = 243$ dan $2^x \\cdot 2^y = 32$. Nilai $x - y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "3^x \\cdot (3^2)^y = 3^5 \\Rightarrow 3^{x + 2y} = 3^5 \\Rightarrow x + 2y = 5" },
        { "tipe": "formula_block", "latex": "2^x \\cdot 2^y = 2^5 \\Rightarrow 2^{x + y} = 2^5 \\Rightarrow x + y = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $x$ untuk mendapatkan nilai $y$, lalu substitusikan untuk mencari $x$**" },
        { "tipe": "formula_block", "latex": "(x + 2y) - (x + y) = 5 - 5 \\Rightarrow y = 0" },
        { "tipe": "formula_block", "latex": "x + 0 = 5 \\Rightarrow x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung selisih $x - y$**" },
        { "tipe": "formula_block", "latex": "x - y = 5 - 0 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x - y$ adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 16 = {}^2\\log 16" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^2\\log 16$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 16 = {}^2\\log 2^4 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 16$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $9^{x} - 4 \\cdot 3^{x} + 3 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 0$ atau $x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah $9^x = (3^x)^2$ dan misalkan $y = 3^x$ untuk membentuk pertidaksamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 4y + 3 \\leq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 1)(y - 3) \\leq 0 \\Rightarrow 1 \\leq y \\leq 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke pemisalan awal $y = 3^x$ dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "1 \\leq 3^x \\leq 3 \\Rightarrow 3^0 \\leq 3^x \\leq 3^1 \\Rightarrow 0 \\leq x \\leq 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$0 \\leq x \\leq 1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 5^{x} + 5^{-x}$ dan $f(a) = 7$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$47$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ],
        [ { "tipe": "paragraph", "text": "$53$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 7$**" },
        { "tipe": "formula_block", "latex": "f(a) = 5^a + 5^{-a} = 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(5^a + 5^{-a})^2 = 7^2" },
        { "tipe": "formula_block", "latex": "(5^a)^2 + 2 \\cdot 5^a \\cdot 5^{-a} + (5^{-a})^2 = 49" },
        { "tipe": "formula_block", "latex": "5^{2a} + 2 \\cdot 5^{a - a} + 5^{-2a} = 49 \\Rightarrow 5^{2a} + 2 + 5^{-2a} = 49" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 5^{2a} + 5^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 5^{2a} + 5^{-2a} = 49 - 2 = 47" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$47$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Investasi Rp4.000.000,00 dengan bunga majemuk 5% per tahun. Waktu minimum agar investasi menjadi minimal Rp6.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 3 \\approx 1{,}585$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$8$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$9$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$10$ tahun" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "4.000.000(1 + 0{,}05)^t \\geq 6.000.000 \\Rightarrow (1{,}05)^t \\geq \\dfrac{6}{4} = \\dfrac{3}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}05}\\log\\left(\\dfrac{3}{2}\\right) = \\dfrac{{}^2\\log(3/2)}{{}^2\\log 1{,}05} = \\dfrac{{}^2\\log 3 - {}^2\\log 2}{{}^2\\log 1{,}05}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{1{,}585 - 1}{0{,}0704} = \\dfrac{0{,}585}{0{,}0704} \\approx 8{,}31" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $8{,}31$ tahun dibulatkan ke atas menjadi $9$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$9$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
