{
  "id": "bs-k10-eks-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x} + 2^{x+1} - 8 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan bentuk persamaan eksponen dengan mengubah $4^x = (2^x)^2$ dan $2^{x+1} = 2 \\cdot 2^x$**" },
        { "tipe": "formula_block", "latex": "(2^x)^2 + 2 \\cdot 2^x - 8 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 2^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 + 2y - 8 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat dan pilih nilai yang memenuhi $y = 2^x > 0$**" },
        { "tipe": "formula_block", "latex": "(y + 4)(y - 2) = 0 \\Rightarrow y = -4 \\quad \\text{atau} \\quad y = 2" },
        { "tipe": "paragraph", "text": "Karena $y = 2^x > 0$ untuk setiap $x \\in \\mathbb{R}$, maka $y = -4$ tidak memenuhi dan yang diambil adalah $y = 2$." },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 2^x$ untuk mencari nilai $x$**" },
        { "tipe": "formula_block", "latex": "2^x = 2 = 2^1 \\Rightarrow x = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = a$ dan ${}^2\\log 7 = b$, maka nilai ${}^{12}\\log 63$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + 2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2 + a + b}{a + 2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{12}\\log 63$ ke basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^{12}\\log 63 = \\dfrac{{}^2\\log 63}{{}^2\\log 12}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 63 = {}^2\\log(3^2 \\cdot 7) = 2 \\cdot {}^2\\log 3 + {}^2\\log 7 = 2a + b" },
        { "tipe": "formula_block", "latex": "{}^2\\log 12 = {}^2\\log(2^2 \\cdot 3) = 2 \\cdot {}^2\\log 2 + {}^2\\log 3 = 2 + a" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{12}\\log 63 = \\dfrac{2a + b}{a + 2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{12}\\log 63$ adalah **$\\dfrac{2a + b}{a + 2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^{1/2}\\log(x^2 - 2x - 11) \\leq -2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < -1$ atau $3 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $x \\geq 5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus logaritma (harus bernilai positif)**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 11 > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $\\dfrac{1}{2} < 1$ (tanda dibalik)**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 11 \\geq \\left(\\dfrac{1}{2}\\right)^{-2} = 2^2 = 4" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 15 \\geq 0 \\Rightarrow (x - 5)(x + 3) \\geq 0" },
        { "tipe": "formula_block", "latex": "x \\leq -3 \\quad \\text{atau} \\quad x \\geq 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Pastikan seluruh interval memenuhi syarat numerus $x^2 - 2x - 11 > 0$**" },
        { "tipe": "paragraph", "text": "Karena $x^2 - 2x - 11 \\geq 4$, maka syarat $x^2 - 2x - 11 > 0$ otomatis terpenuhi di seluruh selang tersebut." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x \\leq -3$ atau $x \\geq 5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah zat radioaktif memiliki waktu paruh 12 tahun. Jika massa awal 320 gram, massa setelah 36 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$80$ gram" } ],
        [ { "tipe": "paragraph", "text": "$40$ gram" } ],
        [ { "tipe": "paragraph", "text": "$20$ gram" } ],
        [ { "tipe": "paragraph", "text": "$10$ gram" } ],
        [ { "tipe": "paragraph", "text": "$5$ gram" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan data ke rumus peluruhan radioaktif**" },
        { "tipe": "paragraph", "text": "Gunakan rumus $M(t) = M_0 \\left(\\dfrac{1}{2}\\right)^{t/T}$ dengan $M_0 = 320$, $T = 12$, dan $t = 36$:" },
        { "tipe": "formula_block", "latex": "M(36) = 320 \\left(\\dfrac{1}{2}\\right)^{36/12}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan pangkat dan hitung massa akhir**" },
        { "tipe": "formula_block", "latex": "M(36) = 320 \\left(\\dfrac{1}{2}\\right)^3 = 320 \\cdot \\dfrac{1}{8} = 40" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, massa zat radioaktif setelah 36 tahun adalah **$40$ gram**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-2) + {}^2\\log(x+2) = {}^2\\log 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus untuk setiap logaritma**" },
        { "tipe": "formula_block", "latex": "x - 2 > 0 \\Rightarrow x > 2" },
        { "tipe": "formula_block", "latex": "x + 2 > 0 \\Rightarrow x > -2" },
        { "tipe": "paragraph", "text": "Irisan dari kedua syarat numerus tersebut adalah $x > 2$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan ruas kiri menggunakan sifat penjumlahan logaritma**" },
        { "tipe": "formula_block", "latex": "{}^2\\log[(x - 2)(x + 2)] = {}^2\\log 12" },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan numerus kedua ruas dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "(x - 2)(x + 2) = 12 \\Rightarrow x^2 - 4 = 12" },
        { "tipe": "formula_block", "latex": "x^2 = 16 \\Rightarrow x = -4 \\quad \\text{atau} \\quad x = 4" },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji nilai $x$ terhadap syarat numerus $x > 2$**" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > 2$, maka $x = -4$ tidak memenuhi dan nilai yang valid hanyalah $x = 4$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 8^b = 128$ dan $5^a \\cdot 5^b = 3125$. Nilai $a \\cdot b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "2^a \\cdot (2^3)^b = 2^7 \\Rightarrow 2^{a + 3b} = 2^7 \\Rightarrow a + 3b = 7" },
        { "tipe": "formula_block", "latex": "5^a \\cdot 5^b = 5^5 \\Rightarrow 5^{a + b} = 5^5 \\Rightarrow a + b = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $a$ untuk mendapatkan nilai $b$, lalu substitusikan untuk mencari $a$**" },
        { "tipe": "formula_block", "latex": "(a + 3b) - (a + b) = 7 - 5 \\Rightarrow 2b = 2 \\Rightarrow b = 1" },
        { "tipe": "formula_block", "latex": "a + 1 = 5 \\Rightarrow a = 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil kali $a \\cdot b$**" },
        { "tipe": "formula_block", "latex": "a \\cdot b = 4 \\cdot 1 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a \\cdot b$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 6 \\cdot {}^6\\log 8 \\cdot {}^8\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 6 \\cdot {}^6\\log 8 \\cdot {}^8\\log 32 = {}^2\\log 32" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^2\\log 32$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 32 = {}^2\\log 2^5 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^2\\log 6 \\cdot {}^6\\log 8 \\cdot {}^8\\log 32$ adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 5x + 6) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah persamaan logaritma ke dalam bentuk eksponen**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x^2 - 5x + 6) = 1 \\Rightarrow x^2 - 5x + 6 = 2^1 = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun persamaan kuadrat ke bentuk standar dan faktorkan**" },
        { "tipe": "formula_block", "latex": "x^2 - 5x + 4 = 0 \\Rightarrow (x - 1)(x - 4) = 0" },
        { "tipe": "formula_block", "latex": "x = 1 \\quad \\text{atau} \\quad x = 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji kedua nilai $x$ terhadap syarat numerus ($x^2 - 5x + 6 > 0$)**" },
        { "tipe": "paragraph", "text": "Untuk $x = 1$, diperoleh $1^2 - 5(1) + 6 = 2 > 0$, dan untuk $x = 4$, diperoleh $4^2 - 5(4) + 6 = 2 > 0$, sehingga keduanya memenuhi." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 1$ atau $x = 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2^{2x} + 2^{-2x}$ dan $f(a) = 7$, maka nilai $2^{a} + 2^{-a}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 7$**" },
        { "tipe": "formula_block", "latex": "f(a) = 2^{2a} + 2^{-2a} = (2^a)^2 + (2^{-a})^2 = 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $u = 2^a + 2^{-a}$ lalu kuadratkan kedua ruasnya**" },
        { "tipe": "formula_block", "latex": "u^2 = (2^a + 2^{-a})^2 = (2^a)^2 + 2 \\cdot 2^a \\cdot 2^{-a} + (2^{-a})^2" },
        { "tipe": "formula_block", "latex": "u^2 = (2^a)^2 + (2^{-a})^2 + 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan $(2^a)^2 + (2^{-a})^2 = 7$ dan tentukan nilai $u > 0$**" },
        { "tipe": "formula_block", "latex": "u^2 = 7 + 2 = 9 \\Rightarrow u = 3" },
        { "tipe": "paragraph", "text": "Karena $2^a > 0$ dan $2^{-a} > 0$, maka nilai $u = 2^a + 2^{-a}$ selalu positif sehingga diambil $u = 3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $2^{a} + 2^{-a}$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp3.000.000,00 diinvestasikan dengan bunga majemuk 6% per tahun. Waktu minimum agar modal menjadi minimal Rp4.000.000,00 adalah... (gunakan ${}^2\\log 1{,}06 \\approx 0{,}084$ dan ${}^2\\log\\dfrac{4}{3} \\approx 0{,}415$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$8$ tahun" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "3.000.000(1 + 0{,}06)^t \\geq 4.000.000 \\Rightarrow (1{,}06)^t \\geq \\dfrac{4}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}06}\\log\\left(\\dfrac{4}{3}\\right) = \\dfrac{{}^2\\log\\left(\\dfrac{4}{3}\\right)}{{}^2\\log 1{,}06}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{0{,}415}{0{,}084} \\approx 4{,}94" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $4{,}94$ tahun dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$5$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
