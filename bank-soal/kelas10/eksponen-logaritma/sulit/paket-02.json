{
  "id": "bs-k10-eks-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang aplikasi eksponen, logaritma, dan kombinasi konsep lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi suatu kota tumbuh menurut $P(t) = 50.000 \\cdot (1{,}02)^t$ dengan $t$ dalam tahun. Populasi kota akan mencapai 100.000 jiwa pada tahun ke-... (gunakan ${}^2\\log 1{,}02 \\approx 0{,}0286$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan nilai $P(t) = 100.000$ ke dalam persamaan**" },
        { "tipe": "formula_block", "latex": "50.000(1{,}02)^t = 100.000" },
        { "tipe": "paragraph", "text": "**Langkah 2: Bagi kedua ruas dengan $50.000$ untuk menyederhanakan persamaan**" },
        { "tipe": "formula_block", "latex": "(1{,}02)^t = \\dfrac{100.000}{50.000} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ubah ke bentuk logaritma dan gunakan sifat perubahan basis ke basis $2$**" },
        { "tipe": "formula_block", "latex": "t = {}^{1{,}02}\\log 2 = \\dfrac{{}^2\\log 2}{{}^2\\log 1{,}02} = \\dfrac{1}{0{,}0286} \\approx 34{,}965 \\approx 35" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, populasi kota akan mencapai 100.000 jiwa pada tahun ke-**$35$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x} + 2^{3-x} = 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan $2^{3-x}$ menggunakan sifat eksponen $a^{m-n} = \\dfrac{a^m}{a^n}$**" },
        { "tipe": "formula_block", "latex": "2^x + \\dfrac{2^3}{2^x} = 9 \\Rightarrow 2^x + \\dfrac{8}{2^x} = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 2^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y + \\dfrac{8}{y} = 9 \\Rightarrow y^2 - 9y + 8 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 8)(y - 1) = 0 \\Rightarrow y = 8 \\quad \\text{atau} \\quad y = 1" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 2^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 8 \\Rightarrow 2^x = 8 = 2^3 \\Rightarrow x = 3" },
        { "tipe": "formula_block", "latex": "y = 1 \\Rightarrow 2^x = 1 = 2^0 \\Rightarrow x = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 0$ atau $x = 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = m$, maka ${}^2\\log 48$ dapat dinyatakan sebagai..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4 + m$" } ],
        [ { "tipe": "paragraph", "text": "$4 - m$" } ],
        [ { "tipe": "paragraph", "text": "$2m + 4$" } ],
        [ { "tipe": "paragraph", "text": "$4m$" } ],
        [ { "tipe": "paragraph", "text": "$m + 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan $48$ ke dalam perkalian bilangan $3$ dan perpangkatan basis $2$**" },
        { "tipe": "paragraph", "text": "Karena $48 = 16 \\cdot 3 = 2^4 \\cdot 3$, maka:" },
        { "tipe": "formula_block", "latex": "{}^2\\log 48 = {}^2\\log(2^4 \\cdot 3)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan sifat penjumlahan logaritma ${}^a\\log(p \\cdot q) = {}^a\\log p + {}^a\\log q$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(2^4 \\cdot 3) = {}^2\\log 2^4 + {}^2\\log 3 = 4 + m" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bentuk ${}^2\\log 48$ dalam $m$ adalah **$4 + m$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^3\\log(x^2 - 2x) \\geq 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 0$ atau $x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x < 0$ atau $2 < x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus logaritma (harus bernilai positif)**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x > 0 \\Rightarrow x(x - 2) > 0 \\Rightarrow x < 0 \\quad \\text{atau} \\quad x > 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $3 > 1$**" },
        { "tipe": "formula_block", "latex": "{}^3\\log(x^2 - 2x) \\geq {}^3\\log 3^1 \\Rightarrow x^2 - 2x \\geq 3" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 3 \\geq 0 \\Rightarrow (x - 3)(x + 1) \\geq 0" },
        { "tipe": "paragraph", "text": "Dengan pembuat nol $x = -1$ dan $x = 3$, uji tanda menghasilkan:" },
        { "tipe": "formula_block", "latex": "x \\leq -1 \\quad \\text{atau} \\quad x \\geq 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan syarat numerus dengan hasil penyelesaian**" },
        { "tipe": "paragraph", "text": "Irisan dari ($x < 0$ atau $x > 2$) dan ($x \\leq -1$ atau $x \\geq 3$) adalah:" },
        { "tipe": "formula_block", "latex": "x \\leq -1 \\quad \\text{atau} \\quad x \\geq 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x \\leq -1$ atau $x \\geq 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah investasi memberikan bunga majemuk 6% per tahun. Waktu minimum (dalam tahun) agar investasi menjadi minimal 2 kali lipat adalah... (gunakan ${}^2\\log 1{,}06 \\approx 0{,}084$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "M_0(1 + 0{,}06)^t \\geq 2M_0 \\Rightarrow (1{,}06)^t \\geq 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen menjadi bentuk logaritma**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}06}\\log 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Gunakan sifat perubahan basis ke basis $2$ dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{{}^2\\log 2}{{}^2\\log 1{,}06} = \\dfrac{1}{0{,}084} \\approx 11{,}9" },
        { "tipe": "paragraph", "text": "Karena diminta waktu minimum dalam tahun penuh agar nilai investasi mencapai minimal 2 kali lipat, maka $11{,}9$ tahun dibulatkan ke atas menjadi $12$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang diperlukan adalah **$12$** tahun." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+2) + {}^2\\log(x-1) = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus untuk setiap logaritma**" },
        { "tipe": "formula_block", "latex": "x + 2 > 0 \\Rightarrow x > -2" },
        { "tipe": "formula_block", "latex": "x - 1 > 0 \\Rightarrow x > 1" },
        { "tipe": "paragraph", "text": "Irisan dari kedua syarat numerus tersebut adalah $x > 1$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan ruas kiri menggunakan sifat penjumlahan logaritma**" },
        { "tipe": "formula_block", "latex": "{}^2\\log[(x + 2)(x - 1)] = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ubah ke bentuk eksponen dan bentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "(x + 2)(x - 1) = 2^2 = 4" },
        { "tipe": "formula_block", "latex": "x^2 + x - 2 = 4 \\Rightarrow x^2 + x - 6 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 4: Faktorkan persamaan kuadrat dan uji terhadap syarat $x > 1$**" },
        { "tipe": "formula_block", "latex": "(x + 3)(x - 2) = 0 \\Rightarrow x = -3 \\quad \\text{atau} \\quad x = 2" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > 1$, maka $x = -3$ tidak memenuhi dan nilai yang valid hanyalah $x = 2$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui ${}^a\\log b = 2$ dan ${}^b\\log c = 3$. Nilai ${}^a\\log c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$**" },
        { "tipe": "formula_block", "latex": "{}^a\\log c = {}^a\\log b \\cdot {}^b\\log c" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui ke dalam persamaan**" },
        { "tipe": "formula_block", "latex": "{}^a\\log c = 2 \\cdot 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^a\\log c$ adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah penduduk suatu daerah mengikuti model $P = P_0 e^{kt}$. Jika penduduk bertambah dari 1.000 menjadi 4.000 dalam 10 tahun, maka nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 2}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 4}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 8}{10}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $P_0 = 1.000$, $P = 4.000$, dan $t = 10$ ke dalam model**" },
        { "tipe": "formula_block", "latex": "4.000 = 1.000 \\cdot e^{10k}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Bagi kedua ruas dengan $1.000$**" },
        { "tipe": "formula_block", "latex": "e^{10k} = \\dfrac{4.000}{1.000} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ambil logaritma natural ($\\ln$) pada kedua ruas**" },
        { "tipe": "formula_block", "latex": "10k = \\ln 4 = \\ln(2^2) = 2\\ln 2" },
        { "tipe": "paragraph", "text": "**Langkah 4: Selesaikan persamaan untuk memperoleh nilai $k$**" },
        { "tipe": "formula_block", "latex": "k = \\dfrac{2\\ln 2}{10} = \\dfrac{\\ln 2}{5}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $k$ adalah **$\\dfrac{\\ln 2}{5}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\left({}^2\\log x\\right)^2 - {}^2\\log x - 6 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{4}$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{2}$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{4}$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{8}$ atau $x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $p = {}^2\\log x$ untuk membentuk persamaan kuadrat (dengan syarat $x > 0$)**" },
        { "tipe": "formula_block", "latex": "p^2 - p - 6 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(p - 3)(p + 2) = 0 \\Rightarrow p = 3 \\quad \\text{atau} \\quad p = -2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke pemisalan awal $p = {}^2\\log x$ untuk mencari nilai $x$**" },
        { "tipe": "formula_block", "latex": "p = 3 \\Rightarrow {}^2\\log x = 3 \\Rightarrow x = 2^3 = 8" },
        { "tipe": "formula_block", "latex": "p = -2 \\Rightarrow {}^2\\log x = -2 \\Rightarrow x = 2^{-2} = \\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = \\dfrac{1}{4}$ atau $x = 8$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2^{x} + 2^{-x}$ dan $f(a) = 5$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 5$**" },
        { "tipe": "formula_block", "latex": "f(a) = 2^a + 2^{-a} = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(2^a + 2^{-a})^2 = 5^2" },
        { "tipe": "formula_block", "latex": "(2^a)^2 + 2 \\cdot 2^a \\cdot 2^{-a} + (2^{-a})^2 = 25" },
        { "tipe": "formula_block", "latex": "2^{2a} + 2 \\cdot 2^{a - a} + 2^{-2a} = 25 \\Rightarrow 2^{2a} + 2 + 2^{-2a} = 25" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 2^{2a} + 2^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 2^{2a} + 2^{-2a} = 25 - 2 = 23" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$23$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
