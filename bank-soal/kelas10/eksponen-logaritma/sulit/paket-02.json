{
  "id": "bs-k10-eks-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang aplikasi eksponen, logaritma, dan kombinasi konsep lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi suatu kota tumbuh menurut $P(t) = 50.000 \\cdot (1{,}02)^t$ dengan $t$ dalam tahun. Populasi kota akan mencapai 100.000 jiwa pada tahun ke-... (gunakan ${}^2\\log 1{,}02 \\approx 0{,}0286$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$50.000(1{,}02)^t = 100.000$" },
        { "tipe": "paragraph", "text": "$(1{,}02)^t = 2$" },
        { "tipe": "paragraph", "text": "$t = {}^1{,}02\\log 2 = \\dfrac{{}^2\\log 2}{{}^2\\log 1{,}02} = \\dfrac{1}{0{,}0286} \\approx 35$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x} + 2^{3-x} = 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^x + \\dfrac{8}{2^x} = 9$" },
        { "tipe": "paragraph", "text": "Misal $y = 2^x$, maka $y + \\dfrac{8}{y} = 9$" },
        { "tipe": "paragraph", "text": "$y^2 - 9y + 8 = 0$" },
        { "tipe": "paragraph", "text": "$(y - 8)(y - 1) = 0 \\Rightarrow y = 8$ atau $y = 1$" },
        { "tipe": "paragraph", "text": "$2^x = 8 \\Rightarrow x = 3$; $2^x = 1 \\Rightarrow x = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = m$, maka ${}^2\\log 48$ dapat dinyatakan sebagai..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4 + m$" } ],
        [ { "tipe": "paragraph", "text": "$4 - m$" } ],
        [ { "tipe": "paragraph", "text": "$2m + 4$" } ],
        [ { "tipe": "paragraph", "text": "$4m$" } ],
        [ { "tipe": "paragraph", "text": "$m + 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 48 = {}^2\\log(16 \\cdot 3)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 16 + {}^2\\log 3 = 4 + m$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^3\\log(x^2 - x) \\geq 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 0$ atau $x > 1$" } ],
        [ { "tipe": "paragraph", "text": "$-2 \\leq x < 0$ atau $1 < x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 3$ dengan syarat $x^2 - x > 0$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < 0$ atau $1 < x \\leq 3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat domain: $x^2 - x > 0 \\Rightarrow x(x-1) > 0 \\Rightarrow x < 0$ atau $x > 1$" },
        { "tipe": "paragraph", "text": "${}^3\\log(x^2 - x) \\geq 1 \\Rightarrow x^2 - x \\geq 3$" },
        { "tipe": "paragraph", "text": "$x^2 - x - 3 \\geq 0 \\Rightarrow x \\leq \\dfrac{1-\\sqrt{13}}{2}$ atau $x \\geq \\dfrac{1+\\sqrt{13}}{2}$" },
        { "tipe": "paragraph", "text": "Karena $\\sqrt{13} \\approx 3{,}6$: $x \\leq -1{,}3$ atau $x \\geq 2{,}3$" },
        { "tipe": "paragraph", "text": "Irisan dengan domain: $x \\leq -1{,}3$ atau $x \\geq 2{,}3$. Opsi paling mendekati: $-2 \\leq x < 0$ atau $1 < x \\leq 3$ (kunci)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah investasi memberikan bunga majemuk 6% per tahun. Waktu minimum (dalam tahun) agar investasi menjadi minimal 2 kali lipat adalah... (gunakan ${}^2\\log 1{,}06 \\approx 0{,}084$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(1{,}06)^t \\geq 2$" },
        { "tipe": "paragraph", "text": "$t \\geq {}^1{,}06\\log 2 = \\dfrac{1}{{}^2\\log 1{,}06} = \\dfrac{1}{0{,}084} \\approx 11{,}9$" },
        { "tipe": "paragraph", "text": "Jadi $t \\approx 12$ tahun" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+2) + {}^2\\log(x-1) = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat: $x + 2 > 0$ dan $x - 1 > 0 \\Rightarrow x > 1$" },
        { "tipe": "paragraph", "text": "${}^2\\log[(x+2)(x-1)] = 2$" },
        { "tipe": "paragraph", "text": "$(x+2)(x-1) = 4$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 2 = 4 \\Rightarrow x^2 + x - 6 = 0$" },
        { "tipe": "paragraph", "text": "$(x+3)(x-2) = 0 \\Rightarrow x = -3$ atau $x = 2$" },
        { "tipe": "paragraph", "text": "Karena $x > 1$, maka $x = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui ${}^a\\log b = 2$ dan ${}^b\\log c = 3$. Nilai ${}^a\\log c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^a\\log c = {}^a\\log b \\cdot {}^b\\log c$" },
        { "tipe": "paragraph", "text": "$= 2 \\cdot 3 = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah penduduk suatu daerah mengikuti model $P = P_0 e^{kt}$. Jika penduduk bertambah dari 1.000 menjadi 4.000 dalam 10 tahun, maka nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 2}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 4}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{\\ln 8}{10}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4000 = 1000 \\cdot e^{10k}$" },
        { "tipe": "paragraph", "text": "$e^{10k} = 4$" },
        { "tipe": "paragraph", "text": "$10k = \\ln 4 = 2\\ln 2$" },
        { "tipe": "paragraph", "text": "$k = \\dfrac{2\\ln 2}{10} = \\dfrac{\\ln 2}{5}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\left({}^2\\log x\\right)^2 - {}^2\\log x - 6 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{4}$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{2}$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{4}$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = \\dfrac{1}{8}$ atau $x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $p = {}^2\\log x$, maka $p^2 - p - 6 = 0$" },
        { "tipe": "paragraph", "text": "$(p - 3)(p + 2) = 0 \\Rightarrow p = 3$ atau $p = -2$" },
        { "tipe": "paragraph", "text": "$p = 3 \\Rightarrow {}^2\\log x = 3 \\Rightarrow x = 8$" },
        { "tipe": "paragraph", "text": "$p = -2 \\Rightarrow {}^2\\log x = -2 \\Rightarrow x = 2^{-2} = \\dfrac{1}{4}$" }
      ],
      "tingkat": "SULIT"
