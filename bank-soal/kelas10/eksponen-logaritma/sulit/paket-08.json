{
  "id": "bs-k10-eks-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x} - 10 \\cdot 3^{x} + 9 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk persamaan eksponen dengan menjabarkan $9^x = (3^x)^2$**" },
        { "tipe": "formula_block", "latex": "(3^x)^2 - 10 \\cdot 3^x + 9 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 3^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 10y + 9 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 9)(y - 1) = 0 \\Rightarrow y = 9 \\quad \\text{atau} \\quad y = 1" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 3^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 9 \\Rightarrow 3^x = 9 = 3^2 \\Rightarrow x = 2" },
        { "tipe": "formula_block", "latex": "y = 1 \\Rightarrow 3^x = 1 = 3^0 \\Rightarrow x = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 0$ atau $x = 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 5 = a$ dan ${}^2\\log 3 = b$, maka nilai ${}^{15}\\log 45$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2b + a}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2b + a}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 2b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{15}\\log 45$ ke basis $2$**" },
        { "tipe": "formula_block", "latex": "{}^{15}\\log 45 = \\dfrac{{}^2\\log 45}{{}^2\\log 15}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 45 = {}^2\\log(3^2 \\cdot 5) = 2 \\cdot {}^2\\log 3 + {}^2\\log 5 = 2b + a" },
        { "tipe": "formula_block", "latex": "{}^2\\log 15 = {}^2\\log(3 \\cdot 5) = {}^2\\log 3 + {}^2\\log 5 = b + a = a + b" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{15}\\log 45 = \\dfrac{2b + a}{a + b}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{15}\\log 45$ adalah **$\\dfrac{2b + a}{a + b}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 4x - 5) < 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -1$ atau $5 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus logaritma (harus bernilai positif)**" },
        { "tipe": "formula_block", "latex": "x^2 - 4x - 5 > 0 \\Rightarrow (x - 5)(x + 1) > 0 \\Rightarrow x < -1 \\quad \\text{atau} \\quad x > 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan pertidaksamaan logaritma dengan basis $2 > 1$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log(x^2 - 4x - 5) < {}^2\\log 2^4 \\Rightarrow x^2 - 4x - 5 < 16" },
        { "tipe": "formula_block", "latex": "x^2 - 4x - 21 < 0 \\Rightarrow (x - 7)(x + 3) < 0 \\Rightarrow -3 < x < 7" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan syarat numerus dengan hasil penyelesaian**" },
        { "tipe": "paragraph", "text": "Irisan dari ($x < -1$ atau $x > 5$) dan ($-3 < x < 7$) adalah:" },
        { "tipe": "formula_block", "latex": "-3 < x < -1 \\quad \\text{atau} \\quad 5 < x < 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-3 < x < -1$ atau $5 < x < 7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bakteri membelah menjadi dua setiap 30 menit. Jika mula-mula ada 100 bakteri, maka setelah 4 jam jumlah bakteri menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.600$" } ],
        [ { "tipe": "paragraph", "text": "$3.200$" } ],
        [ { "tipe": "paragraph", "text": "$6.400$" } ],
        [ { "tipe": "paragraph", "text": "$12.800$" } ],
        [ { "tipe": "paragraph", "text": "$25.600$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan banyak periode pembelahan dalam $4$ jam ($240$ menit)**" },
        { "tipe": "formula_block", "latex": "n = \\dfrac{240\\text{ menit}}{30\\text{ menit}} = 8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah bakteri akhir menggunakan rumus $N = N_0 \\cdot 2^n$**" },
        { "tipe": "formula_block", "latex": "N = 100 \\times 2^8 = 100 \\times 256 = 25.600" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah bakteri setelah 4 jam adalah **$25.600$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+1) + {}^2\\log(x-1) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus untuk setiap logaritma**" },
        { "tipe": "formula_block", "latex": "x + 1 > 0 \\Rightarrow x > -1" },
        { "tipe": "formula_block", "latex": "x - 1 > 0 \\Rightarrow x > 1" },
        { "tipe": "paragraph", "text": "Irisan dari kedua syarat numerus tersebut adalah $x > 1$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan ruas kiri menggunakan sifat penjumlahan logaritma**" },
        { "tipe": "formula_block", "latex": "{}^2\\log[(x + 1)(x - 1)] = 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Ubah ke bentuk eksponen dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "(x + 1)(x - 1) = 2^3 \\Rightarrow x^2 - 1 = 8" },
        { "tipe": "formula_block", "latex": "x^2 = 9 \\Rightarrow x = -3 \\quad \\text{atau} \\quad x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji nilai $x$ terhadap syarat numerus $x > 1$**" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > 1$, maka $x = -3$ tidak memenuhi dan nilai yang valid hanyalah $x = 3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 4^b = 64$ dan $3^{a+b} = 81$. Nilai $a - b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "2^a \\cdot (2^2)^b = 2^6 \\Rightarrow 2^{a + 2b} = 2^6 \\Rightarrow a + 2b = 6" },
        { "tipe": "formula_block", "latex": "3^{a + b} = 3^4 \\Rightarrow a + b = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $a$ untuk mendapatkan nilai $b$, lalu substitusikan untuk mencari $a$**" },
        { "tipe": "formula_block", "latex": "(a + 2b) - (a + b) = 6 - 4 \\Rightarrow b = 2" },
        { "tipe": "formula_block", "latex": "a + 2 = 4 \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung selisih $a - b$**" },
        { "tipe": "formula_block", "latex": "a - b = 2 - 2 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a - b$ adalah **$0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 16 = {}^2\\log 16" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^2\\log 16$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 16 = {}^2\\log 2^4 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 16$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $\\left(\\dfrac{1}{2}\\right)^{x^2 - 2x} \\leq \\dfrac{1}{8}$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah ruas kanan pertidaksamaan ke basis $\\dfrac{1}{2}$**" },
        { "tipe": "formula_block", "latex": "\\left(\\dfrac{1}{2}\\right)^{x^2 - 2x} \\leq \\left(\\dfrac{1}{2}\\right)^3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Balik tanda pertidaksamaan karena basis $\\dfrac{1}{2} < 1$**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x \\geq 3 \\Rightarrow x^2 - 2x - 3 \\geq 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan pertidaksamaan kuadrat untuk memperoleh himpunan penyelesaian**" },
        { "tipe": "formula_block", "latex": "(x - 3)(x + 1) \\geq 0 \\Rightarrow x \\leq -1 \\quad \\text{atau} \\quad x \\geq 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x \\leq -1$ atau $x \\geq 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 7^{x} + 7^{-x}$ dan $f(a) = 5$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 5$**" },
        { "tipe": "formula_block", "latex": "f(a) = 7^a + 7^{-a} = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(7^a + 7^{-a})^2 = 5^2" },
        { "tipe": "formula_block", "latex": "(7^a)^2 + 2 \\cdot 7^a \\cdot 7^{-a} + (7^{-a})^2 = 25" },
        { "tipe": "formula_block", "latex": "7^{2a} + 2 \\cdot 7^{a - a} + 7^{-2a} = 25 \\Rightarrow 7^{2a} + 2 + 7^{-2a} = 25" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 7^{2a} + 7^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 7^{2a} + 7^{-2a} = 25 - 2 = 23" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$23$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp8.000.000,00 dibungakan majemuk 5% per tahun. Waktu minimum agar modal menjadi minimal Rp10.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 1{,}25 \\approx 0{,}322$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "8.000.000(1 + 0{,}05)^t \\geq 10.000.000 \\Rightarrow (1{,}05)^t \\geq \\dfrac{10.000.000}{8.000.000} = 1{,}25" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}05}\\log 1{,}25 = \\dfrac{{}^2\\log 1{,}25}{{}^2\\log 1{,}05}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{0{,}322}{0{,}0704} \\approx 4{,}57" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $4{,}57$ tahun dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$5$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
