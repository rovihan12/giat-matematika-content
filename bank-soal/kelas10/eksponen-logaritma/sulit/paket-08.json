{
  "id": "bs-k10-eks-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x} - 10 \\cdot 3^{x} + 9 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan eksponen dengan menjabarkan suku $9^x = (3^x)^2$." },
        { "tipe": "paragraph", "text": "$(3^x)^2 - 10 \\cdot 3^x + 9 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Lakukan pemisalan $y = 3^x$ untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$y^2 - 10y + 9 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(y - 9)(y - 1) = 0 \\Rightarrow y = 9 \\text{ atau } y = 1$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kembalikan ke pemisalan awal untuk menentukan nilai $x$." },
        { "tipe": "paragraph", "text": "Untuk $y = 9 \\Rightarrow 3^x = 9 = 3^2 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "Untuk $y = 1 \\Rightarrow 3^x = 1 = 3^0 \\Rightarrow x = 0$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 0$ atau $x = 2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 5 = a$ dan ${}^2\\log 3 = b$, maka nilai ${}^{15}\\log 45$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2b + a}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2b + a}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 2b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk ${}^{15}\\log 45$ menggunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "${}^{15}\\log 45 = \\dfrac{{}^2\\log 45}{{}^2\\log 15}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Uraikan numerus $45$ dan $15$ ke dalam faktor primanya yang memuat $5$ dan $3$ ($45 = 9 \\cdot 5 = 3^2 \\cdot 5$ dan $15 = 3 \\cdot 5$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log(3^2 \\cdot 5) = 2 \\cdot {}^2\\log 3 + {}^2\\log 5 = 2b + a$" },
        { "tipe": "paragraph", "text": "${}^2\\log 15 = {}^2\\log(3 \\cdot 5) = {}^2\\log 3 + {}^2\\log 5 = b + a = a + b$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai tersebut ke bentuk pecahan." },
        { "tipe": "paragraph", "text": "${}^{15}\\log 45 = \\dfrac{2b + a}{a + b}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{2b + a}{a + b}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 4x - 5) < 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -1$ atau $5 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain (numerus harus bernilai positif)." },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 5 > 0 \\Rightarrow (x - 5)(x + 1) > 0 \\Rightarrow x < -1 \\text{ atau } x > 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Selesaikan pertidaksamaan logaritma dengan mengubah konstanta $4$ menjadi ${}^2\\log 2^4 = {}^2\\log 16$." },
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 4x - 5) < {}^2\\log 16 \\Rightarrow x^2 - 4x - 5 < 16$" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 21 < 0 \\Rightarrow (x - 7)(x + 3) < 0 \\Rightarrow -3 < x < 7$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Iriskan hasil penyelesaian dengan syarat domain ($x < -1 \\text{ atau } x > 5$). Irisan yang diperoleh adalah $-3 < x < -1$ atau $5 < x < 7$." },
        { "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $-3 < x < -1$ atau $5 < x < 7$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bakteri membelah menjadi dua setiap 30 menit. Jika mula-mula ada 100 bakteri, maka setelah 4 jam jumlah bakteri menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.600$" } ],
        [ { "tipe": "paragraph", "text": "$3.200$" } ],
        [ { "tipe": "paragraph", "text": "$6.400$" } ],
        [ { "tipe": "paragraph", "text": "$12.800$" } ],
        [ { "tipe": "paragraph", "text": "$25.600$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan jumlah periode pembelahan. Waktu 4 jam sama dengan $4 \\times 60 = 240$ menit, sehingga banyak periode $n = \\dfrac{240 \\text{ menit}}{30 \\text{ menit}} = 8$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung jumlah akhir menggunakan rumus pertumbuhan eksponensial $N = N_0 \\cdot 2^n$." },
        { "tipe": "paragraph", "text": "$N = 100 \\times 2^8 = 100 \\times 256 = 25.600$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah bakteri setelah 4 jam adalah $25.600$ (pilihan kelima)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+1) + {}^2\\log(x-1) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat domain ($x + 1 > 0 \\Rightarrow x > -1$ dan $x - 1 > 0 \\Rightarrow x > 1$). Irisan syarat domain adalah $x > 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan persamaan logaritma menggunakan sifat penjumlahan logaritma." },
        { "tipe": "paragraph", "text": "${}^2\\log[(x+1)(x-1)] = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Ubah bentuk logaritma ke bentuk eksponen." },
        { "tipe": "paragraph", "text": "$(x + 1)(x - 1) = 2^3 \\Rightarrow x^2 - 1 = 8$" },
        { "tipe": "paragraph", "text": "$x^2 = 9 \\Rightarrow x = -3 \\text{ atau } x = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Uji nilai $x$ terhadap syarat domain $x > 1$. Nilai $x = -3$ tidak memenuhi, sehingga yang memenuhi adalah $x = 3$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x = 3$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 4^b = 64$ dan $3^{a+b} = 81$. Nilai $a - b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah setiap persamaan ke dalam bentuk basis bilangan prima yang sama ($4 = 2^2$, $64 = 2^6$, dan $81 = 3^4$)." },
        { "tipe": "paragraph", "text": "$2^a \\cdot (2^2)^b = 2^6 \\Rightarrow 2^a \\cdot 2^{2b} = 2^6 \\Rightarrow a + 2b = 6$ (Persamaan 1)" },
        { "tipe": "paragraph", "text": "$3^{a+b} = 3^4 \\Rightarrow a + b = 4$ (Persamaan 2)" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Eliminasi variabel $a$ dengan mengurangkan Persamaan 1 dan Persamaan 2." },
        { "tipe": "paragraph", "text": "$(a + 2b) - (a + b) = 6 - 4 \\Rightarrow b = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai $b = 2$ ke Persamaan 2 untuk mencari nilai $a$." },
        { "tipe": "paragraph", "text": "$a + 2 = 4 \\Rightarrow a = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Hitung nilai $a - b$." },
        { "tipe": "paragraph", "text": "$a - b = 2 - 2 = 0$" },
        { "tipe": "paragraph", "text": "Jadi, nilai $a - b$ adalah $0$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$." },
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 16 = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan bentuk ${}^2\\log 16$." },
        { "tipe": "paragraph", "text": "${}^2\\log 2^4 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $\\left(\\dfrac{1}{2}\\right)^{x^2 - 2x} \\leq \\dfrac{1}{8}$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah ruas kanan pertidaksamaan ke dalam basis eksponen yang sama, yaitu $\\dfrac{1}{2}$ ($\\dfrac{1}{8} = \\left(\\dfrac{1}{2}\\right)^3$)." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^{x^2 - 2x} \\leq \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena basis eksponen bernilai antara $0$ dan $1$ ($\\dfrac{1}{2} < 1$), tanda pertidaksamaan harus dibalik saat menyamakan pangkatnya." },
        { "tipe": "paragraph", "text": "$x^2 - 2x \\geq 3 \\Rightarrow x^2 - 2x - 3 \\geq 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan bentuk kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 3)(x + 1) \\geq 0$" },
        { "tipe": "paragraph", "text": "Pembuat nol: $x = 3$ atau $x = -1$. Daerah penyelesaian pertidaksamaan adalah $x \\leq -1$ atau $x \\geq 3$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ yang memenuhi adalah $x \\leq -1$ atau $x \\geq 3$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 7^{x} + 7^{-x}$ dan $f(a) = 5$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tuliskan persamaan dari $f(a) = 5$." },
        { "tipe": "paragraph", "text": "$f(a) = 7^a + 7^{-a} = 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kuadratkan kedua ruas persamaan tersebut." },
        { "tipe": "paragraph", "text": "$(7^a + 7^{-a})^2 = 5^2$" },
        { "tipe": "paragraph", "text": "$(7^a)^2 + 2 \\cdot 7^a \\cdot 7^{-a} + (7^{-a})^2 = 25$" },
        { "tipe": "paragraph", "text": "$7^{2a} + 2 \\cdot 7^{a-a} + 7^{-2a} = 25 \\Rightarrow 7^{2a} + 2 + 7^{-2a} = 25$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan untuk mendapatkan nilai $7^{2a} + 7^{-2a}$." },
        { "tipe": "paragraph", "text": "$7^{2a} + 7^{-2a} = 25 - 2 = 23$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Perhatikan bahwa $f(2a) = 7^{2a} + 7^{-2a} = 23$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $f(2a)$ adalah $23$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp8.000.000,00 dibungakan majemuk 5% per tahun. Waktu minimum agar modal menjadi minimal Rp10.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 1{,}25 \\approx 0{,}322$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Masukkan data ke dalam rumus bunga majemuk $M_t = M_0(1 + r)^t$." },
        { "tipe": "paragraph", "text": "$8.000.000(1 + 0{,}05)^t \\geq 10.000.000 \\Rightarrow (1{,}05)^t \\geq \\dfrac{10.000.000}{8.000.000} = 1{,}25$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah bentuk pertidaksamaan eksponen ke bentuk logaritma." },
        { "tipe": "paragraph", "text": "$t \\geq {}^1{,}05\\log 1{,}25$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan sifat perubahan basis ke basis $2$." },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log 1{,}25}{{}^2\\log 1{,}05} = \\dfrac{0{,}322}{0{,}0704} \\approx 4{,}57$ tahun" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka dibulatkan ke atas menjadi $5$ tahun." },
        { "tipe": "paragraph", "text": "Jadi, waktu minimumnya adalah $5$ tahun (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
