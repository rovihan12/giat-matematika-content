{
  "id": "bs-k10-eks-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x} - 10 \\cdot 3^{x} + 9 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(3^x)^2 - 10 \\cdot 3^x + 9 = 0$" },
        { "tipe": "paragraph", "text": "Misal $y = 3^x$: $y^2 - 10y + 9 = 0$" },
        { "tipe": "paragraph", "text": "$(y - 9)(y - 1) = 0 \\Rightarrow y = 9$ atau $y = 1$" },
        { "tipe": "paragraph", "text": "$3^x = 9 \\Rightarrow x = 2$; $3^x = 1 \\Rightarrow x = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 5 = a$ dan ${}^2\\log 3 = b$, maka nilai ${}^{15}\\log 45$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2b + a}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2b + a}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 2b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^{15}\\log 45 = \\dfrac{{}^2\\log 45}{{}^2\\log 15}$" },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log(9 \\cdot 5) = 2b + a$" },
        { "tipe": "paragraph", "text": "${}^2\\log 15 = {}^2\\log(3 \\cdot 5) = b + a$" },
        { "tipe": "paragraph", "text": "Jadi ${}^{15}\\log 45 = \\dfrac{2b + a}{a + b}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 4x - 5) < 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 < x < -1$ atau $5 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat domain: $x^2 - 4x - 5 > 0 \\Rightarrow (x-5)(x+1) > 0 \\Rightarrow x < -1$ atau $x > 5$" },
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 4x - 5) < 4 \\Rightarrow x^2 - 4x - 5 < 16$" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 21 < 0 \\Rightarrow (x - 7)(x + 3) < 0 \\Rightarrow -3 < x < 7$" },
        { "tipe": "paragraph", "text": "Irisan dengan domain: $-3 < x < -1$ atau $5 < x < 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bakteri membelah menjadi dua setiap 30 menit. Jika mula-mula ada 100 bakteri, maka setelah 4 jam jumlah bakteri menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.600$" } ],
        [ { "tipe": "paragraph", "text": "$3.200$" } ],
        [ { "tipe": "paragraph", "text": "$6.400$" } ],
        [ { "tipe": "paragraph", "text": "$12.800$" } ],
        [ { "tipe": "paragraph", "text": "$25.600$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4$ jam $= 240$ menit, banyak periode $n = \\dfrac{240}{30} = 8$" },
        { "tipe": "paragraph", "text": "$N = 100 \\times 2^8 = 100 \\times 256 = 25.600$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+1) + {}^2\\log(x-1) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat: $x + 1 > 0$ dan $x - 1 > 0 \\Rightarrow x > 1$" },
        { "tipe": "paragraph", "text": "${}^2\\log[(x+1)(x-1)] = 3$" },
        { "tipe": "paragraph", "text": "$(x+1)(x-1) = 8 \\Rightarrow x^2 - 1 = 8$" },
        { "tipe": "paragraph", "text": "$x^2 = 9 \\Rightarrow x = 3$ (karena $x > 1$)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 4^b = 64$ dan $3^{a+b} = 81$. Nilai $a - b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^a \\cdot 2^{2b} = 2^6 \\Rightarrow a + 2b = 6$" },
        { "tipe": "paragraph", "text": "$3^{a+b} = 3^4 \\Rightarrow a + b = 4$" },
        { "tipe": "paragraph", "text": "Kurangkan: $b = 2$, maka $a = 2$" },
        { "tipe": "paragraph", "text": "$a - b = 2 - 2 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 5 \\cdot {}^5\\log 16 = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $\\left(\\dfrac{1}{2}\\right)^{x^2 - 2x} \\leq \\dfrac{1}{8}$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 1$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^{x^2 - 2x} \\leq \\dfrac{1}{8} = \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "Karena basis $\\dfrac{1}{2} < 1$, tanda berbalik: $x^2 - 2x \\geq 3$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 3 \\geq 0 \\Rightarrow (x - 3)(x + 1) \\geq 0$" },
        { "tipe": "paragraph", "text": "$x \\leq -1$ atau $x \\geq 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 7^{x} + 7^{-x}$ dan $f(a) = 5$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(a) = 7^a + 7^{-a} = 5$" },
        { "tipe": "paragraph", "text": "Kuadratkan: $(7^a + 7^{-a})^2 = 25$" },
        { "tipe": "paragraph", "text": "$7^{2a} + 2 + 7^{-2a} = 25$" },
        { "tipe": "paragraph", "text": "$7^{2a} + 7^{-2a} = 23$" },
        { "tipe": "paragraph", "text": "$f(2a) = 23$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp8.000.000,00 dibungakan majemuk 5% per tahun. Waktu minimum agar modal menjadi minimal Rp10.000.000,00 adalah... (gunakan ${}^2\\log 1{,}05 \\approx 0{,}0704$ dan ${}^2\\log 1{,}25 \\approx 0{,}322$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$8.000.000(1{,}05)^t \\geq 10.000.000$" },
        { "tipe": "paragraph", "text": "$(1{,}05)^t \\geq 1{,}25$" },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log 1{,}25}{{}^2\\log 1{,}05} = \\dfrac{0{,}322}{0{,}0704} \\approx 4{,}57$" },
        { "tipe": "paragraph", "text": "Jadi $t_{\\min} = 5$ tahun" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
