{
  "id": "bs-k10-eks-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang eksponen, logaritma, dan pemodelan matematika lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $25^{x} - 6 \\cdot 5^{x} + 5 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(5^x)^2 - 6 \\cdot 5^x + 5 = 0$" },
        { "tipe": "paragraph", "text": "Misal $y = 5^x$: $y^2 - 6y + 5 = 0$" },
        { "tipe": "paragraph", "text": "$(y - 5)(y - 1) = 0 \\Rightarrow y = 5$ atau $y = 1$" },
        { "tipe": "paragraph", "text": "$5^x = 5 \\Rightarrow x = 1$; $5^x = 1 \\Rightarrow x = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^3\\log 5 = a$ dan ${}^3\\log 2 = b$, maka nilai ${}^{10}\\log 30$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b + 1}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{a + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{b + 1}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^{10}\\log 30 = \\dfrac{{}^3\\log 30}{{}^3\\log 10}$" },
        { "tipe": "paragraph", "text": "${}^3\\log 30 = {}^3\\log(2 \\cdot 3 \\cdot 5) = b + 1 + a = a + b + 1$" },
        { "tipe": "paragraph", "text": "${}^3\\log 10 = {}^3\\log(2 \\cdot 5) = b + a = a + b$" },
        { "tipe": "paragraph", "text": "Jadi ${}^{10}\\log 30 = \\dfrac{a + b + 1}{a + b}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^2\\log(x^2 - 2x - 3) < 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5 < x < -1$ atau $3 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$-5 < x < 7$" } ],
        [ { "tipe": "paragraph", "text": "$x < -5$ atau $x > 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat domain: $x^2 - 2x - 3 > 0 \\Rightarrow (x-3)(x+1) > 0 \\Rightarrow x < -1$ atau $x > 3$" },
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 2x - 3) < 5 \\Rightarrow x^2 - 2x - 3 < 32$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 35 < 0 \\Rightarrow (x - 7)(x + 5) < 0 \\Rightarrow -5 < x < 7$" },
        { "tipe": "paragraph", "text": "Irisan dengan domain: $-5 < x < -1$ atau $3 < x < 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah mobil dibeli dengan harga Rp200.000.000,00. Setiap tahun nilai jualnya menyusut 15% dari harga sebelumnya. Nilai jual mobil setelah 3 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp122.825.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp125.000.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp130.000.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp140.000.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp150.000.000,00" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Nilai setelah $t$ tahun: $V_t = V_0(1 - 0{,}15)^t$" },
        { "tipe": "paragraph", "text": "$V_3 = 200.000.000 \\times (0{,}85)^3$" },
        { "tipe": "paragraph", "text": "$(0{,}85)^3 = 0{,}614125$" },
        { "tipe": "paragraph", "text": "$V_3 = 200.000.000 \\times 0{,}614125 = 122.825.000$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x} \\cdot 3^{x} = 36$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^x \\cdot 3^x = (2 \\cdot 3)^x = 6^x$" },
        { "tipe": "paragraph", "text": "$6^x = 36 = 6^2$" },
        { "tipe": "paragraph", "text": "$x = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui ${}^2\\log x + {}^2\\log y = 6$ dan $x - y = 12$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(xy) = 6 \\Rightarrow xy = 2^6 = 64$" },
        { "tipe": "paragraph", "text": "$x - y = 12 \\Rightarrow x = y + 12$" },
        { "tipe": "paragraph", "text": "$(y + 12)y = 64 \\Rightarrow y^2 + 12y - 64 = 0$" },
        { "tipe": "paragraph", "text": "$(y + 16)(y - 4) = 0 \\Rightarrow y = 4$ (karena $y > 0$)" },
        { "tipe": "paragraph", "text": "$x = 16$, maka $x + y = 20$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 6 \\cdot {}^6\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 6 \\cdot {}^6\\log 8 = {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^3 = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $4^{x} - 2^{x+1} - 8 > 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 < x < 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(2^x)^2 - 2 \\cdot 2^x - 8 > 0$" },
        { "tipe": "paragraph", "text": "Misal $y = 2^x$: $y^2 - 2y - 8 > 0$" },
        { "tipe": "paragraph", "text": "$(y - 4)(y + 2) > 0 \\Rightarrow y > 4$ atau $y < -2$" },
        { "tipe": "paragraph", "text": "Karena $y = 2^x > 0$, maka $y > 4$" },
        { "tipe": "paragraph", "text": "$2^x > 4 = 2^2 \\Rightarrow x > 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2^{x} + 2^{-x}$ dan $f(a) = 3$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(a) = 2^a + 2^{-a} = 3$" },
        { "tipe": "paragraph", "text": "Kuadratkan: $(2^a + 2^{-a})^2 = 9$" },
        { "tipe": "paragraph", "text": "$2^{2a} + 2 + 2^{-2a} = 9$" },
        { "tipe": "paragraph", "text": "$2^{2a} + 2^{-2a} = 7$" },
        { "tipe": "paragraph", "text": "$f(2a) = 2^{2a} + 2^{-2a} = 7$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp10.000.000,00 dibungakan majemuk 4% per semester. Besar modal setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp11.000.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp11.698.585,00" } ],
        [ { "tipe": "paragraph", "text": "Rp11.700.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp12.000.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp12.500.000,00" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bunga 4% per semester, 2 tahun = 4 semester" },
        { "tipe": "paragraph", "text": "$M_n = M_0(1 + i)^n$" },
        { "tipe": "paragraph", "text": "$M_4 = 10.000.000(1 + 0{,}04)^4 = 10.000.000(1{,}04)^4$" },
        { "tipe": "paragraph", "text": "$(1{,}04)^4 \\approx 1{,}16985856$" },
        { "tipe": "paragraph", "text": "$M_4 \\approx 11.698.585{,}60 \\approx 11.698.585$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}