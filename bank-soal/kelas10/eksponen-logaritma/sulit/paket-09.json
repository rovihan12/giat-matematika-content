{
  "id": "bs-k10-eks-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x} - 9 \\cdot 2^{x} + 8 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(2^x)^2 - 9 \\cdot 2^x + 8 = 0$" },
        { "tipe": "paragraph", "text": "Misal $y = 2^x$: $y^2 - 9y + 8 = 0$" },
        { "tipe": "paragraph", "text": "$(y - 8)(y - 1) = 0 \\Rightarrow y = 8$ atau $y = 1$" },
        { "tipe": "paragraph", "text": "$2^x = 8 \\Rightarrow x = 3$; $2^x = 1 \\Rightarrow x = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^3\\log 2 = a$ dan ${}^3\\log 5 = b$, maka nilai ${}^{10}\\log 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + 1}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2a + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^{10}\\log 12 = \\dfrac{{}^3\\log 12}{{}^3\\log 10}$" },
        { "tipe": "paragraph", "text": "${}^3\\log 12 = {}^3\\log(4 \\cdot 3) = {}^3\\log 4 + {}^3\\log 3 = 2a + 1$" },
        { "tipe": "paragraph", "text": "${}^3\\log 10 = {}^3\\log(2 \\cdot 5) = a + b$" },
        { "tipe": "paragraph", "text": "Jadi ${}^{10}\\log 12 = \\dfrac{2a + 1}{a + b}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^3\\log(x^2 - 2x - 8) \\leq 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < -2$ atau $4 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat domain: $x^2 - 2x - 8 > 0 \\Rightarrow (x-4)(x+2) > 0 \\Rightarrow x < -2$ atau $x > 4$" },
        { "tipe": "paragraph", "text": "${}^3\\log(x^2 - 2x - 8) \\leq 2 \\Rightarrow x^2 - 2x - 8 \\leq 9$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 17 \\leq 0$" },
        { "tipe": "paragraph", "text": "Akar: $x = 1 \\pm 3\\sqrt{2}$. Karena $1 - 3\\sqrt{2} \\approx -3{,}24$ dan $1 + 3\\sqrt{2} \\approx 5{,}24$." },
        { "tipe": "paragraph", "text": "Irisan dengan domain: $-3 \\leq x < -2$ atau $4 < x \\leq 5$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah zat radioaktif memiliki waktu paruh 15 tahun. Jika massa awal 480 gram, massa setelah 45 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$ gram" } ],
        [ { "tipe": "paragraph", "text": "$60$ gram" } ],
        [ { "tipe": "paragraph", "text": "$30$ gram" } ],
        [ { "tipe": "paragraph", "text": "$15$ gram" } ],
        [ { "tipe": "paragraph", "text": "$240$ gram" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$M(t) = M_0 \\left(\\dfrac{1}{2}\\right)^{t/T}$" },
        { "tipe": "paragraph", "text": "$M(45) = 480 \\left(\\dfrac{1}{2}\\right)^{45/15} = 480 \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "$= 480 \\cdot \\dfrac{1}{8} = 60$ gram" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-3) + {}^2\\log(x+3) = {}^2\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = 7$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat: $x - 3 > 0$ dan $x + 3 > 0 \\Rightarrow x > 3$" },
        { "tipe": "paragraph", "text": "${}^2\\log[(x-3)(x+3)] = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "$(x-3)(x+3) = 16 \\Rightarrow x^2 - 9 = 16$" },
        { "tipe": "paragraph", "text": "$x^2 = 25 \\Rightarrow x = 5$ (karena $x > 3$)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 4^b = 64$ dan $3^{a+b} = 81$. Nilai $a - b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^a \\cdot 2^{2b} = 2^6 \\Rightarrow a + 2b = 6$" },
        { "tipe": "paragraph", "text": "$3^{a+b} = 3^4 \\Rightarrow a + b = 4$" },
        { "tipe": "paragraph", "text": "Kurangkan: $b = 2$, maka $a = 2$" },
        { "tipe": "paragraph", "text": "$a - b = 2 - 2 = 0$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 4 \\cdot {}^4\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 4 \\cdot {}^4\\log 8 = {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^3 = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $2^{2x} - 9 \\cdot 2^{x} + 8 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 0$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $y = 2^x$: $y^2 - 9y + 8 \\leq 0$" },
        { "tipe": "paragraph", "text": "$(y - 1)(y - 8) \\leq 0 \\Rightarrow 1 \\leq y \\leq 8$" },
        { "tipe": "paragraph", "text": "$1 \\leq 2^x \\leq 8 = 2^3$" },
        { "tipe": "paragraph", "text": "$0 \\leq x \\leq 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2^{x} + 2^{-x}$ dan $f(a) = 4$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$f(a) = 2^a + 2^{-a} = 4$" },
        { "tipe": "paragraph", "text": "Kuadratkan: $(2^a + 2^{-a})^2 = 16$" },
        { "tipe": "paragraph", "text": "$2^{2a} + 2 + 2^{-2a} = 16$" },
        { "tipe": "paragraph", "text": "$2^{2a} + 2^{-2a} = 14$" },
        { "tipe": "paragraph", "text": "$f(2a) = 14$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp6.000.000,00 dibungakan majemuk 4% per tahun. Waktu minimum agar modal menjadi minimal Rp7.000.000,00 adalah... (gunakan ${}^2\\log 1{,}04 \\approx 0{,}0566$ dan ${}^2\\log\\dfrac{7}{6} \\approx 0{,}2224$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$6.000.000(1{,}04)^t \\geq 7.000.000$" },
        { "tipe": "paragraph", "text": "$(1{,}04)^t \\geq \\dfrac{7}{6}$" },
        { "tipe": "paragraph", "text": "$t \\geq \\dfrac{{}^2\\log(7/6)}{{}^2\\log 1{,}04} = \\dfrac{0{,}2224}{0{,}0566} \\approx 3{,}93$" },
        { "tipe": "paragraph", "text": "Jadi $t_{\\min} = 4$ tahun" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
