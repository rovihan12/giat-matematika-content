{
  "id": "bs-k10-eks-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang eksponen, logaritma, dan pemodelan matematika",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-eks-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x} - 9 \\cdot 2^{x} + 8 = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah bentuk persamaan eksponen dengan menjabarkan $4^x = (2^x)^2$**" },
        { "tipe": "formula_block", "latex": "(2^x)^2 - 9 \\cdot 2^x + 8 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $y = 2^x$ untuk membentuk persamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 9y + 8 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 8)(y - 1) = 0 \\Rightarrow y = 8 \\quad \\text{atau} \\quad y = 1" },
        { "tipe": "paragraph", "text": "**Langkah 4: Kembalikan ke pemisalan awal $y = 2^x$ untuk menentukan nilai $x$**" },
        { "tipe": "formula_block", "latex": "y = 8 \\Rightarrow 2^x = 8 = 2^3 \\Rightarrow x = 3" },
        { "tipe": "formula_block", "latex": "y = 1 \\Rightarrow 2^x = 1 = 2^0 \\Rightarrow x = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 0$ atau $x = 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^3\\log 2 = a$ dan ${}^3\\log 5 = b$, maka nilai ${}^{10}\\log 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + 1}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2a + b}{a + b}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + b}{2a + 1}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{a + 2b}{a + b}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah basis ${}^{10}\\log 12$ ke basis $3$**" },
        { "tipe": "formula_block", "latex": "{}^{10}\\log 12 = \\dfrac{{}^3\\log 12}{{}^3\\log 10}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uraikan pembilang dan penyebut ke dalam faktor-faktor primanya**" },
        { "tipe": "formula_block", "latex": "{}^3\\log 12 = {}^3\\log(2^2 \\cdot 3) = 2 \\cdot {}^3\\log 2 + {}^3\\log 3 = 2a + 1" },
        { "tipe": "formula_block", "latex": "{}^3\\log 10 = {}^3\\log(2 \\cdot 5) = {}^3\\log 2 + {}^3\\log 5 = a + b" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan hasil uraian ke bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "{}^{10}\\log 12 = \\dfrac{2a + 1}{a + b}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai ${}^{10}\\log 12$ adalah **$\\dfrac{2a + 1}{a + b}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari ${}^3\\log(x^2 - 2x - 6) \\leq 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < -2$ atau $4 < x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$-2 < x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Selesaikan pertidaksamaan logaritma dengan basis $3 > 1$**" },
        { "tipe": "formula_block", "latex": "{}^3\\log(x^2 - 2x - 6) \\leq {}^3\\log 3^2 \\Rightarrow x^2 - 2x - 6 \\leq 9" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 15 \\leq 0 \\Rightarrow (x - 5)(x + 3) \\leq 0 \\Rightarrow -3 \\leq x \\leq 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan syarat numerus logaritma ($x^2 - 2x - 6 > 0$)**" },
        { "tipe": "formula_block", "latex": "x^2 - 2x - 6 > 0 \\Rightarrow x < 1 - \\sqrt{7} \\quad \\text{atau} \\quad x > 1 + \\sqrt{7}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Iriskan interval $-3 \\leq x \\leq 5$ dengan syarat numerus**" },
        { "tipe": "paragraph", "text": "Karena $1 - \\sqrt{7} \\approx -1{,}65$ dan $1 + \\sqrt{7} \\approx 3{,}65$, batas bilangan bulat pada pilihan yang memenuhi syarat numerus dan berada di dalam $[-3, 5]$ adalah:" },
        { "tipe": "formula_block", "latex": "-3 \\leq x < -2 \\quad \\text{atau} \\quad 4 < x \\leq 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaian yang sesuai adalah **$-3 \\leq x < -2$ atau $4 < x \\leq 5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah zat radioaktif memiliki waktu paruh 15 tahun. Jika massa awal 480 gram, massa setelah 45 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$ gram" } ],
        [ { "tipe": "paragraph", "text": "$60$ gram" } ],
        [ { "tipe": "paragraph", "text": "$30$ gram" } ],
        [ { "tipe": "paragraph", "text": "$15$ gram" } ],
        [ { "tipe": "paragraph", "text": "$240$ gram" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan data ke rumus peluruhan radioaktif**" },
        { "tipe": "paragraph", "text": "Gunakan rumus $M(t) = M_0 \\left(\\dfrac{1}{2}\\right)^{t/T}$ dengan $M_0 = 480$, $T = 15$, dan $t = 45$:" },
        { "tipe": "formula_block", "latex": "M(45) = 480 \\left(\\dfrac{1}{2}\\right)^{45/15}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan pangkat dan hitung massa akhir**" },
        { "tipe": "formula_block", "latex": "M(45) = 480 \\left(\\dfrac{1}{2}\\right)^3 = 480 \\cdot \\dfrac{1}{8} = 60" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, massa zat radioaktif setelah 45 tahun adalah **$60$ gram**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-3) + {}^2\\log(x+3) = {}^2\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = 7$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan syarat numerus untuk setiap logaritma**" },
        { "tipe": "formula_block", "latex": "x - 3 > 0 \\Rightarrow x > 3" },
        { "tipe": "formula_block", "latex": "x + 3 > 0 \\Rightarrow x > -3" },
        { "tipe": "paragraph", "text": "Irisan dari kedua syarat numerus tersebut adalah $x > 3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan ruas kiri menggunakan sifat penjumlahan logaritma**" },
        { "tipe": "formula_block", "latex": "{}^2\\log[(x - 3)(x + 3)] = {}^2\\log 16" },
        { "tipe": "paragraph", "text": "**Langkah 3: Samakan numerus kedua ruas dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "(x - 3)(x + 3) = 16 \\Rightarrow x^2 - 9 = 16" },
        { "tipe": "formula_block", "latex": "x^2 = 25 \\Rightarrow x = -5 \\quad \\text{atau} \\quad x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 4: Uji nilai $x$ terhadap syarat numerus $x > 3$**" },
        { "tipe": "paragraph", "text": "Karena syarat numerus mengharuskan $x > 3$, maka $x = -5$ tidak memenuhi dan nilai yang valid hanyalah $x = 5$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x = 5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $a$ dan $b$ memenuhi $2^a \\cdot 4^b = 64$ dan $3^{a+b} = 81$. Nilai $a - b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah setiap persamaan ke bentuk basis bilangan prima yang sama**" },
        { "tipe": "formula_block", "latex": "2^a \\cdot (2^2)^b = 2^6 \\Rightarrow 2^{a + 2b} = 2^6 \\Rightarrow a + 2b = 6" },
        { "tipe": "formula_block", "latex": "3^{a + b} = 3^4 \\Rightarrow a + b = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $a$ untuk mendapatkan nilai $b$, lalu substitusikan untuk mencari $a$**" },
        { "tipe": "formula_block", "latex": "(a + 2b) - (a + b) = 6 - 4 \\Rightarrow b = 2" },
        { "tipe": "formula_block", "latex": "a + 2 = 4 \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung selisih $a - b$**" },
        { "tipe": "formula_block", "latex": "a - b = 2 - 2 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a - b$ adalah **$0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 4 \\cdot {}^4\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat perkalian rantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d \\cdot {}^d\\log e = {}^a\\log e$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 4 \\cdot {}^4\\log 8 = {}^2\\log 8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan nilai ${}^2\\log 8$**" },
        { "tipe": "formula_block", "latex": "{}^2\\log 8 = {}^2\\log 2^3 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai dari ${}^2\\log 5 \\cdot {}^5\\log 7 \\cdot {}^7\\log 4 \\cdot {}^4\\log 8$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pertidaksamaan $2^{2x} - 9 \\cdot 2^{x} + 8 \\leq 0$ dipenuhi oleh..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 0$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan $2^{2x} = (2^x)^2$ dan misalkan $y = 2^x$ untuk membentuk pertidaksamaan kuadrat**" },
        { "tipe": "formula_block", "latex": "y^2 - 9y + 8 \\leq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan bentuk kuadrat tersebut**" },
        { "tipe": "formula_block", "latex": "(y - 1)(y - 8) \\leq 0 \\Rightarrow 1 \\leq y \\leq 8" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke pemisalan awal $y = 2^x$ dan selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "1 \\leq 2^x \\leq 8 \\Rightarrow 2^0 \\leq 2^x \\leq 2^3 \\Rightarrow 0 \\leq x \\leq 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$0 \\leq x \\leq 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $f(x) = 2^{x} + 2^{-x}$ dan $f(a) = 4$, maka nilai $f(2a)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan bentuk persamaan dari $f(a) = 4$**" },
        { "tipe": "formula_block", "latex": "f(a) = 2^a + 2^{-a} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kuadratkan kedua ruas persamaan tersebut**" },
        { "tipe": "formula_block", "latex": "(2^a + 2^{-a})^2 = 4^2" },
        { "tipe": "formula_block", "latex": "(2^a)^2 + 2 \\cdot 2^a \\cdot 2^{-a} + (2^{-a})^2 = 16" },
        { "tipe": "formula_block", "latex": "2^{2a} + 2 \\cdot 2^{a - a} + 2^{-2a} = 16 \\Rightarrow 2^{2a} + 2 + 2^{-2a} = 16" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan untuk mendapatkan nilai $f(2a) = 2^{2a} + 2^{-2a}$**" },
        { "tipe": "formula_block", "latex": "f(2a) = 2^{2a} + 2^{-2a} = 16 - 2 = 14" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $f(2a)$ adalah **$14$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-eks-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp6.000.000,00 dibungakan majemuk 4% per tahun. Waktu minimum agar modal menjadi minimal Rp7.000.000,00 adalah... (gunakan ${}^2\\log 1{,}04 \\approx 0{,}0566$ dan ${}^2\\log\\dfrac{7}{6} \\approx 0{,}2224$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$4$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$5$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$6$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$7$ tahun" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun pertidaksamaan berdasarkan rumus bunga majemuk $M_t = M_0(1 + r)^t$**" },
        { "tipe": "formula_block", "latex": "6.000.000(1 + 0{,}04)^t \\geq 7.000.000 \\Rightarrow (1{,}04)^t \\geq \\dfrac{7.000.000}{6.000.000} = \\dfrac{7}{6}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$**" },
        { "tipe": "formula_block", "latex": "t \\geq {}^{1{,}04}\\log\\left(\\dfrac{7}{6}\\right) = \\dfrac{{}^2\\log\\left(\\dfrac{7}{6}\\right)}{{}^2\\log 1{,}04}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Substitusikan nilai hampiran logaritma dan bulatkan ke atas**" },
        { "tipe": "formula_block", "latex": "t \\geq \\dfrac{0{,}2224}{0{,}0566} \\approx 3{,}93" },
        { "tipe": "paragraph", "text": "Karena waktu investasi dihitung dalam tahun penuh agar modal mencapai atau melebihi target, maka $3{,}93$ tahun dibulatkan ke atas menjadi $4$ tahun." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, waktu minimum yang dibutuhkan adalah **$4$ tahun**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
