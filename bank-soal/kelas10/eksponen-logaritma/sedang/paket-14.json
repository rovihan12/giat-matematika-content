{
  "id": "bs-k10-eks-sedang-14",
  "nama": "Bank Soal Sedang - Paket 14",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-14-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $5^{2x-1} = 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5^{2x-1} = 125 = 5^3$" },
        { "tipe": "paragraph", "text": "$2x - 1 = 3 \\Rightarrow 2x = 4 \\Rightarrow x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(6x - 5) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(6x - 5) = 3 \\Rightarrow 6x - 5 = 2^3 = 8$" },
        { "tipe": "paragraph", "text": "$6x = 13 \\Rightarrow x = \\dfrac{13}{6}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $27^{x+1} = 9^{x+3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$27^{x+1} = 9^{x+3} \\Rightarrow (3^3)^{x+1} = (3^2)^{x+3}$" },
        { "tipe": "paragraph", "text": "$3x + 3 = 2x + 6 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 96 - {}^2\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 96 - {}^2\\log 3 = {}^2\\log\\left(\\dfrac{96}{3}\\right) = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 3 \\cdot {}^3\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 3 \\cdot {}^3\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x^2 - 6x + 8} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x^2 - 6x + 8} = 1 = 2^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 6x + 8 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 4) = 0 \\Rightarrow x = 2$ atau $x = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 9 \\cdot {}^9\\log 32$ adalah..." } 
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 9 \\cdot {}^9\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
      {
      "id": "bs-k10-eks-s-14-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-1) + {}^2\\log(x+3) = {}^2\\log 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat: $x > 1$" },
        { "tipe": "paragraph", "text": "${}^2\\log[(x-1)(x+3)] = {}^2\\log 12$" },
        { "tipe": "paragraph", "text": "$(x-1)(x+3) = 12 \\Rightarrow x^2 + 2x - 3 = 12$" },
        { "tipe": "paragraph", "text": "$x^2 + 2x - 15 = 0 \\Rightarrow (x+5)(x-3) = 0$" },
        { "tipe": "paragraph", "text": "Karena $x > 1$, maka $x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $4^{x} \\geq 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4^x \\geq 64 = 4^3$" },
        { "tipe": "paragraph", "text": "Karena basis $4 > 1$: $x \\geq 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tabungan Rp4.000.000,00 dibungakan majemuk 5% per tahun. Besar tabungan setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp4.200.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.400.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.410.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.500.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.600.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$M_2 = M_0(1 + i)^2 = 4.000.000(1{,}05)^2$" },
        { "tipe": "paragraph", "text": "$(1{,}05)^2 = 1{,}1025$" },
        { "tipe": "paragraph", "text": "$M_2 = 4.000.000 \\times 1{,}1025 = 4.410.000$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
