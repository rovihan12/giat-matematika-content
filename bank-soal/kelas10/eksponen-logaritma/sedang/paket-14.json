  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-14-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $5^{2x-1} = 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $5^{2x-1} = 125$. Kita harus mencari nilai $x$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m = a^n$ dengan basis $a$ sama (dan $a > 0$, $a \\neq 1$), maka pangkatnya harus sama: $m = n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bilangan di ruas kanan ($125$) menjadi bentuk bilangan berpangkat dengan basis $5$ ($125 = 5^3$)." },
        { "tipe": "paragraph", "text": "$5^{2x-1} = 5^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$2x - 1 = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$2x = 3 + 1$" },
        { "tipe": "paragraph", "text": "$2x = 4 \\Rightarrow x = \\dfrac{4}{2} = 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 2$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(6x - 5) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(6x - 5) = 3$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$6x - 5 = 2^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai perpangkatan pada ruas kanan ($2^3 = 8$)." },
        { "tipe": "paragraph", "text": "$6x - 5 = 8$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mendapatkan nilai $x$." },
        { "tipe": "paragraph", "text": "$6x = 8 + 5$" },
        { "tipe": "paragraph", "text": "$6x = 13 \\Rightarrow x = \\dfrac{13}{6}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Pastikan numerus bernilai positif ($6x - 5 > 0$). Untuk $x = \\dfrac{13}{6}$, diperoleh $6\\left(\\dfrac{13}{6}\\right) - 5 = 8 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = \\dfrac{13}{6}$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $27^{x+1} = 9^{x+3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $27^{x+1} = 9^{x+3}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan $(a^m)^n = a^{m \\cdot n}$ dan penyamaan basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah basis kedua ruas menjadi basis yang sama, yaitu $3$ ($27 = 3^3$ dan $9 = 3^2$)." },
        { "tipe": "paragraph", "text": "$(3^3)^{x+1} = (3^2)^{x+3}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan pangkat di dalam dan di luar kurung pada masing-masing ruas." },
        { "tipe": "paragraph", "text": "$3^{3(x+1)} = 3^{2(x+3)}$" },
        { "tipe": "paragraph", "text": "$3^{3x + 3} = 3^{2x + 6}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$3x + 3 = 2x + 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kelompokkan suku sejenis untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$3x - 2x = 6 - 3$" },
        { "tipe": "paragraph", "text": "$x = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 3$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 96 - {}^2\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pengurangan dua logaritma dengan basis yang sama (${}^2\\log 96 - {}^2\\log 3$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pengurangan logaritma ${}^a\\log m - {}^a\\log n = {}^a\\log \\left(\\dfrac{m}{n}\\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan pengurangan logaritma menjadi bentuk pembagian numerus." },
        { "tipe": "paragraph", "text": "${}^2\\log 96 - {}^2\\log 3 = {}^2\\log\\left(\\dfrac{96}{3}\\right)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan hasil pembagian di dalam numerus." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Ubah angka $32$ menjadi $2^5$, lalu gunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5 = 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 3 \\cdot {}^3\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian tiga suku logaritma berantai ${}^2\\log 5 \\cdot {}^5\\log 3 \\cdot {}^3\\log 32$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus dan basis suku yang berdekatan saling sama ($5$ dan $3$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 3 \\cdot {}^3\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $32$ menjadi bentuk bilangan berpangkat dengan basis $2$ ($32 = 2^5$)." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x^2 - 6x + 8} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $2^{x^2 - 6x + 8} = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol dipangkatkan nol bernilai $1$ ($a^0 = 1$). Jadi, angka $1$ dapat ditulis sebagai $2^0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan dengan menyamakan basis kedua ruas." },
        { "tipe": "paragraph", "text": "$2^{x^2 - 6x + 8} = 2^0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x^2 - 6x + 8 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 4) = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Tentukan nilai $x$ yang memenuhi." },
        { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 2$ atau $x = 4$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 9 \\cdot {}^9\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian dua bentuk logaritma ${}^2\\log 9 \\cdot {}^9\\log 32$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus suku pertama sama dengan basis suku kedua (yaitu $9$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 9 \\cdot {}^9\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $32$ menjadi bentuk bilangan berpangkat dengan basis $2$ ($32 = 2^5$)." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-1) + {}^2\\log(x+3) = {}^2\\log 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(x-1) + {}^2\\log(x+3) = {}^2\\log 12$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan logaritma ${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$ serta uji syarat numerus." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat numerus agar terdefinisi ($x - 1 > 0 \\Rightarrow x > 1$ dan $x + 3 > 0 \\Rightarrow x > -3$, sehingga syarat utamanya $x > 1$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gabungkan penjumlahan logaritma di ruas kiri." },
        { "tipe": "paragraph", "text": "${}^2\\log[(x-1)(x+3)] = {}^2\\log 12$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan numerus pada kedua ruas." },
        { "tipe": "paragraph", "text": "$(x - 1)(x + 3) = 12$" },
        { "tipe": "paragraph", "text": "$x^2 + 2x - 3 = 12$" },
        { "tipe": "paragraph", "text": "$x^2 + 2x - 15 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x + 5)(x - 3) = 0$" },
        { "tipe": "paragraph", "text": "Diperoleh $x = -5$ atau $x = 3$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 5 (Uji Syarat):</strong> Karena syaratnya $x > 1$, nilai $x = -5$ ditolak, sehingga yang memenuhi adalah $x = 3$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 3$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $4^{x} \\geq 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pertidaksamaan eksponen $4^x \\geq 64$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m \\geq a^n$ dengan basis $a > 1$, maka tanda pertidaksamaan tetap ($m \\geq n$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah angka $64$ menjadi bentuk bilangan berpangkat dengan basis $4$ ($64 = 4^3$)." },
        { "tipe": "paragraph", "text": "$4^x \\geq 4^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena basis $4 > 1$, tanda pertidaksamaan tetap dan bandingkan pangkatnya." },
        { "tipe": "paragraph", "text": "$x \\geq 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x \\geq 3$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-14-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tabungan Rp4.000.000,00 dibungakan majemuk 5% per tahun. Besar tabungan setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp4.200.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.400.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.410.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.500.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp4.600.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Modal awal ($M_0$) = $\\text{Rp}4.000.000$, suku bunga ($i$) = $5\\% = 0{,}05$ per tahun, dan periode waktu ($n$) = $2$ tahun." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Rumus pertumbuhan eksponensial untuk bunga majemuk $M_n = M_0(1 + i)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Substitusikan nilai yang diketahui ke dalam rumus bunga majemuk." },
        { "tipe": "paragraph", "text": "$M_2 = 4.000.000(1 + 0{,}05)^2$" },
        { "tipe": "paragraph", "text": "$M_2 = 4.000.000(1{,}05)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai pangkat dari faktor pengali $(1{,}05)^2$." },
        { "tipe": "paragraph", "text": "$(1{,}05)^2 = 1{,}1025$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kalikan hasil tersebut dengan modal awal untuk mendapatkan besar tabungan akhir." },
        { "tipe": "paragraph", "text": "$M_2 = 4.000.000 \\times 1{,}1025 = 4.410.000$" },
        { "tipe": "paragraph", "text": "Jadi, besar tabungan setelah $2$ tahun adalah $\\text{Rp}4.410.000{,}00$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
