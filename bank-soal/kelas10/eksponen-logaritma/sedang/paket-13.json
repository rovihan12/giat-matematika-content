{
  "id": "bs-k10-eks-sedang-13",
  "nama": "Bank Soal Sedang - Paket 13",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-13-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{x+4} = 243$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $3^{x+4} = 243$. Kita harus mencari nilai $x$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m = a^n$ dengan basis $a$ sama (dan $a > 0$, $a \\neq 1$), maka pangkatnya harus sama: $m = n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bilangan di ruas kanan ($243$) menjadi bentuk bilangan berpangkat dengan basis $3$ ($243 = 3^5$)." },
        { "tipe": "paragraph", "text": "$3^{x+4} = 3^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x + 4 = 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$x = 5 - 4 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 1$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(7x - 3) = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{19}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(7x - 3) = 4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$7x - 3 = 2^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai perpangkatan pada ruas kanan ($2^4 = 16$)." },
        { "tipe": "paragraph", "text": "$7x - 3 = 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mendapatkan nilai $x$." },
        { "tipe": "paragraph", "text": "$7x = 16 + 3$" },
        { "tipe": "paragraph", "text": "$7x = 19 \\Rightarrow x = \\dfrac{19}{7}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Pastikan numerus bernilai positif ($7x - 3 > 0$). Untuk $x = \\dfrac{19}{7}$, diperoleh $7\\left(\\dfrac{19}{7}\\right) - 3 = 16 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = \\dfrac{19}{7}$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $16^{x-1} = 8^{x+2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $16^{x-1} = 8^{x+2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan $(a^m)^n = a^{m \\cdot n}$ dan penyamaan basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah basis kedua ruas menjadi basis yang sama, yaitu $2$ ($16 = 2^4$ dan $8 = 2^3$)." },
        { "tipe": "paragraph", "text": "$(2^4)^{x-1} = (2^3)^{x+2}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan pangkat di dalam dan di luar kurung pada masing-masing ruas." },
        { "tipe": "paragraph", "text": "$2^{4(x-1)} = 2^{3(x+2)}$" },
        { "tipe": "paragraph", "text": "$2^{4x - 4} = 2^{3x + 6}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$4x - 4 = 3x + 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kelompokkan suku sejenis untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$4x - 3x = 6 + 4$" },
        { "tipe": "paragraph", "text": "$x = 10$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 10$ (pilihan keempat)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 72 - {}^3\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pengurangan dua logaritma dengan basis yang sama (${}^3\\log 72 - {}^3\\log 8$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pengurangan logaritma ${}^a\\log m - {}^a\\log n = {}^a\\log \\left(\\dfrac{m}{n}\\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan pengurangan logaritma menjadi bentuk pembagian numerus." },
        { "tipe": "paragraph", "text": "${}^3\\log 72 - {}^3\\log 8 = {}^3\\log\\left(\\dfrac{72}{8}\\right)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan hasil pembagian di dalam numerus." },
        { "tipe": "paragraph", "text": "$= {}^3\\log 9$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Ubah angka $9$ menjadi $3^2$, lalu gunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^2 = 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 6 \\cdot {}^6\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian tiga suku logaritma berantai ${}^2\\log 5 \\cdot {}^5\\log 6 \\cdot {}^6\\log 16$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus dan basis suku yang berdekatan saling sama ($5$ dan $6$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 6 \\cdot {}^6\\log 16 = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $16$ menjadi bentuk bilangan berpangkat dengan basis $2$ ($16 = 2^4$)." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $5^{x^2 - 2x - 8} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $5^{x^2 - 2x - 8} = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol dipangkatkan nol bernilai $1$ ($a^0 = 1$). Jadi, angka $1$ dapat ditulis sebagai $5^0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan dengan menyamakan basis kedua ruas." },
        { "tipe": "paragraph", "text": "$5^{x^2 - 2x - 8} = 5^0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 8 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 2) = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Tentukan nilai $x$ yang memenuhi." },
        { "tipe": "paragraph", "text": "$x = 4$ atau $x = -2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = -2$ atau $x = 4$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^9\\log 5 \\cdot {}^5\\log 81$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$81$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian dua bentuk logaritma ${}^9\\log 5 \\cdot {}^5\\log 81$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus suku pertama sama dengan basis suku kedua (yaitu $5$)." },
        { "tipe": "paragraph", "text": "${}^9\\log 5 \\cdot {}^5\\log 81 = {}^9\\log 81$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $81$ menjadi bentuk bilangan berpangkat dengan basis $9$ ($81 = 9^2$)." },
        { "tipe": "paragraph", "text": "$= {}^9\\log 9^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 7x + 12) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 3$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(x^2 - 7x + 12) = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$x^2 - 7x + 12 = 2^1$" },
        { "tipe": "paragraph", "text": "$x^2 - 7x + 12 = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Pindahkan seluruh suku ke ruas kiri untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$x^2 - 7x + 12 - 2 = 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 7x + 10 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 5) = 0$" },
        { "tipe": "paragraph", "text": "Diperoleh $x = 2$ atau $x = 5$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Numerus harus bernilai positif ($x^2 - 7x + 12 > 0$). Untuk $x = 2$, diperoleh $2^2 - 7(2) + 12 = 2 > 0$ (memenuhi). Untuk $x = 5$, diperoleh $5^2 - 7(5) + 12 = 2 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 2$ atau $x = 5$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{5}\\right)^{x} > \\dfrac{1}{125}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pertidaksamaan eksponen $\\left(\\dfrac{1}{5}\\right)^x > \\dfrac{1}{125}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan dan sifat pertidaksamaan eksponen untuk basis pecahan antara $0$ dan $1$ ($0 < a < 1$): jika $a^m > a^n$, maka tanda pertidaksamaan berbalik menjadi $m < n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{125}$ menjadi bentuk perpangkatan dengan basis $\\dfrac{1}{5}$ (karena $\\dfrac{1}{125} = \\left(\\dfrac{1}{5}\\right)^3$)." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{5}\\right)^x > \\left(\\dfrac{1}{5}\\right)^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena basisnya berupa pecahan antara $0$ dan $1$ (yaitu $\\dfrac{1}{5}$), tanda pertidaksamaan harus dibalik saat membandingkan pangkatnya." },
        { "tipe": "paragraph", "text": "$x < 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x < 3$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-13-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi bakteri berlipat ganda setiap 5 jam. Jika mula-mula ada 400 bakteri, maka setelah 15 jam populasinya menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.200$" } ],
        [ { "tipe": "paragraph", "text": "$2.400$" } ],
        [ { "tipe": "paragraph", "text": "$3.200$" } ],
        [ { "tipe": "paragraph", "text": "$4.800$" } ],
        [ { "tipe": "paragraph", "text": "$6.400$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Populasi awal ($P_0$) = $400$ bakteri, rasio pertumbuhan ($r$) = $2$ (berlipat ganda) setiap $5$ jam, dan total waktu = $15$ jam." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Rumus pertumbuhan eksponensial $P_n = P_0 \\times r^n$, dengan $n = \\dfrac{\\text{waktu total}}{\\text{waktu per periode}}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Hitung banyaknya periode penggandaan ($n$) selama $15$ jam." },
        { "tipe": "paragraph", "text": "$n = \\dfrac{15}{5} = 3\\text{ periode}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $P_0$, $r$, dan $n$ ke dalam rumus pertumbuhan." },
        { "tipe": "paragraph", "text": "$P_3 = 400 \\times 2^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Hitung perpangkatan dan kalikan dengan populasi awal." },
        { "tipe": "paragraph", "text": "$P_3 = 400 \\times 8 = 3.200$" },
        { "tipe": "paragraph", "text": "Jadi, populasi bakteri setelah $15$ jam adalah $3.200$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
