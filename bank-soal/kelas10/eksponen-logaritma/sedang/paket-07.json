{
  "id": "bs-k10-eks-sedang-07",
  "nama": "Bank Soal Sedang - Paket 7",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{2x-1} = 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{2x-1} = 8 = 2^3$" },
        { "tipe": "paragraph", "text": "$2x - 1 = 3 \\Rightarrow 2x = 4 \\Rightarrow x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(4x - 3) = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log(4x - 3) = 2 \\Rightarrow 4x - 3 = 3^2 = 9$" },
        { "tipe": "paragraph", "text": "$4x = 12 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x+1} = 8^{x-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4^{x+1} = 8^{x-1} \\Rightarrow (2^2)^{x+1} = (2^3)^{x-1}$" },
        { "tipe": "paragraph", "text": "$2^{2x+2} = 2^{3x-3}$" },
        { "tipe": "paragraph", "text": "$2x + 2 = 3x - 3 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 54 - {}^3\\log 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 54 - {}^3\\log 2 = {}^3\\log\\left(\\dfrac{54}{2}\\right) = {}^3\\log 27$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 9 \\cdot {}^3\\log 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 9 \\cdot {}^3\\log 4 = {}^2\\log 3^2 \\cdot {}^3\\log 2^2$" },
        { "tipe": "paragraph", "text": "$= (2 \\cdot {}^2\\log 3)(2 \\cdot {}^3\\log 2)$" },
        { "tipe": "paragraph", "text": "$= 4 \\cdot ({}^2\\log 3 \\cdot {}^3\\log 2) = 4 \\cdot 1 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x^2 + x - 6} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -3$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -3$ atau $x = -2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x^2 + x - 6} = 1 = 2^0$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 6 = 0$" },
        { "tipe": "paragraph", "text": "$(x + 3)(x - 2) = 0 \\Rightarrow x = -3$ atau $x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 16 = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(x^2 - 4x - 2) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log(x^2 - 4x - 2) = 1 \\Rightarrow x^2 - 4x - 2 = 3^1 = 3$" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 5 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 5)(x + 1) = 0 \\Rightarrow x = 5$ atau $x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{4}\\right)^{x} > 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > -2$" } ],
        [ { "tipe": "paragraph", "text": "$x < -2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{4}\\right)^x > 16 \\Rightarrow (2^{-2})^x > 2^4$" },
        { "tipe": "paragraph", "text": "$2^{-2x} > 2^4$" },
        { "tipe": "paragraph", "text": "Karena basis $2 > 1$: $-2x > 4 \\Rightarrow x < -2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi serangga berlipat ganda setiap 5 jam. Jika mula-mula ada 250 serangga, maka setelah 20 jam populasinya menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1.000$" } ],
        [ { "tipe": "paragraph", "text": "$2.000$" } ],
        [ { "tipe": "paragraph", "text": "$4.000$" } ],
        [ { "tipe": "paragraph", "text": "$5.000$" } ],
        [ { "tipe": "paragraph", "text": "$8.000$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak periode: $n = \\dfrac{20}{5} = 4$" },
        { "tipe": "paragraph", "text": "$P = 250 \\times 2^4 = 250 \\times 16 = 4.000$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
