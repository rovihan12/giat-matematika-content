{
  "id": "bs-k10-eks-sedang-02",
  "nama": "Bank Soal Sedang - Paket 2",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan perubahan basis",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{x+2} = 81$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{x+2} = 81 = 3^4$" },
        { "tipe": "paragraph", "text": "$x + 2 = 4 \\Rightarrow x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^5\\log(3x - 2) = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^5\\log(3x - 2) = 2 \\Rightarrow 3x - 2 = 5^2 = 25$" },
        { "tipe": "paragraph", "text": "$3x = 27 \\Rightarrow x = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{3x-2} = 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{3x-2} = 32 = 2^5$" },
        { "tipe": "paragraph", "text": "$3x - 2 = 5$" },
        { "tipe": "paragraph", "text": "$3x = 7 \\Rightarrow x = \\dfrac{7}{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 24 - {}^2\\log 3 + {}^2\\log 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 24 - {}^2\\log 3 + {}^2\\log 2 = {}^2\\log\\left(\\dfrac{24 \\cdot 2}{3}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 16 = {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 8 = {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x^2 - 3x} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4^{x^2 - 3x} = 1 = 4^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x = 0$" },
        { "tipe": "paragraph", "text": "$x(x - 3) = 0 \\Rightarrow x = 0$ atau $x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 2 \\cdot {}^2\\log 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 2 \\cdot {}^2\\log 9 = {}^3\\log 9$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^2 = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(x^2 - 2x) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -3$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = -3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log(x^2 - 2x) = 1 \\Rightarrow x^2 - 2x = 3^1 = 3$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 3 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 3)(x + 1) = 0 \\Rightarrow x = 3$ atau $x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{2}\\right)^x < 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^x < 8 = 2^3$" },
        { "tipe": "paragraph", "text": "$2^{-x} < 2^3$" },
        { "tipe": "paragraph", "text": "Karena basis $2 > 1$: $-x < 3 \\Rightarrow x > -3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi bakteri berlipat ganda setiap 3 jam. Jika mula-mula ada 100 bakteri, maka setelah 9 jam populasinya menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$400$" } ],
        [ { "tipe": "paragraph", "text": "$600$" } ],
        [ { "tipe": "paragraph", "text": "$800$" } ],
        [ { "tipe": "paragraph", "text": "$900$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak periode: $n = \\dfrac{9}{3} = 3$" },
        { "tipe": "paragraph", "text": "$P = 100 \\times 2^3 = 100 \\times 8 = 800$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
