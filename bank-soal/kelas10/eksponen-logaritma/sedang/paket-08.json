{
  "id": "bs-k10-eks-sedang-08",
  "nama": "Bank Soal Sedang - Paket 8",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{2x+1} = 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{2x+1} = 27 = 3^3$" },
        { "tipe": "paragraph", "text": "$2x + 1 = 3 \\Rightarrow 2x = 2 \\Rightarrow x = 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(3x + 2) = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{30}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(3x + 2) = 5 \\Rightarrow 3x + 2 = 2^5 = 32$" },
        { "tipe": "paragraph", "text": "$3x = 30 \\Rightarrow x = 10$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x-2} = 27^{x-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$9^{x-2} = 27^{x-3} \\Rightarrow (3^2)^{x-2} = (3^3)^{x-3}$" },
        { "tipe": "paragraph", "text": "$2x - 4 = 3x - 9$" },
        { "tipe": "paragraph", "text": "$-x = -5 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 40 - {}^2\\log 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 40 - {}^2\\log 5 = {}^2\\log\\left(\\dfrac{40}{5}\\right) = {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 8 = {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x^2 - 3x - 4} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x^2 - 3x - 4} = 1 = 2^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) = 0 \\Rightarrow x = 4$ atau $x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 2 \\cdot {}^2\\log 5 \\cdot {}^5\\log 27 = {}^3\\log 27$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 5x + 6) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 5x + 6) = 1 \\Rightarrow x^2 - 5x + 6 = 2$" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 4 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 1)(x - 4) = 0 \\Rightarrow x = 1$ atau $x = 4$" },
        { "tipe": "paragraph", "text": "Kedua nilai memenuhi syarat numerus $x^2 - 5x + 6 > 0$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2^{x} \\geq 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^x \\geq 32 = 2^5$" },
        { "tipe": "paragraph", "text": "Karena basis $2 > 1$, tanda tetap: $x \\geq 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tabungan Rp2.500.000,00 dibungakan majemuk 6% per tahun. Besar tabungan setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp2.650.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.700.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.809.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.810.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.900.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$M_n = M_0(1 + i)^n$" },
        { "tipe": "paragraph", "text": "$M_2 = 2.500.000(1 + 0{,}06)^2 = 2.500.000(1{,}06)^2$" },
        { "tipe": "paragraph", "text": "$(1{,}06)^2 = 1{,}1236$" },
        { "tipe": "paragraph", "text": "$M_2 = 2.500.000 \\times 1{,}1236 = 2.809.000$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
