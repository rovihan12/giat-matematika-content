{
  "id": "bs-k10-eks-sedang-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi persamaan $2^{x+1} = 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x+1} = 8 = 2^3$" },
        { "tipe": "paragraph", "text": "Karena basis sama, maka $x + 1 = 3$" },
        { "tipe": "paragraph", "text": "$x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x+3) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(x+3) = 3 \\Rightarrow x + 3 = 2^3 = 8$" },
        { "tipe": "paragraph", "text": "$x = 8 - 3 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{2x-1} = 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{2x-1} = 27 = 3^3$" },
        { "tipe": "paragraph", "text": "$2x - 1 = 3$" },
        { "tipe": "paragraph", "text": "$2x = 4 \\Rightarrow x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(2x-1) = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log(2x-1) = 2 \\Rightarrow 2x - 1 = 3^2 = 9$" },
        { "tipe": "paragraph", "text": "$2x = 10 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 12 + {}^2\\log 4 - {}^2\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 12 + {}^2\\log 4 - {}^2\\log 3 = {}^2\\log\\left(\\dfrac{12 \\cdot 4}{3}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 16 = {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 5 \\cdot {}^5\\log 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan sifat ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$" },
        { "tipe": "paragraph", "text": "${}^3\\log 5 \\cdot {}^5\\log 27 = {}^3\\log 27 = {}^3\\log 3^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $5^{x^2 - 2x} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5^{x^2 - 2x} = 1 = 5^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x = 0$" },
        { "tipe": "paragraph", "text": "$x(x - 2) = 0 \\Rightarrow x = 0$ atau $x = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 4x) = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -4$ atau $x = 8$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = -6$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = -8$ atau $x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 4x) = 5 \\Rightarrow x^2 - 4x = 2^5 = 32$" },
        { "tipe": "paragraph", "text": "$x^2 - 4x - 32 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 8)(x + 4) = 0 \\Rightarrow x = 8$ atau $x = -4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2^{x} > 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^x > 16 = 2^4$" },
        { "tipe": "paragraph", "text": "Karena basis $2 > 1$, tanda pertidaksamaan tetap" },
        { "tipe": "paragraph", "text": "$x > 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal sebesar Rp1.000.000,00 dibungakan majemuk 10% per tahun. Besar modal setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp1.100.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.200.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.210.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.220.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.300.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus bunga majemuk: $M_n = M_0(1 + i)^n$" },
        { "tipe": "paragraph", "text": "$M_2 = 1.000.000(1 + 0{,}1)^2 = 1.000.000(1{,}1)^2$" },
        { "tipe": "paragraph", "text": "$= 1.000.000 \\times 1{,}21 = 1.210.000$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
