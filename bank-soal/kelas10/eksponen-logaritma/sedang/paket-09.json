{
  "id": "bs-k10-eks-sedang-09",
  "nama": "Bank Soal Sedang - Paket 9",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{2x-3} = 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{2x-3} = 27 = 3^3$" },
        { "tipe": "paragraph", "text": "$2x - 3 = 3 \\Rightarrow 2x = 6 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(4x - 4) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(4x - 4) = 3 \\Rightarrow 4x - 4 = 2^3 = 8$" },
        { "tipe": "paragraph", "text": "$4x = 12 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x+1} = 4^{x-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x+1} = (2^2)^{x-2} = 2^{2x-4}$" },
        { "tipe": "paragraph", "text": "$x + 1 = 2x - 4 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 36 - {}^3\\log 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 36 - {}^3\\log 4 = {}^3\\log\\left(\\dfrac{36}{4}\\right) = {}^3\\log 9$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^2 = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 8 = {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{x^2 - 2x - 3} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{x^2 - 2x - 3} = 1 = 3^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 3 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 3)(x + 1) = 0 \\Rightarrow x = 3$ atau $x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(x^2 - 3x + 3) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log(x^2 - 3x + 3) = 1 \\Rightarrow x^2 - 3x + 3 = 3$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x = 0$" },
        { "tipe": "paragraph", "text": "$x(x - 3) = 0 \\Rightarrow x = 0$ atau $x = 3$" },
        { "tipe": "paragraph", "text": "Kedua nilai memenuhi syarat numerus $x^2 - 3x + 3 > 0$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{3}\\right)^{x} < \\dfrac{1}{27}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{3}\\right)^x < \\dfrac{1}{27} = \\left(\\dfrac{1}{3}\\right)^3$" },
        { "tipe": "paragraph", "text": "Karena basis $\\dfrac{1}{3} < 1$, tanda berbalik: $x > 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi khamir berlipat ganda setiap 4 jam. Jika mula-mula ada 150 khamir, maka setelah 12 jam populasinya menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$450$" } ],
        [ { "tipe": "paragraph", "text": "$600$" } ],
        [ { "tipe": "paragraph", "text": "$900$" } ],
        [ { "tipe": "paragraph", "text": "$1.200$" } ],
        [ { "tipe": "paragraph", "text": "$1.800$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak periode: $n = \\dfrac{12}{4} = 3$" },
        { "tipe": "paragraph", "text": "$P = 150 \\times 2^3 = 150 \\times 8 = 1.200$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
