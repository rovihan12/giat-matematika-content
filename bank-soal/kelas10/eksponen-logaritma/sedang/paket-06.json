{
  "id": "bs-k10-eks-sedang-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x+4} = 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x+4} = 16 = 2^4$" },
        { "tipe": "paragraph", "text": "$x + 4 = 4 \\Rightarrow x = 0$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(5x - 1) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(5x - 1) = 3 \\Rightarrow 5x - 1 = 2^3 = 8$" },
        { "tipe": "paragraph", "text": "$5x = 9 \\Rightarrow x = \\dfrac{9}{5}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $8^{x-1} = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$8^{x-1} = 4 \\Rightarrow (2^3)^{x-1} = 2^2$" },
        { "tipe": "paragraph", "text": "$3(x-1) = 2 \\Rightarrow 3x - 3 = 2 \\Rightarrow 3x = 5$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{5}{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 48 - {}^2\\log 6 + {}^2\\log 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 48 - {}^2\\log 6 + {}^2\\log 2 = {}^2\\log\\left(\\dfrac{48 \\cdot 2}{6}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 16 = {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 4 \\cdot {}^4\\log 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 4 \\cdot {}^4\\log 27 = {}^3\\log 27$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $6^{x^2 - x} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$6^{x^2 - x} = 1 = 6^0$" },
        { "tipe": "paragraph", "text": "$x^2 - x = 0$" },
        { "tipe": "paragraph", "text": "$x(x - 1) = 0 \\Rightarrow x = 0$ atau $x = 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log 3 \\cdot {}^3\\log 25$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^5\\log 3 \\cdot {}^3\\log 25 = {}^5\\log 25$" },
        { "tipe": "paragraph", "text": "$= {}^5\\log 5^2 = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 3x) = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 3x) = 2 \\Rightarrow x^2 - 3x = 2^2 = 4$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) = 0 \\Rightarrow x = 4$ atau $x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $5^{x} < 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5^x < 125 = 5^3$" },
        { "tipe": "paragraph", "text": "Karena basis $5 > 1$, tanda tetap: $x < 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp1.500.000,00 dibungakan majemuk 8% per tahun. Besar modal setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp1.620.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.700.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.749.600,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.750.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.800.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$M_n = M_0(1 + i)^n$" },
        { "tipe": "paragraph", "text": "$M_2 = 1.500.000(1 + 0{,}08)^2 = 1.500.000(1{,}08)^2$" },
        { "tipe": "paragraph", "text": "$= 1.500.000 \\times 1{,}1664 = 1.749.600$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
