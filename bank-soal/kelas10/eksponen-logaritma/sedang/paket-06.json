{
  "id": "bs-k10-eks-sedang-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x+4} = 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $2^{x+4} = 16$. Kita harus mencari nilai $x$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m = a^n$ dengan basis $a$ sama (dan $a > 0$, $a \\neq 1$), maka pangkatnya harus sama: $m = n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bilangan di ruas kanan ($16$) menjadi bentuk bilangan berpangkat dengan basis $2$ ($16 = 2^4$)." },
        { "tipe": "paragraph", "text": "$2^{x+4} = 2^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x + 4 = 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$x = 4 - 4 = 0$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 0$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(5x - 1) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(5x - 1) = 3$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$5x - 1 = 2^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai perpangkatan pada ruas kanan ($2^3 = 8$)." },
        { "tipe": "paragraph", "text": "$5x - 1 = 8$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mendapatkan nilai $x$." },
        { "tipe": "paragraph", "text": "$5x = 8 + 1$" },
        { "tipe": "paragraph", "text": "$5x = 9 \\Rightarrow x = \\dfrac{9}{5}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Pastikan numerus bernilai positif ($5x - 1 > 0$). Untuk $x = \\dfrac{9}{5}$, diperoleh $5\\left(\\dfrac{9}{5}\\right) - 1 = 8 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = \\dfrac{9}{5}$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $8^{x-1} = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $8^{x-1} = 4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan $(a^m)^n = a^{m \\cdot n}$ dan penyamaan basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah basis kedua ruas menjadi basis yang sama, yaitu $2$ ($8 = 2^3$ dan $4 = 2^2$)." },
        { "tipe": "paragraph", "text": "$(2^3)^{x-1} = 2^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan pangkat di dalam dan di luar kurung pada ruas kiri." },
        { "tipe": "paragraph", "text": "$2^{3(x-1)} = 2^2$" },
        { "tipe": "paragraph", "text": "$2^{3x - 3} = 2^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$3x - 3 = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Selesaikan persamaan linear untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$3x = 2 + 3$" },
        { "tipe": "paragraph", "text": "$3x = 5 \\Rightarrow x = \\dfrac{5}{3}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = \\dfrac{5}{3}$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 48 - {}^2\\log 6 + {}^2\\log 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma dengan basis yang sama (${}^2\\log 48 - {}^2\\log 6 + {}^2\\log 2$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pengurangan (${}^a\\log m - {}^a\\log n = {}^a\\log \\frac{m}{n}$) dan penjumlahan logaritma (${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan seluruh suku logaritma menjadi satu bentuk pecahan." },
        { "tipe": "paragraph", "text": "${}^2\\log 48 - {}^2\\log 6 + {}^2\\log 2 = {}^2\\log \\left(\\dfrac{48 \\cdot 2}{6}\\right)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan bentuk perhitungan di dalam numerus." },
        { "tipe": "paragraph", "text": "$= {}^2\\log \\left(\\dfrac{96}{6}\\right) = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Ubah angka $16$ menjadi $2^4$, lalu gunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 4 \\cdot {}^4\\log 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian dua bentuk logaritma ${}^3\\log 4 \\cdot {}^4\\log 27$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus suku pertama sama dengan basis suku kedua (yaitu $4$)." },
        { "tipe": "paragraph", "text": "${}^3\\log 4 \\cdot {}^4\\log 27 = {}^3\\log 27$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $27$ menjadi bentuk bilangan berpangkat dengan basis $3$ ($27 = 3^3$)." },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $6^{x^2 - x} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $6^{x^2 - x} = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol dipangkatkan nol bernilai $1$ ($a^0 = 1$). Jadi, angka $1$ dapat ditulis sebagai $6^0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan dengan menyamakan basis kedua ruas." },
        { "tipe": "paragraph", "text": "$6^{x^2 - x} = 6^0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x^2 - x = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat dengan mengeluarkan variabel $x$." },
        { "tipe": "paragraph", "text": "$x(x - 1) = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Tentukan nilai $x$ yang memenuhi." },
        { "tipe": "paragraph", "text": "$x = 0$ atau $x = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 0$ atau $x = 1$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log 3 \\cdot {}^3\\log 25$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian dua bentuk logaritma ${}^5\\log 3 \\cdot {}^3\\log 25$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus suku pertama sama dengan basis suku kedua (yaitu $3$)." },
        { "tipe": "paragraph", "text": "${}^5\\log 3 \\cdot {}^3\\log 25 = {}^5\\log 25$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $25$ menjadi bentuk bilangan berpangkat dengan basis $5$ ($25 = 5^2$)." },
        { "tipe": "paragraph", "text": "$= {}^5\\log 5^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 3x) = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(x^2 - 3x) = 2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$x^2 - 3x = 2^2$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x = 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Pindahkan seluruh suku ke ruas kiri untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) = 0$" },
        { "tipe": "paragraph", "text": "Diperoleh $x = 4$ atau $x = -1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Numerus harus bernilai positif ($x^2 - 3x > 0$). Untuk $x = 4$, diperoleh $4^2 - 3(4) = 4 > 0$ (memenuhi). Untuk $x = -1$, diperoleh $(-1)^2 - 3(-1) = 4 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = -1$ atau $x = 4$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $5^{x} < 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pertidaksamaan eksponen $5^x < 125$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m < a^n$ dengan basis $a > 1$, maka tanda pertidaksamaan tetap ($m < n$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah angka $125$ menjadi bentuk bilangan berpangkat dengan basis $5$ ($125 = 5^3$)." },
        { "tipe": "paragraph", "text": "$5^x < 5^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena basis $5 > 1$, tanda pertidaksamaan tetap dan bandingkan pangkatnya." },
        { "tipe": "paragraph", "text": "$x < 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x < 3$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modal Rp1.500.000,00 dibungakan majemuk 8% per tahun. Besar modal setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp1.620.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.700.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.749.600,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.750.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp1.800.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Modal awal ($M_0$) = $\\text{Rp}1.500.000$, suku bunga ($i$) = $8\\% = 0{,}08$ per tahun, dan periode waktu ($n$) = $2$ tahun." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Rumus pertumbuhan eksponensial untuk bunga majemuk $M_n = M_0(1 + i)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Substitusikan nilai yang diketahui ke dalam rumus bunga majemuk." },
        { "tipe": "paragraph", "text": "$M_2 = 1.500.000(1 + 0{,}08)^2$" },
        { "tipe": "paragraph", "text": "$M_2 = 1.500.000(1{,}08)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai pangkat dari faktor pengali $(1{,}08)^2$." },
        { "tipe": "paragraph", "text": "$(1{,}08)^2 = 1{,}1664$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kalikan hasil tersebut dengan modal awal untuk mendapatkan besar modal akhir." },
        { "tipe": "paragraph", "text": "$M_2 = 1.500.000 \\times 1{,}1664 = 1.749.600$" },
        { "tipe": "paragraph", "text": "Jadi, besar modal setelah $2$ tahun adalah $\\text{Rp}1.749.600{,}00$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
