        [ { "tipe": "paragraph", "text": "$400$" } ],
        [ { "tipe": "paragraph", "text": "$500$" } ],
        [ { "tipe": "paragraph", "text": "$600$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak periode: $n = \\dfrac{12}{4} = 3$" },
        { "tipe": "paragraph", "text": "$P = 50 \\times 2^3 = 50 \\times 8 = 400$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}