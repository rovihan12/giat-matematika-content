{
  "id": "bs-k10-eks-sedang-04",
  "nama": "Bank Soal Sedang - Paket 4",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x+2} = 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x+2} = 32 = 2^5$" },
        { "tipe": "paragraph", "text": "$x + 2 = 5 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^3\\log(2x + 1) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log(2x + 1) = 3 \\Rightarrow 2x + 1 = 3^3 = 27$" },
        { "tipe": "paragraph", "text": "$2x = 26 \\Rightarrow x = 13$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 20 - {}^2\\log 5 + {}^2\\log 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 20 - {}^2\\log 5 + {}^2\\log 4 = {}^2\\log\\left(\\dfrac{20 \\cdot 4}{5}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 16 = {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 5 \\cdot {}^5\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 5 \\cdot {}^5\\log 16 = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{x^2 - 4x} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -4$ atau $x = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{x^2 - 4x} = 1 = 3^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 4x = 0$" },
        { "tipe": "paragraph", "text": "$x(x - 4) = 0 \\Rightarrow x = 0$ atau $x = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 2x) = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -4$ atau $x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = -4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(x^2 - 2x) = 3 \\Rightarrow x^2 - 2x = 2^3 = 8$" },
        { "tipe": "paragraph", "text": "$x^2 - 2x - 8 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 2) = 0 \\Rightarrow x = 4$ atau $x = -2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $3^{x} > 81$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^x > 81 = 3^4$" },
        { "tipe": "paragraph", "text": "Karena basis $3 > 1$: $x > 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 = {}^2\\log 4$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^2 = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $5^{2x-3} = 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5^{2x-3} = 125 = 5^3$" },
        { "tipe": "paragraph", "text": "$2x - 3 = 3$" },
        { "tipe": "paragraph", "text": "$2x = 6 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tabungan Rp2.000.000,00 dibungakan majemuk 5% per tahun. Besar tabungan setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp2.100.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.200.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.205.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.210.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp2.250.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$M_n = M_0(1 + i)^n$" },
        { "tipe": "paragraph", "text": "$M_2 = 2.000.000(1 + 0{,}05)^2 = 2.000.000(1{,}05)^2$" },
        { "tipe": "paragraph", "text": "$= 2.000.000 \\times 1{,}1025 = 2.205.000$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
