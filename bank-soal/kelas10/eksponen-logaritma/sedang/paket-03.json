      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x-1} = 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$9^{x-1} = 27 \\Rightarrow (3^2)^{x-1} = 3^3$" },
        { "tipe": "paragraph", "text": "$3^{2(x-1)} = 3^3$" },
        { "tipe": "paragraph", "text": "$2(x-1) = 3 \\Rightarrow 2x - 2 = 3$" },
        { "tipe": "paragraph", "text": "$2x = 5 \\Rightarrow x = \\dfrac{5}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
