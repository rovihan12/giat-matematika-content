{
  "id": "bs-k10-eks-sedang-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x+3} = 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{x+3} = 64 = 2^6$" },
        { "tipe": "paragraph", "text": "$x + 3 = 6 \\Rightarrow x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(3x + 1) = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(3x + 1) = 4 \\Rightarrow 3x + 1 = 2^4 = 16$" },
        { "tipe": "paragraph", "text": "$3x = 15 \\Rightarrow x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x-1} = 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$9^{x-1} = 27 \\Rightarrow (3^2)^{x-1} = 3^3$" },
        { "tipe": "paragraph", "text": "$3^{2(x-1)} = 3^3$" },
        { "tipe": "paragraph", "text": "$2(x-1) = 3 \\Rightarrow 2x - 2 = 3$" },
        { "tipe": "paragraph", "text": "$2x = 5 \\Rightarrow x = \\dfrac{5}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 18 - {}^3\\log 2 + {}^3\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 18 - {}^3\\log 2 + {}^3\\log 3 = {}^3\\log\\left(\\dfrac{18 \\cdot 3}{2}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 27 = {}^3\\log 3^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log 2 \\cdot {}^2\\log 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^5\\log 2 \\cdot {}^2\\log 125 = {}^5\\log 125$" },
        { "tipe": "paragraph", "text": "$= {}^5\\log 5^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $7^{x^2 - 5x} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = -5$ atau $x = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$7^{x^2 - 5x} = 1 = 7^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 5x = 0$" },
        { "tipe": "paragraph", "text": "$x(x - 5) = 0 \\Rightarrow x = 0$ atau $x = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^4\\log(x^2 - 3x) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -4$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^4\\log(x^2 - 3x) = 1 \\Rightarrow x^2 - 3x = 4^1 = 4$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) = 0 \\Rightarrow x = 4$ atau $x = -1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{3}\\right)^{2x-1} \\ge 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\le -\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\ge -\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\le \\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\ge \\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\le -1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{3}\\right)^{2x-1} \\ge 9 \\Rightarrow (3^{-1})^{2x-1} \\ge 3^2$" },
        { "tipe": "paragraph", "text": "$3^{-(2x-1)} \\ge 3^2 \\Rightarrow -2x + 1 \\ge 2$" },
        { "tipe": "paragraph", "text": "$-2x \\ge 1 \\Rightarrow x \\le -\\dfrac{1}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = a$ dan ${}^2\\log 5 = b$, maka nilai dari ${}^2\\log 45$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a + b$" } ],
        [ { "tipe": "paragraph", "text": "$2a + b$" } ],
        [ { "tipe": "paragraph", "text": "$a + 2b$" } ],
        [ { "tipe": "paragraph", "text": "$2a + 2b$" } ],
        [ { "tipe": "paragraph", "text": "$a^2 + b$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log(9 \\times 5) = {}^2\\log(3^2 \\times 5)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 3^2 + {}^2\\log 5 = 2 \\cdot {}^2\\log 3 + {}^2\\log 5$" },
        { "tipe": "paragraph", "text": "$= 2a + b$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu zat radioaktif menyusut menjadi setengah dari massa sebelumnya setiap 4 jam. Jika massa awal zat tersebut adalah $80\\text{ gram}$, maka massa zat yang tersisa setelah 12 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$20\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$10\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$5\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}5\\text{ gram}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak periode peluruhan: $n = \\dfrac{12}{4} = 3$" },
        { "tipe": "paragraph", "text": "$M = M_0 \\times \\left(\\dfrac{1}{2}\\right)^n = 80 \\times \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "$= 80 \\times \\dfrac{1}{8} = 10\\text{ gram}$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}