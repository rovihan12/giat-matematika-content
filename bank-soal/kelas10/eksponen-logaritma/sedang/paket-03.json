        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(3x + 1) = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
