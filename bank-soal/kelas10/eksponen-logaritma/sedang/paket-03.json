{
  "id": "bs-k10-eks-sedang-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x+3} = 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $2^{x+3} = 64$. Kita harus mencari nilai $x$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m = a^n$ dengan basis $a$ sama (dan $a > 0$, $a \\neq 1$), maka pangkatnya harus sama: $m = n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah angka $64$ menjadi bentuk bilangan berpangkat dengan basis $2$ ($64 = 2^6$)." },
        { "tipe": "paragraph", "text": "$2^{x+3} = 2^6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat dari kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x + 3 = 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$x = 6 - 3 = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 3$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(3x + 1) = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(3x + 1) = 4$. Kita harus mencari nilai $x$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$3x + 1 = 2^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai perpangkatan pada ruas kanan ($2^4 = 16$)." },
        { "tipe": "paragraph", "text": "$3x + 1 = 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mendapatkan nilai $x$." },
        { "tipe": "paragraph", "text": "$3x = 16 - 1$" },
        { "tipe": "paragraph", "text": "$3x = 15 \\Rightarrow x = \\dfrac{15}{3} = 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 5$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $9^{x-1} = 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $9^{x-1} = 27$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan $(a^m)^n = a^{m \\cdot n}$ dan penyamaan basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah basis $9$ menjadi $3^2$ dan basis $27$ menjadi $3^3$." },
        { "tipe": "paragraph", "text": "$(3^2)^{x-1} = 3^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan pangkat di ruas kiri dengan sifat perpangkatan." },
        { "tipe": "paragraph", "text": "$3^{2(x-1)} = 3^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan pangkat dari kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$2(x - 1) = 3$" },
        { "tipe": "paragraph", "text": "$2x - 2 = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Selesaikan persamaan linear untuk mendapatkan nilai $x$." },
        { "tipe": "paragraph", "text": "$2x = 3 + 2$" },
        { "tipe": "paragraph", "text": "$2x = 5 \\Rightarrow x = \\dfrac{5}{2}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = \\dfrac{5}{2}$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 18 - {}^3\\log 2 + {}^3\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma dengan basis yang sama (${}^3\\log 18 - {}^3\\log 2 + {}^3\\log 3$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pengurangan (${}^a\\log m - {}^a\\log n = {}^a\\log \\frac{m}{n}$) dan penjumlahan logaritma (${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan seluruh suku logaritma menjadi satu bentuk." },
        { "tipe": "paragraph", "text": "${}^3\\log 18 - {}^3\\log 2 + {}^3\\log 3 = {}^3\\log \\left(\\dfrac{18 \\cdot 3}{2}\\right)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan bentuk perhitungan di dalam numerus." },
        { "tipe": "paragraph", "text": "$= {}^3\\log \\left(\\dfrac{54}{2}\\right) = {}^3\\log 27$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Ubah angka $27$ menjadi $3^3$, lalu gunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^3 = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log 2 \\cdot {}^2\\log 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian dua bentuk logaritma ${}^5\\log 2 \\cdot {}^2\\log 125$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus suku pertama sama dengan basis suku kedua (yaitu $2$)." },
        { "tipe": "paragraph", "text": "${}^5\\log 2 \\cdot {}^2\\log 125 = {}^5\\log 125$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $125$ menjadi bentuk bilangan berpangkat dengan basis $5$ ($125 = 5^3$)." },
        { "tipe": "paragraph", "text": "$= {}^5\\log 5^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $7^{x^2 - 5x} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = -5$ atau $x = 0$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $7^{x^2 - 5x} = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol dipangkatkan nol bernilai $1$ ($a^0 = 1$). Jadi, angka $1$ dapat ditulis sebagai $7^0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan dengan menyamakan basis kedua ruas." },
        { "tipe": "paragraph", "text": "$7^{x^2 - 5x} = 7^0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x^2 - 5x = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat dengan mengeluarkan variabel $x$." },
        { "tipe": "paragraph", "text": "$x(x - 5) = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Tentukan nilai $x$ yang memenuhi." },
        { "tipe": "paragraph", "text": "$x = 0$ atau $x = 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 0$ atau $x = 5$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^4\\log(x^2 - 3x) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = -4$ atau $x = 1$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^4\\log(x^2 - 3x) = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$x^2 - 3x = 4^1$" },
        { "tipe": "paragraph", "text": "$x^2 - 3x = 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Pindahkan seluruh suku ke ruas kiri untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$x^2 - 3x - 4 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 4)(x + 1) = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Dapatkan nilai $x$ dari masing-masing faktor." },
        { "tipe": "paragraph", "text": "$x = 4$ atau $x = -1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = -1$ atau $x = 4$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{3}\\right)^{2x-1} \\ge 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\le -\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\ge -\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\le \\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\ge \\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\le -1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pertidaksamaan eksponen $\\left(\\dfrac{1}{3}\\right)^{2x-1} \\ge 9$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif $\\dfrac{1}{a} = a^{-1}$ serta sifat pertidaksamaan eksponen untuk basis $a > 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk pecahan $\\dfrac{1}{3}$ menjadi $3^{-1}$ dan angka $9$ menjadi $3^2$ agar kedua ruas memiliki basis $3$." },
        { "tipe": "paragraph", "text": "$(3^{-1})^{2x-1} \\ge 3^2$" },
        { "tipe": "paragraph", "text": "$3^{-(2x-1)} \\ge 3^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena basis $3 > 1$, tanda pertidaksamaan tetap dan bandingkan pangkatnya." },
        { "tipe": "paragraph", "text": "$-(2x - 1) \\ge 2$" },
        { "tipe": "paragraph", "text": "$-2x + 1 \\ge 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan pertidaksamaan linear." },
        { "tipe": "paragraph", "text": "$-2x \\ge 2 - 1$" },
        { "tipe": "paragraph", "text": "$-2x \\ge 1$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Bagi kedua ruas dengan $-2$ (ingat: tanda pertidaksamaan berbalik arah saat dibagi bilangan negatif)." },
        { "tipe": "paragraph", "text": "$x \\le -\\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x \\le -\\dfrac{1}{2}$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika ${}^2\\log 3 = a$ dan ${}^2\\log 5 = b$, maka nilai dari ${}^2\\log 45$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a + b$" } ],
        [ { "tipe": "paragraph", "text": "$2a + b$" } ],
        [ { "tipe": "paragraph", "text": "$a + 2b$" } ],
        [ { "tipe": "paragraph", "text": "$2a + 2b$" } ],
        [ { "tipe": "paragraph", "text": "$a^2 + b$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> ${}^2\\log 3 = a$ dan ${}^2\\log 5 = b$. Kita harus mencari nilai ${}^2\\log 45$ dalam bentuk $a$ dan $b$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian logaritma (${}^a\\log(m \\cdot n) = {}^a\\log m + {}^a\\log n$) dan sifat perpangkatan (${}^a\\log m^n = n \\cdot {}^a\\log m$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Uraikan angka $45$ menjadi faktorisasi prima ($45 = 9 \\times 5 = 3^2 \\times 5$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log(3^2 \\times 5)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Uraikan bentuk perkalian di dalam numerus menjadi penjumlahan logaritma." },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = {}^2\\log 3^2 + {}^2\\log 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Turunkan pangkat $2$ pada suku pertama ke depan." },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = 2 \\cdot {}^2\\log 3 + {}^2\\log 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Substitusikan nilai $a$ dan $b$ yang diketahui." },
        { "tipe": "paragraph", "text": "${}^2\\log 45 = 2a + b$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2a + b$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu zat radioaktif menyusut menjadi setengah dari massa sebelumnya setiap 4 jam. Jika massa awal zat tersebut adalah $80\\text{ gram}$, maka massa zat yang tersisa setelah 12 jam adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$20\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$10\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$5\\text{ gram}$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}5\\text{ gram}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Massa awal ($M_0$) = $80\\text{ gram}$, faktor peluruhan ($r$) = $\\dfrac{1}{2}$ setiap $4$ jam, dan total waktu = $12$ jam." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Rumus peluruhan eksponensial $M_n = M_0 \\times \\left(\\dfrac{1}{2}\\right)^n$, dengan $n = \\dfrac{\\text{waktu total}}{\\text{waktu paruh}}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Hitung banyaknya periode peluruhan ($n$) selama $12$ jam." },
        { "tipe": "paragraph", "text": "$n = \\dfrac{12}{4} = 3\\text{ periode}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $M_0$ dan $n$ ke dalam rumus peluruhan." },
        { "tipe": "paragraph", "text": "$M_3 = 80 \\times \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Hitung nilai perpangkatan dan kalikan dengan massa awal." },
        { "tipe": "paragraph", "text": "$M_3 = 80 \\times \\dfrac{1}{8} = 10\\text{ gram}$" },
        { "tipe": "paragraph", "text": "Jadi, massa zat yang tersisa setelah $12$ jam adalah $10\\text{ gram}$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
