{
  "id": "bs-k10-eks-sedang-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $2^{x-3} = 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $2^{x-3} = 32$. Kita harus mencari nilai $x$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m = a^n$ dengan basis $a$ sama (dan $a > 0$, $a \\neq 1$), maka pangkatnya harus sama: $m = n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bilangan di ruas kanan ($32$) menjadi bentuk bilangan berpangkat dengan basis $2$ ($32 = 2^5$)." },
        { "tipe": "paragraph", "text": "$2^{x-3} = 2^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x - 3 = 5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$x = 5 + 3 = 8$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 8$ (pilihan keempat)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(5x - 2) = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{18}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{14}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(5x - 2) = 4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$5x - 2 = 2^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai perpangkatan pada ruas kanan ($2^4 = 16$)." },
        { "tipe": "paragraph", "text": "$5x - 2 = 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mendapatkan nilai $x$." },
        { "tipe": "paragraph", "text": "$5x = 16 + 2$" },
        { "tipe": "paragraph", "text": "$5x = 18 \\Rightarrow x = \\dfrac{18}{5}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Pastikan numerus bernilai positif ($5x - 2 > 0$). Untuk $x = \\dfrac{18}{5}$, diperoleh $5\\left(\\dfrac{18}{5}\\right) - 2 = 16 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = \\dfrac{18}{5}$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $8^{x+1} = 16^{x-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $8^{x+1} = 16^{x-1}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan $(a^m)^n = a^{m \\cdot n}$ dan penyamaan basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah basis kedua ruas menjadi basis yang sama, yaitu $2$ ($8 = 2^3$ dan $16 = 2^4$)." },
        { "tipe": "paragraph", "text": "$(2^3)^{x+1} = (2^4)^{x-1}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan pangkat di dalam dan di luar kurung pada masing-masing ruas." },
        { "tipe": "paragraph", "text": "$2^{3(x+1)} = 2^{4(x-1)}$" },
        { "tipe": "paragraph", "text": "$2^{3x + 3} = 2^{4x - 4}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$3x + 3 = 4x - 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kelompokkan suku sejenis untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$3 + 4 = 4x - 3x$" },
        { "tipe": "paragraph", "text": "$7 = x \\Rightarrow x = 7$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 7$ (pilihan kelima)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 72 - {}^2\\log 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pengurangan dua logaritma dengan basis yang sama (${}^2\\log 72 - {}^2\\log 9$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pengurangan logaritma ${}^a\\log m - {}^a\\log n = {}^a\\log \\left(\\dfrac{m}{n}\\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan pengurangan logaritma menjadi bentuk pembagian numerus." },
        { "tipe": "paragraph", "text": "${}^2\\log 72 - {}^2\\log 9 = {}^2\\log\\left(\\dfrac{72}{9}\\right)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan hasil pembagian di dalam numerus." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 8$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Ubah angka $8$ menjadi $2^3$, lalu gunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^3 = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 5 \\cdot {}^5\\log 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian dua bentuk logaritma ${}^3\\log 5 \\cdot {}^5\\log 9$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus suku pertama sama dengan basis suku kedua (yaitu $5$)." },
        { "tipe": "paragraph", "text": "${}^3\\log 5 \\cdot {}^5\\log 9 = {}^3\\log 9$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $9$ menjadi bentuk bilangan berpangkat dengan basis $3$ ($9 = 3^2$)." },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x^2 - 5x + 6} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $4^{x^2 - 5x + 6} = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol dipangkatkan nol bernilai $1$ ($a^0 = 1$). Jadi, angka $1$ dapat ditulis sebagai $4^0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan dengan menyamakan basis kedua ruas." },
        { "tipe": "paragraph", "text": "$4^{x^2 - 5x + 6} = 4^0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 3) = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Tentukan nilai $x$ yang memenuhi." },
        { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 2$ atau $x = 3$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian tiga suku logaritma berantai ${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 16$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus dan basis suku yang berdekatan saling sama ($3$ dan $5$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 5 \\cdot {}^5\\log 16 = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $16$ menjadi bentuk bilangan berpangkat dengan basis $2$ ($16 = 2^4$)." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x^2 - 5x + 6) = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 0$ atau $x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(x^2 - 5x + 6) = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 = 2^1$" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Pindahkan seluruh suku ke ruas kiri untuk membentuk persamaan kuadrat." },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 - 2 = 0$" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 4 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 1)(x - 4) = 0$" },
        { "tipe": "paragraph", "text": "Diperoleh $x = 1$ atau $x = 4$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Numerus harus bernilai positif ($x^2 - 5x + 6 > 0$). Untuk $x = 1$, diperoleh $1^2 - 5(1) + 6 = 2 > 0$ (memenuhi). Untuk $x = 4$, diperoleh $4^2 - 5(4) + 6 = 2 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 1$ atau $x = 4$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{2}\\right)^{x} \\leq \\dfrac{1}{32}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq -5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -5$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pertidaksamaan eksponen $\\left(\\dfrac{1}{2}\\right)^x \\leq \\dfrac{1}{32}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan dan sifat pertidaksamaan eksponen untuk basis pecahan antara $0$ dan $1$ ($0 < a < 1$): jika $a^m \\leq a^n$, maka tanda pertidaksamaan berbalik menjadi $m \\geq n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{32}$ menjadi bentuk perpangkatan dengan basis $\\dfrac{1}{2}$ (karena $\\dfrac{1}{32} = \\left(\\dfrac{1}{2}\\right)^5$)." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^x \\leq \\left(\\dfrac{1}{2}\\right)^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena basisnya berupa pecahan antara $0$ dan $1$ (yaitu $\\dfrac{1}{2}$), tanda pertidaksamaan harus dibalik saat membandingkan pangkatnya." },
        { "tipe": "paragraph", "text": "$x \\geq 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x \\geq 5$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tabungan Rp3.200.000,00 dibungakan majemuk 5% per tahun. Besar tabungan setelah 2 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp3.360.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp3.500.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp3.528.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp3.600.000,00" } ],
        [ { "tipe": "paragraph", "text": "Rp3.700.000,00" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Modal awal ($M_0$) = $\\text{Rp}3.200.000$, suku bunga ($i$) = $5\\% = 0{,}05$ per tahun, dan periode waktu ($n$) = $2$ tahun." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Rumus pertumbuhan eksponensial untuk bunga majemuk $M_n = M_0(1 + i)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Substitusikan nilai yang diketahui ke dalam rumus bunga majemuk." },
        { "tipe": "paragraph", "text": "$M_2 = 3.200.000(1 + 0{,}05)^2$" },
        { "tipe": "paragraph", "text": "$M_2 = 3.200.000(1{,}05)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai pangkat dari faktor pengali $(1{,}05)^2$." },
        { "tipe": "paragraph", "text": "$(1{,}05)^2 = 1{,}1025$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Kalikan hasil tersebut dengan modal awal untuk mendapatkan besar tabungan akhir." },
        { "tipe": "paragraph", "text": "$M_2 = 3.200.000 \\times 1{,}1025 = 3.528.000$" },
        { "tipe": "paragraph", "text": "Jadi, besar tabungan setelah $2$ tahun adalah $\\text{Rp}3.528.000{,}00$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
