{
  "id": "bs-k10-eks-sedang-15",
  "nama": "Bank Soal Sedang - Paket 15",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-15-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $7^{2x-3} = 49$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$7^{2x-3} = 49 = 7^2$" },
        { "tipe": "paragraph", "text": "$2x - 3 = 2 \\Rightarrow 2x = 5 \\Rightarrow x = \\dfrac{5}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(3x + 4) = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{28}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{26}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log(3x + 4) = 5 \\Rightarrow 3x + 4 = 2^5 = 32$" },
        { "tipe": "paragraph", "text": "$3x = 28 \\Rightarrow x = \\dfrac{28}{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x+3} = 8^{x-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4^{x+3} = 8^{x-1} \\Rightarrow (2^2)^{x+3} = (2^3)^{x-1}$" },
        { "tipe": "paragraph", "text": "$2x + 6 = 3x - 3 \\Rightarrow x = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 80 - {}^2\\log 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 80 - {}^2\\log 5 = {}^2\\log\\left(\\dfrac{80}{5}\\right) = {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5 = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{x^2 - 5x + 6} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{x^2 - 5x + 6} = 1 = 3^0$" },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 = 0$" },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 3) = 0 \\Rightarrow x = 2$ atau $x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log 2 \\cdot {}^2\\log 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^5\\log 2 \\cdot {}^2\\log 125 = {}^5\\log 125$" },
        { "tipe": "paragraph", "text": "$= {}^5\\log 5^3 = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-2) + {}^2\\log(x+3) = {}^2\\log 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Syarat: $x > 2$" },
        { "tipe": "paragraph", "text": "${}^2\\log[(x-2)(x+3)] = {}^2\\log 6$" },
        { "tipe": "paragraph", "text": "$(x-2)(x+3) = 6 \\Rightarrow x^2 + x - 6 = 6$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0 \\Rightarrow (x+4)(x-3) = 0$" },
        { "tipe": "paragraph", "text": "Karena $x > 2$, maka $x = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{2}\\right)^{x} \\geq \\dfrac{1}{8}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^x \\geq \\dfrac{1}{8} = \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "Karena basis $\\dfrac{1}{2} < 1$, tanda berbalik: $x \\leq 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi bakteri berlipat ganda setiap 6 jam. Jika mula-mula ada 200 bakteri, maka setelah 24 jam populasinya menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$800$" } ],
        [ { "tipe": "paragraph", "text": "$1.600$" } ],
        [ { "tipe": "paragraph", "text": "$2.400$" } ],
        [ { "tipe": "paragraph", "text": "$3.200$" } ],
        [ { "tipe": "paragraph", "text": "$4.800$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Banyak periode: $n = \\dfrac{24}{6} = 4$" },
        { "tipe": "paragraph", "text": "$P = 200 \\times 2^4 = 200 \\times 16 = 3.200$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
