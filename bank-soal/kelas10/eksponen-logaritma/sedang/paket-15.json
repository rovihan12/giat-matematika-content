{
  "id": "bs-k10-eks-sedang-15",
  "nama": "Bank Soal Sedang - Paket 15",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang persamaan eksponen, logaritma, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-s-15-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $7^{2x-3} = 49$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $7^{2x-3} = 49$. Kita harus mencari nilai $x$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Jika $a^m = a^n$ dengan basis $a$ sama (dan $a > 0$, $a \\neq 1$), maka pangkatnya harus sama: $m = n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bilangan di ruas kanan ($49$) menjadi bentuk bilangan berpangkat dengan basis $7$ ($49 = 7^2$)." },
        { "tipe": "paragraph", "text": "$7^{2x-3} = 7^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$2x - 3 = 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$2x = 2 + 3$" },
        { "tipe": "paragraph", "text": "$2x = 5 \\Rightarrow x = \\dfrac{5}{2}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{5}{2}$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(3x + 4) = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{28}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{26}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(3x + 4) = 5$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi logaritma ${}^a\\log b = c \\Leftrightarrow b = a^c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan logaritma ke dalam bentuk eksponen." },
        { "tipe": "paragraph", "text": "$3x + 4 = 2^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai perpangkatan pada ruas kanan ($2^5 = 32$)." },
        { "tipe": "paragraph", "text": "$3x + 4 = 32$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan linear untuk mendapatkan nilai $x$." },
        { "tipe": "paragraph", "text": "$3x = 32 - 4$" },
        { "tipe": "paragraph", "text": "$3x = 28 \\Rightarrow x = \\dfrac{28}{3}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4 (Uji Syarat Numerus):</strong> Pastikan numerus bernilai positif ($3x + 4 > 0$). Untuk $x = \\dfrac{28}{3}$, diperoleh $3\\left(\\dfrac{28}{3}\\right) + 4 = 32 > 0$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{28}{3}$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $4^{x+3} = 8^{x-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $4^{x+3} = 8^{x-1}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan $(a^m)^n = a^{m \\cdot n}$ dan penyamaan basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah basis kedua ruas menjadi basis yang sama, yaitu $2$ ($4 = 2^2$ dan $8 = 2^3$)." },
        { "tipe": "paragraph", "text": "$(2^2)^{x+3} = (2^3)^{x-1}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan pangkat di dalam dan di luar kurung pada masing-masing ruas." },
        { "tipe": "paragraph", "text": "$2^{2(x+3)} = 2^{3(x-1)}$" },
        { "tipe": "paragraph", "text": "$2^{2x + 6} = 2^{3x - 3}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$2x + 6 = 3x - 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Kelompokkan suku sejenis untuk mencari nilai $x$." },
        { "tipe": "paragraph", "text": "$6 + 3 = 3x - 2x$" },
        { "tipe": "paragraph", "text": "$9 = x \\Rightarrow x = 9$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 9$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 80 - {}^2\\log 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pengurangan dua logaritma dengan basis yang sama (${}^2\\log 80 - {}^2\\log 5$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pengurangan logaritma ${}^a\\log m - {}^a\\log n = {}^a\\log \\left(\\dfrac{m}{n}\\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan pengurangan logaritma menjadi bentuk pembagian numerus." },
        { "tipe": "paragraph", "text": "${}^2\\log 80 - {}^2\\log 5 = {}^2\\log\\left(\\dfrac{80}{5}\\right)$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan hasil pembagian di dalam numerus." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 16$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Ubah angka $16$ menjadi $2^4$, lalu gunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^4 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian tiga suku logaritma berantai ${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 32$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c \\cdot {}^c\\log d = {}^a\\log d$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus dan basis suku yang berdekatan saling sama ($3$ dan $4$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 3 \\cdot {}^3\\log 4 \\cdot {}^4\\log 32 = {}^2\\log 32$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $32$ menjadi bentuk bilangan berpangkat dengan basis $2$ ($32 = 2^5$)." },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5$ (pilihan ketiga)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3^{x^2 - 5x + 6} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 6$" } ],
        [ { "tipe": "paragraph", "text": "$x = -2$ atau $x = -3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = -1$ atau $x = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan eksponen $3^{x^2 - 5x + 6} = 1$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol dipangkatkan nol bernilai $1$ ($a^0 = 1$). Jadi, angka $1$ dapat ditulis sebagai $3^0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk persamaan dengan menyamakan basis kedua ruas." },
        { "tipe": "paragraph", "text": "$3^{x^2 - 5x + 6} = 3^0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Samakan pangkat pada kedua ruas karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$x^2 - 5x + 6 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x - 2)(x - 3) = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Tentukan nilai $x$ yang memenuhi." },
        { "tipe": "paragraph", "text": "$x = 2$ atau $x = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 2$ atau $x = 3$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log 2 \\cdot {}^2\\log 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian dua bentuk logaritma ${}^5\\log 2 \\cdot {}^2\\log 125$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian berantai logaritma ${}^a\\log b \\cdot {}^b\\log c = {}^a\\log c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat perkalian berantai logaritma karena numerus suku pertama sama dengan basis suku kedua (yaitu $2$)." },
        { "tipe": "paragraph", "text": "${}^5\\log 2 \\cdot {}^2\\log 125 = {}^5\\log 125$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $125$ menjadi bentuk bilangan berpangkat dengan basis $5$ ($125 = 5^3$)." },
        { "tipe": "paragraph", "text": "$= {}^5\\log 5^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan kedua)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi ${}^2\\log(x-2) + {}^2\\log(x+3) = {}^2\\log 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x = 3$" } ],
        [ { "tipe": "paragraph", "text": "$x = 4$" } ],
        [ { "tipe": "paragraph", "text": "$x = 2$" } ],
        [ { "tipe": "paragraph", "text": "$x = 5$" } ],
        [ { "tipe": "paragraph", "text": "$x = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Persamaan logaritma ${}^2\\log(x-2) + {}^2\\log(x+3) = {}^2\\log 6$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan logaritma ${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$ serta uji syarat numerus." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan syarat numerus agar terdefinisi ($x - 2 > 0 \\Rightarrow x > 2$ dan $x + 3 > 0 \\Rightarrow x > -3$, sehingga syarat utamanya $x > 2$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gabungkan penjumlahan logaritma di ruas kiri." },
        { "tipe": "paragraph", "text": "${}^2\\log[(x-2)(x+3)] = {}^2\\log 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Samakan numerus pada kedua ruas." },
        { "tipe": "paragraph", "text": "$(x - 2)(x + 3) = 6$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 6 = 6$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan persamaan kuadrat tersebut." },
        { "tipe": "paragraph", "text": "$(x + 4)(x - 3) = 0$" },
        { "tipe": "paragraph", "text": "Diperoleh $x = -4$ atau $x = 3$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 5 (Uji Syarat):</strong> Karena syaratnya $x > 2$, nilai $x = -4$ ditolak, sehingga yang memenuhi adalah $x = 3$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x = 3$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\left(\\dfrac{1}{2}\\right)^{x} \\geq \\dfrac{1}{8}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pertidaksamaan eksponen $\\left(\\dfrac{1}{2}\\right)^x \\geq \\dfrac{1}{8}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan dan sifat pertidaksamaan eksponen untuk basis pecahan antara $0$ dan $1$ ($0 < a < 1$): jika $a^m \\geq a^n$, maka tanda pertidaksamaan berbalik menjadi $m \\leq n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{8}$ menjadi bentuk perpangkatan dengan basis $\\dfrac{1}{2}$ (karena $\\dfrac{1}{8} = \\left(\\dfrac{1}{2}\\right)^3$)." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^x \\geq \\left(\\dfrac{1}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena basisnya berupa pecahan antara $0$ dan $1$ (yaitu $\\dfrac{1}{2}$), tanda pertidaksamaan harus dibalik saat membandingkan pangkatnya." },
        { "tipe": "paragraph", "text": "$x \\leq 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $x \\leq 3$ (pilihan pertama)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-eks-s-15-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Populasi bakteri berlipat ganda setiap 6 jam. Jika mula-mula ada 200 bakteri, maka setelah 24 jam populasinya menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$800$" } ],
        [ { "tipe": "paragraph", "text": "$1.600$" } ],
        [ { "tipe": "paragraph", "text": "$2.400$" } ],
        [ { "tipe": "paragraph", "text": "$3.200$" } ],
        [ { "tipe": "paragraph", "text": "$4.800$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Populasi awal ($P_0$) = $200$ bakteri, rasio pertumbuhan ($r$) = $2$ (berlipat ganda) setiap $6$ jam, dan total waktu = $24$ jam." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Rumus pertumbuhan eksponensial $P_n = P_0 \\times r^n$, dengan $n = \\dfrac{\\text{waktu total}}{\\text{waktu per periode}}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Hitung banyaknya periode penggandaan ($n$) selama $24$ jam." },
        { "tipe": "paragraph", "text": "$n = \\dfrac{24}{6} = 4\\text{ periode}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $P_0$, $r$, dan $n$ ke dalam rumus pertumbuhan." },
        { "tipe": "paragraph", "text": "$P_4 = 200 \\times 2^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Hitung perpangkatan dan kalikan dengan populasi awal." },
        { "tipe": "paragraph", "text": "$P_4 = 200 \\times 16 = 3.200$" },
        { "tipe": "paragraph", "text": "Jadi, populasi bakteri setelah $24$ jam adalah $3.200$ (pilihan keempat)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
