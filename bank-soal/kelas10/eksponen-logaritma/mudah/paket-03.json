{
  "id": "bs-k10-eks-mudah-03",
  "nama": "Bank Soal Mudah - Paket 3",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $5^2 \\cdot 5^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^6$" } ],
        [ { "tipe": "paragraph", "text": "$25^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5^2 \\cdot 5^3 = 5^{2+3} = 5^5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{2^9}{2^6}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^{15}$" } ],
        [ { "tipe": "paragraph", "text": "$2^3$" } ],
        [ { "tipe": "paragraph", "text": "$2^{54}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2^9}{2^6} = 2^{9-6} = 2^3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(4^2)^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^5$" } ],
        [ { "tipe": "paragraph", "text": "$4^6$" } ],
        [ { "tipe": "paragraph", "text": "$4^9$" } ],
        [ { "tipe": "paragraph", "text": "$16^6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(4^2)^3 = 4^{2 \\cdot 3} = 4^6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $12^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$-12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$12^0 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $5^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-25$" } ],
        [ { "tipe": "paragraph", "text": "$-10$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5^{-2} = \\dfrac{1}{5^2} = \\dfrac{1}{25}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $10^3 = 1000$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^{10}\\log 1000 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 1000 = 10$" } ],
        [ { "tipe": "paragraph", "text": "${}^{1000}\\log 10 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^{10}\\log 3 = 1000$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $10^3 = 1000$ diperoleh ${}^{10}\\log 1000 = 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 16 = {}^2\\log 2^4 = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^4\\log 2 + {}^4\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^4\\log 10$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 16$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 6$" } ],
        [ { "tipe": "paragraph", "text": "${}^8\\log 16$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^4\\log 2 + {}^4\\log 8 = {}^4\\log (2 \\cdot 8) = {}^4\\log 16$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $8^4 : 8^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8^2$" } ],
        [ { "tipe": "paragraph", "text": "$8^6$" } ],
        [ { "tipe": "paragraph", "text": "$8^8$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{8^4}{8^2} = 8^{4-2} = 8^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{5}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-25$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{25}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{5}\\right)^{-2} = \\dfrac{1}{(1/5)^2} = \\dfrac{1}{1/25} = 25$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
