{
  "id": "bs-k10-eks-mudah-09",
  "nama": "Bank Soal Mudah - Paket 9",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^3 \\cdot 2^2 \\cdot 2^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^5$" } ],
        [ { "tipe": "paragraph", "text": "$2^9$" } ],
        [ { "tipe": "paragraph", "text": "$2^{24}$" } ],
        [ { "tipe": "paragraph", "text": "$8^9$" } ],
        [ { "tipe": "paragraph", "text": "$2^{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^3 \\cdot 2^2 \\cdot 2^4 = 2^{3+2+4} = 2^9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{4^{10}}{4^6 \\cdot 4^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^2$" } ],
        [ { "tipe": "paragraph", "text": "$4^4$" } ],
        [ { "tipe": "paragraph", "text": "$4^8$" } ],
        [ { "tipe": "paragraph", "text": "$4^{18}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{4^{10}}{4^6 \\cdot 4^2} = \\dfrac{4^{10}}{4^8} = 4^{10-8} = 4^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(5^2\\right)^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^6$" } ],
        [ { "tipe": "paragraph", "text": "$5^8$" } ],
        [ { "tipe": "paragraph", "text": "$25^3$" } ],
        [ { "tipe": "paragraph", "text": "$5^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(5^2\\right)^3 = 5^{2 \\cdot 3} = 5^6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{8}\\right)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan tak nol berpangkat nol bernilai 1, sehingga $\\left(\\dfrac{1}{8}\\right)^0 = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{3}{5}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{9}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{25}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{5}\\right)^{-2} = \\left(\\dfrac{5}{3}\\right)^2 = \\dfrac{25}{9}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $8^2 = 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^8\\log 64 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 64 = 8$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 8 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^8\\log 2 = 64$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 2 = 8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $a^c = b$, maka ${}^a\\log b = c$. Dari $8^2 = 64$ diperoleh ${}^8\\log 64 = 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^4\\log \\dfrac{1}{16}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^4\\log \\dfrac{1}{16} = {}^4\\log 4^{-2} = -2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^3\\log 4 + {}^3\\log 6 - {}^3\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 4 + {}^3\\log 6 - {}^3\\log 8 = {}^3\\log\\left(\\dfrac{4 \\cdot 6}{8}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^3\\log 3 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{9^8}{9^2 \\cdot 9^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9^2$" } ],
        [ { "tipe": "paragraph", "text": "$9^4$" } ],
        [ { "tipe": "paragraph", "text": "$9^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$9^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{9^8}{9^2 \\cdot 9^4} = \\dfrac{9^8}{9^6} = 9^{8-6} = 9^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{4}{3}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{9}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{4}{3}\\right)^{-1} = \\dfrac{3}{4}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
