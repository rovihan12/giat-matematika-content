{
  "id": "bs-k10-eks-mudah-09",
  "nama": "Bank Soal Mudah - Paket 9",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^3 \\cdot 2^2 \\cdot 2^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^5$" } ],
        [ { "tipe": "paragraph", "text": "$2^9$" } ],
        [ { "tipe": "paragraph", "text": "$2^{24}$" } ],
        [ { "tipe": "paragraph", "text": "$8^9$" } ],
        [ { "tipe": "paragraph", "text": "$2^3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $2^3 \\cdot 2^2 \\cdot 2^4$. Basis semua bilangan sama, yaitu $2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n \\cdot a^p = a^{m+n+p}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan semua pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$2^{3+2+4} = 2^9$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2^9$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{4^{10}}{4^6 \\cdot 4^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^2$" } ],
        [ { "tipe": "paragraph", "text": "$4^4$" } ],
        [ { "tipe": "paragraph", "text": "$4^8$" } ],
        [ { "tipe": "paragraph", "text": "$4^{18}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $4^{10}$, penyebut $4^6 \\cdot 4^2$. Semua basis bilangan sama, yaitu $4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$4^6 \\cdot 4^2 = 4^{6+2} = 4^8$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{4^{10}}{4^8} = 4^{10-8} = 4^2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4^2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(5^2\\right)^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^6$" } ],
        [ { "tipe": "paragraph", "text": "$5^8$" } ],
        [ { "tipe": "paragraph", "text": "$25^3$" } ],
        [ { "tipe": "paragraph", "text": "$5^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $\\left(5^2\\right)^3$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$5^{2 \\cdot 3} = 5^6$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5^6$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{8}\\right)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan $\\dfrac{1}{8}$ dipangkatkan nol $\\left(\\dfrac{1}{8}\\right)^0$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada pecahan tersebut." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{8}\\right)^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{3}{5}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{9}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{25}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{3}{5}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{5}\\right)^{-2} = \\left(\\dfrac{5}{3}\\right)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung perpangkatan pembilang dan penyebut $\\dfrac{5^2}{3^2} = \\dfrac{25}{9}$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{25}{9}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $8^2 = 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^8\\log 64 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 64 = 8$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 8 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^8\\log 2 = 64$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 2 = 8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $8^2 = 64$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $8$, numerus $64$, dan hasil $2$." },
        { "tipe": "paragraph", "text": "${}^8\\log 64 = 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^8\\log 64 = 2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^4\\log \\dfrac{1}{16}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^4\\log \\dfrac{1}{16}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ serta $\\dfrac{1}{a^n} = a^{-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{16}$ menjadi bentuk perpangkatan dengan basis $4$ ($16 = 4^2$, sehingga $\\dfrac{1}{16} = 4^{-2}$)." },
        { "tipe": "paragraph", "text": "${}^4\\log \\dfrac{1}{16} = {}^4\\log 4^{-2}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= -2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $-2$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^3\\log 4 + {}^3\\log 6 - {}^3\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma ${}^3\\log 4 + {}^3\\log 6 - {}^3\\log 8$ dengan basis yang sama ($3$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan dan pengurangan logaritma ${}^a\\log m + {}^a\\log n - {}^a\\log p = {}^a\\log\\left(\\dfrac{m \\cdot n}{p}\\right)$ serta ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan numerus dengan operasi perkalian dan pembagian." },
        { "tipe": "paragraph", "text": "${}^3\\log\\left(\\dfrac{4 \\cdot 6}{8}\\right) = {}^3\\log\\left(\\dfrac{24}{8}\\right) = {}^3\\log 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "$= 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{9^8}{9^2 \\cdot 9^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9^2$" } ],
        [ { "tipe": "paragraph", "text": "$9^4$" } ],
        [ { "tipe": "paragraph", "text": "$9^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$9^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $9^8$, penyebut $9^2 \\cdot 9^4$. Semua basis bilangan sama, yaitu $9$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$9^2 \\cdot 9^4 = 9^{2+4} = 9^6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{9^8}{9^6} = 9^{8-6} = 9^2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $9^2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{4}{3}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{9}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif satu $\\left(\\dfrac{4}{3}\\right)^{-1}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{4}{3}\\right)^{-1} = \\left(\\dfrac{3}{4}\\right)^1 = \\dfrac{3}{4}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{3}{4}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
