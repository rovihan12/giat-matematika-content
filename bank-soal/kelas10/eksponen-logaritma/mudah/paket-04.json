{
  "id": "bs-k10-eks-mudah-04",
  "nama": "Bank Soal Mudah - Paket 4",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $6^2 \\cdot 6^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^8$" } ],
        [ { "tipe": "paragraph", "text": "$6^6$" } ],
        [ { "tipe": "paragraph", "text": "$36^6$" } ],
        [ { "tipe": "paragraph", "text": "$6^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^{2{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $6^2 \\cdot 6^4$. Basis kedua bilangan sama, yaitu $6$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$6^{2+4} = 6^6$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $6^6$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{9^7}{9^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9^3$" } ],
        [ { "tipe": "paragraph", "text": "$9^{11}$" } ],
        [ { "tipe": "paragraph", "text": "$9^{28}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$9^{1{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembagian bentuk eksponen $\\dfrac{9^7}{9^4}$. Basis kedua bilangan sama, yaitu $9$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "paragraph", "text": "$9^{7-4} = 9^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $9^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(5^3)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^6$" } ],
        [ { "tipe": "paragraph", "text": "$5^9$" } ],
        [ { "tipe": "paragraph", "text": "$25^6$" } ],
        [ { "tipe": "paragraph", "text": "$5^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $(5^3)^2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$5^{3 \\cdot 2} = 5^6$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5^6$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $20^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$-20$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{20}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan $20$ dipangkatkan nol ($20^0$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada bilangan $20$." },
        { "tipe": "paragraph", "text": "$20^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $4^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-64$" } ],
        [ { "tipe": "paragraph", "text": "$-12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan berpangkat negatif $4^{-3}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif $a^{-n} = \\dfrac{1}{a^n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah ke bentuk pecahan dengan pangkat positif." },
        { "tipe": "paragraph", "text": "$4^{-3} = \\dfrac{1}{4^3}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai penyebutnya ($4^3 = 64$)." },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{64}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{1}{64}$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $5^3 = 125$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^5\\log 125 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 125 = 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^{125}\\log 5 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 3 = 125$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 5 = 125$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $5^3 = 125$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $5$, numerus $125$, dan hasil $3$." },
        { "tipe": "paragraph", "text": "${}^5\\log 125 = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^5\\log 125 = 3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^3\\log 9$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ atau mencari bilangan pangkat dari basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah angka $9$ menjadi bentuk perpangkatan dengan basis $3$ ($9 = 3^2$)." },
        { "tipe": "paragraph", "text": "${}^3\\log 9 = {}^3\\log 3^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^5\\log 4 + {}^5\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^5\\log 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 12$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 1$" } ],
        [ { "tipe": "paragraph", "text": "${}^{12}\\log 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Penjumlahan dua logaritma dengan basis yang sama (${}^5\\log 4 + {}^5\\log 3$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan logaritma ${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan kedua numerus karena basis logaritma sudah sama." },
        { "tipe": "paragraph", "text": "${}^5\\log 4 + {}^5\\log 3 = {}^5\\log(4 \\cdot 3) = {}^5\\log 12$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^5\\log 12$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $10^5 : 10^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10^2$" } ],
        [ { "tipe": "paragraph", "text": "$10^8$" } ],
        [ { "tipe": "paragraph", "text": "$10^{15}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$10^{1{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembagian bentuk eksponen $10^5 : 10^3$. Basis kedua bilangan sama, yaitu $10$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "paragraph", "text": "$10^{5-3} = 10^2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $10^2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{4}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{1}{4}\\right)^{-1}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{4}\\right)^{-1} = \\left(\\dfrac{4}{1}\\right)^1 = 4^1$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung hasil perpangkatannya ($4^1 = 4$)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
