{
  "id": "bs-k10-eks-mudah-13",
  "nama": "Bank Soal Mudah - Paket 13",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-13-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $5^4 \\cdot 5^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^7$" } ],
        [ { "tipe": "paragraph", "text": "$5^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$25^7$" } ],
        [ { "tipe": "paragraph", "text": "$5^1$" } ],
        [ { "tipe": "paragraph", "text": "$5^{2{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $5^4 \\cdot 5^3$. Basis kedua bilangan sama, yaitu $5$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$5^{4+3} = 5^7$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5^7$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{2^{15}}{2^6 \\cdot 2^5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^4$" } ],
        [ { "tipe": "paragraph", "text": "$2^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{26}$" } ],
        [ { "tipe": "paragraph", "text": "$1^4$" } ],
        [ { "tipe": "paragraph", "text": "$2^{-4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $2^{15}$, penyebut $2^6 \\cdot 2^5$. Semua basis bilangan sama, yaitu $2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$2^6 \\cdot 2^5 = 2^{6+5} = 2^{11}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{2^{15}}{2^{11}} = 2^{15-11} = 2^4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2^4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(6^3\\right)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^5$" } ],
        [ { "tipe": "paragraph", "text": "$6^6$" } ],
        [ { "tipe": "paragraph", "text": "$6^9$" } ],
        [ { "tipe": "paragraph", "text": "$36^6$" } ],
        [ { "tipe": "paragraph", "text": "$6^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $\\left(6^3\\right)^2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$6^{3 \\cdot 2} = 6^6$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $6^6$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{11}{13}\\right)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan $\\dfrac{11}{13}$ dipangkatkan nol $\\left(\\dfrac{11}{13}\\right)^0$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada pecahan tersebut." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{11}{13}\\right)^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{1}{5}\\right)^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$125$" } ],
        [ { "tipe": "paragraph", "text": "$-125$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{1}{5}\\right)^{-3}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{5}\\right)^{-3} = \\left(\\dfrac{5}{1}\\right)^3 = 5^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung hasil perpangkatannya ($5^3 = 125$)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $125$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $\\left(\\dfrac{1}{3}\\right)^2 = \\dfrac{1}{9}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^{1/3}\\log \\dfrac{1}{9} = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log \\dfrac{1}{9} = \\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "${}^{9}\\log \\dfrac{1}{3} = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^{1/3}\\log 2 = \\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log \\dfrac{1}{3} = 9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $\\left(\\dfrac{1}{3}\\right)^2 = \\dfrac{1}{9}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $\\dfrac{1}{3}$, numerus $\\dfrac{1}{9}$, dan hasil $2$." },
        { "tipe": "paragraph", "text": "${}^{1/3}\\log \\dfrac{1}{9} = 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^{1/3}\\log \\dfrac{1}{9} = 2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^7\\log \\dfrac{1}{49}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^7\\log \\dfrac{1}{49}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ serta $\\dfrac{1}{a^n} = a^{-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{49}$ menjadi bentuk perpangkatan dengan basis $7$ ($49 = 7^2$, sehingga $\\dfrac{1}{49} = 7^{-2}$)." },
        { "tipe": "paragraph", "text": "${}^7\\log \\dfrac{1}{49} = {}^7\\log 7^{-2}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= -2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $-2$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^3\\log 2 + {}^3\\log 9 - {}^3\\log 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma ${}^3\\log 2 + {}^3\\log 9 - {}^3\\log 6$ dengan basis yang sama ($3$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan dan pengurangan logaritma ${}^a\\log m + {}^a\\log n - {}^a\\log p = {}^a\\log\\left(\\dfrac{m \\cdot n}{p}\\right)$ serta ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan numerus dengan operasi perkalian dan pembagian." },
        { "tipe": "paragraph", "text": "${}^3\\log\\left(\\dfrac{2 \\cdot 9}{6}\\right) = {}^3\\log\\left(\\dfrac{18}{6}\\right) = {}^3\\log 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "$= 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{15^8}{15^3 \\cdot 15^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15^3$" } ],
        [ { "tipe": "paragraph", "text": "$15^5$" } ],
        [ { "tipe": "paragraph", "text": "$15^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$15^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $15^8$, penyebut $15^3 \\cdot 15^2$. Semua basis bilangan sama, yaitu $15$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$15^3 \\cdot 15^2 = 15^{3+2} = 15^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{15^8}{15^5} = 15^{8-5} = 15^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $15^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-13-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{7}{2}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{49}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{49}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{49}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{49}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{7}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{7}{2}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{7}{2}\\right)^{-2} = \\left(\\dfrac{2}{7}\\right)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung perpangkatan pembilang dan penyebut $\\dfrac{2^2}{7^2} = \\dfrac{4}{49}$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{4}{49}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
