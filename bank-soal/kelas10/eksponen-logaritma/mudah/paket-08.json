{
  "id": "bs-k10-eks-mudah-08",
  "nama": "Bank Soal Mudah - Paket 8",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3^2 \\cdot 3^4 \\cdot 3^1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^8$" } ],
        [ { "tipe": "paragraph", "text": "$9^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^{2{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $3^2 \\cdot 3^4 \\cdot 3^1$. Basis semua bilangan sama, yaitu $3$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n \\cdot a^p = a^{m+n+p}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan semua pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$3^{2+4+1} = 3^7$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3^7$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{5^{11}}{5^4 \\cdot 5^5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^2$" } ],
        [ { "tipe": "paragraph", "text": "$5^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$5^{20}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$5^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $5^{11}$, penyebut $5^4 \\cdot 5^5$. Semua basis bilangan sama, yaitu $5$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$5^4 \\cdot 5^5 = 5^{4+5} = 5^9$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Lakukan pembagian antara pembilang dan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{5^{11}}{5^9} = 5^{11-9} = 5^2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5^2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(3^3\\right)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^5$" } ],
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^9$" } ],
        [ { "tipe": "paragraph", "text": "$9^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $\\left(3^3\\right)^2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$3^{3 \\cdot 2} = 3^6$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3^6$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $(2x)^0$ untuk $x \\neq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2x$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2x}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk $(2x)^0$ dengan syarat $x \\neq 0$ (sehingga nilai di dalam kurung bukan nol)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada bentuk aljabar tersebut." },
        { "tipe": "paragraph", "text": "$(2x)^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{3}{4}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{9}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{16}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{3}{4}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{4}\\right)^{-2} = \\left(\\dfrac{4}{3}\\right)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung perpangkatan pembilang dan penyebut $\\dfrac{4^2}{3^2} = \\dfrac{16}{9}$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{16}{9}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $4^3 = 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^4\\log 64 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 64 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 4 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 3 = 64$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 3 = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $4^3 = 64$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $4$, numerus $64$, dan hasil $3$." },
        { "tipe": "paragraph", "text": "${}^4\\log 64 = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^4\\log 64 = 3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log \\dfrac{1}{27}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^3\\log \\dfrac{1}{27}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ serta $\\dfrac{1}{a^n} = a^{-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{27}$ menjadi bentuk perpangkatan dengan basis $3$ ($27 = 3^3$, sehingga $\\dfrac{1}{27} = 3^{-3}$)." },
        { "tipe": "paragraph", "text": "${}^3\\log \\dfrac{1}{27} = {}^3\\log 3^{-3}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= -3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $-3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 3 + {}^2\\log 5 - {}^2\\log 15$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma ${}^2\\log 3 + {}^2\\log 5 - {}^2\\log 15$ dengan basis yang sama ($2$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan dan pengurangan logaritma ${}^a\\log m + {}^a\\log n - {}^a\\log p = {}^a\\log\\left(\\dfrac{m \\cdot n}{p}\\right)$ serta ${}^a\\log 1 = 0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan numerus dengan operasi perkalian dan pembagian." },
        { "tipe": "paragraph", "text": "${}^2\\log\\left(\\dfrac{3 \\cdot 5}{15}\\right) = {}^2\\log\\left(\\dfrac{15}{15}\\right) = {}^2\\log 1$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log 1 = 0$." },
        { "tipe": "paragraph", "text": "$= 0$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $0$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{7^9}{7^3 \\cdot 7^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^4$" } ],
        [ { "tipe": "paragraph", "text": "$7^5$" } ],
        [ { "tipe": "paragraph", "text": "$7^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$1^4$" } ],
        [ { "tipe": "paragraph", "text": "$7^{-4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $7^9$, penyebut $7^3 \\cdot 7^2$. Semua basis bilangan sama, yaitu $7$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$7^3 \\cdot 7^2 = 7^{3+2} = 7^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{7^9}{7^5} = 7^{9-5} = 7^4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $7^4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{5}{2}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif satu $\\left(\\dfrac{5}{2}\\right)^{-1}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{5}{2}\\right)^{-1} = \\left(\\dfrac{2}{5}\\right)^1 = \\dfrac{2}{5}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{2}{5}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
