{
  "id": "bs-k10-eks-mudah-08",
  "nama": "Bank Soal Mudah - Paket 8",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3^2 \\cdot 3^4 \\cdot 3^1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^8$" } ],
        [ { "tipe": "paragraph", "text": "$9^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^{2{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^2 \\cdot 3^4 \\cdot 3^1 = 3^{2+4+1} = 3^7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{5^{11}}{5^4 \\cdot 5^5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^2$" } ],
        [ { "tipe": "paragraph", "text": "$5^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$5^{20}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$5^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{5^{11}}{5^4 \\cdot 5^5} = \\dfrac{5^{11}}{5^9} = 5^{11-9} = 5^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(3^3\\right)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^5$" } ],
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^9$" } ],
        [ { "tipe": "paragraph", "text": "$9^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(3^3\\right)^2 = 3^{3 \\cdot 2} = 3^6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $(2x)^0$ untuk $x \\neq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2x$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2x}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan tak nol berpangkat nol bernilai 1, sehingga $(2x)^0 = 1$ untuk $x \\neq 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{3}{4}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{9}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{16}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{4}\\right)^{-2} = \\left(\\dfrac{4}{3}\\right)^2 = \\dfrac{16}{9}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $4^3 = 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^4\\log 64 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 64 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 4 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 3 = 64$" } ],
        [ { "tipe": "paragraph", "text": "${}^{64}\\log 3 = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $a^c = b$, maka ${}^a\\log b = c$. Dari $4^3 = 64$ diperoleh ${}^4\\log 64 = 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log \\dfrac{1}{27}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log \\dfrac{1}{27} = {}^3\\log 3^{-3} = -3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 3 + {}^2\\log 5 - {}^2\\log 15$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 3 + {}^2\\log 5 - {}^2\\log 15 = {}^2\\log\\left(\\dfrac{3 \\cdot 5}{15}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 1 = 0$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{7^9}{7^3 \\cdot 7^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^4$" } ],
        [ { "tipe": "paragraph", "text": "$7^5$" } ],
        [ { "tipe": "paragraph", "text": "$7^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$1^4$" } ],
        [ { "tipe": "paragraph", "text": "$7^{-4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{7^9}{7^3 \\cdot 7^2} = \\dfrac{7^9}{7^5} = 7^{9-5} = 7^4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{5}{2}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{5}{2}\\right)^{-1} = \\dfrac{2}{5}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
