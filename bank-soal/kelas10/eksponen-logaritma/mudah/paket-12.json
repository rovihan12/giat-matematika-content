{
  "id": "bs-k10-eks-mudah-12",
  "nama": "Bank Soal Mudah - Paket 12",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-12-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^7 \\cdot 2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^9$" } ],
        [ { "tipe": "paragraph", "text": "$2^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$4^9$" } ],
        [ { "tipe": "paragraph", "text": "$2^5$" } ],
        [ { "tipe": "paragraph", "text": "$2^{3{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^7 \\cdot 2^2 = 2^{7+2} = 2^9$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{5^{13}}{5^6 \\cdot 5^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^3$" } ],
        [ { "tipe": "paragraph", "text": "$5^{11}$" } ],
        [ { "tipe": "paragraph", "text": "$5^{23}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$5^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{5^{13}}{5^6 \\cdot 5^4} = \\dfrac{5^{13}}{5^{10}} = 5^{13-10} = 5^3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(3^4\\right)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^8$" } ],
        [ { "tipe": "paragraph", "text": "$3^{16}$" } ],
        [ { "tipe": "paragraph", "text": "$9^8$" } ],
        [ { "tipe": "paragraph", "text": "$3^{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(3^4\\right)^2 = 3^{4 \\cdot 2} = 3^8$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{7}{9}\\right)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan tak nol berpangkat nol bernilai 1, sehingga $\\left(\\dfrac{7}{9}\\right)^0 = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{4}{9}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{9}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{81}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{4}{9}\\right)^{-1} = \\dfrac{9}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $3^5 = 243$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^3\\log 243 = 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 243 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^{243}\\log 3 = 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 5 = 243$" } ],
        [ { "tipe": "paragraph", "text": "${}^{243}\\log 5 = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $a^c = b$, maka ${}^a\\log b = c$. Dari $3^5 = 243$ diperoleh ${}^3\\log 243 = 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log \\dfrac{1}{125}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^5\\log \\dfrac{1}{125} = {}^5\\log 5^{-3} = -3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 5 + {}^2\\log 6 - {}^2\\log 15$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 5 + {}^2\\log 6 - {}^2\\log 15 = {}^2\\log\\left(\\dfrac{5 \\cdot 6}{15}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{10^9}{10^4 \\cdot 10^3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10^2$" } ],
        [ { "tipe": "paragraph", "text": "$10^4$" } ],
        [ { "tipe": "paragraph", "text": "$10^{16}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$10^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{10^9}{10^4 \\cdot 10^3} = \\dfrac{10^9}{10^7} = 10^{9-7} = 10^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-12-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{3}{7}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{49}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{49}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{9}{49}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{49}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{7}\\right)^{-2} = \\left(\\dfrac{7}{3}\\right)^2 = \\dfrac{49}{9}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
