{
  "id": "bs-k10-eks-mudah-14",
  "nama": "Bank Soal Mudah - Paket 14",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-14-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $4^2 \\cdot 4^5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^7$" } ],
        [ { "tipe": "paragraph", "text": "$4^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$16^7$" } ],
        [ { "tipe": "paragraph", "text": "$4^3$" } ],
        [ { "tipe": "paragraph", "text": "$4^{2{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4^2 \\cdot 4^5 = 4^{2+5} = 4^7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{3^{14}}{3^5 \\cdot 3^6}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$3^{25}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{3^{14}}{3^5 \\cdot 3^6} = \\dfrac{3^{14}}{3^{11}} = 3^{14-11} = 3^3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(2^3\\right)^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{81}$" } ],
        [ { "tipe": "paragraph", "text": "$8^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{1{,}3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(2^3\\right)^4 = 2^{3 \\cdot 4} = 2^{12}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{17}{19}\\right)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{19}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{19}{17}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan tak nol berpangkat nol bernilai 1, sehingga $\\left(\\dfrac{17}{19}\\right)^0 = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{1}{4}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$-16$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{4}\\right)^{-2} = 4^2 = 16$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $10^4 = 10.000$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^{10}\\log 10.000 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 10.000 = 10$" } ],
        [ { "tipe": "paragraph", "text": "${}^{10.000}\\log 10 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^{10}\\log 4 = 10.000$" } ],
        [ { "tipe": "paragraph", "text": "${}^{10.000}\\log 4 = 10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $a^c = b$, maka ${}^a\\log b = c$. Dari $10^4 = 10.000$ diperoleh ${}^{10}\\log 10.000 = 4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log \\dfrac{1}{81}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log \\dfrac{1}{81} = {}^3\\log 3^{-4} = -4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 7 + {}^2\\log 4 - {}^2\\log 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 7 + {}^2\\log 4 - {}^2\\log 14 = {}^2\\log\\left(\\dfrac{7 \\cdot 4}{14}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{11^9}{11^2 \\cdot 11^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11^3$" } ],
        [ { "tipe": "paragraph", "text": "$11^5$" } ],
        [ { "tipe": "paragraph", "text": "$11^{15}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$11^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{11^9}{11^2 \\cdot 11^4} = \\dfrac{11^9}{11^6} = 11^{9-6} = 11^3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{2}{5}\\right)^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{125}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{8}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{125}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{2}{5}\\right)^{-3} = \\left(\\dfrac{5}{2}\\right)^3 = \\dfrac{125}{8}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
