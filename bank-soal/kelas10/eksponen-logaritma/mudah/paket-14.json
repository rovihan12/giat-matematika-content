{
  "id": "bs-k10-eks-mudah-14",
  "nama": "Bank Soal Mudah - Paket 14",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-14-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $4^2 \\cdot 4^5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^7$" } ],
        [ { "tipe": "paragraph", "text": "$4^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$16^7$" } ],
        [ { "tipe": "paragraph", "text": "$4^3$" } ],
        [ { "tipe": "paragraph", "text": "$4^{2{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $4^2 \\cdot 4^5$. Basis kedua bilangan sama, yaitu $4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$4^{2+5} = 4^7$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4^7$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{3^{14}}{3^5 \\cdot 3^6}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$3^{25}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $3^{14}$, penyebut $3^5 \\cdot 3^6$. Semua basis bilangan sama, yaitu $3$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$3^5 \\cdot 3^6 = 3^{5+6} = 3^{11}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{3^{14}}{3^{11}} = 3^{14-11} = 3^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(2^3\\right)^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{81}$" } ],
        [ { "tipe": "paragraph", "text": "$8^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{1{,}3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $\\left(2^3\\right)^4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$2^{3 \\cdot 4} = 2^{12}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2^{12}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{17}{19}\\right)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{19}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{19}{17}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan $\\dfrac{17}{19}$ dipangkatkan nol $\\left(\\dfrac{17}{19}\\right)^0$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada pecahan tersebut." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{17}{19}\\right)^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{1}{4}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$-16$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{1}{4}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{4}\\right)^{-2} = \\left(\\dfrac{4}{1}\\right)^2 = 4^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung hasil perpangkatannya ($4^2 = 16$)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $16$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $10^4 = 10.000$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^{10}\\log 10.000 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 10.000 = 10$" } ],
        [ { "tipe": "paragraph", "text": "${}^{10.000}\\log 10 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^{10}\\log 4 = 10.000$" } ],
        [ { "tipe": "paragraph", "text": "${}^{10.000}\\log 4 = 10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $10^4 = 10.000$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $10$, numerus $10.000$, dan hasil $4$." },
        { "tipe": "paragraph", "text": "${}^{10}\\log 10.000 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^{10}\\log 10.000 = 4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log \\dfrac{1}{81}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^3\\log \\dfrac{1}{81}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ serta $\\dfrac{1}{a^n} = a^{-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{81}$ menjadi bentuk perpangkatan dengan basis $3$ ($81 = 3^4$, sehingga $\\dfrac{1}{81} = 3^{-4}$)." },
        { "tipe": "paragraph", "text": "${}^3\\log \\dfrac{1}{81} = {}^3\\log 3^{-4}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= -4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $-4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 7 + {}^2\\log 4 - {}^2\\log 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma ${}^2\\log 7 + {}^2\\log 4 - {}^2\\log 14$ dengan basis yang sama ($2$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan dan pengurangan logaritma ${}^a\\log m + {}^a\\log n - {}^a\\log p = {}^a\\log\\left(\\dfrac{m \\cdot n}{p}\\right)$ serta ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan numerus dengan operasi perkalian dan pembagian." },
        { "tipe": "paragraph", "text": "${}^2\\log\\left(\\dfrac{7 \\cdot 4}{14}\\right) = {}^2\\log\\left(\\dfrac{28}{14}\\right) = {}^2\\log 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "$= 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{11^9}{11^2 \\cdot 11^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11^3$" } ],
        [ { "tipe": "paragraph", "text": "$11^5$" } ],
        [ { "tipe": "paragraph", "text": "$11^{15}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$11^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $11^9$, penyebut $11^2 \\cdot 11^4$. Semua basis bilangan sama, yaitu $11$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$11^2 \\cdot 11^4 = 11^{2+4} = 11^6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{11^9}{11^6} = 11^{9-6} = 11^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $11^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-14-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{2}{5}\\right)^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{125}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{8}{125}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{125}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{2}{5}\\right)^{-3}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{2}{5}\\right)^{-3} = \\left(\\dfrac{5}{2}\\right)^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung perpangkatan pembilang dan penyebut $\\dfrac{5^3}{2^3} = \\dfrac{125}{8}$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{125}{8}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
