{
  "id": "bs-k10-eks-mudah-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $7^2 \\cdot 7^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^5$" } ],
        [ { "tipe": "paragraph", "text": "$7^6$" } ],
        [ { "tipe": "paragraph", "text": "$49^5$" } ],
        [ { "tipe": "paragraph", "text": "$7^1$" } ],
        [ { "tipe": "paragraph", "text": "$7^9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $7^2 \\cdot 7^3$. Basis kedua bilangan sama, yaitu $7$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$7^{2+3} = 7^5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $7^5$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{4^8}{4^5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^3$" } ],
        [ { "tipe": "paragraph", "text": "$4^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$4^{40}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$4^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembagian bentuk eksponen $\\dfrac{4^8}{4^5}$. Basis kedua bilangan sama, yaitu $4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "paragraph", "text": "$4^{8-5} = 4^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(6^2)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^4$" } ],
        [ { "tipe": "paragraph", "text": "$6^5$" } ],
        [ { "tipe": "paragraph", "text": "$6^6$" } ],
        [ { "tipe": "paragraph", "text": "$36^4$" } ],
        [ { "tipe": "paragraph", "text": "$6^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $(6^2)^2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$6^{2 \\cdot 2} = 6^4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $6^4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $15^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$-15$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{15}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan $15$ dipangkatkan nol ($15^0$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada bilangan $15$." },
        { "tipe": "paragraph", "text": "$15^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $6^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-36$" } ],
        [ { "tipe": "paragraph", "text": "$-12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan berpangkat negatif $6^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif $a^{-n} = \\dfrac{1}{a^n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah ke bentuk pecahan dengan pangkat positif." },
        { "tipe": "paragraph", "text": "$6^{-2} = \\dfrac{1}{6^2}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai penyebutnya ($6^2 = 36$)." },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{1}{36}$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $7^2 = 49$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^7\\log 49 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 49 = 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^{49}\\log 7 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^7\\log 2 = 49$" } ],
        [ { "tipe": "paragraph", "text": "${}^{49}\\log 2 = 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $7^2 = 49$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $7$, numerus $49$, dan hasil $2$." },
        { "tipe": "paragraph", "text": "${}^7\\log 49 = 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^7\\log 49 = 2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^4\\log 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^4\\log 64$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ atau mencari bilangan pangkat dari basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah angka $64$ menjadi bentuk perpangkatan dengan basis $4$ ($64 = 4^3$)." },
        { "tipe": "paragraph", "text": "${}^4\\log 64 = {}^4\\log 4^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^6\\log 2 + {}^6\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^6\\log 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 6$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 1$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 6$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Penjumlahan dua logaritma dengan basis yang sama (${}^6\\log 2 + {}^6\\log 3$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan logaritma ${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$ serta sifat ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan kedua numerus karena basis logaritma sudah sama." },
        { "tipe": "paragraph", "text": "${}^6\\log 2 + {}^6\\log 3 = {}^6\\log(2 \\cdot 3) = {}^6\\log 6$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan menggunakan sifat ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "$= 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^6\\log 6$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $5^7 : 5^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^9$" } ],
        [ { "tipe": "paragraph", "text": "$5^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$1^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^{-5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembagian bentuk eksponen $5^7 : 5^2$. Basis kedua bilangan sama, yaitu $5$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "paragraph", "text": "$5^{7-2} = 5^5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5^5$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{2}\\right)^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-8$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{1}{2}\\right)^{-3}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^{-3} = \\left(\\dfrac{2}{1}\\right)^3 = 2^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung hasil perpangkatannya ($2^3 = 8$)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $8$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
