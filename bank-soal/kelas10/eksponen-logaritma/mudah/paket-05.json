{
  "id": "bs-k10-eks-mudah-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $7^2 \\cdot 7^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^5$" } ],
        [ { "tipe": "paragraph", "text": "$7^6$" } ],
        [ { "tipe": "paragraph", "text": "$49^5$" } ],
        [ { "tipe": "paragraph", "text": "$7^1$" } ],
        [ { "tipe": "paragraph", "text": "$7^9$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$7^2 \\cdot 7^3 = 7^{2+3} = 7^5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{4^8}{4^5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^3$" } ],
        [ { "tipe": "paragraph", "text": "$4^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$4^{40}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$4^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{4^8}{4^5} = 4^{8-5} = 4^3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(6^2)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^4$" } ],
        [ { "tipe": "paragraph", "text": "$6^5$" } ],
        [ { "tipe": "paragraph", "text": "$6^6$" } ],
        [ { "tipe": "paragraph", "text": "$36^4$" } ],
        [ { "tipe": "paragraph", "text": "$6^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(6^2)^2 = 6^{2 \\cdot 2} = 6^4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $15^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$-15$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{15}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$15^0 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $6^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-36$" } ],
        [ { "tipe": "paragraph", "text": "$-12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$6^{-2} = \\dfrac{1}{6^2} = \\dfrac{1}{36}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $7^2 = 49$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^7\\log 49 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 49 = 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^{49}\\log 7 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^7\\log 2 = 49$" } ],
        [ { "tipe": "paragraph", "text": "${}^{49}\\log 2 = 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $7^2 = 49$ diperoleh ${}^7\\log 49 = 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^4\\log 64$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^4\\log 64 = {}^4\\log 4^3 = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^6\\log 2 + {}^6\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^6\\log 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 6$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 1$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 6$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^6\\log 2 + {}^6\\log 3 = {}^6\\log (2 \\cdot 3) = {}^6\\log 6 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $5^7 : 5^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^9$" } ],
        [ { "tipe": "paragraph", "text": "$5^{14}$" } ],
        [ { "tipe": "paragraph", "text": "$1^5$" } ],
        [ { "tipe": "paragraph", "text": "$5^{-5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{5^7}{5^2} = 5^{7-2} = 5^5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{2}\\right)^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-8$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^{-3} = \\dfrac{1}{(1/2)^3} = \\dfrac{1}{1/8} = 8$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
