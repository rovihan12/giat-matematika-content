{
  "id": "bs-k10-eks-mudah-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3^4 \\cdot 3^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^8$" } ],
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$9^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^2$" } ],
        [ { "tipe": "paragraph", "text": "$3^{10}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Perkalian bentuk eksponen $3^4 \\cdot 3^2$. Basis kedua bilangan sama, yaitu $3$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Menjumlahkan Pangkat** Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "formula_block", "latex": "3^4 \\cdot 3^2 = 3^{4+2} = 3^6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $3^6$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{7^8}{7^5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^3$" } ],
        [ { "tipe": "paragraph", "text": "$7^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$7^{40}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$7^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Pembagian bentuk eksponen $\\dfrac{7^8}{7^5}$. Basis kedua bilangan sama, yaitu $7$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengurangkan Pangkat** Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "formula_block", "latex": "\\dfrac{7^8}{7^5} = 7^{8-5} = 7^3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $7^3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2^3)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^5$" } ],
        [ { "tipe": "paragraph", "text": "$2^6$" } ],
        [ { "tipe": "paragraph", "text": "$2^9$" } ],
        [ { "tipe": "paragraph", "text": "$4^6$" } ],
        [ { "tipe": "paragraph", "text": "$2^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Perpangkatan dari suatu bilangan berpangkat $(2^3)^2$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengalikan Pangkat** Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "formula_block", "latex": "(2^3)^2 = 2^{3 \\cdot 2} = 2^6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $2^6$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $9^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bilangan $9$ dipangkatkan nol ($9^0$)." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1$ untuk $a \\neq 0$)." },
        { "tipe": "paragraph", "text": "**Langkah 1: Menerapkan Sifat Pangkat Nol** Terapkan sifat pangkat nol pada bilangan $9$." },
        { "tipe": "formula_block", "latex": "9^0 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $3^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-9$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bilangan berpangkat negatif $3^{-2}$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pangkat negatif $a^{-n} = \\dfrac{1}{a^n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah ke Pangkat Positif** Ubah ke bentuk pecahan dengan pangkat positif." },
        { "tipe": "formula_block", "latex": "3^{-2} = \\dfrac{1}{3^2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Menghitung Nilai Penyebut** Hitung nilai perpangkatan pada penyebutnya ($3^2 = 9$)." },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{3^2} = \\dfrac{1}{9}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $\\dfrac{1}{9}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $2^5 = 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^2\\log 32 = 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 32 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^{32}\\log 2 = 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 5 = 32$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 2 = 32$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bentuk persamaan eksponen $2^5 = 32$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$ (dengan $a > 0, a \\neq 1,$ dan $b > 0$)." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah ke Bentuk Logaritma** Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$, numerus $32$, dan hasil $5$." },
        { "tipe": "formula_block", "latex": "2^5 = 32 \\Leftrightarrow {}^2\\log 32 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah ${}^2\\log 32 = 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bentuk logaritma ${}^3\\log 27$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat logaritma perpangkatan ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah Numerus ke Bentuk Pangkat** Ubah angka $27$ menjadi bentuk perpangkatan dengan basis $3$ ($27 = 3^3$)." },
        { "tipe": "formula_block", "latex": "{}^3\\log 27 = {}^3\\log 3^3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Menentukan Nilai Logaritma** Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "formula_block", "latex": "{}^3\\log 3^3 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 6 + {}^2\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^2\\log 9$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 18$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 18$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Penjumlahan dua logaritma dengan basis yang sama (${}^2\\log 6 + {}^2\\log 3$)." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat penjumlahan logaritma ${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengalikan Kedua Numerus** Kalikan kedua numerus karena basis logaritma sudah sama." },
        { "tipe": "formula_block", "latex": "{}^2\\log 6 + {}^2\\log 3 = {}^2\\log(6 \\cdot 3) = {}^2\\log 18" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah ${}^2\\log 18$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $6^5 : 6^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^8$" } ],
        [ { "tipe": "paragraph", "text": "$6^{15}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^{1{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Pembagian bentuk eksponen $6^5 : 6^3$. Basis kedua bilangan sama, yaitu $6$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengurangkan Pangkat** Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "formula_block", "latex": "6^5 : 6^3 = 6^{5-3} = 6^2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $6^2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{3}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Pecahan berpangkat negatif $\\left(\\dfrac{1}{3}\\right)^{-1}$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah ke Pangkat Positif** Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "formula_block", "latex": "\\left(\\dfrac{1}{3}\\right)^{-1} = \\left(\\dfrac{3}{1}\\right)^1 = 3^1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Menghitung Hasil Perpangkatan** Hitung nilai perpangkatannya." },
        { "tipe": "formula_block", "latex": "3^1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $3$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}