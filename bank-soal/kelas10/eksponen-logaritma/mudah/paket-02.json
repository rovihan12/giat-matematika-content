{
  "id": "bs-k10-eks-mudah-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3^4 \\cdot 3^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^8$" } ],
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$9^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^4 \\cdot 3^2 = 3^{4+2} = 3^6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{7^8}{7^5}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^3$" } ],
        [ { "tipe": "paragraph", "text": "$7^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$7^{40}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{7^8}{7^5} = 7^{8-5} = 7^3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(2^3)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^5$" } ],
        [ { "tipe": "paragraph", "text": "$2^6$" } ],
        [ { "tipe": "paragraph", "text": "$2^9$" } ],
        [ { "tipe": "paragraph", "text": "$4^6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(2^3)^2 = 2^{3 \\cdot 2} = 2^6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $9^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$-9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$9^0 = 1$ karena setiap bilangan tak nol berpangkat nol bernilai 1." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $3^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-9$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^{-2} = \\dfrac{1}{3^2} = \\dfrac{1}{9}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $2^5 = 32$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^2\\log 32 = 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^5\\log 32 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^{32}\\log 2 = 5$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 5 = 32$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $2^5 = 32$ diperoleh ${}^2\\log 32 = 5$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^3\\log 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 27 = {}^3\\log 3^3 = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 6 + {}^2\\log 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^2\\log 9$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 18$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 18$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 6 + {}^2\\log 3 = {}^2\\log (6 \\cdot 3) = {}^2\\log 18$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $6^5 : 6^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^8$" } ],
        [ { "tipe": "paragraph", "text": "$6^{15}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{6^5}{6^3} = 6^{5-3} = 6^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{3}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{3}\\right)^{-1} = \\dfrac{1}{1/3} = 3$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
