{
  "id": "bs-k10-eks-mudah-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^3 \\cdot 2^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$4^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^3 \\cdot 2^4 = 2^{3+4} = 2^7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $5^6 : 5^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$5^2$" } ],
        [ { "tipe": "paragraph", "text": "$5^{24}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{5^6}{5^4} = 5^{6-4} = 5^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(3^2)^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^8$" } ],
        [ { "tipe": "paragraph", "text": "$3^{16}$" } ],
        [ { "tipe": "paragraph", "text": "$9^4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(3^2)^4 = 3^{2 \\cdot 4} = 3^8$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $7^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$-7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan tak nol berpangkat nol sama dengan 1, jadi $7^0 = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $2^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-8$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^{-3} = \\dfrac{1}{2^3} = \\dfrac{1}{8}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $3^4 = 81$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^3\\log 81 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 81 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^{81}\\log 3 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 4 = 81$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $a^c = b$, maka ${}^a\\log b = c$. Dari $3^4 = 81$ diperoleh ${}^3\\log 81 = 4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 8 = {}^2\\log 2^3 = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^3\\log 5 + {}^3\\log 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^3\\log 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 10$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 25$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^3\\log 5 + {}^3\\log 2 = {}^3\\log (5 \\cdot 2) = {}^3\\log 10$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $4^3 \\cdot 4^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^5$" } ],
        [ { "tipe": "paragraph", "text": "$4^6$" } ],
        [ { "tipe": "paragraph", "text": "$16^5$" } ],
        [ { "tipe": "paragraph", "text": "$4^1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4^3 \\cdot 4^2 = 4^{3+2} = 4^5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{2}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^{-2} = \\dfrac{1}{(1/2)^2} = \\dfrac{1}{1/4} = 4$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
