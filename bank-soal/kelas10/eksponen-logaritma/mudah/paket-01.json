{
  "id": "bs-k10-eks-mudah-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^3 \\cdot 2^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$4^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^1$" } ],
        [ { "tipe": "paragraph", "text": "$2^{34}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $2^3 \\cdot 2^4$. Basis kedua bilangan sama, yaitu $2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$2^{3+4} = 2^7$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2^7$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $5^6 : 5^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$5^2$" } ],
        [ { "tipe": "paragraph", "text": "$5^{24}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$5^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembagian bentuk eksponen $5^6 : 5^4$. Basis kedua bilangan sama, yaitu $5$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "paragraph", "text": "$5^{6-4} = 5^2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $5^2$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(3^2)^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^6$" } ],
        [ { "tipe": "paragraph", "text": "$3^8$" } ],
        [ { "tipe": "paragraph", "text": "$3^{16}$" } ],
        [ { "tipe": "paragraph", "text": "$9^4$" } ],
        [ { "tipe": "paragraph", "text": "$3^{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $(3^2)^4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$3^{2 \\cdot 4} = 3^8$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3^8$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $7^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$-7$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan $7$ dipangkatkan nol ($7^0$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada bilangan $7$." },
        { "tipe": "paragraph", "text": "$7^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $2^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-8$" } ],
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan berpangkat negatif $2^{-3}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif $a^{-n} = \\dfrac{1}{a^n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah ke bentuk pecahan dengan pangkat positif." },
        { "tipe": "paragraph", "text": "$2^{-3} = \\dfrac{1}{2^3}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai penyebutnya ($2^3 = 8$)." },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{1}{8}$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $3^4 = 81$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^3\\log 81 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 81 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^{81}\\log 3 = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 4 = 81$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 3 = 81$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $3^4 = 81$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $3$, numerus $81$, dan hasil $4$." },
        { "tipe": "paragraph", "text": "${}^3\\log 81 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^3\\log 81 = 4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^2\\log 8$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ atau mencari bilangan pangkat dari basis." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah angka $8$ menjadi bentuk perpangkatan dengan basis $2$ ($8 = 2^3$)." },
        { "tipe": "paragraph", "text": "${}^2\\log 8 = {}^2\\log 2^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^3\\log 5 + {}^3\\log 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^3\\log 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 10$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 25$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 10$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Penjumlahan dua logaritma dengan basis yang sama (${}^3\\log 5 + {}^3\\log 2$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan logaritma ${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan kedua numerus karena basis logaritma sudah sama." },
        { "tipe": "paragraph", "text": "${}^3\\log 5 + {}^3\\log 2 = {}^3\\log(5 \\cdot 2) = {}^3\\log 10$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^3\\log 10$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $4^3 \\cdot 4^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^5$" } ],
        [ { "tipe": "paragraph", "text": "$4^6$" } ],
        [ { "tipe": "paragraph", "text": "$16^5$" } ],
        [ { "tipe": "paragraph", "text": "$4^1$" } ],
        [ { "tipe": "paragraph", "text": "$4^{3{,}2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $4^3 \\cdot 4^2$. Basis kedua bilangan sama, yaitu $4$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya." },
        { "tipe": "paragraph", "text": "$4^{3+2} = 4^5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4^5$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{2}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{1}{2}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{2}\\right)^{-2} = \\left(\\dfrac{2}{1}\\right)^2 = 2^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung hasil perpangkatannya ($2^2 = 4$)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
