{
  "id": "bs-k10-eks-mudah-15",
  "nama": "Bank Soal Mudah - Paket 15",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-15-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $6^3 \\cdot 6^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^5$" } ],
        [ { "tipe": "paragraph", "text": "$6^6$" } ],
        [ { "tipe": "paragraph", "text": "$36^5$" } ],
        [ { "tipe": "paragraph", "text": "$6^1$" } ],
        [ { "tipe": "paragraph", "text": "$6^{1{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $6^3 \\cdot 6^2$. Basis kedua bilangan sama, yaitu $6$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$6^{3+2} = 6^5$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $6^5$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{7^{10}}{7^3 \\cdot 7^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^3$" } ],
        [ { "tipe": "paragraph", "text": "$7^{11}$" } ],
        [ { "tipe": "paragraph", "text": "$7^{17}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$7^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $7^{10}$, penyebut $7^3 \\cdot 7^4$. Semua basis bilangan sama, yaitu $7$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$7^3 \\cdot 7^4 = 7^{3+4} = 7^7$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{7^{10}}{7^7} = 7^{10-7} = 7^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $7^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(3^2\\right)^5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$3^{25}$" } ],
        [ { "tipe": "paragraph", "text": "$9^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$3^{2{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $\\left(3^2\\right)^5$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$3^{2 \\cdot 5} = 3^{10}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3^{10}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{23}{29}\\right)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{23}{29}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{29}{23}$" } ],
        [ { "tipe": "paragraph", "text": "$-1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan $\\dfrac{23}{29}$ dipangkatkan nol $\\left(\\dfrac{23}{29}\\right)^0$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada pecahan tersebut." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{23}{29}\\right)^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{1}{6}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$-36$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{1}{6}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{6}\\right)^{-2} = \\left(\\dfrac{6}{1}\\right)^2 = 6^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung hasil perpangkatannya ($6^2 = 36$)." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $36$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $6^3 = 216$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^6\\log 216 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^3\\log 216 = 6$" } ],
        [ { "tipe": "paragraph", "text": "${}^{216}\\log 6 = 3$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 3 = 216$" } ],
        [ { "tipe": "paragraph", "text": "${}^{216}\\log 3 = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $6^3 = 216$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $6$, numerus $216$, dan hasil $3$." },
        { "tipe": "paragraph", "text": "${}^6\\log 216 = 3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^6\\log 216 = 3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^4\\log \\dfrac{1}{64}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^4\\log \\dfrac{1}{64}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ serta $\\dfrac{1}{a^n} = a^{-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{64}$ menjadi bentuk perpangkatan dengan basis $4$ ($64 = 4^3$, sehingga $\\dfrac{1}{64} = 4^{-3}$)." },
        { "tipe": "paragraph", "text": "${}^4\\log \\dfrac{1}{64} = {}^4\\log 4^{-3}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= -3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $-3$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^3\\log 8 + {}^3\\log 9 - {}^3\\log 24$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma ${}^3\\log 8 + {}^3\\log 9 - {}^3\\log 24$ dengan basis yang sama ($3$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan dan pengurangan logaritma ${}^a\\log m + {}^a\\log n - {}^a\\log p = {}^a\\log\\left(\\dfrac{m \\cdot n}{p}\\right)$ serta ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan numerus dengan operasi perkalian dan pembagian." },
        { "tipe": "paragraph", "text": "${}^3\\log\\left(\\dfrac{8 \\cdot 9}{24}\\right) = {}^3\\log\\left(\\dfrac{72}{24}\\right) = {}^3\\log 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "$= 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{20^8}{20^3 \\cdot 20^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20^3$" } ],
        [ { "tipe": "paragraph", "text": "$20^5$" } ],
        [ { "tipe": "paragraph", "text": "$20^{13}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$20^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $20^8$, penyebut $20^3 \\cdot 20^2$. Semua basis bilangan sama, yaitu $20$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$20^3 \\cdot 20^2 = 20^{3+2} = 20^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{20^8}{20^5} = 20^{8-5} = 20^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $20^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-15-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{3}{4}\\right)^{-3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{64}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{27}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{64}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{3}{4}\\right)^{-3}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{4}\\right)^{-3} = \\left(\\dfrac{4}{3}\\right)^3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung perpangkatan pembilang dan penyebut $\\dfrac{4^3}{3^3} = \\dfrac{64}{27}$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{64}{27}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
