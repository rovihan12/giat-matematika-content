{
  "id": "bs-k10-eks-mudah-07",
  "nama": "Bank Soal Mudah - Paket 7",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^4 \\cdot 2^3 \\cdot 2^1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^8$" } ],
        [ { "tipe": "paragraph", "text": "$2^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$6^8$" } ],
        [ { "tipe": "paragraph", "text": "$2^{4{,}3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $2^4 \\cdot 2^3 \\cdot 2^1$. Basis semua bilangan sama, yaitu $2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n \\cdot a^p = a^{m+n+p}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan semua pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$2^{4+3+1} = 2^8$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2^8$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{2^{12}}{2^5 \\cdot 2^3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^4$" } ],
        [ { "tipe": "paragraph", "text": "$2^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{20}$" } ],
        [ { "tipe": "paragraph", "text": "$2^2$" } ],
        [ { "tipe": "paragraph", "text": "$1^4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilangnya $2^{12}$, penyebutnya $2^5 \\cdot 2^3$. Semua basis bilangan sama, yaitu $2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu dengan menjumlahkan pangkatnya." },
        { "tipe": "paragraph", "text": "$2^5 \\cdot 2^3 = 2^{5+3} = 2^8$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Lakukan pembagian dengan mengurangkan pangkat pembilang dan penyebut." },
        { "tipe": "paragraph", "text": "$\\dfrac{2^{12}}{2^8} = 2^{12-8} = 2^4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2^4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(2^2\\right)^5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{25}$" } ],
        [ { "tipe": "paragraph", "text": "$4^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$2^3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $\\left(2^2\\right)^5$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$2^{2 \\cdot 5} = 2^{10}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2^{10}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $(-3)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan $(-3)$ dipangkatkan nol dengan tanda minus di dalam kurung $(-3)^0$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada bilangan tersebut." },
        { "tipe": "paragraph", "text": "$(-3)^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{2}{5}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{25}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{2}{5}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{2}{5}\\right)^{-2} = \\left(\\dfrac{5}{2}\\right)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung perpangkatan pembilang dan penyebut $\\dfrac{5^2}{2^2} = \\dfrac{25}{4}$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{25}{4}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $\\left(\\dfrac{1}{2}\\right)^4 = \\dfrac{1}{16}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^{1/2}\\log \\dfrac{1}{16} = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log \\dfrac{1}{16} = \\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "${}^{16}\\log \\dfrac{1}{2} = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^{1/2}\\log 4 = \\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log \\dfrac{1}{2} = 16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $\\left(\\dfrac{1}{2}\\right)^4 = \\dfrac{1}{16}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $\\dfrac{1}{2}$, numerus $\\dfrac{1}{16}$, dan hasil $4$." },
        { "tipe": "paragraph", "text": "${}^{1/2}\\log \\dfrac{1}{16} = 4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^{1/2}\\log \\dfrac{1}{16} = 4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log \\dfrac{1}{16}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^2\\log \\dfrac{1}{16}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ serta sifat $\\dfrac{1}{a^n} = a^{-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{16}$ menjadi bentuk perpangkatan dengan basis $2$ ($16 = 2^4$, sehingga $\\dfrac{1}{16} = 2^{-4}$)." },
        { "tipe": "paragraph", "text": "${}^2\\log \\dfrac{1}{16} = {}^2\\log 2^{-4}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= -4$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $-4$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 5 + {}^2\\log 4 - {}^2\\log 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma ${}^2\\log 5 + {}^2\\log 4 - {}^2\\log 10$ dengan basis yang sama ($2$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan dan pengurangan logaritma ${}^a\\log m + {}^a\\log n - {}^a\\log p = {}^a\\log\\left(\\dfrac{m \\cdot n}{p}\\right)$ serta ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan numerus dengan operasi perkalian dan pembagian." },
        { "tipe": "paragraph", "text": "${}^2\\log\\left(\\dfrac{5 \\cdot 4}{10}\\right) = {}^2\\log\\left(\\dfrac{20}{10}\\right) = {}^2\\log 2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sentukan hasilnya menggunakan sifat ${}^a\\log a = 1$." },
        { "tipe": "paragraph", "text": "$= 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{6^7}{6^2 \\cdot 6^3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^6$" } ],
        [ { "tipe": "paragraph", "text": "$6^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^{1{,}2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilangnya $6^7$, penyebutnya $6^2 \\cdot 6^3$. Semua basis bilangan sama, yaitu $6$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$6^2 \\cdot 6^3 = 6^{2+3} = 6^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{6^7}{6^5} = 6^{7-5} = 6^2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $6^2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{3}{2}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif satu $\\left(\\dfrac{3}{2}\\right)^{-1}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{2}\\right)^{-1} = \\left(\\dfrac{2}{3}\\right)^1 = \\dfrac{2}{3}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{2}{3}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
