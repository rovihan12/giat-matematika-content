{
  "id": "bs-k10-eks-mudah-07",
  "nama": "Bank Soal Mudah - Paket 7",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^4 \\cdot 2^3 \\cdot 2^1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^8$" } ],
        [ { "tipe": "paragraph", "text": "$2^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$6^8$" } ],
        [ { "tipe": "paragraph", "text": "$2^{4{,}3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2^4 \\cdot 2^3 \\cdot 2^1 = 2^{4+3+1} = 2^8$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{2^{12}}{2^5 \\cdot 2^3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^4$" } ],
        [ { "tipe": "paragraph", "text": "$2^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{20}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1^4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2^{12}}{2^5 \\cdot 2^3} = \\dfrac{2^{12}}{2^{8}} = 2^{12-8} = 2^4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(2^2\\right)^5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{25}$" } ],
        [ { "tipe": "paragraph", "text": "$4^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$2^{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(2^2\\right)^5 = 2^{2 \\cdot 5} = 2^{10}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $(-3)^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan tak nol berpangkat nol bernilai 1, sehingga $(-3)^0 = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{2}{5}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{25}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{2}{5}\\right)^{-2} = \\left(\\dfrac{5}{2}\\right)^2 = \\dfrac{25}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $\\left(\\dfrac{1}{2}\\right)^4 = \\dfrac{1}{16}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^{1/2}\\log \\dfrac{1}{16} = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log \\dfrac{1}{16} = \\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "${}^{16}\\log \\dfrac{1}{2} = 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^{1/2}\\log 4 = \\dfrac{1}{16}$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log \\dfrac{1}{2} = 16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $a^c = b$, maka ${}^a\\log b = c$. Dari $\\left(\\dfrac{1}{2}\\right)^4 = \\dfrac{1}{16}$ diperoleh ${}^{1/2}\\log \\dfrac{1}{16} = 4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^2\\log \\dfrac{1}{16}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log \\dfrac{1}{16} = {}^2\\log 2^{-4} = -4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 5 + {}^2\\log 4 - {}^2\\log 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 5 + {}^2\\log 4 - {}^2\\log 10 = {}^2\\log\\left(\\dfrac{5 \\cdot 4}{10}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 2 = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{6^7}{6^2 \\cdot 6^3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^6$" } ],
        [ { "tipe": "paragraph", "text": "$6^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$6^{1{,}2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{6^7}{6^2 \\cdot 6^3} = \\dfrac{6^7}{6^5} = 6^{7-5} = 6^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{3}{2}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{3}{2}\\right)^{-1} = \\dfrac{2}{3}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
