{
  "id": "bs-k10-eks-mudah-06",
  "nama": "Bank Soal Mudah - Paket 6",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $2^5 \\cdot 2^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$4^7$" } ],
        [ { "tipe": "paragraph", "text": "$2^3$" } ],
        [ { "tipe": "paragraph", "text": "$2^{2{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Perkalian bentuk eksponen $2^5 \\cdot 2^2$. Basis kedua bilangan sama, yaitu $2$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Menjumlahkan Pangkat** Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "formula_block", "latex": "2^5 \\cdot 2^2 = 2^{5+2} = 2^7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $2^7$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{3^{10}}{3^7}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^{17}$" } ],
        [ { "tipe": "paragraph", "text": "$3^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{70}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{-3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Pembagian bentuk eksponen $\\dfrac{3^{10}}{3^7}$. Basis kedua bilangan sama, yaitu $3$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengurangkan Pangkat** Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "formula_block", "latex": "\\dfrac{3^{10}}{3^7} = 3^{10-7} = 3^3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $3^3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $(7^2)^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7^5$" } ],
        [ { "tipe": "paragraph", "text": "$7^6$" } ],
        [ { "tipe": "paragraph", "text": "$7^9$" } ],
        [ { "tipe": "paragraph", "text": "$49^3$" } ],
        [ { "tipe": "paragraph", "text": "$7^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Perpangkatan dari suatu bilangan berpangkat $(7^2)^3$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengalikan Pangkat** Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "formula_block", "latex": "(7^2)^3 = 7^{2 \\cdot 3} = 7^6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $7^6$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $25^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$-25$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{25}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bilangan $25$ dipangkatkan nol ($25^0$)." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1$ untuk $a \\neq 0$)." },
        { "tipe": "paragraph", "text": "**Langkah 1: Menerapkan Sifat Pangkat Nol** Terapkan sifat pangkat nol pada bilangan $25$." },
        { "tipe": "formula_block", "latex": "25^0 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $7^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-49$" } ],
        [ { "tipe": "paragraph", "text": "$-14$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{49}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bilangan berpangkat negatif $7^{-2}$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pangkat negatif $a^{-n} = \\dfrac{1}{a^n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah ke Pangkat Positif** Ubah ke bentuk pecahan dengan pangkat positif." },
        { "tipe": "formula_block", "latex": "7^{-2} = \\dfrac{1}{7^2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Menghitung Nilai Penyebut** Hitung nilai perpangkatan pada penyebutnya ($7^2 = 49$)." },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{7^2} = \\dfrac{1}{49}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $\\dfrac{1}{49}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $6^2 = 36$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^6\\log 36 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 36 = 6$" } ],
        [ { "tipe": "paragraph", "text": "${}^{36}\\log 6 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^6\\log 2 = 36$" } ],
        [ { "tipe": "paragraph", "text": "${}^{36}\\log 2 = 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bentuk persamaan eksponen $6^2 = 36$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$ (dengan $a > 0, a \\neq 1,$ dan $b > 0$)." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah ke Bentuk Logaritma** Ubah bentuk eksponen ke bentuk logaritma dengan basis $6$, numerus $36$, dan hasil $2$." },
        { "tipe": "formula_block", "latex": "6^2 = 36 \\Leftrightarrow {}^6\\log 36 = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah ${}^6\\log 36 = 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^5\\log 625$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Bentuk logaritma ${}^5\\log 625$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat logaritma perpangkatan ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah Numerus ke Bentuk Pangkat** Ubah angka $625$ menjadi bentuk perpangkatan dengan basis $5$ ($625 = 5^4$)." },
        { "tipe": "formula_block", "latex": "{}^5\\log 625 = {}^5\\log 5^4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Menentukan Nilai Logaritma** Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "formula_block", "latex": "{}^5\\log 5^4 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^4\\log 3 + {}^4\\log 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^4\\log 8$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 15$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^{15}\\log 4$" } ],
        [ { "tipe": "paragraph", "text": "${}^4\\log 1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Penjumlahan dua logaritma dengan basis yang sama (${}^4\\log 3 + {}^4\\log 5$)." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat penjumlahan logaritma ${}^a\\log m + {}^a\\log n = {}^a\\log(m \\cdot n)$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengalikan Kedua Numerus** Kalikan kedua numerus karena basis logaritma sudah sama." },
        { "tipe": "formula_block", "latex": "{}^4\\log 3 + {}^4\\log 5 = {}^4\\log(3 \\cdot 5) = {}^4\\log 15" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah ${}^4\\log 15$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $11^6 : 11^4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11^2$" } ],
        [ { "tipe": "paragraph", "text": "$11^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$11^{24}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$11^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Pembagian bentuk eksponen $11^6 : 11^4$. Basis kedua bilangan sama, yaitu $11$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pembagian eksponen dengan basis yang sama $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengurangkan Pangkat** Kurangkan pangkat pembagi dari pangkat yang dibagi." },
        { "tipe": "formula_block", "latex": "11^6 : 11^4 = 11^{6-4} = 11^2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $11^2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{1}{6}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Yang diketahui:** Pecahan berpangkat negatif $\\left(\\dfrac{1}{6}\\right)^{-1}$." },
        { "tipe": "paragraph", "text": "**Sifat yang dipakai:** Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "**Langkah 1: Mengubah ke Pangkat Positif** Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "formula_block", "latex": "\\left(\\dfrac{1}{6}\\right)^{-1} = \\left(\\dfrac{6}{1}\\right)^1 = 6^1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Menghitung Hasil Perpangkatan** Hitung nilai perpangkatannya." },
        { "tipe": "formula_block", "latex": "6^1 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jawabannya adalah $6$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}