{
  "id": "bs-k10-eks-mudah-11",
  "nama": "Bank Soal Mudah - Paket 11",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-11-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3^5 \\cdot 3^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$9^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{2{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3^5 \\cdot 3^2 = 3^{5+2} = 3^7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{6^{11}}{6^4 \\cdot 6^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^3$" } ],
        [ { "tipe": "paragraph", "text": "$6^{11}$" } ],
        [ { "tipe": "paragraph", "text": "$6^{19}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$6^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{6^{11}}{6^4 \\cdot 6^4} = \\dfrac{6^{11}}{6^8} = 6^{11-8} = 6^3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(4^3\\right)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^5$" } ],
        [ { "tipe": "paragraph", "text": "$4^6$" } ],
        [ { "tipe": "paragraph", "text": "$4^9$" } ],
        [ { "tipe": "paragraph", "text": "$16^6$" } ],
        [ { "tipe": "paragraph", "text": "$4^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(4^3\\right)^2 = 4^{3 \\cdot 2} = 4^6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $2024^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2024$" } ],
        [ { "tipe": "paragraph", "text": "$-2024$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2024}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Setiap bilangan tak nol berpangkat nol bernilai 1, sehingga $2024^0 = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{5}{8}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{8}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{64}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{5}{8}\\right)^{-1} = \\dfrac{8}{5}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $2^7 = 128$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^2\\log 128 = 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^7\\log 128 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^{128}\\log 2 = 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 7 = 128$" } ],
        [ { "tipe": "paragraph", "text": "${}^{128}\\log 7 = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jika $a^c = b$, maka ${}^a\\log b = c$. Dari $2^7 = 128$ diperoleh ${}^2\\log 128 = 7$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^6\\log \\dfrac{1}{36}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^6\\log \\dfrac{1}{36} = {}^6\\log 6^{-2} = -2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 6 + {}^2\\log 8 - {}^2\\log 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "${}^2\\log 6 + {}^2\\log 8 - {}^2\\log 12 = {}^2\\log\\left(\\dfrac{6 \\cdot 8}{12}\\right)$" },
        { "tipe": "paragraph", "text": "$= {}^2\\log 4 = {}^2\\log 2^2 = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{12^7}{12^3 \\cdot 12^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12^2$" } ],
        [ { "tipe": "paragraph", "text": "$12^4$" } ],
        [ { "tipe": "paragraph", "text": "$12^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$12^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{12^7}{12^3 \\cdot 12^2} = \\dfrac{12^7}{12^5} = 12^{7-5} = 12^2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{2}{9}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{81}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{81}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{81}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{81}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{2}{9}\\right)^{-2} = \\left(\\dfrac{9}{2}\\right)^2 = \\dfrac{81}{4}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
