{
  "id": "bs-k10-eks-mudah-11",
  "nama": "Bank Soal Mudah - Paket 11",
  "kelas": 10,
  "kategori": "Eksponen dan Logaritma",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang sifat dasar eksponen dan logaritma",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-eks-m-11-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $3^5 \\cdot 3^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^{10}$" } ],
        [ { "tipe": "paragraph", "text": "$9^7$" } ],
        [ { "tipe": "paragraph", "text": "$3^3$" } ],
        [ { "tipe": "paragraph", "text": "$3^{2{,}5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perkalian bentuk eksponen $3^5 \\cdot 3^2$. Basis kedua bilangan sama, yaitu $3$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian eksponen dengan basis yang sama $a^m \\cdot a^n = a^{m+n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan pangkatnya karena basisnya sudah sama." },
        { "tipe": "paragraph", "text": "$3^{5+2} = 3^7$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $3^7$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{6^{11}}{6^4 \\cdot 6^4}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6^3$" } ],
        [ { "tipe": "paragraph", "text": "$6^{11}$" } ],
        [ { "tipe": "paragraph", "text": "$6^{19}$" } ],
        [ { "tipe": "paragraph", "text": "$1^3$" } ],
        [ { "tipe": "paragraph", "text": "$6^{-3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $6^{11}$, penyebut $6^4 \\cdot 6^4$. Semua basis bilangan sama, yaitu $6$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$6^4 \\cdot 6^4 = 6^{4+4} = 6^8$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{6^{11}}{6^8} = 6^{11-8} = 6^3$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $6^3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\left(4^3\\right)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4^5$" } ],
        [ { "tipe": "paragraph", "text": "$4^6$" } ],
        [ { "tipe": "paragraph", "text": "$4^9$" } ],
        [ { "tipe": "paragraph", "text": "$16^6$" } ],
        [ { "tipe": "paragraph", "text": "$4^{1{,}5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Perpangkatan dari suatu bilangan berpangkat $\\left(4^3\\right)^2$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perpangkatan bilangan berpangkat $(a^m)^n = a^{m \\cdot n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kalikan pangkat di dalam kurung dengan pangkat di luar kurung." },
        { "tipe": "paragraph", "text": "$4^{3 \\cdot 2} = 4^6$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $4^6$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $2024^0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2024$" } ],
        [ { "tipe": "paragraph", "text": "$-2024$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2024}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bilangan $2024$ dipangkatkan nol ($2024^0$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Setiap bilangan real tak nol yang dipangkatkan nol selalu bernilai $1$ ($a^0 = 1, \\text{ untuk } a \\neq 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Terapkan sifat pangkat nol pada bilangan tersebut." },
        { "tipe": "paragraph", "text": "$2024^0 = 1$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $1$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk sederhana dari $\\left(\\dfrac{5}{8}\\right)^{-1}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{8}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{64}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif satu $\\left(\\dfrac{5}{8}\\right)^{-1}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{5}{8}\\right)^{-1} = \\left(\\dfrac{8}{5}\\right)^1 = \\dfrac{8}{5}$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{8}{5}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bentuk logaritma dari $2^7 = 128$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "${}^2\\log 128 = 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^7\\log 128 = 2$" } ],
        [ { "tipe": "paragraph", "text": "${}^{128}\\log 2 = 7$" } ],
        [ { "tipe": "paragraph", "text": "${}^2\\log 7 = 128$" } ],
        [ { "tipe": "paragraph", "text": "${}^{128}\\log 7 = 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk persamaan eksponen $2^7 = 128$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Definisi hubungan eksponen dan logaritma: $a^c = b \\Leftrightarrow {}^a\\log b = c$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk eksponen ke bentuk logaritma dengan basis $2$, numerus $128$, dan hasil $7$." },
        { "tipe": "paragraph", "text": "${}^2\\log 128 = 7$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah ${}^2\\log 128 = 7$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari ${}^6\\log \\dfrac{1}{36}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Bentuk logaritma ${}^6\\log \\dfrac{1}{36}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat ${}^a\\log a^n = n$ serta $\\dfrac{1}{a^n} = a^{-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah pecahan $\\dfrac{1}{36}$ menjadi bentuk perpangkatan dengan basis $6$ ($36 = 6^2$, sehingga $\\dfrac{1}{36} = 6^{-2}$)." },
        { "tipe": "paragraph", "text": "${}^6\\log \\dfrac{1}{36} = {}^6\\log 6^{-2}$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan hasilnya menggunakan sifat ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "$= -2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $-2$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari ${}^2\\log 6 + {}^2\\log 8 - {}^2\\log 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Operasi hitung logaritma ${}^2\\log 6 + {}^2\\log 8 - {}^2\\log 12$ dengan basis yang sama ($2$)." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat penjumlahan dan pengurangan logaritma ${}^a\\log m + {}^a\\log n - {}^a\\log p = {}^a\\log\\left(\\dfrac{m \\cdot n}{p}\\right)$ serta ${}^a\\log a^n = n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gabungkan numerus dengan operasi perkalian dan pembagian." },
        { "tipe": "paragraph", "text": "${}^2\\log\\left(\\dfrac{6 \\cdot 8}{12}\\right) = {}^2\\log\\left(\\dfrac{48}{12}\\right) = {}^2\\log 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Ubah angka $4$ menjadi bentuk $2^2$ dan tentukan hasilnya." },
        { "tipe": "paragraph", "text": "${}^2\\log 2^2 = 2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $2$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Hasil dari $\\dfrac{12^7}{12^3 \\cdot 12^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12^2$" } ],
        [ { "tipe": "paragraph", "text": "$12^4$" } ],
        [ { "tipe": "paragraph", "text": "$12^{12}$" } ],
        [ { "tipe": "paragraph", "text": "$1^2$" } ],
        [ { "tipe": "paragraph", "text": "$12^{-2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pembilang $12^7$, penyebut $12^3 \\cdot 12^2$. Semua basis bilangan sama, yaitu $12$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat perkalian $a^m \\cdot a^n = a^{m+n}$ dan pembagian eksponen $a^m : a^n = a^{m-n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Sederhanakan bagian penyebut terlebih dahulu." },
        { "tipe": "paragraph", "text": "$12^3 \\cdot 12^2 = 12^{3+2} = 12^5$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Bagikan pembilang dengan penyebut yang sudah disederhanakan." },
        { "tipe": "paragraph", "text": "$\\dfrac{12^7}{12^5} = 12^{7-5} = 12^2$" },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $12^2$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-eks-m-11-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\left(\\dfrac{2}{9}\\right)^{-2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{81}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{81}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{4}{81}$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{81}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Yang diketahui:</strong> Pecahan berpangkat negatif $\\left(\\dfrac{2}{9}\\right)^{-2}$." },
        { "tipe": "paragraph", "text": "<strong>Sifat yang dipakai:</strong> Sifat pangkat negatif pada pecahan $\\left(\\dfrac{a}{b}\\right)^{-n} = \\left(\\dfrac{b}{a}\\right)^n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Balikkan pecahan dan ubah pangkatnya menjadi positif." },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{2}{9}\\right)^{-2} = \\left(\\dfrac{9}{2}\\right)^2$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung perpangkatan pembilang dan penyebut $\\dfrac{9^2}{2^2} = \\dfrac{81}{4}$." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $\\dfrac{81}{4}$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
