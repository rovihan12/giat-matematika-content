{
  "id": "bs-k10-pel-s-05",
  "nama": "Bank Soal Sedang - Paket 5",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang campuran tentang peluang majemuk",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-s-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar dua kali. Peluang muncul mata dadu $5$ pada kedua lemparan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{18}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = \\dfrac{1}{6} \\cdot \\dfrac{1}{6} = \\dfrac{1}{36}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kartu diambil dari set bridge. Peluang terambil kartu berwarna hitam atau As adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{26}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{hitam}) = \\dfrac{26}{52}$, $P(\\text{As}) = \\dfrac{4}{52}$" },
        { "tipe": "paragraph", "text": "$P(\\text{As hitam}) = \\dfrac{2}{52}$" },
        { "tipe": "paragraph", "text": "$P(A \\cup B) = \\dfrac{26}{52} + \\dfrac{4}{52} - \\dfrac{2}{52} = \\dfrac{28}{52} = \\dfrac{7}{13}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(A) = \\dfrac{1}{3}$, $P(B) = \\dfrac{2}{5}$, dan $P(A \\cap B) = \\dfrac{2}{15}$. Apakah $A$ dan $B$ saling bebas?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Ya, karena $P(A \\cap B) = P(A) \\cdot P(B)$" } ],
        [ { "tipe": "paragraph", "text": "Tidak, karena $P(A \\cap B) \\neq P(A) \\cdot P(B)$" } ],
        [ { "tipe": "paragraph", "text": "Ya, karena $P(A \\cap B) = 0$" } ],
        [ { "tipe": "paragraph", "text": "Tidak, karena $P(A) \\neq P(B)$" } ],
        [ { "tipe": "paragraph", "text": "Tidak dapat ditentukan" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A) \\cdot P(B) = \\dfrac{1}{3} \\cdot \\dfrac{2}{5} = \\dfrac{2}{15}$" },
        { "tipe": "paragraph", "text": "Karena $P(A \\cap B) = P(A) \\cdot P(B)$, maka $A$ dan $B$ saling bebas." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang seorang siswa lulus matematika adalah $0{,}7$, lulus fisika $0{,}6$, dan lulus keduanya $0{,}5$. Peluang siswa lulus matematika ATAU fisika adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}6$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}7$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}8$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}9$" } ],
        [ { "tipe": "paragraph", "text": "$1{,}0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = 0{,}7 + 0{,}6 - 0{,}5 = 0{,}8$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan tiga koin, peluang muncul tepat 2 gambar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ruang sampel: 8 kemungkinan." },
        { "tipe": "paragraph", "text": "Tepat 2 gambar: $\\{GGA, GAG, AGG\\}$ → 3." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{3}{8}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar. Peluang jumlah mata dadu merupakan bilangan prima adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah prima: $2, 3, 5, 7, 11$." },
        { "tipe": "paragraph", "text": "$2$: 1 pasangan, $3$: 2, $5$: 4, $7$: 6, $11$: 2 → total 15 pasangan." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{15}{36} = \\dfrac{5}{12}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 6 bola merah, 4 biru, 2 kuning. Diambil 1 bola secara acak. Peluang terambil bola merah atau biru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total = $6 + 4 + 2 = 12$." },
        { "tipe": "paragraph", "text": "Merah + biru = $6 + 4 = 10$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{10}{12} = \\dfrac{5}{6}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(A^c) = 0{,}4$ dan $P(B) = 0{,}5$ dengan $A$, $B$ saling bebas. Nilai $P(A \\cap B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}20$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}30$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}40$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}50$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}60$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A) = 1 - 0{,}4 = 0{,}6$" },
        { "tipe": "paragraph", "text": "$P(A \\cap B) = 0{,}6 \\cdot 0{,}5 = 0{,}3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam kantong terdapat 8 bola: 5 merah dan 3 putih. Diambil 2 bola satu per satu tanpa pengembalian. Peluang terambil merah lalu putih adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{56}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{28}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{14}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P_1(\\text{merah}) = \\dfrac{5}{8}$, setelah diambil merah, tersisa 4 merah dan 3 putih." },
        { "tipe": "paragraph", "text": "$P_2(\\text{putih}) = \\dfrac{3}{7}$" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{5}{8} \\cdot \\dfrac{3}{7} = \\dfrac{15}{56}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang kejadian $A$ adalah $\\dfrac{3}{8}$ dan peluang $B$ adalah $\\dfrac{1}{4}$. Jika $A$ dan $B$ saling lepas, $P(A \\cup B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Saling lepas: $P(A \\cup B) = P(A) + P(B)$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{3}{8} + \\dfrac{1}{4} = \\dfrac{3}{8} + \\dfrac{2}{8} = \\dfrac{5}{8}$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
