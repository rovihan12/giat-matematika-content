{
  "id": "bs-k10-pel-s-08",
  "nama": "Bank Soal Sedang - Paket 8",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang peluang tanpa pengembalian dan kombinasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-s-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 4 bola merah dan 6 bola putih. Diambil 2 bola satu per satu TANPA pengembalian. Peluang keduanya merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{25}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tanpa pengembalian $\\rightarrow$ kejadian bersyarat." },
        { "tipe": "paragraph", "text": "$P_1 = \\dfrac{4}{10}$, setelah diambil 1 merah: $P_2 = \\dfrac{3}{9}$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{4}{10} \\cdot \\dfrac{3}{9} = \\dfrac{12}{90} = \\dfrac{2}{15}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 5 bola merah dan 3 bola putih. Diambil 2 bola satu per satu TANPA pengembalian. Peluang keduanya putih adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{28}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{28}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{56}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P_1 = \\dfrac{3}{8}$, setelah diambil 1 putih: $P_2 = \\dfrac{2}{7}$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{3}{8} \\cdot \\dfrac{2}{7} = \\dfrac{6}{56} = \\dfrac{3}{28}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang Andi lulus SNBT adalah $0{,}7$. Jika ia lulus SNBT, peluang ia lulus kedokteran adalah $0{,}4$. Peluang Andi lulus SNBT DAN kedokteran adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}11$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}24$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}28$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}30$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}70$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = 0{,}7 \\cdot 0{,}4 = 0{,}28$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar. Diketahui jumlah mata dadu adalah $8$. Peluang salah satu dadu menunjukkan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $8$: $(2,6), (3,5), (4,4), (5,3), (6,2) \\rightarrow 5$ pasangan." },
        { "tipe": "paragraph", "text": "Mengandung $3$: $(3,5), (5,3) \\rightarrow 2$ pasangan." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{2}{5}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kotak ada 3 bola merah, 2 bola biru, dan 4 bola kuning. Diambil satu bola, dicatat, lalu dikembalikan. Peluang terambil merah pada pengambilan kedua GIVEN pengambilan pertama merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena dikembalikan, kedua pengambilan saling bebas." },
        { "tipe": "paragraph", "text": "$P(\\text{merah ke-2} \\mid \\text{merah ke-1}) = P(\\text{merah}) = \\dfrac{3}{9} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu kantong berisi 8 kelereng, 3 merah dan 5 hitam. Diambil 2 kelereng sekaligus. Peluang keduanya merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{28}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{28}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{56}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan kombinasi. $n(S) = C(8,2) = 28$." },
        { "tipe": "paragraph", "text": "Ambil 2 merah dari 3: $C(3,2) = 3$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{3}{28}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kantong terdapat 6 bola: 4 merah dan 2 kuning. Diambil 2 bola sekaligus. Peluang terambil 1 merah dan 1 kuning adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n(S) = C(6,2) = 15$." },
        { "tipe": "paragraph", "text": "Ambil 1 merah dan 1 kuning: $C(4,1) \\cdot C(2,1) = 4 \\cdot 2 = 8$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{8}{15}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu produk cacat adalah $0{,}05$. Peluang dari 2 produk yang diperiksa, keduanya cacat adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}0025$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}0050$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}0100$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}1000$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}2500$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Saling bebas: $P = 0{,}05 \\cdot 0{,}05 = 0{,}0025$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 10 bola, 6 merah dan 4 putih. Diambil 2 bola sekaligus. Peluang terambil keduanya BUKAN putih adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n(S) = C(10,2) = 45$." },
        { "tipe": "paragraph", "text": "Keduanya bukan putih = keduanya merah: $C(6,2) = 15$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{15}{45} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua kejadian $A$ dan $B$ saling bebas dengan $P(A) = \\dfrac{1}{4}$ dan $P(B) = \\dfrac{2}{3}$. Nilai $P(A \\cap B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A \\cap B) = \\dfrac{1}{4} \\cdot \\dfrac{2}{3} = \\dfrac{2}{12} = \\dfrac{1}{6}$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
