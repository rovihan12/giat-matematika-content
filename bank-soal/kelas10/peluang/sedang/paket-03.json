{
  "id": "bs-k10-pel-s-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang peluang gabungan dan komplemen majemuk",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar. Peluang muncul jumlah mata dadu lebih dari $9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $> 9$: $10, 11, 12$." },
        { "tipe": "paragraph", "text": "$10$: $(4,6), (5,5), (6,4)$ → 3" },
        { "tipe": "paragraph", "text": "$11$: $(5,6), (6,5)$ → 2" },
        { "tipe": "paragraph", "text": "$12$: $(6,6)$ → 1" },
        { "tipe": "paragraph", "text": "Total = 6 pasangan → $P = \\dfrac{6}{36} = \\dfrac{1}{6}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 4 bola merah dan 6 bola biru. Diambil 1 bola secara acak. Peluang terambil bola merah ATAU biru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Semua bola pasti merah atau biru → kejadian pasti." },
        { "tipe": "paragraph", "text": "$P = 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan dua dadu, peluang jumlah mata dadu TIDAK lebih dari $4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{12}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $\\leq 4$: $2$ (1 pasangan), $3$ (2), $4$ (3) → total 6 pasangan." },
        { "tipe": "paragraph", "text": "$P(\\leq 4) = \\dfrac{6}{36} = \\dfrac{1}{6}$" },
        { "tipe": "paragraph", "text": "$P(> 4) = 1 - \\dfrac{1}{6} = \\dfrac{5}{6}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(A) = \\dfrac{2}{5}$ dan $P(B) = \\dfrac{1}{3}$ dengan $A$ dan $B$ saling lepas, maka $P(A^c \\cap B^c)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A \\cup B) = \\dfrac{2}{5} + \\dfrac{1}{3} = \\dfrac{6 + 5}{15} = \\dfrac{11}{15}$" },
        { "tipe": "paragraph", "text": "$P((A \\cup B)^c) = 1 - \\dfrac{11}{15} = \\dfrac{4}{15}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar. Peluang muncul mata dadu pertama GENAP dan mata dadu kedua GANJIL adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{genap}) = \\dfrac{3}{6} = \\dfrac{1}{2}$, $P(\\text{ganjil}) = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "Saling bebas: $P = \\dfrac{1}{2} \\cdot \\dfrac{1}{2} = \\dfrac{1}{4}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam suatu kelas, $70\\%$ siswa lulus matematika dan $80\\%$ lulus bahasa. Jika $60\\%$ lulus keduanya, maka persentase siswa yang lulus matematika atau bahasa adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$70\\%$" } ],
        [ { "tipe": "paragraph", "text": "$80\\%$" } ],
        [ { "tipe": "paragraph", "text": "$90\\%$" } ],
        [ { "tipe": "paragraph", "text": "$100\\%$" } ],
        [ { "tipe": "paragraph", "text": "$110\\%$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = 0{,}7 + 0{,}8 - 0{,}6 = 0{,}9 = 90\\%$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kartu diambil dari set bridge. Peluang terambil kartu King ATAU kartu bergambar hati adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{26}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{King}) = \\dfrac{4}{52}$, $P(\\text{hati}) = \\dfrac{13}{52}$" },
        { "tipe": "paragraph", "text": "$P(\\text{King hati}) = \\dfrac{1}{52}$" },
        { "tipe": "paragraph", "text": "$P(A \\cup B) = \\dfrac{4}{52} + \\dfrac{13}{52} - \\dfrac{1}{52} = \\dfrac{16}{52}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang Rina menang lomba adalah $0{,}6$. Peluang Rina TIDAK menang lomba adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}3$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}4$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}6$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{tidak menang}) = 1 - 0{,}6 = 0{,}4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar. Peluang muncul hasil kali kedua mata dadu GENAP adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Hasil kali GANJIL jika KEDUA dadu ganjil: $3 \\times 3 = 9$ pasangan." },
        { "tipe": "paragraph", "text": "$P(\\text{ganjil}) = \\dfrac{9}{36} = \\dfrac{1}{4}$" },
        { "tipe": "paragraph", "text": "$P(\\text{genap}) = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(A) = 0{,}4$, $P(B) = 0{,}5$, dan $A$, $B$ saling bebas. Nilai $P(A \\cup B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}6$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}7$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}8$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}9$" } ],
        [ { "tipe": "paragraph", "text": "$1{,}0$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Saling bebas: $P(A \\cap B) = 0{,}4 \\cdot 0{,}5 = 0{,}2$" },
        { "tipe": "paragraph", "text": "$P(A \\cup B) = 0{,}4 + 0{,}5 - 0{,}2 = 0{,}7$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
