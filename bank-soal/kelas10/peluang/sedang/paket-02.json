{
  "id": "bs-k10-pel-s-02",
  "nama": "Bank Soal Sedang - Paket 2",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang aturan perkalian dan kejadian saling bebas",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-s-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua koin dilempar bersamaan. Peluang muncul angka pada koin pertama DAN gambar pada koin kedua adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian saling bebas: $P = P(A) \\cdot P(B) = \\dfrac{1}{2} \\cdot \\dfrac{1}{2} = \\dfrac{1}{4}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(A) = 0{,}5$, $P(B) = 0{,}4$. Jika $A$ dan $B$ saling bebas, maka $P(A \\cap B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}10$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}20$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}30$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}45$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}90$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Saling bebas: $P(A \\cap B) = P(A) \\cdot P(B)$" },
        { "tipe": "paragraph", "text": "$= 0{,}5 \\cdot 0{,}4 = 0{,}2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar dua kali. Peluang muncul mata $6$ pada lemparan pertama DAN mata $6$ pada lemparan kedua adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{18}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kedua lemparan saling bebas." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{1}{6} \\cdot \\dfrac{1}{6} = \\dfrac{1}{36}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang Ali lulus ujian adalah $0{,}8$ dan peluang Budi lulus adalah $0{,}7$. Peluang keduanya lulus adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}15$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}50$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}56$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}70$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}80$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Saling bebas: $P = 0{,}8 \\cdot 0{,}7 = 0{,}56$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang Ali lulus ujian adalah $0{,}8$ dan peluang Budi lulus adalah $0{,}7$. Peluang keduanya TIDAK lulus adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}02$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}04$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}06$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}08$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{Ali tidak lulus}) = 0{,}2$, $P(\\text{Budi tidak lulus}) = 0{,}3$" },
        { "tipe": "paragraph", "text": "$P = 0{,}2 \\cdot 0{,}3 = 0{,}06$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar bersamaan. Peluang muncul mata dadu $2$ pada dadu pertama DAN mata dadu $5$ pada dadu kedua adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{18}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = \\dfrac{1}{6} \\cdot \\dfrac{1}{6} = \\dfrac{1}{36}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 5 bola merah dan 3 bola putih. Diambil satu bola, dicatat warna, lalu dikembalikan. Peluang terambil merah pada pengambilan pertama DAN putih pada pengambilan kedua adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{56}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena dikembalikan, kedua pengambilan saling bebas." },
        { "tipe": "paragraph", "text": "$P(\\text{merah}) = \\dfrac{5}{8}$, $P(\\text{putih}) = \\dfrac{3}{8}$" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{5}{8} \\cdot \\dfrac{3}{8} = \\dfrac{15}{64}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua kejadian $A$ dan $B$ saling bebas. Jika $P(A) = \\dfrac{1}{2}$ dan $P(A \\cap B) = \\dfrac{1}{6}$, maka $P(B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A \\cap B) = P(A) \\cdot P(B)$" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{6} = \\dfrac{1}{2} \\cdot P(B)$" },
        { "tipe": "paragraph", "text": "$P(B) = \\dfrac{1/6}{1/2} = \\dfrac{1}{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu pesawat berangkat tepat waktu adalah $0{,}9$. Peluang dua pesawat berbeda berangkat tepat waktu adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}18$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}72$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}81$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}90$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}99$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = 0{,}9 \\cdot 0{,}9 = 0{,}81$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan tiga koin, peluang muncul angka pada koin pertama, angka pada koin kedua, dan gambar pada koin ketiga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = \\dfrac{1}{2} \\cdot \\dfrac{1}{2} \\cdot \\dfrac{1}{2} = \\dfrac{1}{8}$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
