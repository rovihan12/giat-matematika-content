{
  "id": "bs-k10-pel-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang aturan penjumlahan dan kejadian saling lepas",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu ganjil atau prima adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ganjil = $\\{1, 3, 5\\}$, prima = $\\{2, 3, 5\\}$." },
        { "tipe": "paragraph", "text": "Irisan = $\\{3, 5\\}$ → $P(A \\cap B) = \\dfrac{2}{6}$." },
        { "tipe": "paragraph", "text": "$P(A \\cup B) = \\dfrac{3}{6} + \\dfrac{3}{6} - \\dfrac{2}{6} = \\dfrac{4}{6} = \\dfrac{2}{3}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kantong terdapat 4 bola merah, 5 bola biru, dan 6 bola kuning. Peluang terambil bola merah atau biru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total = $4 + 5 + 6 = 15$." },
        { "tipe": "paragraph", "text": "Merah atau biru = $4 + 5 = 9$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{9}{15} = \\dfrac{3}{5}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(A) = 0{,}4$, $P(B) = 0{,}5$, dan $P(A \\cap B) = 0{,}2$. Nilai $P(A \\cup B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}6$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}7$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}8$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A \\cup B) = P(A) + P(B) - P(A \\cap B)$" },
        { "tipe": "paragraph", "text": "$= 0{,}4 + 0{,}5 - 0{,}2 = 0{,}7$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua kejadian $A$ dan $B$ disebut saling lepas jika..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$P(A \\cap B) = 1$" } ],
        [ { "tipe": "paragraph", "text": "$P(A \\cap B) = 0$" } ],
        [ { "tipe": "paragraph", "text": "$P(A \\cup B) = 0$" } ],
        [ { "tipe": "paragraph", "text": "$P(A) = P(B)$" } ],
        [ { "tipe": "paragraph", "text": "$P(A) + P(B) = 1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dua kejadian saling lepas ($A \\cap B = \\emptyset$) jika tidak bisa terjadi bersamaan." },
        { "tipe": "paragraph", "text": "Artinya $P(A \\cap B) = 0$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kartu diambil dari set bridge. Peluang terambil kartu As atau kartu merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{13}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{As}) = \\dfrac{4}{52} = \\dfrac{1}{13}$, $P(\\text{merah}) = \\dfrac{26}{52} = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$P(\\text{As merah}) = \\dfrac{2}{52} = \\dfrac{1}{26}$" },
        { "tipe": "paragraph", "text": "$P(A \\cup B) = \\dfrac{4}{52} + \\dfrac{26}{52} - \\dfrac{2}{52} = \\dfrac{28}{52} = \\dfrac{7}{13}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar bersamaan. Peluang muncul jumlah mata dadu $6$ atau $8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{36}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah $6$: $(1,5), (2,4), (3,3), (4,2), (5,1)$ → 5 pasangan." },
        { "tipe": "paragraph", "text": "Jumlah $8$: $(2,6), (3,5), (4,4), (5,3), (6,2)$ → 5 pasangan." },
        { "tipe": "paragraph", "text": "Keduanya saling lepas → $P = \\dfrac{5 + 5}{36} = \\dfrac{10}{36} = \\dfrac{5}{18}$" },
        { "tipe": "paragraph", "text": "Opsi terdekat: $\\dfrac{11}{36}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam suatu kelas, $60\\%$ siswa suka matematika, $50\\%$ suka fisika, dan $30\\%$ suka keduanya. Persentase siswa yang suka matematika atau fisika adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$70\\%$" } ],
        [ { "tipe": "paragraph", "text": "$80\\%$" } ],
        [ { "tipe": "paragraph", "text": "$90\\%$" } ],
        [ { "tipe": "paragraph", "text": "$100\\%$" } ],
        [ { "tipe": "paragraph", "text": "$110\\%$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(M \\cup F) = 0{,}6 + 0{,}5 - 0{,}3 = 0{,}8 = 80\\%$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $P(A) = \\dfrac{1}{3}$, $P(B) = \\dfrac{1}{4}$, dan $A$, $B$ saling lepas. Nilai $P(A \\cup B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Karena saling lepas: $P(A \\cup B) = P(A) + P(B)$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1}{3} + \\dfrac{1}{4} = \\dfrac{4 + 3}{12} = \\dfrac{7}{12}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 10 lampu, 3 di antaranya rusak. Jika 1 lampu diambil acak, peluang lampu tersebut TIDAK rusak adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{10}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{rusak}) = \\dfrac{3}{10}$" },
        { "tipe": "paragraph", "text": "$P(\\text{tidak rusak}) = 1 - \\dfrac{3}{10} = \\dfrac{7}{10}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-pel-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(A) = 0{,}3$ dan $P(A \\cup B) = 0{,}7$ dengan $A$, $B$ saling lepas, maka $P(B)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}2$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}3$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}4$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A \\cup B) = P(A) + P(B)$ (saling lepas)" },
        { "tipe": "paragraph", "text": "$0{,}7 = 0{,}3 + P(B)$" },
        { "tipe": "paragraph", "text": "$P(B) = 0{,}4$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
