{
  "id": "bs-k10-pel-m-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang ruang sampel dan peluang dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-m-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Ruang sampel dari percobaan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$S = \\{1, 2, 3, 4, 5, 6\\}$" } ],
        [ { "tipe": "paragraph", "text": "$S = \\{0, 1, 2, 3, 4, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$S = \\{1, 2, 3, 4, 5\\}$" } ],
        [ { "tipe": "paragraph", "text": "$S = \\{2, 4, 6\\}$" } ],
        [ { "tipe": "paragraph", "text": "$S = \\{1, 3, 5\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dadu memiliki 6 sisi bernomor $1$ sampai $6$." },
        { "tipe": "paragraph", "text": "Ruang sampel = semua kemungkinan hasil = $\\{1, 2, 3, 4, 5, 6\\}$, dengan $n(S) = 6$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah koin dilempar sekali. Peluang muncul sisi angka adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ruang sampel koin = $\\{A, G\\}$, $n(S) = 2$." },
        { "tipe": "paragraph", "text": "Kejadian muncul angka: $n(A) = 1$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{1}{2}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu $4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n(S) = 6$, kejadian muncul mata $4$: $n(A) = 1$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{1}{6}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu kejadian memiliki nilai antara..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1 \\leq P(A) \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq P(A) \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$0 < P(A) < 2$" } ],
        [ { "tipe": "paragraph", "text": "$-\\infty < P(A) < \\infty$" } ],
        [ { "tipe": "paragraph", "text": "$0 \\leq P(A) \\leq 100$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Peluang selalu bernilai antara $0$ dan $1$ (inklusif)." },
        { "tipe": "paragraph", "text": "$P(A) = 0$ berarti kejadian mustahil; $P(A) = 1$ berarti kejadian pasti terjadi." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang muncul mata dadu ganjil pada pelemparan sebuah dadu adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Mata dadu ganjil: $\\{1, 3, 5\\}$ → $n(A) = 3$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{3}{6} = \\dfrac{1}{2}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $P(A) = 0{,}3$, maka peluang komplemen kejadian $A$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}3$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}7$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}9$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A^c) = 1 - P(A) = 1 - 0{,}3 = 0{,}7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu lebih dari $4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Mata dadu lebih dari $4$: $\\{5, 6\\}$ → $n(A) = 2$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{6} = \\dfrac{1}{3}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua koin dilempar bersamaan. Ruang sampelnya memiliki anggota sebanyak..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ruang sampel = $\\{AA, AG, GA, GG\\}$ → $n(S) = 4$." },
        { "tipe": "paragraph", "text": "Secara umum, $n$ koin → $2^n$ anggota. Untuk 2 koin: $2^2 = 4$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang muncul tepat satu sisi angka pada pelemparan dua koin adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ruang sampel: $\\{AA, AG, GA, GG\\}$, $n(S) = 4$." },
        { "tipe": "paragraph", "text": "Tepat satu angka: $\\{AG, GA\\}$ → $n(A) = 2$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{4} = \\dfrac{1}{2}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kantong terdapat 5 bola merah dan 3 bola biru. Peluang terambil bola merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{8}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total bola = $5 + 3 = 8$ → $n(S) = 8$." },
        { "tipe": "paragraph", "text": "Bola merah: $n(A) = 5$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{5}{8}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
