{
  "id": "bs-k10-pel-m-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang peluang komplemen dan kejadian sederhana",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-m-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu bukan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Peluang muncul mata $3$: $P(A) = \\dfrac{1}{6}$." },
        { "tipe": "paragraph", "text": "$P(A^c) = 1 - \\dfrac{1}{6} = \\dfrac{5}{6}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu prima adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bilangan prima pada dadu: $\\{2, 3, 5\\}$ → $n(A) = 3$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{3}{6} = \\dfrac{1}{2}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu kelipatan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan $3$ pada dadu: $\\{3, 6\\}$ → $n(A) = 2$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{6} = \\dfrac{1}{3}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kotak terdapat 4 bola kuning, 3 bola hijau, dan 5 bola putih. Peluang terambil bola hijau adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total bola = $4 + 3 + 5 = 12$." },
        { "tipe": "paragraph", "text": "Bola hijau = $3$." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{3}{12} = \\dfrac{1}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar bersamaan. Banyak anggota ruang sampelnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dua dadu → $n(S) = 6 \\times 6 = 36$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan dua dadu, peluang muncul jumlah mata dadu $7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pasangan berjumlah $7$: $(1,6), (2,5), (3,4), (4,3), (5,2), (6,1)$ → $n(A) = 6$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{6}{36} = \\dfrac{1}{6}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kartu diambil dari satu set kartu bridge. Peluang terambil kartu As adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Satu set bridge = 52 kartu, kartu As ada 4." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{4}{52} = \\dfrac{1}{13}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang kejadian yang pasti terjadi adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\infty$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian pasti memiliki peluang $P(A) = 1$." },
        { "tipe": "paragraph", "text": "Sebaliknya, kejadian mustahil memiliki peluang $P(A) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah huruf dipilih secara acak dari kata \"MATEMATIKA\". Peluang terpilih huruf A adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{10}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kata \"MATEMATIKA\" terdiri dari 10 huruf: M-A-T-E-M-A-T-I-K-A." },
        { "tipe": "paragraph", "text": "Huruf A muncul 3 kali." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{3}{10}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang turun hujan pada suatu hari adalah $0{,}6$. Peluang tidak turun hujan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}2$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}3$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}4$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{tidak hujan}) = 1 - 0{,}6 = 0{,}4$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
