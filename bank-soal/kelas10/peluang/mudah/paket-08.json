{
  "id": "bs-k10-pel-m-08",
  "nama": "Bank Soal Mudah - Paket 8",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang peluang huruf, faktor bilangan, dan konteks kelas",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-m-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah huruf dipilih dari kata \"PELUANG\". Peluang terpilih huruf vokal adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{7}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kata \"PELUANG\" = 7 huruf: P-E-L-U-A-N-G." },
        { "tipe": "paragraph", "text": "Vokal: E, U, A $\\rightarrow n(A) = 3$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{3}{7}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu faktor dari $6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Faktor dari $6$: $\\{1, 2, 3, 6\\} \\rightarrow n(A) = 4$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{4}{6} = \\dfrac{2}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kantong terdapat 6 bola merah dan 4 bola putih. Peluang terambil bola putih adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total = $6 + 4 = 10$." },
        { "tipe": "paragraph", "text": "$P(\\text{putih}) = \\dfrac{4}{10} = \\dfrac{2}{5}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga koin dilempar bersamaan. Banyak anggota ruang sampelnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n(S) = 2^3 = 8$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang muncul ketiganya angka pada pelemparan tiga koin adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian $\\{AAA\\} \\rightarrow n(A) = 1$, $n(S) = 8$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{1}{8}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kelas terdapat 20 siswa putra dan 15 siswa putri. Seorang siswa dipilih secara acak. Peluang terpilih siswa putra adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total = $20 + 15 = 35$." },
        { "tipe": "paragraph", "text": "$P(\\text{putra}) = \\dfrac{20}{35} = \\dfrac{4}{7}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu kejadian $A$ adalah $\\dfrac{3}{5}$. Peluang komplemennya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A^c) = 1 - \\dfrac{3}{5} = \\dfrac{2}{5}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bilangan dipilih dari $\\{1, 2, 3, ..., 15\\}$. Peluang terpilih bilangan kelipatan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan $3$ dari $1$ s.d. $15$: $\\{3, 6, 9, 12, 15\\} \\rightarrow n(A) = 5$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{5}{15} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah huruf dipilih dari kata \"STATISTIKA\". Peluang terpilih huruf S adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kata \"STATISTIKA\" = 10 huruf: S-T-A-T-I-S-T-I-K-A." },
        { "tipe": "paragraph", "text": "Huruf S muncul 2 kali." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{2}{10} = \\dfrac{1}{5}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu kejadian $A$ adalah $\\dfrac{1}{4}$. Peluang komplemennya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A^c) = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
