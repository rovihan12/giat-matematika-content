{
  "id": "bs-k10-pel-m-10",
  "nama": "Bank Soal Mudah - Paket 10",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran tentang peluang dasar dan pelengkap",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-pel-m-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah huruf dipilih secara acak dari kata \"MATEMATIKA\". Peluang terpilih huruf M adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kata \"MATEMATIKA\" terdiri dari 10 huruf: M-A-T-E-M-A-T-I-K-A." },
        { "tipe": "paragraph", "text": "Banyak huruf M = 2, sehingga $n(A) = 2$ dan $n(S) = 10$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{10} = \\dfrac{1}{5}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu prima adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Mata dadu prima: $\\{2, 3, 5\\} \\rightarrow n(A) = 3$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{3}{6} = \\dfrac{1}{2}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kantong terdapat 5 kelereng merah, 3 kelereng biru, dan 2 kelereng hijau. Peluang terambil kelereng merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total kelereng = $5 + 3 + 2 = 10$." },
        { "tipe": "paragraph", "text": "$P(\\text{merah}) = \\dfrac{5}{10} = \\dfrac{1}{2}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua koin dilempar bersamaan. Peluang muncul paling sedikit satu angka adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ruang sampel 2 koin: $\\{AA, AG, GA, GG\\} \\rightarrow n(S) = 4$." },
        { "tipe": "paragraph", "text": "Paling sedikit satu angka: $\\{AA, AG, GA\\} \\rightarrow n(A) = 3$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{3}{4}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang seorang siswa lulus ujian adalah $0,82$. Peluang siswa tersebut tidak lulus ujian adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0,18$" } ],
        [ { "tipe": "paragraph", "text": "$0,28$" } ],
        [ { "tipe": "paragraph", "text": "$0,32$" } ],
        [ { "tipe": "paragraph", "text": "$0,78$" } ],
        [ { "tipe": "paragraph", "text": "$0,82$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{tidak lulus}) = 1 - P(\\text{lulus}) = 1 - 0,82 = 0,18$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bilangan dipilih acak dari $\\{1, 2, 3, ..., 20\\}$. Peluang terpilih bilangan kelipatan $4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan $4$ dari $1$ s.d. $20$: $\\{4, 8, 12, 16, 20\\} \\rightarrow n(A) = 5$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{5}{20} = \\dfrac{1}{4}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang besok turun hujan adalah $\\dfrac{3}{7}$. Peluang besok tidak turun hujan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{7}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{tidak hujan}) = 1 - \\dfrac{3}{7} = \\dfrac{4}{7}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kartu diambil dari satu set kartu bridge. Peluang terambil kartu bernomor $10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kartu bernomor $10$ berjumlah $4$ lembar (hati, keriting, sekop, wajik)." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{4}{52} = \\dfrac{1}{13}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan sebuah dadu, peluang muncul mata dadu kurang dari $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Mata dadu kurang dari $3$: $\\{1, 2\\} \\rightarrow n(A) = 2$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{6} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu kejadian $E$ adalah $\\dfrac{5}{9}$. Peluang kejadian komplemen $E^c$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{9}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(E^c) = 1 - \\dfrac{5}{9} = \\dfrac{4}{9}$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
