{
  "id": "bs-k10-pel-m-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran tentang peluang dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu $1$ atau $2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian $\\{1, 2\\}$ → $n(A) = 2$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{6} = \\dfrac{1}{3}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua buah koin dilempar. Peluang muncul keduanya gambar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ruang sampel: $\\{AA, AG, GA, GG\\}$ → $n(S) = 4$." },
        { "tipe": "paragraph", "text": "Kejadian $\\{GG\\}$ → $n(A) = 1$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{1}{4}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam kantong terdapat 3 bola merah, 4 bola biru, dan 5 bola hijau. Peluang terambil bola biru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total = $3 + 4 + 5 = 12$." },
        { "tipe": "paragraph", "text": "$P(\\text{biru}) = \\dfrac{4}{12} = \\dfrac{1}{3}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan dua dadu, peluang muncul jumlah mata dadu $8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pasangan berjumlah $8$: $(2,6), (3,5), (4,4), (5,3), (6,2)$ → $n(A) = 5$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{5}{36}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang kejadian mustahil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian mustahil tidak mungkin terjadi → $P(A) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kartu diambil dari satu set kartu bridge. Peluang terambil kartu bergambar (J, Q, K) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{13}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kartu bergambar J, Q, K = $3 \\times 4$ jenis = 12 kartu." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{12}{52} = \\dfrac{3}{13}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang hari ini hujan adalah $\\dfrac{2}{5}$. Peluang hari ini tidak hujan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{tidak hujan}) = 1 - \\dfrac{2}{5} = \\dfrac{3}{5}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bilangan dipilih dari $\\{1, 2, 3, ..., 15\\}$. Peluang terpilih bilangan kelipatan $3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan $3$ dari $1$ s.d. $15$: $\\{3, 6, 9, 12, 15\\}$ → $n(A) = 5$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{5}{15} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah huruf dipilih dari kata \"STATISTIKA\". Peluang terpilih huruf S adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kata \"STATISTIKA\" = 10 huruf: S-T-A-T-I-S-T-I-K-A." },
        { "tipe": "paragraph", "text": "Huruf S muncul 2 kali." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{2}{10} = \\dfrac{1}{5}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu kejadian $A$ adalah $\\dfrac{1}{4}$. Peluang komplemennya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(A^c) = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}