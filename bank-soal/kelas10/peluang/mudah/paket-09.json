{
  "id": "bs-k10-pel-m-09",
  "nama": "Bank Soal Mudah - Paket 9",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang peluang pelengkap dan kombinasi dadu",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-pel-m-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar bersamaan. Peluang muncul jumlah mata dadu $5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{18}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pasangan berjumlah $5$: $(1,4), (2,3), (3,2), (4,1) \\rightarrow n(A) = 4$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{4}{36} = \\dfrac{1}{9}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang muncul mata dadu berjumlah $10$ pada pelemparan dua dadu adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{36}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{18}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pasangan berjumlah $10$: $(4,6), (5,5), (6,4) \\rightarrow n(A) = 3$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{3}{36} = \\dfrac{1}{12}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu $1$ atau $2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian $\\{1, 2\\} \\rightarrow n(A) = 2$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{6} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam kantong terdapat 3 bola merah, 4 bola biru, dan 5 bola hijau. Peluang terambil bola biru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total = $3 + 4 + 5 = 12$." },
        { "tipe": "paragraph", "text": "$P(\\text{biru}) = \\dfrac{4}{12} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang kejadian mustahil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-1$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian mustahil tidak mungkin terjadi $\\rightarrow P(A) = 0$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan tiga koin, peluang muncul paling sedikit satu gambar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Gunakan komplemen: kejadian $\\{$tidak ada gambar$\\}$ = semua angka $\\{AAA\\}$." },
        { "tipe": "paragraph", "text": "$P(AAA) = \\dfrac{1}{8}$." },
        { "tipe": "paragraph", "text": "$P(\\text{paling sedikit satu gambar}) = 1 - \\dfrac{1}{8} = \\dfrac{7}{8}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada pelemparan dua dadu, peluang muncul mata dadu pertama ganjil dan mata dadu kedua genap adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Mata dadu ganjil: $\\{1, 3, 5\\} \\rightarrow P = \\dfrac{3}{6} = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "Mata dadu genap: $\\{2, 4, 6\\} \\rightarrow P = \\dfrac{3}{6} = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "Peluang gabungan = $\\dfrac{1}{2} \\times \\dfrac{1}{2} = \\dfrac{1}{4}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kartu diambil dari satu set kartu bridge. Peluang terambil kartu As adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah kartu As = 4, total kartu = 52." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{4}{52} = \\dfrac{1}{13}$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu kejadian pasti (mutlak terjadi) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kejadian pasti/mutlak selalu memiliki peluang bernilai $1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-pel-m-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Peluang muncul mata dadu prima ganjil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Mata dadu prima ganjil: $\\{3, 5\\} \\rightarrow n(A) = 2$." },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{2}{6} = \\dfrac{1}{3}$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
