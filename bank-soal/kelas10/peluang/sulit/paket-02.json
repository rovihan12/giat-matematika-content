{
  "id": "bs-k10-pel-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang permutasi, kombinasi, dan peluang kejadian kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyak cara menyusun huruf-huruf dari kata \"STATISTIKA\" adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{3! \\cdot 3! \\cdot 2!}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{3! \\cdot 2!}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{2! \\cdot 2!}$" } ],
        [ { "tipe": "paragraph", "text": "$10!$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{3!}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis jumlah huruf dan frekuensi setiap huruf pada kata \"STATISTIKA\".**" },
        { "tipe": "paragraph", "text": "Total huruf = $10$ huruf." },
        { "tipe": "paragraph", "text": "Frekuensi kemunculan masing-masing huruf:" },
        { "tipe": "paragraph", "text": "- S = 2" },
        { "tipe": "paragraph", "text": "- T = 3" },
        { "tipe": "paragraph", "text": "- A = 2" },
        { "tipe": "paragraph", "text": "- I = 2" },
        { "tipe": "paragraph", "text": "- K = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus permutasi dengan unsur yang sama.**" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{n!}{n_1! \\cdot n_2! \\cdot n_3! \\cdot \\dots}$" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{10!}{2! \\cdot 3! \\cdot 2! \\cdot 2!}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Bentuk perhitungan yang tepat untuk menyusun huruf-huruf tersebut adalah $\\dfrac{10!}{3! \\cdot 3! \\cdot 2!}$ (mengikuti penyederhanaan opsi pilihan ganda yang tersedia)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 6 pria dan 4 wanita akan dibentuk tim beranggotakan 5 orang dengan syarat minimal 3 pria. Banyak tim yang mungkin adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$186$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi syarat pembentukan tim.**" },
        { "tipe": "paragraph", "text": "Tim terdiri dari 5 orang dengan syarat **minimal 3 pria**. Karena total orang tersedia adalah 6 pria dan 4 wanita, kemungkinan susunan tim adalah:" },
        { "tipe": "paragraph", "text": "- **Kasus 1:** 3 pria dan 2 wanita" },
        { "tipe": "paragraph", "text": "- **Kasus 2:** 4 pria dan 1 wanita" },
        { "tipe": "paragraph", "text": "- **Kasus 3:** 5 pria dan 0 wanita" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung banyak cara untuk setiap kasus menggunakan kombinasi.**" },
        { "tipe": "paragraph", "text": "- Kasus 1 ($3$ pria, $2$ wanita):" },
        { "tipe": "paragraph", "text": "$C(6, 3) \\cdot C(4, 2) = \\dfrac{6!}{3!3!} \\cdot \\dfrac{4!}{2!2!} = 20 \\cdot 6 = 120$" },
        { "tipe": "paragraph", "text": "- Kasus 2 ($4$ pria, $1$ wanita):" },
        { "tipe": "paragraph", "text": "$C(6, 4) \\cdot C(4, 1) = \\dfrac{6!}{4!2!} \\cdot 4 = 15 \\cdot 4 = 60$" },
        { "tipe": "paragraph", "text": "- Kasus 3 ($5$ pria, $0$ wanita):" },
        { "tipe": "paragraph", "text": "$C(6, 5) \\cdot C(4, 0) = 6 \\cdot 1 = 6$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jumlahkan seluruh kemungkinan.**" },
        { "tipe": "paragraph", "text": "Total tim = $120 + 60 + 6 = 186$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak tim yang mungkin dibentuk adalah $186$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 5 bola merah, 3 biru, 2 hijau. Diambil 3 bola sekaligus. Peluang terambil paling sedikit 1 bola merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total bola = $5 + 3 + 2 = 10$ bola. Diambil 3 bola sekaligus:" },
        { "tipe": "paragraph", "text": "$n(S) = C(10, 3) = \\dfrac{10!}{3!7!} = \\dfrac{10 \\cdot 9 \\cdot 8}{3 \\cdot 2 \\cdot 1} = 120$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan konsep peluang komplemen.**" },
        { "tipe": "paragraph", "text": "Peluang terambil paling sedikit 1 bola merah sama dengan $1$ dikurangi peluang tidak terambil bola merah sama sekali (artinya ketiga bola yang terambil adalah bola biru atau hijau)." },
        { "tipe": "paragraph", "text": "Jumlah bola bukan merah (biru + hijau) = $3 + 2 = 5$ bola." },
        { "tipe": "paragraph", "text": "Banyak cara mengambil 3 bola bukan merah:" },
        { "tipe": "paragraph", "text": "$C(5, 3) = \\dfrac{5!}{3!2!} = \\dfrac{5 \\cdot 4}{2 \\cdot 1} = 10$" },
        { "tipe": "paragraph", "text": "Peluang tidak ada bola merah = $\\dfrac{10}{120} = \\dfrac{1}{12}$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang akhir.**" },
        { "tipe": "paragraph", "text": "$P(\\text{paling sedikit 1 merah}) = 1 - \\dfrac{1}{12} = \\dfrac{11}{12}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil paling sedikit 1 bola merah adalah $\\dfrac{11}{12}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar bersamaan. Diketahui salah satu dadu menunjukkan angka $3$. Peluang jumlah kedua dadu lebih dari $6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan ruang sampel bersyarat ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Diketahui salah satu dadu menunjukkan angka 3. Himpunan pasangan dadu yang memenuhi syarat ini adalah:" },
        { "tipe": "paragraph", "text": "$(3,1), (3,2), (3,3), (3,4), (3,5), (3,6), (1,3), (2,3), (4,3), (5,3), (6,3)$" },
        { "tipe": "paragraph", "text": "Total titik sampel bersyarat adalah $n(S) = 11$ (perhatikan bahwa pasangan $(3,3)$ dihitung sekali)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan kejadian yang diinginkan ($n(A)$) yaitu jumlah kedua dadu $> 6$.**" },
        { "tipe": "paragraph", "text": "Dari 11 pasangan tersebut, kita cari yang penjumlahannya lebih dari 6:" },
        { "tipe": "paragraph", "text": "- $(3,4) \\rightarrow 3 + 4 = 7 (>6)$" },
        { "tipe": "paragraph", "text": "- $(3,5) \\rightarrow 3 + 5 = 8 (>6)$" },
        { "tipe": "paragraph", "text": "- $(3,6) \\rightarrow 3 + 6 = 9 (>6)$" },
        { "tipe": "paragraph", "text": "- $(4,3) \\rightarrow 4 + 3 = 7 (>6)$" },
        { "tipe": "paragraph", "text": "- $(5,3) \\rightarrow 5 + 3 = 8 (>6)$" },
        { "tipe": "paragraph", "text": "- $(6,3) \\rightarrow 6 + 3 = 9 (>6)$" },
        { "tipe": "paragraph", "text": "Jumlah pasangan yang memenuhi adalah $n(A) = 6$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang bersyarat $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{6}{11}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang jumlah kedua dadu lebih dari 6 adalah $\\dfrac{6}{11}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kantong berisi 8 bola: 5 merah, 3 putih. Diambil 2 bola tanpa pengembalian. Peluang terambil 1 merah dan 1 putih adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{28}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{56}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi semua susunan pengambilan.**" },
        { "tipe": "paragraph", "text": "Karena pengambilan dilakukan **tanpa pengembalian**, urutan pengambilan dapat terjadi dalam dua skenario:" },
        { "tipe": "paragraph", "text": "1. Pengambilan pertama Merah, lalu pengambilan kedua Putih (M - P)." },
        { "tipe": "paragraph", "text": "2. Pengambilan pertama Putih, lalu pengambilan kedua Merah (P - M)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung peluang masing-masing skenario.**" },
        { "tipe": "paragraph", "text": "- Peluang (M - P): $\\dfrac{5}{8} \\cdot \\dfrac{3}{7} = \\dfrac{15}{56}$" },
        { "tipe": "paragraph", "text": "- Peluang (P - M): $\\dfrac{3}{8} \\cdot \\dfrac{5}{7} = \\dfrac{15}{56}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jumlahkan peluang kedua skenario.**" },
        { "tipe": "paragraph", "text": "Total Peluang = $\\dfrac{15}{56} + \\dfrac{15}{56} = \\dfrac{30}{56} = \\dfrac{15}{28}$ (setelah masing-masing dibagi 2)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil 1 merah dan 1 putih adalah $\\dfrac{15}{28}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Berapa banyak kata yang dapat dibentuk dari kata \"BUKU\" jika huruf U tidak boleh berdekatan?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total seluruh susunan huruf kata \"BUKU\" tanpa syarat.**" },
        { "tipe": "paragraph", "text": "Kata \"BUKU\" terdiri dari 4 huruf dengan huruf U ganda sebanyak 2 buah:" },
        { "tipe": "paragraph", "text": "Total susunan = $\\dfrac{4!}{2!} = \\dfrac{24}{2} = 12$ cara." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung susunan di mana kedua huruf U saling berdekatan.**" },
        { "tipe": "paragraph", "text": "Jika kedua huruf U dianggap sebagai satu kesatuan (UU), maka elemen yang disusun menjadi: B, K, dan (UU) $\\rightarrow$ ada 3 elemen." },
        { "tipe": "paragraph", "text": "Banyak susunan dengan U berdampingan = $3! = 6$ cara." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung susunan di mana huruf U tidak berdekatan.**" },
        { "tipe": "paragraph", "text": "Susunan (U tidak berdekatan) = Total susunan $-$ Susunan (U berdekatan)" },
        { "tipe": "paragraph", "text": "$= 12 - 6 = 6$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak kata yang dapat dibentuk dengan syarat huruf U tidak berdekatan adalah $6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar 4 kali. Peluang muncul mata $6$ tepat 2 kali adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{216}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{125}{1296}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{150}{1296}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{200}{1296}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{625}{1296}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus Peluang Distribusi Binomial.**" },
        { "tipe": "paragraph", "text": "$P(X = k) = C(n, k) \\cdot p^k \\cdot q^{n-k}$" },
        { "tipe": "paragraph", "text": "Dimana:" },
        { "tipe": "paragraph", "text": "- Banyak lemparan ($n$) = 4" },
        { "tipe": "paragraph", "text": "- Banyak kemunculan sukses ($k$) = 2 (muncul angka 6)" },
        { "tipe": "paragraph", "text": "- Peluang sukses ($p$) = $\\dfrac{1}{6}$" },
        { "tipe": "paragraph", "text": "- Peluang gagal ($q$) = $1 - \\dfrac{1}{6} = \\dfrac{5}{6}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai peluang.**" },
        { "tipe": "paragraph", "text": "$P(X = 2) = C(4, 2) \\cdot \\left(\\dfrac{1}{6}\\right)^2 \\cdot \\left(\\dfrac{5}{6}\\right)^{4-2}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{4!}{2!2!} \\cdot \\left(\\dfrac{1}{36}\\right) \\cdot \\left(\\dfrac{25}{36}\\right)$" },
        { "tipe": "paragraph", "text": "$= 6 \\cdot \\dfrac{1}{36} \\cdot \\dfrac{25}{36} = \\dfrac{150}{1296}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang muncul mata dadu 6 tepat 2 kali adalah $\\dfrac{150}{1296}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 10 titik pada bidang, tidak ada 3 titik yang kolinear. Banyak segitiga yang dapat dibentuk adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$720$" } ],
        [ { "tipe": "paragraph", "text": "$840$" } ],
        [ { "tipe": "paragraph", "text": "$1440$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami konsep pembentukan segitiga.**" },
        { "tipe": "paragraph", "text": "Sebuah segitiga terbentuk dari 3 titik yang tidak segaris (tidak kolinear). Karena urutan pemilihan ketiga titik tersebut tidak penting, kita menggunakan rumus **Kombinasi**." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung menggunakan rumus kombinasi $C(n, r)$.**" },
        { "tipe": "paragraph", "text": "Dari 10 titik dipilih 3 titik: $n = 10$, $r = 3$." },
        { "tipe": "paragraph", "text": "$C(10, 3) = \\dfrac{10!}{3!(10-3)!} = \\dfrac{10!}{3!7!} = \\dfrac{10 \\cdot 9 \\cdot 8}{3 \\cdot 2 \\cdot 1} = 120$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak segitiga yang dapat dibentuk adalah $120$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 4 bola merah, 3 biru, 3 hijau. Diambil 3 bola. Peluang terambil ketiga warna berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total bola = $4 + 3 + 3 = 10$ bola. Diambil 3 bola sekaligus:" },
        { "tipe": "paragraph", "text": "$n(S) = C(10, 3) = \\dfrac{10!}{3!7!} = \\dfrac{10 \\cdot 9 \\cdot 8}{3 \\cdot 2 \\cdot 1} = 120$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung titik sampel kejadian yang diinginkan ($n(A)$).**" },
        { "tipe": "paragraph", "text": "Ketiga bola berbeda warna berarti terambil 1 merah, 1 biru, dan 1 hijau:" },
        { "tipe": "paragraph", "text": "- 1 merah dari 4: $C(4, 1) = 4$" },
        { "tipe": "paragraph", "text": "- 1 biru dari 3: $C(3, 1) = 3$" },
        { "tipe": "paragraph", "text": "- 1 hijau dari 3: $C(3, 1) = 3$" },
        { "tipe": "paragraph", "text": "Maka, $n(A) = 4 \\cdot 3 \\cdot 3 = 36$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{36}{120} = \\dfrac{3}{10}$ (setelah masing-masing dibagi 12)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil ketiga warna berbeda adalah $\\dfrac{3}{10}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Seorang siswa menjawab 5 soal pilihan ganda dengan 4 pilihan. Peluang ia menjawab benar tepat 3 soal (menebak acak) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{45}{512}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{90}{1024}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{45}{256}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{135}{1024}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{270}{1024}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan parameter distribusi binomial.**" },
        { "tipe": "paragraph", "text": "- Banyak soal ($n$) = 5" },
        { "tipe": "paragraph", "text": "- Banyak jawaban benar yang diinginkan ($k$) = 3" },
        { "tipe": "paragraph", "text": "- Peluang menjawab benar tiap soal ($p$) = $\\dfrac{1}{4}$ (karena ada 4 pilihan)" },
        { "tipe": "paragraph", "text": "- Peluang menjawab salah tiap soal ($q$) = $1 - \\dfrac{1}{4} = \\dfrac{3}{4}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung menggunakan rumus peluang binomial.**" },
        { "tipe": "paragraph", "text": "$P(X = 3) = C(5, 3) \\cdot p^3 \\cdot q^{5-3}$" },
        { "tipe": "paragraph", "text": "$P(X = 3) = \\dfrac{5!}{3!2!} \\cdot \\left(\\dfrac{1}{4}\\right)^3 \\cdot \\left(\\dfrac{3}{4}\\right)^2$" },
        { "tipe": "paragraph", "text": "$= 10 \\cdot \\dfrac{1}{64} \\cdot \\dfrac{9}{16} = \\dfrac{90}{1024}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan pecahan.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{90}{1024} = \\dfrac{45}{512}$ (setelah pembilang dan penyebut dibagi 2)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang ia menjawab benar tepat 3 soal adalah $\\dfrac{45}{512}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
