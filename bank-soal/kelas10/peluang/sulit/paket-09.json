{
  "id": "bs-k10-pel-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang peluang bersyarat dan teorema Bayes sederhana",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak A berisi 3 bola merah dan 2 putih. Kotak B berisi 4 merah dan 3 putih. Sebuah kotak dipilih acak lalu diambil 1 bola. Peluang terambil bola merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{29}{70}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{41}{70}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{7}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan Aturan Peluang Total.**" },
        { "tipe": "paragraph", "text": "Peluang terambil bola merah merupakan gabungan dari peluang memilih Kotak A lalu mendapat bola merah, ditambah peluang memilih Kotak B lalu mendapat bola merah:" },
        { "tipe": "paragraph", "text": "$P(\\text{merah}) = P(A) \\cdot P(\\text{merah}|A) + P(B) \\cdot P(\\text{merah}|B)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung masing-masing komponen peluang.**" },
        { "tipe": "paragraph", "text": "- Peluang memilih Kotak A: $P(A) = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "- Peluang terambil merah dari Kotak A (isi: 3 merah, 2 putih $\\rightarrow$ total 5): $P(\\text{merah}|A) = \\dfrac{3}{5}$" },
        { "tipe": "paragraph", "text": "- Peluang memilih Kotak B: $P(B) = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "- Peluang terambil merah dari Kotak B (isi: 4 merah, 3 putih $\\rightarrow$ total 7): $P(\\text{merah}|B) = \\dfrac{4}{7}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Lakukan perhitungan akhir dengan menyamakan penyebut.**" },
        { "tipe": "paragraph", "text": "$P(\\text{merah}) = \\left(\\dfrac{1}{2} \\cdot \\dfrac{3}{5}\\right) + \\left(\\dfrac{1}{2} \\cdot \\dfrac{4}{7}\\right)$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{3}{10} + \\dfrac{2}{7} = \\dfrac{21}{70} + \\dfrac{20}{70} = \\dfrac{41}{70}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil bola merah adalah $\\dfrac{41}{70}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam suatu populasi, 60% laki-laki dan 40% perempuan. 5% laki-laki buta warna dan 0,25% perempuan buta warna. Peluang seseorang buta warna adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}031$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}040$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}041$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}050$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}055$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi persentase dan ubah ke bentuk desimal.**" },
        { "tipe": "paragraph", "text": "- Peluang laki-laki: $P(L) = 60\\% = 0{,}6$" },
        { "tipe": "paragraph", "text": "- Peluang perempuan: $P(P) = 40\\% = 0{,}4$" },
        { "tipe": "paragraph", "text": "- Peluang buta warna jika laki-laki: $P(BW|L) = 5\\% = 0{,}05$" },
        { "tipe": "paragraph", "text": "- Peluang buta warna jika perempuan: $P(BW|P) = 0{,}25\\% = 0{,}0025$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan rumus peluang total.**" },
        { "tipe": "paragraph", "text": "$P(\\text{buta warna}) = [P(L) \\cdot P(BW|L)] + [P(P) \\cdot P(BW|P)]$" },
        { "tipe": "paragraph", "text": "$P(\\text{buta warna}) = (0{,}6 \\cdot 0{,}05) + (0{,}4 \\cdot 0{,}0025)$" },
        { "tipe": "paragraph", "text": "$P(\\text{buta warna}) = 0{,}03 + 0{,}001 = 0{,}031$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang seseorang buta warna adalah $0{,}031$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 5 bola merah dan 3 putih. Diambil 2 bola satu per satu tanpa pengembalian. Diketahui bola kedua merah. Peluang bola pertama juga merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan Teorema Bayes untuk peluang bersyarat.**" },
        { "tipe": "paragraph", "text": "Kita ingin mencari $P(M_1 | M_2)$ (peluang bola pertama merah jika diketahui bola kedua merah):" },
        { "tipe": "paragraph", "text": "$P(M_1 | M_2) = \\dfrac{P(M_1 \\text{ dan } M_2)}{P(M_2)}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung peluang masing-masing skenario.**" },
        { "tipe": "paragraph", "text": "- Peluang bola pertama merah: $P(M_1) = \\dfrac{5}{8}$" },
        { "tipe": "paragraph", "text": "- Peluang bola kedua merah jika bola pertama merah: $P(M_2 | M_1) = \\dfrac{4}{7}$" },
        { "tipe": "paragraph", "text": "- Peluang bola pertama putih: $P(P_1) = \\dfrac{3}{8}$" },
        { "tipe": "paragraph", "text": "- Peluang bola kedua merah jika bola pertama putih: $P(M_2 | P_1) = \\dfrac{5}{7}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung total peluang bola kedua merah ($P(M_2)$).**" },
        { "tipe": "paragraph", "text": "$P(M_2) = [P(M_1) \\cdot P(M_2|M_1)] + [P(P_1) \\cdot P(M_2|P_1)]$" },
        { "tipe": "paragraph", "text": "$= \\left(\\dfrac{5}{8} \\cdot \\dfrac{4}{7}\\right) + \\left(\\dfrac{3}{8} \\cdot \\dfrac{5}{7}\\right) = \\dfrac{20}{56} + \\dfrac{15}{56} = \\dfrac{35}{56} = \\dfrac{5}{8}$" },
        { "tipe": "paragraph", "text": "**Langkah 4: Hitung nilai akhir Bayes.**" },
        { "tipe": "paragraph", "text": "$P(M_1 | M_2) = \\dfrac{P(M_1 \\text{ dan } M_2)}{P(M_2)} = \\dfrac{\\dfrac{20}{56}}{\\dfrac{35}{56}} = \\dfrac{20}{35} = \\dfrac{4}{7}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang bola pertama juga merah adalah $\\dfrac{4}{7}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah perusahaan memiliki 3 mesin. Mesin A memproduksi 50% produk dengan 2% cacat. Mesin B 30% dengan 3% cacat. Mesin C 20% dengan 4% cacat. Jika dipilih produk cacat, peluang berasal dari mesin A adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{13}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{10}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tuliskan informasi peluang tiap mesin dan tingkat kecacatannya.**" },
        { "tipe": "paragraph", "text": "- Mesin A: $P(A) = 0{,}5$, $P(\\text{cacat}|A) = 0{,}02$" },
        { "tipe": "paragraph", "text": "- Mesin B: $P(B) = 0{,}3$, $P(\\text{cacat}|B) = 0{,}03$" },
        { "tipe": "paragraph", "text": "- Mesin C: $P(C) = 0{,}2$, $P(\\text{cacat}|C) = 0{,}04$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung total peluang produk cacat ($P(\\text{cacat})$).**" },
        { "tipe": "paragraph", "text": "$P(\\text{cacat}) = [P(A) \\cdot P(\\text{cacat}|A)] + [P(B) \\cdot P(\\text{cacat}|B)] + [P(C) \\cdot P(\\text{cacat}|C)]$" },
        { "tipe": "paragraph", "text": "$= (0{,}5 \\cdot 0{,}02) + (0{,}3 \\cdot 0{,}03) + (0{,}2 \\cdot 0{,}04)$" },
        { "tipe": "paragraph", "text": "$= 0{,}01 + 0{,}009 + 0{,}008 = 0{,}027$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Gunakan Teorema Bayes untuk mencari $P(A|\\text{cacat})$.**" },
        { "tipe": "paragraph", "text": "$P(A|\\text{cacat}) = \\dfrac{P(A) \\cdot P(\\text{cacat}|A)}{P(\\text{cacat})} = \\dfrac{0{,}01}{0{,}027} = \\dfrac{10}{27}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang produk cacat tersebut berasal dari mesin A adalah $\\dfrac{10}{27}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam kotak terdapat 4 kunci, hanya 1 yang cocok. Kunci dicoba satu per satu tanpa pengembalian. Peluang kunci cocok ditemukan pada percobaan ketiga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pahami urutan kejadian percobaan.**" },
        { "tipe": "paragraph", "text": "Kunci cocok ditemukan pada percobaan ketiga berarti:" },
        { "tipe": "paragraph", "text": "- Percobaan 1: Gagal (salah)" },
        { "tipe": "paragraph", "text": "- Percobaan 2: Gagal (salah)" },
        { "tipe": "paragraph", "text": "- Percobaan 3: Berhasil (cocok)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung peluang setiap tahap tanpa pengembalian.**" },
        { "tipe": "paragraph", "text": "- Peluang gagal pertama: $\\dfrac{3}{4}$ (karena ada 3 kunci salah dari 4 kunci)" },
        { "tipe": "paragraph", "text": "- Peluang gagal kedua: $\\dfrac{2}{3}$ (sisa 2 kunci salah dari 3 kunci tersisa)" },
        { "tipe": "paragraph", "text": "- Peluang berhasil ketiga: $\\dfrac{1}{2}$ (sisa 1 kunci cocok dari 2 kunci tersisa)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kalikan seluruh peluang tahapan tersebut.**" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{3}{4} \\cdot \\dfrac{2}{3} \\cdot \\dfrac{1}{2} = \\dfrac{6}{24} = \\dfrac{1}{4}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang kunci cocok ditemukan pada percobaan ketiga adalah $\\dfrac{1}{4}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar. Diketahui hasil kali kedua mata dadu adalah bilangan genap. Peluang jumlah kedua mata dadu $\\geq 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{14}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{27}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan ruang sampel bersyarat ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Diketahui hasil kali kedua mata dadu adalah bilangan genap. Hasil kali ganjil hanya terjadi jika **keduanya ganjil** ($3 \\times 3 = 9$ kemungkinan dari total 36 kemungkinan)." },
        { "tipe": "paragraph", "text": "Maka, jumlah titik sampel hasil kali genap adalah $n(S) = 36 - 9 = 27$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan kejadian yang diinginkan ($n(A)$) yaitu jumlah kedua mata dadu $\\geq 8$ dan hasil kali genap.**" },
        { "tipe": "paragraph", "text": "- Seluruh pasangan dengan jumlah $\\geq 8$ ada 15 pasangan, yaitu:" },
        { "tipe": "paragraph", "text": "  $(2,6), (3,5), (3,6), (4,4), (4,5), (4,6), (5,3), (5,4), (5,5), (5,6), (6,2), (6,3), (6,4), (6,5), (6,6)$." },
        { "tipe": "paragraph", "text": "- Dari 15 pasangan tersebut, kurangi pasangan yang hasil kalinya ganjil (keduanya ganjil dengan jumlah $\\geq 8$), yaitu: $(3,5), (5,3), (5,5)$ sebanyak 3 pasangan." },
        { "tipe": "paragraph", "text": "- Banyak pasangan yang memenuhi adalah $n(A) = 15 - 3 = 12$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang bersyarat.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{12}{27}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang jumlah kedua mata dadu $\\geq 8$ adalah $\\dfrac{12}{27}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam suatu kelas, 40% siswa mengikuti les matematika. Dari yang ikut les, 80% lulus. Dari yang tidak ikut les, 50% lulus. Peluang siswa lulus adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}42$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}52$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}62$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}72$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}82$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi persentase setiap kelompok dan tingkat kelulusannya.**" },
        { "tipe": "paragraph", "text": "- Mengikuti les: $P(\\text{les}) = 40\\% = 0{,}4$ dengan peluang lulus $P(\\text{lulus}|\\text{les}) = 80\\% = 0{,}8$" },
        { "tipe": "paragraph", "text": "- Tidak mengikuti les: $P(\\text{tidak les}) = 60\\% = 0{,}6$ dengan peluang lulus $P(\\text{lulus}|\\text{tidak les}) = 50\\% = 0{,}5$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan aturan peluang total untuk menghitung total peluang lulus.**" },
        { "tipe": "paragraph", "text": "$P(\\text{lulus}) = [P(\\text{les}) \\cdot P(\\text{lulus}|\\text{les})] + [P(\\text{tidak les}) \\cdot P(\\text{lulus}|\\text{tidak les})]$" },
        { "tipe": "paragraph", "text": "$P(\\text{lulus}) = (0{,}4 \\cdot 0{,}8) + (0{,}6 \\cdot 0{,}5)$" },
        { "tipe": "paragraph", "text": "$P(\\text{lulus}) = 0{,}32 + 0{,}30 = 0{,}62$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang siswa lulus adalah $0{,}62$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 10 soal, seorang siswa harus menjawab 5 soal. Jika soal no. 1 wajib dijawab, banyak cara pemilihan soal adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$84$" } ],
        [ { "tipe": "paragraph", "text": "$126$" } ],
        [ { "tipe": "paragraph", "text": "$210$" } ],
        [ { "tipe": "paragraph", "text": "$252$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis syarat pemilihan soal.**" },
        { "tipe": "paragraph", "text": "Siswa harus menjawab 5 soal, dan soal nomor 1 **wajib dijawab**. Ini berarti siswa tinggal memilih sisa **4 soal** lagi dari sisa **9 soal** yang tersedia (karena total soal 10 dikurangi soal nomor 1 yang sudah pasti dipilih)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus kombinasi $C(n, r)$.**" },
        { "tipe": "paragraph", "text": "Dari 9 soal dipilih 4 soal: $n = 9$, $r = 4$." },
        { "tipe": "paragraph", "text": "$C(9, 4) = \dfrac{9!}{4!(9-4)!} = \dfrac{9!}{4!5!} = \dfrac{9 \\cdot 8 \\cdot 7 \\cdot 6}{4 \\cdot 3 \\cdot 2 \\cdot 1} = 126$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak cara pemilihan soal adalah $126$ cara." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kantong berisi 6 bola merah dan 4 putih. Diambil 2 bola satu per satu tanpa pengembalian. Peluang bola kedua putih jika bola pertama merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{7}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis kondisi setelah pengambilan pertama.**" },
        { "tipe": "paragraph", "text": "Awalnya terdapat 6 bola merah dan 4 putih (total 10 bola). Pengambilan pertama adalah bola merah dan **tidak dikembalikan**." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung sisa komposisi bola di dalam kantong.**" },
        { "tipe": "paragraph", "text": "- Sisa bola merah = $6 - 1 = 5$ bola" },
        { "tipe": "paragraph", "text": "- Sisa bola putih = $4$ bola" },
        { "tipe": "paragraph", "text": "- Total sisa bola = $5 + 4 = 9$ bola" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang terambil bola putih pada pengambilan kedua.**" },
        { "tipe": "paragraph", "text": "$P(\\text{putih}|\\text{merah pertama}) = \\dfrac{\\text{jumlah bola putih}}{\\text{total sisa bola}} = \\dfrac{4}{9}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang bola kedua putih jika bola pertama merah adalah $\\dfrac{4}{9}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 5 pria dan 4 wanita, akan dipilih 3 orang. Peluang terpilih sekurang-kurangnya 2 wanita adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{21}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{17}{42}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{19}{42}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total orang = $5 + 4 = 9$ orang. Dipilih 3 orang secara acak:" },
        { "tipe": "paragraph", "text": "$n(S) = C(9, 3) = \\dfrac{9!}{3!6!} = \\dfrac{9 \\cdot 8 \\cdot 7}{3 \\cdot 2 \\cdot 1} = 84$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung titik sampel kejadian yang diinginkan ($n(A)$).**" },
        { "tipe": "paragraph", "text": "Sekurang-kurangnya 2 wanita berarti kemungkinannya adalah (2 wanita dan 1 pria) atau (3 wanita):" },
        { "tipe": "paragraph", "text": "- **Kasus 1 (2 wanita, 1 pria):**" },
