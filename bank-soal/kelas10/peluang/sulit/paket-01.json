  "soal": [
    {
      "id": "bs-k10-pel-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kotak terdapat 5 bola merah dan 4 bola putih. Diambil 3 bola sekaligus. Peluang terambil 2 merah dan 1 putih adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{21}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{20}{42}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$) menggunakan rumus kombinasi.**" },
        { "tipe": "paragraph", "text": "Total bola = $5 + 4 = 9$ bola. Diambil 3 bola sekaligus secara acak:" },
        { "tipe": "paragraph", "text": "$n(S) = C(9, 3) = \\dfrac{9!}{3!(9-3)!} = \\dfrac{9 \\cdot 8 \\cdot 7}{3 \\cdot 2 \\cdot 1} = 84$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung titik sampel kejadian yang diinginkan ($n(A)$).**" },
        { "tipe": "paragraph", "text": "Terambil 2 bola merah dari 5 bola merah:" },
        { "tipe": "paragraph", "text": "$C(5, 2) = \\dfrac{5!}{2!(5-2)!} = \\dfrac{5 \\cdot 4}{2 \\cdot 1} = 10$" },
        { "tipe": "paragraph", "text": "Terambil 1 bola putih dari 4 bola putih:" },
        { "tipe": "paragraph", "text": "$C(4, 1) = \\dfrac{4!}{1!(4-1)!} = 4$" },
        { "tipe": "paragraph", "text": "Maka, $n(A) = 10 \\cdot 4 = 40$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang kejadian $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{40}{84} = \\dfrac{10}{21}$ (setelah masing-masing dibagi 4)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil 2 merah dan 1 putih adalah $\\dfrac{10}{21}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah panitia beranggotakan 4 orang akan dipilih dari 6 pria dan 5 wanita. Peluang panitia tersebut terdiri dari 2 pria dan 2 wanita adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{66}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{22}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{33}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total orang = $6 + 5 = 11$ orang. Dipilih 4 orang secara acak:" },
        { "tipe": "paragraph", "text": "$n(S) = C(11, 4) = \\dfrac{11!}{4!(11-4)!} = \\dfrac{11 \\cdot 10 \\cdot 9 \\cdot 8}{4 \\cdot 3 \\cdot 2 \\cdot 1} = 330$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung titik sampel kejadian yang diinginkan ($n(A)$).**" },
        { "tipe": "paragraph", "text": "Dipilih 2 pria dari 6 pria:" },
        { "tipe": "paragraph", "text": "$C(6, 2) = \\dfrac{6!}{2!(6-2)!} = \\dfrac{6 \\cdot 5}{2 \\cdot 1} = 15$" },
        { "tipe": "paragraph", "text": "Dipilih 2 wanita dari 5 wanita:" },
        { "tipe": "paragraph", "text": "$C(5, 2) = \\dfrac{5!}{2!(5-2)!} = \\dfrac{5 \\cdot 4}{2 \\cdot 1} = 10$" },
        { "tipe": "paragraph", "text": "Maka, $n(A) = 15 \\cdot 10 = 150$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang kejadian $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{150}{330} = \\dfrac{5}{11}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang panitia tersebut terdiri dari 2 pria dan 2 wanita adalah $\\dfrac{5}{11}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga koin dilempar bersamaan. Peluang muncul paling sedikit 2 angka adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{8}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan ruang sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Untuk pelemparan 3 koin, jumlah seluruh kemungkinan titik sampel adalah $n(S) = 2^3 = 8$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan titik sampel yang memenuhi syarat (paling sedikit 2 angka).**" },
        { "tipe": "paragraph", "text": "Paling sedikit 2 angka berarti bisa muncul 2 angka atau 3 angka:" },
        { "tipe": "paragraph", "text": "- Muncul 2 angka: $\\{AAG, AGA, GAA\\}$ (3 kejadian)" },
        { "tipe": "paragraph", "text": "- Muncul 3 angka: $\\{AAA\\}$ (1 kejadian)" },
        { "tipe": "paragraph", "text": "Maka, jumlah kejadian yang memenuhi adalah $n(A) = 3 + 1 = 4$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{4}{8} = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang muncul paling sedikit 2 angka adalah $\\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 10 siswa akan dipilih 3 siswa untuk menjadi ketua, sekretaris, dan bendahara. Banyak cara pemilihan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$480$" } ],
        [ { "tipe": "paragraph", "text": "$720$" } ],
        [ { "tipe": "paragraph", "text": "$1440$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi aturan pencacahan.**" },
        { "tipe": "paragraph", "text": "Karena posisi yang dipilih memiliki jabatan/urutan yang berbeda (ketua, sekretaris, bendahara), maka permasalahan ini diselesaikan menggunakan konsep **Permutasi**." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus permutasi $P(n, r)$.**" },
        { "tipe": "paragraph", "text": "Dari 10 siswa diambil 3 orang: $n = 10$, $r = 3$." },
        { "tipe": "paragraph", "text": "$P(10, 3) = \\dfrac{10!}{(10-3)!} = \\dfrac{10!}{7!} = 10 \\cdot 9 \\cdot 8 = 720$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak cara pemilihan pengurus tersebut adalah $720$ cara." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 8 siswa akan dipilih 3 siswa untuk mengikuti olimpiade. Banyak cara pemilihan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$112$" } ],
        [ { "tipe": "paragraph", "text": "$168$" } ],
        [ { "tipe": "paragraph", "text": "$336$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi aturan pencacahan.**" },
        { "tipe": "paragraph", "text": "Karena pemilihan 3 siswa untuk mengikuti olimpiade tidak memperhatikan urutan atau jabatan, maka permasalahan ini diselesaikan menggunakan konsep **Kombinasi**." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus kombinasi $C(n, r)$.**" },
        { "tipe": "paragraph", "text": "Dari 8 siswa dipilih 3 orang: $n = 8$, $r = 3$." },
        { "tipe": "paragraph", "text": "$C(8, 3) = \\dfrac{8!}{3!(8-3)!} = \\dfrac{8 \\cdot 7 \\cdot 6}{3 \\cdot 2 \\cdot 1} = 56$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak cara pemilihan adalah $56$ cara." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar 3 kali. Peluang muncul mata dadu $6$ paling sedikit satu kali adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{216}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{91}{216}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{125}{216}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{175}{216}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{215}{216}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan konsep peluang komplemen.**" },
        { "tipe": "paragraph", "text": "Peluang muncul mata dadu 6 paling sedikit satu kali dapat dihitung menggunakan rumus komplemen:" },
        { "tipe": "paragraph", "text": "$P(\\text{paling sedikit satu 6}) = 1 - P(\\text{tidak pernah muncul angka 6})$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung peluang tidak pernah muncul angka 6 dalam 3 lemparan.**" },
        { "tipe": "paragraph", "text": "Peluang bukan angka 6 dalam satu lemparan adalah $\\dfrac{5}{6}$." },
        { "tipe": "paragraph", "text": "Peluang tidak muncul angka 6 selama 3 lemparan berturut-turut:" },
        { "tipe": "paragraph", "text": "$P(\\text{tidak 6 semua}) = \\left(\\dfrac{5}{6}\\right)^3 = \\dfrac{125}{216}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang akhir.**" },
        { "tipe": "paragraph", "text": "$P(\\text{paling sedikit satu 6}) = 1 - \\dfrac{125}{216} = \\dfrac{216}{216} - \\dfrac{125}{216} = \\dfrac{91}{216}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang muncul mata dadu 6 paling sedikit satu kali adalah $\\dfrac{91}{216}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam sebuah kantong terdapat 6 kelereng merah, 4 biru, dan 5 hijau. Diambil 3 kelereng sekaligus. Peluang terambil ketiganya berbeda warna adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{24}{91}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{91}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{26}{91}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{91}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{30}{91}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total kelereng = $6 + 4 + 5 = 15$ kelereng. Diambil 3 kelereng sekaligus:" },
        { "tipe": "paragraph", "text": "$n(S) = C(15, 3) = \\dfrac{15!}{3!(15-3)!} = \\dfrac{15 \\cdot 14 \\cdot 13}{3 \\cdot 2 \\cdot 1} = 455$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung titik sampel kejadian yang diinginkan ($n(A)$).**" },
        { "tipe": "paragraph", "text": "Ketiganya berbeda warna berarti terambil 1 merah, 1 biru, dan 1 hijau:" },
        { "tipe": "paragraph", "text": "- 1 merah dari 6: $C(6, 1) = 6$" },
        { "tipe": "paragraph", "text": "- 1 biru dari 4: $C(4, 1) = 4$" },
        { "tipe": "paragraph", "text": "- 1 hijau dari 5: $C(5, 1) = 5$" },
        { "tipe": "paragraph", "text": "Maka, $n(A) = 6 \\cdot 4 \\cdot 5 = 120$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{120}{455} = \\dfrac{24}{91}$ (setelah masing-masing dibagi 5)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil ketiganya berbeda warna adalah $\\dfrac{24}{91}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Berapa banyak susunan berbeda dari huruf-huruf pada kata \"MATEMATIKA\"?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$151200$" } ],
        [ { "tipe": "paragraph", "text": "$302400$" } ],
        [ { "tipe": "paragraph", "text": "$604800$" } ],
        [ { "tipe": "paragraph", "text": "$3628800$" } ],
        [ { "tipe": "paragraph", "text": "$1209600$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis jumlah huruf dan frekuensi setiap huruf.**" },
        { "tipe": "paragraph", "text": "Kata \"MATEMATIKA\" terdiri dari $10$ huruf dengan rincian frekuensi kemunculan:" },
        { "tipe": "paragraph", "text": "- M = 2" },
        { "tipe": "paragraph", "text": "- A = 3" },
        { "tipe": "paragraph", "text": "- T = 2" },
        { "tipe": "paragraph", "text": "- E = 1" },
        { "tipe": "paragraph", "text": "- I = 1" },
        { "tipe": "paragraph", "text": "- K = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan rumus permutasi dengan unsur yang sama.**" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{n!}{n_1! \\cdot n_2! \\cdot n_3! \\cdot \\dots}$" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{10!}{2! \\cdot 3! \\cdot 2!} = \\dfrac{3.628.800}{2 \\cdot 6 \\cdot 2} = \\dfrac{3.628.800}{24} = 151.200$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak susunan huruf yang berbeda adalah $151.200$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 7 bola merah dan 5 bola putih. Diambil 3 bola sekaligus. Peluang terambil paling sedikit 2 merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{44}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{14}{22}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{21}{44}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total bola = $7 + 5 = 12$ bola. Diambil 3 bola sekaligus:" },
        { "tipe": "paragraph", "text": "$n(S) = C(12, 3) = \\dfrac{12!}{3!(12-3)!} = \\dfrac{12 \\cdot 11 \\cdot 10}{3 \\cdot 2 \\cdot 1} = 220$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung titik sampel kejadian yang diinginkan ($n(A)$).**" },
        { "tipe": "paragraph", "text": "Paling sedikit 2 merah berarti kemungkinannya adalah (2 merah dan 1 putih) atau (3 merah):" },
        { "tipe": "paragraph", "text": "- Kasus 1 (2 merah, 1 putih): $C(7, 2) \\cdot C(5, 1) = 21 \\cdot 5 = 105$" },
        { "tipe": "paragraph", "text": "- Kasus 2 (3 merah): $C(7, 3) = \\dfrac{7 \\cdot 6 \\cdot 5}{3 \\cdot 2 \\cdot 1} = 35$" },
        { "tipe": "paragraph", "text": "Maka, $n(A) = 105 + 35 = 140$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{140}{220} = \\dfrac{7}{11}$ (setelah masing-masing dibagi 20)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil paling sedikit 2 merah adalah $\\dfrac{7}{11}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari angka $1, 2, 3, 4, 5$ akan dibentuk bilangan 3 angka berbeda. Banyak bilangan ganjil yang dapat dibentuk adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis syarat bilangan ganjil.**" },
        { "tipe": "paragraph", "text": "Suatu bilangan bernilai ganjil jika angka satuannya ganjil. Dari angka $\\{1, 2, 3, 4, 5\\}$, angka yang ganjil adalah $\\{1, 3, 5\\}$ (ada 3 pilihan untuk posisi satuan)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan banyak pilihan untuk setiap posisi (aturan pengisian tempat).**" },
        { "tipe": "paragraph", "text": "- **Posisi Satuan:** Hanya boleh diisi angka ganjil $\\{1, 3, 5\\} \\rightarrow$ **3 pilihan**." },
        { "tipe": "paragraph", "text": "- **Posisi Ratusan:** Karena angka harus berbeda dan 1 angka sudah dipakai di satuan, sisa pilihan angka adalah $5 - 1 = 4 \\rightarrow$ **4 pilihan**." },
        { "tipe": "paragraph", "text": "- **Posisi Puluhan:** Karena 2 angka sudah dipakai di satuan dan ratusan, sisa pilihan angka adalah $5 - 2 = 3 \\rightarrow$ **3 pilihan**." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung total susunan bilangan.**" },
        { "tipe": "paragraph", "text": "Total bilangan = $\\text{Ratusan} \\times \\text{Puluhan} \\times \\text{Satuan} = 4 \\times 3 \\times 3 = 36$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak bilangan ganjil yang dapat dibentuk adalah $36$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
