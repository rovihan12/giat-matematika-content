{
  "id": "bs-k10-pel-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang permutasi, kombinasi, dan peluang kejadian kompleks",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-pel-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyak cara menyusun huruf-huruf dari kata \"STATISTIKA\" adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{2! \\cdot 3! \\cdot 2! \\cdot 2!}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{3! \\cdot 2!}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{2! \\cdot 2!}$" } ],
        [ { "tipe": "paragraph", "text": "$10!$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10!}{3!}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis jumlah huruf dan frekuensi setiap unsur yang sama.**" },
        { "tipe": "paragraph", "text": "Kata \"STATISTIKA\" terdiri dari $10$ huruf dengan rincian frekuensi kemunculan huruf yang sama:" },
        { "tipe": "paragraph", "text": "- S = 2" },
        { "tipe": "paragraph", "text": "- T = 3" },
        { "tipe": "paragraph", "text": "- A = 2" },
        { "tipe": "paragraph", "text": "- I = 2" },
        { "tipe": "paragraph", "text": "- K = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan rumus Permutasi dengan Unsur yang Sama.**" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{n!}{n_1! \\cdot n_2! \\cdot n_3! \\cdot n_4! \\cdot \\dots}$" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{10!}{2! \\cdot 3! \\cdot 2! \\cdot 2!}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak cara menyusun huruf-huruf tersebut adalah $\\dfrac{10!}{2! \\cdot 3! \\cdot 2! \\cdot 2!}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 6 pria dan 4 wanita akan dibentuk tim beranggotakan 5 orang dengan syarat minimal 3 pria. Banyak tim yang mungkin adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$186$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis ketentuan pembentukan tim.**" },
        { "tipe": "paragraph", "text": "Tim yang dipilih beranggotakan 5 orang dengan syarat **minimal 3 pria**. Dari 6 pria dan 4 wanita, kemungkinan susunan tim adalah:" },
        { "tipe": "paragraph", "text": "1. **3 Pria dan 2 Wanita**" },
        { "tipe": "paragraph", "text": "2. **4 Pria dan 1 Wanita**" },
        { "tipe": "paragraph", "text": "3. **5 Pria dan 0 Wanita**" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah kemungkinan untuk setiap kasus menggunakan kombinasi.**" },
        { "tipe": "paragraph", "text": "- **Kasus 1 (3 Pria, 2 Wanita):**" },
        { "tipe": "paragraph", "text": "  $C(6, 3) \\cdot C(4, 2) = \\dfrac{6!}{3!3!} \\cdot \\dfrac{4!}{2!2!} = 20 \\cdot 6 = 120$" },
        { "tipe": "paragraph", "text": "- **Kasus 2 (4 Pria, 1 Wanita):**" },
        { "tipe": "paragraph", "text": "  $C(6, 4) \\cdot C(4, 1) = \\dfrac{6!}{4!2!} \\cdot 4 = 15 \\cdot 4 = 60$" },
        { "tipe": "paragraph", "text": "- **Kasus 3 (5 Pria, 0 Wanita):**" },
        { "tipe": "paragraph", "text": "  $C(6, 5) \\cdot C(4, 0) = 6 \\cdot 1 = 6$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jumlahkan seluruh kemungkinan dari setiap kasus.**" },
        { "tipe": "paragraph", "text": "Total tim = $120 + 60 + 6 = 186$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak tim yang mungkin dibentuk adalah $186$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 5 bola merah, 3 biru, 2 hijau. Diambil 3 bola sekaligus. Peluang terambil paling sedikit 1 bola merah adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total bola = $5 + 3 + 2 = 10$ bola. Diambil 3 bola sekaligus:" },
        { "tipe": "paragraph", "text": "$n(S) = C(10, 3) = \\dfrac{10!}{3!7!} = \\dfrac{10 \\cdot 9 \\cdot 8}{3 \\cdot 2 \\cdot 1} = 120$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan konsep peluang komplemen.**" },
        { "tipe": "paragraph", "text": "Peluang terambil paling sedikit 1 bola merah sama dengan $1$ dikurangi peluang **tidak terambil bola merah sama sekali** (artinya ketiga bola yang terambil adalah bola selain merah, yaitu biru atau hijau)." },
        { "tipe": "paragraph", "text": "Jumlah bola selain merah = $3 \\text{ (biru)} + 2 \\text{ (hijau)} = 5$ bola." },
        { "tipe": "paragraph", "text": "Banyak cara mengambil 3 bola bukan merah dari 5 bola:" },
        { "tipe": "paragraph", "text": "$C(5, 3) = \\dfrac{5!}{3!2!} = \\dfrac{5 \\cdot 4}{2 \\cdot 1} = 10$" },
        { "tipe": "paragraph", "text": "Peluang tidak ada bola merah = $\\dfrac{10}{120} = \\dfrac{1}{12}$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang akhir.**" },
        { "tipe": "paragraph", "text": "$P(\\text{paling sedikit 1 merah}) = 1 - \\dfrac{1}{12} = \\dfrac{12}{12} - \\dfrac{1}{12} = \\dfrac{11}{12}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil paling sedikit 1 bola merah adalah $\\dfrac{11}{12}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar bersamaan. Diketahui salah satu dadu menunjukkan angka $3$. Peluang jumlah kedua dadu lebih dari $6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan ruang sampel bersyarat ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Diketahui salah satu dadu menunjukkan angka 3. Pasangan mata dadu yang memenuhi syarat ini adalah:" },
        { "tipe": "paragraph", "text": "$(3,1), (3,2), (3,3), (3,4), (3,5), (3,6)$ (6 pasangan)" },
        { "tipe": "paragraph", "text": "$(1,3), (2,3), (4,3), (5,3), (6,3)$ (5 pasangan, dengan $(3,3)$ tidak dihitung dua kali)." },
        { "tipe": "paragraph", "text": "Maka, banyak titik sampel bersyarat adalah $n(S) = 11$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan kejadian yang diinginkan ($n(A)$) yaitu jumlah kedua dadu lebih dari 6.**" },
        { "tipe": "paragraph", "text": "Dari 11 pasangan di atas, pasangan yang jumlahnya $> 6$ adalah:" },
        { "tipe": "paragraph", "text": "$(3,4) \\rightarrow 7$", "tipe": "paragraph", "text": "$(3,5) \\rightarrow 8$", "tipe": "paragraph", "text": "$(3,6) \\rightarrow 9$", "tipe": "paragraph", "text": "$(4,3) \\rightarrow 7$", "tipe": "paragraph", "text": "$(5,3) \\rightarrow 8$", "tipe": "paragraph", "text": "$(6,3) \\rightarrow 9$." },
        { "tipe": "paragraph", "text": "Banyak pasangan yang memenuhi adalah $n(A) = 6$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang bersyarat $P(A)$.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{6}{11}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang jumlah kedua dadu lebih dari 6 adalah $\\dfrac{6}{11}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kantong berisi 8 bola: 5 merah, 3 putih. Diambil 2 bola tanpa pengembalian. Peluang terambil 1 merah dan 1 putih adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{28}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{56}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{14}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{8}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi pola pengambilan tanpa pengembalian.**" },
        { "tipe": "paragraph", "text": "Pengambilan 2 bola satu per satu tanpa pengembalian untuk mendapatkan 1 merah dan 1 putih dapat terjadi dalam 2 susunan urutan:" },
        { "tipe": "paragraph", "text": "1. **Merah lalu Putih (M - P)**" },
        { "tipe": "paragraph", "text": "2. **Putih lalu Merah (P - M)**" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung peluang masing-masing susunan urutan.**" },
        { "tipe": "paragraph", "text": "- Peluang (M - P) = $\\dfrac{5}{8} \\cdot \\dfrac{3}{7} = \\dfrac{15}{56}$" },
        { "tipe": "paragraph", "text": "- Peluang (P - M) = $\\dfrac{3}{8} \\cdot \\dfrac{5}{7} = \\dfrac{15}{56}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Jumlahkan peluang kedua kemungkinan tersebut.**" },
        { "tipe": "paragraph", "text": "Total Peluang = $\\dfrac{15}{56} + \\dfrac{15}{56} = \\dfrac{30}{56} = \\dfrac{15}{28}$ (setelah dibagi 2)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil 1 merah dan 1 putih adalah $\\dfrac{15}{28}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Berapa banyak kata yang dapat dibentuk dari kata \"BUKU\" jika huruf U tidak boleh berdekatan?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total seluruh susunan kata \"BUKU\" tanpa syarat.**" },
        { "tipe": "paragraph", "text": "Kata \"BUKU\" terdiri dari 4 huruf dengan huruf U muncul sebanyak 2 kali:" },
        { "tipe": "paragraph", "text": "Total susunan = $\\dfrac{4!}{2!} = \\dfrac{24}{2} = 12$ susunan." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah susunan di mana kedua huruf U saling berdekatan.**`" },
        { "tipe": "paragraph", "text": "Jika kedua huruf U harus selalu berdekatan, anggap $\\{U, U\\}$ sebagai **1 objek tunggal**." },
        { "tipe": "paragraph", "text": "Objek yang akan disusun menjadi: $\\{U, U\\}, B, K$ (total 3 objek)." },
        { "tipe": "paragraph", "text": "Banyak susunan = $3! = 6$ cara." },
        { "tipe": "paragraph", "text": "**Langkah 3: Gunakan aturan selisih untuk mencari kondisi huruf U tidak berdekatan.**" },
        { "tipe": "paragraph", "text": "Susunan (U tidak berdekatan) = Total Susunan - Susunan (U berdekatan)" },
        { "tipe": "paragraph", "text": "Susunan = $12 - 6 = 6$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak kata yang dapat dibentuk jika huruf U tidak berdekatan adalah $6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar 4 kali. Peluang muncul mata $6$ tepat 2 kali adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{216}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{125}{1296}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{150}{1296}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{200}{1296}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{625}{1296}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan rumus Distribusi Binomial.**" },
        { "tipe": "paragraph", "text": "- Banyak lemparan ($n$) = 4" },
        { "tipe": "paragraph", "text": "- Sukses muncul angka 6 ($k$) = 2" },
        { "tipe": "paragraph", "text": "- Peluang sukses ($p$) = $\\dfrac{1}{6}$" },
        { "tipe": "paragraph", "text": "- Peluang gagal ($q$) = $1 - \\dfrac{1}{6} = \\dfrac{5}{6}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai peluang binomial.**" },
        { "tipe": "paragraph", "text": "$P(X = 2) = C(4, 2) \\cdot \\left(\\dfrac{1}{6}\\right)^2 \\cdot \\left(\\dfrac{5}{6}\\right)^{4-2}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{4!}{2!2!} \\cdot \\dfrac{1}{36} \\cdot \\dfrac{25}{36}$" },
        { "tipe": "paragraph", "text": "$= 6 \\cdot \\dfrac{25}{1296} = \\dfrac{150}{1296}$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang muncul mata dadu 6 tepat 2 kali adalah $\\dfrac{150}{1296}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari 10 titik pada bidang, tidak ada 3 titik yang kolinear. Banyak segitiga yang dapat dibentuk adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$720$" } ],
        [ { "tipe": "paragraph", "text": "$840$" } ],
        [ { "tipe": "paragraph", "text": "$1440$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi konsep pembentukan segitiga.**`" },
        { "tipe": "paragraph", "text": "Sebuah segitiga dibentuk oleh **3 titik** yang tidak segaris (kolinear). Karena urutan pemilihan ketiga titik tersebut tidak penting, permasalahan ini diselesaikan menggunakan konsep **Kombinasi**." },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus kombinasi $C(n, r)$.**" },
        { "tipe": "paragraph", "text": "Dari 10 titik dipilih 3 titik: $n = 10$, $r = 3$." },
        { "tipe": "paragraph", "text": "$C(10, 3) = \\dfrac{10!}{3!7!} = \\dfrac{10 \\cdot 9 \\cdot 8}{3 \\cdot 2 \\cdot 1} = 120$" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Banyak segitiga yang dapat dibentuk adalah $120$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 4 bola merah, 3 biru, 3 hijau. Diambil 3 bola. Peluang terambil ketiga warna berbeda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total titik sampel ($n(S)$).**" },
        { "tipe": "paragraph", "text": "Total bola = $4 + 3 + 3 = 10$ bola. Diambil 3 bola sekaligus:" },
        { "tipe": "paragraph", "text": "$n(S) = C(10, 3) = \\dfrac{10!}{3!7!} = \\dfrac{10 \\cdot 9 \\cdot 8}{3 \\cdot 2 \\cdot 1} = 120$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung titik sampel kejadian yang diinginkan ($n(A)$).**" },
        { "tipe": "paragraph", "text": "Ketiga bola berbeda warna berarti terambil 1 merah, 1 biru, dan 1 hijau:" },
        { "tipe": "paragraph", "text": "- 1 merah dari 4: $C(4, 1) = 4$" },
        { "tipe": "paragraph", "text": "- 1 biru dari 3: $C(3, 1) = 3$" },
        { "tipe": "paragraph", "text": "- 1 hijau dari 3: $C(3, 1) = 3$" },
        { "tipe": "paragraph", "text": "Maka, $n(A) = 4 \\cdot 3 \\cdot 3 = 36$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung peluang $P(A)$ pengambilan ketiga warna berbeda.**" },
        { "tipe": "paragraph", "text": "$P(A) = \\dfrac{n(A)}{n(S)} = \\dfrac{36}{120} = \\dfrac{3}{10}$ (setelah masing-masing dibagi 12)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang terambil ketiga warna berbeda adalah $\\dfrac{3}{10}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Seorang siswa menjawab 5 soal pilihan ganda dengan 4 pilihan. Peluang ia menjawab benar tepat 3 soal (menebak acak) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{45}{512}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{90}{1024}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{45}{256}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{135}{1024}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{270}{1024}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan parameter distribusi binomial.**" },
        { "tipe": "paragraph", "text": "- Banyak soal ($n$) = 5" },
        { "tipe": "paragraph", "text": "- Soal dijawab benar ($k$) = 3" },
        { "tipe": "paragraph", "text": "- Peluang menebak benar per soal ($p$) = $\\dfrac{1}{4}$" },
        { "tipe": "paragraph", "text": "- Peluang menebak salah per soal ($q$) = $1 - \\dfrac{1}{4} = \\dfrac{3}{4}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai peluang binomial.**" },
        { "tipe": "paragraph", "text": "$P(X = 3) = C(5, 3) \\cdot \\left(\\dfrac{1}{4}\\right)^3 \\cdot \\left(\\dfrac{3}{4}\\right)^{5-3}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{5!}{3!2!} \\cdot \\left(\\dfrac{1}{64}\\right) \\cdot \\left(\\dfrac{9}{16}\\right)$" },
        { "tipe": "paragraph", "text": "$= 10 \\cdot \\dfrac{9}{1024} = \\dfrac{90}{1024}$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Sederhanakan pecahan ke bentuk paling sederhana.**" },
        { "tipe": "paragraph", "text": "$\\dfrac{90}{1024} = \\dfrac{45}{512}$ (setelah pembilang dan penyebut dibagi 2)." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Peluang ia menjawab benar tepat 3 soal adalah $\\dfrac{45}{512}$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
