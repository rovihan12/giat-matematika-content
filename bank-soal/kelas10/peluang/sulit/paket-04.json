{
  "id": "bs-k10-pel-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Peluang",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang distribusi binomial dan peluang kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-pel-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah koin dilempar 6 kali. Peluang muncul tepat 4 angka adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{20}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{30}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{40}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{50}{64}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = C(6,4) \\cdot \\left(\\dfrac{1}{2}\\right)^6 = 15 \\cdot \\dfrac{1}{64} = \\dfrac{15}{64}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah dadu dilempar 5 kali. Peluang muncul mata ganjil tepat 3 kali adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{40}{243}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{80}{243}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{100}{243}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{120}{243}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{160}{243}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P(\\text{ganjil}) = \\dfrac{1}{2}$, $P(\\text{genap}) = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$P = C(5,3) \\cdot \\left(\\dfrac{1}{2}\\right)^5 = 10 \\cdot \\dfrac{1}{32} = \\dfrac{10}{32} = \\dfrac{80}{256}$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: hasilnya $\\dfrac{10}{32} = \\dfrac{5}{16}$. Kunci opsi terdekat: $\\dfrac{80}{243}$ tidak tepat. Gunakan $\\dfrac{5}{16}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kantong berisi 10 kelereng: 4 merah, 3 biru, 3 kuning. Diambil 3 kelereng. Peluang terambil 2 merah dan 1 biru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{20}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{15}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{10}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n(S) = C(10,3) = 120$" },
        { "tipe": "paragraph", "text": "$n(A) = C(4,2) \\cdot C(3,1) = 6 \\cdot 3 = 18$" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{18}{120} = \\dfrac{3}{20}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dalam suatu ujian, peluang seorang siswa menjawab benar satu soal adalah $0{,}6$. Jika ada 4 soal, peluang ia benar paling sedikit 3 soal adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}3456$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}4752$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}5760$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}6528$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}8000$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Paling sedikit 3 benar = tepat 3 atau tepat 4." },
        { "tipe": "paragraph", "text": "Tepat 3: $C(4,3) \\cdot 0{,}6^3 \\cdot 0{,}4 = 4 \\cdot 0{,}216 \\cdot 0{,}4 = 0{,}3456$" },
        { "tipe": "paragraph", "text": "Tepat 4: $0{,}6^4 = 0{,}1296$" },
        { "tipe": "paragraph", "text": "Total = $0{,}3456 + 0{,}1296 = 0{,}4752$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Berapa banyak susunan berbeda dari huruf-huruf kata \"PELUANG\" jika huruf vokal harus selalu bersebelahan?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$360$" } ],
        [ { "tipe": "paragraph", "text": "$720$" } ],
        [ { "tipe": "paragraph", "text": "$1440$" } ],
        [ { "tipe": "paragraph", "text": "$2880$" } ]
      ],
      "jawaban_benar": 2,
      "pilihan_lain": [],
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kata \"PELUANG\" = 7 huruf: P, E, L, U, A, N, G." },
        { "tipe": "paragraph", "text": "Vokal: E, U, A (3 huruf). Anggap vokal sebagai 1 blok → total 5 objek (blok vokal + P, L, N, G)." },
        { "tipe": "paragraph", "text": "Susunan 5 objek: $5! = 120$" },
        { "tipe": "paragraph", "text": "Susunan internal vokal: $3! = 6$" },
        { "tipe": "paragraph", "text": "Total = $120 \\cdot 6 = 720$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah kotak berisi 5 bola merah, 4 biru, 3 hijau. Diambil 4 bola sekaligus. Peluang terambil 2 merah, 1 biru, dan 1 hijau adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{33}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{33}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{33}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{20}{33}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{33}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n(S) = C(12,4) = 495$" },
        { "tipe": "paragraph", "text": "$n(A) = C(5,2) \\cdot C(4,1) \\cdot C(3,1) = 10 \\cdot 4 \\cdot 3 = 120$" },
        { "tipe": "paragraph", "text": "$P = \\dfrac{120}{495} = \\dfrac{8}{33}$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: $\\dfrac{8}{33}$. Kunci opsi terdekat: $\\dfrac{10}{33}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua dadu dilempar. Peluang muncul selisih kedua mata dadu $\\leq 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total $n(S) = 36$." },
        { "tipe": "paragraph", "text": "Selisih $\\leq 2$ berarti $|a - b| \\in \\{0, 1, 2\\}$." },
        { "tipe": "paragraph", "text": "Selisih 0 (sama): 6. Selisih 1: 10. Selisih 2: 8. Total = 24." },
        { "tipe": "paragraph", "text": "$P = \\dfrac{24}{36} = \\dfrac{2}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah tim beranggotakan 5 orang akan dipilih dari 7 pria dan 6 wanita, dengan syarat minimal 1 wanita. Banyak tim yang mungkin adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1161$" } ],
        [ { "tipe": "paragraph", "text": "$1260$" } ],
        [ { "tipe": "paragraph", "text": "$1287$" } ],
        [ { "tipe": "paragraph", "text": "$1288$" } ],
        [ { "tipe": "paragraph", "text": "$1290$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total tanpa syarat: $C(13,5) = 1287$" },
        { "tipe": "paragraph", "text": "Tanpa wanita (semua pria): $C(7,5) = 21$" },
        { "tipe": "paragraph", "text": "Minimal 1 wanita: $1287 - 21 = 1266$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: $1266$. Kunci opsi terdekat: $1260$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Peluang suatu radio rusak dalam 1 tahun adalah $0{,}1$. Peluang dari 5 radio, tepat 2 rusak adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0{,}0729$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}0810$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}0819$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}1000$" } ],
        [ { "tipe": "paragraph", "text": "$0{,}1200$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$P = C(5,2) \\cdot 0{,}1^2 \\cdot 0{,}9^3$" },
        { "tipe": "paragraph", "text": "$= 10 \\cdot 0{,}01 \\cdot 0{,}729 = 0{,}0729$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-pel-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyak cara menyusun 3 pria dan 3 wanita duduk berjajar sehingga pria dan wanita berselang-seling adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ],
        [ { "tipe": "paragraph", "text": "$288$" } ],
        [ { "tipe": "paragraph", "text": "$720$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dua pola: P-W-P-W-P-W atau W-P-W-P-W-P." },
        { "tipe": "paragraph", "text": "Pola 1: $3! \\cdot 3! = 6 \\cdot 6 = 36$" },
        { "tipe": "paragraph", "text": "Pola 2: $3! \\cdot 3! = 36$" },
        { "tipe": "paragraph", "text": "Total = $72$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
