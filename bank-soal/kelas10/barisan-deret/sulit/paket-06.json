{
  "id": "bs-k10-bd-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang barisan bertingkat, rekursif, dan telescoping",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-12 dari barisan bertingkat $4, 7, 12, 19, 28, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$143$" } ],
        [ { "tipe": "paragraph", "text": "$147$" } ],
        [ { "tipe": "paragraph", "text": "$151$" } ],
        [ { "tipe": "paragraph", "text": "$155$" } ],
        [ { "tipe": "paragraph", "text": "$159$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis selisih bertingkat untuk menentukan rumus umum suku ke-$n$**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $3, 5, 7, 9, \\ldots$ dengan beda tetap $2$, sehingga suku ke-$n$ berbentuk:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 12$ untuk menghitung suku ke-12**" },
        { "tipe": "formula_block", "latex": "U_{12} = 12^2 + 3 = 144 + 3 = 147" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-12 dari barisan tersebut adalah **$147$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $x_1, x_2, x_3, \\ldots$ didefinisikan dengan $x_1 = 2$, $x_2 = 5$, dan $x_n = 3x_{n-1} - 2x_{n-2}$ untuk $n \\ge 3$. Nilai $x_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$43$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$47$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus rekursif $x_n = 3x_{n-1} - 2x_{n-2}$ untuk mencari $x_3$ dan $x_4$**" },
        { "tipe": "formula_block", "latex": "x_3 = 3x_2 - 2x_1 = 3(5) - 2(2) = 15 - 4 = 11" },
        { "tipe": "formula_block", "latex": "x_4 = 3x_3 - 2x_2 = 3(11) - 2(5) = 33 - 10 = 23" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x_5$ dari $x_4$ dan $x_3$**" },
        { "tipe": "formula_block", "latex": "x_5 = 3x_4 - 2x_3 = 3(23) - 2(11) = 69 - 22 = 47" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_5$ adalah **$47$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{1 \\cdot 3} + \\dfrac{1}{3 \\cdot 5} + \\dfrac{1}{5 \\cdot 7} + \\ldots + \\dfrac{1}{19 \\cdot 21}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{21}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{21}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{20}{21}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{21}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan suku umum deret menjadi pecahan parsial teleskopik**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{(2k - 1)(2k + 1)} = \\dfrac{1}{2}\\left(\\dfrac{1}{2k - 1} - \\dfrac{1}{2k + 1}\\right)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan dari $k = 1$ hingga $k = 10$ dan sederhanakan suku-suku tengahnya**" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2}\\left(1 - \\dfrac{1}{3} + \\dfrac{1}{3} - \\dfrac{1}{5} + \\ldots + \\dfrac{1}{19} - \\dfrac{1}{21}\\right) = \\dfrac{1}{2}\\left(1 - \\dfrac{1}{21}\\right)" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2} \\cdot \\dfrac{20}{21} = \\dfrac{10}{21}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$\\dfrac{10}{21}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan geometri. Jika hasil kalinya $343$ dan jumlahnya $57$, maka bilangan terbesarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan tiga bilangan geometri adalah $\\dfrac{a}{r}, a, ar$ dan cari $a$ dari hasil kalinya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{a}{r} \\cdot a \\cdot ar = 343 \\Rightarrow a^3 = 343 \\Rightarrow a = 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan jumlah ketiga bilangan ($57$) untuk menentukan rasio ($r$)**" },
        { "tipe": "formula_block", "latex": "\\dfrac{7}{r} + 7 + 7r = 57 \\Rightarrow \\dfrac{7}{r} + 7r = 50 \\Rightarrow 7r^2 - 50r + 7 = 0" },
        { "tipe": "formula_block", "latex": "(7r - 1)(r - 7) = 0 \\Rightarrow r = 7 \\quad \\text{atau} \\quad r = \\dfrac{1}{7}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan ketiga bilangan dan ambil nilai terbesarnya**" },
        { "tipe": "formula_block", "latex": "\\text{Barisan bilangan: } 1, 7, 49 \\Rightarrow \\text{bilangan terbesar} = 49" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bilangan terbesarnya adalah **$49$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = 2n^3 - 3n^2 + 4n$. Suku ke-4 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$53$" } ],
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$57$" } ],
        [ { "tipe": "paragraph", "text": "$59$" } ],
        [ { "tipe": "paragraph", "text": "$61$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hubungan $U_n = S_n - S_{n - 1}$ untuk $n = 4$**" },
        { "tipe": "formula_block", "latex": "U_4 = S_4 - S_3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $S_4$ dan $S_3$**" },
        { "tipe": "formula_block", "latex": "S_4 = 2(4)^3 - 3(4)^2 + 4(4) = 128 - 48 + 16 = 96" },
        { "tipe": "formula_block", "latex": "S_3 = 2(3)^3 - 3(3)^2 + 4(3) = 54 - 27 + 12 = 39" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kurangkan $S_4$ dengan $S_3$ untuk memperoleh $U_4$**" },
        { "tipe": "formula_block", "latex": "U_4 = 96 - 39 = 57" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-4 deret tersebut adalah **$57$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{2} + \\dfrac{3}{4} + \\dfrac{5}{8} + \\dfrac{7}{16} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan deret dalam notasi sigma dan pecah menjadi deret standar**" },
        { "tipe": "formula_block", "latex": "S = \\sum_{n=1}^{\\infty} \\dfrac{2n - 1}{2^n} = 2 \\sum_{n=1}^{\\infty} \\dfrac{n}{2^n} - \\sum_{n=1}^{\\infty} \\dfrac{1}{2^n}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai masing-masing deret tak hingga**" },
        { "tipe": "formula_block", "latex": "\\sum_{n=1}^{\\infty} \\dfrac{n}{2^n} = \\dfrac{\\dfrac{1}{2}}{\\left(1 - \\dfrac{1}{2}\\right)^2} = 2, \\qquad \\sum_{n=1}^{\\infty} \\dfrac{1}{2^n} = \\dfrac{\\dfrac{1}{2}}{1 - \\dfrac{1}{2}} = 1" },
        { "tipe": "formula_block", "latex": "S = 2(2) - 1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tak hingga tersebut adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 2, \\log(2^x - 2), \\log(2^x + 10)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat barisan aritmatika pada tiga suku logaritma**" },
        { "tipe": "formula_block", "latex": "2 \\log(2^x - 2) = \\log 2 + \\log(2^x + 10) \\Rightarrow (2^x - 2)^2 = 2(2^x + 10)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $t = 2^x$ dan selesaikan persamaan kuadratnya**" },
        { "tipe": "formula_block", "latex": "(t - 2)^2 = 2(t + 10) \\Rightarrow t^2 - 4t + 4 = 2t + 20 \\Rightarrow t^2 - 6t - 16 = 0" },
        { "tipe": "formula_block", "latex": "(t - 8)(t + 2) = 0 \\Rightarrow t = 8 \\quad (\\text{karena } t = 2^x > 0)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke variabel $x$ untuk memperoleh penyelesaiannya**" },
        { "tipe": "formula_block", "latex": "2^x = 8 = 2^3 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama suatu deret didefinisikan sebagai $S_n = 3^n - 1$. Suku ke-5 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$81$" } ],
        [ { "tipe": "paragraph", "text": "$162$" } ],
        [ { "tipe": "paragraph", "text": "$243$" } ],
        [ { "tipe": "paragraph", "text": "$486$" } ],
        [ { "tipe": "paragraph", "text": "$729$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hubungan $U_5 = S_5 - S_4$**" },
        { "tipe": "formula_block", "latex": "U_5 = S_5 - S_4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $S_5$ dan $S_4$ lalu kurangkan**" },
        { "tipe": "formula_block", "latex": "S_5 = 3^5 - 1 = 243 - 1 = 242, \\qquad S_4 = 3^4 - 1 = 81 - 1 = 80" },
        { "tipe": "formula_block", "latex": "U_5 = 242 - 80 = 162" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 deret tersebut adalah **$162$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika akar-akar persamaan $x^3 - 12x^2 + 39x - 28 = 0$ membentuk barisan aritmatika, maka beda barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3$ atau $3$" } ],
        [ { "tipe": "paragraph", "text": "$-2$ atau $2$" } ],
        [ { "tipe": "paragraph", "text": "$-1$ atau $1$" } ],
        [ { "tipe": "paragraph", "text": "$-4$ atau $4$" } ],
        [ { "tipe": "paragraph", "text": "$-5$ atau $5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan tiga akar persamaan kubik sebagai $a - b, a, a + b$ dan gunakan jumlah akarnya**" },
        { "tipe": "formula_block", "latex": "(a - b) + a + (a + b) = 3a = 12 \\Rightarrow a = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan hasil kali ketiga akarnya untuk mencari nilai beda ($b$)**" },
        { "tipe": "formula_block", "latex": "(a - b)a(a + b) = a(a^2 - b^2) = 28" },
        { "tipe": "formula_block", "latex": "4(4^2 - b^2) = 28 \\Rightarrow 16 - b^2 = 7 \\Rightarrow b^2 = 9 \\Rightarrow b = \\pm 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, beda barisan aritmatika tersebut adalah **$-3$ atau $3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai dari $\\sum_{k=1}^{99} \\dfrac{1}{\\sqrt{k} + \\sqrt{k+1}}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Rasionalkan penyebut setiap suku dengan bentuk sekawannya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{\\sqrt{k} + \\sqrt{k + 1}} = \\dfrac{\\sqrt{k + 1} - \\sqrt{k}}{(k + 1) - k} = \\sqrt{k + 1} - \\sqrt{k}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan secara teleskopik dari $k = 1$ sampai $k = 99$**" },
        { "tipe": "formula_block", "latex": "\\sum_{k=1}^{99} (\\sqrt{k + 1} - \\sqrt{k}) = (\\sqrt{2} - \\sqrt{1}) + (\\sqrt{3} - \\sqrt{2}) + \\ldots + (\\sqrt{100} - \\sqrt{99})" },
        { "tipe": "formula_block", "latex": "\\sqrt{100} - \\sqrt{1} = 10 - 1 = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai deret tersebut adalah **$9$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
