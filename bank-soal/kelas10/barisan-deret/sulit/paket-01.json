{
  "id": "bs-k10-bd-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang barisan bertingkat dan deret geometri tak hingga",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan bertingkat $2, 5, 10, 17, 26, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$101$" } ],
        [ { "tipe": "paragraph", "text": "$102$" } ],
        [ { "tipe": "paragraph", "text": "$103$" } ],
        [ { "tipe": "paragraph", "text": "$104$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Selisih: $3, 5, 7, 9, \\ldots$ (aritmatika dengan beda 2)." },
        { "tipe": "paragraph", "text": "Rumus: $U_n = n^2 + 1$." },
        { "tipe": "paragraph", "text": "$U_{10} = 100 + 1 = 101$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret geometri tak hingga $\\dfrac{1}{2} + \\dfrac{1}{4} + \\dfrac{1}{8} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = \\dfrac{1}{2}$, $r = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{1/2}{1 - 1/2} = \\dfrac{1/2}{1/2} = 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $1, 4, 9, 16, 25, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = n^2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Barisan kuadrat sempurna: $1^2, 2^2, 3^2, \\ldots$" },
        { "tipe": "paragraph", "text": "$U_n = n^2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 20 suku pertama barisan $3, 6, 12, 24, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3(2^{20} - 1)$" } ],
        [ { "tipe": "paragraph", "text": "$3 \\cdot 2^{20}$" } ],
        [ { "tipe": "paragraph", "text": "$3(2^{21} - 1)$" } ],
        [ { "tipe": "paragraph", "text": "$2(3^{20} - 1)$" } ],
        [ { "tipe": "paragraph", "text": "$3^{20}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 3$, $r = 2$" },
        { "tipe": "paragraph", "text": "$S_{20} = \\dfrac{3(2^{20} - 1)}{2 - 1} = 3(2^{20} - 1)$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika pada deret geometri tak hingga $S_\\infty = 4$ dan jumlah 2 suku pertamanya $3$, maka suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{a}{1-r} = 4 \\Rightarrow a = 4(1-r)$" },
        { "tipe": "paragraph", "text": "$S_2 = a + ar = a(1+r) = 3$" },
        { "tipe": "paragraph", "text": "Substitusi: $4(1-r)(1+r) = 3 \\Rightarrow 4(1-r^2) = 3 \\Rightarrow 1 - r^2 = \\dfrac{3}{4} \\Rightarrow r^2 = \\dfrac{1}{4}$" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{1}{2}$ → $a = 4 \\cdot \\dfrac{1}{2} = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 barisan $2, 3, 5, 8, 12, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Selisih bertingkat: $1, 2, 3, 4, 5, 6, 7, \\ldots$" },
        { "tipe": "paragraph", "text": "$U_1 = 2$" },
        { "tipe": "paragraph", "text": "$U_2 = 2 + 1 = 3$" },
        { "tipe": "paragraph", "text": "$U_3 = 3 + 2 = 5$" },
        { "tipe": "paragraph", "text": "$U_4 = 5 + 3 = 8$" },
        { "tipe": "paragraph", "text": "$U_5 = 8 + 4 = 12$" },
        { "tipe": "paragraph", "text": "$U_6 = 12 + 5 = 17$" },
        { "tipe": "paragraph", "text": "$U_7 = 17 + 6 = 23$" },
        { "tipe": "paragraph", "text": "$U_8 = 23 + 7 = 30$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 + \\dfrac{1}{4} + \\dfrac{1}{16} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 1$, $r = \\dfrac{1}{4}$" },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{1}{1 - 1/4} = \\dfrac{1}{3/4} = \\dfrac{4}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_1 + U_2 + U_3 = 24$ dan $U_1 \\cdot U_2 \\cdot U_3 = 480$. Suku pertama dan bedanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 2$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$, $b = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 6$, $b = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$, $b = 5$" } ],
        [ { "tipe": "paragraph", "text": "$a = 5$, $b = 3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal: $U_1 = a-b$, $U_2 = a$, $U_3 = a+b$." },
        { "tipe": "paragraph", "text": "Jumlah = $3a = 24 \\Rightarrow a = 8$." },
        { "tipe": "paragraph", "text": "Hasil kali: $(8-b) \\cdot 8 \\cdot (8+b) = 480 \\Rightarrow 64 - b^2 = 60 \\Rightarrow b^2 = 4 \\Rightarrow b = 2$." },
        { "tipe": "paragraph", "text": "Suku pertama $U_1 = 8 - 2 = 6$, dan beda $b = 2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret $2 + 6 + 18 + \\ldots$ adalah 728. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 2$, $r = 3$" },
        { "tipe": "paragraph", "text": "$S_n = \\dfrac{2(3^n - 1)}{3 - 1} = 3^n - 1 = 728$" },
        { "tipe": "paragraph", "text": "$3^n = 729 = 3^6 \\Rightarrow n = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dijatuhkan dari ketinggian $h$. Setiap pantulan mencapai $\\dfrac{1}{3}$ dari ketinggian sebelumnya. Jika total lintasan bola sampai berhenti adalah 24 m, maka $h$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$ m" } ],
        [ { "tipe": "paragraph", "text": "$8$ m" } ],
        [ { "tipe": "paragraph", "text": "$10$ m" } ],
        [ { "tipe": "paragraph", "text": "$12$ m" } ],
        [ { "tipe": "paragraph", "text": "$15$ m" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Total lintasan = $h + 2 \\cdot \\dfrac{h/3}{1 - 1/3} = h + 2 \\cdot \\dfrac{h/3}{2/3} = h + h = 2h$" },
        { "tipe": "paragraph", "text": "$2h = 24 \\Rightarrow h = 12$ m" }
      ],
      "tingkat": "SULIT"
    }
  ]
}