{
  "id": "bs-k10-bd-s-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang sistem persamaan, deret tak hingga, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_2 + U_5 = 19$ dan $U_4 = 11$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan suku-suku barisan aritmatika dalam suku pertama ($a$) dan beda ($b$)**" },
        { "tipe": "formula_block", "latex": "U_4 = a + 3b = 11 \\Rightarrow a = 11 - 3b" },
        { "tipe": "formula_block", "latex": "U_2 + U_5 = (a + b) + (a + 4b) = 19 \\Rightarrow 2a + 5b = 19" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $a = 11 - 3b$ untuk mencari nilai $b$**" },
        { "tipe": "formula_block", "latex": "2(11 - 3b) + 5b = 19 \\Rightarrow 22 - b = 19 \\Rightarrow b = 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai suku pertama ($a$)**" },
        { "tipe": "formula_block", "latex": "a = 11 - 3(3) = 11 - 9 = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama barisan tersebut adalah **$2$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = n^2 + 4n$. Suku ke-8 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hubungan suku ke-$n$ dan jumlah $n$ suku pertama ($U_n = S_n - S_{n-1}$)**" },
        { "tipe": "formula_block", "latex": "U_8 = S_8 - S_7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $S_8$ dan $S_7$**" },
        { "tipe": "formula_block", "latex": "S_8 = 8^2 + 4(8) = 64 + 32 = 96" },
        { "tipe": "formula_block", "latex": "S_7 = 7^2 + 4(7) = 49 + 28 = 77" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kurangkan $S_8$ dengan $S_7$ untuk memperoleh $U_8$**" },
        { "tipe": "formula_block", "latex": "U_8 = 96 - 77 = 19" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-8 deret tersebut adalah **$19$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $\\dfrac{4}{5} + \\dfrac{4}{25} + \\dfrac{4}{125} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama ($a$) dan rasio ($r$) deret geometri**" },
        { "tipe": "formula_block", "latex": "a = \\dfrac{4}{5}, \\qquad r = \\dfrac{\\dfrac{4}{25}}{\\dfrac{4}{5}} = \\dfrac{1}{5}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah tak hingga menggunakan rumus $S_\\infty = \\dfrac{a}{1 - r}$**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\dfrac{\\dfrac{4}{5}}{1 - \\dfrac{1}{5}} = \\dfrac{\\dfrac{4}{5}}{\\dfrac{4}{5}} = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah tak hingga deret tersebut adalah **$1$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Seorang pedagang menjual 30 mangkok pada hari pertama, 35 mangkok hari kedua, 40 mangkok hari ketiga, dan seterusnya (naik 5 tiap hari). Total mangkok terjual selama 12 hari adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$600$" } ],
        [ { "tipe": "paragraph", "text": "$630$" } ],
        [ { "tipe": "paragraph", "text": "$660$" } ],
        [ { "tipe": "paragraph", "text": "$690$" } ],
        [ { "tipe": "paragraph", "text": "$720$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi unsur barisan aritmatika dari soal**" },
        { "tipe": "formula_block", "latex": "a = 30, \\qquad b = 5, \\qquad n = 12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung total penjualan menggunakan rumus $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$**" },
        { "tipe": "formula_block", "latex": "S_{12} = \\dfrac{12}{2}\\big(2(30) + (12 - 1) \\cdot 5\\big) = 6(60 + 55) = 6 \\cdot 115 = 690" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, total mangkok terjual selama 12 hari adalah **$690$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan geometri, $U_2 = 20$ dan $U_5 = 160$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rasio ($r$) dari perbandingan $U_5$ dan $U_2$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{U_5}{U_2} = \\dfrac{160}{20} \\Rightarrow r^{5 - 2} = 8 \\Rightarrow r^3 = 8 \\Rightarrow r = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku pertama ($a$) dari persamaan $U_2 = a \\cdot r$**" },
        { "tipe": "formula_block", "latex": "a \\cdot 2 = 20 \\Rightarrow a = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama barisan tersebut adalah **$10$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan asli kelipatan 11 yang kurang dari 200 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1782$" } ],
        [ { "tipe": "paragraph", "text": "$1881$" } ],
        [ { "tipe": "paragraph", "text": "$1980$" } ],
        [ { "tipe": "paragraph", "text": "$2079$" } ],
        [ { "tipe": "paragraph", "text": "$2178$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun barisan aritmatika kelipatan 11 yang kurang dari 200**" },
        { "tipe": "formula_block", "latex": "11, 22, \\ldots, 198 \\quad (a = 11, \\; b = 11, \\; U_n = 198)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan banyak suku ($n$) menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "198 = 11 + (n - 1) \\cdot 11 \\Rightarrow 11(n - 1) = 187 \\Rightarrow n - 1 = 17 \\Rightarrow n = 18" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung jumlah deret menggunakan rumus $S_n = \\dfrac{n}{2}(a + U_n)$**" },
        { "tipe": "formula_block", "latex": "S_{18} = \\dfrac{18}{2}(11 + 198) = 9 \\cdot 209 = 1881" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah semua bilangan asli kelipatan 11 yang kurang dari 200 adalah **$1881$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $S_4 = 30$ dan $S_8 = 108$. Beda barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah $S_4$ dan $S_8$ ke persamaan linear dalam $a$ dan $b$**" },
        { "tipe": "formula_block", "latex": "S_4 = \\dfrac{4}{2}(2a + 3b) = 30 \\Rightarrow 2(2a + 3b) = 30 \\Rightarrow 2a + 3b = 15" },
        { "tipe": "formula_block", "latex": "S_8 = \\dfrac{8}{2}(2a + 7b) = 108 \\Rightarrow 4(2a + 7b) = 108 \\Rightarrow 2a + 7b = 27" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $a$ untuk memperoleh nilai beda ($b$)**" },
        { "tipe": "formula_block", "latex": "(2a + 7b) - (2a + 3b) = 27 - 15 \\Rightarrow 4b = 12 \\Rightarrow b = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, beda barisan aritmatika tersebut adalah **$3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 dan ke-5 barisan geometri berturut-turut $18$ dan $162$. Suku ke-4 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$66$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat suku tengah barisan geometri ($U_4^2 = U_3 \\cdot U_5$)**" },
        { "tipe": "formula_block", "latex": "U_4 = \\sqrt{U_3 \\cdot U_5} = \\sqrt{18 \\cdot 162}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai akar kuadratnya**" },
        { "tipe": "formula_block", "latex": "U_4 = \\sqrt{2916} = 54" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-4 barisan geometri tersebut adalah **$54$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 18 suku pertama deret $1 + 5 + 9 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$594$" } ],
        [ { "tipe": "paragraph", "text": "$612$" } ],
        [ { "tipe": "paragraph", "text": "$630$" } ],
        [ { "tipe": "paragraph", "text": "$648$" } ],
        [ { "tipe": "paragraph", "text": "$666$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama ($a$), beda ($b$), dan banyak suku ($n$)**" },
        { "tipe": "formula_block", "latex": "a = 1, \\qquad b = 5 - 1 = 4, \\qquad n = 18" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah 18 suku pertama menggunakan rumus $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$**" },
        { "tipe": "formula_block", "latex": "S_{18} = \\dfrac{18}{2}\\big(2(1) + (18 - 1) \\cdot 4\\big) = 9(2 + 68) = 9 \\cdot 70 = 630" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah 18 suku pertama deret tersebut adalah **$630$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga memiliki $S_\\infty = 20$ dan $r = \\dfrac{1}{4}$. Suku pertama deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $S_\\infty = 20$ dan $r = \\dfrac{1}{4}$ ke rumus deret geometri tak hingga**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\dfrac{a}{1 - r} \\Rightarrow 20 = \\dfrac{a}{1 - \\dfrac{1}{4}} = \\dfrac{a}{\\dfrac{3}{4}}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai suku pertama ($a$)**" },
        { "tipe": "formula_block", "latex": "a = 20 \\times \\dfrac{3}{4} = 5 \\times 3 = 15" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama deret geometri tak hingga tersebut adalah **$15$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
