{
  "id": "bs-k10-bd-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang barisan bertingkat, rekursif, dan deret lanjutan",
  "versi": "1.0.1",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-16 dari barisan bertingkat $8, 11, 16, 23, 32, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$261$" } ],
        [ { "tipe": "paragraph", "text": "$263$" } ],
        [ { "tipe": "paragraph", "text": "$265$" } ],
        [ { "tipe": "paragraph", "text": "$267$" } ],
        [ { "tipe": "paragraph", "text": "$269$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis selisih bertingkat untuk menentukan rumus umum suku ke-$n$**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $3, 5, 7, 9, \\ldots$ dengan beda tetap $2$, sehingga suku ke-$n$ berbentuk:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 16$ untuk menghitung suku ke-16**" },
        { "tipe": "formula_block", "latex": "U_{16} = 16^2 + 7 = 256 + 7 = 263" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-16 dari barisan tersebut adalah **$263$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $v_1, v_2, v_3, \\ldots$ didefinisikan dengan $v_1 = 3$, $v_2 = 5$, dan $v_n = 3v_{n-1} - 2v_{n-2}$ untuk $n \\ge 3$. Nilai $v_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ],
        [ { "tipe": "paragraph", "text": "$41$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan rumus rekurensi $v_n = 3v_{n - 1} - 2v_{n - 2}$ untuk mencari $v_3$ dan $v_4$**" },
        { "tipe": "formula_block", "latex": "v_3 = 3v_2 - 2v_1 = 3(5) - 2(3) = 15 - 6 = 9" },
        { "tipe": "formula_block", "latex": "v_4 = 3v_3 - 2v_2 = 3(9) - 2(5) = 27 - 10 = 17" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $v_5$ dari $v_4$ dan $v_3$**" },
        { "tipe": "formula_block", "latex": "v_5 = 3v_4 - 2v_3 = 3(17) - 2(9) = 51 - 18 = 33" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $v_5$ adalah **$33$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{5 \\cdot 7} + \\dfrac{1}{7 \\cdot 9} + \\dfrac{1}{9 \\cdot 11} + \\ldots + \\dfrac{1}{25 \\cdot 27}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{135}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{90}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{45}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{90}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan suku umum deret menjadi pecahan parsial teleskopik**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{(2k + 3)(2k + 5)} = \\dfrac{1}{2}\\left(\\dfrac{1}{2k + 3} - \\dfrac{1}{2k + 5}\\right)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan dari $k = 1$ hingga $k = 11$ dan sederhanakan suku-suku tengahnya**" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2}\\left(\\dfrac{1}{5} - \\dfrac{1}{7} + \\dfrac{1}{7} - \\dfrac{1}{9} + \\ldots + \\dfrac{1}{25} - \\dfrac{1}{27}\\right) = \\dfrac{1}{2}\\left(\\dfrac{1}{5} - \\dfrac{1}{27}\\right)" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2} \\cdot \\dfrac{22}{135} = \\dfrac{11}{135}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$\\dfrac{11}{135}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan geometri. Jika hasil kalinya $1331$ dan jumlahnya $\\dfrac{143}{3}$, maka bilangan terbesarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$55$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan tiga bilangan geometri adalah $\\dfrac{a}{r}, a, ar$ dan cari $a$ dari hasil kalinya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{a}{r} \\cdot a \\cdot ar = 1331 \\Rightarrow a^3 = 1331 \\Rightarrow a = 11" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan jumlah ketiga bilangan ($\\dfrac{143}{3}$) untuk menentukan rasio ($r$)**" },
        { "tipe": "formula_block", "latex": "\\dfrac{11}{r} + 11 + 11r = \\dfrac{143}{3} \\Rightarrow \\dfrac{11}{r} + 11r = \\dfrac{110}{3} \\Rightarrow \\dfrac{1}{r} + r = \\dfrac{10}{3}" },
        { "tipe": "formula_block", "latex": "3r^2 - 10r + 3 = 0 \\Rightarrow (3r - 1)(r - 3) = 0 \\Rightarrow r = 3 \\quad \\text{atau} \\quad r = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan ketiga bilangan dan ambil nilai terbesarnya**" },
        { "tipe": "formula_block", "latex": "\\text{Barisan bilangan: } \\dfrac{11}{3}, 11, 33 \\Rightarrow \\text{bilangan terbesar} = 33" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bilangan terbesarnya adalah **$33$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = n^3 + 3n^2 - 2n$. Suku ke-6 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$114$" } ],
        [ { "tipe": "paragraph", "text": "$118$" } ],
        [ { "tipe": "paragraph", "text": "$122$" } ],
        [ { "tipe": "paragraph", "text": "$126$" } ],
        [ { "tipe": "paragraph", "text": "$130$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hubungan $U_n = S_n - S_{n - 1}$ untuk $n = 6$**" },
        { "tipe": "formula_block", "latex": "U_6 = S_6 - S_5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $S_6$ dan $S_5$**" },
        { "tipe": "formula_block", "latex": "S_6 = 6^3 + 3(6)^2 - 2(6) = 216 + 108 - 12 = 312" },
        { "tipe": "formula_block", "latex": "S_5 = 5^3 + 3(5)^2 - 2(5) = 125 + 75 - 10 = 190" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kurangkan $S_6$ dengan $S_5$ untuk memperoleh $U_6$**" },
        { "tipe": "formula_block", "latex": "U_6 = 312 - 190 = 122" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-6 deret tersebut adalah **$122$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{4}{9} + \\dfrac{8}{27} + \\dfrac{12}{81} + \\dfrac{16}{243} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan deret dalam notasi sigma dengan $r = \\dfrac{1}{3}$**" },
        { "tipe": "formula_block", "latex": "S = \\sum_{n=1}^{\\infty} \\dfrac{4n}{3^{n + 1}} = \\dfrac{4}{3} \\sum_{n=1}^{\\infty} n \\left(\\dfrac{1}{3}\\right)^n" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus $\\sum_{n=1}^{\\infty} n r^n = \\dfrac{r}{(1 - r)^2}$ dan hitung hasilnya**" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{4}{3} \\cdot \\dfrac{\\dfrac{1}{3}}{\\left(1 - \\dfrac{1}{3}\\right)^2} = \\dfrac{4}{3} \\cdot \\dfrac{\\dfrac{1}{3}}{\\dfrac{4}{9}} = \\dfrac{4}{3} \\cdot \\dfrac{3}{4} = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tak hingga tersebut adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 4, \\log(4^x - 4), \\log(4^x + 20)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat barisan aritmatika pada tiga suku logaritma**" },
        { "tipe": "formula_block", "latex": "2 \\log(4^x - 4) = \\log 4 + \\log(4^x + 20) \\Rightarrow (4^x - 4)^2 = 4(4^x + 20)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $t = 4^x$ dan selesaikan persamaan kuadratnya**" },
        { "tipe": "formula_block", "latex": "(t - 4)^2 = 4(t + 20) \\Rightarrow t^2 - 8t + 16 = 4t + 80 \\Rightarrow t^2 - 12t - 64 = 0" },
        { "tipe": "formula_block", "latex": "(t - 16)(t + 4) = 0 \\Rightarrow t = 16 \\quad (\\text{karena } t = 4^x > 0)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke variabel $x$ untuk memperoleh penyelesaiannya**" },
        { "tipe": "formula_block", "latex": "4^x = 16 = 4^2 \\Rightarrow x = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri $6 + 18 + 54 + \\ldots$ adalah $19680$. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi $a = 6$ dan $r = 3$, lalu susun persamaan dari $S_n = 19680$**" },
        { "tipe": "formula_block", "latex": "S_n = \\dfrac{6(3^n - 1)}{3 - 1} = 19680 \\Rightarrow 3(3^n - 1) = 19680" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan eksponensial untuk mencari nilai $n$**" },
        { "tipe": "formula_block", "latex": "3^n - 1 = 6560 \\Rightarrow 3^n = 6561 = 3^8 \\Rightarrow n = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $n$ adalah **$8$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dijatuhkan dari ketinggian $20$ m. Setiap pantulan mencapai $\\dfrac{3}{4}$ dari ketinggian sebelumnya. Total lintasan bola sampai berhenti adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$120$ m" } ],
        [ { "tipe": "paragraph", "text": "$140$ m" } ],
        [ { "tipe": "paragraph", "text": "$160$ m" } ],
        [ { "tipe": "paragraph", "text": "$180$ m" } ],
        [ { "tipe": "paragraph", "text": "$200$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus total lintasan bola jatuh dan memantul tak hingga**" },
        { "tipe": "formula_block", "latex": "\\text{Total Lintasan} = h + 2 \\cdot \\dfrac{ar}{1 - r}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $h = 20$, $a = 20$, dan $r = \\dfrac{3}{4}$ lalu hitung nilainya**" },
        { "tipe": "formula_block", "latex": "\\text{Total Lintasan} = 20 + 2 \\cdot \\dfrac{20 \\cdot \\dfrac{3}{4}}{1 - \\dfrac{3}{4}} = 20 + 2 \\cdot \\dfrac{15}{\\dfrac{1}{4}} = 20 + 2(60) = 140" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, total lintasan bola sampai berhenti adalah **$140$ m**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 \\cdot 2^1 + 2 \\cdot 2^2 + 3 \\cdot 2^3 + \\ldots + 10 \\cdot 2^{10}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18434$" } ],
        [ { "tipe": "paragraph", "text": "$19434$" } ],
        [ { "tipe": "paragraph", "text": "$20434$" } ],
        [ { "tipe": "paragraph", "text": "$21434$" } ],
        [ { "tipe": "paragraph", "text": "$22434$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jumlah deret aritmatika-geometri hingga $\\sum_{k=1}^{n} k \\cdot 2^k = (n - 1)2^{n + 1} + 2$**" },
        { "tipe": "formula_block", "latex": "\\sum_{k=1}^{10} k \\cdot 2^k = (10 - 1)2^{10 + 1} + 2 = 9 \\cdot 2^{11} + 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai numeriknya**" },
        { "tipe": "formula_block", "latex": "9 \\cdot 2048 + 2 = 18432 + 2 = 18434" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$18434$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
