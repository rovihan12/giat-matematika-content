{
  "id": "bs-k10-bd-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang barisan bertingkat, rekursif, dan deret lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-14 dari barisan bertingkat $7, 10, 15, 22, 31, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$196$" } ],
        [ { "tipe": "paragraph", "text": "$198$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ],
        [ { "tipe": "paragraph", "text": "$202$" } ],
        [ { "tipe": "paragraph", "text": "$204$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Analisis selisih antar-suku bertingkat: $3, 5, 7, 9, \\ldots$ (aritmatika dengan beda tetap $2$). Pola ini menunjukkan rumus umum suku ke-$n$ berbentuk kuadrat, yaitu $U_n = n^2 + 6$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung suku ke-14 ($U_{14}$) dengan mensubstitusikan $n = 14$:" },
        { "tipe": "paragraph", "text": "$U_{14} = 14^2 + 6 = 196 + 6 = 202$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-14 adalah $202$ (pilihan keempat)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $w_1, w_2, w_3, \\ldots$ didefinisikan dengan $w_1 = 2$, $w_2 = 6$, dan $w_n = 4w_{n-1} - 3w_{n-2}$ untuk $n \\ge 3$. Nilai $w_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$150$" } ],
        [ { "tipe": "paragraph", "text": "$156$" } ],
        [ { "tipe": "paragraph", "text": "$162$" } ],
        [ { "tipe": "paragraph", "text": "$168$" } ],
        [ { "tipe": "paragraph", "text": "$174$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus rekurensi secara bertahap mulai dari $n = 3$ hingga $n = 5$:" },
        { "tipe": "paragraph", "text": "$w_3 = 4(6) - 3(2) = 24 - 6 = 18$." },
        { "tipe": "paragraph", "text": "$w_4 = 4(18) - 3(6) = 72 - 18 = 54$." },
        { "tipe": "paragraph", "text": "$w_5 = 4(54) - 3(18) = 216 - 54 = 162$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $w_5$ adalah $162$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{4 \\cdot 6} + \\dfrac{1}{6 \\cdot 8} + \\dfrac{1}{8 \\cdot 10} + \\ldots + \\dfrac{1}{24 \\cdot 26}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{104}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{52}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk umum suku ke-$k$ menggunakan pecahan parsial: $\\dfrac{1}{(2k+2)(2k+4)} = \\dfrac{1}{2}\\left(\\dfrac{1}{2k+2} - \\dfrac{1}{2k+4}\\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Jabarkan bentuk telescoping dari $k=1$ sampai $k=11$:" },
        { "tipe": "paragraph", "text": "$S = \\dfrac{1}{2} \\left( \\dfrac{1}{4} - \\dfrac{1}{6} + \\dfrac{1}{6} - \\dfrac{1}{8} + \\dots - \\dfrac{1}{26} \\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Suku-suku di tengah saling menghilangkan, menyisakan suku pertama dan terakhir:" },
        { "tipe": "paragraph", "text": "$S = \\dfrac{1}{2}\\left(\\dfrac{1}{4} - \\dfrac{1}{26}\\right) = \\dfrac{1}{2} \\cdot \\dfrac{22}{104} = \\dfrac{11}{104}$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tersebut adalah $\\dfrac{11}{104}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan geometri. Jika hasil kalinya $1000$ dan jumlahnya $35$, maka bilangan terbesarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Misalkan tiga bilangan geometri tersebut adalah $\\dfrac{a}{r}, a, ar$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan informasi hasil kali $= a^3 = 1000 \\Rightarrow a = 10$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan informasi jumlah:" },
        { "tipe": "paragraph", "text": "$\\dfrac{10}{r} + 10 + 10r = 35 \\Rightarrow \\dfrac{10}{r} + 10r = 25$." },
        { "tipe": "paragraph", "text": "Kalikan $r$ dan sederhanakan menjadi: $10r^2 - 25r + 10 = 0 \\Rightarrow 2r^2 - 5r + 2 = 0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan persamaan: $(2r-1)(r-2) = 0 \\Rightarrow r = 2$ atau $r = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 5:</strong> Jika $a = 10$ dan $r = 2$, maka bilangan tersebut adalah $5, 10, 20$, sehingga bilangan terbesarnya adalah $20$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = 2n^3 + n^2 - 3n$. Suku ke-5 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$128$" } ],
        [ { "tipe": "paragraph", "text": "$132$" } ],
        [ { "tipe": "paragraph", "text": "$136$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan hubungan antara jumlah suku dan suku ke-$n$ ($U_n = S_n - S_{n-1}$). " },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung $S_5$ dan $S_4$:" },
        { "tipe": "paragraph", "text": "$S_5 = 2(5)^3 + (5)^2 - 3(5) = 250 + 25 - 15 = 260$." },
        { "tipe": "paragraph", "text": "$S_4 = 2(4)^3 + (4)^2 - 3(4) = 128 + 16 - 12 = 132$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Tentukan suku ke-5 ($U_5$):" },
        { "tipe": "paragraph", "text": "$U_5 = S_5 - S_4 = 260 - 132 = 128$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-5 adalah $128$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{5} + \\dfrac{4}{25} + \\dfrac{9}{125} + \\dfrac{16}{625} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{45}{256}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Identifikasi bentuk AGP: $S = \\sum_{n=1}^{\\infty} \\dfrac{n^2}{5^n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus $\\sum_{n=1}^{\\infty} n^2 r^n = \\dfrac{r(1+r)}{(1-r)^3}$ dengan $r = \\dfrac{1}{5}$:" },
        { "tipe": "paragraph", "text": "$S = \\dfrac{\\dfrac{1}{5}\\left(1 + \\dfrac{1}{5}\\right)}{\\left(1 - \\dfrac{1}{5}\\right)^3} = \\dfrac{\\dfrac{6}{25}}{\\dfrac{64}{125}}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan perhitungan:" },
        { "tipe": "paragraph", "text": "$S = \\dfrac{6}{25} \\cdot \\dfrac{125}{64} = \\dfrac{30}{64} = \\dfrac{15}{32}$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tersebut adalah $\\dfrac{15}{32}$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 4, \\log(4^x - 4), \\log(4^x + 20)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan sifat tengah barisan aritmatika: $2\\log(4^x - 4) = \\log 4 + \\log(4^x + 20)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan menjadi: $(4^x - 4)^2 = 4(4^x + 20)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Misalkan $t = 4^x$, sehingga diperoleh: $t^2 - 8t + 16 = 4t + 80 \\Rightarrow t^2 - 12t - 64 = 0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan: $(t - 16)(t + 4) = 0 \\Rightarrow t = 16$ (karena $t = 4^x > 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 5:</strong> Selesaikan $4^x = 16 \\Rightarrow x = 2$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ adalah $2$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri $5 + 15 + 45 + \\ldots$ adalah $16400$. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan $a = 5$ dan $r = 3$ dari deret tersebut." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret geometri:" },
        { "tipe": "paragraph", "text": "$S_n = \\dfrac{5(3^n - 1)}{3 - 1} = \\dfrac{5(3^n - 1)}{2} = 16400$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan eksponensial:" },
        { "tipe": "paragraph", "text": "$3^n - 1 = 16400 \\cdot \\dfrac{2}{5} = 6560 \\Rightarrow 3^n = 6561 = 3^8 \\Rightarrow n = 8$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $n$ adalah $8$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dijatuhkan dari ketinggian $18$ m. Setiap pantulan mencapai $\\dfrac{1}{3}$ dari ketinggian sebelumnya. Total lintasan bola sampai berhenti adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$ m" } ],
        [ { "tipe": "paragraph", "text": "$36$ m" } ],
        [ { "tipe": "paragraph", "text": "$42$ m" } ],
        [ { "tipe": "paragraph", "text": "$48$ m" } ],
        [ { "tipe": "paragraph", "text": "$54$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus total lintasan bola jatuh dan memantul: $\\text{Total} = h + 2 \\cdot \\dfrac{ar}{1 - r}$ dengan $h = 18$ dan $r = \\dfrac{1}{3}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai-nilai tersebut:" },
        { "tipe": "paragraph", "text": "$\\text{Total} = 18 + 2 \\cdot \\dfrac{18 \\cdot \\dfrac{1}{3}}{1 - \\dfrac{1}{3}}$" },
        { "tipe": "paragraph", "text": "$= 18 + 2 \\cdot \\dfrac{6}{\\dfrac{2}{3}} = 18 + 2(9) = 36$ m." },
        { "tipe": "paragraph", "text": "Jadi, total lintasan bola sampai berhenti adalah $36$ m (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 \\cdot 2 \\cdot 3 + 2 \\cdot 3 \\cdot 4 + 3 \\cdot 4 \\cdot 5 + \\ldots + 10 \\cdot 11 \\cdot 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3960$" } ],
        [ { "tipe": "paragraph", "text": "$4290$" } ],
        [ { "tipe": "paragraph", "text": "$4620$" } ],
        [ { "tipe": "paragraph", "text": "$4950$" } ],
        [ { "tipe": "paragraph", "text": "$5280$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus deret perkalian tiga suku berurutan: $\\sum_{k=1}^{n} k(k+1)(k+2) = \\dfrac{n(n+1)(n+2)(n+3)}{4}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $n = 10$:" },
        { "tipe": "paragraph", "text": "$\\dfrac{10 \\cdot 11 \\cdot 12 \\cdot 13}{4} = 10 \\cdot 11 \\cdot 3 \\cdot 13 = 4290$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tersebut adalah $4290$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
