{
  "id": "bs-k10-bd-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang deret aritmatika bertingkat dan aplikasi lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-12 dari barisan $1, 5, 11, 19, 29, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$145$" } ],
        [ { "tipe": "paragraph", "text": "$155$" } ],
        [ { "tipe": "paragraph", "text": "$165$" } ],
        [ { "tipe": "paragraph", "text": "$175$" } ],
        [ { "tipe": "paragraph", "text": "$185$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis selisih bertingkat barisan untuk menentukan rumus suku ke-$n$**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $4, 6, 8, 10, \\ldots$ dan selisih tingkat kedua tetap yaitu $2$, sehingga suku ke-$n$ berbentuk kuadrat:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + n - 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 12$ untuk memperoleh suku ke-12**" },
        { "tipe": "formula_block", "latex": "U_{12} = 12^2 + 12 - 1 = 144 + 12 - 1 = 155" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-12 dari barisan tersebut adalah **$155$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri dengan $U_1 = 8$ dan $U_3 = 2$ (rasio positif) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rasio positif ($r$) dari $U_1 = a = 8$ dan $U_3 = a \\cdot r^2 = 2$**" },
        { "tipe": "formula_block", "latex": "8r^2 = 2 \\Rightarrow r^2 = \\dfrac{2}{8} = \\dfrac{1}{4} \\Rightarrow r = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah tak hingga menggunakan rumus $S_\\infty = \\dfrac{a}{1 - r}$**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\dfrac{8}{1 - \\dfrac{1}{2}} = \\dfrac{8}{\\dfrac{1}{2}} = 8 \\times 2 = 16" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah tak hingga deret geometri tersebut adalah **$16$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-15 dari barisan $3, 8, 15, 24, 35, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$220$" } ],
        [ { "tipe": "paragraph", "text": "$224$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$255$" } ],
        [ { "tipe": "paragraph", "text": "$260$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rumus suku ke-$n$ dari pola barisan bertingkat**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $5, 7, 9, 11, \\ldots$ dengan beda tetap $2$, sehingga diperoleh:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + 2n" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 15$ untuk menghitung suku ke-15**" },
        { "tipe": "formula_block", "latex": "U_{15} = 15^2 + 2(15) = 225 + 30 = 255" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-15 dari barisan tersebut adalah **$255$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{a}, \\dfrac{1}{b}, \\dfrac{1}{c}$ membentuk barisan aritmatika dengan $a = 2$, $c = 6$, maka $b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat barisan aritmatika pada tiga suku berurutan**" },
        { "tipe": "formula_block", "latex": "2 \\cdot \\dfrac{1}{b} = \\dfrac{1}{a} + \\dfrac{1}{c}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $a = 2$ dan $c = 6$ lalu selesaikan untuk $b$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{b} = \\dfrac{1}{2} + \\dfrac{1}{6} = \\dfrac{4}{6} = \\dfrac{2}{3}" },
        { "tipe": "formula_block", "latex": "2b = 6 \\Rightarrow b = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $b$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret $1 + 4 + 7 + \\ldots$ adalah 145. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi $a = 1$ dan $b = 3$, lalu susun persamaan dari $S_n = 145$**" },
        { "tipe": "formula_block", "latex": "S_n = \\dfrac{n}{2}\\big(2(1) + (n - 1) \\cdot 3\\big) = 145" },
        { "tipe": "formula_block", "latex": "\\dfrac{n(3n - 1)}{2} = 145 \\Rightarrow 3n^2 - n - 290 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan atau uji nilai $n$ bilangan asli yang memenuhi**" },
        { "tipe": "formula_block", "latex": "(n - 10)(3n + 29) = 0 \\Rightarrow n = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $n$ adalah **$10$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan geometri, $U_2 \\cdot U_4 = 64$ dan $U_3 = 8$. Jika rasio barisan tersebut adalah $r = 2$, maka suku pertama barisan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus suku ke-$3$ barisan geometri ($U_3 = a \\cdot r^2 = 8$)**" },
        { "tipe": "formula_block", "latex": "a \\cdot r^2 = 8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $r = 2$ untuk menghitung suku pertama ($a$)**" },
        { "tipe": "formula_block", "latex": "a \\cdot 2^2 = 8 \\Rightarrow 4a = 8 \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama barisan geometri tersebut adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1^2 + 2^2 + 3^2 + \\ldots + 10^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$285$" } ],
        [ { "tipe": "paragraph", "text": "$355$" } ],
        [ { "tipe": "paragraph", "text": "$385$" } ],
        [ { "tipe": "paragraph", "text": "$405$" } ],
        [ { "tipe": "paragraph", "text": "$455$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jumlah kuadrat $n$ bilangan asli pertama**" },
        { "tipe": "formula_block", "latex": "\\sum_{k=1}^{n} k^2 = \\dfrac{n(n + 1)(2n + 1)}{6}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 10$ dan hitung hasilnya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{10(10 + 1)(2 \\cdot 10 + 1)}{6} = \\dfrac{10 \\cdot 11 \\cdot 21}{6} = \\dfrac{2310}{6} = 385" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$385$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $5, 11, 19, 29, 41, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 3n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2n + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 3n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n^2 + 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + n + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis pola selisih bertingkat dari barisan**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $6, 8, 10, 12, \\ldots$ dengan beda tetap $2$, sehingga suku ke-$n$ berbentuk:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + 3n + 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Verifikasi rumus untuk $n = 1$ dan $n = 2$**" },
        { "tipe": "formula_block", "latex": "U_1 = 1^2 + 3(1) + 1 = 5, \\qquad U_2 = 2^2 + 3(2) + 1 = 11" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = n^2 + 3n + 1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 2, \\log(x+1), \\log(x+5)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat barisan aritmatika pada tiga suku berurutan**" },
        { "tipe": "formula_block", "latex": "2 \\log(x + 1) = \\log 2 + \\log(x + 5)" },
        { "tipe": "formula_block", "latex": "\\log(x + 1)^2 = \\log\\big(2(x + 5)\\big)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan numerus dan selesaikan persamaan kuadratnya**" },
        { "tipe": "formula_block", "latex": "(x + 1)^2 = 2(x + 5) \\Rightarrow x^2 + 2x + 1 = 2x + 10 \\Rightarrow x^2 = 9" },
        { "tipe": "formula_block", "latex": "x = 3 \\quad \\text{atau} \\quad x = -3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji syarat numerus ($x + 1 > 0$ dan $x + 5 > 0$)**" },
        { "tipe": "paragraph", "text": "Untuk $x = -3$, numerus $x + 1 = -2$ tidak memenuhi syarat positif, sehingga nilai yang memenuhi adalah $x = 3$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{2} + \\dfrac{2}{4} + \\dfrac{3}{8} + \\dfrac{4}{16} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan deret sebagai deret aritmatika-geometri tak hingga dengan $r = \\dfrac{1}{2}$**" },
        { "tipe": "formula_block", "latex": "\\sum_{n=1}^{\\infty} \\dfrac{n}{2^n} = \\sum_{n=1}^{\\infty} n \\left(\\dfrac{1}{2}\\right)^n" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus $\\sum_{n=1}^{\\infty} n r^n = \\dfrac{r}{(1 - r)^2}$ untuk $|r| < 1$**" },
        { "tipe": "formula_block", "latex": "\\sum_{n=1}^{\\infty} n \\left(\\dfrac{1}{2}\\right)^n = \\dfrac{\\dfrac{1}{2}}{\\left(1 - \\dfrac{1}{2}\\right)^2} = \\dfrac{\\dfrac{1}{2}}{\\dfrac{1}{4}} = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tak hingga tersebut adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
