{
  "id": "bs-k10-bd-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang deret aritmatika bertingkat dan aplikasi lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-12 dari barisan $1, 5, 11, 19, 29, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$145$" } ],
        [ { "tipe": "paragraph", "text": "$155$" } ],
        [ { "tipe": "paragraph", "text": "$165$" } ],
        [ { "tipe": "paragraph", "text": "$175$" } ],
        [ { "tipe": "paragraph", "text": "$185$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Selisih: $4, 6, 8, 10, \\ldots$ (aritmatika beda 2)." },
        { "tipe": "paragraph", "text": "Rumus: $U_n = n^2 + n - 1$." },
        { "tipe": "paragraph", "text": "$U_{12} = 144 + 12 - 1 = 155$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri dengan $U_1 = 8$ dan $U_3 = 2$ (rasio positif) adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_3 = a r^2 = 2 \\Rightarrow 8 r^2 = 2 \\Rightarrow r^2 = \\dfrac{1}{4}$" },
        { "tipe": "paragraph", "text": "$r = \\dfrac{1}{2}$ (positif)" },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{8}{1 - 1/2} = \\dfrac{8}{1/2} = 16$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-15 dari barisan $3, 8, 15, 24, 35, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$220$" } ],
        [ { "tipe": "paragraph", "text": "$224$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$255$" } ],
        [ { "tipe": "paragraph", "text": "$260$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pola: $U_n = n^2 + 2n$ (cek: $1+2=3$, $4+4=8$, $9+6=15$)." },
        { "tipe": "paragraph", "text": "$U_{15} = 225 + 30 = 255$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{a}, \\dfrac{1}{b}, \\dfrac{1}{c}$ membentuk barisan aritmatika dengan $a = 2$, $c = 6$, maka $b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sifat barisan aritmatika: $2 \\cdot \\dfrac{1}{b} = \\dfrac{1}{a} + \\dfrac{1}{c}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{2}{b} = \\dfrac{1}{2} + \\dfrac{1}{6} = \\dfrac{4}{6} = \\dfrac{2}{3}$" },
        { "tipe": "paragraph", "text": "$b = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret $1 + 4 + 7 + \\ldots$ adalah 145. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(2 + 3(n-1)) = \\dfrac{n(3n - 1)}{2} = 145$" },
        { "tipe": "paragraph", "text": "$3n^2 - n = 290 \\Rightarrow 3n^2 - n - 290 = 0$" },
        { "tipe": "paragraph", "text": "Coba $n = 10$: $300 - 10 = 290$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan geometri, $U_2 \\cdot U_4 = 64$ dan $U_3 = 8$. Jika rasio barisan tersebut adalah $r = 2$, maka suku pertama barisan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Diketahui $U_3 = a \\cdot r^2 = 8$." },
        { "tipe": "paragraph", "text": "Untuk $r = 2$, diperoleh $a \\cdot 2^2 = 8 \\Rightarrow 4a = 8 \\Rightarrow a = 2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1^2 + 2^2 + 3^2 + \\ldots + 10^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$285$" } ],
        [ { "tipe": "paragraph", "text": "$355$" } ],
        [ { "tipe": "paragraph", "text": "$385$" } ],
        [ { "tipe": "paragraph", "text": "$405$" } ],
        [ { "tipe": "paragraph", "text": "$455$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus: $\\sum_{k=1}^n k^2 = \\dfrac{n(n+1)(2n+1)}{6}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{10 \\cdot 11 \\cdot 21}{6} = \\dfrac{2310}{6} = 385$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $5, 11, 19, 29, 41, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 3n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2n + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 3n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n^2 + 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + n + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Selisih: $6, 8, 10, 12, \\ldots$ (aritmatika beda 2)." },
        { "tipe": "paragraph", "text": "Rumus: $U_n = n^2 + 3n + 1$." },
        { "tipe": "paragraph", "text": "Cek: $n=1 \\rightarrow 5$, $n=2 \\rightarrow 11$, $n=3 \\rightarrow 19$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 2, \\log(x+1), \\log(x+5)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sifat aritmatika: $2 \\log(x+1) = \\log 2 + \\log(x+5)$" },
        { "tipe": "paragraph", "text": "$(x+1)^2 = 2(x+5)$" },
        { "tipe": "paragraph", "text": "$x^2 + 2x + 1 = 2x + 10$" },
        { "tipe": "paragraph", "text": "$x^2 = 9 \\Rightarrow x = 3$ (karena $x > -1$ agar numerus positif)" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{2} + \\dfrac{2}{4} + \\dfrac{3}{8} + \\dfrac{4}{16} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Deret aritmatika-geometri: $\\sum_{n=1}^{\\infty} \\dfrac{n}{2^n}$" },
        { "tipe": "paragraph", "text": "Rumus: $\\sum_{n=1}^{\\infty} n r^n = \\dfrac{r}{(1-r)^2}$ untuk $|r| < 1$, dengan $r = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "$= \\dfrac{1/2}{(1/2)^2} = \\dfrac{1/2}{1/4} = 2$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}