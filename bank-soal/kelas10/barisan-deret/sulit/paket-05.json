{
  "id": "bs-k10-bd-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang deret dan aplikasi kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{2} + \\dfrac{1}{6} + \\dfrac{1}{12} + \\dfrac{1}{20} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{1}{n(n+1)} = \\dfrac{1}{n} - \\dfrac{1}{n+1}$" },
        { "tipe": "paragraph", "text": "$S_\\infty = 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 barisan geometri $\\dfrac{1}{3}, \\dfrac{1}{9}, \\dfrac{1}{27}, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{243}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{729}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{81}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = \\dfrac{1}{3}$, $r = \\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "$U_6 = \\dfrac{1}{3} \\cdot \\left(\\dfrac{1}{3}\\right)^5 = \\dfrac{1}{3^6} = \\dfrac{1}{729}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $1, 3, 6, 10, 15, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = \\dfrac{n(n+1)}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = \\dfrac{n(n-1)}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bilangan segitiga: $U_n = \\dfrac{n(n+1)}{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret $\\dfrac{1}{3} + \\dfrac{1}{9} + \\dfrac{1}{27} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{1/3}{1 - 1/3} = \\dfrac{1/3}{2/3} = \\dfrac{1}{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan $1, 5, 11, 19, 29, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$71$" } ],
        [ { "tipe": "paragraph", "text": "$73$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$77$" } ],
        [ { "tipe": "paragraph", "text": "$79$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pola: $U_n = n^2 + n - 1$." },
        { "tipe": "paragraph", "text": "$U_8 = 64 + 8 - 1 = 71$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret aritmatika memiliki $U_1 = 4$ dan $U_{20} = 80$. Jumlah 20 suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$800$" } ],
        [ { "tipe": "paragraph", "text": "$820$" } ],
        [ { "tipe": "paragraph", "text": "$840$" } ],
        [ { "tipe": "paragraph", "text": "$860$" } ],
        [ { "tipe": "paragraph", "text": "$880$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_{20} = \\dfrac{20}{2}(4 + 80) = 10 \\cdot 84 = 840$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{a}, \\dfrac{1}{b}, \\dfrac{1}{c}$ barisan aritmatika dengan $a = 3$ dan $c = 9$, maka $b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2}{b} = \\dfrac{1}{3} + \\dfrac{1}{9} = \\dfrac{4}{9}$" },
        { "tipe": "paragraph", "text": "$b = \\dfrac{18}{4} = \\dfrac{9}{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 + 4 + 16 + 64 + \\ldots + 4^{10}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4^{11} - 1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4^{10} - 1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$4^{11} - 1$" } ],
        [ { "tipe": "paragraph", "text": "$4^{10} - 1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4^{11}}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Ada 11 suku (dari $4^0$ sampai $4^{10}$)." },
        { "tipe": "paragraph", "text": "$S_{11} = \\dfrac{1(4^{11} - 1)}{4 - 1} = \\dfrac{4^{11} - 1}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah pabrik memproduksi 500 unit pada tahun pertama, 600 unit tahun kedua, 700 tahun ketiga, dst. Total produksi 10 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8700$" } ],
        [ { "tipe": "paragraph", "text": "$9000$" } ],
        [ { "tipe": "paragraph", "text": "$9500$" } ],
        [ { "tipe": "paragraph", "text": "$10000$" } ],
        [ { "tipe": "paragraph", "text": "$10500$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 500$, $b = 100$, $n = 10$" },
        { "tipe": "paragraph", "text": "$S_{10} = \\dfrac{10}{2}(2 \\cdot 500 + 9 \\cdot 100) = 5(1000 + 900) = 5 \\cdot 1900 = 9500$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 barisan geometri dengan $U_2 = 6$ dan $U_4 = 54$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$162$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$216$" } ],
        [ { "tipe": "paragraph", "text": "$243$" } ],
        [ { "tipe": "paragraph", "text": "$270$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r^2 = \\dfrac{54}{6} = 9 \\Rightarrow r = 3$" },
        { "tipe": "paragraph", "text": "$U_5 = U_4 \\cdot r = 54 \\cdot 3 = 162$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
