{
  "id": "bs-k10-bd-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang deret dan aplikasi kompleks",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{2} + \\dfrac{1}{6} + \\dfrac{1}{12} + \\dfrac{1}{20} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan suku umum deret sebagai perkalian dua bilangan berurutan lalu urai menjadi pecahan parsial**" },
        { "tipe": "formula_block", "latex": "\\sum_{n=1}^{\\infty} \\dfrac{1}{n(n + 1)} = \\sum_{n=1}^{\\infty} \\left(\\dfrac{1}{n} - \\dfrac{1}{n + 1}\\right)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung limit jumlah parsialnya saat $N$ menuju tak hingga**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\lim_{N \\to \\infty} \\left(1 - \\dfrac{1}{N + 1}\\right) = 1 - 0 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tak hingga tersebut adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 barisan geometri $\\dfrac{1}{3}, \\dfrac{1}{9}, \\dfrac{1}{27}, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{243}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{729}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{81}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{27}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama ($a$) dan rasio ($r$) barisan geometri**" },
        { "tipe": "formula_block", "latex": "a = \\dfrac{1}{3}, \\qquad r = \\dfrac{\\dfrac{1}{9}}{\\dfrac{1}{3}} = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku ke-6 menggunakan rumus $U_n = a \\cdot r^{n - 1}$**" },
        { "tipe": "formula_block", "latex": "U_6 = \\dfrac{1}{3} \\cdot \\left(\\dfrac{1}{3}\\right)^{6 - 1} = \\dfrac{1}{3} \\cdot \\left(\\dfrac{1}{3}\\right)^5 = \\dfrac{1}{3^6} = \\dfrac{1}{729}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-6 barisan geometri tersebut adalah **$\\dfrac{1}{729}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $1, 3, 6, 10, 15, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = \\dfrac{n(n+1)}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = \\dfrac{n(n-1)}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kenali pola barisan bilangan segitiga**" },
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan bilangan segitiga merupakan jumlah $n$ bilangan asli pertama ($1 + 2 + 3 + \\ldots + n$), sehingga rumusnya adalah:" },
        { "tipe": "formula_block", "latex": "U_n = \\dfrac{n(n + 1)}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Verifikasi rumus untuk beberapa suku pertama**" },
        { "tipe": "formula_block", "latex": "U_1 = \\dfrac{1(2)}{2} = 1, \\qquad U_3 = \\dfrac{3(4)}{2} = 6, \\qquad U_5 = \\dfrac{5(6)}{2} = 15" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = \\dfrac{n(n + 1)}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret $\\dfrac{1}{3} + \\dfrac{1}{9} + \\dfrac{1}{27} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama ($a$) dan rasio ($r$) deret geometri**" },
        { "tipe": "formula_block", "latex": "a = \\dfrac{1}{3}, \\qquad r = \\dfrac{\\dfrac{1}{9}}{\\dfrac{1}{3}} = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah tak hingga menggunakan rumus $S_\\infty = \\dfrac{a}{1 - r}$**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\dfrac{\\dfrac{1}{3}}{1 - \\dfrac{1}{3}} = \\dfrac{\\dfrac{1}{3}}{\\dfrac{2}{3}} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah tak hingga deret tersebut adalah **$\\dfrac{1}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan $1, 5, 11, 19, 29, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$71$" } ],
        [ { "tipe": "paragraph", "text": "$73$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$77$" } ],
        [ { "tipe": "paragraph", "text": "$79$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rumus umum suku ke-$n$ dari pola barisan bertingkat**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $4, 6, 8, 10, \\ldots$ dengan beda tetap $2$, sehingga suku ke-$n$ berbentuk:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + n - 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 8$ untuk menghitung suku ke-8**" },
        { "tipe": "formula_block", "latex": "U_8 = 8^2 + 8 - 1 = 64 + 8 - 1 = 71" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-8 barisan tersebut adalah **$71$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret aritmatika memiliki $U_1 = 4$ dan $U_{20} = 80$. Jumlah 20 suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$800$" } ],
        [ { "tipe": "paragraph", "text": "$820$" } ],
        [ { "tipe": "paragraph", "text": "$840$" } ],
        [ { "tipe": "paragraph", "text": "$860$" } ],
        [ { "tipe": "paragraph", "text": "$880$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi $n = 20$, $a = U_1 = 4$, dan $U_{20} = 80$**" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah 20 suku pertama menggunakan rumus $S_n = \\dfrac{n}{2}(a + U_n)$**" },
        { "tipe": "formula_block", "latex": "S_{20} = \\dfrac{20}{2}(4 + 80) = 10 \\cdot 84 = 840" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah 20 suku pertama deret aritmatika tersebut adalah **$840$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{a}, \\dfrac{1}{b}, \\dfrac{1}{c}$ barisan aritmatika dengan $a = 3$ dan $c = 9$, maka $b$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat barisan aritmatika pada tiga suku berurutan**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{b} = \\dfrac{1}{a} + \\dfrac{1}{c}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $a = 3$ dan $c = 9$ lalu selesaikan untuk $b$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{b} = \\dfrac{1}{3} + \\dfrac{1}{9} = \\dfrac{4}{9} \\Rightarrow 4b = 18 \\Rightarrow b = \\dfrac{9}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $b$ adalah **$\\dfrac{9}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 + 4 + 16 + 64 + \\ldots + 4^{10}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4^{11} - 1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4^{10} - 1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$4^{11} - 1$" } ],
        [ { "tipe": "paragraph", "text": "$4^{10} - 1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4^{11}}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama ($a$), rasio ($r$), dan banyak suku ($n$)**" },
        { "tipe": "formula_block", "latex": "a = 1 = 4^0, \\qquad r = 4, \\qquad n = 11 \\; (\\text{dari } 4^0 \\text{ hingga } 4^{10})" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah deret geometri menggunakan rumus $S_n = \\dfrac{a(r^n - 1)}{r - 1}$**" },
        { "tipe": "formula_block", "latex": "S_{11} = \\dfrac{1(4^{11} - 1)}{4 - 1} = \\dfrac{4^{11} - 1}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$\\dfrac{4^{11} - 1}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah pabrik memproduksi 500 unit pada tahun pertama, 600 unit tahun kedua, 700 tahun ketiga, dst. Total produksi 10 tahun adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8700$" } ],
        [ { "tipe": "paragraph", "text": "$9000$" } ],
        [ { "tipe": "paragraph", "text": "$9500$" } ],
        [ { "tipe": "paragraph", "text": "$10000$" } ],
        [ { "tipe": "paragraph", "text": "$10500$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi unsur barisan aritmatika dari soal**" },
        { "tipe": "formula_block", "latex": "a = 500, \\qquad b = 100, \\qquad n = 10" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung total produksi 10 tahun menggunakan rumus $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$**" },
        { "tipe": "formula_block", "latex": "S_{10} = \\dfrac{10}{2}\\big(2(500) + (10 - 1) \\cdot 100\\big) = 5(1000 + 900) = 5 \\cdot 1900 = 9500" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, total produksi selama 10 tahun adalah **$9500$ unit**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 barisan geometri dengan $U_2 = 6$ dan $U_4 = 54$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$162$" } ],
        [ { "tipe": "paragraph", "text": "$180$" } ],
        [ { "tipe": "paragraph", "text": "$216$" } ],
        [ { "tipe": "paragraph", "text": "$243$" } ],
        [ { "tipe": "paragraph", "text": "$270$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rasio positif ($r$) dari perbandingan $U_4$ dan $U_2$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{U_4}{U_2} = r^{4 - 2} = r^2 = \\dfrac{54}{6} = 9 \\Rightarrow r = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku ke-5 ($U_5$) dengan mengalikan $U_4$ dan $r$**" },
        { "tipe": "formula_block", "latex": "U_5 = U_4 \\cdot r = 54 \\cdot 3 = 162" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 barisan geometri tersebut adalah **$162$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
