{
  "id": "bs-k10-bd-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang barisan bertingkat, rekursif, dan deret lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-13 dari barisan bertingkat $6, 9, 14, 21, 30, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$170$" } ],
        [ { "tipe": "paragraph", "text": "$172$" } ],
        [ { "tipe": "paragraph", "text": "$174$" } ],
        [ { "tipe": "paragraph", "text": "$176$" } ],
        [ { "tipe": "paragraph", "text": "$178$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis selisih bertingkat untuk menentukan rumus umum suku ke-$n$**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $3, 5, 7, 9, \\ldots$ dengan beda tetap $2$, sehingga suku ke-$n$ berbentuk:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 13$ untuk menghitung suku ke-13**" },
        { "tipe": "formula_block", "latex": "U_{13} = 13^2 + 5 = 169 + 5 = 174" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-13 dari barisan tersebut adalah **$174$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $z_1, z_2, z_3, \\ldots$ didefinisikan dengan $z_1 = 3$, $z_2 = 7$, dan $z_n = 3z_{n-1} - 2z_{n-2}$ untuk $n \\ge 3$. Nilai $z_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$59$" } ],
        [ { "tipe": "paragraph", "text": "$63$" } ],
        [ { "tipe": "paragraph", "text": "$67$" } ],
        [ { "tipe": "paragraph", "text": "$71$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan rumus rekurensi $z_n = 3z_{n - 1} - 2z_{n - 2}$ untuk mencari $z_3$ dan $z_4$**" },
        { "tipe": "formula_block", "latex": "z_3 = 3z_2 - 2z_1 = 3(7) - 2(3) = 21 - 6 = 15" },
        { "tipe": "formula_block", "latex": "z_4 = 3z_3 - 2z_2 = 3(15) - 2(7) = 45 - 14 = 31" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $z_5$ dari $z_4$ dan $z_3$**" },
        { "tipe": "formula_block", "latex": "z_5 = 3z_4 - 2z_3 = 3(31) - 2(15) = 93 - 30 = 63" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $z_5$ adalah **$63$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{3 \\cdot 5} + \\dfrac{1}{5 \\cdot 7} + \\dfrac{1}{7 \\cdot 9} + \\ldots + \\dfrac{1}{21 \\cdot 23}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{69}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{69}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{20}{69}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{23}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan suku umum deret menjadi pecahan parsial teleskopik**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{(2k + 1)(2k + 3)} = \\dfrac{1}{2}\\left(\\dfrac{1}{2k + 1} - \\dfrac{1}{2k + 3}\\right)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan dari $k = 1$ hingga $k = 10$ dan sederhanakan suku-suku tengahnya**" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2}\\left(\\dfrac{1}{3} - \\dfrac{1}{5} + \\dfrac{1}{5} - \\dfrac{1}{7} + \\ldots + \\dfrac{1}{21} - \\dfrac{1}{23}\\right) = \\dfrac{1}{2}\\left(\\dfrac{1}{3} - \\dfrac{1}{23}\\right)" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2} \\cdot \\dfrac{20}{69} = \\dfrac{10}{69}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$\\dfrac{10}{69}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan geometri. Jika hasil kalinya $729$ dan jumlahnya $39$, maka bilangan terbesarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan tiga bilangan geometri adalah $\\dfrac{a}{r}, a, ar$ dan cari $a$ dari hasil kalinya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{a}{r} \\cdot a \\cdot ar = 729 \\Rightarrow a^3 = 729 \\Rightarrow a = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan jumlah ketiga bilangan ($39$) untuk menentukan rasio ($r$)**" },
        { "tipe": "formula_block", "latex": "\\dfrac{9}{r} + 9 + 9r = 39 \\Rightarrow \\dfrac{9}{r} + 9r = 30 \\Rightarrow 9r^2 - 30r + 9 = 0 \\Rightarrow 3r^2 - 10r + 3 = 0" },
        { "tipe": "formula_block", "latex": "(3r - 1)(r - 3) = 0 \\Rightarrow r = 3 \\quad \\text{atau} \\quad r = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan ketiga bilangan dan ambil nilai terbesarnya**" },
        { "tipe": "formula_block", "latex": "\\text{Barisan bilangan: } 3, 9, 27 \\Rightarrow \\text{bilangan terbesar} = 27" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bilangan terbesarnya adalah **$27$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = 3n^3 - 2n^2 + n$. Suku ke-4 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$94$" } ],
        [ { "tipe": "paragraph", "text": "$98$" } ],
        [ { "tipe": "paragraph", "text": "$102$" } ],
        [ { "tipe": "paragraph", "text": "$106$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hubungan $U_n = S_n - S_{n - 1}$ untuk $n = 4$**" },
        { "tipe": "formula_block", "latex": "U_4 = S_4 - S_3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $S_4$ dan $S_3$**" },
        { "tipe": "formula_block", "latex": "S_4 = 3(4)^3 - 2(4)^2 + 4 = 192 - 32 + 4 = 164" },
        { "tipe": "formula_block", "latex": "S_3 = 3(3)^3 - 2(3)^2 + 3 = 81 - 18 + 3 = 66" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kurangkan $S_4$ dengan $S_3$ untuk memperoleh $U_4$**" },
        { "tipe": "formula_block", "latex": "U_4 = 164 - 66 = 98" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-4 deret tersebut adalah **$98$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{3}{4} + \\dfrac{6}{16} + \\dfrac{9}{64} + \\dfrac{12}{256} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{16}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{20}{9}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{28}{9}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan deret sebagai deret aritmatika-geometri tak hingga dengan $r = \\dfrac{1}{4}$**" },
        { "tipe": "formula_block", "latex": "S = \\sum_{n=1}^{\\infty} \\dfrac{3n}{4^n} = 3 \\sum_{n=1}^{\\infty} n \\left(\\dfrac{1}{4}\\right)^n" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus $\\sum_{n=1}^{\\infty} n r^n = \\dfrac{r}{(1 - r)^2}$ dan hitung hasilnya**" },
        { "tipe": "formula_block", "latex": "S = 3 \\cdot \\dfrac{\\dfrac{1}{4}}{\\left(1 - \\dfrac{1}{4}\\right)^2} = 3 \\cdot \\dfrac{\\dfrac{1}{4}}{\\dfrac{9}{16}} = 3 \\cdot \\dfrac{4}{9} = \\dfrac{4}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tak hingga tersebut adalah **$\\dfrac{4}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 2, \\log(2^x + 2), \\log(2^x + 14)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat barisan aritmatika pada tiga suku logaritma**" },
        { "tipe": "formula_block", "latex": "2 \\log(2^x + 2) = \\log 2 + \\log(2^x + 14) \\Rightarrow (2^x + 2)^2 = 2(2^x + 14)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $t = 2^x$ dan selesaikan persamaan kuadratnya**" },
        { "tipe": "formula_block", "latex": "(t + 2)^2 = 2(t + 14) \\Rightarrow t^2 + 4t + 4 = 2t + 28 \\Rightarrow t^2 + 2t - 24 = 0" },
        { "tipe": "formula_block", "latex": "(t + 6)(t - 4) = 0 \\Rightarrow t = 4 \\quad (\\text{karena } t = 2^x > 0)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke variabel $x$ untuk memperoleh penyelesaiannya**" },
        { "tipe": "formula_block", "latex": "2^x = 4 = 2^2 \\Rightarrow x = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri $4 + 12 + 36 + \\ldots$ adalah $4372$. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi $a = 4$ dan $r = 3$, lalu susun persamaan dari $S_n = 4372$**" },
        { "tipe": "formula_block", "latex": "S_n = \\dfrac{4(3^n - 1)}{3 - 1} = 4372 \\Rightarrow 2(3^n - 1) = 4372" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan eksponensial untuk mencari nilai $n$**" },
        { "tipe": "formula_block", "latex": "3^n - 1 = 2186 \\Rightarrow 3^n = 2187 = 3^7 \\Rightarrow n = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $n$ adalah **$7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dijatuhkan dari ketinggian $15$ m. Setiap pantulan mencapai $\\dfrac{2}{5}$ dari ketinggian sebelumnya. Total lintasan bola sampai berhenti adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$35$ m" } ],
        [ { "tipe": "paragraph", "text": "$40$ m" } ],
        [ { "tipe": "paragraph", "text": "$45$ m" } ],
        [ { "tipe": "paragraph", "text": "$50$ m" } ],
        [ { "tipe": "paragraph", "text": "$55$ m" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus total lintasan bola jatuh dan memantul tak hingga**" },
        { "tipe": "formula_block", "latex": "\\text{Total Lintasan} = h + 2 \\cdot \\dfrac{ar}{1 - r}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $h = 15$, $a = 15$, dan $r = \\dfrac{2}{5}$ lalu hitung nilainya**" },
        { "tipe": "formula_block", "latex": "\\text{Total Lintasan} = 15 + 2 \\cdot \\dfrac{15 \\cdot \\dfrac{2}{5}}{1 - \\dfrac{2}{5}} = 15 + 2 \\cdot \\dfrac{6}{\\dfrac{3}{5}} = 15 + 2(10) = 35" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, total lintasan bola sampai berhenti adalah **$35$ m**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 \\cdot 3 + 2 \\cdot 4 + 3 \\cdot 5 + \\ldots + 15 \\cdot 17$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1400$" } ],
        [ { "tipe": "paragraph", "text": "$1440$" } ],
        [ { "tipe": "paragraph", "text": "$1480$" } ],
        [ { "tipe": "paragraph", "text": "$1520$" } ],
        [ { "tipe": "paragraph", "text": "$1560$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan suku ke-$k$ dalam notasi sigma dan jabarkan**" },
        { "tipe": "formula_block", "latex": "\\sum_{k=1}^{15} k(k + 2) = \\sum_{k=1}^{15} k^2 + 2 \\sum_{k=1}^{15} k" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus jumlah kuadrat dan jumlah bilangan asli untuk $n = 15$**" },
        { "tipe": "formula_block", "latex": "\\sum_{k=1}^{15} k^2 + 2 \\sum_{k=1}^{15} k = \\dfrac{15 \\cdot 16 \\cdot 31}{6} + 2 \\cdot \\dfrac{15 \\cdot 16}{2} = 1240 + 240 = 1480" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$1480$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
