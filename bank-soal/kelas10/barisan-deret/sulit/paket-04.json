{
  "id": "bs-k10-bd-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN tentang deret konvergen dan transformasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-20 barisan $1, 4, 9, 16, 25, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$360$" } ],
        [ { "tipe": "paragraph", "text": "$380$" } ],
        [ { "tipe": "paragraph", "text": "$400$" } ],
        [ { "tipe": "paragraph", "text": "$420$" } ],
        [ { "tipe": "paragraph", "text": "$440$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_n = n^2$, $U_{20} = 400$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri dengan $a = 6$ dan $S_\\infty = 9$ memiliki rasio..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{a}{1-r} \\Rightarrow 9 = \\dfrac{6}{1-r}$" },
        { "tipe": "paragraph", "text": "$1 - r = \\dfrac{2}{3} \\Rightarrow r = \\dfrac{1}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_n = n(n+1)$, $U_8 = 8 \\cdot 9 = 72$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $U_n = 3n^2 - 2n$, maka $U_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_5 = 3(25) - 2(5) = 75 - 10 = 65$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret geometri memiliki $U_1 = 3$ dan $U_5 = 243$. Jumlah 5 suku pertama adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$363$" } ],
        [ { "tipe": "paragraph", "text": "$369$" } ],
        [ { "tipe": "paragraph", "text": "$375$" } ],
        [ { "tipe": "paragraph", "text": "$381$" } ],
        [ { "tipe": "paragraph", "text": "$387$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r^4 = \\dfrac{243}{3} = 81 \\Rightarrow r = 3$" },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{3(3^5 - 1)}{3 - 1} = \\dfrac{3(243 - 1)}{2} = \\dfrac{3 \\cdot 242}{2} = 363$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan $1, 3, 6, 10, 15, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bilangan segitiga: $U_n = \\dfrac{n(n+1)}{2}$" },
        { "tipe": "paragraph", "text": "$U_6 = \\dfrac{6 \\cdot 7}{2} = 21$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $\\dfrac{1}{1 \\cdot 2} + \\dfrac{1}{2 \\cdot 3} + \\dfrac{1}{3 \\cdot 4} + \\ldots + \\dfrac{1}{99 \\cdot 100}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{98}{100}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{99}{100}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{100}{101}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{101}{100}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Telescoping: $S = 1 - \\dfrac{1}{100} = \\dfrac{99}{100}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret aritmatika memiliki $S_5 = 35$ dan $S_{10} = 120$. Suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{5}{2}(2a + 4b) = 35 \\Rightarrow 2a + 4b = 14 \\Rightarrow a + 2b = 7$" },
        { "tipe": "paragraph", "text": "$S_{10} = \\dfrac{10}{2}(2a + 9b) = 120 \\Rightarrow 2a + 9b = 24$" },
        { "tipe": "paragraph", "text": "Kurangkan: $5b = 10 \\Rightarrow b = 2$" },
        { "tipe": "paragraph", "text": "$a + 4 = 7 \\Rightarrow a = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga $a + ar + ar^2 + \\ldots$ memiliki jumlah 12. Jika $a = 3$, maka $r$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$12 = \\dfrac{3}{1-r} \\Rightarrow 1 - r = \\dfrac{1}{4} \\Rightarrow r = \\dfrac{3}{4}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $3, 6, 11, 18, 27, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n^2 - n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Cek: $n=1 → 3$, $n=2 → 6$, $n=3 → 11$, $n=4 → 18$." },
        { "tipe": "paragraph", "text": "Rumus: $U_n = n^2 + 2$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
