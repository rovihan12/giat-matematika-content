{
  "id": "bs-k10-bd-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN tentang deret konvergen dan transformasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-20 barisan $1, 4, 9, 16, 25, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$360$" } ],
        [ { "tipe": "paragraph", "text": "$380$" } ],
        [ { "tipe": "paragraph", "text": "$400$" } ],
        [ { "tipe": "paragraph", "text": "$420$" } ],
        [ { "tipe": "paragraph", "text": "$440$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi pola barisan bilangan kuadrat untuk menentukan rumus suku ke-$n$**" },
        { "tipe": "formula_block", "latex": "U_1 = 1^2, \\quad U_2 = 2^2, \\quad U_3 = 3^2, \\quad \\ldots \\Rightarrow U_n = n^2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 20$ untuk menghitung suku ke-20**" },
        { "tipe": "formula_block", "latex": "U_{20} = 20^2 = 400" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-20 barisan tersebut adalah **$400$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri dengan $a = 6$ dan $S_\\infty = 9$ memiliki rasio..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $a = 6$ dan $S_\\infty = 9$ ke rumus jumlah deret geometri tak hingga**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\dfrac{a}{1 - r} \\Rightarrow 9 = \\dfrac{6}{1 - r} \\Rightarrow 1 - r = \\dfrac{6}{9} = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai rasio ($r$)**" },
        { "tipe": "formula_block", "latex": "r = 1 - \\dfrac{2}{3} = \\dfrac{1}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rasio deret geometri tersebut adalah **$\\dfrac{1}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi pola perkalian berurutan untuk menentukan rumus suku ke-$n$**" },
        { "tipe": "formula_block", "latex": "U_1 = 1 \\times 2, \\quad U_2 = 2 \\times 3, \\quad U_3 = 3 \\times 4, \\quad \\ldots \\Rightarrow U_n = n(n + 1)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 8$ untuk menghitung suku ke-8**" },
        { "tipe": "formula_block", "latex": "U_8 = 8(8 + 1) = 8 \\times 9 = 72" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-8 barisan tersebut adalah **$72$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $U_n = 3n^2 - 2n$, maka $U_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $n = 5$ ke rumus umum suku ke-$n$**" },
        { "tipe": "formula_block", "latex": "U_5 = 3(5)^2 - 2(5)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai aritmatikanya**" },
        { "tipe": "formula_block", "latex": "U_5 = 3(25) - 10 = 75 - 10 = 65" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $U_5$ adalah **$65$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret geometri memiliki $U_1 = 3$ dan $U_5 = 243$. Jumlah 5 suku pertama adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$363$" } ],
        [ { "tipe": "paragraph", "text": "$369$" } ],
        [ { "tipe": "paragraph", "text": "$375$" } ],
        [ { "tipe": "paragraph", "text": "$381$" } ],
        [ { "tipe": "paragraph", "text": "$387$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rasio ($r$) dari $U_1 = a = 3$ dan $U_5 = a \\cdot r^4 = 243$**" },
        { "tipe": "formula_block", "latex": "3r^4 = 243 \\Rightarrow r^4 = 81 \\Rightarrow r = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah 5 suku pertama menggunakan rumus $S_n = \\dfrac{a(r^n - 1)}{r - 1}$**" },
        { "tipe": "formula_block", "latex": "S_5 = \\dfrac{3(3^5 - 1)}{3 - 1} = \\dfrac{3(243 - 1)}{2} = \\dfrac{3 \\cdot 242}{2} = 3 \\cdot 121 = 363" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah 5 suku pertama deret geometri tersebut adalah **$363$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan $1, 3, 6, 10, 15, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus umum barisan bilangan segitiga**" },
        { "tipe": "formula_block", "latex": "U_n = \\dfrac{n(n + 1)}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 6$ untuk menghitung suku ke-6**" },
        { "tipe": "formula_block", "latex": "U_6 = \\dfrac{6(6 + 1)}{2} = \\dfrac{42}{2} = 21" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-6 barisan tersebut adalah **$21$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $\\dfrac{1}{1 \\cdot 2} + \\dfrac{1}{2 \\cdot 3} + \\dfrac{1}{3 \\cdot 4} + \\ldots + \\dfrac{1}{99 \\cdot 100}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{98}{100}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{99}{100}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{100}{101}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{101}{100}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan setiap suku menjadi pecahan parsial (bentuk teleskopik)**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{n(n + 1)} = \\dfrac{1}{n} - \\dfrac{1}{n + 1}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan penjumlahan suku-suku yang saling meniadakan**" },
        { "tipe": "formula_block", "latex": "\\left(1 - \\dfrac{1}{2}\\right) + \\left(\\dfrac{1}{2} - \\dfrac{1}{3}\\right) + \\ldots + \\left(\\dfrac{1}{99} - \\dfrac{1}{100}\\right) = 1 - \\dfrac{1}{100} = \\dfrac{99}{100}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$\\dfrac{99}{100}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret aritmatika memiliki $S_5 = 35$ dan $S_{10} = 120$. Suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun sistem persamaan linear dalam $a$ dan $b$ dari $S_5 = 35$ dan $S_{10} = 120$**" },
        { "tipe": "formula_block", "latex": "S_5 = \\dfrac{5}{2}(2a + 4b) = 35 \\Rightarrow 2a + 4b = 14 \\Rightarrow a + 2b = 7" },
        { "tipe": "formula_block", "latex": "S_{10} = \\dfrac{10}{2}(2a + 9b) = 120 \\Rightarrow 2a + 9b = 24" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi $a$ untuk mencari nilai $b$, lalu substitusikan untuk memperoleh $a$**" },
        { "tipe": "formula_block", "latex": "(2a + 9b) - 2(a + 2b) = 24 - 14 \\Rightarrow 5b = 10 \\Rightarrow b = 2" },
        { "tipe": "formula_block", "latex": "a + 2(2) = 7 \\Rightarrow a = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama deret aritmatika tersebut adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga $a + ar + ar^2 + \\ldots$ memiliki jumlah 12. Jika $a = 3$, maka $r$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $S_\\infty = 12$ dan $a = 3$ ke rumus jumlah deret geometri tak hingga**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\dfrac{a}{1 - r} \\Rightarrow 12 = \\dfrac{3}{1 - r} \\Rightarrow 1 - r = \\dfrac{3}{12} = \\dfrac{1}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai rasio ($r$)**" },
        { "tipe": "formula_block", "latex": "r = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rasio deret geometri tak hingga tersebut adalah **$\\dfrac{3}{4}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $3, 6, 11, 18, 27, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n^2 - n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis selisih bertingkat untuk menentukan bentuk rumus kuadrat suku ke-$n$**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $3, 5, 7, 9, \\ldots$ dengan beda tetap $2$, sehingga suku ke-$n$ memenuhi:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji rumus untuk beberapa suku awal barisan**" },
        { "tipe": "formula_block", "latex": "U_1 = 1^2 + 2 = 3, \\qquad U_2 = 2^2 + 2 = 6, \\qquad U_3 = 3^2 + 2 = 11" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = n^2 + 2$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
