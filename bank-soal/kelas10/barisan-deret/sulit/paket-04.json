{
  "id": "bs-k10-bd-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN tentang deret konvergen dan transformasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-20 barisan $1, 4, 9, 16, 25, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$360$" } ],
        [ { "tipe": "paragraph", "text": "$380$" } ],
        [ { "tipe": "paragraph", "text": "$400$" } ],
        [ { "tipe": "paragraph", "text": "$420$" } ],
        [ { "tipe": "paragraph", "text": "$440$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Perhatikan pola barisan bilangan: $1 = 1^2$, $4 = 2^2$, $9 = 3^2$, $16 = 4^2$, $25 = 5^2$ (merupakan barisan kuadrat bilangan asli)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus umum suku ke-$n$ ($U_n = n^2$) untuk mencari suku ke-20 ($U_{20}$):" },
        { "tipe": "paragraph", "text": "$U_{20} = 20^2 = 400$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-20 adalah $400$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri dengan $a = 6$ dan $S_\\infty = 9$ memiliki rasio..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus jumlah deret geometri tak hingga $S_\\infty = \\dfrac{a}{1 - r}$ dengan $a = 6$ dan $S_\\infty = 9$." },
        { "tipe": "paragraph", "text": "$9 = \\dfrac{6}{1 - r} \\Rightarrow 1 - r = \\dfrac{6}{9} = \\dfrac{2}{3}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Selesaikan persamaan untuk mencari rasio ($r$): $r = 1 - \\dfrac{2}{3} = \\dfrac{1}{3}$." },
        { "tipe": "paragraph", "text": "Jadi, rasio deret tersebut adalah $\\dfrac{1}{3}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Perhatikan pola barisan bilangan: $2 = 1 \\times 2$, $6 = 2 \\times 3$, $12 = 3 \\times 4$, $20 = 4 \\times 5$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan rumus suku ke-$n$ ($U_n$), yaitu $U_n = n(n+1)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Hitung suku ke-8 ($U_8$) dengan mensubstitusikan $n = 8$:" },
        { "tipe": "paragraph", "text": "$U_8 = 8(8 + 1) = 8 \\times 9 = 72$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-8 adalah $72$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $U_n = 3n^2 - 2n$, maka $U_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus suku ke-$n$ yang diberikan: $U_n = 3n^2 - 2n$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $n = 5$ ke dalam rumus:" },
        { "tipe": "paragraph", "text": "$U_5 = 3(5)^2 - 2(5) = 3(25) - 10 = 75 - 10 = 65$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $U_5$ adalah $65$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret geometri memiliki $U_1 = 3$ dan $U_5 = 243$. Jumlah 5 suku pertama adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$363$" } ],
        [ { "tipe": "paragraph", "text": "$369$" } ],
        [ { "tipe": "paragraph", "text": "$375$" } ],
        [ { "tipe": "paragraph", "text": "$381$" } ],
        [ { "tipe": "paragraph", "text": "$387$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus suku ke-$n$ barisan geometri $U_5 = a \\cdot r^4 = 243$ dengan $a = 3$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Cari nilai rasio ($r$): $3r^4 = 243 \\Rightarrow r^4 = \\dfrac{243}{3} = 81 \\Rightarrow r = 3$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan rumus jumlah 5 suku pertama deret geometri $S_n = \\dfrac{a(r^n - 1)}{r - 1}$:" },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{3(3^5 - 1)}{3 - 1} = \\dfrac{3(243 - 1)}{2} = \\dfrac{3 \\cdot 242}{2} = 3 \\cdot 121 = 363$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah 5 suku pertama adalah $363$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan $1, 3, 6, 10, 15, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kenali pola barisan bilangan segitiga: $1, 3, 6, 10, 15, \\ldots$ yang memiliki rumus umum $U_n = \\dfrac{n(n+1)}{2}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung suku ke-6 ($U_6$) dengan mensubstitusikan $n = 6$:" },
        { "tipe": "paragraph", "text": "$U_6 = \\dfrac{6(6 + 1)}{2} = \\dfrac{6 \\cdot 7}{2} = \\dfrac{42}{2} = 21$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-6 adalah $21$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $\\dfrac{1}{1 \\cdot 2} + \\dfrac{1}{2 \\cdot 3} + \\dfrac{1}{3 \\cdot 4} + \\ldots + \\dfrac{1}{99 \\cdot 100}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{98}{100}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{99}{100}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{100}{101}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{101}{100}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jabarkan setiap pecahan menggunakan sifat pecahan parsial (telescoping series): $\\dfrac{1}{n(n+1)} = \\dfrac{1}{n} - \\dfrac{1}{n+1}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tuliskan bentuk penjumlahannya:" },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{1} - \\dfrac{1}{2}\\right) + \\left(\\dfrac{1}{2} - \\dfrac{1}{3}\\right) + \\left(\\dfrac{1}{3} - \\dfrac{1}{4}\\right) + \\ldots + \\left(\\dfrac{1}{99} - \\dfrac{1}{100}\\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Sederhanakan suku-suku yang saling menghilangkan, menyisakan suku pertama dan suku terakhir:" },
        { "tipe": "paragraph", "text": "$1 - \\dfrac{1}{100} = \\dfrac{100}{100} - \\dfrac{1}{100} = \\dfrac{99}{100}$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tersebut adalah $\\dfrac{99}{100}$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret aritmatika memiliki $S_5 = 35$ dan $S_{10} = 120$. Suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus jumlah deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n-1)b)$ untuk $S_5$ dan $S_{10}$:" },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{5}{2}(2a + 4b) = 35 \\Rightarrow 2a + 4b = 14 \\Rightarrow a + 2b = 7$ (Persamaan 1)" },
        { "tipe": "paragraph", "text": "$S_{10} = \\dfrac{10}{2}(2a + 9b) = 120 \\Rightarrow 2a + 9b = 24$ (Persamaan 2)" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan Persamaan 1 dengan 2, lalu eliminasi dengan Persamaan 2:" },
        { "tipe": "paragraph", "text": "$2a + 4b = 14$" },
        { "tipe": "paragraph", "text": "$2a + 9b = 24$" },
        { "tipe": "paragraph", "text": "------------------------ (-)" },
        { "tipe": "paragraph", "text": "$-5b = -10 \\Rightarrow b = 2$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Substitusikan nilai $b = 2$ ke dalam Persamaan 1:" },
        { "tipe": "paragraph", "text": "$a + 2(2) = 7 \\Rightarrow a + 4 = 7 \\Rightarrow a = 3$." },
        { "tipe": "paragraph", "text": "Jadi, suku pertamanya adalah $3$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga $a + ar + ar^2 + \\ldots$ memiliki jumlah 12. Jika $a = 3$, maka $r$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus jumlah deret geometri tak hingga $S_\\infty = \\dfrac{a}{1 - r}$ dengan $S_\\infty = 12$ dan $a = 3$." },
        { "tipe": "paragraph", "text": "$12 = \\dfrac{3}{1 - r} \\Rightarrow 1 - r = \\dfrac{3}{12} = \\dfrac{1}{4}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Selesaikan persamaan untuk mencari rasio ($r$): $r = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}$." },
        { "tipe": "paragraph", "text": "Jadi, rasio deret tersebut adalah $\\dfrac{3}{4}$ (pilihan keempat)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $3, 6, 11, 18, 27, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + 2n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n^2 - n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 1$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Analisis barisan bilangan: $3, 6, 11, 18, 27, \\ldots$ Selisih antar-suku berturut-turut adalah $3, 5, 7, 9, \\ldots$ (membentuk barisan aritmatika dengan beda tetap $2$, yang menunjukkan barisan kuadrat)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Uji pilihan rumus suku ke-$n$ ($U_n = n^2 + 2$):" },
        { "tipe": "paragraph", "text": "- Untuk $n = 1$: $1^2 + 2 = 3$ (sesuai)" },
        { "tipe": "paragraph", "text": "- Untuk $n = 2$: $2^2 + 2 = 6$ (sesuai)" },
        { "tipe": "paragraph", "text": "- Untuk $n = 3$: $3^2 + 2 = 11$ (sesuai)" },
        { "tipe": "paragraph", "text": "Jadi, rumus suku ke-$n$ adalah $U_n = n^2 + 2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
