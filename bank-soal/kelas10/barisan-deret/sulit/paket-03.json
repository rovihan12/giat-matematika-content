{
  "id": "bs-k10-bd-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang barisan dan deret lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 barisan $2, 6, 12, 20, 30, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$130$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pola: $U_n = n(n+1)$." },
        { "tipe": "paragraph", "text": "$U_{10} = 10 \\cdot 11 = 110$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga $2 + \\dfrac{4}{3} + \\dfrac{8}{9} + \\ldots$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 2$, $r = \\dfrac{4/3}{2} = \\dfrac{2}{3}$" },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{2}{1 - 2/3} = \\dfrac{2}{1/3} = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $p, q, r$ membentuk barisan aritmatika dan $p + r = 10$, maka $q$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sifat aritmatika: $2q = p + r = 10 \\Rightarrow q = 5$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 barisan $\\sqrt{2}, 2, 2\\sqrt{2}, 4, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$16\\sqrt{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Barisan geometri: $a = \\sqrt{2}$, $r = \\dfrac{2}{\\sqrt{2}} = \\sqrt{2}$" },
        { "tipe": "paragraph", "text": "$U_5 = \\sqrt{2} \\cdot (\\sqrt{2})^4 = \\sqrt{2} \\cdot 4 = 4\\sqrt{2}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $1 + 3 + 9 + 27 + \\ldots + 2187$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3279$" } ],
        [ { "tipe": "paragraph", "text": "$3280$" } ],
        [ { "tipe": "paragraph", "text": "$3281$" } ],
        [ { "tipe": "paragraph", "text": "$3282$" } ],
        [ { "tipe": "paragraph", "text": "$3283$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2187 = 3^7$, jadi ada 8 suku ($3^0$ sampai $3^7$)." },
        { "tipe": "paragraph", "text": "$S_8 = \\dfrac{3^8 - 1}{3 - 1} = \\dfrac{6561 - 1}{2} = \\dfrac{6560}{2} = 3280$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah perusahaan memproduksi 100 unit pada bulan pertama, 120 pada bulan kedua, 140 pada bulan ketiga, dst. Total produksi pada tahun pertama adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2420$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2520$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2620$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2720$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2820$ unit" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 100$, $b = 20$, $n = 12$" },
        { "tipe": "paragraph", "text": "$S_{12} = \\dfrac{12}{2}(2 \\cdot 100 + 11 \\cdot 20) = 6(200 + 220) = 6 \\cdot 420 = 2520$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-20 barisan aritmatika dengan $U_5 = 15$ dan $U_{10} = 35$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$71$" } ],
        [ { "tipe": "paragraph", "text": "$73$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$77$" } ],
        [ { "tipe": "paragraph", "text": "$79$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$b = \\dfrac{35 - 15}{5} = 4$" },
        { "tipe": "paragraph", "text": "$a = 15 - 4 \\cdot 4 = -1$" },
        { "tipe": "paragraph", "text": "$U_{20} = -1 + 19 \\cdot 4 = -1 + 76 = 75$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{x}, \\dfrac{1}{y}, \\dfrac{1}{z}$ barisan aritmatika, maka..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x, y, z$ barisan aritmatika" } ],
        [ { "tipe": "paragraph", "text": "$x, y, z$ barisan geometri" } ],
        [ { "tipe": "paragraph", "text": "$y = \\dfrac{2xz}{x+z}$" } ],
        [ { "tipe": "paragraph", "text": "$y = \\dfrac{x+z}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$y^2 = xz$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{1}{x}, \\dfrac{1}{y}, \\dfrac{1}{z}$ aritmatika → $\\dfrac{2}{y} = \\dfrac{1}{x} + \\dfrac{1}{z} = \\dfrac{x+z}{xz}$" },
        { "tipe": "paragraph", "text": "$y = \\dfrac{2xz}{x+z}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret $\\sum_{n=1}^{\\infty} \\dfrac{1}{n(n+1)}$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Telescoping: $\\dfrac{1}{n(n+1)} = \\dfrac{1}{n} - \\dfrac{1}{n+1}$" },
        { "tipe": "paragraph", "text": "Jumlah parsial $S_N = 1 - \\dfrac{1}{N+1}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga suku berurutan barisan geometri berjumlah 21 dan hasil kalinya 216. Suku tengahnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal: $\\dfrac{a}{r}, a, ar$." },
        { "tipe": "paragraph", "text": "Hasil kali = $\\dfrac{a}{r} \\cdot a \\cdot ar = a^3 = 216 \\Rightarrow a = 6$" },
        { "tipe": "paragraph", "text": "Suku tengah = $6$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
