{
  "id": "bs-k10-bd-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang barisan dan deret lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 barisan $2, 6, 12, 20, 30, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$130$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi pola perkalian berurutan untuk menentukan rumus suku ke-$n$**" },
        { "tipe": "formula_block", "latex": "U_1 = 1 \\times 2, \\quad U_2 = 2 \\times 3, \\quad U_3 = 3 \\times 4, \\quad \\ldots \\Rightarrow U_n = n(n + 1)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 10$ untuk menghitung suku ke-10**" },
        { "tipe": "formula_block", "latex": "U_{10} = 10(10 + 1) = 10 \\times 11 = 110" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-10 barisan tersebut adalah **$110$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga $2 + \\dfrac{4}{3} + \\dfrac{8}{9} + \\ldots$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan rasio ($r$) deret geometri**" },
        { "tipe": "formula_block", "latex": "a = 2, \\qquad r = \\dfrac{\\dfrac{4}{3}}{2} = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah tak hingga menggunakan rumus $S_\\infty = \\dfrac{a}{1 - r}$**" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\dfrac{2}{1 - \\dfrac{2}{3}} = \\dfrac{2}{\\dfrac{1}{3}} = 2 \\times 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret geometri tak hingga tersebut adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $p, q, r$ membentuk barisan aritmatika dan $p + r = 10$, maka $q$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat suku tengah barisan aritmatika ($2q = p + r$)**" },
        { "tipe": "formula_block", "latex": "2q = p + r" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $p + r = 10$ dan selesaikan untuk $q$**" },
        { "tipe": "formula_block", "latex": "2q = 10 \\Rightarrow q = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $q$ adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 barisan $\\sqrt{2}, 2, 2\\sqrt{2}, 4, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$8\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$16\\sqrt{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama ($a$) dan rasio ($r$) barisan geometri**" },
        { "tipe": "formula_block", "latex": "a = \\sqrt{2}, \\qquad r = \\dfrac{2}{\\sqrt{2}} = \\sqrt{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku ke-5 menggunakan rumus $U_n = a \\cdot r^{n - 1}$**" },
        { "tipe": "formula_block", "latex": "U_5 = \\sqrt{2} \\cdot (\\sqrt{2})^{5 - 1} = \\sqrt{2} \\cdot (\\sqrt{2})^4 = \\sqrt{2} \\cdot 4 = 4\\sqrt{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 barisan tersebut adalah **$4\\sqrt{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $1 + 3 + 9 + 27 + \\ldots + 2187$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3279$" } ],
        [ { "tipe": "paragraph", "text": "$3280$" } ],
        [ { "tipe": "paragraph", "text": "$3281$" } ],
        [ { "tipe": "paragraph", "text": "$3282$" } ],
        [ { "tipe": "paragraph", "text": "$3283$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$), rasio ($r$), dan banyak suku ($n$)**" },
        { "tipe": "formula_block", "latex": "a = 1, \\qquad r = 3, \\qquad U_n = 2187 = 3^7 \\Rightarrow n = 8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah deret geometri menggunakan rumus $S_n = \\dfrac{a(r^n - 1)}{r - 1}$**" },
        { "tipe": "formula_block", "latex": "S_8 = \\dfrac{1(3^8 - 1)}{3 - 1} = \\dfrac{6561 - 1}{2} = \\dfrac{6560}{2} = 3280" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$3280$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah perusahaan memproduksi 100 unit pada bulan pertama, 120 pada bulan kedua, 140 pada bulan ketiga, dst. Total produksi pada tahun pertama adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2420$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2520$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2620$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2720$ unit" } ],
        [ { "tipe": "paragraph", "text": "$2820$ unit" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi unsur barisan aritmatika untuk 1 tahun (12 bulan)**" },
        { "tipe": "formula_block", "latex": "a = 100, \\qquad b = 20, \\qquad n = 12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung total produksi menggunakan rumus $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$**" },
        { "tipe": "formula_block", "latex": "S_{12} = \\dfrac{12}{2}\\big(2(100) + (12 - 1) \\cdot 20\\big) = 6(200 + 220) = 6 \\cdot 420 = 2520" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, total produksi pada tahun pertama adalah **$2520$ unit**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-20 barisan aritmatika dengan $U_5 = 15$ dan $U_{10} = 35$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$71$" } ],
        [ { "tipe": "paragraph", "text": "$73$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$77$" } ],
        [ { "tipe": "paragraph", "text": "$79$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan beda ($b$) dan suku pertama ($a$) barisan aritmatika**" },
        { "tipe": "formula_block", "latex": "b = \\dfrac{U_{10} - U_5}{10 - 5} = \\dfrac{35 - 15}{5} = 4" },
        { "tipe": "formula_block", "latex": "U_5 = a + 4b = 15 \\Rightarrow a + 4(4) = 15 \\Rightarrow a = -1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku ke-20 menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "U_{20} = -1 + (20 - 1) \\cdot 4 = -1 + 76 = 75" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-20 barisan aritmatika tersebut adalah **$75$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{x}, \\dfrac{1}{y}, \\dfrac{1}{z}$ barisan aritmatika, maka..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x, y, z$ barisan aritmatika" } ],
        [ { "tipe": "paragraph", "text": "$x, y, z$ barisan geometri" } ],
        [ { "tipe": "paragraph", "text": "$y = \\dfrac{2xz}{x+z}$" } ],
        [ { "tipe": "paragraph", "text": "$y = \\dfrac{x+z}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$y^2 = xz$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan sifat barisan aritmatika pada tiga suku berurutan**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{y} = \\dfrac{1}{x} + \\dfrac{1}{z}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Samakan penyebut dan selesaikan persamaan untuk $y$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{y} = \\dfrac{x + z}{xz} \\Rightarrow y(x + z) = 2xz \\Rightarrow y = \\dfrac{2xz}{x + z}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hubungan yang benar adalah **$y = \\dfrac{2xz}{x + z}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret $\\sum_{n=1}^{\\infty} \\dfrac{1}{n(n+1)}$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan suku umum deret menjadi pecahan parsial (bentuk teleskopik)**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{n(n + 1)} = \\dfrac{1}{n} - \\dfrac{1}{n + 1}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Susun jumlah parsial ke-$N$ dan ambil limit saat $N$ menuju tak hingga**" },
        { "tipe": "formula_block", "latex": "S_N = \\left(1 - \\dfrac{1}{2}\\right) + \\left(\\dfrac{1}{2} - \\dfrac{1}{3}\\right) + \\ldots + \\left(\\dfrac{1}{N} - \\dfrac{1}{N + 1}\\right) = 1 - \\dfrac{1}{N + 1}" },
        { "tipe": "formula_block", "latex": "S_\\infty = \\lim_{N \\to \\infty} \\left(1 - \\dfrac{1}{N + 1}\\right) = 1 - 0 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga suku berurutan barisan geometri berjumlah 21 dan hasil kalinya 216. Suku tengahnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan tiga suku berurutan barisan geometri dengan suku tengah $a$ dan rasio $r$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{a}{r}, \\quad a, \\quad ar" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan persamaan hasil kali ketiga suku untuk mencari nilai $a$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{a}{r} \\cdot a \\cdot ar = 216 \\Rightarrow a^3 = 216 \\Rightarrow a = \\sqrt[3]{216} = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku tengah barisan geometri tersebut adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
