{
  "id": "bs-k10-bd-sulit-07",
  "nama": "Bank Soal Sulit - Paket 7",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang barisan bertingkat, rekursif, dan deret lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-15 dari barisan bertingkat $5, 8, 13, 20, 29, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$224$" } ],
        [ { "tipe": "paragraph", "text": "$229$" } ],
        [ { "tipe": "paragraph", "text": "$234$" } ],
        [ { "tipe": "paragraph", "text": "$239$" } ],
        [ { "tipe": "paragraph", "text": "$244$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Analisis selisih antar-suku bertingkat: $3, 5, 7, 9, \\ldots$ (aritmatika dengan beda tetap $2$). Pola ini menunjukkan rumus umum suku ke-$n$ berbentuk kuadrat, yaitu $U_n = n^2 + 4$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung suku ke-15 ($U_{15}$) dengan mensubstitusikan $n = 15$:" },
        { "tipe": "paragraph", "text": "$U_{15} = 15^2 + 4 = 225 + 4 = 229$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-15 adalah $229$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $y_1, y_2, y_3, \\ldots$ didefinisikan dengan $y_1 = 1$, $y_2 = 4$, dan $y_n = 2y_{n-1} - y_{n-2} + 2$ untuk $n \\ge 3$. Nilai $y_6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$41$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus rekurensi secara bertahap mulai dari $n = 3$ hingga $n = 6$:" },
        { "tipe": "paragraph", "text": "$y_3 = 2(4) - 1 + 2 = 9$." },
        { "tipe": "paragraph", "text": "$y_4 = 2(9) - 4 + 2 = 16$." },
        { "tipe": "paragraph", "text": "$y_5 = 2(16) - 9 + 2 = 25$." },
        { "tipe": "paragraph", "text": "$y_6 = 2(25) - 16 + 2 = 36$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Pola umum barisan tersebut adalah $y_n = n^2$, sehingga untuk $n = 6$ diperoleh $y_6 = 6^2 = 36$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{2 \\cdot 4} + \\dfrac{1}{4 \\cdot 6} + \\dfrac{1}{6 \\cdot 8} + \\ldots + \\dfrac{1}{20 \\cdot 22}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{22}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{11}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{11}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Ubah bentuk umum suku ke-$k$ menggunakan pecahan parsial: $\\dfrac{1}{(2k)(2k+2)} = \\dfrac{1}{2}\\left(\\dfrac{1}{2k} - \\dfrac{1}{2k+2}\\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Jabarkan bentuk telescoping tanpa tanda kurung bertumpuk agar tidak terpotong:" },
        { "tipe": "paragraph", "text": "$S = \\dfrac{1}{2} \\left( \\dfrac{1}{2} - \\dfrac{1}{4} + \\dfrac{1}{4} - \\dfrac{1}{6} + \\dots - \\dfrac{1}{22} \\right)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Suku-suku di tengah saling menghilangkan, menyisakan suku pertama dan terakhir:" },
        { "tipe": "paragraph", "text": "$S = \\dfrac{1}{2}\\left(\\dfrac{1}{2} - \\dfrac{1}{22}\\right) = \\dfrac{1}{2} \\cdot \\dfrac{10}{22} = \\dfrac{5}{22}$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tersebut adalah $\\dfrac{5}{22}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan geometri. Jika hasil kalinya $512$ dan jumlahnya $28$, maka bilangan terbesarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Misalkan tiga bilangan geometri tersebut adalah $\\dfrac{a}{r}, a, ar$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan informasi hasil kali $= a^3 = 512 \\Rightarrow a = 8$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Gunakan informasi jumlah:" },
        { "tipe": "paragraph", "text": "$\\dfrac{8}{r} + 8 + 8r = 28 \\Rightarrow \\dfrac{8}{r} + 8r = 20$." },
        { "tipe": "paragraph", "text": "Kalikan $r$ dan sederhanakan menjadi: $8r^2 - 20r + 8 = 0 \\Rightarrow 2r^2 - 5r + 2 = 0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan persamaan: $(2r-1)(r-2) = 0 \\Rightarrow r = 2$ atau $r = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 5:</strong> Jika $a = 8$ dan $r = 2$, maka bilangan tersebut adalah $4, 8, 16$, sehingga bilangan terbesarnya adalah $16$ (pilihan ketiga)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = n^3 + 2n^2 - n$. Suku ke-5 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$74$" } ],
        [ { "tipe": "paragraph", "text": "$78$" } ],
        [ { "tipe": "paragraph", "text": "$82$" } ],
        [ { "tipe": "paragraph", "text": "$86$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan hubungan antara jumlah suku dan suku ke-$n$ ($U_n = S_n - S_{n-1}$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung $S_5$ dan $S_4$:" },
        { "tipe": "paragraph", "text": "$S_5 = 5^3 + 2(5)^2 - 5 = 125 + 50 - 5 = 170$." },
        { "tipe": "paragraph", "text": "$S_4 = 4^3 + 2(4)^2 - 4 = 64 + 32 - 4 = 92$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Tentukan suku ke-5 ($U_5$):" },
        { "tipe": "paragraph", "text": "$U_5 = S_5 - S_4 = 170 - 92 = 78$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-5 adalah $78$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{2}{3} + \\dfrac{4}{9} + \\dfrac{6}{27} + \\dfrac{8}{81} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Identifikasi bentuk AGP: $S = \\sum_{n=1}^{\\infty} \\dfrac{2n}{3^n} = 2 \\sum_{n=1}^{\\infty} \\dfrac{n}{3^n}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus deret $\\sum_{n=1}^{\\infty} n r^n = \\dfrac{r}{(1-r)^2}$ dengan $r = \\dfrac{1}{3}$:" },
        { "tipe": "paragraph", "text": "$\\sum_{n=1}^{\\infty} n \\left(\\dfrac{1}{3}\\right)^n = \\dfrac{\\dfrac{1}{3}}{\\left(1 - \\dfrac{1}{3}\\right)^2} = \\dfrac{\\dfrac{1}{3}}{\\dfrac{4}{9}} = \\dfrac{3}{4}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Hitung nilai total $S = 2 \\cdot \\dfrac{3}{4} = \\dfrac{3}{2}$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tersebut adalah $\\dfrac{3}{2}$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 2, \\log(2^x + 2), \\log(2^x + 14)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan sifat tengah barisan aritmatika: $2\\log(2^x + 2) = \\log 2 + \\log(2^x + 14)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Sederhanakan menjadi: $(2^x + 2)^2 = 2(2^x + 14)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Misalkan $t = 2^x$, sehingga diperoleh: $t^2 + 4t + 4 = 2t + 28 \\Rightarrow t^2 + 2t - 24 = 0$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 4:</strong> Faktorkan: $(t + 6)(t - 4) = 0 \\Rightarrow t = 4$ (karena $t = 2^x > 0$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 5:</strong> Selesaikan $2^x = 4 \\Rightarrow x = 2$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $x$ adalah $2$ (pilihan pertama)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri $3 + 9 + 27 + \\ldots$ adalah $3279$. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan $a = 3$ dan $r = 3$ dari deret tersebut." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret geometri:" },
        { "tipe": "paragraph", "text": "$S_n = \\dfrac{3(3^n - 1)}{3 - 1} = \\dfrac{3(3^n - 1)}{2} = 3279$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 3:</strong> Selesaikan persamaan eksponensial:" },
        { "tipe": "paragraph", "text": "$3^n - 1 = 3279 \\cdot \\dfrac{2}{3} = 2186 \\Rightarrow 3^n = 2187 = 3^7 \\Rightarrow n = 7$." },
        { "tipe": "paragraph", "text": "Jadi, nilai $n$ adalah $7$ (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dijatuhkan dari ketinggian $12$ m. Setiap pantulan mencapai $\\dfrac{1}{4}$ dari ketinggian sebelumnya. Total lintasan bola sampai berhenti adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$ m" } ],
        [ { "tipe": "paragraph", "text": "$20$ m" } ],
        [ { "tipe": "paragraph", "text": "$22$ m" } ],
        [ { "tipe": "paragraph", "text": "$24$ m" } ],
        [ { "tipe": "paragraph", "text": "$26$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus total lintasan bola jatuh dan memantul: $\\text{Total} = h + 2 \\cdot \\dfrac{ar}{1 - r}$ dengan $h = 12$ dan $r = \\dfrac{1}{4}$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai-nilai tersebut:" },
        { "tipe": "paragraph", "text": "$\\text{Total} = 12 + 2 \\cdot \\dfrac{12 \\cdot \\dfrac{1}{4}}{1 - \\dfrac{1}{4}}$" },
        { "tipe": "paragraph", "text": "$= 12 + 2 \\cdot \\dfrac{3}{\\dfrac{3}{4}} = 12 + 2(4) = 20$ m." },
        { "tipe": "paragraph", "text": "Jadi, total lintasan bola sampai berhenti adalah $20$ m (pilihan kedua)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 \\cdot 3 + 2 \\cdot 4 + 3 \\cdot 5 + \\ldots + 15 \\cdot 17$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1360$" } ],
        [ { "tipe": "paragraph", "text": "$1400$" } ],
        [ { "tipe": "paragraph", "text": "$1440$" } ],
        [ { "tipe": "paragraph", "text": "$1480$" } ],
        [ { "tipe": "paragraph", "text": "$1520$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Nyatakan suku ke-$k$ dalam notasi sigma: $\\sum_{k=1}^{15} k(k+2) = \\sum_{k=1}^{15} (k^2 + 2k)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret kuadrat dan linier untuk $n = 15$:" },
        { "tipe": "paragraph", "text": "$\\dfrac{15 \\cdot 16 \\cdot 31}{6} + 15 \\cdot 16$" },
        { "tipe": "paragraph", "text": "$= 1240 + 240 = 1480$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tersebut adalah $1480$ (pilihan keempat)." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
