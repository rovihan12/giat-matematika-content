{
  "id": "bs-k10-bd-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang barisan bertingkat, rekursif, dan deret lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-sulit-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-14 dari barisan bertingkat $7, 10, 15, 22, 31, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$196$" } ],
        [ { "tipe": "paragraph", "text": "$198$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ],
        [ { "tipe": "paragraph", "text": "$202$" } ],
        [ { "tipe": "paragraph", "text": "$204$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Analisis selisih bertingkat untuk menentukan rumus umum suku ke-$n$**" },
        { "tipe": "paragraph", "text": "Selisih tingkat pertama adalah $3, 5, 7, 9, \\ldots$ dengan beda tetap $2$, sehingga suku ke-$n$ berbentuk:" },
        { "tipe": "formula_block", "latex": "U_n = n^2 + 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 14$ untuk menghitung suku ke-14**" },
        { "tipe": "formula_block", "latex": "U_{14} = 14^2 + 6 = 196 + 6 = 202" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-14 dari barisan tersebut adalah **$202$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $w_1, w_2, w_3, \\ldots$ didefinisikan dengan $w_1 = 2$, $w_2 = 6$, dan $w_n = 4w_{n-1} - 3w_{n-2}$ untuk $n \\ge 3$. Nilai $w_5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$150$" } ],
        [ { "tipe": "paragraph", "text": "$156$" } ],
        [ { "tipe": "paragraph", "text": "$162$" } ],
        [ { "tipe": "paragraph", "text": "$168$" } ],
        [ { "tipe": "paragraph", "text": "$174$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan rumus rekurensi $w_n = 4w_{n - 1} - 3w_{n - 2}$ untuk mencari $w_3$ dan $w_4$**" },
        { "tipe": "formula_block", "latex": "w_3 = 4w_2 - 3w_1 = 4(6) - 3(2) = 24 - 6 = 18" },
        { "tipe": "formula_block", "latex": "w_4 = 4w_3 - 3w_2 = 4(18) - 3(6) = 72 - 18 = 54" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $w_5$ dari $w_4$ dan $w_3$**" },
        { "tipe": "formula_block", "latex": "w_5 = 4w_4 - 3w_3 = 4(54) - 3(18) = 216 - 54 = 162" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $w_5$ adalah **$162$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{4 \\cdot 6} + \\dfrac{1}{6 \\cdot 8} + \\dfrac{1}{8 \\cdot 10} + \\ldots + \\dfrac{1}{24 \\cdot 26}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{104}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{52}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{26}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{13}{52}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan suku umum deret menjadi pecahan parsial teleskopik**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{(2k + 2)(2k + 4)} = \\dfrac{1}{2}\\left(\\dfrac{1}{2k + 2} - \\dfrac{1}{2k + 4}\\right)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan dari $k = 1$ hingga $k = 11$ dan sederhanakan suku-suku tengahnya**" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2}\\left(\\dfrac{1}{4} - \\dfrac{1}{6} + \\dfrac{1}{6} - \\dfrac{1}{8} + \\ldots + \\dfrac{1}{24} - \\dfrac{1}{26}\\right) = \\dfrac{1}{2}\\left(\\dfrac{1}{4} - \\dfrac{1}{26}\\right)" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{1}{2} \\cdot \\dfrac{22}{104} = \\dfrac{11}{104}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$\\dfrac{11}{104}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan geometri. Jika hasil kalinya $1000$ dan jumlahnya $35$, maka bilangan terbesarnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan tiga bilangan geometri adalah $\\dfrac{a}{r}, a, ar$ dan cari $a$ dari hasil kalinya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{a}{r} \\cdot a \\cdot ar = 1000 \\Rightarrow a^3 = 1000 \\Rightarrow a = 10" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan jumlah ketiga bilangan ($35$) untuk menentukan rasio ($r$)**" },
        { "tipe": "formula_block", "latex": "\\dfrac{10}{r} + 10 + 10r = 35 \\Rightarrow \\dfrac{10}{r} + 10r = 25 \\Rightarrow 10r^2 - 25r + 10 = 0 \\Rightarrow 2r^2 - 5r + 2 = 0" },
        { "tipe": "formula_block", "latex": "(2r - 1)(r - 2) = 0 \\Rightarrow r = 2 \\quad \\text{atau} \\quad r = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan ketiga bilangan dan ambil nilai terbesarnya**" },
        { "tipe": "formula_block", "latex": "\\text{Barisan bilangan: } 5, 10, 20 \\Rightarrow \\text{bilangan terbesar} = 20" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bilangan terbesarnya adalah **$20$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = 2n^3 + n^2 - 3n$. Suku ke-5 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$128$" } ],
        [ { "tipe": "paragraph", "text": "$132$" } ],
        [ { "tipe": "paragraph", "text": "$136$" } ],
        [ { "tipe": "paragraph", "text": "$140$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan hubungan $U_n = S_n - S_{n - 1}$ untuk $n = 5$**" },
        { "tipe": "formula_block", "latex": "U_5 = S_5 - S_4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $S_5$ dan $S_4$**" },
        { "tipe": "formula_block", "latex": "S_5 = 2(5)^3 + (5)^2 - 3(5) = 250 + 25 - 15 = 260" },
        { "tipe": "formula_block", "latex": "S_4 = 2(4)^3 + (4)^2 - 3(4) = 128 + 16 - 12 = 132" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kurangkan $S_5$ dengan $S_4$ untuk memperoleh $U_5$**" },
        { "tipe": "formula_block", "latex": "U_5 = 260 - 132 = 128" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 deret tersebut adalah **$128$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $\\dfrac{1}{5} + \\dfrac{4}{25} + \\dfrac{9}{125} + \\dfrac{16}{625} + \\ldots$ sampai tak hingga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{16}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{15}{32}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{64}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{128}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{45}{256}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan deret dalam notasi sigma dengan $r = \\dfrac{1}{5}$**" },
        { "tipe": "formula_block", "latex": "S = \\sum_{n=1}^{\\infty} \\dfrac{n^2}{5^n} = \\sum_{n=1}^{\\infty} n^2 \\left(\\dfrac{1}{5}\\right)^n" },
        { "tipe": "paragraph", "text": "**Langkah 2: Gunakan rumus $\\sum_{n=1}^{\\infty} n^2 r^n = \\dfrac{r(1 + r)}{(1 - r)^3}$ dan hitung hasilnya**" },
        { "tipe": "formula_block", "latex": "S = \\dfrac{\\dfrac{1}{5}\\left(1 + \\dfrac{1}{5}\\right)}{\\left(1 - \\dfrac{1}{5}\\right)^3} = \\dfrac{\\dfrac{6}{25}}{\\dfrac{64}{125}} = \\dfrac{6}{25} \\cdot \\dfrac{125}{64} = \\dfrac{30}{64} = \\dfrac{15}{32}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tak hingga tersebut adalah **$\\dfrac{15}{32}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\log 4, \\log(4^x - 4), \\log(4^x + 20)$ membentuk barisan aritmatika, maka $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan sifat barisan aritmatika pada tiga suku logaritma**" },
        { "tipe": "formula_block", "latex": "2 \\log(4^x - 4) = \\log 4 + \\log(4^x + 20) \\Rightarrow (4^x - 4)^2 = 4(4^x + 20)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Misalkan $t = 4^x$ dan selesaikan persamaan kuadratnya**" },
        { "tipe": "formula_block", "latex": "(t - 4)^2 = 4(t + 20) \\Rightarrow t^2 - 8t + 16 = 4t + 80 \\Rightarrow t^2 - 12t - 64 = 0" },
        { "tipe": "formula_block", "latex": "(t - 16)(t + 4) = 0 \\Rightarrow t = 16 \\quad (\\text{karena } t = 4^x > 0)" },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke variabel $x$ untuk memperoleh penyelesaiannya**" },
        { "tipe": "formula_block", "latex": "4^x = 16 = 4^2 \\Rightarrow x = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri $5 + 15 + 45 + \\ldots$ adalah $16400$. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi $a = 5$ dan $r = 3$, lalu susun persamaan dari $S_n = 16400$**" },
        { "tipe": "formula_block", "latex": "S_n = \\dfrac{5(3^n - 1)}{3 - 1} = 16400 \\Rightarrow \\dfrac{5(3^n - 1)}{2} = 16400" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan eksponensial untuk mencari nilai $n$**" },
        { "tipe": "formula_block", "latex": "3^n - 1 = 16400 \\cdot \\dfrac{2}{5} = 6560 \\Rightarrow 3^n = 6561 = 3^8 \\Rightarrow n = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $n$ adalah **$8$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dijatuhkan dari ketinggian $18$ m. Setiap pantulan mencapai $\\dfrac{1}{3}$ dari ketinggian sebelumnya. Total lintasan bola sampai berhenti adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$ m" } ],
        [ { "tipe": "paragraph", "text": "$36$ m" } ],
        [ { "tipe": "paragraph", "text": "$42$ m" } ],
        [ { "tipe": "paragraph", "text": "$48$ m" } ],
        [ { "tipe": "paragraph", "text": "$54$ m" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus total lintasan bola jatuh dan memantul tak hingga**" },
        { "tipe": "formula_block", "latex": "\\text{Total Lintasan} = h + 2 \\cdot \\dfrac{ar}{1 - r}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $h = 18$, $a = 18$, dan $r = \\dfrac{1}{3}$ lalu hitung nilainya**" },
        { "tipe": "formula_block", "latex": "\\text{Total Lintasan} = 18 + 2 \\cdot \\dfrac{18 \\cdot \\dfrac{1}{3}}{1 - \\dfrac{1}{3}} = 18 + 2 \\cdot \\dfrac{6}{\\dfrac{2}{3}} = 18 + 2(9) = 36" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, total lintasan bola sampai berhenti adalah **$36$ m**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-bd-sulit-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret $1 \\cdot 2 \\cdot 3 + 2 \\cdot 3 \\cdot 4 + 3 \\cdot 4 \\cdot 5 + \\ldots + 10 \\cdot 11 \\cdot 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3960$" } ],
        [ { "tipe": "paragraph", "text": "$4290$" } ],
        [ { "tipe": "paragraph", "text": "$4620$" } ],
        [ { "tipe": "paragraph", "text": "$4950$" } ],
        [ { "tipe": "paragraph", "text": "$5280$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jumlah perkalian tiga bilangan asli berurutan**" },
        { "tipe": "formula_block", "latex": "\\sum_{k=1}^{n} k(k + 1)(k + 2) = \\dfrac{n(n + 1)(n + 2)(n + 3)}{4}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $n = 10$ dan hitung hasilnya**" },
        { "tipe": "formula_block", "latex": "\\dfrac{10 \\cdot 11 \\cdot 12 \\cdot 13}{4} = 10 \\cdot 11 \\cdot 3 \\cdot 13 = 4290" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tersebut adalah **$4290$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
