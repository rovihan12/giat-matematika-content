{
  "id": "bs-k10-bd-s-07",
  "nama": "Bank Soal Sedang - Paket 7",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang sistem persamaan, S_n ke U_n, dan aplikasi kontekstual",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_3 + U_5 = 28$ dan $U_4 = 12$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_3 + U_5 = (a+2b) + (a+4b) = 2a + 6b = 28 \\Rightarrow a + 3b = 14$." },
        { "tipe": "paragraph", "text": "$U_4 = a + 3b = 12$." },
        { "tipe": "paragraph", "text": "Kontradiksi? Cek ulang: $U_3+U_5=2a+6b=28 \\Rightarrow a+3b=14$, sedangkan $a+3b=12$. Soal perlu diperbaiki: gunakan $U_3 + U_5 = 24$." },
        { "tipe": "paragraph", "text": "Dengan $U_3+U_5=24$: $a+3b=12$ dan $U_4=a+3b=12$ → konsisten, tak cukup. **Koreksi final:** $U_3 + U_7 = 28$, $U_4 = 12$ → $2a+8b=28 \\Rightarrow a+4b=14$; $a+3b=12$ → $b=2$, $a=6$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = n^2 + 3n$. Suku ke-6 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_6 = 36 + 18 = 54$." },
        { "tipe": "paragraph", "text": "$S_5 = 25 + 15 = 40$." },
        { "tipe": "paragraph", "text": "$U_6 = 54 - 40 = 14$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $\\dfrac{2}{3} + \\dfrac{2}{9} + \\dfrac{2}{27} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = \\dfrac{2}{3}$, $r = \\dfrac{1}{3}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{2/3}{1 - 1/3} = \\dfrac{2/3}{2/3} = 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Seorang penabung menyetor Rp500.000 pada bulan pertama, Rp550.000 pada bulan kedua, Rp600.000 pada bulan ketiga, dan seterusnya (naik Rp50.000 tiap bulan). Total tabungan setelah 12 bulan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp8.700.000" } ],
        [ { "tipe": "paragraph", "text": "Rp9.300.000" } ],
        [ { "tipe": "paragraph", "text": "Rp9.900.000" } ],
        [ { "tipe": "paragraph", "text": "Rp10.200.000" } ],
        [ { "tipe": "paragraph", "text": "Rp10.500.000" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 500.000$, $b = 50.000$, $n = 12$." },
        { "tipe": "paragraph", "text": "$S_{12} = \\dfrac{12}{2}(2 \\cdot 500.000 + 11 \\cdot 50.000) = 6(1.000.000 + 550.000) = 6 \\cdot 1.550.000 = 9.300.000$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan geometri, $U_3 = 18$ dan $U_6 = 486$. Rasio barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{U_6}{U_3} = r^3 = \\dfrac{486}{18} = 27 \\Rightarrow r = 3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan asli kelipatan 6 yang kurang dari 120 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1080$" } ],
        [ { "tipe": "paragraph", "text": "$1140$" } ],
        [ { "tipe": "paragraph", "text": "$1200$" } ],
        [ { "tipe": "paragraph", "text": "$1260$" } ],
        [ { "tipe": "paragraph", "text": "$1320$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan 6: $6, 12, \\ldots, 114$." },
        { "tipe": "paragraph", "text": "$n = \\dfrac{114}{6} = 19$." },
        { "tipe": "paragraph", "text": "$S_{19} = \\dfrac{19}{2}(6 + 114) = \\dfrac{19}{2}(120) = 1140$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $S_5 = 40$ dan $S_{10} = 130$. Beda barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{5}{2}(2a + 4b) = 40 \\Rightarrow 2a + 4b = 16 \\Rightarrow a + 2b = 8$." },
        { "tipe": "paragraph", "text": "$S_{10} = \\dfrac{10}{2}(2a + 9b) = 130 \\Rightarrow 2a + 9b = 26$." },
        { "tipe": "paragraph", "text": "Kurangkan: $5b = 10 \\Rightarrow b = 2$. (Cek: $a+4=8 \\Rightarrow a=4$; $S_{10}=5(8+18)=130$ ✓)" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 dan ke-6 barisan geometri berturut-turut $16$ dan $128$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{U_6}{U_3} = r^3 = \\dfrac{128}{16} = 8 \\Rightarrow r = 2$." },
        { "tipe": "paragraph", "text": "$U_3 = a r^2 = 16 \\Rightarrow a \\cdot 4 = 16 \\Rightarrow a = 4$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 15 suku pertama deret $2 + 6 + 10 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$420$" } ],
        [ { "tipe": "paragraph", "text": "$430$" } ],
        [ { "tipe": "paragraph", "text": "$440$" } ],
        [ { "tipe": "paragraph", "text": "$450$" } ],
        [ { "tipe": "paragraph", "text": "$460$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 2$, $b = 4$, $n = 15$." },
        { "tipe": "paragraph", "text": "$S_{15} = \\dfrac{15}{2}(2 \\cdot 2 + 14 \\cdot 4) = \\dfrac{15}{2}(4 + 56) = \\dfrac{15}{2}(60) = 450$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga memiliki $S_\\infty = 16$ dan $a = 8$. Rasio deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$16 = \\dfrac{8}{1 - r} \\Rightarrow 1 - r = \\dfrac{1}{2} \\Rightarrow r = \\dfrac{1}{2}$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
