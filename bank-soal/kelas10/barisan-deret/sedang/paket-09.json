{
  "id": "bs-k10-bd-s-09",
  "nama": "Bank Soal Sedang - Paket 9",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang suku tengah, sistem persamaan, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah dari barisan aritmatika dengan $U_1 = 9$ dan $U_{15} = 65$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$39$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama dan suku terakhir**" },
        { "tipe": "paragraph", "text": "Diketahui $U_1 = 9$ dan $U_{15} = 65$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku tengah dengan rumus $U_t = \\dfrac{U_1 + U_n}{2}$**" },
        { "tipe": "formula_block", "latex": "U_t = \\dfrac{9 + 65}{2} = \\dfrac{74}{2} = 37" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku tengah barisan aritmatika tersebut adalah **$37$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Di antara bilangan $4$ dan $40$ disisipkan 5 bilangan sehingga membentuk barisan aritmatika. Beda barisan baru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi nilai awal, nilai akhir, dan banyak sisipan**" },
        { "tipe": "paragraph", "text": "Diketahui $x = 4$, $y = 40$, dan banyak bilangan yang disisipkan $k = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung beda barisan baru dengan rumus $b' = \\dfrac{y - x}{k + 1}$**" },
        { "tipe": "formula_block", "latex": "b' = \\dfrac{40 - 4}{5 + 1} = \\dfrac{36}{6} = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, beda barisan baru tersebut adalah **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_3 = 15$ dan $U_8 = 40$. Suku ke-14 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$66$" } ],
        [ { "tipe": "paragraph", "text": "$68$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan beda ($b$) dari selisih $U_8$ dan $U_3$**" },
        { "tipe": "formula_block", "latex": "U_8 - U_3 = (8 - 3)b \\Rightarrow 40 - 15 = 5b \\Rightarrow 25 = 5b \\Rightarrow b = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan suku pertama ($a$) dari persamaan $U_3 = a + 2b$**" },
        { "tipe": "formula_block", "latex": "a + 2(5) = 15 \\Rightarrow a + 10 = 15 \\Rightarrow a = 5" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung suku ke-14 ($U_{14}$) menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "U_{14} = 5 + (14 - 1) \\cdot 5 = 5 + 13 \\cdot 5 = 5 + 65 = 70" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-14 barisan aritmatika tersebut adalah **$70$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan kelipatan 9 antara 100 dan 250 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2808$" } ],
        [ { "tipe": "paragraph", "text": "$2907$" } ],
        [ { "tipe": "paragraph", "text": "$3006$" } ],
        [ { "tipe": "paragraph", "text": "$3105$" } ],
        [ { "tipe": "paragraph", "text": "$3204$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi barisan kelipatan $9$ antara $100$ dan $250$**" },
        { "tipe": "paragraph", "text": "Suku pertama adalah $a = 108$, beda $b = 9$, dan suku terakhir adalah $U_n = 243$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan banyak suku ($n$) menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "243 = 108 + (n - 1)9 \\Rightarrow 135 = 9(n - 1) \\Rightarrow n - 1 = 15 \\Rightarrow n = 16" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung jumlah deret ($S_{16}$) menggunakan rumus $S_n = \\dfrac{n}{2}(a + U_n)$**" },
        { "tipe": "formula_block", "latex": "S_{16} = \\dfrac{16}{2}(108 + 243) = 8 \\cdot 351 = 2808" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah semua bilangan kelipatan $9$ antara $100$ dan $250$ adalah **$2808$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah barisan geometri dengan $U_1 = 3$ dan $U_9 = 768$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama dan suku terakhir**" },
        { "tipe": "paragraph", "text": "Diketahui $U_1 = 3$ dan $U_9 = 768$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku tengah dengan rumus $U_t = \\sqrt{U_1 \\cdot U_n}$**" },
        { "tipe": "formula_block", "latex": "U_t = \\sqrt{3 \\cdot 768} = \\sqrt{2304} = 48" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku tengah barisan geometri tersebut adalah **$48$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $10, 15, 20, 25, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n - 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 10n + 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 10$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan beda ($b$) barisan aritmatika**" },
        { "tipe": "formula_block", "latex": "a = 10, \\qquad b = 15 - 10 = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "U_n = 10 + (n - 1) \\cdot 5 = 10 + 5n - 5 = 5n + 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = 5n + 5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 barisan geometri $\\dfrac{1}{8}, \\dfrac{1}{4}, \\dfrac{1}{2}, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan rasio ($r$) barisan geometri**" },
        { "tipe": "formula_block", "latex": "a = \\dfrac{1}{8}, \\qquad r = \\dfrac{\\dfrac{1}{4}}{\\dfrac{1}{8}} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku ke-6 ($U_6$) menggunakan rumus $U_n = a \\cdot r^{n - 1}$**" },
        { "tipe": "formula_block", "latex": "U_6 = \\dfrac{1}{8} \\cdot 2^{6 - 1} = \\dfrac{1}{8} \\cdot 2^5 = \\dfrac{1}{8} \\cdot 32 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-6 barisan geometri tersebut adalah **$4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 12 suku pertama deret $4 + 7 + 10 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$228$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$246$" } ],
        [ { "tipe": "paragraph", "text": "$252$" } ],
        [ { "tipe": "paragraph", "text": "$264$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi unsur deret aritmatika**" },
        { "tipe": "paragraph", "text": "Diketahui $a = 4$, beda $b = 7 - 4 = 3$, dan banyak suku $n = 12$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $S_{12}$ menggunakan rumus $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$**" },
        { "tipe": "formula_block", "latex": "S_{12} = \\dfrac{12}{2}\\left(2(4) + (12 - 1)3\\right) = 6(8 + 33) = 6 \\cdot 41 = 246" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $12$ suku pertama deret tersebut adalah **$246$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika diketahui $U_4 = 13$ dan $U_7 = 25$. Suku pertama dan bedanya berturut-turut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 1$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$, $b = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 5$, $b = 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan beda ($b$) dari selisih $U_7$ dan $U_4$**" },
        { "tipe": "formula_block", "latex": "U_7 - U_4 = (7 - 4)b \\Rightarrow 25 - 13 = 3b \\Rightarrow 12 = 3b \\Rightarrow b = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan suku pertama ($a$) dari persamaan $U_4 = a + 3b$**" },
        { "tipe": "formula_block", "latex": "a + 3(4) = 13 \\Rightarrow a + 12 = 13 \\Rightarrow a = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama dan bedanya berturut-turut adalah **$a = 1$** dan **$b = 4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret geometri tak hingga $\\dfrac{5}{6} + \\dfrac{5}{12} + \\dfrac{5}{24} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{10}{3}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan rasio ($r$) deret geometri**" },
        { "tipe": "formula_block", "latex": "a = \\dfrac{5}{6}, \\qquad r = \\dfrac{\\dfrac{5}{12}}{\\dfrac{5}{6}} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah tak hingga dengan rumus $S_{\\infty} = \\dfrac{a}{1 - r}$**" },
        { "tipe": "formula_block", "latex": "S_{\\infty} = \\dfrac{\\dfrac{5}{6}}{1 - \\dfrac{1}{2}} = \\dfrac{\\dfrac{5}{6}}{\\dfrac{1}{2}} = \\dfrac{5}{6} \\times 2 = \\dfrac{5}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret geometri tak hingga tersebut adalah **$\\dfrac{5}{3}$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
