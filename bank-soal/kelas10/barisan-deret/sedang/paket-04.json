{
  "id": "bs-k10-bd-s-04",
  "nama": "Bank Soal Sedang - Paket 4",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang kombinasi barisan, deret, dan aplikasi lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = n^2 + n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n^2 - n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n^2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pola: $U_n = n(n+1) = n^2 + n$." },
        { "tipe": "paragraph", "text": "Cek: $U_1 = 2$, $U_2 = 6$, $U_3 = 12$, $U_4 = 20$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah deret aritmatika memiliki $U_3 + U_5 = 30$ dan $U_4 + U_6 = 38$. Suku ke-8 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_4 + U_6 - (U_3 + U_5) = 38 - 30 = 8 = 2b \\Rightarrow b = 4$" },
        { "tipe": "paragraph", "text": "$U_3 + U_5 = 2a + 6b = 30 \\Rightarrow 2a + 24 = 30 \\Rightarrow a = 3$" },
        { "tipe": "paragraph", "text": "$U_8 = 3 + 7 \\cdot 4 = 31$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri $1 + 3 + 9 + \\ldots$ adalah 364. Nilai $n$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_n = \\dfrac{1(3^n - 1)}{3 - 1} = \\dfrac{3^n - 1}{2} = 364$" },
        { "tipe": "paragraph", "text": "$3^n - 1 = 728 \\Rightarrow 3^n = 729 = 3^6 \\Rightarrow n = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan aritmatika dengan $U_3 = 8$ dan $U_7 = 20$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$b = \\dfrac{20 - 8}{7 - 3} = \\dfrac{12}{4} = 3$" },
        { "tipe": "paragraph", "text": "$U_3 = a + 2b = 8 \\Rightarrow a = 2$" },
        { "tipe": "paragraph", "text": "$U_{10} = 2 + 9 \\cdot 3 = 29$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret geometri tak hingga dengan $a = 6$ dan $r = \\dfrac{1}{3}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{6}{1 - 1/3} = \\dfrac{6}{2/3} = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan aritmatika. Jika jumlah ketiga bilangan adalah 27 dan hasil kalinya adalah 504, maka beda barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal tiga bilangan: $a-b, a, a+b$." },
        { "tipe": "paragraph", "text": "Jumlah = $3a = 27 \\Rightarrow a = 9$." },
        { "tipe": "paragraph", "text": "Hasil kali: $(9-b) \\cdot 9 \\cdot (9+b) = 504 \\Rightarrow 81 - b^2 = 56 \\Rightarrow b^2 = 25 \\Rightarrow b = 5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan geometri $1, 2, 4, 8, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 1$, $r = 2$." },
        { "tipe": "paragraph", "text": "$U_5 = a \\cdot r^4 = 1 \\cdot 2^4 = 16$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 8 suku pertama deret aritmatika $5 + 9 + 13 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$148$" } ],
        [ { "tipe": "paragraph", "text": "$152$" } ],
        [ { "tipe": "paragraph", "text": "$156$" } ],
        [ { "tipe": "paragraph", "text": "$160$" } ],
        [ { "tipe": "paragraph", "text": "$164$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 5$, $b = 4$, $n = 8$" },
        { "tipe": "paragraph", "text": "$S_8 = \\dfrac{8}{2}(2 \\cdot 5 + 7 \\cdot 4) = 4(10 + 28) = 4 \\cdot 38 = 152$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui barisan geometri $U_1 = 3$ dan $U_4 = 24$. Jumlah 5 suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$81$" } ],
        [ { "tipe": "paragraph", "text": "$93$" } ],
        [ { "tipe": "paragraph", "text": "$102$" } ],
        [ { "tipe": "paragraph", "text": "$117$" } ],
        [ { "tipe": "paragraph", "text": "$124$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r^3 = \\dfrac{24}{3} = 8 \\Rightarrow r = 2$" },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{3(2^5 - 1)}{2-1} = 3(31) = 93$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan asli kelipatan 5 yang kurang dari 100 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$850$" } ],
        [ { "tipe": "paragraph", "text": "$900$" } ],
        [ { "tipe": "paragraph", "text": "$950$" } ],
        [ { "tipe": "paragraph", "text": "$1000$" } ],
        [ { "tipe": "paragraph", "text": "$1050$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan 5 kurang dari 100: $5, 10, \\ldots, 95$" },
        { "tipe": "paragraph", "text": "$n = \\dfrac{95}{5} = 19$" },
        { "tipe": "paragraph", "text": "$S_{19} = \\dfrac{19}{2}(5 + 95) = \\dfrac{19}{2}(100) = 950$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}