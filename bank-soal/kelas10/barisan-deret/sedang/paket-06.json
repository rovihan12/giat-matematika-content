{
  "id": "bs-k10-bd-s-06",
  "nama": "Bank Soal Sedang - Paket 6",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang suku tengah, sisipan, sistem persamaan, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah dari barisan aritmatika dengan $U_1 = 7$ dan $U_{13} = 55$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama dan suku terakhir**" },
        { "tipe": "paragraph", "text": "Diketahui $U_1 = 7$ dan $U_{13} = 55$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku tengah dengan rumus $U_t = \\dfrac{U_1 + U_n}{2}$**" },
        { "tipe": "formula_block", "latex": "U_t = \\dfrac{7 + 55}{2} = \\dfrac{62}{2} = 31" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku tengah barisan aritmatika tersebut adalah **$31$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Di antara bilangan $3$ dan $27$ disisipkan 5 bilangan sehingga membentuk barisan aritmatika. Beda barisan baru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi nilai awal, nilai akhir, dan banyak sisipan**" },
        { "tipe": "paragraph", "text": "Diketahui $x = 3$, $y = 27$, dan banyak bilangan yang disisipkan $k = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung beda barisan baru dengan rumus $b' = \\dfrac{y - x}{k + 1}$**" },
        { "tipe": "formula_block", "latex": "b' = \\dfrac{27 - 3}{5 + 1} = \\dfrac{24}{6} = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, beda barisan baru tersebut adalah **$4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_4 = 14$ dan $U_9 = 34$. Suku ke-12 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan beda ($b$) dari selisih $U_9$ dan $U_4$**" },
        { "tipe": "formula_block", "latex": "U_9 - U_4 = (9 - 4)b \\Rightarrow 34 - 14 = 5b \\Rightarrow 20 = 5b \\Rightarrow b = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan suku pertama ($a$) dari persamaan $U_4 = a + 3b$**" },
        { "tipe": "formula_block", "latex": "a + 3(4) = 14 \\Rightarrow a + 12 = 14 \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung suku ke-12 ($U_{12}$) menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "U_{12} = 2 + (12 - 1) \\cdot 4 = 2 + 11 \\cdot 4 = 2 + 44 = 46" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-12 barisan aritmatika tersebut adalah **$46$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan kelipatan 4 antara 50 dan 150 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2400$" } ],
        [ { "tipe": "paragraph", "text": "$2500$" } ],
        [ { "tipe": "paragraph", "text": "$2600$" } ],
        [ { "tipe": "paragraph", "text": "$2700$" } ],
        [ { "tipe": "paragraph", "text": "$2800$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi barisan kelipatan $4$ antara $50$ dan $150$**" },
        { "tipe": "paragraph", "text": "Suku pertama adalah $a = 52$, beda $b = 4$, dan suku terakhir adalah $U_n = 148$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan banyak suku ($n$) menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "148 = 52 + (n - 1)4 \\Rightarrow 96 = 4(n - 1) \\Rightarrow n - 1 = 24 \\Rightarrow n = 25" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung jumlah deret ($S_{25}$) menggunakan rumus $S_n = \\dfrac{n}{2}(a + U_n)$**" },
        { "tipe": "formula_block", "latex": "S_{25} = \\dfrac{25}{2}(52 + 148) = \\dfrac{25}{2}(200) = 25 \\cdot 100 = 2500" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah semua bilangan kelipatan $4$ antara $50$ dan $150$ adalah **$2500$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah barisan geometri dengan $U_1 = 5$ dan $U_9 = 1280$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku pertama dan suku terakhir**" },
        { "tipe": "paragraph", "text": "Diketahui $U_1 = 5$ dan $U_9 = 1280$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku tengah dengan rumus $U_t = \\sqrt{U_1 \\cdot U_n}$**" },
        { "tipe": "formula_block", "latex": "U_t = \\sqrt{5 \\cdot 1280} = \\sqrt{6400} = 80" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku tengah barisan geometri tersebut adalah **$80$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $8, 13, 18, 23, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n - 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n + 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 8$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 8n + 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan beda ($b$) barisan aritmatika**" },
        { "tipe": "formula_block", "latex": "a = 8, \\qquad b = 13 - 8 = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan ke rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "U_n = 8 + (n - 1) \\cdot 5 = 8 + 5n - 5 = 5n + 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = 5n + 3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 barisan geometri $\\dfrac{1}{4}, \\dfrac{1}{2}, 1, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan rasio ($r$) barisan geometri**" },
        { "tipe": "formula_block", "latex": "a = \\dfrac{1}{4}, \\qquad r = \\dfrac{\\dfrac{1}{2}}{\\dfrac{1}{4}} = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku ke-5 ($U_5$) menggunakan rumus $U_n = a \\cdot r^{n - 1}$**" },
        { "tipe": "formula_block", "latex": "U_5 = \\dfrac{1}{4} \\cdot 2^{5 - 1} = \\dfrac{1}{4} \\cdot 2^4 = \\dfrac{1}{4} \\cdot 16 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 barisan geometri tersebut adalah **$4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 10 suku pertama deret $5 + 8 + 11 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$175$" } ],
        [ { "tipe": "paragraph", "text": "$185$" } ],
        [ { "tipe": "paragraph", "text": "$195$" } ],
        [ { "tipe": "paragraph", "text": "$205$" } ],
        [ { "tipe": "paragraph", "text": "$215$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi unsur deret aritmatika**" },
        { "tipe": "paragraph", "text": "Diketahui $a = 5$, beda $b = 8 - 5 = 3$, dan banyak suku $n = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $S_{10}$ menggunakan rumus $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$**" },
        { "tipe": "formula_block", "latex": "S_{10} = \\dfrac{10}{2}\\left(2(5) + (10 - 1)3\\right) = 5(10 + 9 \\cdot 3) = 5(10 + 27) = 5 \\cdot 37 = 185" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $10$ suku pertama deret tersebut adalah **$185$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika diketahui $U_2 = 9$ dan $U_8 = 33$. Suku pertama dan bedanya berturut-turut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 5$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 5$, $b = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$, $b = 5$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$, $b = 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan beda ($b$) dari selisih $U_8$ dan $U_2$**" },
        { "tipe": "formula_block", "latex": "U_8 - U_2 = (8 - 2)b \\Rightarrow 33 - 9 = 6b \\Rightarrow 24 = 6b \\Rightarrow b = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan suku pertama ($a$) dari persamaan $U_2 = a + b$**" },
        { "tipe": "formula_block", "latex": "a + 4 = 9 \\Rightarrow a = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama dan bedanya berturut-turut adalah **$a = 5$** dan **$b = 4$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret geometri tak hingga $\\dfrac{1}{4} + \\dfrac{1}{8} + \\dfrac{1}{16} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan rasio ($r$) deret geometri**" },
        { "tipe": "formula_block", "latex": "a = \\dfrac{1}{4}, \\qquad r = \\dfrac{\\dfrac{1}{8}}{\\dfrac{1}{4}} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah tak hingga dengan rumus $S_{\\infty} = \\dfrac{a}{1 - r}$**" },
        { "tipe": "formula_block", "latex": "S_{\\infty} = \\dfrac{\\dfrac{1}{4}}{1 - \\dfrac{1}{2}} = \\dfrac{\\dfrac{1}{4}}{\\dfrac{1}{2}} = \\dfrac{1}{4} \\times 2 = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret geometri tak hingga tersebut adalah **$\\dfrac{1}{2}$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
