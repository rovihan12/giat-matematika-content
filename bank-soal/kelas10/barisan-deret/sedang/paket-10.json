  "deskripsi": "Soal sedang tentang sistem persamaan, deret tak hingga, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_2 + U_5 = 19$ dan $U_4 = 11$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_2 + U_5 = (a+b) + (a+4b) = 2a + 5b = 19$." },
        { "tipe": "paragraph", "text": "$U_4 = a + 3b = 11 \\Rightarrow a = 11 - 3b$." },
        { "tipe": "paragraph", "text": "Substitusi: $2(11-3b) + 5b = 19 \\Rightarrow 22 - b = 19 \\Rightarrow b = 3$." },
        { "tipe": "paragraph", "text": "Diperoleh $a = 11 - 3(3) = 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = n^2 + 4n$. Suku ke-8 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_8 = 64 + 32 = 96$." },
        { "tipe": "paragraph", "text": "$S_7 = 49 + 28 = 77$." },
        { "tipe": "paragraph", "text": "$U_8 = 96 - 77 = 19$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $\\dfrac{4}{5} + \\dfrac{4}{25} + \\dfrac{4}{125} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{8}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = \\dfrac{4}{5}$, $r = \\dfrac{1}{5}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{4/5}{1 - 1/5} = \\dfrac{4/5}{4/5} = 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Seorang pedagang menjual 30 mangkok pada hari pertama, 35 mangkok hari kedua, 40 mangkok hari ketiga, dan seterusnya (naik 5 tiap hari). Total mangkok terjual selama 12 hari adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$600$" } ],
        [ { "tipe": "paragraph", "text": "$630$" } ],
        [ { "tipe": "paragraph", "text": "$660$" } ],
        [ { "tipe": "paragraph", "text": "$690$" } ],
        [ { "tipe": "paragraph", "text": "$720$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 30$, $b = 5$, $n = 12$." },
        { "tipe": "paragraph", "text": "$S_{12} = \\dfrac{12}{2}(2 \\cdot 30 + 11 \\cdot 5) = 6(60 + 55) = 6 \\cdot 115 = 690$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan geometri, $U_2 = 20$ dan $U_5 = 160$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{U_5}{U_2} = r^3 = \\dfrac{160}{20} = 8 \\Rightarrow r = 2$." },
        { "tipe": "paragraph", "text": "$U_2 = a r = 20 \\Rightarrow a \\cdot 2 = 20 \\Rightarrow a = 10$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan asli kelipatan 11 yang kurang dari 200 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1782$" } ],
        [ { "tipe": "paragraph", "text": "$1881$" } ],
        [ { "tipe": "paragraph", "text": "$1980$" } ],
        [ { "tipe": "paragraph", "text": "$2079$" } ],
        [ { "tipe": "paragraph", "text": "$2178$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan 11 < 200: $11, 22, \\ldots, 198$." },
        { "tipe": "paragraph", "text": "$n = \\dfrac{198}{11} = 18$." },
        { "tipe": "paragraph", "text": "$S_{18} = \\dfrac{18}{2}(11 + 198) = 9 \\cdot 209 = 1881$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $S_4 = 30$ dan $S_8 = 108$. Beda barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_4 = 2(2a + 3b) = 30 \\Rightarrow 2a + 3b = 15$." },
        { "tipe": "paragraph", "text": "$S_8 = 4(2a + 7b) = 108 \\Rightarrow 2a + 7b = 27$." },
        { "tipe": "paragraph", "text": "Kurangkan: $4b = 12 \\Rightarrow b = 3$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 dan ke-5 barisan geometri berturut-turut $18$ dan $162$. Suku ke-4 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$66$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_4 = \\sqrt{U_3 \\cdot U_5} = \\sqrt{18 \\cdot 162} = \\sqrt{2916} = 54$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 18 suku pertama deret $1 + 5 + 9 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$594$" } ],
        [ { "tipe": "paragraph", "text": "$612$" } ],
        [ { "tipe": "paragraph", "text": "$630$" } ],
        [ { "tipe": "paragraph", "text": "$648$" } ],
        [ { "tipe": "paragraph", "text": "$666$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 1$, $b = 4$, $n = 18$." },
        { "tipe": "paragraph", "text": "$S_{18} = \\dfrac{18}{2}(2 \\cdot 1 + 17 \\cdot 4) = 9(2 + 68) = 9 \\cdot 70 = 630$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga memiliki $S_\\infty = 20$ dan $r = \\dfrac{1}{4}$. Suku pertama deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$20 = \\dfrac{a}{1 - 1/4} = \\dfrac{a}{3/4}$." },
        { "tipe": "paragraph", "text": "$a = 20 \\cdot \\dfrac{3}{4} = 15$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
