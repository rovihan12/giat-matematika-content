{
  "id": "bs-k10-bd-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang suku tengah, sisipan, dan suku ke-n",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah dari barisan aritmatika dengan $U_1 = 3$ dan $U_{11} = 43$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_t = \\dfrac{a + U_n}{2} = \\dfrac{3 + 43}{2} = 23$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika di antara bilangan $2$ dan $32$ disisipkan 4 bilangan sehingga membentuk barisan aritmatika, maka beda barisan baru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Disisipkan $k = 4$ bilangan → total suku baru = $n + k = 2 + 4 = 6$." },
        { "tipe": "paragraph", "text": "$b = \\dfrac{U_{baru} - U_{awal}}{k+1} = \\dfrac{32 - 2}{4+1} = \\dfrac{30}{5} = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 dan suku ke-7 barisan aritmatika berturut-turut $11$ dan $27$. Suku ke-15 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$57$" } ],
        [ { "tipe": "paragraph", "text": "$59$" } ],
        [ { "tipe": "paragraph", "text": "$61$" } ],
        [ { "tipe": "paragraph", "text": "$63$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_7 - U_3 = 27 - 11 = 16 = 4b \\Rightarrow b = 4$" },
        { "tipe": "paragraph", "text": "$U_3 = a + 2b = 11 \\Rightarrow a = 11 - 8 = 3$" },
        { "tipe": "paragraph", "text": "$U_{15} = 3 + 14 \\cdot 4 = 3 + 56 = 59$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan kelipatan 3 antara 100 dan 200 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4950$" } ],
        [ { "tipe": "paragraph", "text": "$5000$" } ],
        [ { "tipe": "paragraph", "text": "$5025$" } ],
        [ { "tipe": "paragraph", "text": "$5050$" } ],
        [ { "tipe": "paragraph", "text": "$5100$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan 3: pertama $102$, terakhir $198$." },
        { "tipe": "paragraph", "text": "$n = \\dfrac{198 - 102}{3} + 1 = \\dfrac{96}{3} + 1 = 33$" },
        { "tipe": "paragraph", "text": "$S_{33} = \\dfrac{33}{2}(102 + 198) = \\dfrac{33}{2}(300) = 33 \\cdot 150 = 4950$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah barisan geometri dengan $U_1 = 2$ dan $U_9 = 512$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_t = \\sqrt{a \\cdot U_n} = \\sqrt{2 \\cdot 512} = \\sqrt{1024} = 32$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ barisan $5, 8, 11, 14, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 3n + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n - 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 5$, $b = 3$" },
        { "tipe": "paragraph", "text": "$U_n = 5 + (n-1) \\cdot 3 = 5 + 3n - 3 = 3n + 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-4 barisan geometri $\\dfrac{1}{2}, 1, 2, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = \\dfrac{1}{2}$, $r = \\dfrac{1}{1/2} = 2$" },
        { "tipe": "paragraph", "text": "$U_4 = \\dfrac{1}{2} \\cdot 2^{3} = \\dfrac{1}{2} \\cdot 8 = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 12 suku pertama deret $3 + 5 + 7 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$160$" } ],
        [ { "tipe": "paragraph", "text": "$164$" } ],
        [ { "tipe": "paragraph", "text": "$168$" } ],
        [ { "tipe": "paragraph", "text": "$172$" } ],
        [ { "tipe": "paragraph", "text": "$176$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 3$, $b = 2$, $n = 12$" },
        { "tipe": "paragraph", "text": "$S_{12} = \\dfrac{12}{2}(2 \\cdot 3 + 11 \\cdot 2) = 6(6 + 22) = 6 \\cdot 28 = 168$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika diketahui $U_5 = 17$ dan $U_{10} = 37$. Suku pertama dan bedanya berturut-turut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 5$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 5$, $b = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 3$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$, $b = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 1$, $b = 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_{10} - U_5 = 37 - 17 = 20 = 5b \\Rightarrow b = 4$" },
        { "tipe": "paragraph", "text": "$U_5 = a + 4b = 17 \\Rightarrow a = 17 - 16 = 1$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: $a = 1$, $b = 4$. Kunci opsi E." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 barisan geometri $\\ldots, 12, 24, 48, \\ldots$ adalah $12$. Berapa suku ke-5?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ],
        [ { "tipe": "paragraph", "text": "$192$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_3 = 12$, $U_4 = 24$, $U_5 = 48$, $U_6 = 96$" },
        { "tipe": "paragraph", "text": "Diketahui $r = 2$, $U_5 = 12 \\cdot 2^2 = 48$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: jawaban $U_5 = 48$. Kunci opsi A." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
