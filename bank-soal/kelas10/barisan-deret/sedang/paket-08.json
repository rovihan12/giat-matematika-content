{
  "id": "bs-k10-bd-s-08",
  "nama": "Bank Soal Sedang - Paket 8",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang sistem persamaan, S_n ke U_n, dan aplikasi kontekstual",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_2 + U_5 = 25$ dan $U_3 = 11$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_2 + U_5 = (a+b) + (a+4b) = 2a + 5b = 25$." },
        { "tipe": "paragraph", "text": "$U_3 = a + 2b = 11$." },
        { "tipe": "paragraph", "text": "Dari $a = 11 - 2b$: $2(11-2b) + 5b = 25 \\Rightarrow 22 + b = 25 \\Rightarrow b = 3$, maka $a = 5$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $S_n = 2n^2 + n$. Suku ke-7 deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_7 = 2(49) + 7 = 105$." },
        { "tipe": "paragraph", "text": "$S_6 = 2(36) + 6 = 78$." },
        { "tipe": "paragraph", "text": "$U_7 = 105 - 78 = 27$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $\\dfrac{3}{4} + \\dfrac{3}{8} + \\dfrac{3}{16} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{9}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{2}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = \\dfrac{3}{4}$, $r = \\dfrac{1}{2}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{3/4}{1 - 1/2} = \\dfrac{3/4}{1/2} = \\dfrac{3}{2}$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Seorang atlet berenang 400 m pada hari pertama, 450 m pada hari kedua, 500 m pada hari ketiga, dan seterusnya (naik 50 m tiap hari). Total jarak renang selama 10 hari adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6250$ m" } ],
        [ { "tipe": "paragraph", "text": "$6500$ m" } ],
        [ { "tipe": "paragraph", "text": "$6750$ m" } ],
        [ { "tipe": "paragraph", "text": "$7000$ m" } ],
        [ { "tipe": "paragraph", "text": "$7250$ m" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 400$, $b = 50$, $n = 10$." },
        { "tipe": "paragraph", "text": "$S_{10} = \\dfrac{10}{2}(2 \\cdot 400 + 9 \\cdot 50) = 5(800 + 450) = 5 \\cdot 1250 = 6250$ m." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan geometri, $U_2 = 12$ dan $U_5 = 96$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{U_5}{U_2} = r^3 = \\dfrac{96}{12} = 8 \\Rightarrow r = 2$." },
        { "tipe": "paragraph", "text": "$U_2 = a r = 12 \\Rightarrow a \\cdot 2 = 12 \\Rightarrow a = 6$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan asli kelipatan 7 yang kurang dari 100 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$700$" } ],
        [ { "tipe": "paragraph", "text": "$735$" } ],
        [ { "tipe": "paragraph", "text": "$770$" } ],
        [ { "tipe": "paragraph", "text": "$805$" } ],
        [ { "tipe": "paragraph", "text": "$840$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan 7: $7, 14, \\ldots, 98$." },
        { "tipe": "paragraph", "text": "$n = \\dfrac{98}{7} = 14$." },
        { "tipe": "paragraph", "text": "$S_{14} = \\dfrac{14}{2}(7 + 98) = 7 \\cdot 105 = 735$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $S_6 = 57$ dan $S_{12} = 222$. Suku pertama barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_6 = 3(2a + 5b) = 57 \\Rightarrow 2a + 5b = 19$." },
        { "tipe": "paragraph", "text": "$S_{12} = 6(2a + 11b) = 222 \\Rightarrow 2a + 11b = 37$." },
        { "tipe": "paragraph", "text": "Kurangkan kedua persamaan: $6b = 18 \\Rightarrow b = 3$." },
        { "tipe": "paragraph", "text": "Substitusi nilai $b$: $2a + 5(3) = 19 \\Rightarrow 2a = 4 \\Rightarrow a = 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-4 dan ke-7 barisan geometri berturut-turut $24$ dan $192$. Rasio barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{U_7}{U_4} = r^3 = \\dfrac{192}{24} = 8 \\Rightarrow r = 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 20 suku pertama deret $3 + 7 + 11 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$780$" } ],
        [ { "tipe": "paragraph", "text": "$800$" } ],
        [ { "tipe": "paragraph", "text": "$820$" } ],
        [ { "tipe": "paragraph", "text": "$840$" } ],
        [ { "tipe": "paragraph", "text": "$860$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 3$, $b = 4$, $n = 20$." },
        { "tipe": "paragraph", "text": "$S_{20} = \\dfrac{20}{2}(2 \\cdot 3 + 19 \\cdot 4) = 10(6 + 76) = 10 \\cdot 82 = 820$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga memiliki $S_\\infty = 24$ dan $r = \\dfrac{1}{3}$. Suku pertama deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$24 = \\dfrac{a}{1 - 1/3} = \\dfrac{a}{2/3}$." },
        { "tipe": "paragraph", "text": "$a = 24 \\cdot \\dfrac{2}{3} = 16$." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
