{
  "id": "bs-k10-bd-s-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang deret geometri tak hingga dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret geometri tak hingga $1 - \\dfrac{1}{3} + \\dfrac{1}{9} - \\ldots$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{4}{3}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 1$, $r = -\\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{1}{1 - (-1/3)} = \\dfrac{1}{4/3} = \\dfrac{3}{4}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bola dijatuhkan dari ketinggian 10 m. Setiap pantulan mencapai $\\dfrac{2}{3}$ dari tinggi sebelumnya. Total lintasan sampai berhenti adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$ m" } ],
        [ { "tipe": "paragraph", "text": "$40$ m" } ],
        [ { "tipe": "paragraph", "text": "$50$ m" } ],
        [ { "tipe": "paragraph", "text": "$60$ m" } ],
        [ { "tipe": "paragraph", "text": "$70$ m" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Lintasan = $h + 2 \\cdot S_\\infty(\\text{pantulan})$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{a}{1 - r} = \\dfrac{10 \\cdot (2/3)}{1 - 2/3} = \\dfrac{20/3}{1/3} = 20$" },
        { "tipe": "paragraph", "text": "Total = $10 + 2 \\cdot 20 = 50$ m" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri adalah $12$ dan suku pertamanya $4$. Rasio deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{4}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{a}{1-r} \\Rightarrow 12 = \\dfrac{4}{1-r}$" },
        { "tipe": "paragraph", "text": "$1 - r = \\dfrac{1}{3} \\Rightarrow r = \\dfrac{2}{3}$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: $r = \\dfrac{2}{3}$. Kunci opsi D." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada barisan aritmatika, $U_1 + U_3 = 16$ dan $U_2 + U_4 = 24$. Suku pertama dan beda adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 4$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 4$, $b = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$, $b = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 6$, $b = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 8$, $b = 2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_1 + U_3 = a + (a + 2b) = 2a + 2b = 16 \\Rightarrow a + b = 8$" },
        { "tipe": "paragraph", "text": "$U_2 + U_4 = (a+b) + (a+3b) = 2a + 4b = 24 \\Rightarrow a + 2b = 12$" },
        { "tipe": "paragraph", "text": "Kurangkan: $b = 4$, maka $a = 4$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: $a = 4$, $b = 4$. Kunci opsi A." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret geometri $2 + 2\\sqrt{2} + 4 + \\ldots$ sampai 5 suku adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2(3 + \\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$2(3 + 2\\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$2(3 + 3\\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$4(3 + 2\\sqrt{2})$" } ],
        [ { "tipe": "paragraph", "text": "$4(3 + 3\\sqrt{2})$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 2$, $r = \\sqrt{2}$" },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{2((\\sqrt{2})^5 - 1)}{\\sqrt{2} - 1} = \\dfrac{2(4\\sqrt{2} - 1)}{\\sqrt{2} - 1}$" },
        { "tipe": "paragraph", "text": "Rasionalkan & sederhanakan → $2(3 + 2\\sqrt{2})$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 15 suku pertama deret aritmatika dengan $U_1 = 4$ dan $U_{15} = 60$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$420$" } ],
        [ { "tipe": "paragraph", "text": "$450$" } ],
        [ { "tipe": "paragraph", "text": "$480$" } ],
        [ { "tipe": "paragraph", "text": "$500$" } ],
        [ { "tipe": "paragraph", "text": "$520$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_{15} = \\dfrac{15}{2}(4 + 60) = \\dfrac{15}{2}(64) = 15 \\cdot 32 = 480$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $U_4 = 24$ dan $U_7 = 192$ pada barisan geometri, maka rasio barisan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{U_7}{U_4} = \\dfrac{192}{24} = 8 = r^3 \\Rightarrow r = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah semua bilangan asli antara 1 dan 100 yang habis dibagi 4 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1000$" } ],
        [ { "tipe": "paragraph", "text": "$1176$" } ],
        [ { "tipe": "paragraph", "text": "$1200$" } ],
        [ { "tipe": "paragraph", "text": "$1224$" } ],
        [ { "tipe": "paragraph", "text": "$1300$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kelipatan 4 antara 1 dan 100: $4, 8, \\ldots, 96$" },
        { "tipe": "paragraph", "text": "$n = \\dfrac{96}{4} = 24$" },
        { "tipe": "paragraph", "text": "$S_{24} = \\dfrac{24}{2}(4 + 96) = 12 \\cdot 100 = 1200$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 dan ke-5 barisan geometri adalah 6 dan 24. Suku ke-7 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ],
        [ { "tipe": "paragraph", "text": "$192$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{U_5}{U_3} = \\dfrac{24}{6} = 4 = r^2 \\Rightarrow r = 2$" },
        { "tipe": "paragraph", "text": "$U_7 = U_5 \\cdot r^2 = 24 \\cdot 4 = 96$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-bd-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika pada deret geometri $S_\\infty = 8$ dan $r = \\dfrac{1}{2}$, maka suku pertamanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{a}{1 - r} \\Rightarrow 8 = \\dfrac{a}{1/2} \\Rightarrow a = 4$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
