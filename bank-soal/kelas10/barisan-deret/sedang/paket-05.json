        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_n = 3 + (n-1) \\cdot 4 = 79$" },
        { "tipe": "paragraph", "text": "$(n-1) \\cdot 4 = 76 \\Rightarrow n-1 = 19 \\Rightarrow n = 20$" }
      ],
      "tingkat": "SEDANG"
    },
    {
