    {
      "id": "bs-k10-bd-s-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada deret geometri, $S_3 = 14$ dan $S_4 = 30$. Rasio deret tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_4 = S_4 - S_3 = 30 - 14 = 16$" },
        { "tipe": "paragraph", "text": "$S_3 = a(1 + r + r^2) = 14$" },
        { "tipe": "paragraph", "text": "$U_4 = ar^3 = 16$" },
        { "tipe": "paragraph", "text": "$\\dfrac{ar^3}{a(1+r+r^2)} = \\dfrac{16}{14} \\Rightarrow \\dfrac{r^3}{1+r+r^2} = \\dfrac{8}{7}$" },
        { "tipe": "paragraph", "text": "Coba $r = 2$: $\\dfrac{8}{1+2+4} = \\dfrac{8}{7}$ ✓" }
      ],
      "tingkat": "SEDANG"
