{
  "id": "bs-k10-bd-m-06",
  "nama": "Bank Soal Mudah - Paket 6",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang pola barisan, beda/rasio, dan suku ke-n",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-06-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $4, 9, 14, 19, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Beda = $9 - 4 = 5$ (barisan aritmatika)." },
        { "tipe": "paragraph", "text": "Suku berikutnya = $19 + 5 = 24$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $81, 27, 9, 3, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{2}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{9}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rasio = $27/81 = \\dfrac{1}{3}$ (barisan geometri)." },
        { "tipe": "paragraph", "text": "Suku berikutnya = $3 \\times \\dfrac{1}{3} = 1$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Beda dari barisan aritmatika $12, 7, 2, -3, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$-3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$b = 7 - 12 = -5$ (barisan menurun)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rasio dari barisan geometri $5, 15, 45, 135, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$r = 15/5 = 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan aritmatika $7, 11, 15, 19, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 7$, $b = 4$." },
        { "tipe": "paragraph", "text": "$U_6 = 7 + (6-1) \\cdot 4 = 7 + 20 = 27$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan geometri $3, 6, 12, 24, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 3$, $r = 2$." },
        { "tipe": "paragraph", "text": "$U_5 = 3 \\cdot 2^{4} = 3 \\cdot 16 = 48$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $6, 10, 14, 18, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n - 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 6n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 6$, $b = 4$." },
        { "tipe": "paragraph", "text": "$U_n = 6 + (n-1) \\cdot 4 = 4n + 2$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 6 suku pertama deret $1 + 4 + 7 + 10 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$57$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 1$, $b = 3$, $n = 6$." },
        { "tipe": "paragraph", "text": "$S_6 = \\dfrac{6}{2}(2 \\cdot 1 + 5 \\cdot 3) = 3(2 + 15) = 3 \\cdot 17 = 51$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan $1, 4, 9, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$81$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Pola kuadrat: $U_n = n^2$." },
        { "tipe": "paragraph", "text": "$U_8 = 8^2 = 64$." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-06-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $6 + 3 + \\dfrac{3}{2} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 6$, $r = \\dfrac{1}{2}$ (dengan $|r| < 1$)." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{6}{1 - \\frac{1}{2}} = \\dfrac{6}{\\frac{1}{2}} = 12$." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
