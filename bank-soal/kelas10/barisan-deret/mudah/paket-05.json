{
  "id": "bs-k10-bd-m-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran tentang barisan dan deret",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-25 dari barisan aritmatika $3, 8, 13, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$118$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$123$" } ],
        [ { "tipe": "paragraph", "text": "$125$" } ],
        [ { "tipe": "paragraph", "text": "$128$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 3$) dan beda ($b = 8 - 3 = 5$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_{25}$ menggunakan rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_{25} = 3 + (25 - 1) \\cdot 5 = 3 + 24 \\cdot 5 = 3 + 120 = 123" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-25 barisan aritmatika tersebut adalah **$123$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyak suku pada barisan $4, 8, 12, \\ldots, 100$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 4$), beda ($b = 8 - 4 = 4$), dan suku terakhir ($U_n = 100$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus $U_n = a + (n - 1)b$ untuk mencari nilai $n$." },
        { "tipe": "formula_block", "latex": "100 = 4 + (n - 1) \\cdot 4 \\Rightarrow 96 = 4(n - 1) \\Rightarrow n - 1 = 24 \\Rightarrow n = 25" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, banyak suku pada barisan tersebut adalah **$25$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku pertama barisan geometri $\\ldots, 8, 16, 32$ jika $r = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi suku ketiga ($U_3 = 8$) dan rasio ($r = 2$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$ untuk mencari suku pertama ($a$)." },
        { "tipe": "formula_block", "latex": "U_3 = a \\cdot 2^{3-1} = 4a = 8 \\Rightarrow a = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama barisan geometri tersebut adalah **$2$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 15 suku pertama deret $2 + 4 + 6 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$220$" } ],
        [ { "tipe": "paragraph", "text": "$230$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$250$" } ],
        [ { "tipe": "paragraph", "text": "$260$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 2$), beda ($b = 2$), dan banyaknya suku ($n = 15$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_{15}$ menggunakan rumus jumlah deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$." },
        { "tipe": "formula_block", "latex": "S_{15} = \\dfrac{15}{2}\\left(2(2) + (15 - 1)2\\right) = \\dfrac{15}{2}(4 + 28) = \\dfrac{15}{2}(32) = 15 \\cdot 16 = 240" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $15$ suku pertama deret tersebut adalah **$240$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika barisan aritmatika memiliki $U_3 = 10$ dan $U_7 = 22$, maka bedanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan selisih suku pada barisan aritmatika $U_7 - U_3 = (7 - 3)b$**" },
        { "tipe": "formula_block", "latex": "22 - 10 = 4b \\Rightarrow 12 = 4b \\Rightarrow b = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, beda barisan aritmatika tersebut adalah **$3$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 4 suku pertama deret geometri $5 + 10 + 20 + 40$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$85$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jumlahkan keempat suku pada deret geometri tersebut**" },
        { "tipe": "formula_block", "latex": "S_4 = 5 + 10 + 20 + 40 = 75" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $4$ suku pertama deret geometri tersebut adalah **$75$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 barisan geometri dengan $a = 5$ dan $r = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$**" },
        { "tipe": "paragraph", "text": "Diketahui $a = 5$, $r = 4$, dan $n = 3$." },
        { "tipe": "formula_block", "latex": "U_3 = 5 \\cdot 4^{3-1} = 5 \\cdot 4^2 = 5 \\cdot 16 = 80" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-3 barisan geometri tersebut adalah **$80$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $4, 7, 10, 13, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 3n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 4$) dan beda ($b = 7 - 4 = 3$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_n = 4 + (n - 1) \\cdot 3 = 4 + 3n - 3 = 3n + 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = 3n + 1$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret tak hingga $8 + 4 + 2 + 1 + \\ldots$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 8$) dan rasio ($r = \\dfrac{4}{8} = \\dfrac{1}{2}$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_{\\infty}$ menggunakan rumus jumlah deret geometri tak hingga $S_{\\infty} = \\dfrac{a}{1 - r}$." },
        { "tipe": "formula_block", "latex": "S_{\\infty} = \\dfrac{8}{1 - \\dfrac{1}{2}} = \\dfrac{8}{\\dfrac{1}{2}} = 8 \\times 2 = 16" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret tak hingga tersebut adalah **$16$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan $1, 4, 9, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kenali pola kuadrat bilangan asli $U_n = n^2$**" },
        { "tipe": "paragraph", "text": "Substitusikan $n = 5$ ke dalam rumus pola tersebut." },
        { "tipe": "formula_block", "latex": "U_5 = 5^2 = 25" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 barisan tersebut adalah **$25$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
