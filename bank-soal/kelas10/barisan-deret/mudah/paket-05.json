{
  "id": "bs-k10-bd-m-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran tentang barisan dan deret",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-25 dari barisan aritmatika $3, 8, 13, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$118$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ],
        [ { "tipe": "paragraph", "text": "$123$" } ],
        [ { "tipe": "paragraph", "text": "$125$" } ],
        [ { "tipe": "paragraph", "text": "$128$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_{25} = 3 + 24 \\cdot 5 = 3 + 120 = 123$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Banyak suku pada barisan $4, 8, 12, \\ldots, 100$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 4$, $b = 4$, $U_n = 100$" },
        { "tipe": "paragraph", "text": "$100 = 4 + (n-1) \\cdot 4 \\Rightarrow 96 = 4(n-1) \\Rightarrow n-1 = 24 \\Rightarrow n = 25$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku pertama barisan geometri $\\ldots, 8, 16, 32$ jika $r = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_3 = 8$ dengan $r = 2$: $a \\cdot r^2 = 8 \\Rightarrow a \\cdot 4 = 8 \\Rightarrow a = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 15 suku pertama deret $2 + 4 + 6 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$220$" } ],
        [ { "tipe": "paragraph", "text": "$230$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ],
        [ { "tipe": "paragraph", "text": "$250$" } ],
        [ { "tipe": "paragraph", "text": "$260$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_{15} = \\dfrac{15}{2}(2 \\cdot 2 + 14 \\cdot 2) = \\dfrac{15}{2}(4 + 28) = \\dfrac{15}{2}(32) = 240$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika barisan aritmatika memiliki $U_3 = 10$ dan $U_7 = 22$, maka bedanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_7 - U_3 = 22 - 10 = 12 = 4b$" },
        { "tipe": "paragraph", "text": "$b = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 4 suku pertama deret geometri $5 + 10 + 20 + 40$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$85$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_4 = 5 + 10 + 20 + 40 = 75$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-3 barisan geometri dengan $a = 5$ dan $r = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$U_3 = 5 \\cdot 4^{2} = 5 \\cdot 16 = 80$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $4, 7, 10, 13, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 3n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n + 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 4$, $b = 3$" },
        { "tipe": "paragraph", "text": "$U_n = 4 + (n-1) \\cdot 3 = 3n + 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret tak hingga $8 + 4 + 2 + 1 + \\ldots$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{8}{1 - \\frac{1}{2}} = \\dfrac{8}{\\frac{1}{2}} = 16$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan $1, 4, 9, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Barisan kuadrat: $U_n = n^2$." },
        { "tipe": "paragraph", "text": "$U_5 = 25$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
