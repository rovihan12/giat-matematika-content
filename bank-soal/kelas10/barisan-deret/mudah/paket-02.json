{
  "id": "bs-k10-bd-m-02",
  "nama": "Bank Soal Mudah - Paket 2",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang suku ke-n barisan aritmatika dan geometri",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-15 dari barisan $2, 5, 8, 11, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan beda ($b$) barisan aritmatika**" },
        { "tipe": "paragraph", "text": "Dari barisan diperoleh $a = 2$ dan $b = 5 - 2 = 3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $U_{15}$ menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "U_{15} = 2 + (15 - 1) \\cdot 3 = 2 + 14 \\cdot 3 = 2 + 42 = 44" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-15 barisan tersebut adalah **$44$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan $4, 7, 10, 13, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan beda ($b$) barisan aritmatika**" },
        { "tipe": "paragraph", "text": "Dari barisan diperoleh $a = 4$ dan $b = 7 - 4 = 3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $U_8$ menggunakan rumus $U_n = a + (n - 1)b$**" },
        { "tipe": "formula_block", "latex": "U_8 = 4 + (8 - 1) \\cdot 3 = 4 + 7 \\cdot 3 = 4 + 21 = 25" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-8 barisan tersebut adalah **$25$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku pertama dan beda barisan $10, 7, 4, 1, \\ldots$ berturut-turut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 10$, $b = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 10$, $b = -3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 10$, $b = -4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 1$, $b = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 1$, $b = -3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan hitung beda ($b = U_2 - U_1$)**" },
        { "tipe": "formula_block", "latex": "a = 10, \\qquad b = 7 - 10 = -3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku pertama dan bedanya berturut-turut adalah **$a = 10$** dan **$b = -3$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-12 dari barisan $1, 4, 7, 10, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 1$) dan beda ($b = 4 - 1 = 3$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_{12}$ menggunakan rumus $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_{12} = 1 + (12 - 1) \\cdot 3 = 1 + 11 \\cdot 3 = 1 + 33 = 34" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-12 barisan tersebut adalah **$34$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-$n$ dari barisan $3, 8, 13, 18, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 5n - 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n + 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n - 2$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 3$) dan beda ($b = 8 - 3 = 5$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_n = 3 + (n - 1) \\cdot 5 = 3 + 5n - 5 = 5n - 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = 5n - 2$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $U_n = 4n + 1$, maka suku ke-7 adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $n = 7$ ke rumus $U_n = 4n + 1$**" },
        { "tipe": "formula_block", "latex": "U_7 = 4(7) + 1 = 28 + 1 = 29" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-7 barisan tersebut adalah **$29$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $2, 6, 18, 54, \\ldots$ memiliki $a$ dan $r$ berturut-turut..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$a = 2$, $r = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$, $r = 3$" } ],
        [ { "tipe": "paragraph", "text": "$a = 2$, $r = 4$" } ],
        [ { "tipe": "paragraph", "text": "$a = 6$, $r = 2$" } ],
        [ { "tipe": "paragraph", "text": "$a = 6$, $r = 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a$) dan hitung rasio ($r = \\dfrac{U_2}{U_1}$)**" },
        { "tipe": "formula_block", "latex": "a = 2, \\qquad r = \\dfrac{6}{2} = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ dan $r$ berturut-turut adalah **$a = 2$** dan **$r = 3$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan geometri $1, 2, 4, 8, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 1$) dan rasio ($r = \\dfrac{2}{1} = 2$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_6$ menggunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "formula_block", "latex": "U_6 = 1 \\cdot 2^{6-1} = 1 \\cdot 2^5 = 32" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-6 barisan geometri tersebut adalah **$32$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-4 dari barisan geometri $3, 6, 12, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 3$) dan rasio ($r = \\dfrac{6}{3} = 2$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_4$ menggunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "formula_block", "latex": "U_4 = 3 \\cdot 2^{4-1} = 3 \\cdot 2^3 = 3 \\cdot 8 = 24" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-4 barisan geometri tersebut adalah **$24$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan geometri $2, 8, 32, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 2 \\cdot 4^{n-1}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2 \\cdot 4^n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4 \\cdot 2^{n-1}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 2 \\cdot 2^{n-1}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4^{n-1}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 2$) dan rasio ($r = \\dfrac{8}{2} = 4$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus umum suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "formula_block", "latex": "U_n = 2 \\cdot 4^{n-1}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan geometri tersebut adalah **$U_n = 2 \\cdot 4^{n-1}$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
