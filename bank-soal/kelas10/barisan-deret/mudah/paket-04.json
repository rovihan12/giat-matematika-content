      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan geometri $2, 6, 18, \\ldots$ adalah..." }
