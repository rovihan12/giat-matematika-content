        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 100$, $b = -5$" },
        { "tipe": "paragraph", "text": "$U_{15} = 100 + 14 \\cdot (-5) = 100 - 70 = 30$" }
