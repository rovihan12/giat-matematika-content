      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1458$" } ],
        [ { "tipe": "paragraph", "text": "$2916$" } ],
        [ { "tipe": "paragraph", "text": "$4374$" } ],
        [ { "tipe": "paragraph", "text": "$8748$" } ],
        [ { "tipe": "paragraph", "text": "$13122$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 2$, $r = 3$" },
        { "tipe": "paragraph", "text": "$U_8 = 2 \\cdot 3^7 = 2 \\cdot 2187 = 4374$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret tak hingga $4 + 2 + 1 + \\dfrac{1}{2} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 4$, $r = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{4}{1 - \\frac{1}{2}} = \\dfrac{4}{\\frac{1}{2}} = 8$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan $1, 4, 9, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$81$" } ],
