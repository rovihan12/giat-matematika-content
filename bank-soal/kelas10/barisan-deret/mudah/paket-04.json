{
  "id": "bs-k10-bd-m-04",
  "nama": "Bank Soal Mudah - Paket 4",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang suku tengah dan aplikasi sederhana",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-20 dari barisan $5, 10, 15, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$95$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$105$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ],
        [ { "tipe": "paragraph", "text": "$115$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 5$) dan beda ($b = 10 - 5 = 5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus suku ke-$n$ barisan aritmatika $U_n = a + (n-1)b$ untuk mencari $U_{20}$." },
        { "tipe": "paragraph", "text": "$U_{20} = 5 + (20 - 1) \\cdot 5 = 5 + 19 \\cdot 5 = 5 + 95 = 100$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-20 adalah $100$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-7 dari barisan geometri $3, 6, 12, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$128$" } ],
        [ { "tipe": "paragraph", "text": "$192$" } ],
        [ { "tipe": "paragraph", "text": "$256$" } ],
        [ { "tipe": "paragraph", "text": "$384$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 3$) dan rasio ($r = \\dfrac{6}{3} = 2$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$ untuk mencari $U_7$." },
        { "tipe": "paragraph", "text": "$U_7 = 3 \\cdot 2^{7-1} = 3 \\cdot 2^6 = 3 \\cdot 64 = 192$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-7 adalah $192$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah dari barisan aritmatika $2, 5, 8, 11, 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Perhatikan jumlah suku pada barisan tersebut yang berjumlah $5$ suku (ganjil)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Suku tengah terletak di posisi ke-$3$ ($U_3$) dari barisan tersebut." },
        { "tipe": "paragraph", "text": "$U_3 = 8$" },
        { "tipe": "paragraph", "text": "Jadi, suku tengahnya adalah $8$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-15 dari barisan $100, 95, 90, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 100$) dan beda ($b = 95 - 100 = -5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus $U_n = a + (n-1)b$ untuk mencari $U_{15}$." },
        { "tipe": "paragraph", "text": "$U_{15} = 100 + (15 - 1) \\cdot (-5) = 100 + 14 \\cdot (-5) = 100 - 70 = 30$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-15 adalah $30$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 20 suku pertama deret $1 + 2 + 3 + 4 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$190$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ],
        [ { "tipe": "paragraph", "text": "$210$" } ],
        [ { "tipe": "paragraph", "text": "$220$" } ],
        [ { "tipe": "paragraph", "text": "$230$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus jumlah deret bilangan asli $S_n = \\dfrac{n(n+1)}{2}$ dengan $n = 20$." },
        { "tipe": "paragraph", "text": "$S_{20} = \\dfrac{20(20 + 1)}{2} = \\dfrac{20 \\cdot 21}{2} = 10 \\cdot 21 = 210$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah 20 suku pertama adalah $210$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan geometri $2, 6, 18, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1458$" } ],
        [ { "tipe": "paragraph", "text": "$2916$" } ],
        [ { "tipe": "paragraph", "text": "$4374$" } ],
        [ { "tipe": "paragraph", "text": "$8748$" } ],
        [ { "tipe": "paragraph", "text": "$13122$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 2$) dan rasio ($r = \\dfrac{6}{2} = 3$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus $U_n = a \\cdot r^{n-1}$ untuk mencari suku ke-8." },
        { "tipe": "paragraph", "text": "$U_8 = 2 \\cdot 3^{8-1} = 2 \\cdot 3^7 = 2 \\cdot 2187 = 4374$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-8 adalah $4374$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret tak hingga $4 + 2 + 1 + \\dfrac{1}{2} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 4$) dan rasio ($r = \\dfrac{2}{4} = \\dfrac{1}{2}$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret geometri tak hingga $S_\\infty = \\dfrac{a}{1-r}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{4}{1 - \\dfrac{1}{2}} = \\dfrac{4}{\\dfrac{1}{2}} = 4 \\times 2 = 8$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tak hingga adalah $8$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan $1, 4, 9, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$81$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$121$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Analisis pola barisan yang merupakan barisan kuadrat bilangan asli ($U_n = n^2$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $n = 10$." },
        { "tipe": "paragraph", "text": "$U_{10} = 10^2 = 100$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-10 adalah $100$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Analisis pola barisan bilangan berpola perkalian berurutan $U_n = n(n+1)$." },
        { "tipe": "paragraph", "text": "$U_1 = 1 \\cdot 2 = 2$, $U_2 = 2 \\cdot 3 = 6$, $U_3 = 3 \\cdot 4 = 12$, $U_4 = 4 \\cdot 5 = 20$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung suku ke-5 ($U_5$).rumus $U_5 = 5 \\cdot (5+1) = 5 \\cdot 6 = 30$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-5 adalah $30$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan $2, 3, 5, 8, 12, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Periksa selisih antar suku yang berdekatan:" },
        { "tipe": "paragraph", "text": "$3 - 2 = 1$" },
        { "tipe": "paragraph", "text": "$5 - 3 = 2$" },
        { "tipe": "paragraph", "text": "$8 - 5 = 3$" },
        { "tipe": "paragraph", "text": "$12 - 8 = 4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Pola selisih bertambah $1$ secara konstan, sehingga selisih berikutnya adalah $5$." },
        { "tipe": "paragraph", "text": "$U_6 = 12 + 5 = 17$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-6 adalah $17$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
