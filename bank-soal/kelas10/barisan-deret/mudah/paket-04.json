    },
    {
      "id": "bs-k10-bd-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-15 dari barisan $100, 95, 90, \\ldots$ adalah..." }
      ],
      "pilihan": [
