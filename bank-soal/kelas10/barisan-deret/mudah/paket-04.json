        [ { "tipe": "paragraph", "text": "$121$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Barisan ini adalah kuadrat bilangan asli: $U_n = n^2$." },
        { "tipe": "paragraph", "text": "$U_{10} = 10^2 = 100$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q09",
