{
  "id": "bs-k10-bd-m-04",
  "nama": "Bank Soal Mudah - Paket 4",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang suku tengah dan aplikasi sederhana",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-20 dari barisan $5, 10, 15, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$95$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$105$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ],
        [ { "tipe": "paragraph", "text": "$115$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 5$) dan beda ($b = 10 - 5 = 5$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_{20}$ menggunakan rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_{20} = 5 + (20 - 1) \\cdot 5 = 5 + 19 \\cdot 5 = 5 + 95 = 100" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-20 barisan tersebut adalah **$100$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-7 dari barisan geometri $3, 6, 12, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$128$" } ],
        [ { "tipe": "paragraph", "text": "$192$" } ],
        [ { "tipe": "paragraph", "text": "$256$" } ],
        [ { "tipe": "paragraph", "text": "$384$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 3$) dan rasio ($r = \\dfrac{6}{3} = 2$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_7$ menggunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "formula_block", "latex": "U_7 = 3 \\cdot 2^{7-1} = 3 \\cdot 2^6 = 3 \\cdot 64 = 192" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-7 barisan geometri tersebut adalah **$192$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku tengah dari barisan aritmatika $2, 5, 8, 11, 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "Tidak ada" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan posisi suku tengah dari barisan ganjil ($5$ suku)**" },
        { "tipe": "paragraph", "text": "Pada barisan $2, 5, 8, 11, 14$, suku tengah berada di urutan ke-$3$ ($U_3$)." },
        { "tipe": "formula_block", "latex": "U_3 = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku tengah barisan aritmatika tersebut adalah **$8$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-15 dari barisan $100, 95, 90, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 100$) dan beda ($b = 95 - 100 = -5$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_{15}$ menggunakan rumus $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_{15} = 100 + (15 - 1) \\cdot (-5) = 100 + 14 \\cdot (-5) = 100 - 70 = 30" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-15 barisan tersebut adalah **$30$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 20 suku pertama deret $1 + 2 + 3 + 4 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$190$" } ],
        [ { "tipe": "paragraph", "text": "$200$" } ],
        [ { "tipe": "paragraph", "text": "$210$" } ],
        [ { "tipe": "paragraph", "text": "$220$" } ],
        [ { "tipe": "paragraph", "text": "$230$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jumlah $n$ bilangan asli pertama $S_n = \\dfrac{n(n + 1)}{2}$**" },
        { "tipe": "paragraph", "text": "Substitusikan $n = 20$ ke dalam rumus." },
        { "tipe": "formula_block", "latex": "S_{20} = \\dfrac{20(20 + 1)}{2} = \\dfrac{20 \\cdot 21}{2} = 10 \\cdot 21 = 210" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $20$ suku pertama deret tersebut adalah **$210$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan geometri $2, 6, 18, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1458$" } ],
        [ { "tipe": "paragraph", "text": "$2916$" } ],
        [ { "tipe": "paragraph", "text": "$4374$" } ],
        [ { "tipe": "paragraph", "text": "$8748$" } ],
        [ { "tipe": "paragraph", "text": "$13122$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 2$) dan rasio ($r = \\dfrac{6}{2} = 3$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_8$ menggunakan rumus $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "formula_block", "latex": "U_8 = 2 \\cdot 3^{8-1} = 2 \\cdot 3^7 = 2 \\cdot 2187 = 4374" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-8 barisan geometri tersebut adalah **$4374$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah deret tak hingga $4 + 2 + 1 + \\dfrac{1}{2} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 4$) dan rasio ($r = \\dfrac{2}{4} = \\dfrac{1}{2}$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_{\\infty}$ menggunakan rumus jumlah deret geometri tak hingga $S_{\\infty} = \\dfrac{a}{1 - r}$." },
        { "tipe": "formula_block", "latex": "S_{\\infty} = \\dfrac{4}{1 - \\dfrac{1}{2}} = \\dfrac{4}{\\dfrac{1}{2}} = 4 \\times 2 = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah deret geometri tak hingga tersebut adalah **$8$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan $1, 4, 9, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$81$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$121$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kenali pola kuadrat bilangan asli $U_n = n^2$**" },
        { "tipe": "paragraph", "text": "Substitusikan $n = 10$ ke dalam rumus pola tersebut." },
        { "tipe": "formula_block", "latex": "U_{10} = 10^2 = 100" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-10 barisan tersebut adalah **$100$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kenali pola perkalian dua bilangan berurutan $U_n = n(n + 1)$**" },
        { "tipe": "formula_block", "latex": "U_1 = 1 \\cdot 2 = 2, \\quad U_2 = 2 \\cdot 3 = 6, \\quad U_3 = 3 \\cdot 4 = 12, \\quad U_4 = 4 \\cdot 5 = 20" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung suku ke-5 ($U_5$)**" },
        { "tipe": "formula_block", "latex": "U_5 = 5 \\cdot (5 + 1) = 5 \\cdot 6 = 30" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 barisan tersebut adalah **$30$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan $2, 3, 5, 8, 12, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$23$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan pola selisih antar suku yang berdekatan**" },
        { "tipe": "formula_block", "latex": "3 - 2 = 1, \\quad 5 - 3 = 2, \\quad 8 - 5 = 3, \\quad 12 - 8 = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tambahkan selisih berikutnya ($5$) ke suku ke-5 ($12$)**" },
        { "tipe": "formula_block", "latex": "U_6 = 12 + 5 = 17" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-6 barisan tersebut adalah **$17$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
