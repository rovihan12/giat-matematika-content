      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 3$), beda ($b = 7 - 3 = 4$), dan banyaknya suku ($n = 6$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$." },
        { "tipe": "formula_block", "latex": "S_6 = \\dfrac{6}{2}\\left(2(3) + (6 - 1)4\\right) = 3(6 + 20) = 3 \\cdot 26 = 78" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $6$ suku pertama deret tersebut adalah **$78$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
