  "soal": [
    {
      "id": "bs-k10-bd-m-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 10 suku pertama dari deret $1 + 3 + 5 + 7 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 1$, $b = 2$, $n = 10$" },
        { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(2a + (n-1)b) = \\dfrac{10}{2}(2 + 18) = 5 \\cdot 20 = 100$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 5 suku pertama dari deret $2 + 4 + 6 + 8 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$S_5 = 2+4+6+8+10 = 30$" },
        { "tipe": "paragraph", "text": "Atau rumus: $S_5 = \\dfrac{5}{2}(2 \\cdot 2 + 4 \\cdot 2) = \\dfrac{5}{2}(12) = 30$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus jumlah $n$ suku pertama deret aritmatika adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(2a + (n-1)b)$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{a(r^n - 1)}{r-1}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = n \\cdot a$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = a + (n-1)b$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(a + b)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus jumlah $n$ suku pertama deret aritmatika: $S_n = \\dfrac{n}{2}(2a + (n-1)b)$" },
        { "tipe": "paragraph", "text": "Bentuk alternatif: $S_n = \\dfrac{n}{2}(a + U_n)$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 6 suku pertama dari deret $3 + 7 + 11 + \\ldots$ adalah..." }
