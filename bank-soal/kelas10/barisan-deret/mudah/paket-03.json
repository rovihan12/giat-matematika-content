    {
      "id": "bs-k10-bd-m-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret tak hingga $1 + \\dfrac{1}{2} + \\dfrac{1}{4} + \\ldots$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
