    {
      "id": "bs-k10-bd-m-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri dengan rasio $r \\neq 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{a(r^n - 1)}{r-1}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(2a + (n-1)b)$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = ar^{n-1}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{a}{1-r}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = a \\cdot n$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Identifikasi bentuk rumus baku jumlah $n$ suku pertama ($S_n$) pada deret geometri untuk $r > 1$." },
        { "tipe": "paragraph", "text": "Rumusnya adalah $S_n = \\dfrac{a(r^n - 1)}{r-1}$." },
        { "tipe": "paragraph", "text": "Jadi, jawaban yang benar adalah $S_n = \\dfrac{a(r^n - 1)}{r-1}$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 5 suku pertama deret geometri $2 + 6 + 18 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$196$" } ],
        [ { "tipe": "paragraph", "text": "$212$" } ],
        [ { "tipe": "paragraph", "text": "$242$" } ],
        [ { "tipe": "paragraph", "text": "$256$" } ],
        [ { "tipe": "paragraph", "text": "$272$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 2$), rasio ($r = \\dfrac{6}{2} = 3$), dan banyaknya suku ($n = 5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah $n$ suku pertama deret geometri $S_n = \\dfrac{a(r^n - 1)}{r-1}$." },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{2(3^5 - 1)}{3 - 1} = \\dfrac{2(243 - 1)}{2} = 243 - 1 = 242$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah 5 suku pertama adalah $242$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 8 suku pertama deret $2 + 5 + 8 + 11 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$104$" } ],
        [ { "tipe": "paragraph", "text": "$108$" } ],
        [ { "tipe": "paragraph", "text": "$112$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 2$), beda ($b = 5 - 2 = 3$), dan banyaknya suku ($n = 8$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus $S_n = \\dfrac{n}{2}(2a + (n-1)b)$." },
        { "tipe": "paragraph", "text": "$S_8 = \\dfrac{8}{2}(2(2) + (8-1)3) = 4(4 + 7(3)) = 4(4 + 21) = 4 \\cdot 25 = 100$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah 8 suku pertama adalah $100$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 3 suku pertama deret geometri $3 + 9 + 27$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$39$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
