    {
      "id": "bs-k10-bd-m-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Deret tak hingga $1 + \\dfrac{1}{2} + \\dfrac{1}{4} + \\ldots$ memiliki jumlah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 1$) dan rasio ($r = \\dfrac{1}{2}$) dari deret geometri tak hingga tersebut." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret geometri tak hingga $S_\\infty = \\dfrac{a}{1-r}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{1}{1 - \\dfrac{1}{2}} = \\dfrac{1}{\\dfrac{1}{2}} = 2$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah deret tak hingga tersebut adalah $2$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
