  "deskripsi": "Soal mudah tentang jumlah deret aritmatika dan geometri",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 10 suku pertama dari deret $1 + 3 + 5 + 7 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$110$" } ],
        [ { "tipe": "paragraph", "text": "$120$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 1$), beda ($b = 3 - 1 = 2$), dan banyaknya suku ($n = 10$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah $n$ suku pertama deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n-1)b)$." },
        { "tipe": "paragraph", "text": "$S_{10} = \\dfrac{10}{2}(2(1) + (10-1)2) = 5(2 + 18) = 5 \\cdot 20 = 100$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah 10 suku pertama adalah $100$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 5 suku pertama dari deret $2 + 4 + 6 + 8 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 2$), beda ($b = 4 - 2 = 2$), dan banyaknya suku ($n = 5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah $n$ suku pertama deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n-1)b)$." },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{5}{2}(2(2) + (5-1)2) = \\dfrac{5}{2}(4 + 8) = \\dfrac{5}{2}(12) = 30$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah 5 suku pertama adalah $30$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus jumlah $n$ suku pertama deret aritmatika adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(2a + (n-1)b)$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{a(r^n - 1)}{r-1}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = n \\cdot a$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = a + (n-1)b$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(a + b)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Identifikasi bentuk rumus baku jumlah $n$ suku pertama ($S_n$) pada deret aritmatika." },
        { "tipe": "paragraph", "text": "Rumusnya adalah $S_n = \\dfrac{n}{2}(2a + (n-1)b)$." },
        { "tipe": "paragraph", "text": "Jadi, jawaban yang benar adalah $S_n = \\dfrac{n}{2}(2a + (n-1)b)$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 6 suku pertama dari deret $3 + 7 + 11 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$78$" } ],
        [ { "tipe": "paragraph", "text": "$82$" } ],
        [ { "tipe": "paragraph", "text": "$84$" } ],
        [ { "tipe": "paragraph", "text": "$88$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 3$), beda ($b = 7 - 3 = 4$), dan banyaknya suku ($n = 6$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Masukkan nilai ke dalam rumus $S_n = \\dfrac{n}{2}(2a + (n-1)b)$." },
        { "tipe": "paragraph", "text": "$S_6 = \\dfrac{6}{2}(2(3) + (6-1)4) = 3(6 + 5(4)) = 3(6 + 20) = 3 \\cdot 26 = 78$" },
        { "tipe": "paragraph", "text": "Jadi, jumlah 6 suku pertama adalah $78$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 4 suku pertama deret geometri $1 + 2 + 4 + 8$ adalah..." }
