        [ { "tipe": "paragraph", "text": "$S_n = ar^{n-1}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{a}{1-r}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = a \\cdot n$" } ]
