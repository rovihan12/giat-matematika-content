      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus jumlah $n$ suku pertama deret geometri: $S_n = \\dfrac{a(r^n - 1)}{r-1}$ (untuk $r \\neq 1$)." }
