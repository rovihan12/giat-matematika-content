    },
    {
      "id": "bs-k10-bd-m-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah $n$ suku pertama deret geometri dengan rasio $r \\neq 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{a(r^n - 1)}{r-1}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{n}{2}(2a + (n-1)b)$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = ar^{n-1}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = \\dfrac{a}{1-r}$" } ],
        [ { "tipe": "paragraph", "text": "$S_n = a \\cdot n$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi rumus baku jumlah $n$ suku pertama ($S_n$) deret geometri**" },
        { "tipe": "formula_block", "latex": "S_n = \\dfrac{a(r^n - 1)}{r - 1}, \\qquad r \\neq 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus jumlah $n$ suku pertama deret geometri dengan rasio $r \\neq 1$ adalah **$S_n = \\dfrac{a(r^n - 1)}{r-1}$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-03-q07",
      "pertanyaan": [
