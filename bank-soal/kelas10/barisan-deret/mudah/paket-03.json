      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 2$), rasio ($r = \\dfrac{6}{2} = 3$), dan banyaknya suku ($n = 5$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_5$ menggunakan rumus $S_n = \\dfrac{a(r^n - 1)}{r - 1}$." },
        { "tipe": "formula_block", "latex": "S_5 = \\dfrac{2(3^5 - 1)}{3 - 1} = \\dfrac{2(243 - 1)}{2} = 243 - 1 = 242" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $5$ suku pertama deret geometri tersebut adalah **$242$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
