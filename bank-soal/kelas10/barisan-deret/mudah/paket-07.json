  "deskripsi": "Soal mudah tentang suku ke-n, jumlah deret, dan pola bilangan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $7, 12, 17, 22, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan beda ($b$) barisan aritmatika**" },
        { "tipe": "formula_block", "latex": "b = 12 - 7 = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tambahkan beda ke suku terakhir ($22$) untuk mendapatkan suku berikutnya**" },
        { "tipe": "formula_block", "latex": "U_5 = 22 + 5 = 27" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku berikutnya dari barisan tersebut adalah **$27$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $2, 6, 18, 54, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$108$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ],
        [ { "tipe": "paragraph", "text": "$162$" } ],
        [ { "tipe": "paragraph", "text": "$216$" } ],
        [ { "tipe": "paragraph", "text": "$324$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rasio ($r$) barisan geometri**" },
        { "tipe": "formula_block", "latex": "r = \\dfrac{6}{2} = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan suku terakhir ($54$) dengan rasio untuk mendapatkan suku berikutnya**" },
        { "tipe": "formula_block", "latex": "U_5 = 54 \\times 3 = 162" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku berikutnya dari barisan tersebut adalah **$162$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan aritmatika $2, 6, 10, 14, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 2$) dan beda ($b = 6 - 2 = 4$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_{10}$ menggunakan rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_{10} = 2 + (10 - 1) \\cdot 4 = 2 + 9 \\cdot 4 = 2 + 36 = 38" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-10 barisan aritmatika tersebut adalah **$38$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-4 dari barisan geometri $5, 10, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 5$) dan rasio ($r = \\dfrac{10}{5} = 2$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_4$ menggunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "formula_block", "latex": "U_4 = 5 \\cdot 2^{4-1} = 5 \\cdot 2^3 = 5 \\cdot 8 = 40" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-4 barisan geometri tersebut adalah **$40$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $9, 13, 17, 21, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n - 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 9$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 9n + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 9$) dan beda ($b = 13 - 9 = 4$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_n = 9 + (n - 1) \\cdot 4 = 9 + 4n - 4 = 4n + 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = 4n + 5$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 5 suku pertama deret $3 + 6 + 9 + 12 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 3$), beda ($b = 3$), dan banyaknya suku ($n = 5$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_5$ menggunakan rumus jumlah deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$." },
        { "tipe": "formula_block", "latex": "S_5 = \\dfrac{5}{2}\\left(2(3) + (5 - 1)3\\right) = \\dfrac{5}{2}(6 + 12) = \\dfrac{5}{2} \\cdot 18 = 5 \\cdot 9 = 45" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $5$ suku pertama deret tersebut adalah **$45$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 4 suku pertama deret geometri $2 + 6 + 18 + 54$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$85$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jumlahkan keempat suku pada deret geometri tersebut**" },
        { "tipe": "formula_block", "latex": "S_4 = 2 + 6 + 18 + 54 = 80" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $4$ suku pertama deret geometri tersebut adalah **$80$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-7 dari barisan $3, 5, 7, 9, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 3$) dan beda ($b = 5 - 3 = 2$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_7$ menggunakan rumus $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_7 = 3 + (7 - 1) \\cdot 2 = 3 + 6 \\cdot 2 = 3 + 12 = 15" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-7 barisan tersebut adalah **$15$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kenali pola perkalian dua bilangan berurutan $U_n = n(n + 1)$**" },
        { "tipe": "paragraph", "text": "Substitusikan $n = 6$ ke dalam rumus pola tersebut." },
        { "tipe": "formula_block", "latex": "U_6 = 6 \\cdot (6 + 1) = 6 \\cdot 7 = 42" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-6 barisan tersebut adalah **$42$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $9 + 3 + 1 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{29}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 9$) dan rasio ($r = \\dfrac{3}{9} = \\dfrac{1}{3}$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_{\\infty}$ menggunakan rumus jumlah deret geometri tak hingga $S_{\\infty} = \\dfrac{a}{1 - r}$." },
        { "tipe": "formula_block", "latex": "S_{\\infty} = \\dfrac{9}{1 - \\dfrac{1}{3}} = \\dfrac{9}{\\dfrac{2}{3}} = 9 \\times \\dfrac{3}{2} = \\dfrac{27}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah tak hingga deret geometri tersebut adalah **$\\dfrac{27}{2}$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
