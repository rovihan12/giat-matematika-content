{
  "id": "bs-k10-bd-m-07",
  "nama": "Bank Soal Mudah - Paket 7",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang suku ke-n, jumlah deret, dan pola bilangan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-07-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $7, 12, 17, 22, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan beda ($b$) dengan mengurangkan suku kedua dengan suku pertama ($12 - 7 = 5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tambahkan beda ke suku terakhir yang diketahui ($22 + 5 = 27$)." },
        { "tipe": "paragraph", "text": "Jadi, suku berikutnya adalah $27$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $2, 6, 18, 54, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$108$" } ],
        [ { "tipe": "paragraph", "text": "$144$" } ],
        [ { "tipe": "paragraph", "text": "$162$" } ],
        [ { "tipe": "paragraph", "text": "$216$" } ],
        [ { "tipe": "paragraph", "text": "$324$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan rasio ($r$) dengan membagi suku kedua dengan suku pertama ($\\dfrac{6}{2} = 3$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan suku terakhir dengan rasio ($54 \\times 3 = 162$)." },
        { "tipe": "paragraph", "text": "Jadi, suku berikutnya adalah $162$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan aritmatika $2, 6, 10, 14, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$38$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 2$) dan beda ($b = 6 - 2 = 4$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Masukkan ke dalam rumus suku ke-$n$ barisan aritmatika $U_n = a + (n-1)b$." },
        { "tipe": "paragraph", "text": "$U_{10} = 2 + (10 - 1) \\cdot 4 = 2 + 9 \\cdot 4 = 2 + 36 = 38$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-10 adalah $38$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-4 dari barisan geometri $5, 10, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 5$) dan rasio ($r = \\dfrac{10}{5} = 2$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Masukkan ke dalam rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "paragraph", "text": "$U_4 = 5 \\cdot 2^{4-1} = 5 \\cdot 2^3 = 5 \\cdot 8 = 40$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-4 adalah $40$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $9, 13, 17, 21, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n - 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 9$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 9n + 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 9$) dan beda ($b = 13 - 9 = 4$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $a$ dan $b$ ke dalam rumus $U_n = a + (n-1)b$." },
        { "tipe": "paragraph", "text": "$U_n = 9 + (n-1) \\cdot 4 = 9 + 4n - 4 = 4n + 5$." },
        { "tipe": "paragraph", "text": "Jadi, rumus suku ke-$n$ adalah $U_n = 4n + 5$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 5 suku pertama deret $3 + 6 + 9 + 12 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 3$), beda ($b = 3$), dan banyaknya suku ($n = 5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n-1)b)$." },
        { "tipe": "paragraph", "text": "$S_5 = \\dfrac{5}{2}(2(3) + (5-1)3) = \\dfrac{5}{2}(6 + 4(3)) = \\dfrac{5}{2}(6 + 12) = \\dfrac{5}{2} \\cdot 18 = 5 \\cdot 9 = 45$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah 5 suku pertama adalah $45$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 4 suku pertama deret geometri $2 + 6 + 18 + 54$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ],
        [ { "tipe": "paragraph", "text": "$85$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan langsung suku-suku yang diketahui karena berjumlah 4 suku." },
        { "tipe": "paragraph", "text": "$S_4 = 2 + 6 + 18 + 54 = 80$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah 4 suku pertama adalah $80$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-7 dari barisan $3, 5, 7, 9, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 3$) dan beda ($b = 5 - 3 = 2$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus $U_n = a + (n-1)b$ untuk mencari $U_7$." },
        { "tipe": "paragraph", "text": "$U_7 = 3 + (7 - 1) \\cdot 2 = 3 + 6 \\cdot 2 = 3 + 12 = 15$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-7 adalah $15$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan $2, 6, 12, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Analisis pola barisan yang merupakan pola perkalian bilangan berurutan $U_n = n(n+1)$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $n = 6$." },
        { "tipe": "paragraph", "text": "$U_6 = 6 \\cdot (6 + 1) = 6 \\cdot 7 = 42$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-6 adalah $42$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-07-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $9 + 3 + 1 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{27}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{25}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{29}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 9$) dan rasio ($r = \\dfrac{3}{9} = \\dfrac{1}{3}$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret geometri tak hingga $S_\\infty = \\dfrac{a}{1-r}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{9}{1 - \\dfrac{1}{3}} = \\dfrac{9}{\\dfrac{2}{3}} = 9 \\times \\dfrac{3}{2} = \\dfrac{27}{2}$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah tak hingga deret tersebut adalah $\\dfrac{27}{2}$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
