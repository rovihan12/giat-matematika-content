{
  "id": "bs-k10-bd-m-08",
  "nama": "Bank Soal Mudah - Paket 8",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang pola, suku ke-n, dan jumlah deret",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-08-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $10, 16, 22, 28, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan beda ($b$) barisan aritmatika**" },
        { "tipe": "formula_block", "latex": "b = 16 - 10 = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tambahkan beda ke suku terakhir ($28$) untuk mendapatkan suku berikutnya**" },
        { "tipe": "formula_block", "latex": "U_5 = 28 + 6 = 34" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku berikutnya dari barisan tersebut adalah **$34$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $64, 32, 16, 8, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan rasio ($r$) barisan geometri**" },
        { "tipe": "formula_block", "latex": "r = \\dfrac{32}{64} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan suku terakhir ($8$) dengan rasio untuk mendapatkan suku berikutnya**" },
        { "tipe": "formula_block", "latex": "U_5 = 8 \\times \\dfrac{1}{2} = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku berikutnya dari barisan tersebut adalah **$4$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-9 dari barisan aritmatika $5, 9, 13, 17, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$37$" } ],
        [ { "tipe": "paragraph", "text": "$39$" } ],
        [ { "tipe": "paragraph", "text": "$41$" } ],
        [ { "tipe": "paragraph", "text": "$43$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 5$) dan beda ($b = 9 - 5 = 4$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_9$ menggunakan rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_9 = 5 + (9 - 1) \\cdot 4 = 5 + 8 \\cdot 4 = 5 + 32 = 37" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-9 barisan aritmatika tersebut adalah **$37$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan geometri $4, 12, 36, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$108$" } ],
        [ { "tipe": "paragraph", "text": "$216$" } ],
        [ { "tipe": "paragraph", "text": "$324$" } ],
        [ { "tipe": "paragraph", "text": "$432$" } ],
        [ { "tipe": "paragraph", "text": "$648$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 4$) dan rasio ($r = \\dfrac{12}{4} = 3$)**" },
        { "tipe": "paragraph", "text": "Hitung $U_5$ menggunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "formula_block", "latex": "U_5 = 4 \\cdot 3^{5-1} = 4 \\cdot 3^4 = 4 \\cdot 81 = 324" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-5 barisan geometri tersebut adalah **$324$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Beda dari barisan aritmatika $20, 14, 8, 2, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-6$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$-5$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$-4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus beda barisan aritmatika $b = U_2 - U_1$**" },
        { "tipe": "formula_block", "latex": "b = 14 - 20 = -6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, beda barisan aritmatika tersebut adalah **$-6$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 8 suku pertama deret $2 + 5 + 8 + 11 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$104$" } ],
        [ { "tipe": "paragraph", "text": "$108$" } ],
        [ { "tipe": "paragraph", "text": "$112$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 2$), beda ($b = 5 - 2 = 3$), dan banyaknya suku ($n = 8$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_8$ menggunakan rumus jumlah deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n - 1)b)$." },
        { "tipe": "formula_block", "latex": "S_8 = \\dfrac{8}{2}\\left(2(2) + (8 - 1)3\\right) = 4(4 + 21) = 4 \\cdot 25 = 100" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $8$ suku pertama deret tersebut adalah **$100$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $5, 10, 15, 20, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 5n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n + 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 5n - 1$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = n + 5$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 10n - 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 5$) dan beda ($b = 10 - 5 = 5$)**" },
        { "tipe": "paragraph", "text": "Substitusikan ke rumus suku ke-$n$ barisan aritmatika $U_n = a + (n - 1)b$." },
        { "tipe": "formula_block", "latex": "U_n = 5 + (n - 1) \\cdot 5 = 5 + 5n - 5 = 5n" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rumus suku ke-$n$ barisan tersebut adalah **$U_n = 5n$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-7 dari barisan $1, 3, 6, 10, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kenali pola bilangan segitiga dengan rumus $U_n = \\dfrac{n(n + 1)}{2}$**" },
        { "tipe": "paragraph", "text": "Substitusikan $n = 7$ ke dalam rumus pola tersebut." },
        { "tipe": "formula_block", "latex": "U_7 = \\dfrac{7(7 + 1)}{2} = \\dfrac{7 \\cdot 8}{2} = 7 \\cdot 4 = 28" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, suku ke-7 barisan tersebut adalah **$28$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 6 suku pertama deret geometri $1 + 2 + 4 + 8 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$63$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$127$" } ],
        [ { "tipe": "paragraph", "text": "$128$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 1$), rasio ($r = 2$), dan banyaknya suku ($n = 6$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_6$ menggunakan rumus jumlah deret geometri $S_n = \\dfrac{a(r^n - 1)}{r - 1}$." },
        { "tipe": "formula_block", "latex": "S_6 = \\dfrac{1(2^6 - 1)}{2 - 1} = \\dfrac{64 - 1}{1} = 63" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah $6$ suku pertama deret geometri tersebut adalah **$63$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-08-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $10 + 5 + \\dfrac{5}{2} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan suku pertama ($a = 10$) dan rasio ($r = \\dfrac{5}{10} = \\dfrac{1}{2}$)**" },
        { "tipe": "paragraph", "text": "Hitung $S_{\\infty}$ menggunakan rumus jumlah deret geometri tak hingga $S_{\\infty} = \\dfrac{a}{1 - r}$." },
        { "tipe": "formula_block", "latex": "S_{\\infty} = \\dfrac{10}{1 - \\dfrac{1}{2}} = \\dfrac{10}{\\dfrac{1}{2}} = 10 \\times 2 = 20" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jumlah tak hingga deret geometri tersebut adalah **$20$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
