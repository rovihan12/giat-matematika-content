{
  "id": "bs-k10-bd-m-09",
  "nama": "Bank Soal Mudah - Paket 9",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang pola barisan, suku ke-n, dan jumlah deret",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-09-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $6, 11, 16, 21, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan beda ($b$) dengan mengurangkan suku kedua dengan suku pertama ($11 - 6 = 5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tambahkan beda ke suku terakhir yang diketahui ($21 + 5 = 26$)." },
        { "tipe": "paragraph", "text": "Jadi, suku berikutnya adalah $26$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $1, 5, 25, 125, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$500$" } ],
        [ { "tipe": "paragraph", "text": "$525$" } ],
        [ { "tipe": "paragraph", "text": "$600$" } ],
        [ { "tipe": "paragraph", "text": "$625$" } ],
        [ { "tipe": "paragraph", "text": "$725$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan rasio ($r$) dengan membagi suku kedua dengan suku pertama ($\\dfrac{5}{1} = 5$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Kalikan suku terakhir dengan rasio ($125 \\times 5 = 625$)." },
        { "tipe": "paragraph", "text": "Jadi, suku berikutnya adalah $625$ (pilihan keempat)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-12 dari barisan aritmatika $3, 7, 11, 15, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$43$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$47$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$51$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 3$) dan beda ($b = 7 - 3 = 4$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Masukkan ke dalam rumus suku ke-$n$ barisan aritmatika $U_n = a + (n-1)b$." },
        { "tipe": "paragraph", "text": "$U_{12} = 3 + (12 - 1) \\cdot 4 = 3 + 11 \\cdot 4 = 3 + 44 = 47$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-12 adalah $47$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-6 dari barisan geometri $2, 4, 8, 16, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$64$" } ],
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$128$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 2$) dan rasio ($r = \\dfrac{4}{2} = 2$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Masukkan ke dalam rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "paragraph", "text": "$U_6 = 2 \\cdot 2^{6-1} = 2 \\cdot 2^5 = 2 \\cdot 32 = 64$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-6 adalah $64$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $7, 11, 15, 19, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n - 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 7n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 7$) dan beda ($b = 11 - 7 = 4$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $a$ dan $b$ ke dalam rumus $U_n = a + (n-1)b$." },
        { "tipe": "paragraph", "text": "$U_n = 7 + (n-1) \\cdot 4 = 7 + 4n - 4 = 4n + 3$." },
        { "tipe": "paragraph", "text": "Jadi, rumus suku ke-$n$ adalah $U_n = 4n + 3$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 10 suku pertama deret $4 + 8 + 12 + 16 + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$200$" } ],
        [ { "tipe": "paragraph", "text": "$210$" } ],
        [ { "tipe": "paragraph", "text": "$220$" } ],
        [ { "tipe": "paragraph", "text": "$230$" } ],
        [ { "tipe": "paragraph", "text": "$240$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 4$), beda ($b = 4$), dan banyaknya suku ($n = 10$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret aritmatika $S_n = \\dfrac{n}{2}(2a + (n-1)b)$." },
        { "tipe": "paragraph", "text": "$S_{10} = \\dfrac{10}{2}(2(4) + (10-1)4) = 5(8 + 9(4)) = 5(8 + 36) = 5 \\cdot 44 = 220$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah 10 suku pertama adalah $220$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-8 dari barisan $2, 5, 10, 17, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ],
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$72$" } ],
        [ { "tipe": "paragraph", "text": "$82$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Kenali pola barisan yang merupakan penjumlahan kuadrat bilangan dengan $1$ ($U_n = n^2 + 1$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Substitusikan nilai $n = 8$." },
        { "tipe": "paragraph", "text": "$U_8 = 8^2 + 1 = 64 + 1 = 65$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-8 adalah $65$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah 5 suku pertama deret geometri $3 + 6 + 12 + 24 + 48$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$81$" } ],
        [ { "tipe": "paragraph", "text": "$90$" } ],
        [ { "tipe": "paragraph", "text": "$93$" } ],
        [ { "tipe": "paragraph", "text": "$96$" } ],
        [ { "tipe": "paragraph", "text": "$99$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Jumlahkan secara langsung suku-suku yang diketahui karena berjumlah 5 suku." },
        { "tipe": "paragraph", "text": "$S_5 = 3 + 6 + 12 + 24 + 48 = 93$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah 5 suku pertama adalah $93$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-11 dari barisan $1, 4, 7, 10, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 1$) dan beda ($b = 4 - 1 = 3$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus suku ke-$n$ barisan aritmatika $U_n = a + (n-1)b$." },
        { "tipe": "paragraph", "text": "$U_{11} = 1 + (11 - 1) \\cdot 3 = 1 + 10 \\cdot 3 = 1 + 30 = 31$." },
        { "tipe": "paragraph", "text": "Jadi, suku ke-11 adalah $31$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-09-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tak hingga deret geometri $12 + 4 + \\dfrac{4}{3} + \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a = 12$) dan rasio ($r = \\dfrac{4}{12} = \\dfrac{1}{3}$)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Gunakan rumus jumlah deret geometri tak hingga $S_\\infty = \\dfrac{a}{1-r}$." },
        { "tipe": "paragraph", "text": "$S_\\infty = \\dfrac{12}{1 - \\dfrac{1}{3}} = \\dfrac{12}{\\dfrac{2}{3}} = 12 \\times \\dfrac{3}{2} = 18$." },
        { "tipe": "paragraph", "text": "Jadi, jumlah tak hingga deret tersebut adalah $18$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
