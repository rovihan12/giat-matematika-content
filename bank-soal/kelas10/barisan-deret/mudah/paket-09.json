      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan $7, 11, 15, 19, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n - 3$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 7n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 3n + 4$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = 4n + 7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a = 7$, $b = 4$." },
        { "tipe": "paragraph", "text": "$U_n = 7 + (n-1) \\cdot 4 = 4n + 3$." }
      ],
      "tingkat": "MUDAH"
    },
    {
