      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan aritmatika: $U_n = a + (n-1)b$." },
        { "tipe": "paragraph", "text": "$a$ = suku pertama, $b$ = beda." }
      ],
      "tingkat": "MUDAH"
