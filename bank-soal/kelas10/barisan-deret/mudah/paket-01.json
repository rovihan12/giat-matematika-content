{
  "id": "bs-k10-bd-m-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 10,
  "kategori": "Barisan dan Deret",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang pola barisan dan suku berikutnya",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-bd-m-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $2, 5, 8, 11, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan pola atau beda antar suku yang berdekatan dengan mengurangkan suku sesudahnya dengan suku sebelumnya." },
        { "tipe": "paragraph", "text": "Beda ($b$) = $5 - 2 = 3$ (karena selisihnya selalu tetap, barisan ini merupakan barisan aritmatika)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan suku berikutnya dengan menambahkan beda ke suku terakhir yang diketahui." },
        { "tipe": "paragraph", "text": "Suku berikutnya = $11 + 3 = 14$" },
        { "tipe": "paragraph", "text": "Jadi, suku berikutnya adalah $14$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku berikutnya dari barisan $3, 6, 12, 24, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan rasio antar suku yang berdekatan dengan membagi suku sesudahnya dengan suku sebelumnya." },
        { "tipe": "paragraph", "text": "Rasio ($r$) = $\\dfrac{6}{3} = 2$ (karena perbandingannya selalu tetap, barisan ini merupakan barisan geometri)." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Tentukan suku berikutnya dengan mengalikan suku terakhir dengan rasio." },
        { "tipe": "paragraph", "text": "Suku berikutnya = $24 \\times 2 = 48$" },
        { "tipe": "paragraph", "text": "Jadi, suku berikutnya adalah $48$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Barisan $1, 4, 7, 10, \\ldots$ merupakan barisan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Geometri" } ],
        [ { "tipe": "paragraph", "text": "Aritmatika" } ],
        [ { "tipe": "paragraph", "text": "Harmonik" } ],
        [ { "tipe": "paragraph", "text": "Fibonacci" } ],
        [ { "tipe": "paragraph", "text": "Bertingkat" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Periksa selisih antar suku yang berdekatan." },
        { "tipe": "paragraph", "text": "$4 - 1 = 3$" },
        { "tipe": "paragraph", "text": "$7 - 4 = 3$" },
        { "tipe": "paragraph", "text": "$10 - 7 = 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Karena selisih (beda) antar suku selalu bernilai konstan yaitu $3$, maka barisan tersebut adalah barisan aritmatika." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah Aritmatika (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Beda dari barisan aritmatika $5, 9, 13, 17, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus beda barisan aritmatika $b = U_2 - U_1$." },
        { "tipe": "paragraph", "text": "$b = 9 - 5 = 4$" },
        { "tipe": "paragraph", "text": "Jadi, beda dari barisan tersebut adalah $4$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rasio dari barisan geometri $2, 6, 18, 54, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus rasio barisan geometri $r = \\dfrac{U_2}{U_1}$." },
        { "tipe": "paragraph", "text": "$r = \\dfrac{6}{2} = 3$" },
        { "tipe": "paragraph", "text": "Jadi, rasio dari barisan tersebut adalah $3$ (pilihan kedua)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rumus suku ke-$n$ barisan aritmatika adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$U_n = a + (n-1)b$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = a \\cdot r^{n-1}$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = a + nb$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = a \\cdot r^n$" } ],
        [ { "tipe": "paragraph", "text": "$U_n = \\dfrac{n}{2}(2a + (n-1)b)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Identifikasi bentuk umum rumus suku ke-$n$ pada barisan aritmatika." },
        { "tipe": "paragraph", "text": "Rumusnya adalah $U_n = a + (n-1)b$, dengan $a$ adalah suku pertama dan $b$ adalah beda." },
        { "tipe": "paragraph", "text": "Jadi, jawabannya adalah $U_n = a + (n-1)b$ (pilihan pertama)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan $3, 7, 11, 15, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan nilai suku pertama ($a$) dan beda ($b$). Dari barisan diperoleh $a = 3$ dan $b = 7 - 3 = 4$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Masukkan nilai ke dalam rumus suku ke-$n$ barisan aritmatika $U_n = a + (n-1)b$." },
        { "tipe": "paragraph", "text": "$U_5 = 3 + (5-1) \\cdot 4 = 3 + 4 \\cdot 4 = 3 + 16 = 19$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-5 adalah $19$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-4 dari barisan geometri $2, 4, 8, \\ldots$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Tentukan suku pertama ($a$) dan rasio ($r$). Dari barisan diperoleh $a = 2$ dan $r = \\dfrac{4}{2} = 2$." },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Masukkan nilai ke dalam rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$." },
        { "tipe": "paragraph", "text": "$U_4 = 2 \\cdot 2^{4-1} = 2 \\cdot 2^3 = 2 \\cdot 8 = 16$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-4 adalah $16$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-10 dari barisan aritmatika dengan $a = 4$ dan $b = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$34$" } ],
        [ { "tipe": "paragraph", "text": "$37$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus suku ke-$n$ barisan aritmatika $U_n = a + (n-1)b$ dengan $a = 4$, $b = 3$, dan $n = 10$." },
        { "tipe": "paragraph", "text": "$U_{10} = 4 + (10-1) \\cdot 3$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung nilai operasi hitungnya." },
        { "tipe": "paragraph", "text": "$U_{10} = 4 + 9 \\cdot 3 = 4 + 27 = 31$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-10 adalah $31$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-bd-m-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suku ke-5 dari barisan geometri dengan $a = 1$ dan $r = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$81$" } ],
        [ { "tipe": "paragraph", "text": "$108$" } ],
        [ { "tipe": "paragraph", "text": "$243$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "<strong>Langkah 1:</strong> Gunakan rumus suku ke-$n$ barisan geometri $U_n = a \\cdot r^{n-1}$ dengan $a = 1$, $r = 3$, dan $n = 5$." },
        { "tipe": "paragraph", "text": "$U_5 = 1 \\cdot 3^{5-1} = 1 \\cdot 3^4$" },
        { "tipe": "paragraph", "text": "<strong>Langkah 2:</strong> Hitung hasil pemangkatan." },
        { "tipe": "paragraph", "text": "$U_5 = 1 \\cdot 81 = 81$" },
        { "tipe": "paragraph", "text": "Jadi, suku ke-5 adalah $81$ (pilihan ketiga)." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
