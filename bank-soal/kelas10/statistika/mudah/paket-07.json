      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$52$" } ],
        [ { "tipe": "paragraph", "text": "$54$" } ],
        [ { "tipe": "paragraph", "text": "$56$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{\\sum x_i}{n} \\Rightarrow \\sum x_i = \\bar{x} \\cdot n = 9 \\cdot 6 = 54$" }
