      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata ulangan 24 siswa adalah $75$. Setelah seorang siswa mengikuti ulangan susulan, rata-rata menjadi $76$. Nilai siswa susulan tersebut adalah..." }
