        [ { "tipe": "paragraph", "text": "$101$" } ],
        [ { "tipe": "paragraph", "text": "$102$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah 24 siswa = $24 \\times 75 = 1800$." },
        { "tipe": "paragraph", "text": "Jumlah 25 siswa = $25 \\times 76 = 1900$." },
        { "tipe": "paragraph", "text": "Nilai susulan = $1900 - 1800 = 100$." }
      ],
      "tingkat": "SEDANG"
    },
