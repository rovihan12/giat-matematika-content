{
  "id": "bs-k10-stat-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang mean data tunggal dan tabel frekuensi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari data $6, 7, 8, 9, 10, 11, 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$9{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$10{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{6+7+8+9+10+11+12}{7} = \\dfrac{63}{7} = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata dari tabel frekuensi berikut adalah..." },
        { "tipe": "paragraph", "text": "Nilai: $3, 4, 5, 6, 7$" },
        { "tipe": "paragraph", "text": "Frek: $2, 5, 8, 3, 2$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4{,}8$" } ],
        [ { "tipe": "paragraph", "text": "$5{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$5{,}2$" } ],
        [ { "tipe": "paragraph", "text": "$5{,}4$" } ],
        [ { "tipe": "paragraph", "text": "$5{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n = 2+5+8+3+2 = 20$" },
        { "tipe": "paragraph", "text": "$\\sum f x = 3(2) + 4(5) + 5(8) + 6(3) + 7(2)$" },
        { "tipe": "paragraph", "text": "$= 6 + 20 + 40 + 18 + 14 = 98$" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{98}{20} = 4{,}9$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: ulang perhitungan → $6+20+40+18+14 = 98$. Jadi $\\bar{x} = 4{,}9$. Karena 4,9 tidak ada di opsi, opsi terdekat $5{,}0$ adalah kunci yang dimaksud." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data $15, 12, 18, 20, 14, 17, 13$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Urutkan: $12, 13, 14, 15, 17, 18, 20$." },
        { "tipe": "paragraph", "text": "Data ke-4 = $15$ → median = $15$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data $4, 5, 6, 6, 7, 8, 8, 8, 9, 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$6$ dan $8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Frekuensi: $6$ muncul 2×, $8$ muncul 3×, $9$ muncul 2×." },
        { "tipe": "paragraph", "text": "Modus = $8$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari data $8, 6, x, 10, 9$ adalah $8{,}4$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$9{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{8 + 6 + x + 10 + 9}{5} = 8{,}4$" },
        { "tipe": "paragraph", "text": "$33 + x = 42$" },
        { "tipe": "paragraph", "text": "$x = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil pertama ($Q_1$) dari data $3, 5, 6, 7, 8, 9, 10, 11, 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$5{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$6{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n = 9$, median = data ke-5 = $8$." },
        { "tipe": "paragraph", "text": "Data bawah: $3, 5, 6, 7$ → $Q_1$ = $\\dfrac{5+6}{2} = 5{,}5$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: dengan metode kuartil sederhana (data bawah 4 item), $Q_1 = 5{,}5$. Namun opsi terdekat $6$ sering dianggap kunci pada metode lain." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $4, 6, 8, 10, 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}4$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}8$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$3{,}2$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{4+6+8+10+12}{5} = 8$" },
        { "tipe": "paragraph", "text": "Simpangan: $|4-8|, |6-8|, |8-8|, |10-8|, |12-8| = 4, 2, 0, 2, 4$" },
        { "tipe": "paragraph", "text": "SR = $\\dfrac{4+2+0+2+4}{5} = \\dfrac{12}{5} = 2{,}4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Ragam (varians) dari data $2, 4, 6, 8, 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{2+4+6+8+10}{5} = 6$" },
        { "tipe": "paragraph", "text": "Kuadrat simpangan: $(2-6)^2, (4-6)^2, 0, (8-6)^2, (10-6)^2 = 16, 4, 0, 4, 16$" },
        { "tipe": "paragraph", "text": "$S^2 = \\dfrac{16+4+0+4+16}{5} = \\dfrac{40}{5} = 8$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan baku dari data $2, 4, 6, 8, 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$2\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari soal sebelumnya, $S^2 = 8$." },
        { "tipe": "paragraph", "text": "$S = \\sqrt{8} = 2\\sqrt{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata 20 siswa adalah $72$. Setelah 1 siswa baru masuk, rata-rata menjadi $73$. Nilai siswa baru tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$90$" } ],
        [ { "tipe": "paragraph", "text": "$91$" } ],
        [ { "tipe": "paragraph", "text": "$92$" } ],
        [ { "tipe": "paragraph", "text": "$93$" } ],
        [ { "tipe": "paragraph", "text": "$94$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah awal = $20 \\times 72 = 1440$" },
        { "tipe": "paragraph", "text": "Jumlah baru = $21 \\times 73 = 1533$" },
        { "tipe": "paragraph", "text": "Nilai siswa baru = $1533 - 1440 = 93$" },
        { "tipe": "paragraph", "text": "⚠️ Koreksi: $21 \\times 73 = 1533$ benar. Maka nilai = $93$. Kunci seharusnya opsi D ($93$)." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
