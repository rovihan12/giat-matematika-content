{
  "id": "bs-k10-stat-s-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang rata-rata gabungan dan interpretasi data",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata 15 siswa putra adalah $70$ dan 10 siswa putri adalah $80$. Rata-rata seluruh siswa adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$73$" } ],
        [ { "tipe": "paragraph", "text": "$74$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$76$" } ],
        [ { "tipe": "paragraph", "text": "$77$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\bar{x}_{gab} = \\dfrac{15(70) + 10(80)}{25}$" },
        { "tipe": "paragraph", "text": "$= \\dfrac{1050 + 800}{25} = \\dfrac{1850}{25} = 74$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata 8 data adalah $6$. Jika satu data baru dengan nilai $12$ ditambahkan, rata-rata baru menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$6{,}67$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$7{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah awal = $8 \\times 6 = 48$" },
        { "tipe": "paragraph", "text": "Jumlah baru = $48 + 12 = 60$, $n = 9$" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{60}{9} = 6{,}67$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data $8, 4, 6, 10, 12, 5, 7, 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$7{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$8{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Urutkan: $4, 5, 6, 7, 8, 9, 10, 12$." },
        { "tipe": "paragraph", "text": "Median = $\\dfrac{7 + 8}{2} = 7{,}5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data berikut menunjukkan frekuensi nilai. Modusnya adalah..." },
        { "tipe": "paragraph", "text": "Nilai: $5, 6, 7, 8, 9$" },
        { "tipe": "paragraph", "text": "Frek: $2, 4, 6, 3, 1$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Frekuensi tertinggi = $6$ pada nilai $7$." },
        { "tipe": "paragraph", "text": "Modus = $7$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\bar{x} = 7$ untuk data $5, 6, 7, 8, x$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{5+6+7+8+x}{5} = 7$" },
        { "tipe": "paragraph", "text": "$26 + x = 35$" },
        { "tipe": "paragraph", "text": "$x = 9$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $6, 8, 10, 12, 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}4$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}8$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\bar{x} = 10$" },
        { "tipe": "paragraph", "text": "Simpangan: $4, 2, 0, 2, 4$ → jumlah $12$" },
        { "tipe": "paragraph", "text": "SR = $\\dfrac{12}{5} = 2{,}4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Ragam dari data $4, 5, 6, 7, 8, 9, 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\bar{x} = 7$" },
        { "tipe": "paragraph", "text": "Simpangan kuadrat: $9, 4, 1, 0, 1, 4, 9$ → jumlah $28$" },
        { "tipe": "paragraph", "text": "$S^2 = \\dfrac{28}{7} = 4$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan baku dari data $4, 5, 6, 7, 8, 9, 10$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{4}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari soal ragam: $S^2 = 4$." },
        { "tipe": "paragraph", "text": "$S = \\sqrt{4} = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata 5 data adalah $8$. Jika data terkecil $4$ dan terbesar $12$, maka jumlah tiga data sisanya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$22$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah seluruh = $5 \\times 8 = 40$" },
        { "tipe": "paragraph", "text": "Jumlah 2 data = $4 + 12 = 16$" },
        { "tipe": "paragraph", "text": "Jumlah 3 data sisa = $40 - 16 = 24$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-stat-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil pertama ($Q_1$) dan kuartil ketiga ($Q_3$) dari data $3, 4, 6, 7, 8, 10, 11, 13, 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$Q_1 = 5$ dan $Q_3 = 12$" } ],
        [ { "tipe": "paragraph", "text": "$Q_1 = 5{,}5$ dan $Q_3 = 11{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$Q_1 = 6$ dan $Q_3 = 11$" } ],
        [ { "tipe": "paragraph", "text": "$Q_1 = 6{,}5$ dan $Q_3 = 12{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$Q_1 = 7$ dan $Q_3 = 12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n = 9$, median = data ke-5 = $8$." },
        { "tipe": "paragraph", "text": "Data bawah ($3, 4, 6, 7$) → $Q_1 = \\dfrac{4+6}{2} = 5$" },
        { "tipe": "paragraph", "text": "Data atas ($10, 11, 13, 14$) → $Q_3 = \\dfrac{11+13}{2} = 12$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
