        [ { "tipe": "paragraph", "text": "$\\sqrt{\\dfrac{40}{3}}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{10}$" } ],
        [ { "tipe": "paragraph", "text": "$\\sqrt{12}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan nilai ragam ($S^2$) dari data tersebut**" },
        { "tipe": "paragraph", "text": "Dari perhitungan sebelumnya, ragam data $2, 4, 6, 8, 10, 12$ adalah $S^2 = \\dfrac{35}{3}$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung simpangan baku ($S = \\sqrt{S^2}$)**" },
        { "tipe": "paragraph", "text": "$S = \\sqrt{\\dfrac{35}{3}}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $10-14$, $15-19$, $20-24$, $25-29$" },
        { "tipe": "paragraph", "text": "Frek: $4, 10, 8, 8$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$18{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$19{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$19{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$20{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$20{,}5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak kelas median**" },
        { "tipe": "paragraph", "text": "Jumlah frekuensi $n = 4 + 10 + 8 + 8 = 30$, sehingga letak median berada pada data ke-$\\dfrac{n}{2} = 15$." },
        { "tipe": "paragraph", "text": "Frekuensi kumulatif: $4$ (kelas 1), $14$ (kelas 2), $22$ (kelas 3). Data ke-$15$ berada di kelas ketiga, yaitu interval $20-24$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus median**" },
        { "tipe": "paragraph", "text": "• $L = 20 - 0{,}5 = 19{,}5$" },
        { "tipe": "paragraph", "text": "• $f_k = 14$" },
        { "tipe": "paragraph", "text": "• $f_m = 8$" },
        { "tipe": "paragraph", "text": "• $c = 5$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai median ($Me$)**" },
        { "tipe": "paragraph", "text": "$Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$Me = 19{,}5 + \\left(\\dfrac{15 - 14}{8}\\right) \\cdot 5 = 19{,}5 + 0{,}625 = 20{,}125$." },
        { "tipe": "paragraph", "text": "Nilai pada pilihan yang paling mendekati adalah $20{,}0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jangkauan interkuartil dari data $5, 8, 10, 12, 15, 18, 20, 22$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
