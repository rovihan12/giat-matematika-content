  "deskripsi": "Soal sulit tentang ukuran penyebaran data berkelompok dan analisis lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $30-39$, $40-49$, $50-59$, $60-69$" },
        { "tipe": "paragraph", "text": "Frek: $6, 10, 14, 10$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$52{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$53{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$53{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$54{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$54{,}5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak kelas median**" },
        { "tipe": "paragraph", "text": "Jumlah frekuensi $n = 6 + 10 + 14 + 10 = 40$, sehingga letak median berada pada data ke-$\\dfrac{n}{2} = \\dfrac{40}{2} = 20$." },
        { "tipe": "paragraph", "text": "Frekuensi kumulatif: $6$ (kelas 1), $16$ (kelas 2), $30$ (kelas 3). Data ke-$20$ berada di kelas ketiga, yaitu interval $50-59$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus median**" },
        { "tipe": "paragraph", "text": "• Tepi bawah kelas median ($L$) $= 50 - 0{,}5 = 49{,}5$" },
        { "tipe": "paragraph", "text": "• Frekuensi kumulatif sebelum kelas median ($f_k$) $= 16$" },
        { "tipe": "paragraph", "text": "• Frekuensi kelas median ($f_m$) $= 14$" },
        { "tipe": "paragraph", "text": "• Panjang kelas ($c$) $= 10$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai median ($Me$)**" },
        { "tipe": "paragraph", "text": "$Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$Me = 49{,}5 + \\left(\\dfrac{20 - 16}{14}\\right) \\cdot 10 = 49{,}5 + \\dfrac{40}{14} \\approx 49{,}5 + 2{,}86 = 52{,}36$." },
        { "tipe": "paragraph", "text": "Dari pilihan yang tersedia, nilai yang paling mendekati adalah $52{,}5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $20-24$, $25-29$, $30-34$, $35-39$, $40-44$" },
        { "tipe": "paragraph", "text": "Frek: $4, 8, 15, 9, 4$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$31{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$31{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$32{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$32{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$33{,}0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan kelas modus**" },
        { "tipe": "paragraph", "text": "Frekuensi tertinggi adalah $15$, sehingga kelas modusnya adalah interval $30-34$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus modus**" },
        { "tipe": "paragraph", "text": "• $L = 30 - 0{,}5 = 29{,}5$" },
        { "tipe": "paragraph", "text": "• $d_1 = 15 - 8 = 7$" },
        { "tipe": "paragraph", "text": "• $d_2 = 15 - 9 = 6$" },
        { "tipe": "paragraph", "text": "• $c = 5$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai modus ($Mo$)**" },
        { "tipe": "paragraph", "text": "$Mo = L + \\left(\\dfrac{d_1}{d_1 + d_2}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$Mo = 29{,}5 + \\left(\\dfrac{7}{7 + 6}\\right) \\cdot 5 = 29{,}5 + \\dfrac{35}{13} \\approx 29{,}5 + 2{,}69 = 32{,}19$." },
        { "tipe": "paragraph", "text": "Pembulatan terdekat pada pilihan adalah $32{,}0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari tabel distribusi berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $60-64$ ($f=2$), $65-69$ ($f=5$), $70-74$ ($f=8$), $75-79$ ($f=5$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$70{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$71{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$71{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$72{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$72{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah data ($n$) dan titik tengah ($x_i$) tiap interval**" },
        { "tipe": "paragraph", "text": "• $n = 2 + 5 + 8 + 5 = 20$" },
        { "tipe": "paragraph", "text": "• Titik tengah ($x_i$): $62$, $67$, $72$, dan $77$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah perkalian frekuensi dan titik tengah ($\\sum f_i \\cdot x_i$)**" },
        { "tipe": "paragraph", "text": "• $2 \\times 62 = 124$" },
        { "tipe": "paragraph", "text": "• $5 \\times 67 = 335$" },
        { "tipe": "paragraph", "text": "• $8 \\times 72 = 576$" },
        { "tipe": "paragraph", "text": "• $5 \\times 77 = 385$" },
        { "tipe": "paragraph", "text": "$\\sum f_i \\cdot x_i = 124 + 335 + 576 + 385 = 1.420$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung rata-rata ($\\bar{x}$)**" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{\\sum f_i \\cdot x_i}{n} = \\dfrac{1.420}{20} = 71{,}0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Desil ke-3 ($D_3$) dari data $n = 50$ berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $20-29$, $30-39$, $40-49$, $50-59$, $60-69$" },
        { "tipe": "paragraph", "text": "Frek: $5, 12, 15, 10, 8$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$33{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$34{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$35{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$36{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$37{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak kelas desil ke-3 ($D_3$)**" },
        { "tipe": "paragraph", "text": "Letak $D_3$ berada pada data ke-$\\dfrac{3}{10} n = \\dfrac{3}{10} \\times 50 = 15$." },
        { "tipe": "paragraph", "text": "Frekuensi kumulatif: $5$ (kelas 1), $17$ (kelas 2). Data ke-$15$ berada di kelas kedua, yaitu interval $30-39$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus $D_3$**" },
        { "tipe": "paragraph", "text": "• $L = 30 - 0{,}5 = 29{,}5$" },
        { "tipe": "paragraph", "text": "• $f_k = 5$" },
        { "tipe": "paragraph", "text": "• $f_{D_3} = 12$" },
        { "tipe": "paragraph", "text": "• $c = 10$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $D_3$**" },
        { "tipe": "paragraph", "text": "$D_3 = L + \\left(\\dfrac{\\frac{3}{10}n - f_k}{f_{D_3}}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$D_3 = 29{,}5 + \\left(\\dfrac{15 - 5}{12}\\right) \\cdot 10 = 29{,}5 + \\dfrac{100}{12} \\approx 29{,}5 + 8{,}33 = 37{,}83$." },
        { "tipe": "paragraph", "text": "Nilai pada pilihan yang paling mendekati adalah $37{,}5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $10, 12, 14, 16, 18, 20$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$3{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$)**" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{10 + 12 + 14 + 16 + 18 + 20}{6} = \\dfrac{90}{6} = 15$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah nilai mutlak simpangan $|x_i - \\bar{x}|$**" },
        { "tipe": "paragraph", "text": "• $|10 - 15| = 5$" },
        { "tipe": "paragraph", "text": "• $|12 - 15| = 3$" },
        { "tipe": "paragraph", "text": "• $|14 - 15| = 1$" },
        { "tipe": "paragraph", "text": "• $|16 - 15| = 1$" },
        { "tipe": "paragraph", "text": "• $|18 - 15| = 3$" },
        { "tipe": "paragraph", "text": "• $|20 - 15| = 5$" },
        { "tipe": "paragraph", "text": "Jumlah simpangan $= 5 + 3 + 1 + 1 + 3 + 5 = 18$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung simpangan rata-rata ($SR$)**" },
        { "tipe": "paragraph", "text": "$SR = \\dfrac{\\sum |x_i - \\bar{x}|}{n} = \\dfrac{18}{6} = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Ragam dari data $2, 4, 6, 8, 10, 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{40}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{70}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$)**" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{2 + 4 + 6 + 8 + 10 + 12}{6} = \\dfrac{42}{6} = 7$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah kuadrat simpangan $\\sum (x_i - \\bar{x})^2$**" },
        { "tipe": "paragraph", "text": "• $(2 - 7)^2 = (-5)^2 = 25$" },
        { "tipe": "paragraph", "text": "• $(4 - 7)^2 = (-3)^2 = 9$" },
        { "tipe": "paragraph", "text": "• $(6 - 7)^2 = (-1)^2 = 1$" },
        { "tipe": "paragraph", "text": "• $(8 - 7)^2 = 1^2 = 1$" },
        { "tipe": "paragraph", "text": "• $(10 - 7)^2 = 3^2 = 9$" },
        { "tipe": "paragraph", "text": "• $(12 - 7)^2 = 5^2 = 25$" },
        { "tipe": "paragraph", "text": "Jumlah kuadrat simpangan $= 25 + 9 + 1 + 1 + 9 + 25 = 70$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung ragam ($S^2$)**" },
        { "tipe": "paragraph", "text": "$S^2 = \\dfrac{\\sum (x_i - \\bar{x})^2}{n} = \\dfrac{70}{6} = \\dfrac{35}{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q07",
