        { "tipe": "paragraph", "text": "**Langkah 1: Bagi data terurut ($n = 8$) menjadi kelompok bawah dan atas**" },
        { "tipe": "paragraph", "text": "• Kelompok data bawah: $5, 8, 10, 12$" },
        { "tipe": "paragraph", "text": "• Kelompok data atas: $15, 18, 20, 22$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung kuartil bawah ($Q_1$) dan kuartil atas ($Q_3$)**" },
        { "tipe": "paragraph", "text": "• $Q_1 = \\dfrac{8 + 10}{2} = \\dfrac{18}{2} = 9$" },
        { "tipe": "paragraph", "text": "• $Q_3 = \\dfrac{18 + 20}{2} = \\dfrac{38}{2} = 19$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung jangkauan interkuartil ($H = Q_3 - Q_1$)**" },
        { "tipe": "paragraph", "text": "$H = 19 - 9 = 10$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika rata-rata 10 data adalah $20$, dan setiap data dikali $2$ lalu dikurangi $5$, rata-rata baru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan sifat transformasi linear rata-rata**" },
        { "tipe": "paragraph", "text": "Jika setiap nilai data $x_i$ diubah menjadi $ax_i + b$, maka rata-rata barunya menjadi $\\bar{x}_{\\text{baru}} = a\\bar{x} + b$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $a = 2$, $b = -5$, dan $\\bar{x} = 20$**" },
        { "tipe": "paragraph", "text": "$\\bar{x}_{\\text{baru}} = 2(20) - 5 = 40 - 5 = 35$." }
      ],
      "tingkat": "SULIT"
    }
  ]
