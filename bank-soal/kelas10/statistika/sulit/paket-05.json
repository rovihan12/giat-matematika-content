{
  "id": "bs-k10-stat-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang statistika inferensial dan analisis data",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $10-14$ ($f=2$), $15-19$ ($f=6$), $20-24$ ($f=12$), $25-29$ ($f=8$), $30-34$ ($f=2$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$21{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$22{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$22{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$23{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$23{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah data ($n$) dan titik tengah ($x_i$) tiap interval**" },
        { "tipe": "paragraph", "text": "Diperoleh $n = 2 + 6 + 12 + 8 + 2 = 30$ dengan titik tengah masing-masing interval: $12$, $17$, $22$, $27$, dan $32$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sum f_i x_i$ dan nilai rata-rata ($\\bar{x}$)**" },
        { "tipe": "formula_block", "latex": "\\sum f_i x_i = 2(12) + 6(17) + 12(22) + 8(27) + 2(32) = 24 + 102 + 264 + 216 + 64 = 670" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{670}{30} \\approx 22{,}33" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$22{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $25-29$, $30-34$, $35-39$, $40-44$, $45-49$" },
        { "tipe": "paragraph", "text": "Frek: $3, 7, 14, 8, 3$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$36{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$37{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$37{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$38{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$38{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi kelas modus dan komponen rumusnya**" },
        { "tipe": "paragraph", "text": "Frekuensi terbesar adalah $14$ pada interval $35-39$, sehingga $L = 34{,}5$, $d_1 = 14 - 7 = 7$, $d_2 = 14 - 8 = 6$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai modus ($Mo$)**" },
        { "tipe": "formula_block", "latex": "Mo = L + \\left(\\dfrac{d_1}{d_1 + d_2}\\right) \\cdot c = 34{,}5 + \\left(\\dfrac{7}{7 + 6}\\right) \\cdot 5 = 34{,}5 + \\dfrac{35}{13} \\approx 37{,}19" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Pembulatan terdekat pada pilihan adalah **$37{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $50-54$, $55-59$, $60-64$, $65-69$, $70-74$" },
        { "tipe": "paragraph", "text": "Frek: $4, 8, 14, 10, 4$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$60{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$61{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$61{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$62{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$62{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas median**" },
        { "tipe": "paragraph", "text": "Dengan $n = 40$ dan frekuensi kumulatif $4, 12, 26, 36, 40$, data ke-$\\dfrac{n}{2} = 20$ berada pada interval $60-64$ dengan $L = 59{,}5$, $f_k = 12$, $f_m = 14$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai median ($Me$)**" },
        { "tipe": "formula_block", "latex": "Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c = 59{,}5 + \\left(\\dfrac{20 - 12}{14}\\right) \\cdot 5 = 59{,}5 + \\dfrac{40}{14} \\approx 62{,}36" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$62{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Desil ke-9 ($D_9$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $10-19$, $20-29$, $30-39$, $40-49$, $50-59$" },
        { "tipe": "paragraph", "text": "Frek: $5, 8, 12, 15, 10$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$49{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$50{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$51{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$52{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$53{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas desil ke-9 ($D_9$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 50$, letak $D_9$ berada pada data ke-$\\dfrac{9}{10}(50) = 45$ (frekuensi kumulatif $5, 13, 25, 40, 50$), yaitu pada interval $50-59$ dengan $L = 49{,}5$, $f_k = 40$, $f_D = 10$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $D_9$**" },
        { "tipe": "formula_block", "latex": "D_9 = L + \\left(\\dfrac{\\frac{9}{10}n - f_k}{f_D}\\right) \\cdot c = 49{,}5 + \\left(\\dfrac{45 - 40}{10}\\right) \\cdot 10 = 49{,}5 + 5 = 54{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$53{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $8, 10, 12, 14, 16$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}4$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}8$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$) data**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{8 + 10 + 12 + 14 + 16}{5} = \\dfrac{60}{5} = 12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung simpangan rata-rata ($SR$)**" },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{|8 - 12| + |10 - 12| + |12 - 12| + |14 - 12| + |16 - 12|}{5} = \\dfrac{4 + 2 + 0 + 2 + 4}{5} = \\dfrac{12}{5} = 2{,}4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, simpangan rata-rata data tersebut adalah **$2{,}4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Koefisien variasi dari data dengan rata-rata $50$ dan simpangan baku $5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5\\%$" } ],
        [ { "tipe": "paragraph", "text": "$10\\%$" } ],
        [ { "tipe": "paragraph", "text": "$15\\%$" } ],
        [ { "tipe": "paragraph", "text": "$20\\%$" } ],
        [ { "tipe": "paragraph", "text": "$25\\%$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus koefisien variasi ($KV$) dan substitusikan $S = 5$ serta $\\bar{x} = 50$**" },
        { "tipe": "formula_block", "latex": "KV = \\dfrac{S}{\\bar{x}} \\times 100\\% = \\dfrac{5}{50} \\times 100\\% = 0{,}1 \\times 100\\% = 10\\%" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, koefisien variasi data tersebut adalah **$10\\%$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika data $4, 5, 6, 7, 8$ ditransformasi menjadi $2x + 3$, maka rata-rata baru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$19$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata data awal ($\\bar{x}$)**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{4 + 5 + 6 + 7 + 8}{5} = \\dfrac{30}{5} = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Terapkan transformasi linear $2\\bar{x} + 3$**" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{baru}} = 2(6) + 3 = 12 + 3 = 15" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-rata baru data tersebut adalah **$15$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika rata-rata suatu data adalah $20$ dan jangkauannya $30$, sedangkan data terkecil adalah $5$, maka data terbesar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus jangkauan ($R = x_{\\text{maks}} - x_{\\text{min}}$) dan substitusikan $R = 30$ serta $x_{\\text{min}} = 5$**" },
        { "tipe": "formula_block", "latex": "30 = x_{\\text{maks}} - 5 \\Rightarrow x_{\\text{maks}} = 30 + 5 = 35" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, data terbesarnya adalah **$35$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil pertama dari data $6, 8, 10, 12, 14, 16, 18, 20, 22$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan kelompok data di bawah median ($n = 9$)**" },
        { "tipe": "paragraph", "text": "Median berada pada data ke-$5$ yaitu $14$, sehingga kelompok data di bawah median adalah $6, 8, 10, 12$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung kuartil pertama ($Q_1$) sebagai nilai tengah kelompok bawah**" },
        { "tipe": "formula_block", "latex": "Q_1 = \\dfrac{8 + 10}{2} = \\dfrac{18}{2} = 9" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, kuartil pertama data tersebut adalah **$9$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Suatu data memiliki rata-rata $\\bar{x} = 60$, median $= 58$, dan modus $= 55$. Hubungan yang benar antara ketiga ukuran tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\bar{x} = Mo = Me$" } ],
        [ { "tipe": "paragraph", "text": "$\\bar{x} < Me < Mo$" } ],
        [ { "tipe": "paragraph", "text": "$\\bar{x} > Me > Mo$" } ],
        [ { "tipe": "paragraph", "text": "$\\bar{x} = Me > Mo$" } ],
        [ { "tipe": "paragraph", "text": "$\\bar{x} > Mo > Me$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Bandingkan nilai rata-rata, median, dan modus**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = 60 > Me = 58 > Mo = 55 \\Rightarrow \\bar{x} > Me > Mo" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, hubungan yang benar adalah **$\\bar{x} > Me > Mo$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
