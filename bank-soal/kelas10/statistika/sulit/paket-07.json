{
  "id": "bs-k10-stat-t-07",
  "nama": "Bank Soal Sulit - Paket 7",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang median, modus, dan kuartil pada data tunggal dan tabel frekuensi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-t-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data $12, 7, 15, 10, 18, 14, 9, 11$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$11{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$12{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Urutkan data dari terkecil ke terbesar ($n = 8$)**" },
        { "tipe": "paragraph", "text": "Urutan data tersebut adalah $7, 9, 10, 11, 12, 14, 15, 18$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung median dari rata-rata data ke-$4$ dan ke-$5$**" },
        { "tipe": "formula_block", "latex": "Me = \\dfrac{11 + 12}{2} = \\dfrac{23}{2} = 11{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, median data tersebut adalah **$11{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel berikut. Median data tersebut adalah..." },
        { "tipe": "paragraph", "text": "Nilai: $4, 5, 6, 7, 8$" },
        { "tipe": "paragraph", "text": "Frek: $2, 4, 5, 3, 1$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$5{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$6{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak median dari total frekuensi $n = 15$**" },
        { "tipe": "formula_block", "latex": "n = 2 + 4 + 5 + 3 + 1 = 15 \\qquad \\Rightarrow \\qquad \\text{letak } Me = \\dfrac{15 + 1}{2} = 8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai data ke-$8$ menggunakan frekuensi kumulatif**" },
        { "tipe": "paragraph", "text": "Frekuensi kumulatifnya adalah $2$ untuk nilai $4$ (data ke-$1$ s.d. $2$), $6$ untuk nilai $5$ (data ke-$3$ s.d. $6$), dan $11$ untuk nilai $6$ (data ke-$7$ s.d. $11$), sehingga data ke-$8$ bernilai $6$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, median data tersebut adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data: $3, 5, 5, 6, 7, 7, 7, 9, 10$. Pernyataan yang benar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Median = $7$, modus = $7$" } ],
        [ { "tipe": "paragraph", "text": "Median = $6$, modus = $7$" } ],
        [ { "tipe": "paragraph", "text": "Median = $7$, modus = $5$" } ],
        [ { "tipe": "paragraph", "text": "Median = $6{,}5$, modus = $7$" } ],
        [ { "tipe": "paragraph", "text": "Median = $7$, modus = $6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan median dan modus dari data terurut ($n = 9$)**" },
        { "tipe": "paragraph", "text": "Data terurut $3, 5, 5, 6, 7, 7, 7, 9, 10$ memiliki data tengah (data ke-$5$) sama dengan $7$, dan nilai $7$ muncul paling banyak ($3$ kali)." },
        { "tipe": "formula_block", "latex": "Me = 7, \\qquad Mo = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, pernyataan yang benar adalah **Median = $7$, modus = $7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil pertama ($Q_1$) dari data $3, 4, 6, 8, 9, 11, 12, 15, 17$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan kelompok data bagian bawah ($n = 9$)**" },
        { "tipe": "paragraph", "text": "Median berada pada data ke-$5$ yaitu $9$, sehingga kelompok data di bawah median adalah $3, 4, 6, 8$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung kuartil pertama ($Q_1$) sebagai median kelompok bawah**" },
        { "tipe": "formula_block", "latex": "Q_1 = \\dfrac{4 + 6}{2} = \\dfrac{10}{2} = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, kuartil pertama ($Q_1$) data tersebut adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel berikut. Modus data tersebut adalah..." },
        { "tipe": "paragraph", "text": "Nilai: $5, 6, 7, 8, 9$" },
        { "tipe": "paragraph", "text": "Frek: $2, 4, 6, 3, 1$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi nilai dengan frekuensi terbesar pada tabel**" },
        { "tipe": "paragraph", "text": "Frekuensi terbesar adalah $6$ (muncul $6$ kali), yang bersesuaian dengan nilai $7$." },
        { "tipe": "formula_block", "latex": "Mo = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, modus data tersebut adalah **$7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data: $5, 8, 10, 12, 15, 18, 20, 22, 25$. Jangkauan interkuartilnya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan $Q_1$ dan $Q_3$ dari kelompok data bawah dan atas ($n = 9$)**" },
        { "tipe": "paragraph", "text": "Median adalah data ke-$5$ yaitu $15$, sehingga kelompok bawah adalah $5, 8, 10, 12$ dan kelompok atas adalah $18, 20, 22, 25$." },
        { "tipe": "formula_block", "latex": "Q_1 = \\dfrac{8 + 10}{2} = 9, \\qquad Q_3 = \\dfrac{20 + 22}{2} = 21" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jangkauan interkuartil ($H = Q_3 - Q_1$)**" },
        { "tipe": "formula_block", "latex": "H = 21 - 9 = 12" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jangkauan interkuartil data tersebut adalah **$12$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data $15, 12, 18, 10, 20, 14, 16, 11, 13, 17$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$14{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$15{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Urutkan data dari terkecil ke terbesar ($n = 10$)**" },
        { "tipe": "paragraph", "text": "Urutan data tersebut adalah $10, 11, 12, 13, 14, 15, 16, 17, 18, 20$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung median dari rata-rata data ke-$5$ dan ke-$6$**" },
        { "tipe": "formula_block", "latex": "Me = \\dfrac{14 + 15}{2} = \\dfrac{29}{2} = 14{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, median data tersebut adalah **$14{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel berikut. Median data tersebut adalah..." },
        { "tipe": "paragraph", "text": "Nilai: $3, 4, 5, 6, 7, 8$" },
        { "tipe": "paragraph", "text": "Frek: $1, 2, 4, 4, 2, 1$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$5{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$6{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan nilai data ke-$7$ dan ke-$8$ dari total $n = 14$ data**" },
        { "tipe": "paragraph", "text": "Frekuensi kumulatifnya adalah $1$ (nilai $3$), $3$ (nilai $4$), $7$ (nilai $5$, mencakup data ke-$4$ s.d. $7$), dan $11$ (nilai $6$, mencakup data ke-$8$ s.d. $11$), sehingga data ke-$7$ bernilai $5$ dan data ke-$8$ bernilai $6$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai median ($Me$)**" },
        { "tipe": "formula_block", "latex": "Me = \\dfrac{5 + 6}{2} = 5{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, median data tersebut adalah **$5{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data: $2, 3, 3, 4, 4, 5, 5, 5, 6, 6, 7$. Modus data tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$3$ dan $5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung frekuensi kemunculan tiap nilai pada data**" },
        { "tipe": "paragraph", "text": "Angka $2$ muncul $1$ kali, angka $3, 4, 6$ masing-masing muncul $2$ kali, angka $7$ muncul $1$ kali, dan angka $5$ muncul paling banyak yaitu $3$ kali." },
        { "tipe": "formula_block", "latex": "Mo = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, modus data tersebut adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil ketiga ($Q_3$) dari data $4, 5, 7, 8, 10, 11, 13, 15, 16, 18, 20$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$15{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$17$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan kelompok data bagian atas ($n = 11$)**" },
        { "tipe": "paragraph", "text": "Median berada pada data ke-$6$ yaitu $11$, sehingga kelompok data di atas median adalah $13, 15, 16, 18, 20$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan kuartil ketiga ($Q_3$) sebagai median kelompok atas**" },
        { "tipe": "formula_block", "latex": "Q_3 = 16" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, kuartil ketiga ($Q_3$) data tersebut adalah **$16$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
