        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Urutkan data baru setelah menambahkan $4$ ($n = 6$)**" },
        { "tipe": "paragraph", "text": "$4, 6, 8, 10, 12, 14$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung median untuk data genap ($n = 6$)**" },
        { "tipe": "paragraph", "text": "Median terletak di antara data ke-$3$ ($8$) dan data ke-$4$ ($10$):" },
        { "tipe": "paragraph", "text": "$Me = \\dfrac{8 + 10}{2} = \\dfrac{18}{2} = 9$." }
