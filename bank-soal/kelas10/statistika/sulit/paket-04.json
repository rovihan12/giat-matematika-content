{
  "id": "bs-k10-stat-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang rata-rata berkelompok, transformasi data, dan analisis statistik",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $20-24$ ($f=4$), $25-29$ ($f=8$), $30-34$ ($f=10$), $35-39$ ($f=6$), $40-44$ ($f=2$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$31{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$31{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$32{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$32{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah data ($n$) dan titik tengah ($x_i$) tiap interval**" },
        { "tipe": "paragraph", "text": "Diperoleh $n = 4 + 8 + 10 + 6 + 2 = 30$ dengan titik tengah masing-masing interval: $22$, $27$, $32$, $37$, dan $42$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sum f_i x_i$ dan nilai rata-rata ($\\bar{x}$)**" },
        { "tipe": "formula_block", "latex": "\\sum f_i x_i = 4(22) + 8(27) + 10(32) + 6(37) + 2(42) = 88 + 216 + 320 + 222 + 84 = 930" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{930}{30} = 31{,}0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-rata data berkelompok tersebut adalah **$31{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil ketiga ($Q_3$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $10-19$, $20-29$, $30-39$, $40-49$, $50-59$" },
        { "tipe": "paragraph", "text": "Frek: $4, 8, 10, 12, 6$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$44{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$45{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$45{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$46{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$46{,}5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas kuartil ketiga ($Q_3$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 40$, letak $Q_3$ berada pada data ke-$\\dfrac{3}{4}(40) = 30$ (frekuensi kumulatif $4, 12, 22, 34$), yaitu pada interval $40-49$ dengan $L = 39{,}5$, $f_k = 22$, $f_Q = 12$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $Q_3$**" },
        { "tipe": "formula_block", "latex": "Q_3 = L + \\left(\\dfrac{\\frac{3}{4}n - f_k}{f_Q}\\right) \\cdot c = 39{,}5 + \\left(\\dfrac{30 - 22}{12}\\right) \\cdot 10 = 39{,}5 + \\dfrac{80}{12} \\approx 46{,}17" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$46{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $150-154$, $155-159$, $160-164$, $165-169$" },
        { "tipe": "paragraph", "text": "Frek: $5, 8, 15, 7$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$160{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$161{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$161{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$162{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$162{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi kelas modus dan komponen rumusnya**" },
        { "tipe": "paragraph", "text": "Frekuensi terbesar adalah $15$ pada interval $160-164$, sehingga $L = 159{,}5$, $d_1 = 15 - 8 = 7$, $d_2 = 15 - 7 = 8$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai modus ($Mo$)**" },
        { "tipe": "formula_block", "latex": "Mo = L + \\left(\\dfrac{d_1}{d_1 + d_2}\\right) \\cdot c = 159{,}5 + \\left(\\dfrac{7}{7 + 8}\\right) \\cdot 5 = 159{,}5 + \\dfrac{35}{15} \\approx 161{,}83" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$161{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $5-9$, $10-14$, $15-19$, $20-24$" },
        { "tipe": "paragraph", "text": "Frek: $6, 10, 8, 6$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$14{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$14{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$15{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$15{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas median**" },
        { "tipe": "paragraph", "text": "Dengan $n = 30$ dan frekuensi kumulatif $6, 16, 24, 30$, data ke-$\\dfrac{n}{2} = 15$ berada pada interval $10-14$ dengan $L = 9{,}5$, $f_k = 6$, $f_m = 10$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai median ($Me$)**" },
        { "tipe": "formula_block", "latex": "Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c = 9{,}5 + \\left(\\dfrac{15 - 6}{10}\\right) \\cdot 5 = 9{,}5 + 4{,}5 = 14{,}0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai median data berkelompok tersebut adalah **$14{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $5, 10, 15, 20, 25$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$) data**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{5 + 10 + 15 + 20 + 25}{5} = \\dfrac{75}{5} = 15" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung simpangan rata-rata ($SR$)**" },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{|5 - 15| + |10 - 15| + |15 - 15| + |20 - 15| + |25 - 15|}{5} = \\dfrac{10 + 5 + 0 + 5 + 10}{5} = \\dfrac{30}{5} = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, simpangan rata-rata data tersebut adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Ragam dari data $3, 5, 7, 9, 11, 13$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{40}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{70}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{70}{6}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$) data**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{3 + 5 + 7 + 9 + 11 + 13}{6} = \\dfrac{48}{6} = 8" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung ragam ($S^2$) dari jumlah kuadrat simpangan**" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{(-5)^2 + (-3)^2 + (-1)^2 + 1^2 + 3^2 + 5^2}{6} = \\dfrac{25 + 9 + 1 + 1 + 9 + 25}{6} = \\dfrac{70}{6} = \\dfrac{35}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, ragam data tersebut adalah **$\\dfrac{35}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika rata-rata 10 data adalah $25$ dan rata-rata 15 data lainnya adalah $30$, maka rata-rata gabungan seluruh data tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$27{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$28{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus rata-rata gabungan dan substitusikan nilai yang diketahui**" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{gab}} = \\dfrac{n_1 \\bar{x}_1 + n_2 \\bar{x}_2}{n_1 + n_2} = \\dfrac{10(25) + 15(30)}{10 + 15} = \\dfrac{250 + 450}{25} = \\dfrac{700}{25} = 28" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-rata gabungan seluruh data tersebut adalah **$28$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persentil ke-10 ($P_{10}$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $30-39$, $40-49$, $50-59$, $60-69$" },
        { "tipe": "paragraph", "text": "Frek: $5, 12, 18, 15$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$37{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$38{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$39{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$40{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$41{,}0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas persentil ke-10 ($P_{10}$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 50$, letak $P_{10}$ berada pada data ke-$\\dfrac{10}{100}(50) = 5$ (frekuensi kumulatif kelas pertama $= 5$), yaitu pada interval $30-39$ dengan $L = 29{,}5$, $f_k = 0$, $f_P = 5$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $P_{10}$**" },
        { "tipe": "formula_block", "latex": "P_{10} = L + \\left(\\dfrac{\\frac{10}{100}n - f_k}{f_P}\\right) \\cdot c = 29{,}5 + \\left(\\dfrac{5 - 0}{5}\\right) \\cdot 10 = 29{,}5 + 10 = 39{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$39{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jangkauan dari data berkelompok dengan interval $20-29$ sampai $60-69$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan tepi atas kelas tertinggi dan tepi bawah kelas terendah**" },
        { "tipe": "paragraph", "text": "Tepi bawah kelas $20-29$ adalah $19{,}5$ dan tepi atas kelas $60-69$ adalah $69{,}5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jangkauan data berkelompok**" },
        { "tipe": "formula_block", "latex": "\\text{Jangkauan} = 69{,}5 - 19{,}5 = 50" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, jangkauan data berkelompok tersebut adalah **$50$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika rata-rata 20 data adalah $50$ dan simpangan bakunya $4$, kemudian semua data ditambah $10$, maka simpangan baku baru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan sifat ukuran penyebaran terhadap pergeseran data**" },
        { "tipe": "paragraph", "text": "Menambah setiap nilai data dengan konstanta $10$ hanya menggeser posisi data dan tidak mengubah ukuran penyebaran (seperti jangkauan, ragam, maupun simpangan baku)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan simpangan baku baru**" },
        { "tipe": "formula_block", "latex": "s_{\\text{baru}} = s_{\\text{lama}} = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, simpangan baku baru tetap sebesar **$4$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
