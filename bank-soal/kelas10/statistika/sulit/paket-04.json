{
  "id": "bs-k10-stat-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang rata-rata berkelompok, transformasi data, dan analisis statistik",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $20-24$ ($f=4$), $25-29$ ($f=8$), $30-34$ ($f=10$), $35-39$ ($f=6$), $40-44$ ($f=2$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$31{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$31{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$32{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$32{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah data ($n$) dan titik tengah ($x_i$) tiap interval**" },
        { "tipe": "paragraph", "text": "• $n = 4 + 8 + 10 + 6 + 2 = 30$" },
        { "tipe": "paragraph", "text": "• Titik tengah ($x_i$): $22$, $27$, $32$, $37$, dan $42$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah perkalian frekuensi dan titik tengah ($\\sum f_i \\cdot x_i$)**" },
        { "tipe": "paragraph", "text": "• $4 \\times 22 = 88$" },
        { "tipe": "paragraph", "text": "• $8 \\times 27 = 216$" },
        { "tipe": "paragraph", "text": "• $10 \\times 32 = 320$" },
        { "tipe": "paragraph", "text": "• $6 \\times 37 = 222$" },
        { "tipe": "paragraph", "text": "• $2 \\times 42 = 84$" },
        { "tipe": "paragraph", "text": "$\\sum f_i \\cdot x_i = 88 + 216 + 320 + 222 + 84 = 930$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung rata-rata ($\\bar{x}$)**" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{\\sum f_i \\cdot x_i}{n} = \\dfrac{930}{30} = 31{,}0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil ketiga ($Q_3$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $10-19$, $20-29$, $30-39$, $40-49$, $50-59$" },
        { "tipe": "paragraph", "text": "Frek: $4, 8, 10, 12, 6$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$44{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$45{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$45{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$46{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$46{,}5$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak kelas kuartil ketiga ($Q_3$)**" },
        { "tipe": "paragraph", "text": "Jumlah frekuensi $n = 4 + 8 + 10 + 12 + 6 = 40$." },
        { "tipe": "paragraph", "text": "Letak $Q_3$ berada pada data ke-$\\dfrac{3}{4} n = \\dfrac{3}{4} \\times 40 = 30$." },
        { "tipe": "paragraph", "text": "Frekuensi kumulatif: $4$ (kelas 1), $12$ (kelas 2), $22$ (kelas 3), $34$ (kelas 4). Data ke-$30$ berada di kelas keempat, yaitu interval $40-49$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus $Q_3$**" },
        { "tipe": "paragraph", "text": "• $L = 40 - 0{,}5 = 39{,}5$" },
        { "tipe": "paragraph", "text": "• $f_k = 22$" },
        { "tipe": "paragraph", "text": "• $f_Q = 12$" },
        { "tipe": "paragraph", "text": "• $c = 10$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $Q_3$**" },
        { "tipe": "paragraph", "text": "$Q_3 = L + \\left(\\dfrac{\\frac{3}{4}n - f_k}{f_Q}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$Q_3 = 39{,}5 + \\left(\\dfrac{30 - 22}{12}\\right) \\cdot 10 = 39{,}5 + \\dfrac{80}{12} \\approx 39{,}5 + 6{,}67 = 46{,}17$." },
        { "tipe": "paragraph", "text": "Nilai pada pilihan yang paling mendekati adalah $46{,}0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $150-154$, $155-159$, $160-164$, $165-169$" },
        { "tipe": "paragraph", "text": "Frek: $5, 8, 15, 7$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$160{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$161{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$161{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$162{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$162{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan kelas modus**" },
        { "tipe": "paragraph", "text": "Frekuensi tertinggi adalah $15$, sehingga kelas modusnya adalah interval $160-164$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus modus**" },
        { "tipe": "paragraph", "text": "• $L = 160 - 0{,}5 = 159{,}5$" },
        { "tipe": "paragraph", "text": "• $d_1 = 15 - 8 = 7$" },
        { "tipe": "paragraph", "text": "• $d_2 = 15 - 7 = 8$" },
        { "tipe": "paragraph", "text": "• $c = 5$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai modus ($Mo$)**" },
        { "tipe": "paragraph", "text": "$Mo = L + \\left(\\dfrac{d_1}{d_1 + d_2}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$Mo = 159{,}5 + \\left(\\dfrac{7}{7 + 8}\\right) \\cdot 5 = 159{,}5 + \\dfrac{35}{15} \\approx 159{,}5 + 2{,}33 = 161{,}83$." },
        { "tipe": "paragraph", "text": "Nilai pada pilihan yang paling mendekati adalah $161{,}5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $5-9$, $10-14$, $15-19$, $20-24$" },
        { "tipe": "paragraph", "text": "Frek: $6, 10, 8, 6$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$14{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$14{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$15{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$15{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak kelas median**" },
        { "tipe": "paragraph", "text": "Jumlah frekuensi $n = 6 + 10 + 8 + 6 = 30$, sehingga letak median berada pada data ke-$\\dfrac{n}{2} = 15$." },
        { "tipe": "paragraph", "text": "Frekuensi kumulatif: $6$ (kelas 1), $16$ (kelas 2). Data ke-$15$ berada di kelas kedua, yaitu interval $10-14$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus median**" },
        { "tipe": "paragraph", "text": "• $L = 10 - 0{,}5 = 9{,}5$" },
        { "tipe": "paragraph", "text": "• $f_k = 6$" },
        { "tipe": "paragraph", "text": "• $f_m = 10$" },
        { "tipe": "paragraph", "text": "• $c = 5$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai median ($Me$)**" },
        { "tipe": "paragraph", "text": "$Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$Me = 9{,}5 + \\left(\\dfrac{15 - 6}{10}\\right) \\cdot 5 = 9{,}5 + \\dfrac{45}{10} = 9{,}5 + 4{,}5 = 14{,}0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $5, 10, 15, 20, 25$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$)**" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{5 + 10 + 15 + 20 + 25}{5} = \\dfrac{75}{5} = 15$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah nilai mutlak simpangan $|x_i - \\bar{x}|$**" },
        { "tipe": "paragraph", "text": "• $|5 - 15| = 10$" },
        { "tipe": "paragraph", "text": "• $|10 - 15| = 5$" },
        { "tipe": "paragraph", "text": "• $|15 - 15| = 0$" },
        { "tipe": "paragraph", "text": "• $|20 - 15| = 5$" },
        { "tipe": "paragraph", "text": "• $|25 - 15| = 10$" },
        { "tipe": "paragraph", "text": "Jumlah simpangan $= 10 + 5 + 0 + 5 + 10 = 30$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung simpangan rata-rata ($SR$)**" },
        { "tipe": "paragraph", "text": "$SR = \\dfrac{\\sum |x_i - \\bar{x}|}{n} = \\dfrac{30}{5} = 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Ragam dari data $3, 5, 7, 9, 11, 13$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{40}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{70}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{70}{6}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$)**" },
        { "tipe": "paragraph", "text": "$\\bar{x} = \\dfrac{3 + 5 + 7 + 9 + 11 + 13}{6} = \\dfrac{48}{6} = 8$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah kuadrat simpangan $\\sum (x_i - \\bar{x})^2$**" },
        { "tipe": "paragraph", "text": "• $(3 - 8)^2 = (-5)^2 = 25$" },
        { "tipe": "paragraph", "text": "• $(5 - 8)^2 = (-3)^2 = 9$" },
        { "tipe": "paragraph", "text": "• $(7 - 8)^2 = (-1)^2 = 1$" },
        { "tipe": "paragraph", "text": "• $(9 - 8)^2 = 1^2 = 1$" },
        { "tipe": "paragraph", "text": "• $(11 - 8)^2 = 3^2 = 9$" },
        { "tipe": "paragraph", "text": "• $(13 - 8)^2 = 5^2 = 25$" },
        { "tipe": "paragraph", "text": "Jumlah kuadrat simpangan $= 25 + 9 + 1 + 1 + 9 + 25 = 70$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung ragam ($S^2$)**" },
        { "tipe": "paragraph", "text": "$S^2 = \\dfrac{\\sum (x_i - \\bar{x})^2}{n} = \\dfrac{70}{6} = \\dfrac{35}{3}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika rata-rata 10 data adalah $25$ dan rata-rata 15 data lainnya adalah $30$, maka rata-rata gabungan seluruh data tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$27{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$28$" } ],
        [ { "tipe": "paragraph", "text": "$28{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus rata-rata gabungan**" },
        { "tipe": "paragraph", "text": "$\\bar{x}_{\\text{gab}} = \\dfrac{n_1 \\cdot \\bar{x}_1 + n_2 \\cdot \\bar{x}_2}{n_1 + n_2}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $n_1 = 10$, $\\bar{x}_1 = 25$, $n_2 = 15$, dan $\\bar{x}_2 = 30$**" },
        { "tipe": "paragraph", "text": "$\\bar{x}_{\\text{gab}} = \\dfrac{10(25) + 15(30)}{10 + 15} = \\dfrac{250 + 450}{25} = \\dfrac{700}{25} = 28$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persentil ke-10 ($P_{10}$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $30-39$, $40-49$, $50-59$, $60-69$" },
        { "tipe": "paragraph", "text": "Frek: $5, 12, 18, 15$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$37{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$38{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$39{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$40{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$41{,}0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak kelas persentil ke-10 ($P_{10}$)**" },
        { "tipe": "paragraph", "text": "Jumlah frekuensi $n = 5 + 12 + 18 + 15 = 50$." },
        { "tipe": "paragraph", "text": "Letak $P_{10}$ berada pada data ke-$\\dfrac{10}{100} n = \\dfrac{10}{100} \\times 50 = 5$. Karena frekuensi kumulatif kelas pertama tepat sama dengan $5$, kelas $P_{10}$ adalah interval pertama ($30-39$)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus persentil**" },
        { "tipe": "paragraph", "text": "• $L = 30 - 0{,}5 = 29{,}5$" },
        { "tipe": "paragraph", "text": "• $f_k = 0$" },
        { "tipe": "paragraph", "text": "• $f_P = 5$" },
        { "tipe": "paragraph", "text": "• $c = 10$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $P_{10}$**" },
        { "tipe": "paragraph", "text": "$P_{10} = L + \\left(\\dfrac{\\frac{10}{100}n - f_k}{f_P}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$P_{10} = 29{,}5 + \\left(\\dfrac{5 - 0}{5}\\right) \\cdot 10 = 29{,}5 + 10 = 39{,}5$." },
        { "tipe": "paragraph", "text": "Nilai pada pilihan yang paling mendekati adalah $39{,}0$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jangkauan dari data berkelompok dengan interval $20-29$ sampai $60-69$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi tepi atas kelas tertinggi dan tepi bawah kelas terendah**" },
        { "tipe": "paragraph", "text": "• Tepi bawah kelas terendah ($20-29$): $20 - 0{,}5 = 19{,}5$" },
        { "tipe": "paragraph", "text": "• Tepi atas kelas tertinggi ($60-69$): $69 + 0{,}5 = 69{,}5$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jangkauan data berkelompok**" },
        { "tipe": "paragraph", "text": "$\\text{Jangkauan} = 69{,}5 - 19{,}5 = 50$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika rata-rata 20 data adalah $50$ dan simpangan bakunya $4$, kemudian semua data ditambah $10$, maka simpangan baku baru adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan sifat ukuran penyebaran terhadap pergeseran data**" },
        { "tipe": "paragraph", "text": "Menambah atau mengurangi setiap nilai data dengan suatu konstanta hanya menggeser letak data, sehingga **tidak mengubah** ukuran penyebaran seperti jangkauan, ragam, maupun simpangan baku." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan simpangan baku baru**" },
        { "tipe": "paragraph", "text": "Simpangan baku baru tetap sama dengan simpangan baku awal, yaitu $4$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
