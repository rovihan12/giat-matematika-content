{
  "id": "bs-k10-stat-sulit-01",
  "nama": "Bank Soal Sulit - Paket 1",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang mean, median, dan modus data berkelompok",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Perhatikan tabel distribusi frekuensi berikut. Nilai rata-rata data tersebut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $40-49$, $50-59$, $60-69$, $70-79$, $80-89$" },
        { "tipe": "paragraph", "text": "Frek: $3, 7, 10, 6, 4$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$62{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$63{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$63{,}3$" } ],
        [ { "tipe": "paragraph", "text": "$64{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$64{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah data ($n$) dan titik tengah ($x_i$) tiap interval**" },
        { "tipe": "paragraph", "text": "Diperoleh $n = 3 + 7 + 10 + 6 + 4 = 30$ dengan titik tengah masing-masing interval: $44{,}5$; $54{,}5$; $64{,}5$; $74{,}5$; dan $84{,}5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sum f_i x_i$ dan nilai rata-rata ($\\bar{x}$)**" },
        { "tipe": "formula_block", "latex": "\\sum f_i x_i = 3(44{,}5) + 7(54{,}5) + 10(64{,}5) + 6(74{,}5) + 4(84{,}5) = 133{,}5 + 381{,}5 + 645 + 447 + 338 = 1.945" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{1.945}{30} \\approx 64{,}83" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$64{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dari tabel distribusi frekuensi pada soal sebelumnya ($n = 30$), median data berkelompok adalah..." },
        { "tipe": "paragraph", "text": "Interval: $40-49$, $50-59$, $60-69$, $70-79$, $80-89$" },
        { "tipe": "paragraph", "text": "Frek: $3, 7, 10, 6, 4$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$62{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$63{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$63{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$64{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$64{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan kelas median dari letak data ke-$\\dfrac{n}{2} = 15$**" },
        { "tipe": "paragraph", "text": "Frekuensi kumulatif tiap kelas adalah $3$, $10$, $20$, $26$, dan $30$, sehingga data ke-$15$ terletak pada interval $60-69$ dengan $L = 59{,}5$, $f_k = 10$, $f_m = 10$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung median ($Me$) menggunakan rumus data berkelompok**" },
        { "tipe": "formula_block", "latex": "Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c = 59{,}5 + \\left(\\dfrac{15 - 10}{10}\\right) \\cdot 10 = 59{,}5 + 5 = 64{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, median data berkelompok tersebut adalah **$64{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari tabel distribusi frekuensi berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $50-54$, $55-59$, $60-64$, $65-69$, $70-74$" },
        { "tipe": "paragraph", "text": "Frek: $3, 5, 12, 7, 3$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$61{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$62{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$62{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$63{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$63{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi kelas modus dan komponen rumusnya**" },
        { "tipe": "paragraph", "text": "Frekuensi terbesar adalah $12$ pada interval $60-64$, sehingga $L = 59{,}5$, $d_1 = 12 - 5 = 7$, $d_2 = 12 - 7 = 5$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung modus ($Mo$)**" },
        { "tipe": "formula_block", "latex": "Mo = L + \\left(\\dfrac{d_1}{d_1 + d_2}\\right) \\cdot c = 59{,}5 + \\left(\\dfrac{7}{7 + 5}\\right) \\cdot 5 = 59{,}5 + \\dfrac{35}{12} \\approx 62{,}42" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Pembulatan terdekat pada pilihan adalah **$62{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil pertama ($Q_1$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $20-29$, $30-39$, $40-49$, $50-59$, $60-69$" },
        { "tipe": "paragraph", "text": "Frek: $4, 8, 12, 10, 6$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$35{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$37{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$38{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$39{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$40{,}0$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas kuartil pertama ($Q_1$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 40$, letak $Q_1$ berada pada data ke-$\\dfrac{1}{4}(40) = 10$ (frekuensi kumulatif $4$ dan $12$), yaitu pada interval $30-39$ dengan $L = 29{,}5$, $f_k = 4$, $f_{Q_1} = 8$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $Q_1$**" },
        { "tipe": "formula_block", "latex": "Q_1 = L + \\left(\\dfrac{\\frac{1}{4}n - f_k}{f_{Q_1}}\\right) \\cdot c = 29{,}5 + \\left(\\dfrac{10 - 4}{8}\\right) \\cdot 10 = 29{,}5 + 7{,}5 = 37{,}0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai kuartil pertama ($Q_1$) adalah **$37{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil ketiga ($Q_3$) dari data berkelompok pada soal sebelumnya adalah..." },
        { "tipe": "paragraph", "text": "Interval: $20-29$, $30-39$, $40-49$, $50-59$, $60-69$" },
        { "tipe": "paragraph", "text": "Frek: $4, 8, 12, 10, 6$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$53{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$54{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$54{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas kuartil ketiga ($Q_3$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 40$, letak $Q_3$ berada pada data ke-$\\dfrac{3}{4}(40) = 30$ (frekuensi kumulatif $4, 12, 24, 34$), yaitu pada interval $50-59$ dengan $L = 49{,}5$, $f_k = 24$, $f_{Q_3} = 10$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $Q_3$**" },
        { "tipe": "formula_block", "latex": "Q_3 = L + \\left(\\dfrac{\\frac{3}{4}n - f_k}{f_{Q_3}}\\right) \\cdot c = 49{,}5 + \\left(\\dfrac{30 - 24}{10}\\right) \\cdot 10 = 49{,}5 + 6 = 55{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai kuartil ketiga ($Q_3$) adalah **$55{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Desil ke-7 ($D_7$) dari data berkelompok dengan $n = 50$ berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $10-19$, $20-29$, $30-39$, $40-49$, $50-59$" },
        { "tipe": "paragraph", "text": "Frek: $5, 10, 15, 12, 8$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$41{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$42{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$42{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$43{,}0$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas desil ke-7 ($D_7$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 50$, letak $D_7$ berada pada data ke-$\\dfrac{7}{10}(50) = 35$ (frekuensi kumulatif $5, 15, 30, 42$), yaitu pada interval $40-49$ dengan $L = 39{,}5$, $f_k = 30$, $f_{D_7} = 12$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $D_7$**" },
        { "tipe": "formula_block", "latex": "D_7 = L + \\left(\\dfrac{\\frac{7}{10}n - f_k}{f_{D_7}}\\right) \\cdot c = 39{,}5 + \\left(\\dfrac{35 - 30}{12}\\right) \\cdot 10 = 39{,}5 + \\dfrac{50}{12} \\approx 43{,}67" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$43{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $1-5$, $6-10$, $11-15$, $16-20$" },
        { "tipe": "paragraph", "text": "Frek: $3, 8, 6, 3$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$9{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$10{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$10{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$11{,}0$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan kelas median dari letak data ke-$\\dfrac{n}{2} = 10$**" },
        { "tipe": "paragraph", "text": "Dengan $n = 20$ dan frekuensi kumulatif $3, 11, 17, 20$, data ke-$10$ berada pada interval $6-10$ dengan $L = 5{,}5$, $f_k = 3$, $f_m = 8$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai median ($Me$)**" },
        { "tipe": "formula_block", "latex": "Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c = 5{,}5 + \\left(\\dfrac{10 - 3}{8}\\right) \\cdot 5 = 5{,}5 + 4{,}375 = 9{,}875 \\approx 10{,}0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$10{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $8, 9, 10, 11, 12$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$1{,}2$" } ],
        [ { "tipe": "paragraph", "text": "$1{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$2{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$) data**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{8 + 9 + 10 + 11 + 12}{5} = \\dfrac{50}{5} = 10" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung simpangan rata-rata ($SR$)**" },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{|8 - 10| + |9 - 10| + |10 - 10| + |11 - 10| + |12 - 10|}{5} = \\dfrac{2 + 1 + 0 + 1 + 2}{5} = \\dfrac{6}{5} = 1{,}2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, simpangan rata-rata data tersebut adalah **$1{,}2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Ragam dari data $1, 2, 3, 4, 5, 6, 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$) data**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{1 + 2 + 3 + 4 + 5 + 6 + 7}{7} = \\dfrac{28}{7} = 4" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung ragam ($S^2$) dari jumlah kuadrat simpangan**" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{(-3)^2 + (-2)^2 + (-1)^2 + 0^2 + 1^2 + 2^2 + 3^2}{7} = \\dfrac{9 + 4 + 1 + 0 + 1 + 4 + 9}{7} = \\dfrac{28}{7} = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, ragam data tersebut adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata 20 data adalah $50$. Jika tiap data dikurangi $3$, rata-ratanya menjadi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ],
        [ { "tipe": "paragraph", "text": "$47$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan sifat pergeseran rata-rata akibat pengurangan konstanta**" },
        { "tipe": "paragraph", "text": "Jika setiap nilai data dikurangi $3$, maka rata-rata barunya juga berkurang sebesar $3$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung rata-rata baru**" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{baru}} = 50 - 3 = 47" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-ratanya menjadi **$47$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
