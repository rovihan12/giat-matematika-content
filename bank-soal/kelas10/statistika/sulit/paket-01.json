      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Terapkan sifat pergeseran rata-rata**" },
        { "tipe": "paragraph", "text": "Jika setiap nilai data ditambah atau dikurangi dengan suatu konstanta $k$, maka nilai rata-rata baru juga akan bertambah atau berkurang sebesar $k$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung rata-rata baru**" },
        { "tipe": "paragraph", "text": "$\\bar{x}_{\\text{baru}} = \\bar{x}_{\\text{lama}} - 3 = 50 - 3 = 47$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
