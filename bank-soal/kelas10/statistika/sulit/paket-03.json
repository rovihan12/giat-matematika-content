    {
      "id": "bs-k10-stat-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persentil ke-25 ($P_{25}$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $40-49$, $50-59$, $60-69$, $70-79$" },
        { "tipe": "paragraph", "text": "Frek: $5, 15, 20, 10$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$54{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$56{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$56{,}5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$n = 50$, $P_{25}$ = data ke-$\\dfrac{25}{100} \\cdot 50 = 12{,}5$." },
        { "tipe": "paragraph", "text": "Frek kumulatif: $5, 20$ → kelas $P_{25}$ = $50-59$." },
        { "tipe": "paragraph", "text": "$L = 49{,}5$, $f_k = 5$, $f_P = 15$, $c = 10$" },
        { "tipe": "paragraph", "text": "$P_{25} = 49{,}5 + \\left(\\dfrac{12{,}5 - 5}{15}\\right) \\cdot 10 = 49{,}5 + 5 = 54{,}5$" }
      ],
      "tingkat": "SULIT"
    },
