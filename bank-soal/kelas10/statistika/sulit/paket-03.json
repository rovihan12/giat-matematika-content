{
  "id": "bs-k10-stat-sulit-03",
  "nama": "Bank Soal Sulit - Paket 3",
  "kelas": 10,
  "kategori": "Statistika",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang persentil, desil, dan interpretasi data berkelompok",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-stat-sulit-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persentil ke-25 ($P_{25}$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $40-49$, $50-59$, $60-69$, $70-79$" },
        { "tipe": "paragraph", "text": "Frek: $5, 15, 20, 10$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$54{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$56{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$56{,}5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas persentil ke-25 ($P_{25}$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 50$, letak $P_{25}$ berada pada data ke-$\\dfrac{25}{100}(50) = 12{,}5$ (frekuensi kumulatif $5$ dan $20$), yaitu pada interval $50-59$ dengan $L = 49{,}5$, $f_k = 5$, $f_P = 15$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $P_{25}$**" },
        { "tipe": "formula_block", "latex": "P_{25} = L + \\left(\\dfrac{\\frac{25}{100}n - f_k}{f_P}\\right) \\cdot c = 49{,}5 + \\left(\\dfrac{12{,}5 - 5}{15}\\right) \\cdot 10 = 49{,}5 + 5 = 54{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai persentil ke-25 ($P_{25}$) adalah **$54{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Persentil ke-75 ($P_{75}$) dari data berkelompok pada soal sebelumnya adalah..." },
        { "tipe": "paragraph", "text": "Interval: $40-49$, $50-59$, $60-69$, $70-79$" },
        { "tipe": "paragraph", "text": "Frek: $5, 15, 20, 10$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$64{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$65{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$66{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$67{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$68{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas persentil ke-75 ($P_{75}$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 50$, letak $P_{75}$ berada pada data ke-$\\dfrac{75}{100}(50) = 37{,}5$ (frekuensi kumulatif $5, 20, 40$), yaitu pada interval $60-69$ dengan $L = 59{,}5$, $f_k = 20$, $f_P = 20$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $P_{75}$**" },
        { "tipe": "formula_block", "latex": "P_{75} = L + \\left(\\dfrac{\\frac{75}{100}n - f_k}{f_P}\\right) \\cdot c = 59{,}5 + \\left(\\dfrac{37{,}5 - 20}{20}\\right) \\cdot 10 = 59{,}5 + 8{,}75 = 68{,}25" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$68{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $100-109$, $110-119$, $120-129$, $130-139$" },
        { "tipe": "paragraph", "text": "Frek: $8, 12, 18, 12$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$119{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$120{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$120{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$121{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$122{,}0$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas median**" },
        { "tipe": "paragraph", "text": "Dengan $n = 50$ dan frekuensi kumulatif $8, 20, 38, 50$, data ke-$\\dfrac{n}{2} = 25$ berada pada interval $120-129$ dengan $L = 119{,}5$, $f_k = 20$, $f_m = 18$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai median ($Me$)**" },
        { "tipe": "formula_block", "latex": "Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c = 119{,}5 + \\left(\\dfrac{25 - 20}{18}\\right) \\cdot 10 = 119{,}5 + \\dfrac{50}{18} \\approx 122{,}28" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$122{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Kuartil pertama ($Q_1$) dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $1-10$, $11-20$, $21-30$, $31-40$, $41-50$" },
        { "tipe": "paragraph", "text": "Frek: $6, 12, 15, 10, 7$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$13{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$14{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$15{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$16{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$17{,}0$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas kuartil pertama ($Q_1$)**" },
        { "tipe": "paragraph", "text": "Dengan $n = 50$, letak $Q_1$ berada pada data ke-$\\dfrac{1}{4}(50) = 12{,}5$ (frekuensi kumulatif $6$ dan $18$), yaitu pada interval $11-20$ dengan $L = 10{,}5$, $f_k = 6$, $f_Q = 12$, dan $c = 10$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $Q_1$**" },
        { "tipe": "formula_block", "latex": "Q_1 = L + \\left(\\dfrac{\\frac{1}{4}n - f_k}{f_Q}\\right) \\cdot c = 10{,}5 + \\left(\\dfrac{12{,}5 - 6}{12}\\right) \\cdot 10 = 10{,}5 + \\dfrac{65}{12} \\approx 15{,}92" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$16{,}0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Simpangan rata-rata dari data $25, 30, 35, 40, 45$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$) data**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{25 + 30 + 35 + 40 + 45}{5} = \\dfrac{175}{5} = 35" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung simpangan rata-rata ($SR$)**" },
        { "tipe": "formula_block", "latex": "SR = \\dfrac{|25 - 35| + |30 - 35| + |35 - 35| + |40 - 35| + |45 - 35|}{5} = \\dfrac{10 + 5 + 0 + 5 + 10}{5} = \\dfrac{30}{5} = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, simpangan rata-rata data tersebut adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Ragam dari data $4, 6, 8, 10, 12, 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{35}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{70}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{40}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung rata-rata ($\\bar{x}$) data**" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{4 + 6 + 8 + 10 + 12 + 14}{6} = \\dfrac{54}{6} = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung ragam ($S^2$) dari jumlah kuadrat simpangan**" },
        { "tipe": "formula_block", "latex": "S^2 = \\dfrac{(-5)^2 + (-3)^2 + (-1)^2 + 1^2 + 3^2 + 5^2}{6} = \\dfrac{25 + 9 + 1 + 1 + 9 + 25}{6} = \\dfrac{70}{6} = \\dfrac{35}{3}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, ragam data tersebut adalah **$\\dfrac{35}{3}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Median dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $15-19$, $20-24$, $25-29$, $30-34$" },
        { "tipe": "paragraph", "text": "Frek: $5, 10, 12, 8$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$24{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$25{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$25{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$26{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$26{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak dan kelas median**" },
        { "tipe": "paragraph", "text": "Dengan $n = 35$ dan frekuensi kumulatif $5, 15, 27, 35$, data ke-$\\dfrac{n}{2} = 17{,}5$ berada pada interval $25-29$ dengan $L = 24{,}5$, $f_k = 15$, $f_m = 12$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai median ($Me$)**" },
        { "tipe": "formula_block", "latex": "Me = L + \\left(\\dfrac{\\frac{n}{2} - f_k}{f_m}\\right) \\cdot c = 24{,}5 + \\left(\\dfrac{17{,}5 - 15}{12}\\right) \\cdot 5 = 24{,}5 + \\dfrac{12{,}5}{12} \\approx 25{,}54" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$25{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Rata-rata dari tabel distribusi berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $40-44$ ($f=3$), $45-49$ ($f=7$), $50-54$ ($f=10$), $55-59$ ($f=5$)" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$49{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$50{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$50{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$51{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$51{,}5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah data ($n$) dan titik tengah ($x_i$) tiap interval**" },
        { "tipe": "paragraph", "text": "Diperoleh $n = 3 + 7 + 10 + 5 = 25$ dengan titik tengah masing-masing interval: $42$, $47$, $52$, dan $57$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $\\sum f_i x_i$ dan nilai rata-rata ($\\bar{x}$)**" },
        { "tipe": "formula_block", "latex": "\\sum f_i x_i = 3(42) + 7(47) + 10(52) + 5(57) = 126 + 329 + 520 + 285 = 1.260" },
        { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{1.260}{25} = 50{,}4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Nilai pada pilihan yang paling mendekati adalah **$50{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Modus dari data berkelompok berikut adalah..." },
        { "tipe": "paragraph", "text": "Interval: $65-69$, $70-74$, $75-79$, $80-84$" },
        { "tipe": "paragraph", "text": "Frek: $4, 8, 12, 6$" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$76{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$76{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$77{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$77{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$78{,}0$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi kelas modus dan komponen rumusnya**" },
        { "tipe": "paragraph", "text": "Frekuensi terbesar adalah $12$ pada interval $75-79$, sehingga $L = 74{,}5$, $d_1 = 12 - 8 = 4$, $d_2 = 12 - 6 = 6$, dan $c = 5$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai modus ($Mo$)**" },
        { "tipe": "formula_block", "latex": "Mo = L + \\left(\\dfrac{d_1}{d_1 + d_2}\\right) \\cdot c = 74{,}5 + \\left(\\dfrac{4}{4 + 6}\\right) \\cdot 5 = 74{,}5 + 2 = 76{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai modus data tersebut adalah **$76{,}5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-sulit-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika rata-rata 25 data adalah $40$ dan rata-rata 15 data lainnya adalah $60$, maka rata-rata gabungannya adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$47{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$48{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$49$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus rata-rata gabungan dan substitusikan nilai yang diketahui**" },
        { "tipe": "formula_block", "latex": "\\bar{x}_{\\text{gab}} = \\dfrac{n_1 \\bar{x}_1 + n_2 \\bar{x}_2}{n_1 + n_2} = \\dfrac{25(40) + 15(60)}{25 + 15} = \\dfrac{1.000 + 900}{40} = \\dfrac{1.900}{40} = 47{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, rata-rata gabungannya adalah **$47{,}5$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
