        { "tipe": "paragraph", "text": "• $f_k = 20$" },
        { "tipe": "paragraph", "text": "• $f_P = 20$" },
        { "tipe": "paragraph", "text": "• $c = 10$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $P_{75}$**" },
        { "tipe": "paragraph", "text": "$P_{75} = L + \\left(\\dfrac{\\frac{75}{100}n - f_k}{f_P}\\right) \\cdot c$" },
