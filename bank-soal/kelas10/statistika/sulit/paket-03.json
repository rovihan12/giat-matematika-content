      "pilihan": [
        [ { "tipe": "paragraph", "text": "$54{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$55{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$56{,}0$" } ],
        [ { "tipe": "paragraph", "text": "$56{,}5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan letak kelas persentil ke-25 ($P_{25}$)**" },
        { "tipe": "paragraph", "text": "Jumlah frekuensi $n = 5 + 15 + 20 + 10 = 50$." },
        { "tipe": "paragraph", "text": "Letak $P_{25}$ berada pada data ke-$\\dfrac{25}{100} n = \\dfrac{25}{100} \\times 50 = 12{,}5$." },
        { "tipe": "paragraph", "text": "Frekuensi kumulatif: $5$ (kelas 1), $20$ (kelas 2). Data ke-$12{,}5$ berada di kelas kedua, yaitu interval $50-59$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Identifikasi komponen rumus persentil**" },
        { "tipe": "paragraph", "text": "• $L = 50 - 0{,}5 = 49{,}5$" },
        { "tipe": "paragraph", "text": "• $f_k = 5$" },
        { "tipe": "paragraph", "text": "• $f_P = 15$" },
        { "tipe": "paragraph", "text": "• $c = 10$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $P_{25}$**" },
        { "tipe": "paragraph", "text": "$P_{25} = L + \\left(\\dfrac{\\frac{25}{100}n - f_k}{f_P}\\right) \\cdot c$" },
        { "tipe": "paragraph", "text": "$P_{25} = 49{,}5 + \\left(\\dfrac{12{,}5 - 5}{15}\\right) \\cdot 10 = 49{,}5 + \\dfrac{75}{15} = 49{,}5 + 5 = 54{,}5$." }
      ],
      "tingkat": "SULIT"
    },
