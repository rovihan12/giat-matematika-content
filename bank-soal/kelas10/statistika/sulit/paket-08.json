  "soal": [
    {
      "id": "bs-k10-stat-t-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai rata-rata 20 siswa adalah $75$. Setelah 4 siswa baru bergabung dengan nilai masing-masing $80, 82, 88, 98$, rata-rata seluruh siswa adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$76$" } ],
        [ { "tipe": "paragraph", "text": "$76{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$77$" } ],
        [ { "tipe": "paragraph", "text": "$77{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$78$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah nilai 20 siswa awal dan 4 siswa baru**" },
        { "tipe": "paragraph", "text": "• Jumlah nilai 20 siswa $= 20 \\times 75 = 1.500$" },
        { "tipe": "paragraph", "text": "• Jumlah nilai 4 siswa baru $= 80 + 82 + 88 + 98 = 348$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung rata-rata gabungan 24 siswa**" },
        { "tipe": "paragraph", "text": "$\\bar{x}_{\\text{gab}} = \\dfrac{1.500 + 348}{20 + 4} = \\dfrac{1.848}{24} = 77$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-stat-t-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Data nilai: $60, 65, 70, 75, 80, 85, 90, 95$. Jika nilai $60$ dan $95$ dikeluarkan, rata-rata data tersisa adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$72{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$75{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$76$" } ],
        [ { "tipe": "paragraph", "text": "$77{,}5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung jumlah seluruh 8 data**" },
        { "tipe": "paragraph", "text": "Jumlah 8 data $= 60 + 65 + 70 + 75 + 80 + 85 + 90 + 95 = 620$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Kurangi dengan nilai $60$ dan $95$ untuk mendapatkan jumlah 6 data tersisa**" },
        { "tipe": "paragraph", "text": "Jumlah 6 data tersisa $= 620 - 60 - 95 = 465$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung rata-rata 6 data tersisa**" },
        { "tipe": "paragraph", "text": "$\\bar{x}_{\\text{baru}} = \\dfrac{465}{6} = 77{,}5$." }
      ],
      "tingkat": "SULIT"
    },
    {
