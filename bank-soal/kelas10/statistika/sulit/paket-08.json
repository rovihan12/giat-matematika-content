        { "tipe": "paragraph", "text": "• Jumlah 9 data awal $= 9 \\times 8 = 72$" },
        { "tipe": "paragraph", "text": "• Jumlah 10 data akhir $= 10 \\times 8{,}5 = 85$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari nilai data tambahan $x$**" },
        { "tipe": "paragraph", "text": "$x = 85 - 72 = 13$." }
