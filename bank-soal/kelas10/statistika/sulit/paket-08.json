        { "tipe": "paragraph", "text": "Jumlah awal $= 5 \\times 12 = 60$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung jumlah baru setelah mengganti $6$ menjadi $16$**" },
        { "tipe": "paragraph", "text": "Jumlah baru $= 60 - 6 + 16 = 70$." },
