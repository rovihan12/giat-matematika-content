  "soal": [
    {
      "id": "bs-k10-spl-s-08-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Umur Ayah 3 kali umur Anak. 5 tahun lagi jumlah umur mereka 62. Umur Anak sekarang adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$11$ tahun" }],
        [{ "tipe": "paragraph", "text": "$12$ tahun" }],
        [{ "tipe": "paragraph", "text": "$13$ tahun" }],
        [{ "tipe": "paragraph", "text": "$14$ tahun" }],
        [{ "tipe": "paragraph", "text": "$15$ tahun" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$A=3a$; $(A+5)+(a+5)=62 \\Rightarrow 4a+10=62 \\Rightarrow a=13$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-08-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "A dan B bekerja bersama menyelesaikan proyek dalam 4 hari. A sendiri 12 hari. B sendiri berapa hari?" }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$ hari" }],
        [{ "tipe": "paragraph", "text": "$6$ hari" }],
        [{ "tipe": "paragraph", "text": "$7$ hari" }],
        [{ "tipe": "paragraph", "text": "$8$ hari" }],
        [{ "tipe": "paragraph", "text": "$9$ hari" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{1}{12} + \\dfrac{1}{b} = \\dfrac{1}{4} \\Rightarrow \\dfrac{1}{b} = \\dfrac{1}{4} - \\dfrac{1}{12} = \\dfrac{2}{12} = \\dfrac{1}{6} \\Rightarrow b=6$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-08-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sebuah pesawat terbang 3 jam dengan angin, 4 jam melawan angin. Kecepatan angin 20 km/jam. Kecepatan pesawat di udara tenang adalah..." }],
      "pilihan": [
