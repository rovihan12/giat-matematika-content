        [{ "tipe": "paragraph", "text": "$-1 < x < 4$" }],
        [{ "tipe": "paragraph", "text": "$x < -4$ atau $x > 1$" }],
        [{ "tipe": "paragraph", "text": "$-4 < x < 1$" }],
        [{ "tipe": "paragraph", "text": "$x > 4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
