        { "tipe": "paragraph", "text": "Uji $x=-3$: $\\dfrac{7}{-1} < 0$ ✗; $x=0$: $\\dfrac{4}{2} > 0$ ✓; $x=5$: $\\dfrac{-1}{7} < 0$ ✗." },
        { "tipe": "paragraph", "text": "HP: $-2 < x \\leq 4$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-07-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Andi membeli 2 buku dan 3 pena Rp32.000. Budi membeli 3 buku dan 2 pena Rp38.000. Harga 1 buku adalah..." }],
