        [{ "tipe": "paragraph", "text": "Rp7.000" }],
        [{ "tipe": "paragraph", "text": "Rp8.000" }],
        [{ "tipe": "paragraph", "text": "Rp9.000" }],
        [{ "tipe": "paragraph", "text": "Rp10.000" }]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sistem persamaan: $2b + 3p = 32.000$ dan $3b + 2p = 38.000$." },
        { "tipe": "paragraph", "text": "Eliminasi $p$: $3(3b + 2p) - 2(2b + 3p) = 3(38.000) - 2(32.000)$" },
        { "tipe": "paragraph", "text": "$5b = 114.000 - 64.000 = 50.000 \\Rightarrow b = 10.000$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-07-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{2x - 3}{x + 1} > 1$ adalah..." }],
