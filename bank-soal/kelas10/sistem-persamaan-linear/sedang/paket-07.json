        [{ "tipe": "paragraph", "text": "Rp16.000" }],
        [{ "tipe": "paragraph", "text": "Rp17.000" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$10p - 120.000 \\geq 30.000 \\Rightarrow 10p \\geq 150.000 \\Rightarrow p \\geq 15.000$." }
