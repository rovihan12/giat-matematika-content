      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-07-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Rina ingin membeli 3 buku dan 2 pena dengan uang Rp50.000. Jika harga 1 pena Rp4.000, harga maksimum 1 buku agar uangnya cukup adalah..." }],
