  "soal": [
    {
      "id": "bs-k10-spl-s-07-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{3x - 1}{2} < \\dfrac{x + 5}{3}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < \\dfrac{13}{7}$" }],
        [{ "tipe": "paragraph", "text": "$x > \\dfrac{13}{7}$" }],
        [{ "tipe": "paragraph", "text": "$x < \\dfrac{7}{13}$" }],
        [{ "tipe": "paragraph", "text": "$x > \\dfrac{7}{13}$" }],
        [{ "tipe": "paragraph", "text": "$x < 2$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3(3x-1) < 2(x+5) \\Rightarrow 9x-3 < 2x+10 \\Rightarrow 7x < 13 \\Rightarrow x < 13/7$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-07-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\dfrac{2x + 3}{x - 1} > 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < -\\dfrac{3}{2}$ atau $x > 1$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{3}{2} < x < 1$" }],
        [{ "tipe": "paragraph", "text": "$x < -\\dfrac{3}{2}$ atau $x < 1$" }],
        [{ "tipe": "paragraph", "text": "$x > -\\dfrac{3}{2}$ atau $x < 1$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{3}{2} < x < -1$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik kritis: $x = -3/2$, $x = 1$ (dikecualikan)." },
        { "tipe": "paragraph", "text": "Uji $x=-2$: $\\dfrac{-1}{-3} > 0$ ✓; $x=0$: $\\dfrac{3}{-1} < 0$ ✗; $x=2$: $\\dfrac{7}{1} > 0$ ✓." },
        { "tipe": "paragraph", "text": "HP: $x < -3/2$ atau $x > 1$." }
      ],
      "tingkat": "SEDANG"
    },
    {
