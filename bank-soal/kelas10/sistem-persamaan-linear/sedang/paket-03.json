{
  "id": "bs-k10-spl-s-03",
  "nama": "Bank Soal Sedang - Paket 3",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang sistem persamaan dengan parameter",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-s-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + y = 5$ dan $2x + ay = 8$ tidak memiliki solusi jika nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sistem tidak punya solusi jika kedua garis sejajar (koefisien proporsional, konstanta tidak)." },
        { "tipe": "paragraph", "text": "$\\dfrac{2}{1} = \\dfrac{a}{1} \\neq \\dfrac{8}{5}$" },
        { "tipe": "paragraph", "text": "Dari $\\dfrac{2}{1} = \\dfrac{a}{1} \\Rightarrow a = 2$" },
        { "tipe": "paragraph", "text": "Cek: $\\dfrac{2}{1} = \\dfrac{2}{1} = 2 \\neq \\dfrac{8}{5}$ ✓" },
        { "tipe": "paragraph", "text": "Jadi $a = 2$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $3x + 2y = 12$ dan $6x + 4y = k$ memiliki tak hingga solusi jika $k$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tak hingga solusi jika kedua persamaan identik (proporsional semua)." },
        { "tipe": "paragraph", "text": "$\\dfrac{6}{3} = \\dfrac{4}{2} = \\dfrac{k}{12} \\Rightarrow 2 = \\dfrac{k}{12} \\Rightarrow k = 24$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $x - y = 3$ dan $2x + ay = 6$ memiliki tepat satu solusi. Nilai $a$ yang TIDAK mungkin adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-2$" } ],
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tepat satu solusi jika $\\dfrac{2}{1} \\neq \\dfrac{a}{-1} \\Rightarrow a \\neq -2$." },
        { "tipe": "paragraph", "text": "Jadi $a = -2$ membuat sistem tidak punya solusi (garis sejajar)." },
        { "tipe": "paragraph", "text": "Nilai $a$ yang tidak mungkin untuk tepat satu solusi = $-2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika sistem $ax + 3y = 6$ dan $2x + y = 4$ memiliki solusi tunggal $(x, y) = (2, 0)$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $(2, 0)$ ke $ax + 3y = 6$: $2a + 0 = 6 \\Rightarrow a = 3$." },
        { "tipe": "paragraph", "text": "Cek dengan $2x + y = 4$: $4 + 0 = 4$ ✓" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + 2y = 5$ dan $3x + ky = 15$ memiliki tak hingga solusi jika $k$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tak hingga solusi jika proporsional: $\\dfrac{3}{1} = \\dfrac{k}{2} = \\dfrac{15}{5}$." },
        { "tipe": "paragraph", "text": "$3 = \\dfrac{k}{2} \\Rightarrow k = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $2x - y = 4$ dan $4x - 2y = m$ TIDAK memiliki solusi jika $m$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tidak punya solusi jika $\\dfrac{4}{2} = \\dfrac{-2}{-1} \\neq \\dfrac{m}{4}$." },
        { "tipe": "paragraph", "text": "$2 = 2 \\neq \\dfrac{m}{4} \\Rightarrow m \\neq 8$" },
        { "tipe": "paragraph", "text": "Jadi TIDAK punya solusi untuk $m \\neq 8$. Dari opsi, $m = 6$ adalah salah satu nilai yang memenuhi." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $x + y = 3$ dan $ax + 2y = 6$. Jika sistem memiliki solusi tunggal, maka nilai $a$ yang TIDAK boleh adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi tunggal jika $\\dfrac{a}{1} \\neq \\dfrac{2}{1} \\Rightarrow a \\neq 2$." },
        { "tipe": "paragraph", "text": "Jika $a = 2$: cek apakah tak hingga solusi atau tidak punya solusi." },
        { "tipe": "paragraph", "text": "$\\dfrac{2}{1} = \\dfrac{2}{1} = \\dfrac{6}{3} = 2$ → tak hingga solusi." },
        { "tipe": "paragraph", "text": "Jadi $a = 2$ bukan solusi tunggal." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $kx + 2y = 8$ dan $3x + y = 4$ memiliki solusi tunggal. Nilai $k$ yang TIDAK diperbolehkan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi tunggal jika $\\dfrac{k}{3} \\neq \\dfrac{2}{1} \\Rightarrow k \\neq 6$." },
        { "tipe": "paragraph", "text": "Jadi $k = 6$ tidak diperbolehkan (akan membuat garis sejajar/tidak punya solusi)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $x + y = 4$ dan $2x + 2y = k$ memiliki tak hingga solusi. Nilai $k$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Tak hingga solusi: $\\dfrac{2}{1} = \\dfrac{2}{1} = \\dfrac{k}{4} \\Rightarrow k = 8$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Agar sistem $2x + 3y = 5$ dan $4x + ay = 10$ memiliki TAK HINGGA solusi, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Proporsional: $\\dfrac{4}{2} = \\dfrac{a}{3} = \\dfrac{10}{5}$." },
        { "tipe": "paragraph", "text": "$2 = \\dfrac{a}{3} \\Rightarrow a = 6$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
