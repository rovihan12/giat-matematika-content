    },
    {
      "id": "bs-k10-spl-s-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $x + y = 5$, $y + z = 7$, dan $x + z = 6$. Nilai $xyz$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x + y + z = \\dfrac{5 + 7 + 6}{2} = 9$" },
        { "tipe": "paragraph", "text": "$x = 9 - 7 = 2$; $y = 9 - 6 = 3$; $z = 9 - 5 = 4$" },
        { "tipe": "paragraph", "text": "$xyz = 2 \\cdot 3 \\cdot 4 = 24$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $x + y + z = 12$, $x - y = 2$, dan $y - z = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(6, 4, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(5, 3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(7, 5, 0)$" } ],
        [ { "tipe": "paragraph", "text": "$(6, 3, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(5, 4, 3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $x - y = 2 \\Rightarrow x = y + 2$" },
        { "tipe": "paragraph", "text": "Dari $y - z = 2 \\Rightarrow z = y - 2$" },
        { "tipe": "paragraph", "text": "Substitusi: $(y + 2) + y + (y - 2) = 12 \\Rightarrow 3y = 12 \\Rightarrow y = 4$" },
        { "tipe": "paragraph", "text": "$x = 6$, $z = 2$. HP = $(6, 4, 2)$" }
      ],
      "tingkat": "SEDANG"
    },
    {
