      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $x + y + z = 6$, $2x - y + z = 3$, dan $x + 2y - z = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, 2, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 1, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 1, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "(i) $x + y + z = 6$; (ii) $2x - y + z = 3$; (iii) $x + 2y - z = 2$" },
        { "tipe": "paragraph", "text": "(ii) $-$ (i): $x - 2y = -3$ … (iv)" },
        { "tipe": "paragraph", "text": "(iii) + (i): $2x + 3y = 8$ … (v)" },
        { "tipe": "paragraph", "text": "Dari (iv): $x = 2y - 3$. Substitusi (v): $4y - 6 + 3y = 8 \\Rightarrow 7y = 14 \\Rightarrow y = 2$" },
        { "tipe": "paragraph", "text": "$x = 1$; dari (i): $1 + 2 + z = 6 \\Rightarrow z = 3$" },
        { "tipe": "paragraph", "text": "HP = $\\{(1, 2, 3)\\}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $z$ dari sistem $x + y + z = 8$, $x - y + z = 6$, dan $x + y - z = 4$ adalah..." }
