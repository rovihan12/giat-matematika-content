{
  "id": "bs-k10-spl-s-10",
  "nama": "Bank Soal Sedang - Paket 10",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SEDANG",
  "deskripsi": "Campuran soal sedang: SPLTV, pertidaksamaan, dan aplikasi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-s-10-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian $x + y + z = 8$, $x - y + z = 4$, $x + y - z = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(3, 2, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 2, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 2, 2)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $z$ dan $x$ untuk memperoleh nilai variabel lainnya**" },
        { "tipe": "formula_block", "latex": "(x + y + z) + (x + y - z) = 8 + 2 \\Rightarrow 2x + 2y = 10 \\Rightarrow x + y = 5" },
        { "tipe": "formula_block", "latex": "(x + y + z) - (x - y + z) = 8 - 4 \\Rightarrow 2y = 4 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $y = 2$ untuk memperoleh $x$ dan $z$**" },
        { "tipe": "formula_block", "latex": "x + 2 = 5 \\Rightarrow x = 3 \\qquad \\text{dan} \\qquad 3 + 2 + z = 8 \\Rightarrow z = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, penyelesaian sistem tersebut adalah **$(3, 2, 3)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|3x - 2| \\leq 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{3} \\leq x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq \\dfrac{5}{3}$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -\\dfrac{5}{3}$ atau $x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$-\\dfrac{5}{3} < x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Ubah pertidaksamaan nilai mutlak menjadi pertidaksamaan rangkap**" },
        { "tipe": "formula_block", "latex": "|3x - 2| \\leq 7 \\Rightarrow -7 \\leq 3x - 2 \\leq 7" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tambahkan $2$ pada setiap bagian lalu bagi dengan $3$**" },
        { "tipe": "formula_block", "latex": "-7 + 2 \\leq 3x \\leq 7 + 2 \\Rightarrow -5 \\leq 3x \\leq 9 \\Rightarrow -\\dfrac{5}{3} \\leq x \\leq 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-\\dfrac{5}{3} \\leq x \\leq 3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x \\cdot y \\cdot z$ dari sistem $x + y = 5$, $y + z = 7$, $x + z = 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$21$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jumlahkan ketiga persamaan untuk memperoleh $x + y + z$, lalu cari masing-masing variabel**" },
        { "tipe": "formula_block", "latex": "2(x + y + z) = 5 + 7 + 6 = 18 \\Rightarrow x + y + z = 9" },
        { "tipe": "formula_block", "latex": "z = 9 - 5 = 4, \\qquad x = 9 - 7 = 2, \\qquad y = 9 - 6 = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai perkalian $x \\cdot y \\cdot z$**" },
        { "tipe": "formula_block", "latex": "x \\cdot y \\cdot z = 2 \\cdot 3 \\cdot 4 = 24" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x \\cdot y \\cdot z$ adalah **$24$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Seorang pedagang membeli 20 kg apel Rp300.000. Ia ingin untung minimal 20%. Harga jual minimal per kg adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp16.000" } ],
        [ { "tipe": "paragraph", "text": "Rp17.000" } ],
        [ { "tipe": "paragraph", "text": "Rp18.000" } ],
        [ { "tipe": "paragraph", "text": "Rp19.000" } ],
        [ { "tipe": "paragraph", "text": "Rp20.000" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hitung total hasil penjualan minimal dengan untung $20\\%$**" },
        { "tipe": "formula_block", "latex": "\\text{Total jual minimal} = 300.000 + 20\\% \\times 300.000 = 300.000 + 60.000 = 360.000" },
        { "tipe": "paragraph", "text": "**Langkah 2: Bagi total penjualan minimal dengan berat apel ($20$ kg)**" },
        { "tipe": "formula_block", "latex": "\\text{Harga jual minimal per kg} = \\dfrac{360.000}{20} = 18.000" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, harga jual minimal per kg adalah **Rp18.000**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $2x + 3y = 13$ dan $4x - y = 5$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan $y$ dari persamaan kedua lalu substitusikan ke persamaan pertama**" },
        { "tipe": "formula_block", "latex": "4x - y = 5 \\Rightarrow y = 4x - 5" },
        { "tipe": "formula_block", "latex": "2x + 3(4x - 5) = 13 \\Rightarrow 14x - 15 = 13 \\Rightarrow 14x = 28 \\Rightarrow x = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $y$ dan hitung $x + y$**" },
        { "tipe": "formula_block", "latex": "y = 4(2) - 5 = 3 \\Rightarrow x + y = 2 + 3 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{2x + 1}{x - 2} \\leq 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$-3 \\leq x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$-3 < x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$ atau $x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$ atau $x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$-3 \\leq x \\leq 2$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pindahkan $1$ ke ruas kiri dan samakan penyebut**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2x + 1}{x - 2} - 1 \\leq 0 \\Rightarrow \\dfrac{(2x + 1) - (x - 2)}{x - 2} \\leq 0 \\Rightarrow \\dfrac{x + 3}{x - 2} \\leq 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan titik kritis dan uji tanda pada interval (dengan $x \\neq 2$)**" },
        { "tipe": "formula_block", "latex": "x = -3 \\text{ (termasuk)} \\quad \\text{dan} \\quad x = 2 \\text{ (dikecualikan)} \\Rightarrow -3 \\leq x < 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-3 \\leq x < 2$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Umur Ibu 4 tahun lebih muda dari Ayah. 6 tahun lalu jumlah umur mereka 60. Umur Ibu sekarang adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$30$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$31$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$32$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$33$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$34$ tahun" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun persamaan selisih umur sekarang dan jumlah umur enam tahun lalu**" },
        { "tipe": "paragraph", "text": "Misalkan umur Ayah sekarang adalah $A$ dan umur Ibu sekarang adalah $I$ (dalam tahun)." },
        { "tipe": "formula_block", "latex": "I = A - 4 \\qquad \\text{dan} \\qquad (A - 6) + (I - 6) = 60 \\Rightarrow A + I = 72" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $I = A - 4$ untuk memperoleh umur Ayah dan Ibu sekarang**" },
        { "tipe": "formula_block", "latex": "A + (A - 4) = 72 \\Rightarrow 2A = 76 \\Rightarrow A = 38, \\qquad I = 38 - 4 = 34" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, umur Ibu sekarang adalah **$34$ tahun**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai minimum $f = 2x + 3y$ pada $x + y \\geq 5$, $x + 3y \\geq 6$, $x, y \\geq 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik-titik sudut daerah penyelesaian**" },
        { "tipe": "formula_block", "latex": "(5, 0), \\quad (0, 5), \\quad \\text{dan potong } x + y = 5 \\text{ dengan } x + 3y = 6 \\Rightarrow \\left(\\dfrac{9}{2}, \\dfrac{1}{2}\\right)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Evaluasi fungsi objektif $f = 2x + 3y$ pada setiap titik sudut**" },
        { "tipe": "formula_block", "latex": "f(5, 0) = 10, \\quad f(0, 5) = 15, \\quad f\\left(\\dfrac{9}{2}, \\dfrac{1}{2}\\right) = 2\\left(\\dfrac{9}{2}\\right) + 3\\left(\\dfrac{1}{2}\\right) = 9 + 1{,}5 = 10{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum $f = 2x + 3y$ adalah **$10$** (di titik $(5, 0)$)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x - 3| > 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < -1$ atau $x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$-1 < x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan pertidaksamaan nilai mutlak menjadi dua kasus**" },
        { "tipe": "formula_block", "latex": "x - 3 < -2 \\qquad \\text{atau} \\qquad x - 3 > 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan masing-masing pertidaksamaan untuk $x$**" },
        { "tipe": "formula_block", "latex": "x < -2 + 3 \\Rightarrow x < 1 \\qquad \\text{atau} \\qquad x > 2 + 3 \\Rightarrow x > 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x < 1$ atau $x > 5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-10-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan jumlahnya 36. Bilangan kedua 2 kali pertama, ketiga 6 lebih dari kedua. Bilangan terbesar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan ketiga bilangan dalam variabel $a$ lalu jumlahkan sama dengan $36$**" },
        { "tipe": "paragraph", "text": "Misalkan bilangan pertama adalah $a$, maka bilangan kedua adalah $b = 2a$ dan bilangan ketiga adalah $c = b + 6 = 2a + 6$." },
        { "tipe": "formula_block", "latex": "a + 2a + (2a + 6) = 36 \\Rightarrow 5a + 6 = 36 \\Rightarrow 5a = 30 \\Rightarrow a = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan ketiga bilangan dan pilih bilangan terbesar**" },
        { "tipe": "formula_block", "latex": "a = 6, \\qquad b = 2(6) = 12, \\qquad c = 12 + 6 = 18" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bilangan terbesar dari ketiga bilangan tersebut adalah **$18$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
