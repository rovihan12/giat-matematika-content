        [{ "tipe": "paragraph", "text": "$(1, 3, 5)$" }],
        [{ "tipe": "paragraph", "text": "$(3, 2, 4)$" }],
        [{ "tipe": "paragraph", "text": "$(2, 4, 3)$" }],
        [{ "tipe": "paragraph", "text": "$(4, 2, 3)$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Verifikasi $(2,3,4)$: (i) $2+3+4=9$ ✓; (ii) $4-3+4=5$ ✓; (iii) $2+6-4=4$ ✓." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $z$ dari sistem $x + y + z = 10$, $2x - y + z = 7$, dan $x + 2y - z = 5$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Mengeliminasi variabel $x$ dan $y$ diperoleh solusi $(3, 3, 4)$. Jadi nilai $z = 4$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y \\leq 8$, $2x + y \\geq 10$, $x \\geq 0$, $y \\geq 0$. Titik yang merupakan titik sudut daerah penyelesaian adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$(0, 8)$ dan $(5, 0)$" }],
        [{ "tipe": "paragraph", "text": "$(0, 10)$ dan $(8, 0)$" }],
