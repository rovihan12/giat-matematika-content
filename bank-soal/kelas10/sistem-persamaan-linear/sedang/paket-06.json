        [{ "tipe": "paragraph", "text": "$(0, 0)$ dan $(8, 0)$" }],
        [{ "tipe": "paragraph", "text": "$(5, 0)$ dan $(8, 0)$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik potong dengan sumbu: $x+y=8$ → $(0,8),(8,0)$; $2x+y=10$ → $(0,10),(5,0)$." },
        { "tipe": "paragraph", "text": "Titik sudut daerah penyelesaian: $(0,8)$, $(5,0)$, dan titik potong $(2,6)$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x + y + z$ dari sistem $2x + y + z = 7$, $x + 2y + z = 8$, $x + y + 2z = 9$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$9$" }],
        [{ "tipe": "paragraph", "text": "$10$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan ketiga persamaan: $4x + 4y + 4z = 24 \\Rightarrow 4(x + y + z) = 24 \\Rightarrow x + y + z = 6$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y \\geq 4$, $x + 2y \\leq 8$, $x \\geq 0$, $y \\geq 0$. Titik $(0, 5)$..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "Memenuhi semua kendala" }],
        [{ "tipe": "paragraph", "text": "Tidak memenuhi $x + y \\geq 4$" }],
        [{ "tipe": "paragraph", "text": "Tidak memenuhi $x + 2y \\leq 8$" }],
        [{ "tipe": "paragraph", "text": "Tidak memenuhi $x \\geq 0$" }],
        [{ "tipe": "paragraph", "text": "Tidak memenuhi $y \\geq 0$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Uji titik $(0,5)$: $0+5 = 5 \\geq 4$ (memenuhi), namun $0+2(5) = 10 \\nleq 8$ (tidak memenuhi)." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian sistem $y \\geq x + 1$ dan $y \\leq 2x - 1$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x \\geq 2$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq 2$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 1$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq 1$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 3$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x+1 \\leq 2x-1 \\Rightarrow 2 \\leq x \\Rightarrow x \\geq 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x \\cdot y$ dari sistem $x + y + z = 6$, $x - y + z = 2$, $x + y - z = 0$ adalah..." }],
      "pilihan": [
