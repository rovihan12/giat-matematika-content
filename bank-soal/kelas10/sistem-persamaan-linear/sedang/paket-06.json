      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari eliminasi diperoleh $x = 1, y = 2, z = 3$." },
        { "tipe": "paragraph", "text": "Maka nilai $x \\cdot y = 1 \\cdot 2 = 2$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem pertidaksamaan $x + y \\leq 6$, $2x + y \\geq 8$, $x \\geq 0$, $y \\geq 0$ memiliki titik sudut..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$(0, 6), (4, 0), (2, 4)$" }],
