      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik sudut: $(0,6)$, $(4,0)$ [dari $2x+y=8$], dan potong $x+y=6$ & $2x+y=8$: $x=2, y=4$." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-06-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Diketahui $x + y = 7$, $y + z = 9$, $x + z = 8$. Nilai $x \\cdot y \\cdot z$ adalah..." }],
