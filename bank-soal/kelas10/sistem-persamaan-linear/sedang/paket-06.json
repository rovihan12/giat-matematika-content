        [{ "tipe": "paragraph", "text": "$(0, 6), (2, 4), (3, 0)$" }],
        [{ "tipe": "paragraph", "text": "$(0, 6), (4, 0), (3, 2)$" }],
        [{ "tipe": "paragraph", "text": "$(0, 8), (4, 0), (2, 4)$" }]
