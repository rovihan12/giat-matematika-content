  "soal": [
    {
      "id": "bs-k10-spl-s-06-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Penyelesaian sistem $x + y + z = 9$, $2x - y + z = 5$, dan $x + 2y - z = 4$ adalah..." }],
