{
  "id": "bs-k10-spl-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang SPLDV dengan bentuk pecahan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian dari sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = 1$ dan $\\dfrac{2}{x} - \\dfrac{1}{y} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1{,}5;\\ 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(3;\\ 1{,}5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2,\\ 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(1,\\ 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(3,\\ 3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan variabel baru lalu eliminasi untuk memperoleh nilai $x$**" },
        { "tipe": "paragraph", "text": "Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, sehingga diperoleh $a + b = 1$ dan $2a - b = 1$." },
        { "tipe": "formula_block", "latex": "(a + b) + (2a - b) = 1 + 1 \\Rightarrow 3a = 2 \\Rightarrow a = \\dfrac{2}{3} \\Rightarrow x = \\dfrac{3}{2} = 1{,}5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $a = \\dfrac{2}{3}$ untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{3} + b = 1 \\Rightarrow b = \\dfrac{1}{3} \\Rightarrow y = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, penyelesaian dari sistem tersebut adalah **$(1{,}5;\\ 3)$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x + y$ dari sistem $\\dfrac{2}{x} + \\dfrac{3}{y} = 2$ dan $\\dfrac{4}{x} - \\dfrac{3}{y} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, lalu tentukan nilai $x$ dan $y$**" },
        { "tipe": "formula_block", "latex": "(2a + 3b) + (4a - 3b) = 2 + 1 \\Rightarrow 6a = 3 \\Rightarrow a = \\dfrac{1}{2} \\Rightarrow x = 2" },
        { "tipe": "formula_block", "latex": "2\\left(\\dfrac{1}{2}\\right) + 3b = 2 \\Rightarrow 3b = 1 \\Rightarrow b = \\dfrac{1}{3} \\Rightarrow y = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x + y$**" },
        { "tipe": "formula_block", "latex": "x + y = 2 + 3 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{x + y}{2} = 5$ dan $\\dfrac{x - y}{3} = 1$, nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hilangkan penyebut pada kedua persamaan**" },
        { "tipe": "formula_block", "latex": "\\dfrac{x + y}{2} = 5 \\Rightarrow x + y = 10, \\qquad \\dfrac{x - y}{3} = 1 \\Rightarrow x - y = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan kedua persamaan untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(x + y) + (x - y) = 10 + 3 \\Rightarrow 2x = 13 \\Rightarrow x = 6{,}5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ adalah **$6{,}5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = 3$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = 1$ memiliki nilai $x \\cdot y$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, lalu tentukan nilai $x$ dan $y$**" },
        { "tipe": "formula_block", "latex": "(a + b) + (a - b) = 3 + 1 \\Rightarrow 2a = 4 \\Rightarrow a = 2 \\Rightarrow x = \\dfrac{1}{2}" },
        { "tipe": "formula_block", "latex": "2 + b = 3 \\Rightarrow b = 1 \\Rightarrow y = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x \\cdot y$**" },
        { "tipe": "formula_block", "latex": "x \\cdot y = \\dfrac{1}{2} \\cdot 1 = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x \\cdot y$ sama dengan **$\\dfrac{1}{2}$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{a} - \\dfrac{1}{b} = \\dfrac{1}{6}$ dan $\\dfrac{1}{a} + \\dfrac{1}{b} = \\dfrac{1}{2}$, maka nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $p = \\dfrac{1}{a}$ dan $q = \\dfrac{1}{b}$, lalu eliminasi variabel $q$**" },
        { "tipe": "formula_block", "latex": "(p - q) + (p + q) = \\dfrac{1}{6} + \\dfrac{1}{2} \\Rightarrow 2p = \\dfrac{1}{6} + \\dfrac{3}{6} = \\dfrac{4}{6} = \\dfrac{2}{3}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $p$ dan nilai $a$**" },
        { "tipe": "formula_block", "latex": "p = \\dfrac{1}{3} \\Rightarrow \\dfrac{1}{a} = \\dfrac{1}{3} \\Rightarrow a = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a$ adalah **$3$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $\\dfrac{x}{2} + \\dfrac{y}{3} = \\dfrac{5}{2}$ dan $\\dfrac{x}{3} + \\dfrac{y}{2} = \\dfrac{5}{2}$ memiliki nilai $x + y$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kalikan kedua persamaan dengan $6$ untuk menghilangkan penyebut**" },
        { "tipe": "formula_block", "latex": "3x + 2y = 15 \\qquad \\text{dan} \\qquad 2x + 3y = 15" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kurangkan kedua persamaan lalu tentukan nilai $x$, $y$, dan $x + y$**" },
        { "tipe": "formula_block", "latex": "(3x + 2y) - (2x + 3y) = 15 - 15 \\Rightarrow x - y = 0 \\Rightarrow x = y" },
        { "tipe": "formula_block", "latex": "3x + 2x = 15 \\Rightarrow 5x = 15 \\Rightarrow x = 3, \\quad y = 3 \\Rightarrow x + y = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ sama dengan **$6$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $y$ dari sistem $\\dfrac{2}{x} + \\dfrac{1}{y} = 3$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hubungkan $x$ dan $y$ dari persamaan kedua**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{x} - \\dfrac{1}{y} = 0 \\Rightarrow \\dfrac{1}{x} = \\dfrac{1}{y} \\Rightarrow x = y" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = y$ ke persamaan pertama untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2}{y} + \\dfrac{1}{y} = 3 \\Rightarrow \\dfrac{3}{y} = 3 \\Rightarrow y = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $y$ dari sistem tersebut adalah **$1$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\dfrac{3}{x} - \\dfrac{2}{y} = 0$ dan $\\dfrac{2}{x} + \\dfrac{3}{y} = \\dfrac{13}{6}$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, lalu selesaikan sistem persamaan**" },
        { "tipe": "formula_block", "latex": "3a - 2b = 0 \\Rightarrow a = \\dfrac{2}{3}b" },
        { "tipe": "formula_block", "latex": "2\\left(\\dfrac{2}{3}b\\right) + 3b = \\dfrac{13}{6} \\Rightarrow \\dfrac{4}{3}b + \\dfrac{9}{3}b = \\dfrac{13}{6} \\Rightarrow \\dfrac{13}{3}b = \\dfrac{13}{6} \\Rightarrow b = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$, $y$, dan hitung $x + y$**" },
        { "tipe": "formula_block", "latex": "b = \\dfrac{1}{2} \\Rightarrow y = 2, \\qquad a = \\dfrac{2}{3}\\left(\\dfrac{1}{2}\\right) = \\dfrac{1}{3} \\Rightarrow x = 3 \\Rightarrow x + y = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\dfrac{x+1}{2} + \\dfrac{y-1}{3} = 3$ dan $\\dfrac{x-1}{3} + \\dfrac{y+1}{2} = 4$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kalikan kedua persamaan dengan $6$ untuk menyederhanakan bentuk pecahan**" },
        { "tipe": "formula_block", "latex": "3(x + 1) + 2(y - 1) = 18 \\Rightarrow 3x + 2y + 1 = 18 \\Rightarrow 3x + 2y = 17" },
        { "tipe": "formula_block", "latex": "2(x - 1) + 3(y + 1) = 24 \\Rightarrow 2x + 3y + 1 = 24 \\Rightarrow 2x + 3y = 23" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jumlahkan kedua persamaan untuk memperoleh nilai $x + y$**" },
        { "tipe": "formula_block", "latex": "(3x + 2y) + (2x + 3y) = 17 + 23 \\Rightarrow 5(x + y) = 40 \\Rightarrow x + y = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$8$**." }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{2}{x} + \\dfrac{3}{y} = 12$ dan $\\dfrac{3}{x} - \\dfrac{2}{y} = 5$, nilai $\\dfrac{1}{x} + \\dfrac{1}{y}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, lalu eliminasi variabel $b$**" },
        { "tipe": "formula_block", "latex": "2(2a + 3b) + 3(3a - 2b) = 2(12) + 3(5) \\Rightarrow 4a + 9a = 24 + 15 \\Rightarrow 13a = 39 \\Rightarrow a = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $a = 3$ untuk memperoleh nilai $b$ lalu hitung $a + b$**" },
        { "tipe": "formula_block", "latex": "2(3) + 3b = 12 \\Rightarrow 3b = 6 \\Rightarrow b = 2 \\Rightarrow \\dfrac{1}{x} + \\dfrac{1}{y} = 3 + 2 = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{1}{x} + \\dfrac{1}{y}$ adalah **$5$**." }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
