{
  "id": "bs-k10-spl-s-01",
  "nama": "Bank Soal Sedang - Paket 1",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SEDANG",
  "deskripsi": "Soal sedang tentang SPLDV dengan bentuk pecahan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-s-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian dari sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = 1$ dan $\\dfrac{2}{x} - \\dfrac{1}{y} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1{,}5;\\ 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(3;\\ 1{,}5)$" } ],
        [ { "tipe": "paragraph", "text": "$(2,\\ 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(1,\\ 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(3,\\ 3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$." },
        { "tipe": "paragraph", "text": "$a + b = 1$ dan $2a - b = 1$." },
        { "tipe": "paragraph", "text": "Jumlahkan: $3a = 2 \\Rightarrow a = \\dfrac{2}{3}$" },
        { "tipe": "paragraph", "text": "Substitusi: $\\dfrac{2}{3} + b = 1 \\Rightarrow b = \\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "$x = \\dfrac{3}{2} = 1{,}5$ dan $y = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x + y$ dari sistem $\\dfrac{2}{x} + \\dfrac{3}{y} = 2$ dan $\\dfrac{4}{x} - \\dfrac{3}{y} = 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a = \\dfrac{1}{x}$, $b = \\dfrac{1}{y}$." },
        { "tipe": "paragraph", "text": "$2a + 3b = 2$ … (i); $4a - 3b = 1$ … (ii)" },
        { "tipe": "paragraph", "text": "(i)+(ii): $6a = 3 \\Rightarrow a = \\dfrac{1}{2} \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "Substitusi (i): $1 + 3b = 2 \\Rightarrow b = \\dfrac{1}{3} \\Rightarrow y = 3$" },
        { "tipe": "paragraph", "text": "$x + y = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{x + y}{2} = 5$ dan $\\dfrac{x - y}{3} = 1$, nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6{,}5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x + y = 10$ … (i); $x - y = 3$ … (ii)" },
        { "tipe": "paragraph", "text": "(i) + (ii): $2x = 13 \\Rightarrow x = 6{,}5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = 3$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = 1$ memiliki nilai $x \\cdot y$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a = \\dfrac{1}{x}$, $b = \\dfrac{1}{y}$." },
        { "tipe": "paragraph", "text": "$a + b = 3$; $a - b = 1$" },
        { "tipe": "paragraph", "text": "Jumlahkan: $2a = 4 \\Rightarrow a = 2 \\Rightarrow x = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "Substitusi: $2 + b = 3 \\Rightarrow b = 1 \\Rightarrow y = 1$" },
        { "tipe": "paragraph", "text": "$x \\cdot y = \\dfrac{1}{2}$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{1}{a} - \\dfrac{1}{b} = \\dfrac{1}{6}$ dan $\\dfrac{1}{a} + \\dfrac{1}{b} = \\dfrac{1}{2}$, maka nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $p = \\dfrac{1}{a}$, $q = \\dfrac{1}{b}$." },
        { "tipe": "paragraph", "text": "$p - q = \\dfrac{1}{6}$ dan $p + q = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "Jumlahkan: $2p = \\dfrac{2}{3} \\Rightarrow p = \\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "$a = 3$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $\\dfrac{x}{2} + \\dfrac{y}{3} = \\dfrac{5}{2}$ dan $\\dfrac{x}{3} + \\dfrac{y}{2} = \\dfrac{5}{2}$ memiliki nilai $x + y$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan (i) dengan 6: $3x + 2y = 15$" },
        { "tipe": "paragraph", "text": "Kalikan (ii) dengan 6: $2x + 3y = 15$" },
        { "tipe": "paragraph", "text": "Kurangkan: $x - y = 0 \\Rightarrow x = y$" },
        { "tipe": "paragraph", "text": "Substitusi: $5x = 15 \\Rightarrow x = 3$, $y = 3$" },
        { "tipe": "paragraph", "text": "$x + y = 6$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $y$ dari sistem $\\dfrac{2}{x} + \\dfrac{1}{y} = 3$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $\\dfrac{1}{x} - \\dfrac{1}{y} = 0 \\Rightarrow x = y$" },
        { "tipe": "paragraph", "text": "Substitusi: $\\dfrac{2}{x} + \\dfrac{1}{x} = 3 \\Rightarrow \\dfrac{3}{x} = 3 \\Rightarrow x = 1$" },
        { "tipe": "paragraph", "text": "$y = 1$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\dfrac{3}{x} - \\dfrac{2}{y} = 0$ dan $\\dfrac{2}{x} + \\dfrac{3}{y} = \\dfrac{13}{6}$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a = \\dfrac{1}{x}$, $b = \\dfrac{1}{y}$." },
        { "tipe": "paragraph", "text": "Dari (i): $3a = 2b \\Rightarrow a = \\dfrac{2b}{3}$" },
        { "tipe": "paragraph", "text": "Substitusi (ii): $\\dfrac{4b}{3} + 3b = \\dfrac{13}{6} \\Rightarrow \\dfrac{13b}{3} = \\dfrac{13}{6} \\Rightarrow b = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$y = 2$; $a = \\dfrac{1}{3} \\Rightarrow x = 3$" },
        { "tipe": "paragraph", "text": "$x + y = 5$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $\\dfrac{x+1}{2} + \\dfrac{y-1}{3} = 3$ dan $\\dfrac{x-1}{3} + \\dfrac{y+1}{2} = 4$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan (i) ×6: $3(x+1) + 2(y-1) = 18 \\Rightarrow 3x + 2y = 17$" },
        { "tipe": "paragraph", "text": "Kalikan (ii) ×6: $2(x-1) + 3(y+1) = 24 \\Rightarrow 2x + 3y = 23$" },
        { "tipe": "paragraph", "text": "Jumlahkan: $5x + 5y = 40 \\Rightarrow x + y = 8$" }
      ],
      "tingkat": "SEDANG"
    },
    {
      "id": "bs-k10-spl-s-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{2}{x} + \\dfrac{3}{y} = 12$ dan $\\dfrac{3}{x} - \\dfrac{2}{y} = 5$, nilai $\\dfrac{1}{x} + \\dfrac{1}{y}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a = \\dfrac{1}{x}$, $b = \\dfrac{1}{y}$." },
        { "tipe": "paragraph", "text": "$2a + 3b = 12$; $3a - 2b = 5$" },
        { "tipe": "paragraph", "text": "(i)×2: $4a + 6b = 24$; (ii)×3: $9a - 6b = 15$; jumlahkan: $13a = 39 \\Rightarrow a = 3$" },
        { "tipe": "paragraph", "text": "Substitusi (i): $6 + 3b = 12 \\Rightarrow b = 2$" },
        { "tipe": "paragraph", "text": "$a + b = 5$" }
      ],
      "tingkat": "SEDANG"
    }
  ]
}
