{
  "id": "bs-k10-spl-m-01",
  "nama": "Bank Soal Mudah - Paket 1",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang SPLDV dengan metode substitusi",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-m-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian dari sistem persamaan $x + y = 7$ dan $x - y = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(5, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(6, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan kedua persamaan: $(x+y) + (x-y) = 7 + 3$" },
        { "tipe": "paragraph", "text": "$2x = 10 \\Rightarrow x = 5$" },
        { "tipe": "paragraph", "text": "Substitusi ke $x + y = 7$: $5 + y = 7 \\Rightarrow y = 2$" },
        { "tipe": "paragraph", "text": "HP = $\\{(5, 2)\\}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $y$ yang memenuhi sistem $2x + y = 8$ dan $x = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 3$: $2(3) + y = 8$" },
        { "tipe": "paragraph", "text": "$6 + y = 8 \\Rightarrow y = 2$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $3x + 2y = 12$ dan $x = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(2, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 5)$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 2$: $3(2) + 2y = 12$" },
        { "tipe": "paragraph", "text": "$6 + 2y = 12 \\Rightarrow 2y = 6 \\Rightarrow y = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ dari sistem $x + 2y = 10$ dan $y = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $y = 2$: $x + 4 = 10$" },
        { "tipe": "paragraph", "text": "$x = 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem persamaan linear dua variabel $x + y = 5$ dan $2x + 2y = 10$ memiliki..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ],
        [ { "tipe": "paragraph", "text": "Tepat satu solusi" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga solusi" } ],
        [ { "tipe": "paragraph", "text": "Dua solusi" } ],
        [ { "tipe": "paragraph", "text": "Tiga solusi" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Persamaan kedua = 2 × persamaan pertama → kedua persamaan identik (berimpit)." },
        { "tipe": "paragraph", "text": "Maka sistem memiliki tak hingga banyak solusi." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x + y$ dari sistem $x - y = 4$ dan $2x + y = 11$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $x - y = 4 \\Rightarrow x = y + 4$" },
        { "tipe": "paragraph", "text": "Substitusi: $2(y + 4) + y = 11 \\Rightarrow 2y + 8 + y = 11$" },
        { "tipe": "paragraph", "text": "$3y = 3 \\Rightarrow y = 1$, maka $x = 5$" },
        { "tipe": "paragraph", "text": "$x + y = 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2x - y = 5$ dan $x + y = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{(3, 1)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(2, 2)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(1, 3)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(4, 0)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(0, 4)\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan: $3x = 9 \\Rightarrow x = 3$" },
        { "tipe": "paragraph", "text": "Substitusi $x + y = 4$: $3 + y = 4 \\Rightarrow y = 1$" },
        { "tipe": "paragraph", "text": "HP = $\\{(3, 1)\\}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $3x - y = 8$ dan $x + y = 4$. Nilai $2x - y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan: $4x = 12 \\Rightarrow x = 3$" },
        { "tipe": "paragraph", "text": "$x + y = 4 \\Rightarrow 3 + y = 4 \\Rightarrow y = 1$" },
        { "tipe": "paragraph", "text": "$2x - y = 6 - 1 = 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $4x + 3y = 15$ dan $4x - 3y = 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(3, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan: $8x = 24 \\Rightarrow x = 3$" },
        { "tipe": "paragraph", "text": "Substitusi: $4(3) + 3y = 15 \\Rightarrow 12 + 3y = 15 \\Rightarrow 3y = 3 \\Rightarrow y = 1$" },
        { "tipe": "paragraph", "text": "HP = $\\{(3, 1)\\}$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + 2y = 8$ dan $2x - y = 6$, nilai $x \\cdot y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $2x - y = 6 \\Rightarrow y = 2x - 6$" },
        { "tipe": "paragraph", "text": "Substitusi: $x + 2(2x - 6) = 8 \\Rightarrow x + 4x - 12 = 8$" },
        { "tipe": "paragraph", "text": "$5x = 20 \\Rightarrow x = 4$, maka $y = 2$" },
        { "tipe": "paragraph", "text": "$x \\cdot y = 8$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
