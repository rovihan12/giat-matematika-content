  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "MUDAH",
  "deskripsi": "Persamaan linear satu variabel dengan konteks sehari-hari dan operasi dasar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-m-06-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $5x - 12 = 3x + 8$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$16$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5x - 3x = 8 + 12 \\Rightarrow 2x = 20 \\Rightarrow x = 10$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $2(3x - 4) = 5x + 7$, maka nilai $x$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$16$" }],
        [{ "tipe": "paragraph", "text": "$17$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$6x - 8 = 5x + 7 \\Rightarrow x = 15$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Umur Rina 5 tahun lebih muda dari Doni. Jumlah umur mereka 37 tahun. Umur Rina adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$14$ tahun" }],
        [{ "tipe": "paragraph", "text": "$15$ tahun" }],
        [{ "tipe": "paragraph", "text": "$16$ tahun" }],
        [{ "tipe": "paragraph", "text": "$17$ tahun" }],
        [{ "tipe": "paragraph", "text": "$18$ tahun" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal Rina $= r$, Doni $= r + 5$." },
        { "tipe": "paragraph", "text": "$r + (r + 5) = 37 \\Rightarrow 2r = 32 \\Rightarrow r = 16$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Harga 4 pulpen dan 2 buku adalah Rp26.000. Jika harga 1 buku Rp5.000, harga 1 pulpen adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "Rp3.000" }],
        [{ "tipe": "paragraph", "text": "Rp3.500" }],
        [{ "tipe": "paragraph", "text": "Rp4.000" }],
        [{ "tipe": "paragraph", "text": "Rp4.500" }],
        [{ "tipe": "paragraph", "text": "Rp5.000" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal pulpen $= p$: $4p + 2(5.000) = 26.000$" },
        { "tipe": "paragraph", "text": "$4p = 16.000 \\Rightarrow p = 4.000$" }
      ],
      "tingkat": "MUDAH"
    },
    {
