        [{ "tipe": "paragraph", "text": "$14$ cm" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4s = 48 \\Rightarrow s = 12$ cm" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ dari $\\dfrac{x}{3} + 2 = 7$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$16$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{x}{3} = 5 \\Rightarrow x = 15$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Diketahui $3x + 7 = 2x + 15$. Nilai $x + 5$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$11$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3x - 2x = 15 - 7 \\Rightarrow x = 8$" },
        { "tipe": "paragraph", "text": "$x + 5 = 13$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sebuah bilangan dikurangi 8 lalu dikali 3 hasilnya 21. Bilangan tersebut adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$16$" }],
        [{ "tipe": "paragraph", "text": "$17$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3(x - 8) = 21 \\Rightarrow x - 8 = 7 \\Rightarrow x = 15$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $y$ yang memenuhi $4y - 9 = 2y + 5$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$9$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4y - 2y = 5 + 9 \\Rightarrow 2y = 14 \\Rightarrow y = 7$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-06-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Panjang persegi panjang 3 cm lebih dari lebarnya. Jika kelilingnya 34 cm, lebarnya adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$ cm" }],
        [{ "tipe": "paragraph", "text": "$6$ cm" }],
        [{ "tipe": "paragraph", "text": "$7$ cm" }],
        [{ "tipe": "paragraph", "text": "$8$ cm" }],
        [{ "tipe": "paragraph", "text": "$9$ cm" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal lebar $= l$, panjang $= l + 3$." },
        { "tipe": "paragraph", "text": "$2(l + l + 3) = 34 \\Rightarrow 2l + 3 = 17 \\Rightarrow l = 7$ cm" }
      ],
      "tingkat": "MUDAH"
    }
  ]
