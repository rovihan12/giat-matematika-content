{
  "id": "bs-k10-spl-m-05",
  "nama": "Bank Soal Mudah - Paket 5",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah campuran SPLDV, SPLTV, dan pertidaksamaan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-m-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Umur Andi 3 tahun lebih tua dari Budi. Jumlah umur mereka 21 tahun. Umur Andi adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$10$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$11$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$12$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$13$ tahun" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun model persamaan dan selesaikan untuk umur Budi ($b$)**" },
        { "tipe": "paragraph", "text": "Misalkan umur Andi adalah $a$ dan umur Budi adalah $b$, maka $a = b + 3$ dan $a + b = 21$." },
        { "tipe": "formula_block", "latex": "(b + 3) + b = 21 \\Rightarrow 2b + 3 = 21 \\Rightarrow 2b = 18 \\Rightarrow b = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung umur Andi ($a$)**" },
        { "tipe": "formula_block", "latex": "a = 9 + 3 = 12" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, umur Andi adalah **$12$ tahun**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Harga 2 buku dan 3 pensil adalah Rp14.000. Harga 1 buku Rp4.000. Harga 1 pensil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp1.500" } ],
        [ { "tipe": "paragraph", "text": "Rp2.000" } ],
        [ { "tipe": "paragraph", "text": "Rp2.500" } ],
        [ { "tipe": "paragraph", "text": "Rp3.000" } ],
        [ { "tipe": "paragraph", "text": "Rp3.500" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan harga buku Rp4.000 ke persamaan harga total**" },
        { "tipe": "paragraph", "text": "Misalkan harga $1$ pensil adalah $p$ (dalam rupiah)." },
        { "tipe": "formula_block", "latex": "2(4000) + 3p = 14000 \\Rightarrow 8000 + 3p = 14000 \\Rightarrow 3p = 6000 \\Rightarrow p = 2000" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, harga 1 pensil adalah **Rp2.000**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Keliling persegi panjang 36 cm. Panjangnya 4 cm lebih dari lebarnya. Lebar persegi panjang adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$ cm" } ],
        [ { "tipe": "paragraph", "text": "$6$ cm" } ],
        [ { "tipe": "paragraph", "text": "$7$ cm" } ],
        [ { "tipe": "paragraph", "text": "$8$ cm" } ],
        [ { "tipe": "paragraph", "text": "$9$ cm" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus keliling persegi panjang dengan $p = l + 4$**" },
        { "tipe": "formula_block", "latex": "2(p + l) = 36 \\Rightarrow p + l = 18 \\Rightarrow (l + 4) + l = 18" },
        { "tipe": "formula_block", "latex": "2l + 4 = 18 \\Rightarrow 2l = 14 \\Rightarrow l = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, lebar persegi panjang adalah **$7$ cm**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\dfrac{2x - 1}{3} > 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 1$" } ],
        [ { "tipe": "paragraph", "text": "$x > 2$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 2$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kalikan kedua ruas dengan $3$ lalu selesaikan untuk $x$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2x - 1}{3} > 1 \\Rightarrow 2x - 1 > 3 \\Rightarrow 2x > 4 \\Rightarrow x > 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x > 2$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bilangan ditambah 5, lalu dikali 3, hasilnya 27. Bilangan tersebut adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun persamaan linear dan selesaikan untuk $x$**" },
        { "tipe": "paragraph", "text": "Misalkan bilangan tersebut adalah $x$." },
        { "tipe": "formula_block", "latex": "3(x + 5) = 27 \\Rightarrow x + 5 = 9 \\Rightarrow x = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bilangan tersebut adalah **$4$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian dari $x + y = 8$ dan $x - y = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(5, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 5)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(6, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 6)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $y$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(x + y) + (x - y) = 8 + 2 \\Rightarrow 2x = 10 \\Rightarrow x = 5" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 5$ ke $x + y = 8$ untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "5 + y = 8 \\Rightarrow y = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, penyelesaian dari sistem tersebut adalah **$(5, 3)$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ dari sistem $3x + 2y = 16$ dan $x - y = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan $x$ dari persamaan kedua lalu substitusikan ke persamaan pertama**" },
        { "tipe": "paragraph", "text": "Dari $x - y = 2$ diperoleh $x = y + 2$, kemudian substitusikan ke $3x + 2y = 16$:" },
        { "tipe": "formula_block", "latex": "3(y + 2) + 2y = 16 \\Rightarrow 5y + 6 = 16 \\Rightarrow 5y = 10 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x$**" },
        { "tipe": "formula_block", "latex": "x = 2 + 2 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ dari sistem tersebut adalah **$4$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $5 - 3x \\geq -4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kurangkan $5$ lalu bagi kedua ruas dengan $-3$ (tanda dibalik)**" },
        { "tipe": "formula_block", "latex": "5 - 3x \\geq -4 \\Rightarrow -3x \\geq -9 \\Rightarrow x \\leq 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x \\leq 3$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x + y + z = 12$, $x = 4$, dan $y = 3$. Nilai $z$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $x = 4$ dan $y = 3$ ke persamaan $x + y + z = 12$**" },
        { "tipe": "formula_block", "latex": "4 + 3 + z = 12 \\Rightarrow 7 + z = 12 \\Rightarrow z = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $z$ adalah **$5$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah dua bilangan adalah 30 dan selisihnya 6. Bilangan yang lebih besar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun SPLDV lalu jumlahkan kedua persamaan untuk mencari bilangan besar ($a$)**" },
        { "tipe": "paragraph", "text": "Misalkan dua bilangan tersebut adalah $a$ (lebih besar) dan $b$ (lebih kecil), sehingga $a + b = 30$ dan $a - b = 6$." },
        { "tipe": "formula_block", "latex": "(a + b) + (a - b) = 30 + 6 \\Rightarrow 2a = 36 \\Rightarrow a = 18" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, bilangan yang lebih besar adalah **$18$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
