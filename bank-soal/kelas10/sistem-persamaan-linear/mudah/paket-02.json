  "soal": [
    {
      "id": "bs-k10-spl-m-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $2x + 3y = 12$ dan $2x - 3y = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 2)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $y$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(2x + 3y) + (2x - 3y) = 12 + 0 \\Rightarrow 4x = 12 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 3$ untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "2(3) + 3y = 12 \\Rightarrow 6 + 3y = 12 \\Rightarrow 3y = 6 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, penyelesaian sistem tersebut adalah **$(3, 2)$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $y$ dari sistem $5x + 2y = 19$ dan $3x - 2y = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $y$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(5x + 2y) + (3x - 2y) = 19 + 5 \\Rightarrow 8x = 24 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 3$ ke persamaan pertama untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "5(3) + 2y = 19 \\Rightarrow 15 + 2y = 19 \\Rightarrow 2y = 4 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $y$ dari sistem tersebut adalah **$2$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + 3y = 9$ dan $x - 3y = -3$ memiliki solusi..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(0, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(6, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $y$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(x + 3y) + (x - 3y) = 9 + (-3) \\Rightarrow 2x = 6 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 3$ ke persamaan pertama untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "3 + 3y = 9 \\Rightarrow 3y = 6 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, sistem tersebut memiliki solusi **$(3, 2)$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x + y$ dari sistem $3x + 4y = 20$ dan $3x - 4y = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan nilai $x$ dan $y$**" },
        { "tipe": "paragraph", "text": "Jumlahkan kedua persamaan untuk memperoleh $x$, lalu substitusikan ke persamaan pertama untuk memperoleh $y$:" },
        { "tipe": "formula_block", "latex": "6x = 24 \\Rightarrow x = 4, \\qquad 3(4) + 4y = 20 \\Rightarrow 4y = 8 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x + y$**" },
        { "tipe": "formula_block", "latex": "x + y = 4 + 2 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$6$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $7x + 2y = 20$ dan $3x - 2y = -4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1{,}6;\\ 4{,}4)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 6)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 4)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $y$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(7x + 2y) + (3x - 2y) = 20 + (-4) \\Rightarrow 10x = 16 \\Rightarrow x = 1{,}6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 1{,}6$ ke persamaan pertama untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "7(1{,}6) + 2y = 20 \\Rightarrow 11{,}2 + 2y = 20 \\Rightarrow 2y = 8{,}8 \\Rightarrow y = 4{,}4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, penyelesaian sistem tersebut adalah **$(1{,}6;\\ 4{,}4)$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ dari sistem $2x + y = 8$ dan $2x - y = 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $y$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(2x + y) + (2x - y) = 8 + 4 \\Rightarrow 4x = 12 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ dari sistem tersebut adalah **$3$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + y = 6$ dan $3x + 3y = 12$ memiliki..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Tidak ada solusi" } ],
        [ { "tipe": "paragraph", "text": "Tepat satu solusi" } ],
        [ { "tipe": "paragraph", "text": "Tak hingga solusi" } ],
        [ { "tipe": "paragraph", "text": "Dua solusi" } ],
        [ { "tipe": "paragraph", "text": "Tiga solusi" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Sederhanakan persamaan kedua lalu bandingkan dengan persamaan pertama**" },
        { "tipe": "paragraph", "text": "Bagi persamaan kedua ($3x + 3y = 12$) dengan $3$ sehingga diperoleh $x + y = 4$, yang bertentangan dengan persamaan pertama $x + y = 6$." },
        { "tipe": "formula_block", "latex": "x + y = 4 \\quad \\text{dan} \\quad x + y = 6 \\quad (\\text{kontradiksi})" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, sistem tersebut **tidak ada solusi**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $y$ dari sistem $4x + 3y = 24$ dan $4x - 3y = 0$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $y$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "(4x + 3y) + (4x - 3y) = 24 + 0 \\Rightarrow 8x = 24 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 3$ ke persamaan kedua untuk memperoleh nilai $y$**" },
        { "tipe": "formula_block", "latex": "4(3) - 3y = 0 \\Rightarrow 12 = 3y \\Rightarrow y = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $y$ dari sistem tersebut adalah **$4$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $x + 2y = 7$ dan $2x + y = 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(3, 1)$" } ],
        [ { "tipe": "paragraph", "text": "$(4, 1)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan $x$ dari persamaan pertama lalu substitusikan ke persamaan kedua**" },
        { "tipe": "paragraph", "text": "Dari $x + 2y = 7$ diperoleh $x = 7 - 2y$, kemudian substitusikan ke $2x + y = 8$:" },
        { "tipe": "formula_block", "latex": "2(7 - 2y) + y = 8 \\Rightarrow 14 - 3y = 8 \\Rightarrow -3y = -6 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $y = 2$ untuk memperoleh nilai $x$**" },
        { "tipe": "formula_block", "latex": "x = 7 - 2(2) = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, penyelesaian sistem tersebut adalah **$(3, 2)$**." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $2x + 3y$ dari sistem $x - y = 1$ dan $2x + y = 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan nilai $x$ dan $y$**" },
        { "tipe": "paragraph", "text": "Jumlahkan kedua persamaan untuk memperoleh $x$, lalu substitusikan ke $x - y = 1$ untuk memperoleh $y$:" },
        { "tipe": "formula_block", "latex": "3x = 9 \\Rightarrow x = 3, \\qquad 3 - y = 1 \\Rightarrow y = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $2x + 3y$**" },
        { "tipe": "formula_block", "latex": "2x + 3y = 2(3) + 3(2) = 6 + 6 = 12" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $2x + 3y$ adalah **$12$**." }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
