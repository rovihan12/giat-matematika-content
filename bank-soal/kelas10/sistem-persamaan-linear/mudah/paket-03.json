{
  "id": "bs-k10-spl-m-03",
  "nama": "Bank Soal Mudah - Paket 3",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "MUDAH",
  "deskripsi": "Soal mudah tentang SPLTV sederhana",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-m-03-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian dari sistem $x + y + z = 6$, $x = 1$, dan $y = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$(1, 2, 3)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 2, 4)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 2, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(1, 3, 2)$" } ],
        [ { "tipe": "paragraph", "text": "$(2, 1, 3)$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $x = 1$, $y = 2$: $1 + 2 + z = 6$" },
        { "tipe": "paragraph", "text": "$z = 3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $z$ dari sistem $x + y + z = 10$, $x = 2$, $y = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2 + 3 + z = 10 \\Rightarrow z = 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x + y = 5$, $y + z = 7$, dan $z = 3$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari $y + z = 7$ dan $z = 3$: $y = 4$" },
        { "tipe": "paragraph", "text": "Dari $x + y = 5$: $x + 4 = 5 \\Rightarrow x = 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + y + z = 12$, $x = 3$, $y = 4$. Nilai $z$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3 + 4 + z = 12 \\Rightarrow z = 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x + y = 8$, $y + z = 10$, dan $x + z = 12$. Nilai $x + y + z$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan ketiga persamaan: $2(x + y + z) = 8 + 10 + 12 = 30$" },
        { "tipe": "paragraph", "text": "$x + y + z = 15$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + 2y + z = 9$, $y = 2$, dan $z = 1$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x + 4 + 1 = 9 \\Rightarrow x = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x + y = 10$, $x + z = 12$, dan $y + z = 14$. Nilai $z$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x + y + z = \\dfrac{10 + 12 + 14}{2} = 18$" },
        { "tipe": "paragraph", "text": "$z = 18 - (x + y) = 18 - 10 = 8$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $y$ dari sistem $2x + y - z = 5$, $x = 1$, $z = 2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2(1) + y - 2 = 5 \\Rightarrow y = 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x + y + z = 15$, $x + y = 9$, dan $y + z = 11$. Nilai $x$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$z = 15 - (x + y) = 15 - 9 = 6$" },
        { "tipe": "paragraph", "text": "$y = 11 - z = 11 - 6 = 5$" },
        { "tipe": "paragraph", "text": "$x = 9 - y = 9 - 5 = 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-03-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tiga bilangan adalah 20. Bilangan pertama 3, bilangan kedua 7. Bilangan ketiga adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3 + 7 + z = 20 \\Rightarrow z = 10$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
}
