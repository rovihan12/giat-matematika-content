      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $x + 3 > 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > 10$" } ],
        [ { "tipe": "paragraph", "text": "$x < 10$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x + 3 > 7 \\Rightarrow x > 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2x - 5 \\leq 7$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 1$" } ],
        [ { "tipe": "paragraph", "text": "$x < 6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2x \\leq 12 \\Rightarrow x \\leq 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $-3x > 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > -3$" } ],
        [ { "tipe": "paragraph", "text": "$x < -3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq -3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$-3x > 9$ → bagi dengan $-3$ (tanda berbalik):" },
        { "tipe": "paragraph", "text": "$x < -3$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $4x - 2 \\geq 2x + 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$4x - 2x \\geq 6 + 2$" },
        { "tipe": "paragraph", "text": "$2x \\geq 8 \\Rightarrow x \\geq 4$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $5 - 2x < 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 1$" } ],
        [ { "tipe": "paragraph", "text": "$x > 1$" } ],
        [ { "tipe": "paragraph", "text": "$x < 4$" } ],
        [ { "tipe": "paragraph", "text": "$x > 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 1$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$-2x < -2$" },
        { "tipe": "paragraph", "text": "Bagi $-2$ (tanda berbalik): $x > 1$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $\\dfrac{x}{2} + 1 \\leq 4$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq 4$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 6$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq 8$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{x}{2} \\leq 3 \\Rightarrow x \\leq 6$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $3(x - 2) > 9$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x > 3$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x > 6$" } ],
        [ { "tipe": "paragraph", "text": "$x < 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3x - 6 > 9 \\Rightarrow 3x > 15 \\Rightarrow x > 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $2x + 3 < x + 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x < 5$" } ],
        [ { "tipe": "paragraph", "text": "$x > 5$" } ],
        [ { "tipe": "paragraph", "text": "$x < 11$" } ],
        [ { "tipe": "paragraph", "text": "$x > 11$" } ],
        [ { "tipe": "paragraph", "text": "$x < -5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2x - x < 8 - 3 \\Rightarrow x < 5$" }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ bulat positif terkecil yang memenuhi $3x - 1 \\geq 8$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$3x \\geq 9 \\Rightarrow x \\geq 3$" },
        { "tipe": "paragraph", "text": "Nilai bulat positif terkecil = 3." }
      ],
      "tingkat": "MUDAH"
    },
    {
      "id": "bs-k10-spl-m-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian dari $-2x + 5 \\leq 1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$x \\leq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\leq -2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq -2$" } ],
        [ { "tipe": "paragraph", "text": "$x \\geq 3$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$-2x \\leq -4$" },
        { "tipe": "paragraph", "text": "Bagi $-2$: $x \\geq 2$" }
      ],
      "tingkat": "MUDAH"
    }
  ]
