      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Sistem persamaan: $2x+y=8$ dan $x+2y=10$." },
        { "tipe": "paragraph", "text": "Dari eliminasi diperoleh $3x = 6 \\Rightarrow x = 2$ dan $y = 4$." }
      ],
