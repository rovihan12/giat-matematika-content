    },
    {
      "id": "bs-k10-spl-sulit-07-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sebuah pabrik memproduksi 3 jenis barang A, B, C. Total 110 unit. A = 2B, C = B + 10. Banyak A adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$36$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$45$" }],
        [{ "tipe": "paragraph", "text": "$50$" }]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Substitusi $A = 2B$ dan $C = B + 10$ ke $A + B + C = 110$:" },
        { "tipe": "paragraph", "text": "$2B + B + (B + 10) = 110 \\Rightarrow 4B + 10 = 110 \\Rightarrow 4B = 100 \\Rightarrow B = 25$." },
        { "tipe": "paragraph", "text": "Maka banyak barang A adalah $A = 2(25) = 50$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-07-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Dua pekerja A dan B menyelesaikan proyek 12 hari. A dan C 15 hari. B dan C 20 hari. A sendiri berapa hari?" }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$20$ hari" }],
        [{ "tipe": "paragraph", "text": "$24$ hari" }],
