        [{ "tipe": "paragraph", "text": "$36$ hari" }],
        [{ "tipe": "paragraph", "text": "$40$ hari" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kecepatan kerja: $a+b=\\dfrac{1}{12}$, $a+c=\\dfrac{1}{15}$, $b+c=\\dfrac{1}{20}$." },
        { "tipe": "paragraph", "text": "Jumlahkan ketiga persamaan: $2(a+b+c) = \\dfrac{5+4+3}{60} = \\dfrac{12}{60} = \\dfrac{1}{5} \\Rightarrow a+b+c = \\dfrac{1}{10}$." },
        { "tipe": "paragraph", "text": "Kecepatan A saja: $a = (a+b+c) - (b+c) = \\dfrac{1}{10} - \\dfrac{1}{20} = \\dfrac{1}{20}$." },
        { "tipe": "paragraph", "text": "Jadi A sendiri memerlukan $20$ hari." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-07-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Campuran 30% garam dari bahan A (20%) dan B (50%). Jika ingin 60 liter, banyak A adalah..." }],
