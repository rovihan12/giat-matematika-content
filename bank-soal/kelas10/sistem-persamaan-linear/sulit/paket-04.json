{
  "id": "bs-k10-spl-sulit-04",
  "nama": "Bank Soal Sulit - Paket 4",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit aplikasi kontekstual sistem persamaan linear",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-04-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah perusahaan memiliki 3 jenis produk A, B, C. Total produksi ketiganya 225 unit. Produk A 2 kali produk B, dan produk C 25 lebih banyak dari produk B. Banyak produk A adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$100$" } ],
        [ { "tipe": "paragraph", "text": "$125$" } ],
        [ { "tipe": "paragraph", "text": "$150$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal produk A $= a$, B $= b$, C $= c$." },
        { "tipe": "paragraph", "text": "$a + b + c = 225$; $a = 2b$; $c = b + 25$" },
        { "tipe": "paragraph", "text": "$2b + b + b + 25 = 225 \\Rightarrow 4b = 200 \\Rightarrow b = 50$" },
        { "tipe": "paragraph", "text": "$a = 100$; $c = 75$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah toko menjual 3 novel, 2 komik, dan 1 majalah dengan total Rp137.000. Harga novel Rp5.000 lebih mahal dari komik, dan majalah Rp10.000 lebih murah dari komik. Harga 1 komik adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp20.000" } ],
        [ { "tipe": "paragraph", "text": "Rp22.000" } ],
        [ { "tipe": "paragraph", "text": "Rp25.000" } ],
        [ { "tipe": "paragraph", "text": "Rp28.000" } ],
        [ { "tipe": "paragraph", "text": "Rp30.000" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal komik $= k$; novel $= k + 5.000$; majalah $= k - 10.000$." },
        { "tipe": "paragraph", "text": "$3(k + 5.000) + 2k + (k - 10.000) = 137.000$" },
        { "tipe": "paragraph", "text": "$6k + 5.000 = 137.000 \\Rightarrow 6k = 132.000 \\Rightarrow k = 22.000$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Dua tahun lalu umur ayah 3 kali umur anak. Jumlah umur mereka sekarang 36 tahun. Umur anak sekarang adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$9$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$10$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$11$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$12$ tahun" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal ayah $= A$, anak $= a$." },
        { "tipe": "paragraph", "text": "$A - 2 = 3(a - 2) \\Rightarrow A = 3a - 4$" },
        { "tipe": "paragraph", "text": "$A + a = 36$" },
        { "tipe": "paragraph", "text": "$3a - 4 + a = 36 \\Rightarrow 4a = 40 \\Rightarrow a = 10$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah perusahaan taksi memiliki tarif buka pintu Rp5.000 + Rp3.000/km. Perusahaan lain buka pintu Rp8.000 + Rp2.000/km. Pada jarak berapa tarif keduanya sama?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$ km" } ],
        [ { "tipe": "paragraph", "text": "$2$ km" } ],
        [ { "tipe": "paragraph", "text": "$3$ km" } ],
        [ { "tipe": "paragraph", "text": "$4$ km" } ],
        [ { "tipe": "paragraph", "text": "$5$ km" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$5.000 + 3.000k = 8.000 + 2.000k$" },
        { "tipe": "paragraph", "text": "$1.000k = 3.000 \\Rightarrow k = 3$ km" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tukang A dan B menyelesaikan taman dalam 6 hari. A dan C dalam 8 hari. B dan C dalam 12 hari. Berapa hari yang diperlukan A sendiri?" }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{44}{5}$ hari" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{48}{5}$ hari" } ],
        [ { "tipe": "paragraph", "text": "$10$ hari" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{52}{5}$ hari" } ],
        [ { "tipe": "paragraph", "text": "$12$ hari" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a + b = \\dfrac{1}{6}$; $a + c = \\dfrac{1}{8}$; $b + c = \\dfrac{1}{12}$" },
        { "tipe": "paragraph", "text": "Jumlahkan: $2(a + b + c) = \\dfrac{1}{6} + \\dfrac{1}{8} + \\dfrac{1}{12} = \\dfrac{4+3+2}{24} = \\dfrac{3}{8}$" },
        { "tipe": "paragraph", "text": "$a + b + c = \\dfrac{3}{16}$; $a = \\dfrac{3}{16} - \\dfrac{1}{12} = \\dfrac{9-4}{48} = \\dfrac{5}{48}$" },
        { "tipe": "paragraph", "text": "Waktu A $= \\dfrac{48}{5}$ hari" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Bahan A mengandung 20% garam, bahan B 50%. Ingin dibuat 100 liter larutan 30%. Banyak bahan A yang diperlukan adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$50$ liter" } ],
        [ { "tipe": "paragraph", "text": "$60$ liter" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{200}{3}$ liter" } ],
        [ { "tipe": "paragraph", "text": "$70$ liter" } ],
        [ { "tipe": "paragraph", "text": "$80$ liter" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a + b = 100$; $0{,}2a + 0{,}5b = 30$" },
        { "tipe": "paragraph", "text": "$b = 100 - a$: $0{,}2a + 50 - 0{,}5a = 30$" },
        { "tipe": "paragraph", "text": "$-0{,}3a = -20 \\Rightarrow a = \\dfrac{200}{3}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Empat tahun lalu umur ayah 4 kali umur anak. Delapan tahun yang akan datang umur ayah 2 kali umur anak. Umur ayah sekarang adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$28$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$32$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$36$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$40$ tahun" } ],
        [ { "tipe": "paragraph", "text": "$44$ tahun" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$A - 4 = 4(a - 4) \\Rightarrow A = 4a - 12$" },
        { "tipe": "paragraph", "text": "$A + 8 = 2(a + 8) \\Rightarrow A = 2a + 8$" },
        { "tipe": "paragraph", "text": "$4a - 12 = 2a + 8 \\Rightarrow 2a = 20 \\Rightarrow a = 10$; $A = 28$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pada suatu toko, 1 kg apel + 2 kg jeruk = Rp50.000. 2 kg apel + 3 kg jeruk = Rp85.000. Harga 1 kg apel adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "Rp15.000" } ],
        [ { "tipe": "paragraph", "text": "Rp18.000" } ],
        [ { "tipe": "paragraph", "text": "Rp20.000" } ],
        [ { "tipe": "paragraph", "text": "Rp22.000" } ],
        [ { "tipe": "paragraph", "text": "Rp25.000" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$A + 2J = 50.000$; $2A + 3J = 85.000$" },
        { "tipe": "paragraph", "text": "(i)×2: $2A + 4J = 100.000$; (ii): $2A + 3J = 85.000$; kurangkan: $J = 15.000$" },
        { "tipe": "paragraph", "text": "$A = 50.000 - 30.000 = 20.000$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Pabrik memproduksi 2 jenis barang X dan Y. Setiap X butuh 2 jam mesin A dan 1 jam mesin B. Setiap Y butuh 1 jam mesin A dan 3 jam mesin B. Tersedia 100 jam A dan 100 jam B. Jika x unit X dan y unit Y diproduksi maksimum, maka x + y = ..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ],
        [ { "tipe": "paragraph", "text": "$50$" } ],
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kendala: $2x + y \\leq 100$; $x + 3y \\leq 100$" },
        { "tipe": "paragraph", "text": "Titik-titik sudut: $(50, 0) = 50$; $(0, 33{,}3)$; titik potong:" },
        { "tipe": "paragraph", "text": "$y = 100 - 2x$; $x + 300 - 6x = 100 \\Rightarrow 5x = 200 \\Rightarrow x = 40$, $y = 20$" },
        { "tipe": "paragraph", "text": "$x + y = 60$ ✓" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-04-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sebuah bilangan 2 angka memiliki jumlah angka 8. Jika angka ditukar, nilainya = 2 kali nilai asli ditambah 10. Bilangan asli adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$17$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$53$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Bilangan $= 10a + b$; $a + b = 8$." },
        { "tipe": "paragraph", "text": "$10b + a = 2(10a + b) + 10$" },
        { "tipe": "paragraph", "text": "$8b - 19a = 10$" },
        { "tipe": "paragraph", "text": "$b = 8 - a$: $64 - 8a - 19a = 10 \\Rightarrow 27a = 54 \\Rightarrow a = 2$; $b = 6$." },
        { "tipe": "paragraph", "text": "Bilangan asli = $26$" }
      ],
      "tingkat": "SULIT"
    }
  ]
}
