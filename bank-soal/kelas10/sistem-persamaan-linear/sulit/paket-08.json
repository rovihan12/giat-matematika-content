{
  "id": "bs-k10-spl-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Pertidaksamaan pecahan, nilai mutlak, dan sistem pertidaksamaan lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-08-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x^2 - 9}{x - 1} \\geq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$-3 \\leq x < 1$ atau $x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq -3$ atau $1 < x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$-3 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$-3 < x < 1$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{(x-3)(x+3)}{x-1} \\geq 0$. Pembuat nol: $x = -3$, $x = 1$ (dikecualikan), $x = 3$." },
        { "tipe": "paragraph", "text": "Uji interval: negatif pada $x < -3$ dan $1 < x < 3$; positif pada $-3 \\leq x < 1$ dan $x \\geq 3$." },
        { "tipe": "paragraph", "text": "Maka HP: $-3 \\leq x < 1$ atau $x \\geq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $|2x - 1| \\geq x + 2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x \\leq -\\dfrac{1}{3}$ atau $x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{1}{3} \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq -3$ atau $x \\geq \\dfrac{1}{3}$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2x-1 \\leq -(x+2) \\Rightarrow 3x \\leq -1 \\Rightarrow x \\leq -1/3$." },
        { "tipe": "paragraph", "text": "$2x-1 \\geq x+2 \\Rightarrow x \\geq 3$." },
        { "tipe": "paragraph", "text": "HP: $x \\leq -1/3$ atau $x \\geq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y \\leq 6$, $2x + y \\geq 6$, $x \\geq 0$, $y \\geq 0$. Nilai minimum $f = 3x + 4y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$9$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$11$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik sudut daerah penyelesaian: $(3,0) \\Rightarrow 3(3)+0 = 9$, $(0,6) \\Rightarrow 4(6) = 24$." },
        { "tipe": "paragraph", "text": "Nilai minimum adalah $9$ di titik $(3,0)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $|x - 2| + |x + 3| = 7$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\{-4, 3\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-3, 4\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-2, 3\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-4, 2\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-3, 2\\}$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Analisis interval:" },
        { "tipe": "paragraph", "text": "Untuk $x < -3$: $-(x-2) - (x+3) = 7 \\Rightarrow -2x - 1 = 7 \\Rightarrow x = -4$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Untuk $-3 \\leq x < 2$: $-(x-2) + (x+3) = 5 \\neq 7$ (tidak ada solusi)." },
        { "tipe": "paragraph", "text": "Untuk $x \\geq 2$: $(x-2) + (x+3) = 7 \\Rightarrow 2x + 1 = 7 \\Rightarrow x = 3$ (memenuhi)." },
        { "tipe": "paragraph", "text": "Maka HP = $\\{-4, 3\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{2x - 5}{x + 1} > 1$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < -1$ atau $x > 6$" }],
        [{ "tipe": "paragraph", "text": "$-1 < x < 6$" }],
        [{ "tipe": "paragraph", "text": "$x < -6$ atau $x > 1$" }],
        [{ "tipe": "paragraph", "text": "$-6 < x < 1$" }],
        [{ "tipe": "paragraph", "text": "$x > 6$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{2x-5}{x+1} - 1 > 0 \\Rightarrow \\dfrac{x-6}{x+1} > 0$." },
        { "tipe": "paragraph", "text": "Titik kritis: $x = 6$, $x = -1$ (dikecualikan). HP: $x < -1$ atau $x > 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai maksimum $f = 2x + 3y$ pada $x + 2y \\leq 6$, $2x + y \\leq 6$, $x,y \\geq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$11$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik sudut daerah: $(0,0) \\Rightarrow 0$, $(3,0) \\Rightarrow 6$, $(0,3) \\Rightarrow 9$, dan titik potong $(2,2) \\Rightarrow 2(2)+3(2) = 10$." },
        { "tipe": "paragraph", "text": "Nilai maksimum adalah $10$ di titik $(2,2)$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $|x + 1| < |2x - 3|$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < \\dfrac{2}{3}$ atau $x > 4$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{2}{3} < x < 4$" }],
        [{ "tipe": "paragraph", "text": "$x < -4$ atau $x > \\dfrac{2}{3}$" }],
        [{ "tipe": "paragraph", "text": "$-4 < x < \\dfrac{2}{3}$" }],
        [{ "tipe": "paragraph", "text": "$x > 4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kuadratkan kedua ruas: $(x+1)^2 < (2x-3)^2$." },
        { "tipe": "paragraph", "text": "$(x+1)^2 - (2x-3)^2 < 0 \\Rightarrow ((x+1)-(2x-3))((x+1)+(2x-3)) < 0$." },
        { "tipe": "paragraph", "text": "$(-x+4)(3x-2) < 0 \\Rightarrow (x-4)(3x-2) > 0$." },
        { "tipe": "paragraph", "text": "Maka HP: $x < 2/3$ atau $x > 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y \\geq 4$, $x + 2y \\leq 8$, $x \\geq 0$, $y \\geq 0$. Luas daerah penyelesaian adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$9$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik sudut daerah di Kuadran I: $(4,0)$, $(8,0)$, dan $(0,4)$." },
        { "tipe": "paragraph", "text": "Luas = $\\dfrac{1}{2} \\times \\text{alas} \\times \\text{tinggi} = \\dfrac{1}{2} \\times (8 - 4) \\times 4 = 8$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\dfrac{x^2 - 4}{x + 3} \\leq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < -3$ atau $-2 \\leq x \\leq 2$" }],
        [{ "tipe": "paragraph", "text": "$-3 < x \\leq -2$ atau $x \\geq 2$" }],
        [{ "tipe": "paragraph", "text": "$-2 \\leq x \\leq 2$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 2$" }],
        [{ "tipe": "paragraph", "text": "$-3 \\leq x \\leq 2$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{(x-2)(x+2)}{x+3} \\leq 0$. Pembuat nol: $x = -3$ (dikecualikan), $x = -2$, $x = 2$." },
        { "tipe": "paragraph", "text": "Uji interval: negatif pada $x < -3$ dan $-2 \\leq x \\leq 2$." },
        { "tipe": "paragraph", "text": "Maka HP: $x < -3$ atau $-2 \\leq x \\leq 2$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $|2x - 3| = 5$, nilai $x_1 + x_2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$2x-3=5 \\Rightarrow x_1=4$; $2x-3=-5 \\Rightarrow x_2=-1$." },
        { "tipe": "paragraph", "text": "Maka $x_1+x_2 = 4 + (-1) = 3$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
