{
  "id": "bs-k10-spl-sulit-08",
  "nama": "Bank Soal Sulit - Paket 8",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Pertidaksamaan pecahan, nilai mutlak, dan sistem pertidaksamaan lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-08-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{x^2 - 9}{x - 1} \\geq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$-3 \\leq x < 1$ atau $x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq -3$ atau $1 < x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$-3 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$-3 < x < 1$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pembilang dan tentukan titik-titik kritis**" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x - 3)(x + 3)}{x - 1} \\geq 0, \\qquad x \\neq 1" },
        { "tipe": "paragraph", "text": "Pembuat nol pembilang adalah $x = -3$ dan $x = 3$ (termasuk penyelesaian), sedangkan pembuat nol penyebut adalah $x = 1$ (dikecualikan)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji tanda pada setiap interval garis bilangan**" },
        { "tipe": "formula_block", "latex": "x \\leq -3 : -\\dfrac{7}{5} < 0 \\text{ (tidak)}, \\qquad -3 \\leq x < 1 : +9 > 0 \\text{ (ya)}, \\qquad 1 < x \\leq 3 : -5 < 0 \\text{ (tidak)}, \\qquad x \\geq 3 : +\\dfrac{7}{3} > 0 \\text{ (ya)}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$-3 \\leq x < 1$ atau $x \\geq 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $|2x - 1| \\geq x + 2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x \\leq -\\dfrac{1}{3}$ atau $x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$-\\dfrac{1}{3} \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq -3$ atau $x \\geq \\dfrac{1}{3}$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Uraikan pertidaksamaan nilai mutlak menjadi dua kasus linear**" },
        { "tipe": "formula_block", "latex": "2x - 1 \\leq -(x + 2) \\Rightarrow 3x \\leq -1 \\Rightarrow x \\leq -\\dfrac{1}{3}" },
        { "tipe": "formula_block", "latex": "2x - 1 \\geq x + 2 \\Rightarrow x \\geq 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Verifikasi dan gabungkan penyelesaian kedua kasus**" },
        { "tipe": "paragraph", "text": "Kedua interval memenuhi pertidaksamaan awal $|2x - 1| \\geq x + 2$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x \\leq -\\dfrac{1}{3}$ atau $x \\geq 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y \\leq 6$, $2x + y \\geq 6$, $x \\geq 0$, $y \\geq 0$. Nilai minimum $f = 3x + 4y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$9$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$11$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik-titik sudut daerah penyelesaian pada kuadran I**" },
        { "tipe": "paragraph", "text": "Daerah di atas $2x + y = 6$ dan di bawah $x + y = 6$ pada $x \\geq 0, y \\geq 0$ memiliki titik sudut $(3, 0)$, $(6, 0)$, dan $(0, 6)$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji nilai $f(x, y) = 3x + 4y$ pada setiap titik sudut**" },
        { "tipe": "formula_block", "latex": "f(3, 0) = 3(3) + 4(0) = 9, \\qquad f(6, 0) = 3(6) + 4(0) = 18, \\qquad f(0, 6) = 3(0) + 4(6) = 24" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai minimum $f = 3x + 4y$ adalah **$9$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $|x - 2| + |x + 3| = 7$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\{-4, 3\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-3, 4\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-2, 3\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-4, 2\\}$" }],
        [{ "tipe": "paragraph", "text": "$\\{-3, 2\\}$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Bagi garis bilangan berdasarkan pembuat nol $x = -3$ dan $x = 2$**" },
        { "tipe": "paragraph", "text": "Pada interval $-3 \\leq x < 2$ diperoleh $-(x - 2) + (x + 3) = 7 \\Rightarrow 5 = 7$ (tidak memenuhi), sedangkan pada interval luar diperoleh:" },
        { "tipe": "formula_block", "latex": "x < -3 : -(x - 2) - (x + 3) = 7 \\Rightarrow -2x - 1 = 7 \\Rightarrow x = -4" },
        { "tipe": "formula_block", "latex": "x \\geq 2 : (x - 2) + (x + 3) = 7 \\Rightarrow 2x + 1 = 7 \\Rightarrow x = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Verifikasi syarat interval pada masing-masing nilai $x$**" },
        { "tipe": "paragraph", "text": "Nilai $x = -4$ memenuhi $x < -3$ dan $x = 3$ memenuhi $x \\geq 2$." },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$\\{-4, 3\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $\\dfrac{2x - 5}{x + 1} > 1$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < -1$ atau $x > 6$" }],
        [{ "tipe": "paragraph", "text": "$-1 < x < 6$" }],
        [{ "tipe": "paragraph", "text": "$x < -6$ atau $x > 1$" }],
        [{ "tipe": "paragraph", "text": "$-6 < x < 1$" }],
        [{ "tipe": "paragraph", "text": "$x > 6$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pindahkan $1$ ke ruas kiri dan samakan penyebut**" },
        { "tipe": "formula_block", "latex": "\\dfrac{2x - 5}{x + 1} - 1 > 0 \\Rightarrow \\dfrac{(2x - 5) - (x + 1)}{x + 1} > 0 \\Rightarrow \\dfrac{x - 6}{x + 1} > 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji tanda pada interval dengan titik kritis $x = -1$ dan $x = 6$**" },
        { "tipe": "formula_block", "latex": "x < -1 : +8 > 0 \\text{ (ya)}, \\qquad -1 < x < 6 : -6 < 0 \\text{ (tidak)}, \\qquad x > 6 : +\\dfrac{1}{8} > 0 \\text{ (ya)}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x < -1$ atau $x > 6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai maksimum $f = 2x + 3y$ pada $x + 2y \\leq 6$, $2x + y \\leq 6$, $x,y \\geq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$11$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari titik potong kedua garis batas dan titik sudut daerah fisibel**" },
        { "tipe": "paragraph", "text": "Dari $x + 2y = 6$ dan $2x + y = 6$ diperoleh titik potong $(2, 2)$, sehingga titik-titik sudut daerah penyelesaian di kuadran I adalah $(0, 0)$, $(3, 0)$, $(0, 3)$, dan $(2, 2)$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji nilai fungsi objektif $f(x, y) = 2x + 3y$ pada setiap titik sudut**" },
        { "tipe": "formula_block", "latex": "f(0, 0) = 0, \\qquad f(3, 0) = 6, \\qquad f(0, 3) = 9, \\qquad f(2, 2) = 2(2) + 3(2) = 10" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai maksimum $f = 2x + 3y$ adalah **$10$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Himpunan penyelesaian $|x + 1| < |2x - 3|$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < \\dfrac{2}{3}$ atau $x > 4$" }],
        [{ "tipe": "paragraph", "text": "$\\dfrac{2}{3} < x < 4$" }],
        [{ "tipe": "paragraph", "text": "$x < -4$ atau $x > \\dfrac{2}{3}$" }],
        [{ "tipe": "paragraph", "text": "$-4 < x < \\dfrac{2}{3}$" }],
        [{ "tipe": "paragraph", "text": "$x > 4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas dan gunakan sifat selisih kuadrat**" },
        { "tipe": "formula_block", "latex": "(x + 1)^2 - (2x - 3)^2 < 0 \\Rightarrow (-x + 4)(3x - 2) < 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kalikan dengan $-1$ dan tentukan interval penyelesaian**" },
        { "tipe": "formula_block", "latex": "(x - 4)(3x - 2) > 0 \\Rightarrow x < \\dfrac{2}{3} \\text{ atau } x > 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaiannya adalah **$x < \\dfrac{2}{3}$ atau $x > 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y \\geq 4$, $x + 2y \\leq 8$, $x \\geq 0$, $y \\geq 0$. Luas daerah penyelesaian adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$9$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik sudut daerah penyelesaian berbentuk segitiga**" },
        { "tipe": "paragraph", "text": "Pada kuadran I ($x \\geq 0, y \\geq 0$), daerah di atas $x + y = 4$ dan di bawah $x + 2y = 8$ memiliki titik sudut $(4, 0)$, $(8, 0)$, dan $(0, 4)$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung luas segitiga dengan alas $8 - 4 = 4$ dan tinggi $4$**" },
        { "tipe": "formula_block", "latex": "\\text{Luas} = \\dfrac{1}{2} \\times 4 \\times 4 = 8" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, luas daerah penyelesaian tersebut adalah **$8$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\dfrac{x^2 - 4}{x + 3} \\leq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x < -3$ atau $-2 \\leq x \\leq 2$" }],
        [{ "tipe": "paragraph", "text": "$-3 < x \\leq -2$ atau $x \\geq 2$" }],
        [{ "tipe": "paragraph", "text": "$-2 \\leq x \\leq 2$" }],
        [{ "tipe": "paragraph", "text": "$x \\leq -2$ atau $x \\geq 2$" }],
        [{ "tipe": "paragraph", "text": "$-3 \\leq x \\leq 2$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pembilang dan tentukan titik-titik kritis**" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x - 2)(x + 2)}{x + 3} \\leq 0, \\qquad x \\neq -3" },
        { "tipe": "paragraph", "text": "Pembuat nol pembilang adalah $x = -2$ dan $x = 2$ (termasuk penyelesaian), sedangkan pembuat nol penyebut adalah $x = -3$ (dikecualikan)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji tanda pada setiap interval garis bilangan**" },
        { "tipe": "formula_block", "latex": "x < -3 : -12 < 0 \\text{ (ya)}, \\qquad -3 < x \\leq -2 : +4{,}5 > 0 \\text{ (tidak)}, \\qquad -2 \\leq x \\leq 2 : -\\dfrac{4}{3} < 0 \\text{ (ya)}, \\qquad x \\geq 2 : +\\dfrac{5}{6} > 0 \\text{ (tidak)}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x < -3$ atau $-2 \\leq x \\leq 2$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-08-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $|2x - 3| = 5$, nilai $x_1 + x_2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari kedua akar persamaan nilai mutlak**" },
        { "tipe": "formula_block", "latex": "2x - 3 = 5 \\Rightarrow x_1 = 4 \\qquad \\text{dan} \\qquad 2x - 3 = -5 \\Rightarrow x_2 = -1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x_1 + x_2$**" },
        { "tipe": "formula_block", "latex": "x_1 + x_2 = 4 + (-1) = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1 + x_2$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
