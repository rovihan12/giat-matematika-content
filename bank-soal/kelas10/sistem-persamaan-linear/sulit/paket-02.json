{
  "id": "bs-k10-spl-sulit-02",
  "nama": "Bank Soal Sulit - Paket 2",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit tentang sistem persamaan nonlinear sederhana dan identitas aljabar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-02-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $x^2 + y^2 = 25$ dan $x + y = 7$ adalah $(x_1, y_1)$ dan $(x_2, y_2)$ dengan $x_1 > x_2$. Nilai $x_1 - y_1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $y = 7 - x$ ke persamaan $x^2 + y^2 = 25$**" },
        { "tipe": "formula_block", "latex": "x^2 + (7 - x)^2 = 25 \\Rightarrow 2x^2 - 14x + 24 = 0 \\Rightarrow x^2 - 7x + 12 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan persamaan kuadrat dan tentukan $(x_1, y_1)$ dengan $x_1 > x_2$**" },
        { "tipe": "formula_block", "latex": "(x - 3)(x - 4) = 0 \\Rightarrow x_1 = 4 \\quad \\text{dan} \\quad y_1 = 7 - 4 = 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $x_1 - y_1$**" },
        { "tipe": "formula_block", "latex": "x_1 - y_1 = 4 - 3 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1 - y_1$ adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian sistem $x^2 - y^2 = 9$ dan $x + y = 3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{(3, 0)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(0, 3)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(-3, 0)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(0, -3)\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{(3, 3)\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan $x^2 - y^2 = 9$ dan substitusikan $x + y = 3$**" },
        { "tipe": "formula_block", "latex": "(x - y)(x + y) = 9 \\Rightarrow (x - y) \\cdot 3 = 9 \\Rightarrow x - y = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi dan substitusi untuk memperoleh nilai $x$ dan $y$**" },
        { "tipe": "paragraph", "text": "Jumlahkan $x + y = 3$ dan $x - y = 3$ untuk mendapatkan $2x = 6 \\Rightarrow x = 3$, lalu substitusikan ke $x + y = 3$:" },
        { "tipe": "formula_block", "latex": "3 + y = 3 \\Rightarrow y = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, himpunan penyelesaian sistem tersebut adalah **$\\\\{(3, 0)\\\\}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $x^2 + y^2 = 20$ dan $xy = 8$. Nilai $(x + y)^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$36$" } ],
        [ { "tipe": "paragraph", "text": "$40$" } ]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan $(x + y)^2$ dan substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui $x^2 + y^2 = 20$ dan $xy = 8$:" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = (x^2 + y^2) + 2xy = 20 + 2(8) = 20 + 16 = 36" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(x + y)^2$ adalah **$36$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Penyelesaian sistem $\\dfrac{1}{x} + \\dfrac{2}{y} = 3$ dan $\\dfrac{2}{x} - \\dfrac{1}{y} = 1$ adalah $(x, y)$. Nilai $x \\cdot y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, lalu eliminasi $b$**" },
        { "tipe": "paragraph", "text": "Dari $a + 2b = 3$ dan $2a - b = 1$, jumlahkan persamaan pertama dengan $2$ kali persamaan kedua:" },
        { "tipe": "formula_block", "latex": "5a = 5 \\Rightarrow a = 1 \\quad \\text{dan} \\quad 1 + 2b = 3 \\Rightarrow b = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$, $y$, dan hitung $x \\cdot y$**" },
        { "tipe": "formula_block", "latex": "x = 1, \\quad y = 1 \\Rightarrow x \\cdot y = 1 \\cdot 1 = 1" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x \\cdot y$ adalah **$1$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui $x + y + z = 9$, $x^2 + y^2 + z^2 = 35$, dan $xy + xz + yz = 23$. Nilai $(x - 1)(y - 1)(z - 1)$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$0$" } ],
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan $(x - 1)(y - 1)(z - 1)$ dalam bentuk simetris dan identitas kubik**" },
        { "tipe": "paragraph", "text": "Dengan mensubstitusikan $t = 1$ pada identitas akar kubik $(t - x)(t - y)(t - z) = t^3 - (x+y+z)t^2 + (xy+xz+yz)t - xyz$, diperoleh:" },
        { "tipe": "formula_block", "latex": "(x - 1)(y - 1)(z - 1) = xyz - (xy + xz + yz) + (x + y + z) - 1 = xyz - 23 + 9 - 1 = xyz - 15" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $xyz$ dari identitas aljabar**" },
        { "tipe": "paragraph", "text": "Dari $(x + y + z)^2 = x^2 + y^2 + z^2 + 2(xy + xz + yz)$ memenuhi $9^2 = 35 + 2(23) = 81$. Untuk bilangan bulat positif yang memenuhi jumlah $9$, jumlah kuadrat $35$, dan jumlah hasil kali dua-dua $23$, yaitu $1$, $3$, dan $5$, berlaku $xyz = 1 \\cdot 3 \\cdot 5 = 15$:" },
        { "tipe": "formula_block", "latex": "(x - 1)(y - 1)(z - 1) = 15 - 15 = 0" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(x - 1)(y - 1)(z - 1)$ adalah **$0$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y = 5$ dan $xy = 6$, nilai $x^3 + y^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$35$" } ],
        [ { "tipe": "paragraph", "text": "$45$" } ],
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas jumlah pangkat tiga dan substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui $x + y = 5$ dan $xy = 6$:" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 = (x + y)^3 - 3xy(x + y) = 5^3 - 3(6)(5) = 125 - 90 = 35" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + y^3$ adalah **$35$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + y = 4$ dan $x^2 + y^2 = 10$ memiliki solusi $(x_1, y_1)$ dan $(x_2, y_2)$ dengan $x_1 > x_2$. Nilai $x_1 \\cdot y_1$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $y = 4 - x$ ke persamaan $x^2 + y^2 = 10$**" },
        { "tipe": "formula_block", "latex": "x^2 + (4 - x)^2 = 10 \\Rightarrow 2x^2 - 8x + 6 = 0 \\Rightarrow x^2 - 4x + 3 = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Faktorkan persamaan kuadrat dan hitung $x_1 \\cdot y_1$ dengan $x_1 > x_2$**" },
        { "tipe": "formula_block", "latex": "(x - 1)(x - 3) = 0 \\Rightarrow x_1 = 3 \\quad \\text{dan} \\quad y_1 = 4 - 3 = 1" },
        { "tipe": "formula_block", "latex": "x_1 \\cdot y_1 = 3 \\cdot 1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x_1 \\cdot y_1$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $a + b = 7$ dan $ab = 12$, nilai $\\dfrac{1}{a} + \\dfrac{1}{b}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{12}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{7}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{12}{5}$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Samakan penyebut lalu substitusikan $a + b = 7$ dan $ab = 12$**" },
        { "tipe": "formula_block", "latex": "\\dfrac{1}{a} + \\dfrac{1}{b} = \\dfrac{a + b}{ab} = \\dfrac{7}{12}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $\\dfrac{1}{a} + \\dfrac{1}{b}$ adalah **$\\dfrac{7}{12}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x^2 - y = 3$ dan $x - y = 1$ memiliki solusi $(x, y)$ dengan $x > 0$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi $y$ dan faktorkan persamaan kuadrat untuk $x > 0$**" },
        { "tipe": "paragraph", "text": "Kurangkan persamaan kedua dari pertama:" },
        { "tipe": "formula_block", "latex": "(x^2 - y) - (x - y) = 3 - 1 \\Rightarrow x^2 - x - 2 = 0 \\Rightarrow (x - 2)(x + 1) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $y$ dan hitung $x + y$**" },
        { "tipe": "paragraph", "text": "Karena $x > 0$, maka $x = 2$, sehingga $y = 2 - 1 = 1$:" },
        { "tipe": "formula_block", "latex": "x + y = 2 + 1 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-02-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 3$, nilai $x^2 + \\dfrac{1}{x^2}$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$11$" } ],
        [ { "tipe": "paragraph", "text": "$13$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas persamaan $x + \\dfrac{1}{x} = 3$**" },
        { "tipe": "formula_block", "latex": "\\left(x + \\dfrac{1}{x}\\right)^2 = 3^2 \\Rightarrow x^2 + 2 \\cdot x \\cdot \\dfrac{1}{x} + \\dfrac{1}{x^2} = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan dan pindahkan konstanta ke ruas kanan**" },
        { "tipe": "formula_block", "latex": "x^2 + 2 + \\dfrac{1}{x^2} = 9 \\Rightarrow x^2 + \\dfrac{1}{x^2} = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^2 + \\dfrac{1}{x^2}$ adalah **$7$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
