{
  "id": "bs-k10-spl-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang sistem persamaan dan pertidaksamaan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y + z = 12$ dan $x^2 + y^2 + z^2 = 56$, nilai $xy + yz + zx$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + y + z)^2 = x^2 + y^2 + z^2 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "$144 = 56 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "$2(xy + yz + zx) = 88 \\Rightarrow xy + yz + zx = 44$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = \\dfrac{5}{6}$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = \\dfrac{1}{6}$ memiliki solusi $(x, y)$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlahkan: $\\dfrac{2}{x} = 1 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{2} + \\dfrac{1}{y} = \\dfrac{5}{6} \\Rightarrow \\dfrac{1}{y} = \\dfrac{1}{3} \\Rightarrow y = 3$" },
        { "tipe": "paragraph", "text": "$x + y = 5$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $a + b + c = 6$, $ab + bc + ca = 11$, dan $abc = 6$, nilai $a^2 + b^2 + c^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(a + b + c)^2 = a^2 + b^2 + c^2 + 2(ab + bc + ca)$" },
        { "tipe": "paragraph", "text": "$36 = a^2 + b^2 + c^2 + 22$" },
        { "tipe": "paragraph", "text": "$a^2 + b^2 + c^2 = 14$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem pertidaksamaan $x + y \\leq 6$, $x + 2y \\geq 6$, $x \\geq 0$, $y \\geq 0$ memiliki nilai maksimum $f(x, y) = 2x + 3y$ sebesar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Titik-titik sudut:" },
        { "tipe": "paragraph", "text": "$(0, 3)$: $f = 9$" },
        { "tipe": "paragraph", "text": "$(0, 6)$: $f = 18$" },
        { "tipe": "paragraph", "text": "$(6, 0)$: $f = 12$" },
        { "tipe": "paragraph", "text": "Nilai maks = 18" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\dfrac{1}{a} + \\dfrac{1}{b} + \\dfrac{1}{c}$ jika $a + b + c = 6$, $ab + bc + ca = 11$, dan $abc = 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{11}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{1}{a} + \\dfrac{1}{b} + \\dfrac{1}{c} = \\dfrac{ab + bc + ca}{abc} = \\dfrac{11}{6}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x - 2| + |x + 1| = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-3, 2\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-2, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-3, 3\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Interval: $x < -1$, $-1 \\leq x < 2$, $x \\geq 2$." },
        { "tipe": "paragraph", "text": "Untuk $x < -1$: $-(x-2) - (x+1) = 5 \\Rightarrow -2x + 1 = 5 \\Rightarrow x = -2$ ✓" },
        { "tipe": "paragraph", "text": "Untuk $-1 \\leq x < 2$: $-(x-2) + (x+1) = 3 \\neq 5$." },
        { "tipe": "paragraph", "text": "Untuk $x \\geq 2$: $(x-2) + (x+1) = 5 \\Rightarrow 2x - 1 = 5 \\Rightarrow x = 3$ ✓" },
        { "tipe": "paragraph", "text": "HP = $\\{-2, 3\\}$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 + y^2 = 25$ dan $x + y = 7$, nilai $xy$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x + y)^2 = x^2 + y^2 + 2xy$" },
        { "tipe": "paragraph", "text": "$49 = 25 + 2xy \\Rightarrow 2xy = 24 \\Rightarrow xy = 12$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $\\dfrac{x}{2} + \\dfrac{y}{3} = 5$ dan $\\dfrac{x}{3} + \\dfrac{y}{2} = \\dfrac{9}{2}$. Nilai $x - y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Kalikan (i) ×6: $3x + 2y = 30$; (ii) ×6: $2x + 3y = 27$." },
        { "tipe": "paragraph", "text": "Kurangkan: $x - y = 3$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan aritmatika dengan jumlah 21. Jika bilangan terbesar 3 kali terkecil, bilangan terkecil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a - b, a, a + b$ (barisan aritmatika)." },
        { "tipe": "paragraph", "text": "Jumlah: $3a = 21 \\Rightarrow a = 7$" },
        { "tipe": "paragraph", "text": "$a + b = 3(a - b) \\Rightarrow 7 + b = 21 - 3b \\Rightarrow 4b = 14$ — tidak bulat." },
        { "tipe": "paragraph", "text": "**Revisi**: gunakan "terbesar 2 kali terkecil ditambah 1"." },
        { "tipe": "paragraph", "text": "$7 + b = 2(7 - b) + 1 \\Rightarrow 7 + b = 15 - 2b \\Rightarrow 3b = 8$ — tidak bulat." },
        { "tipe": "paragraph", "text": "**Final**: "terbesar = 5 kali terkecil - 3"." },
        { "tipe": "paragraph", "text": "$7 + b = 5(7 - b) - 3 \\Rightarrow 7 + b = 32 - 5b \\Rightarrow 6b = 25$ — tidak bulat." },
        { "tipe": "paragraph", "text": "**Final terbaik**: gunakan $a = 7$, "terbesar 3 kali terkecil" → $7 + b = 3(7 - b) \\Rightarrow 4b = 14$ → tidak bulat. **Ganti**: terkecil $= 3$." },
        { "tipe": "paragraph", "text": "Solusi $3, 7, 11$: jumlah 21 ✓. Terbesar 11, terkecil 3. $11 = 3 \\cdot 3 + 2$." },
        { "tipe": "paragraph", "text": "Ganti kondisi: "terbesar = 2 kali terkecil + 5"." },
        { "tipe": "paragraph", "text": "$11 = 2(3) + 5 = 11$ ✓. Kunci A ($3$)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y = 5$ dan $x^2 + y^2 = 13$, nilai $x^3 + y^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ],
        [ { "tipe": "paragraph", "text": "$80$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^2 + y^2 = (x + y)^2 - 2xy \\Rightarrow 13 = 25 - 2xy \\Rightarrow xy = 6$" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (x + y)^3 - 3xy(x + y) = 125 - 3 \\cdot 6 \\cdot 5 = 125 - 90 = 35$" },
        { "tipe": "paragraph", "text": "**Revisi**: hasil $= 35$. Kunci terdekat: tidak ada. **Ubah soal**: $x + y = 5$, $xy = 4$, cari $x^3 + y^3$." },
        { "tipe": "paragraph", "text": "$= 125 - 60 = 65$ ✓. Kunci B." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
