{
  "id": "bs-k10-spl-sulit-05",
  "nama": "Bank Soal Sulit - Paket 5",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Soal sulit OSN-style tentang sistem persamaan dan pertidaksamaan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-05-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y + z = 12$ dan $x^2 + y^2 + z^2 = 56$, nilai $xy + yz + zx$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$40$" } ],
        [ { "tipe": "paragraph", "text": "$42$" } ],
        [ { "tipe": "paragraph", "text": "$44$" } ],
        [ { "tipe": "paragraph", "text": "$46$" } ],
        [ { "tipe": "paragraph", "text": "$48$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat tiga variabel**" },
        { "tipe": "paragraph", "text": "$(x + y + z)^2 = x^2 + y^2 + z^2 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui ke dalam rumus**" },
        { "tipe": "paragraph", "text": "Diketahui $x + y + z = 12$ dan $x^2 + y^2 + z^2 = 56$, maka:" },
        { "tipe": "paragraph", "text": "$(12)^2 = 56 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "$144 = 56 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Selesaikan persamaan untuk mencari $xy + yz + zx$**" },
        { "tipe": "paragraph", "text": "$2(xy + yz + zx) = 144 - 56$" },
        { "tipe": "paragraph", "text": "$2(xy + yz + zx) = 88$" },
        { "tipe": "paragraph", "text": "$xy + yz + zx = \\dfrac{88}{2} = 44$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = \\dfrac{5}{6}$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = \\dfrac{1}{6}$ memiliki solusi $(x, y)$. Nilai $x + y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $\\dfrac{1}{y}$ dengan menjumlahkan kedua persamaan**" },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{x} + \\dfrac{1}{y}\\right) + \\left(\\dfrac{1}{x} - \\dfrac{1}{y}\\right) = \\dfrac{5}{6} + \\dfrac{1}{6}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{2}{x} = \\dfrac{6}{6} = 1 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 2$ ke persamaan pertama untuk mencari $y$**" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{2} + \\dfrac{1}{y} = \\dfrac{5}{6}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{y} = \\dfrac{5}{6} - \\dfrac{1}{2} = \\dfrac{5 - 3}{6} = \\dfrac{2}{6} = \\dfrac{1}{3}$" },
        { "tipe": "paragraph", "text": "Diperoleh $y = 3$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $x + y$**" },
        { "tipe": "paragraph", "text": "$x + y = 2 + 3 = 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $a + b + c = 6$, $ab + bc + ca = 11$, dan $abc = 6$, nilai $a^2 + b^2 + c^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$16$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat jumlah tiga bilangan**" },
        { "tipe": "paragraph", "text": "$(a + b + c)^2 = a^2 + b^2 + c^2 + 2(ab + bc + ca)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui** (informasi $abc = 6$ tidak diperlukan dalam rumus ini)" },
        { "tipe": "paragraph", "text": "$(6)^2 = a^2 + b^2 + c^2 + 2(11)$" },
        { "tipe": "paragraph", "text": "$36 = a^2 + b^2 + c^2 + 22$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $a^2 + b^2 + c^2$**" },
        { "tipe": "paragraph", "text": "$a^2 + b^2 + c^2 = 36 - 22 = 14$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem pertidaksamaan $x + y \\leq 6$, $x + 2y \\geq 6$, $x \\geq 0$, $y \\geq 0$ memiliki nilai maksimum $f(x, y) = 2x + 3y$ sebesar..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ],
        [ { "tipe": "paragraph", "text": "$18$" } ],
        [ { "tipe": "paragraph", "text": "$20$" } ],
        [ { "tipe": "paragraph", "text": "$24$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan titik potong garis batas dengan sumbu koordinat**" },
        { "tipe": "paragraph", "text": "• Garis $x + y = 6$: memotong sumbu-$x$ di $(6, 0)$ dan sumbu-$y$ di $(0, 6)$." },
        { "tipe": "paragraph", "text": "• Garis $x + 2y = 6$: memotong sumbu-$x$ di $(6, 0)$ dan sumbu-$y$ di $(0, 3)$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan titik-titik sudut daerah penyelesaian**" },
        { "tipe": "paragraph", "text": "Daerah fisibel berada di kuadran I ($x \\geq 0, y \\geq 0$), di bawah garis $x + y = 6$, dan di atas garis $x + 2y = 6$." },
        { "tipe": "paragraph", "text": "Ketiga titik sudut yang membatasi daerah segitiga tersebut adalah $(0, 3)$, $(0, 6)$, dan $(6, 0)$." },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji setiap titik sudut ke fungsi objektif $f(x, y) = 2x + 3y$**" },
        { "tipe": "paragraph", "text": "• Titik $(0, 3)$: $f(0, 3) = 2(0) + 3(3) = 9$" },
        { "tipe": "paragraph", "text": "• Titik $(0, 6)$: $f(0, 6) = 2(0) + 3(6) = 18$" },
        { "tipe": "paragraph", "text": "• Titik $(6, 0)$: $f(6, 0) = 2(6) + 3(0) = 12$" },
        { "tipe": "paragraph", "text": "Jadi, nilai maksimumnya adalah $18$ (dicapai di titik $(0, 6)$)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $\\dfrac{1}{a} + \\dfrac{1}{b} + \\dfrac{1}{c}$ jika $a + b + c = 6$, $ab + bc + ca = 11$, dan $abc = 6$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{6}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{6}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{11}{5}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{11}$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Samakan penyebut ketiga pecahan menjadi $abc$**" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{a} + \\dfrac{1}{b} + \\dfrac{1}{c} = \\dfrac{bc}{abc} + \\dfrac{ac}{abc} + \\dfrac{ab}{abc}$" },
        { "tipe": "paragraph", "text": "Gabungkan pembilangnya dan urutkan:" },
        { "tipe": "paragraph", "text": "$= \\dfrac{ab + bc + ca}{abc}$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui $ab + bc + ca = 11$ dan $abc = 6$, maka:" },
        { "tipe": "paragraph", "text": "$\\dfrac{ab + bc + ca}{abc} = \\dfrac{11}{6}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Himpunan penyelesaian $|x - 2| + |x + 1| = 5$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\{-2, 3\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-1, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-3, 2\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-2, 4\\}$" } ],
        [ { "tipe": "paragraph", "text": "$\\{-3, 3\\}$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan pembuat nol masing-masing nilai mutlak**" },
        { "tipe": "paragraph", "text": "• $|x + 1| = 0 \\Rightarrow x = -1$" },
        { "tipe": "paragraph", "text": "• $|x - 2| = 0 \\Rightarrow x = 2$" },
        { "tipe": "paragraph", "text": "Kedua titik membagi garis bilangan menjadi 3 kasus interval:" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan pada setiap interval**" },
        { "tipe": "paragraph", "text": "• **Kasus 1: Untuk $x < -1$**" },
        { "tipe": "paragraph", "text": "Kedua bentuk di dalam mutlak bernilai negatif, sehingga:" },
        { "tipe": "paragraph", "text": "$-(x - 2) - (x + 1) = 5 \\Rightarrow -2x + 1 = 5 \\Rightarrow -2x = 4 \\Rightarrow x = -2$ (Memenuhi karena $-2 < -1$)." },
        { "tipe": "paragraph", "text": "• **Kasus 2: Untuk $-1 \\leq x < 2$**" },
        { "tipe": "paragraph", "text": "$(x - 2)$ negatif dan $(x + 1)$ tak negatif, sehingga:" },
        { "tipe": "paragraph", "text": "$-(x - 2) + (x + 1) = 5 \\Rightarrow -x + 2 + x + 1 = 5 \\Rightarrow 3 = 5$ (Tidak ada solusi pada interval ini)." },
        { "tipe": "paragraph", "text": "• **Kasus 3: Untuk $x \\geq 2$**" },
        { "tipe": "paragraph", "text": "Kedua bentuk di dalam mutlak bernilai tak negatif, sehingga:" },
        { "tipe": "paragraph", "text": "$(x - 2) + (x + 1) = 5 \\Rightarrow 2x - 1 = 5 \\Rightarrow 2x = 6 \\Rightarrow x = 3$ (Memenuhi karena $3 \\geq 2$)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Gabungkan semua solusi yang memenuhi**" },
        { "tipe": "paragraph", "text": "Jadi, himpunan penyelesaiannya adalah $\\{-2, 3\\}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x^2 + y^2 = 25$ dan $x + y = 7$, nilai $xy$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ],
        [ { "tipe": "paragraph", "text": "$14$" } ],
        [ { "tipe": "paragraph", "text": "$15$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan bentuk kuadrat $(x + y)^2$**" },
        { "tipe": "paragraph", "text": "$(x + y)^2 = x^2 + 2xy + y^2$" },
        { "tipe": "paragraph", "text": "Kelompokkan suku $x^2 + y^2$:" },
        { "tipe": "paragraph", "text": "$(x + y)^2 = (x^2 + y^2) + 2xy$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x + y = 7$ dan $x^2 + y^2 = 25$**" },
        { "tipe": "paragraph", "text": "$(7)^2 = 25 + 2xy$" },
        { "tipe": "paragraph", "text": "$49 = 25 + 2xy$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $xy$**" },
        { "tipe": "paragraph", "text": "$2xy = 49 - 25$" },
        { "tipe": "paragraph", "text": "$2xy = 24 \\Rightarrow xy = \\dfrac{24}{2} = 12$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $\\dfrac{x}{2} + \\dfrac{y}{3} = 5$ dan $\\dfrac{x}{3} + \\dfrac{y}{2} = \\dfrac{9}{2}$. Nilai $x - y$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Hilangkan pecahan dengan mengalikan kedua persamaan dengan KPK penyebutnya ($6$)**" },
        { "tipe": "paragraph", "text": "• Persamaan pertama dikali $6$: $6\\left(\\dfrac{x}{2} + \\dfrac{y}{3}\\right) = 6(5) \\Rightarrow 3x + 2y = 30$ ... (Persamaan 1)" },
        { "tipe": "paragraph", "text": "• Persamaan kedua dikali $6$: $6\\left(\\dfrac{x}{3} + \\dfrac{y}{2}\\right) = 6\\left(\\dfrac{9}{2}\\right) \\Rightarrow 2x + 3y = 27$ ... (Persamaan 2)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Kurangkan persamaan (1) dan persamaan (2) secara langsung**" },
        { "tipe": "paragraph", "text": "Perhatikan bahwa selisih koefisien kedua persamaan langsung menghasilkan $x - y$:" },
        { "tipe": "paragraph", "text": "$(3x + 2y) - (2x + 3y) = 30 - 27$" },
        { "tipe": "paragraph", "text": "$x - y = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Tiga bilangan membentuk barisan aritmatika dengan jumlah 21. Jika bilangan terbesar sama dengan 2 kali bilangan terkecil ditambah 5, bilangan terkecil adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan ketiga bilangan barisan aritmatika secara simetris**" },
        { "tipe": "paragraph", "text": "Misalkan suku tengah $= a$ dan beda barisan $= b$ (dengan $b > 0$), sehingga ketiga bilangan tersebut adalah:" },
        { "tipe": "paragraph", "text": "• Bilangan terkecil $= a - b$" },
        { "tipe": "paragraph", "text": "• Bilangan tengah $= a$" },
        { "tipe": "paragraph", "text": "• Bilangan terbesar $= a + b$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari suku tengah ($a$) dari jumlah ketiga bilangan**" },
        { "tipe": "paragraph", "text": "$(a - b) + a + (a + b) = 21$" },
        { "tipe": "paragraph", "text": "$3a = 21 \\Rightarrow a = 7$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Cari beda barisan ($b$) dari hubungan bilangan terbesar dan terkecil**" },
        { "tipe": "paragraph", "text": "Bilangan terbesar $= 2 \\times (\\text{bilangan terkecil}) + 5$" },
        { "tipe": "paragraph", "text": "$a + b = 2(a - b) + 5$" },
        { "tipe": "paragraph", "text": "Substitusikan $a = 7$:" },
        { "tipe": "paragraph", "text": "$7 + b = 2(7 - b) + 5$" },
        { "tipe": "paragraph", "text": "$7 + b = 14 - 2b + 5$" },
        { "tipe": "paragraph", "text": "$b + 2b = 19 - 7 \\Rightarrow 3b = 12 \\Rightarrow b = 4$" },
        { "tipe": "paragraph", "text": "**Langkah 4: Tentukan bilangan terkecil**" },
        { "tipe": "paragraph", "text": "Bilangan terkecil $= a - b = 7 - 4 = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-05-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $x + y = 5$ dan $xy = 4$, nilai $x^3 + y^3$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$55$" } ],
        [ { "tipe": "paragraph", "text": "$60$" } ],
        [ { "tipe": "paragraph", "text": "$65$" } ],
        [ { "tipe": "paragraph", "text": "$70$" } ],
        [ { "tipe": "paragraph", "text": "$75$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas penjumlahan pangkat tiga**" },
        { "tipe": "paragraph", "text": "Dari penjabaran $(x + y)^3 = x^3 + y^3 + 3xy(x + y)$, diperoleh:" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (x + y)^3 - 3xy(x + y)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x + y = 5$ dan $xy = 4$**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (5)^3 - 3(4)(5)$" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = 125 - 60 = 65$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
