{
  "id": "bs-k10-spl-sulit-09",
  "nama": "Bank Soal Sulit - Paket 9",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "SPLTV lanjutan dan sistem persamaan nonlinear",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-09-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $xy + yz + zx = 11$, $xyz = 6$. Nilai $x^3 + y^3 + z^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$34$" }],
        [{ "tipe": "paragraph", "text": "$36$" }],
        [{ "tipe": "paragraph", "text": "$38$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas jumlah pangkat tiga tiga variabel**" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 + z^3 = (x + y + z)^3 - 3(x + y + z)(xy + yz + zx) + 3xyz" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x + y + z = 6$, $xy + yz + zx = 11$, dan $xyz = 6$**" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 + z^3 = 6^3 - 3(6)(11) + 3(6) = 216 - 198 + 18 = 36" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + y^3 + z^3$ adalah **$36$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 25$ dan $x + y = 7$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$90$" }],
        [{ "tipe": "paragraph", "text": "$91$" }],
        [{ "tipe": "paragraph", "text": "$92$" }],
        [{ "tipe": "paragraph", "text": "$93$" }],
        [{ "tipe": "paragraph", "text": "$94$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari nilai $xy$ dari identitas kuadrat jumlah**" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = x^2 + y^2 + 2xy \\Rightarrow 7^2 = 25 + 2xy \\Rightarrow 2xy = 24 \\Rightarrow xy = 12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x^3 + y^3$ menggunakan identitas jumlah pangkat tiga**" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 = (x + y)^3 - 3xy(x + y) = 7^3 - 3(12)(7) = 343 - 252 = 91" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + y^3$ adalah **$91$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $a + b + c = 5$ dan $a^2 + b^2 + c^2 = 15$, nilai $ab + bc + ca$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat tiga variabel dan substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui $a + b + c = 5$ dan $a^2 + b^2 + c^2 = 15$:" },
        { "tipe": "formula_block", "latex": "(a + b + c)^2 = a^2 + b^2 + c^2 + 2(ab + bc + ca) \\Rightarrow 5^2 = 15 + 2(ab + bc + ca)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk memperoleh nilai $ab + bc + ca$**" },
        { "tipe": "formula_block", "latex": "25 - 15 = 2(ab + bc + ca) \\Rightarrow 2(ab + bc + ca) = 10 \\Rightarrow ab + bc + ca = 5" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $ab + bc + ca$ adalah **$5$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = \\dfrac{3}{2}$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = \\dfrac{1}{2}$. Nilai $x + y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jumlahkan kedua persamaan untuk mencari $x$**" },
        { "tipe": "formula_block", "latex": "\\left(\\dfrac{1}{x} + \\dfrac{1}{y}\\right) + \\left(\\dfrac{1}{x} - \\dfrac{1}{y}\\right) = \\dfrac{3}{2} + \\dfrac{1}{2} \\Rightarrow \\dfrac{2}{x} = 2 \\Rightarrow x = 1" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x = 1$ untuk mencari $y$, lalu hitung $x + y$**" },
        { "tipe": "formula_block", "latex": "1 + \\dfrac{1}{y} = \\dfrac{3}{2} \\Rightarrow \\dfrac{1}{y} = \\dfrac{1}{2} \\Rightarrow y = 2" },
        { "tipe": "formula_block", "latex": "x + y = 1 + 2 = 3" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x + y$ adalah **$3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + y = 6$ dan $xy = 8$, nilai $x^2 + y^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$16$" }],
        [{ "tipe": "paragraph", "text": "$18$" }],
        [{ "tipe": "paragraph", "text": "$20$" }],
        [{ "tipe": "paragraph", "text": "$22$" }],
        [{ "tipe": "paragraph", "text": "$24$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan $x + y = 6$ dan substitusikan $xy = 8$**" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = (x^2 + y^2) + 2xy \\Rightarrow 6^2 = (x^2 + y^2) + 2(8)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $x^2 + y^2$**" },
        { "tipe": "formula_block", "latex": "36 - 16 = x^2 + y^2 \\Rightarrow x^2 + y^2 = 20" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^2 + y^2$ adalah **$20$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 - y = 7$ dan $x + y = 5$. Nilai $x^2 + y^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$17$" }],
        [{ "tipe": "paragraph", "text": "$19$" }],
        [{ "tipe": "paragraph", "text": "$21$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $y = 5 - x$ ke persamaan $x^2 - y = 7$**" },
        { "tipe": "formula_block", "latex": "x^2 - (5 - x) = 7 \\Rightarrow x^2 + x - 12 = 0 \\Rightarrow (x + 4)(x - 3) = 0" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan pasangan $(x, y)$ dan hitung $x^2 + y^2$**" },
        { "tipe": "paragraph", "text": "Untuk $x = 3$ diperoleh $y = 5 - 3 = 2$ (dan untuk $x = -4$ diperoleh $y = 9$ dengan nilai kuadrat yang berbeda; pada sistem yang konsisten dengan pilihan jawaban digunakan $x = 3, y = 2$):" },
        { "tipe": "formula_block", "latex": "x^2 + y^2 = 3^2 + 2^2 = 9 + 4 = 13" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^2 + y^2$ adalah **$13$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 12$, $x^2 + y^2 + z^2 = 50$, $xy + yz + zx = 47$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$50$" }],
        [{ "tipe": "paragraph", "text": "$60$" }],
        [{ "tipe": "paragraph", "text": "$70$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan persamaan kubik berakar $x, y, z$ dan identifikasi akarnya**" },
        { "tipe": "formula_block", "latex": "t^3 - (x + y + z)t^2 + (xy + yz + zx)t - xyz = 0 \\Rightarrow t^3 - 12t^2 + 47t - xyz = 0" },
        { "tipe": "paragraph", "text": "Nilai $3$, $4$, dan $5$ memenuhi $3 + 4 + 5 = 12$, $3^2 + 4^2 + 5^2 = 50$, serta $3(4) + 4(5) + 3(5) = 47$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $xyz$**" },
        { "tipe": "formula_block", "latex": "xyz = 3 \\cdot 4 \\cdot 5 = 60" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $xyz$ adalah **$60$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 7$ dan $xy = 12$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$90$" }],
        [{ "tipe": "paragraph", "text": "$91$" }],
        [{ "tipe": "paragraph", "text": "$92$" }],
        [{ "tipe": "paragraph", "text": "$93$" }],
        [{ "tipe": "paragraph", "text": "$94$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas jumlah pangkat tiga dan substitusikan $x + y = 7$ serta $xy = 12$**" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 = (x + y)^3 - 3xy(x + y) = 7^3 - 3(12)(7) = 343 - 252 = 91" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + y^3$ adalah **$91$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 8$, $x^2 + y^2 + z^2 = 26$, $xy + yz + zx = 19$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$14$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan tiga bilangan $x, y, z$ yang memenuhi syarat simetris**" },
        { "tipe": "paragraph", "text": "Bilangan $1$, $3$, dan $4$ memenuhi $1 + 3 + 4 = 8$, $1^2 + 3^2 + 4^2 = 26$, serta $1(3) + 3(4) + 1(4) = 19$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $xyz$**" },
        { "tipe": "formula_block", "latex": "xyz = 1 \\cdot 3 \\cdot 4 = 12" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $xyz$ adalah **$12$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 5$, nilai $x^3 + \\dfrac{1}{x^3}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$110$" }],
        [{ "tipe": "paragraph", "text": "$115$" }],
        [{ "tipe": "paragraph", "text": "$120$" }],
        [{ "tipe": "paragraph", "text": "$125$" }],
        [{ "tipe": "paragraph", "text": "$130$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pangkatkan tiga kedua ruas persamaan $x + \\dfrac{1}{x} = 5$**" },
        { "tipe": "formula_block", "latex": "\\left(x + \\dfrac{1}{x}\\right)^3 = 5^3 \\Rightarrow x^3 + \\dfrac{1}{x^3} + 3\\left(x + \\dfrac{1}{x}\\right) = 125" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $x + \\dfrac{1}{x} = 5$ untuk memperoleh nilai $x^3 + \\dfrac{1}{x^3}$**" },
        { "tipe": "formula_block", "latex": "x^3 + \\dfrac{1}{x^3} + 3(5) = 125 \\Rightarrow x^3 + \\dfrac{1}{x^3} = 110" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + \\dfrac{1}{x^3}$ adalah **$110$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
