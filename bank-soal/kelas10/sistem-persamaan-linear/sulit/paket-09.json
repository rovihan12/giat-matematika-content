      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas penjumlahan pangkat tiga**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (x + y)^3 - 3xy(x + y)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x + y = 7$ dan $xy = 12$**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (7)^3 - 3(12)(7)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil akhirnya**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = 343 - 252 = 91$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 8$, $x^2 + y^2 + z^2 = 26$, $xy + yz + zx = 19$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$14$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi tiga bilangan yang memenuhi syarat simetris**" },
        { "tipe": "paragraph", "text": "Cari tiga bilangan $x, y, z$ dengan jumlah $8$, jumlah kuadrat $26$, dan jumlah hasil kali berpasangan $19$." },
        { "tipe": "paragraph", "text": "Bilangan yang memenuhi adalah $1, 3,$ dan $4$ karena:" },
        { "tipe": "paragraph", "text": "• $1 + 3 + 4 = 8$" },
        { "tipe": "paragraph", "text": "• $1^2 + 3^2 + 4^2 = 1 + 9 + 16 = 26$" },
        { "tipe": "paragraph", "text": "• $(1)(3) + (3)(4) + (1)(4) = 3 + 12 + 4 = 19$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $xyz$**" },
        { "tipe": "paragraph", "text": "$xyz = 1 \\cdot 3 \\cdot 4 = 12$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 5$, nilai $x^3 + \\dfrac{1}{x^3}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$110$" }],
        [{ "tipe": "paragraph", "text": "$115$" }],
        [{ "tipe": "paragraph", "text": "$120$" }],
        [{ "tipe": "paragraph", "text": "$125$" }],
        [{ "tipe": "paragraph", "text": "$130$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Pangkatkan tiga kedua ruas persamaan**" },
        { "tipe": "paragraph", "text": "$\\left(x + \\dfrac{1}{x}\\right)^3 = 5^3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jabarkan ruas kiri menggunakan identitas $(a + b)^3 = a^3 + b^3 + 3ab(a + b)$**" },
        { "tipe": "paragraph", "text": "$x^3 + \\dfrac{1}{x^3} + 3 \\cdot x \\cdot \\dfrac{1}{x} \\left(x + \\dfrac{1}{x}\\right) = 125$" },
        { "tipe": "paragraph", "text": "Karena $x \\cdot \\dfrac{1}{x} = 1$ dan $x + \\dfrac{1}{x} = 5$, maka:" },
        { "tipe": "paragraph", "text": "$x^3 + \\dfrac{1}{x^3} + 3(1)(5) = 125$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Pindahkan konstanta ke ruas kanan**" },
        { "tipe": "paragraph", "text": "$x^3 + \\dfrac{1}{x^3} = 125 - 15 = 110$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
