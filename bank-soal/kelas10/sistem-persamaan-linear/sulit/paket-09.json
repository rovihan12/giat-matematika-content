  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "SPLTV lanjutan dan sistem persamaan nonlinear",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-09-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $xy + yz + zx = 11$, $xyz = 6$. Nilai $x^3 + y^3 + z^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$34$" }],
        [{ "tipe": "paragraph", "text": "$36$" }],
        [{ "tipe": "paragraph", "text": "$38$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas jumlah pangkat tiga tiga variabel**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 + z^3 - 3xyz = (x + y + z)(x^2 + y^2 + z^2 - xy - yz - zx)$" },
        { "tipe": "paragraph", "text": "Atau dalam bentuk langsung:" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 + z^3 = (x + y + z)^3 - 3(x + y + z)(xy + yz + zx) + 3xyz$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui $x + y + z = 6$, $xy + yz + zx = 11$, dan $xyz = 6$:" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 + z^3 = (6)^3 - 3(6)(11) + 3(6)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil akhirnya**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 + z^3 = 216 - 198 + 18 = 36$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 25$ dan $x + y = 7$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$90$" }],
        [{ "tipe": "paragraph", "text": "$91$" }],
        [{ "tipe": "paragraph", "text": "$92$" }],
        [{ "tipe": "paragraph", "text": "$93$" }],
        [{ "tipe": "paragraph", "text": "$94$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari nilai $xy$ menggunakan identitas kuadrat**" },
        { "tipe": "paragraph", "text": "$(x + y)^2 = x^2 + y^2 + 2xy$" },
        { "tipe": "paragraph", "text": "$(7)^2 = 25 + 2xy \\Rightarrow 49 = 25 + 2xy \\Rightarrow 2xy = 24 \\Rightarrow xy = 12$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $x^3 + y^3$ menggunakan identitas pangkat tiga**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (x + y)^3 - 3xy(x + y)$" },
        { "tipe": "paragraph", "text": "Substitusikan $x + y = 7$ dan $xy = 12$:" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (7)^3 - 3(12)(7) = 343 - 252 = 91$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $a + b + c = 5$ dan $a^2 + b^2 + c^2 = 15$, nilai $ab + bc + ca$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan rumus penjabaran $(a + b + c)^2$**" },
        { "tipe": "paragraph", "text": "$(a + b + c)^2 = a^2 + b^2 + c^2 + 2(ab + bc + ca)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "$(5)^2 = 15 + 2(ab + bc + ca)$" },
        { "tipe": "paragraph", "text": "$25 = 15 + 2(ab + bc + ca)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $ab + bc + ca$**" },
        { "tipe": "paragraph", "text": "$2(ab + bc + ca) = 25 - 15$" },
        { "tipe": "paragraph", "text": "$2(ab + bc + ca) = 10 \\Rightarrow ab + bc + ca = \\dfrac{10}{2} = 5$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $\\dfrac{1}{x} + \\dfrac{1}{y} = \\dfrac{3}{2}$ dan $\\dfrac{1}{x} - \\dfrac{1}{y} = \\dfrac{1}{2}$. Nilai $x + y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi $\\dfrac{1}{y}$ dengan menjumlahkan kedua persamaan**" },
        { "tipe": "paragraph", "text": "$\\left(\\dfrac{1}{x} + \\dfrac{1}{y}\\right) + \\left(\\dfrac{1}{x} - \\dfrac{1}{y}\\right) = \\dfrac{3}{2} + \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{2}{x} = \\dfrac{4}{2} = 2 \\Rightarrow x = 1$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $\\dfrac{1}{x} = 1$ ke persamaan pertama untuk mencari $y$**" },
        { "tipe": "paragraph", "text": "$1 + \\dfrac{1}{y} = \\dfrac{3}{2}$" },
        { "tipe": "paragraph", "text": "$\\dfrac{1}{y} = \\dfrac{3}{2} - 1 = \\dfrac{1}{2} \\Rightarrow y = 2$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $x + y$**" },
        { "tipe": "paragraph", "text": "$x + y = 1 + 2 = 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + y = 6$ dan $xy = 8$, nilai $x^2 + y^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$16$" }],
        [{ "tipe": "paragraph", "text": "$18$" }],
        [{ "tipe": "paragraph", "text": "$20$" }],
        [{ "tipe": "paragraph", "text": "$22$" }],
        [{ "tipe": "paragraph", "text": "$24$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat $(x + y)^2$**" },
        { "tipe": "paragraph", "text": "$(x + y)^2 = x^2 + 2xy + y^2 = (x^2 + y^2) + 2xy$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x + y = 6$ dan $xy = 8$**" },
        { "tipe": "paragraph", "text": "$(6)^2 = (x^2 + y^2) + 2(8)$" },
        { "tipe": "paragraph", "text": "$36 = (x^2 + y^2) + 16$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $x^2 + y^2$**" },
        { "tipe": "paragraph", "text": "$x^2 + y^2 = 36 - 16 = 20$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 - y = 7$ dan $x + y = 5$. Nilai $x^2 + y^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$17$" }],
        [{ "tipe": "paragraph", "text": "$19$" }],
        [{ "tipe": "paragraph", "text": "$21$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Nyatakan $y$ dalam variabel $x$ dari persamaan linear**" },
        { "tipe": "paragraph", "text": "$x + y = 5 \\Rightarrow y = 5 - x$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $y$ ke persamaan kuadrat**" },
        { "tipe": "paragraph", "text": "$x^2 - (5 - x) = 7$" },
        { "tipe": "paragraph", "text": "$x^2 - 5 + x = 7$" },
        { "tipe": "paragraph", "text": "$x^2 + x - 12 = 0$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Faktorkan persamaan kuadrat dan cari pasangan $(x, y)$**" },
        { "tipe": "paragraph", "text": "$(x + 4)(x - 3) = 0 \\Rightarrow x = -4$ atau $x = 3$." },
        { "tipe": "paragraph", "text": "Untuk $x = 3$: $y = 5 - 3 = 2$." },
        { "tipe": "paragraph", "text": "**Langkah 4: Hitung nilai $x^2 + y^2$**" },
        { "tipe": "paragraph", "text": "$x^2 + y^2 = 3^2 + 2^2 = 9 + 4 = 13$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 12$, $x^2 + y^2 + z^2 = 50$, $xy + yz + zx = 47$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$50$" }],
        [{ "tipe": "paragraph", "text": "$60$" }],
        [{ "tipe": "paragraph", "text": "$70$" }]
      ],
      "jawaban_benar": 3,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Susun persamaan polinomial berakar $x, y, z$**" },
        { "tipe": "paragraph", "text": "Berdasarkan teorema Vieta untuk persamaan derajat tiga:" },
        { "tipe": "paragraph", "text": "$t^3 - (x + y + z)t^2 + (xy + yz + zx)t - xyz = 0$" },
        { "tipe": "paragraph", "text": "Substitusikan nilai yang diketahui:" },
        { "tipe": "paragraph", "text": "$t^3 - 12t^2 + 47t - xyz = 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Cari nilai akar-akar $x, y, z$**" },
        { "tipe": "paragraph", "text": "Cari tiga bilangan yang jumlahnya $12$, jumlah kuadratnya $50$, dan jumlah hasil kali berpasangannya $47$." },
        { "tipe": "paragraph", "text": "Diperoleh bilangan tersebut adalah $3, 4,$ dan $5$ karena:" },
        { "tipe": "paragraph", "text": "• $3 + 4 + 5 = 12$" },
        { "tipe": "paragraph", "text": "• $3^2 + 4^2 + 5^2 = 9 + 16 + 25 = 50$" },
        { "tipe": "paragraph", "text": "• $(3)(4) + (4)(5) + (3)(5) = 12 + 20 + 15 = 47$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $xyz$**" },
        { "tipe": "paragraph", "text": "$xyz = 3 \\cdot 4 \\cdot 5 = 60$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-09-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 7$ dan $xy = 12$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
