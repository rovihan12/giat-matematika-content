      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Buat model matematika dari soal cerita**" },
        { "tipe": "paragraph", "text": "Misalkan ketiga bilangan tersebut adalah $a$ (pertama), $b$ (kedua), dan $c$ (ketiga)." },
        { "tipe": "paragraph", "text": "• Jumlah tiga bilangan adalah 20 $\\Rightarrow a + b + c = 20$" },
        { "tipe": "paragraph", "text": "• Bilangan pertama ditambah 2 sama dengan bilangan kedua $\\Rightarrow b = a + 2$" },
        { "tipe": "paragraph", "text": "• Bilangan ketiga dikurangi 3 sama dengan bilangan pertama $\\Rightarrow c - 3 = a \\Rightarrow c = a + 3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $b$ dan $c$ ke persamaan pertama**" },
        { "tipe": "paragraph", "text": "$a + (a + 2) + (a + 3) = 20$" },
        { "tipe": "paragraph", "text": "$3a + 5 = 20$" },
        { "tipe": "paragraph", "text": "$3a = 15 \\Rightarrow a = 5$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Tentukan nilai $b$ dan $c$**" },
        { "tipe": "paragraph", "text": "• $b = 5 + 2 = 7$" },
        { "tipe": "paragraph", "text": "• $c = 5 + 3 = 8$" },
        { "tipe": "paragraph", "text": "Dari ketiga bilangan ($5, 7, 8$), bilangan yang terbesar adalah $8$." }
      ],
      "tingkat": "SULIT"
    },
