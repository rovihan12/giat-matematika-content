  "soal": [
    {
      "id": "bs-k10-spl-sulit-01-q01",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $x + y + z = 6$, $2x - y + 3z = 12$, dan $x + 2y - z = 1$. Nilai $xyz$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ],
        [ { "tipe": "paragraph", "text": "$12$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi $(x, y, z) = (2, 1, 3)$:" },
        { "tipe": "paragraph", "text": "(i) $2 + 1 + 3 = 6$ ✓" },
        { "tipe": "paragraph", "text": "(ii) $4 - 1 + 9 = 12$ ✓" },
        { "tipe": "paragraph", "text": "(iii) $2 + 2 - 3 = 1$ ✓" },
        { "tipe": "paragraph", "text": "$xyz = 2 \\cdot 1 \\cdot 3 = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q02",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + y + z = 12$, $2x - y + 2z = 15$, dan $3x + 2y - z = 13$ memiliki nilai $x - y + z$ sama dengan..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi $(x, y, z) = (4, 3, 5)$:" },
        { "tipe": "paragraph", "text": "(i) $4 + 3 + 5 = 12$ ✓" },
        { "tipe": "paragraph", "text": "(ii) $8 - 3 + 10 = 15$ ✓" },
        { "tipe": "paragraph", "text": "(iii) $12 + 6 - 5 = 13$ ✓" },
        { "tipe": "paragraph", "text": "$x - y + z = 4 - 3 + 5 = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q03",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x$ dari sistem $3x + 2y - z = 11$, $x - y + 2z = 1$, dan $2x + 3y + z = 14$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi $(x, y, z) = (2, 3, 1)$:" },
        { "tipe": "paragraph", "text": "(i) $6 + 6 - 1 = 11$ ✓" },
        { "tipe": "paragraph", "text": "(ii) $2 - 3 + 2 = 1$ ✓" },
        { "tipe": "paragraph", "text": "(iii) $4 + 9 + 1 = 14$ ✓" },
        { "tipe": "paragraph", "text": "$x = 2$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q04",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Diketahui sistem $x + y + z = 8$, $x - y + z = 6$, dan $x + y - z = 4$. Nilai $x^2 + y^2 + z^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$26$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$30$" } ],
        [ { "tipe": "paragraph", "text": "$32$" } ],
        [ { "tipe": "paragraph", "text": "$35$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "(i)+(iii): $2x + 2y = 12 \\Rightarrow x + y = 6$" },
        { "tipe": "paragraph", "text": "Dari (i): $z = 8 - 6 = 2$" },
        { "tipe": "paragraph", "text": "(i) - (ii): $2y = 2 \\Rightarrow y = 1$; maka $x = 5$." },
        { "tipe": "paragraph", "text": "$x^2 + y^2 + z^2 = 25 + 1 + 4 = 30$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q05",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika sistem $2x + ay = 8$ dan $x - y = 1$ memiliki solusi tunggal dengan $y = 2$, nilai $a$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$1$" } ],
        [ { "tipe": "paragraph", "text": "$2$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x - y = 1 \\Rightarrow x = y + 1 = 3$" },
        { "tipe": "paragraph", "text": "Substitusi ke $2x + ay = 8$: $6 + 2a = 8 \\Rightarrow 2a = 2 \\Rightarrow a = 1$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q06",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Nilai $x + y + z$ dari sistem $x + 2y + 3z = 14$, $2x + y + z = 7$, dan $3x + y + 2z = 11$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi $(1, 2, 3)$:" },
        { "tipe": "paragraph", "text": "(i) $1+4+9=14$ ✓; (ii) $2+2+3=7$ ✓; (iii) $3+2+6=11$ ✓." },
        { "tipe": "paragraph", "text": "$x + y + z = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q07",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $(x, y, z)$ memenuhi $x + y = 5$, $y + z = 7$, dan $x + z = 6$, nilai $x^2 + y^2 + z^2$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$25$" } ],
        [ { "tipe": "paragraph", "text": "$27$" } ],
        [ { "tipe": "paragraph", "text": "$29$" } ],
        [ { "tipe": "paragraph", "text": "$31$" } ],
        [ { "tipe": "paragraph", "text": "$33$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x + y + z = \\dfrac{5 + 7 + 6}{2} = 9$" },
        { "tipe": "paragraph", "text": "$x = 9 - 7 = 2$; $y = 9 - 6 = 3$; $z = 9 - 5 = 4$" },
        { "tipe": "paragraph", "text": "$x^2 + y^2 + z^2 = 4 + 9 + 16 = 29$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q08",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $2x + y - z = 1$, dan $x - y + z = 2$ memiliki solusi $(x, y, z)$. Nilai $x \\cdot y \\cdot z$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$4$" } ],
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$6$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi $(1, 2, 3)$:" },
        { "tipe": "paragraph", "text": "(i) $1+2+3 = 6$ ✓" },
        { "tipe": "paragraph", "text": "(ii) $2 + 2 - 3 = 1$ ✓" },
        { "tipe": "paragraph", "text": "(iii) $1 - 2 + 3 = 2$ ✓" },
        { "tipe": "paragraph", "text": "$xyz = 1 \\cdot 2 \\cdot 3 = 6$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q09",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jumlah tiga bilangan adalah 20. Bilangan pertama ditambah 2 sama dengan bilangan kedua, dan bilangan ketiga dikurangi 3 sama dengan bilangan pertama. Bilangan terbesar adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$5$" } ],
        [ { "tipe": "paragraph", "text": "$7$" } ],
        [ { "tipe": "paragraph", "text": "$8$" } ],
        [ { "tipe": "paragraph", "text": "$9$" } ],
        [ { "tipe": "paragraph", "text": "$10$" } ]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a, b, c$." },
        { "tipe": "paragraph", "text": "$a + b + c = 20$; $b = a + 2$; $c - 3 = a \\Rightarrow c = a + 3$" },
        { "tipe": "paragraph", "text": "$a + (a + 2) + (a + 3) = 20 \\Rightarrow 3a = 15 \\Rightarrow a = 5$" },
        { "tipe": "paragraph", "text": "$b = 7$; $c = 8$. Terbesar = $8$" }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-01-q10",
      "pertanyaan": [
        { "tipe": "paragraph", "text": "Jika $\\dfrac{2}{x} + \\dfrac{3}{y} + \\dfrac{1}{z} = 7$, $\\dfrac{1}{x} - \\dfrac{2}{y} + \\dfrac{3}{z} = 5$, dan $\\dfrac{3}{x} + \\dfrac{1}{y} - \\dfrac{2}{z} = 0$, nilai $x + y + z$ adalah..." }
      ],
      "pilihan": [
        [ { "tipe": "paragraph", "text": "$\\dfrac{5}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{3}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$\\dfrac{7}{2}$" } ],
        [ { "tipe": "paragraph", "text": "$3$" } ],
        [ { "tipe": "paragraph", "text": "$4$" } ]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misal $a = \\dfrac{1}{x}$, $b = \\dfrac{1}{y}$, $c = \\dfrac{1}{z}$." },
        { "tipe": "paragraph", "text": "Solusi $(a, b, c) = (1, 1, 2)$:" },
        { "tipe": "paragraph", "text": "(i) $2 + 3 + 2 = 7$ ✓" },
        { "tipe": "paragraph", "text": "(ii) $1 - 2 + 6 = 5$ ✓" },
        { "tipe": "paragraph", "text": "(iii) $3 + 1 - 4 = 0$ ✓" },
        { "tipe": "paragraph", "text": "$x = 1$, $y = 1$, $z = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "$x + y + z = 1 + 1 + \\dfrac{1}{2} = \\dfrac{5}{2}$" }
      ],
      "tingkat": "SULIT"
    }
  ]
