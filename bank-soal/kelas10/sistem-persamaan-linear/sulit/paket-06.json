{
  "id": "bs-k10-spl-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "SPLTV dengan parameter, sistem nonlinear sederhana, dan identitas aljabar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-06-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $2x - y + z = 3$, $x + 2y - z = 2$ memiliki solusi $(x,y,z)$. Nilai $x^2 + y^2 + z^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$16$" }],
        [{ "tipe": "paragraph", "text": "$18$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Eliminasi variabel $z$ untuk membentuk SPLDV dalam $x$ dan $y$**" },
        { "tipe": "paragraph", "text": "Jumlahkan persamaan pertama ($x + y + z = 6$) dengan ketiga ($x + 2y - z = 2$), serta jumlahkan persamaan kedua ($2x - y + z = 3$) dengan ketiga:" },
        { "tipe": "formula_block", "latex": "2x + 3y = 8" },
        { "tipe": "formula_block", "latex": "3x + y = 5 \\Rightarrow y = 5 - 3x" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$, $y$, dan $z$**" },
        { "tipe": "paragraph", "text": "Substitusikan $y = 5 - 3x$ ke $2x + 3y = 8$ sehingga diperoleh $x = 1$ dan $y = 2$, lalu substitusikan ke $x + y + z = 6$:" },
        { "tipe": "formula_block", "latex": "1 + 2 + z = 6 \\Rightarrow z = 3" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $x^2 + y^2 + z^2$**" },
        { "tipe": "formula_block", "latex": "x^2 + y^2 + z^2 = 1^2 + 2^2 + 3^2 = 1 + 4 + 9 = 14" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^2 + y^2 + z^2$ adalah **$14$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 5$ dan $x^2 + y^2 = 13$. Nilai $xy$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan $x + y = 5$ dan substitusikan $x^2 + y^2 = 13$**" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = (x^2 + y^2) + 2xy \\Rightarrow 5^2 = 13 + 2xy" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk memperoleh nilai $xy$**" },
        { "tipe": "formula_block", "latex": "25 - 13 = 2xy \\Rightarrow 2xy = 12 \\Rightarrow xy = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $xy$ adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $2x + y = 7$ dan $x + 3y = 11$. Nilai $x^2 + y^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$9$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$11$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Substitusikan $y = 7 - 2x$ ke persamaan $x + 3y = 11$**" },
        { "tipe": "formula_block", "latex": "x + 3(7 - 2x) = 11 \\Rightarrow -5x = -10 \\Rightarrow x = 2 \\quad \\text{dan} \\quad y = 7 - 2(2) = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x^2 + y^2$**" },
        { "tipe": "formula_block", "latex": "x^2 + y^2 = 2^2 + 3^2 = 4 + 9 = 13" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^2 + y^2$ adalah **$13$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + y + z = 10$ dan $x^2 + y^2 + z^2 = 40$, nilai $xy + yz + zx$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$25$" }],
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$35$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$45$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat tiga variabel dan substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui $x + y + z = 10$ dan $x^2 + y^2 + z^2 = 40$:" },
        { "tipe": "formula_block", "latex": "(x + y + z)^2 = x^2 + y^2 + z^2 + 2(xy + yz + zx) \\Rightarrow 10^2 = 40 + 2(xy + yz + zx)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk mencari nilai $xy + yz + zx$**" },
        { "tipe": "formula_block", "latex": "100 - 40 = 2(xy + yz + zx) \\Rightarrow 2(xy + yz + zx) = 60 \\Rightarrow xy + yz + zx = 30" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $xy + yz + zx$ adalah **$30$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 7$ dan $x^2 + y^2 = 25$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$90$" }],
        [{ "tipe": "paragraph", "text": "$91$" }],
        [{ "tipe": "paragraph", "text": "$92$" }],
        [{ "tipe": "paragraph", "text": "$93$" }],
        [{ "tipe": "paragraph", "text": "$94$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari nilai $xy$ dari identitas kuadrat jumlah**" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = x^2 + y^2 + 2xy \\Rightarrow 7^2 = 25 + 2xy \\Rightarrow 2xy = 24 \\Rightarrow xy = 12" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x^3 + y^3$ menggunakan identitas jumlah pangkat tiga**" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 = (x + y)^3 - 3xy(x + y) = 7^3 - 3(12)(7) = 343 - 252 = 91" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + y^3$ adalah **$91$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $2x + y + z = 7$, $x + 2y + z = 8$, $x + y + 2z = 9$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$14$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jumlahkan ketiga persamaan untuk memperoleh nilai $x + y + z$**" },
        { "tipe": "formula_block", "latex": "(2x + y + z) + (x + 2y + z) + (x + y + 2z) = 7 + 8 + 9 \\Rightarrow 4(x + y + z) = 24 \\Rightarrow x + y + z = 6" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan nilai $x$, $y$, $z$ lalu hitung $xyz$**" },
        { "tipe": "paragraph", "text": "Kurangkan $x + y + z = 6$ dari masing-masing persamaan awal untuk mendapatkan $x = 1$, $y = 2$, dan $z = 3$:" },
        { "tipe": "formula_block", "latex": "xyz = 1 \\cdot 2 \\cdot 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $xyz$ adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $a + b + c = 6$, $ab + bc + ca = 11$, nilai $a^2 + b^2 + c^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$16$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat jumlah tiga bilangan**" },
        { "tipe": "formula_block", "latex": "(a + b + c)^2 = a^2 + b^2 + c^2 + 2(ab + bc + ca)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan $a + b + c = 6$ dan $ab + bc + ca = 11$**" },
        { "tipe": "formula_block", "latex": "6^2 = a^2 + b^2 + c^2 + 2(11) \\Rightarrow 36 = a^2 + b^2 + c^2 + 22 \\Rightarrow a^2 + b^2 + c^2 = 14" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a^2 + b^2 + c^2$ adalah **$14$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 4$ dan $xy = 3$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$28$" }],
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$34$" }],
        [{ "tipe": "paragraph", "text": "$36$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas jumlah pangkat tiga dan substitusikan $x + y = 4$ serta $xy = 3$**" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 = (x + y)^3 - 3xy(x + y) = 4^3 - 3(3)(4) = 64 - 36 = 28" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + y^3$ adalah **$28$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 4$, nilai $x^2 + \\dfrac{1}{x^2}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$16$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas persamaan $x + \\dfrac{1}{x} = 4$**" },
        { "tipe": "formula_block", "latex": "\\left(x + \\dfrac{1}{x}\\right)^2 = 4^2 \\Rightarrow x^2 + 2 \\cdot x \\cdot \\dfrac{1}{x} + \\dfrac{1}{x^2} = 16" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan dan pindahkan konstanta ke ruas kanan**" },
        { "tipe": "formula_block", "latex": "x^2 + 2 + \\dfrac{1}{x^2} = 16 \\Rightarrow x^2 + \\dfrac{1}{x^2} = 14" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^2 + \\dfrac{1}{x^2}$ adalah **$14$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 - y^2 = 12$ dan $x + y = 6$. Nilai $x - y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$1$" }],
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan $x^2 - y^2 = 12$ dan substitusikan $x + y = 6$**" },
        { "tipe": "formula_block", "latex": "(x - y)(x + y) = 12 \\Rightarrow (x - y) \\cdot 6 = 12 \\Rightarrow x - y = 2" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x - y$ adalah **$2$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
