{
  "id": "bs-k10-spl-sulit-06",
  "nama": "Bank Soal Sulit - Paket 6",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "SPLTV dengan parameter, sistem nonlinear sederhana, dan identitas aljabar",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-06-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $2x - y + z = 3$, $x + 2y - z = 2$ memiliki solusi $(x,y,z)$. Nilai $x^2 + y^2 + z^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$16$" }],
        [{ "tipe": "paragraph", "text": "$18$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari eliminasi/substitusi diperoleh solusi $(x, y, z) = (1, 2, 3)$." },
        { "tipe": "paragraph", "text": "Maka $x^2 + y^2 + z^2 = 1^2 + 2^2 + 3^2 = 1 + 4 + 9 = 14$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 5$ dan $x^2 + y^2 = 13$. Nilai $xy$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x+y)^2 = x^2+y^2+2xy \\Rightarrow 25 = 13+2xy \\Rightarrow xy=6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $2x + y = 7$ dan $x + 3y = 11$. Nilai $x^2 + y^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$9$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$11$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }]
      ],
      "jawaban_benar": 4,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Dari eliminasi diperoleh $x = 2$ dan $y = 3$." },
        { "tipe": "paragraph", "text": "Maka $x^2 + y^2 = 2^2 + 3^2 = 4 + 9 = 13$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + y + z = 10$ dan $x^2 + y^2 + z^2 = 40$, nilai $xy + yz + zx$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$25$" }],
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$35$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$45$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x+y+z)^2 = x^2+y^2+z^2 + 2(xy+yz+zx) \\Rightarrow 100 = 40 + 2(xy+yz+zx) \\Rightarrow xy+yz+zx = 30$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 7$ dan $x^2 + y^2 = 25$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$90$" }],
        [{ "tipe": "paragraph", "text": "$91$" }],
        [{ "tipe": "paragraph", "text": "$92$" }],
        [{ "tipe": "paragraph", "text": "$93$" }],
        [{ "tipe": "paragraph", "text": "$94$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$49 = 25+2xy \\Rightarrow xy=12$." },
        { "tipe": "paragraph", "text": "$x^3+y^3 = (x+y)^3 - 3xy(x+y) = 343 - 3(12)(7) = 343 - 252 = 91$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $2x + y + z = 7$, $x + 2y + z = 8$, $x + y + 2z = 9$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$10$" }],
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$14$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Jumlah ketiga persamaan: $4(x+y+z) = 24 \\Rightarrow x+y+z = 6$." },
        { "tipe": "paragraph", "text": "Kurangkan dari masing-masing persamaan untuk memperoleh $x = 1$, $y = 2$, dan $z = 3$." },
        { "tipe": "paragraph", "text": "Maka nilai $xyz = 1 \\cdot 2 \\cdot 3 = 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $a + b + c = 6$, $ab + bc + ca = 11$, nilai $a^2 + b^2 + c^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$16$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(a+b+c)^2 = a^2+b^2+c^2 + 2(ab+bc+ca) \\Rightarrow 36 = a^2+b^2+c^2 + 22 \\Rightarrow a^2+b^2+c^2=14$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 4$ dan $xy = 3$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$28$" }],
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$34$" }],
        [{ "tipe": "paragraph", "text": "$36$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$x^3+y^3 = (x+y)^3 - 3xy(x+y) = 4^3 - 3(3)(4) = 64 - 36 = 28$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 4$, nilai $x^2 + \\dfrac{1}{x^2}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$12$" }],
        [{ "tipe": "paragraph", "text": "$13$" }],
        [{ "tipe": "paragraph", "text": "$14$" }],
        [{ "tipe": "paragraph", "text": "$15$" }],
        [{ "tipe": "paragraph", "text": "$16$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "\\left(x + \\dfrac{1}{x}\\right)^2 = x^2 + 2 + \\dfrac{1}{x^2} \\Rightarrow 16 = x^2 + 2 + \\dfrac{1}{x^2} \\Rightarrow x^2 + \\dfrac{1}{x^2} = 14$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-06-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 - y^2 = 12$ dan $x + y = 6$. Nilai $x - y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$1$" }],
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }]
      ],
      "jawaban_benar": 1,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x-y)(x+y)=12 \\Rightarrow 6(x-y)=12 \\Rightarrow x-y=2$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
