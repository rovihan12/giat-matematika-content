{
  "id": "bs-k10-spl-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Soal OSN-style: identitas aljabar, sistem nonlinear, dan pertidaksamaan lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-10-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $a + b = 5$ dan $ab = 6$, nilai $a^3 + b^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$35$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$45$" }],
        [{ "tipe": "paragraph", "text": "$50$" }],
        [{ "tipe": "paragraph", "text": "$55$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$a^3+b^3 = (a+b)^3 - 3ab(a+b) = 5^3 - 3(6)(5) = 125 - 90 = 35$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 20$ dan $xy = 8$. Nilai $(x - y)^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x-y)^2 = x^2+y^2-2xy = 20 - 2(8) = 20 - 16 = 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $|x - 1| + |x - 3| = 2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" }],
        [{ "tipe": "paragraph", "text": "$x = 2$" }],
        [{ "tipe": "paragraph", "text": "$x < 1$ atau $x > 3$" }],
        [{ "tipe": "paragraph", "text": "$1 < x < 3$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Untuk $1 \\leq x \\leq 3$, $|x-1| = x-1$ dan $|x-3| = 3-x$." },
        { "tipe": "paragraph", "text": "Maka $(x-1) + (3-x) = 2 \\Rightarrow 2 = 2$ (berlaku untuk semua $1 \\leq x \\leq 3$)." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $\\dfrac{2}{x} + \\dfrac{3}{y} = 8$ dan $\\dfrac{3}{x} + \\dfrac{2}{y} = 7$. Nilai $x \\cdot y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$1$" }],
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$: $2a + 3b = 8$ dan $3a + 2b = 7$." },
        { "tipe": "paragraph", "text": "Dari eliminasi diperoleh $a = 2$ dan $b = 1$, sehingga $x = \\dfrac{1}{2}$ dan $y = 1$." },
        { "tipe": "paragraph", "text": "Maka nilai $x \\cdot y = \\dfrac{1}{2} \\cdot 1 = \\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + y + z = 9$ dan $x^2 + y^2 + z^2 = 35$, nilai $xy + yz + zx$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$21$" }],
        [{ "tipe": "paragraph", "text": "$22$" }],
        [{ "tipe": "paragraph", "text": "$23$" }],
        [{ "tipe": "paragraph", "text": "$24$" }],
        [{ "tipe": "paragraph", "text": "$25$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x+y+z)^2 = x^2+y^2+z^2 + 2(xy+yz+zx) \\Rightarrow 81 = 35 + 2(xy+yz+zx) \\Rightarrow xy+yz+zx = 23$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 4$ dan $x^2 + y^2 = 10$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$28$" }],
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$34$" }],
        [{ "tipe": "paragraph", "text": "$36$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x+y)^2 = x^2+y^2+2xy \\Rightarrow 16 = 10 + 2xy \\Rightarrow xy = 3$." },
        { "tipe": "paragraph", "text": "$x^3+y^3 = (x+y)^3 - 3xy(x+y) = 4^3 - 3(3)(4) = 64 - 36 = 28$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\dfrac{x^2 - 5x + 6}{x - 4} \\leq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x \\leq 2$ atau $3 \\leq x < 4$" }],
        [{ "tipe": "paragraph", "text": "$2 \\leq x \\leq 3$ atau $x > 4$" }],
        [{ "tipe": "paragraph", "text": "$x < 2$ atau $3 < x < 4$" }],
        [{ "tipe": "paragraph", "text": "$2 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$\\dfrac{(x-2)(x-3)}{x-4} \\leq 0$. Pembuat nol: $x = 2$, $x = 3$, dan $x = 4$ (dikecualikan)." },
        { "tipe": "paragraph", "text": "Uji interval: negatif pada $x \\leq 2$ dan $3 \\leq x < 4$." },
        { "tipe": "paragraph", "text": "Maka HP: $x \\leq 2$ atau $3 \\leq x < 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 13$ dan $x + y = 5$. Nilai $x \\cdot y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "$(x+y)^2 = x^2+y^2+2xy \\Rightarrow 25 = 13 + 2xy \\Rightarrow xy = 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 3$, nilai $x^2 + \\dfrac{1}{x^2}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$9$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "\\left(x + \\dfrac{1}{x}\\right)^2 = x^2 + 2 + \\dfrac{1}{x^2} \\Rightarrow 9 = x^2 + 2 + \\dfrac{1}{x^2} \\Rightarrow x^2 + \\dfrac{1}{x^2} = 7$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $x^2 + y^2 + z^2 = 14$, $xy + yz + zx = 11$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "Solusi sistem persamaan yang memenuhi adalah $(1, 2, 3)$." },
        { "tipe": "paragraph", "text": "Maka nilai $xyz = 1 \\cdot 2 \\cdot 3 = 6$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
