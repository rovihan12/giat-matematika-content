{
  "id": "bs-k10-spl-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Soal OSN-style: identitas aljabar, sistem nonlinear, dan pertidaksamaan lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-10-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $a + b = 5$ dan $ab = 6$, nilai $a^3 + b^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$35$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$45$" }],
        [{ "tipe": "paragraph", "text": "$50$" }],
        [{ "tipe": "paragraph", "text": "$55$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas jumlah pangkat tiga dan substitusikan $a + b = 5$ serta $ab = 6$**" },
        { "tipe": "formula_block", "latex": "a^3 + b^3 = (a + b)^3 - 3ab(a + b) = 5^3 - 3(6)(5) = 125 - 90 = 35" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $a^3 + b^3$ adalah **$35$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 20$ dan $xy = 8$. Nilai $(x - y)^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan $(x - y)^2$ dan substitusikan $x^2 + y^2 = 20$ serta $xy = 8$**" },
        { "tipe": "formula_block", "latex": "(x - y)^2 = (x^2 + y^2) - 2xy = 20 - 2(8) = 20 - 16 = 4" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $(x - y)^2$ adalah **$4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $|x - 1| + |x - 3| = 2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" }],
        [{ "tipe": "paragraph", "text": "$x = 2$" }],
        [{ "tipe": "paragraph", "text": "$x < 1$ atau $x > 3$" }],
        [{ "tipe": "paragraph", "text": "$1 < x < 3$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tinjau persamaan pada interval yang dibatasi pembuat nol $x = 1$ dan $x = 3$**" },
        { "tipe": "formula_block", "latex": "x < 1 : -(x - 1) - (x - 3) = 2 \\Rightarrow x = 1 \\text{ (tidak memenuhi } x < 1\\text{)}" },
        { "tipe": "formula_block", "latex": "1 \\leq x \\leq 3 : (x - 1) - (x - 3) = 2 \\Rightarrow 2 = 2 \\text{ (selalu benar)}" },
        { "tipe": "formula_block", "latex": "x > 3 : (x - 1) + (x - 3) = 2 \\Rightarrow x = 3 \\text{ (tidak memenuhi } x > 3\\text{)}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$1 \\leq x \\leq 3$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $\\dfrac{2}{x} + \\dfrac{3}{y} = 8$ dan $\\dfrac{3}{x} + \\dfrac{2}{y} = 7$. Nilai $x \\cdot y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$1$" }],
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, lalu eliminasi untuk mencari $a$ dan $b$**" },
        { "tipe": "formula_block", "latex": "3(3a + 2b) - 2(2a + 3b) = 3(7) - 2(8) \\Rightarrow 5a = 5 \\Rightarrow a = 1" },
        { "tipe": "formula_block", "latex": "2(1) + 3b = 8 \\Rightarrow 3b = 6 \\Rightarrow b = 2" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan $x$ dan $y$, lalu hitung $x \\cdot y$**" },
        { "tipe": "formula_block", "latex": "x = 1, \\qquad y = \\dfrac{1}{2} \\qquad \\Rightarrow \\qquad x \\cdot y = 1 \\cdot \\dfrac{1}{2} = \\dfrac{1}{2}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x \\cdot y$ adalah **$\\dfrac{1}{2}$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + y + z = 9$ dan $x^2 + y^2 + z^2 = 35$, nilai $xy + yz + zx$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$21$" }],
        [{ "tipe": "paragraph", "text": "$22$" }],
        [{ "tipe": "paragraph", "text": "$23$" }],
        [{ "tipe": "paragraph", "text": "$24$" }],
        [{ "tipe": "paragraph", "text": "$25$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat tiga variabel dan substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "Diketahui $x + y + z = 9$ dan $x^2 + y^2 + z^2 = 35$:" },
        { "tipe": "formula_block", "latex": "(x + y + z)^2 = x^2 + y^2 + z^2 + 2(xy + yz + zx) \\Rightarrow 9^2 = 35 + 2(xy + yz + zx)" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk memperoleh nilai $xy + yz + zx$**" },
        { "tipe": "formula_block", "latex": "81 - 35 = 2(xy + yz + zx) \\Rightarrow 2(xy + yz + zx) = 46 \\Rightarrow xy + yz + zx = 23" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $xy + yz + zx$ adalah **$23$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 4$ dan $x^2 + y^2 = 10$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$28$" }],
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$34$" }],
        [{ "tipe": "paragraph", "text": "$36$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari nilai $xy$ dari identitas kuadrat jumlah**" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = x^2 + y^2 + 2xy \\Rightarrow 4^2 = 10 + 2xy \\Rightarrow 2xy = 6 \\Rightarrow xy = 3" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $x^3 + y^3$ menggunakan identitas jumlah pangkat tiga**" },
        { "tipe": "formula_block", "latex": "x^3 + y^3 = (x + y)^3 - 3xy(x + y) = 4^3 - 3(3)(4) = 64 - 36 = 28" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^3 + y^3$ adalah **$28$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\dfrac{x^2 - 5x + 6}{x - 4} \\leq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x \\leq 2$ atau $3 \\leq x < 4$" }],
        [{ "tipe": "paragraph", "text": "$2 \\leq x \\leq 3$ atau $x > 4$" }],
        [{ "tipe": "paragraph", "text": "$x < 2$ atau $3 < x < 4$" }],
        [{ "tipe": "paragraph", "text": "$2 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pembilang dan tentukan titik-titik kritis**" },
        { "tipe": "formula_block", "latex": "\\dfrac{(x - 2)(x - 3)}{x - 4} \\leq 0, \\qquad x \\neq 4" },
        { "tipe": "paragraph", "text": "Pembuat nol pembilang adalah $x = 2$ dan $x = 3$ (termasuk penyelesaian), sedangkan pembuat nol penyebut adalah $x = 4$ (dikecualikan)." },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji tanda pada setiap interval garis bilangan**" },
        { "tipe": "formula_block", "latex": "x \\leq 2 : -\\dfrac{3}{2} < 0 \\text{ (ya)}, \\qquad 2 \\leq x \\leq 3 : +\\dfrac{1}{6} > 0 \\text{ (tidak)}, \\qquad 3 \\leq x < 4 : -\\dfrac{3}{2} < 0 \\text{ (ya)}, \\qquad x > 4 : +6 > 0 \\text{ (tidak)}" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x$ yang memenuhi adalah **$x \\leq 2$ atau $3 \\leq x < 4$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 13$ dan $x + y = 5$. Nilai $x \\cdot y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan $x + y = 5$ dan substitusikan $x^2 + y^2 = 13$**" },
        { "tipe": "formula_block", "latex": "(x + y)^2 = (x^2 + y^2) + 2xy \\Rightarrow 5^2 = 13 + 2xy" },
        { "tipe": "paragraph", "text": "**Langkah 2: Selesaikan persamaan untuk memperoleh nilai $x \\cdot y$**" },
        { "tipe": "formula_block", "latex": "25 - 13 = 2xy \\Rightarrow 2xy = 12 \\Rightarrow xy = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x \\cdot y$ adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 3$, nilai $x^2 + \\dfrac{1}{x^2}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$9$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas persamaan $x + \\dfrac{1}{x} = 3$**" },
        { "tipe": "formula_block", "latex": "\\left(x + \\dfrac{1}{x}\\right)^2 = 3^2 \\Rightarrow x^2 + 2 \\cdot x \\cdot \\dfrac{1}{x} + \\dfrac{1}{x^2} = 9" },
        { "tipe": "paragraph", "text": "**Langkah 2: Sederhanakan dan pindahkan konstanta ke ruas kanan**" },
        { "tipe": "formula_block", "latex": "x^2 + 2 + \\dfrac{1}{x^2} = 9 \\Rightarrow x^2 + \\dfrac{1}{x^2} = 7" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $x^2 + \\dfrac{1}{x^2}$ adalah **$7$**." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $x^2 + y^2 + z^2 = 14$, $xy + yz + zx = 11$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan tiga bilangan $x, y, z$ yang memenuhi syarat simetris**" },
        { "tipe": "paragraph", "text": "Bilangan $1$, $2$, dan $3$ memenuhi $1 + 2 + 3 = 6$, $1^2 + 2^2 + 3^2 = 14$, serta $1(2) + 2(3) + 1(3) = 11$." },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $xyz$**" },
        { "tipe": "formula_block", "latex": "xyz = 1 \\cdot 2 \\cdot 3 = 6" },
        { "tipe": "paragraph", "text": "**Kesimpulan:** Jadi, nilai $xyz$ adalah **$6$**." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
