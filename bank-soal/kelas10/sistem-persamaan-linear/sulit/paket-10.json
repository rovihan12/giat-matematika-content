{
  "id": "bs-k10-spl-sulit-10",
  "nama": "Bank Soal Sulit - Paket 10",
  "kelas": 10,
  "kategori": "Sistem Persamaan dan Pertidaksamaan Linear",
  "tingkat": "SULIT",
  "deskripsi": "Soal OSN-style: identitas aljabar, sistem nonlinear, dan pertidaksamaan lanjutan",
  "versi": "1.0.0",
  "soal": [
    {
      "id": "bs-k10-spl-sulit-10-q01",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $a + b = 5$ dan $ab = 6$, nilai $a^3 + b^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$35$" }],
        [{ "tipe": "paragraph", "text": "$40$" }],
        [{ "tipe": "paragraph", "text": "$45$" }],
        [{ "tipe": "paragraph", "text": "$50$" }],
        [{ "tipe": "paragraph", "text": "$55$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas jumlah pangkat tiga**" },
        { "tipe": "paragraph", "text": "$a^3 + b^3 = (a + b)^3 - 3ab(a + b)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $a + b = 5$ dan $ab = 6$**" },
        { "tipe": "paragraph", "text": "$a^3 + b^3 = (5)^3 - 3(6)(5)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil akhirnya**" },
        { "tipe": "paragraph", "text": "$a^3 + b^3 = 125 - 90 = 35$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q02",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 20$ dan $xy = 8$. Nilai $(x - y)^2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan bentuk kuadrat selisih $(x - y)^2$**" },
        { "tipe": "paragraph", "text": "$(x - y)^2 = x^2 - 2xy + y^2 = (x^2 + y^2) - 2xy$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x^2 + y^2 = 20$ dan $xy = 8$**" },
        { "tipe": "paragraph", "text": "$(x - y)^2 = 20 - 2(8)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung hasil akhirnya**" },
        { "tipe": "paragraph", "text": "$(x - y)^2 = 20 - 16 = 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q03",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $|x - 1| + |x - 3| = 2$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$1 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x = 1$ atau $x = 3$" }],
        [{ "tipe": "paragraph", "text": "$x = 2$" }],
        [{ "tipe": "paragraph", "text": "$x < 1$ atau $x > 3$" }],
        [{ "tipe": "paragraph", "text": "$1 < x < 3$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Tentukan pembuat nol masing-masing nilai mutlak**" },
        { "tipe": "paragraph", "text": "• $|x - 1| = 0 \\Rightarrow x = 1$" },
        { "tipe": "paragraph", "text": "• $|x - 3| = 0 \\Rightarrow x = 3$" },
        { "tipe": "paragraph", "text": "Kedua titik membagi garis bilangan menjadi 3 interval:" },
        { "tipe": "paragraph", "text": "**Langkah 2: Uji persamaan pada setiap interval**" },
        { "tipe": "paragraph", "text": "• **Interval $x < 1$:** $-(x - 1) - (x - 3) = 2 \\Rightarrow -2x + 4 = 2 \\Rightarrow x = 1$ (tidak memenuhi syarat $x < 1$)." },
        { "tipe": "paragraph", "text": "• **Interval $1 \\leq x \\leq 3$:** $(x - 1) - (x - 3) = 2 \\Rightarrow x - 1 - x + 3 = 2 \\Rightarrow 2 = 2$ (selalu benar untuk semua $x$ pada interval ini)." },
        { "tipe": "paragraph", "text": "• **Interval $x > 3$:** $(x - 1) + (x - 3) = 2 \\Rightarrow 2x - 4 = 2 \\Rightarrow x = 3$ (tidak memenuhi syarat $x > 3$)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Kesimpulan**" },
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi adalah seluruh bilangan pada interval $1 \\leq x \\leq 3$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q04",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $\\dfrac{2}{x} + \\dfrac{3}{y} = 8$ dan $\\dfrac{3}{x} + \\dfrac{2}{y} = 7$. Nilai $x \\cdot y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$\\dfrac{1}{2}$" }],
        [{ "tipe": "paragraph", "text": "$1$" }],
        [{ "tipe": "paragraph", "text": "$2$" }],
        [{ "tipe": "paragraph", "text": "$3$" }],
        [{ "tipe": "paragraph", "text": "$4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Lakukan pemisalan variabel**" },
        { "tipe": "paragraph", "text": "Misalkan $a = \\dfrac{1}{x}$ dan $b = \\dfrac{1}{y}$, sehingga sistem menjadi:" },
        { "tipe": "paragraph", "text": "(1) $2a + 3b = 8$" },
        { "tipe": "paragraph", "text": "(2) $3a + 2b = 7$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Eliminasi variabel $b$**" },
        { "tipe": "paragraph", "text": "Kalikan persamaan (1) dengan $2$ dan persamaan (2) dengan $3$, lalu kurangkan:" },
        { "tipe": "paragraph", "text": "$3(3a + 2b) - 2(2a + 3b) = 3(7) - 2(8)$" },
        { "tipe": "paragraph", "text": "$(9a + 6b) - (4a + 6b) = 21 - 16$" },
        { "tipe": "paragraph", "text": "$5a = 5 \\Rightarrow a = 1$ — tunggu, periksa kembali: jika $a = 1$, maka dari (1) $2(1) + 3b = 8 \\Rightarrow 3b = 6 \\Rightarrow b = 2$." },
        { "tipe": "paragraph", "text": "Cek ke persamaan (2): $3(1) + 2(2) = 3 + 4 = 7$ (Benar!)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Kembalikan ke variabel $x$ dan $y$, lalu hitung $x \\cdot y$**" },
        { "tipe": "paragraph", "text": "• $a = \\dfrac{1}{x} = 1 \\Rightarrow x = 1$" },
        { "tipe": "paragraph", "text": "• $b = \\dfrac{1}{y} = 2 \\Rightarrow y = \\dfrac{1}{2}$" },
        { "tipe": "paragraph", "text": "Maka, nilai $x \\cdot y = 1 \\cdot \\dfrac{1}{2} = \\dfrac{1}{2}$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q05",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + y + z = 9$ dan $x^2 + y^2 + z^2 = 35$, nilai $xy + yz + zx$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$21$" }],
        [{ "tipe": "paragraph", "text": "$22$" }],
        [{ "tipe": "paragraph", "text": "$23$" }],
        [{ "tipe": "paragraph", "text": "$24$" }],
        [{ "tipe": "paragraph", "text": "$25$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Gunakan identitas kuadrat jumlah tiga variabel**" },
        { "tipe": "paragraph", "text": "$(x + y + z)^2 = x^2 + y^2 + z^2 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai yang diketahui**" },
        { "tipe": "paragraph", "text": "$(9)^2 = 35 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "$81 = 35 + 2(xy + yz + zx)$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $xy + yz + zx$**" },
        { "tipe": "paragraph", "text": "$2(xy + yz + zx) = 81 - 35$" },
        { "tipe": "paragraph", "text": "$2(xy + yz + zx) = 46 \\Rightarrow xy + yz + zx = \\dfrac{46}{2} = 23$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q06",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y = 4$ dan $x^2 + y^2 = 10$. Nilai $x^3 + y^3$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$28$" }],
        [{ "tipe": "paragraph", "text": "$30$" }],
        [{ "tipe": "paragraph", "text": "$32$" }],
        [{ "tipe": "paragraph", "text": "$34$" }],
        [{ "tipe": "paragraph", "text": "$36$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Cari nilai $xy$ menggunakan identitas kuadrat**" },
        { "tipe": "paragraph", "text": "$(x + y)^2 = x^2 + y^2 + 2xy$" },
        { "tipe": "paragraph", "text": "$(4)^2 = 10 + 2xy \\Rightarrow 16 = 10 + 2xy \\Rightarrow 2xy = 6 \\Rightarrow xy = 3$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung $x^3 + y^3$ menggunakan identitas pangkat tiga**" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (x + y)^3 - 3xy(x + y)$" },
        { "tipe": "paragraph", "text": "Substitusikan $x + y = 4$ dan $xy = 3$:" },
        { "tipe": "paragraph", "text": "$x^3 + y^3 = (4)^3 - 3(3)(4) = 64 - 36 = 28$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q07",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi $\\dfrac{x^2 - 5x + 6}{x - 4} \\leq 0$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$x \\leq 2$ atau $3 \\leq x < 4$" }],
        [{ "tipe": "paragraph", "text": "$2 \\leq x \\leq 3$ atau $x > 4$" }],
        [{ "tipe": "paragraph", "text": "$x < 2$ atau $3 < x < 4$" }],
        [{ "tipe": "paragraph", "text": "$2 \\leq x \\leq 3$" }],
        [{ "tipe": "paragraph", "text": "$x \\geq 4$" }]
      ],
      "jawaban_benar": 0,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Faktorkan pembilang bentuk kuadrat**" },
        { "tipe": "paragraph", "text": "$\\dfrac{(x - 2)(x - 3)}{x - 4} \\leq 0$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Tentukan titik kritis dan syarat penyebut**" },
        { "tipe": "paragraph", "text": "• Pembuat nol pembilang: $x = 2$ dan $x = 3$ (termasuk dalam penyelesaian karena tanda $\\leq$)." },
        { "tipe": "paragraph", "text": "• Pembuat nol penyebut: $x = 4$ (dikecualikan karena $x \\neq 4$)." },
        { "tipe": "paragraph", "text": "**Langkah 3: Uji tanda pada empat interval garis bilangan (dicari hasil negatif / $\\leq 0$)**" },
        { "tipe": "paragraph", "text": "1) Interval $x \\leq 2$ (uji $x = 0$): $\\dfrac{(-2)(-3)}{-4} = -\\dfrac{6}{4} < 0$ (Memenuhi)" },
        { "tipe": "paragraph", "text": "2) Interval $2 \\leq x \\leq 3$ (uji $x = 2{,}5$): $\\dfrac{(0{,}5)(-0{,}5)}{-1{,}5} = +\\dfrac{0{,}25}{1{,}5} > 0$ (Tidak memenuhi)" },
        { "tipe": "paragraph", "text": "3) Interval $3 \\leq x < 4$ (uji $x = 3{,}5$): $\\dfrac{(1{,}5)(0{,}5)}{-0{,}5} = -1{,}5 < 0$ (Memenuhi)" },
        { "tipe": "paragraph", "text": "4) Interval $x > 4$ (uji $x = 5$): $\\dfrac{(3)(2)}{1} = +6 > 0$ (Tidak memenuhi)" },
        { "tipe": "paragraph", "text": "**Langkah 4: Gabungkan interval yang memenuhi**" },
        { "tipe": "paragraph", "text": "Nilai $x$ yang memenuhi adalah $x \\leq 2$ atau $3 \\leq x < 4$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q08",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x^2 + y^2 = 13$ dan $x + y = 5$. Nilai $x \\cdot y$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Jabarkan bentuk kuadrat $(x + y)^2$**" },
        { "tipe": "paragraph", "text": "$(x + y)^2 = x^2 + 2xy + y^2 = (x^2 + y^2) + 2xy$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Substitusikan nilai $x + y = 5$ dan $x^2 + y^2 = 13$**" },
        { "tipe": "paragraph", "text": "$(5)^2 = 13 + 2xy$" },
        { "tipe": "paragraph", "text": "$25 = 13 + 2xy$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Hitung nilai $x \\cdot y$**" },
        { "tipe": "paragraph", "text": "$2xy = 25 - 13$" },
        { "tipe": "paragraph", "text": "$2xy = 12 \\Rightarrow xy = \\dfrac{12}{2} = 6$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q09",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Jika $x + \\dfrac{1}{x} = 3$, nilai $x^2 + \\dfrac{1}{x^2}$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }],
        [{ "tipe": "paragraph", "text": "$9$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Kuadratkan kedua ruas persamaan**" },
        { "tipe": "paragraph", "text": "$\\left(x + \\dfrac{1}{x}\\right)^2 = 3^2$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Jabarkan ruas kiri menggunakan rumus $(a + b)^2 = a^2 + 2ab + b^2$**" },
        { "tipe": "paragraph", "text": "$x^2 + 2 \\cdot x \\cdot \\dfrac{1}{x} + \\left(\\dfrac{1}{x}\\right)^2 = 9$" },
        { "tipe": "paragraph", "text": "$x^2 + 2 + \\dfrac{1}{x^2} = 9$" },
        { "tipe": "paragraph", "text": "**Langkah 3: Pindahkan konstanta ke ruas kanan**" },
        { "tipe": "paragraph", "text": "$x^2 + \\dfrac{1}{x^2} = 9 - 2 = 7$." }
      ],
      "tingkat": "SULIT"
    },
    {
      "id": "bs-k10-spl-sulit-10-q10",
      "pertanyaan": [{ "tipe": "paragraph", "text": "Sistem $x + y + z = 6$, $x^2 + y^2 + z^2 = 14$, $xy + yz + zx = 11$. Nilai $xyz$ adalah..." }],
      "pilihan": [
        [{ "tipe": "paragraph", "text": "$4$" }],
        [{ "tipe": "paragraph", "text": "$5$" }],
        [{ "tipe": "paragraph", "text": "$6$" }],
        [{ "tipe": "paragraph", "text": "$7$" }],
        [{ "tipe": "paragraph", "text": "$8$" }]
      ],
      "jawaban_benar": 2,
      "pembahasan": [
        { "tipe": "paragraph", "text": "**Langkah 1: Identifikasi tiga bilangan yang memenuhi syarat simetris**" },
        { "tipe": "paragraph", "text": "Cari tiga bilangan $x, y, z$ dengan jumlah $6$, jumlah kuadrat $14$, dan jumlah hasil kali berpasangan $11$." },
        { "tipe": "paragraph", "text": "Bilangan yang memenuhi adalah $1, 2,$ dan $3$ karena:" },
        { "tipe": "paragraph", "text": "• $1 + 2 + 3 = 6$" },
        { "tipe": "paragraph", "text": "• $1^2 + 2^2 + 3^2 = 1 + 4 + 9 = 14$" },
        { "tipe": "paragraph", "text": "• $(1)(2) + (2)(3) + (1)(3) = 2 + 6 + 3 = 11$" },
        { "tipe": "paragraph", "text": "**Langkah 2: Hitung nilai $xyz$**" },
        { "tipe": "paragraph", "text": "$xyz = 1 \\cdot 2 \\cdot 3 = 6$." }
      ],
      "tingkat": "SULIT"
    }
  ]
}
