              "tipe": "isi_kosong",
              "pertanyaan": "Pada fungsi $f(x) = 5x^2 - 3x + 7$, berapakah nilai $b$?",
              "pilihan": [],
              "jawaban": "-3",
              "pembahasan": "Bentuk umum: $f(x) = ax^2 + bx + c$. Bandingkan dengan $5x^2 - 3x + 7$: maka $a = 5$, $b = -3$, dan $c = 7$. Jadi nilai $b = -3$."
            },
            {
              "id": "10-fk-b01-s3-q2",
              "tipe": "pilihan",
              "pertanyaan": "Pada fungsi $g(x) = -2x^2 + 4$, berapakah nilai $b$?",
              "pilihan": [
                "$b = -2$",
                "$b = 4$",
                "$b = 0$",
                "$b = 2$"
