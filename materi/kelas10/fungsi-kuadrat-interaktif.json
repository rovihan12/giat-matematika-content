              "tipe": "heading",
              "level": 2,
              "text": "Bentuk Umum"
            },
            {
              "tipe": "formula_block",
              "latex": "f(x) = ax^2 + bx + c"
            },
            {
              "tipe": "paragraph",
              "text": "dengan syarat **$a \\neq 0$**."
            },
            {
              "tipe": "paragraph",
              "text": "Kalau $a = 0$, maka fungsinya bukan kuadrat lagi, melainkan **fungsi linear**."
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "Peran Masing-masing Koefisien"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "**$a$** = koefisien kuadrat → menentukan **arah buka parabola** (dan lebar/sempitnya)",
                "**$b$** = koefisien linear → mempengaruhi **posisi sumbu simetri**",
                "**$c$** = konstanta → **titik potong dengan sumbu Y**"
              ]
            }
          ],
          "latihan": [
