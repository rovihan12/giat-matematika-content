          "judul": "Apa Itu Fungsi Kuadrat?",
          "konten": [
            {
              "tipe": "heading",
              "level": 2,
              "text": "Definisi"
            },
            {
              "tipe": "paragraph",
              "text": "Fungsi kuadrat adalah fungsi polinomial yang memiliki **pangkat tertinggi 2** pada variabelnya."
            },
            {
              "tipe": "paragraph",
              "text": "Kata \"kuadrat\" berasal dari bahasa Latin *quadratus* yang berarti \"berpangkat dua\"."
            },
            {
              "tipe": "paragraph",
              "text": "Bentuk paling sederhana dari fungsi kuadrat adalah $y = x^2$. Jika digambar, kurvanya melengkung seperti huruf U — inilah yang disebut **parabola**."
            }
          ],
          "latihan": [
            {
              "id": "10-fk-b01-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Manakah yang merupakan fungsi kuadrat?",
              "pilihan": [
                "$f(x) = 2x + 3$",
                "$f(x) = x^2 - 4x + 1$",
                "$f(x) = \\dfrac{1}{x}$",
                "$f(x) = \\sqrt{x}$"
              ],
              "jawaban": 1,
              "pembahasan": "Fungsi kuadrat punya **pangkat tertinggi 2** pada variabelnya. Pilihan B ($f(x) = x^2 - 4x + 1$) adalah fungsi kuadrat karena variabel $x$ berpangkat 2. Pilihan A adalah fungsi linear (pangkat 1), C dan D bukan polinomial."
            },
            {
              "id": "10-fk-b01-s2-q2",
              "tipe": "benar_salah",
              "pertanyaan": "Fungsi $f(x) = 3x^2 - 2x$ adalah fungsi kuadrat.",
              "pilihan": [],
              "jawaban": true,
              "pembahasan": "Benar! Meskipun tidak ada konstanta (yang artinya $c = 0$), fungsi ini tetap fungsi kuadrat karena pangkat tertinggi variabelnya adalah 2."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Bentuk Umum Fungsi Kuadrat",
          "konten": [
