              "id": "10-fk-b03-s2-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "Titik puncak $f(x) = x^2 - 10x + 20$. Nilai $x_p$ = ... (tulis angka saja)",
              "jawaban": "5",
              "pembahasan": "$x_p = -\\dfrac{-10}{2} = 5$."
            }
