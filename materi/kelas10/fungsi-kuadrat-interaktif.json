                { "tipe": "formula_block", "latex": "y_p = f(3) = 3^2 - 6(3) + 5 = -4" },
                { "tipe": "paragraph", "text": "Titik puncak = $(3, -4)$. Karena $a > 0$, ini titik <b>minimum</b>." }
              ]
            }
          ],
          "latihan": [
