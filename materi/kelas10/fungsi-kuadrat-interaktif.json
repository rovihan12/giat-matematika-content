      "judul": "Pengertian Fungsi Kuadrat",
      "deskripsi": "Definisi, bentuk umum, dan contoh fungsi kuadrat",
      "total_step": 4,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Fungsi Kuadrat?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Fungsi kuadrat adalah fungsi polinomial yang memiliki <b>pangkat tertinggi 2</b> pada variabelnya. Kata \"kuadrat\" berasal dari bahasa Latin <i>quadratus</i> yang berarti \"berpangkat dua\"."
            },
            {
              "tipe": "paragraph",
              "text": "Bentuk paling sederhana dari fungsi kuadrat adalah $y = x^2$. Jika kita gambar, kurvanya melengkung seperti huruf U — inilah yang disebut <b>parabola</b>."
            },
            {
              "tipe": "formula_block",
              "latex": "f(x) = ax^2 + bx + c, \\quad a \\neq 0"
            },
            {
              "tipe": "paragraph",
              "text": "Keterangan: $a$ = koefisien kuadrat, $b$ = koefisien linear, $c$ = konstanta."
            }
          ],
          "latihan": [
            {
              "id": "10-fk-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Manakah yang merupakan fungsi kuadrat?",
              "pilihan": ["$f(x) = 2x + 3$", "$f(x) = x^2 - 4x + 1$", "$f(x) = x^3 + 2$", "$f(x) = \\dfrac{1}{x}$"],
              "jawaban": 1,
              "pembahasan": "Fungsi kuadrat punya pangkat tertinggi 2. Jawaban: $f(x) = x^2 - 4x + 1$."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Bentuk Umum dan Syaratnya",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Bentuk umum fungsi kuadrat adalah:"
            },
            {
              "tipe": "formula_block",
              "latex": "f(x) = ax^2 + bx + c"
            },
            {
              "tipe": "paragraph",
              "text": "dengan syarat $a \\neq 0$. Kalau $a = 0$, maka fungsinya bukan kuadrat lagi, melainkan fungsi linear."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$a$ = koefisien kuadrat (menentukan arah buka parabola)",
                "$b$ = koefisien linear (mempengaruhi posisi sumbu simetri)",
                "$c$ = konstanta (titik potong dengan sumbu Y)"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh: Identifikasi Koefisien",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan nilai $a$, $b$, dan $c$ dari fungsi $f(x) = 3x^2 - 7x + 2$." },
