    {
      "id": "10-barisan-bab-05",
      "nomor": 5,
      "judul": "Deret Geometri",
      "deskripsi": "Jumlah suku-suku barisan geometri",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Dari Barisan ke Deret Geometri",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Sekarang kita jumlahkan suku-suku barisan geometri. Hasilnya disebut <b>deret geometri</b>."
            },
            {
              "tipe": "paragraph",
              "text": "Yang menarik: kalau rasionya antara $-1$ dan $1$, deret ini bisa punya <b>jumlah sampai tak hingga</b>!"
            }
          ],
          "latihan": []
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Rumus Jumlah n Suku Pertama",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Rumusnya tergantung nilai rasio $r$:"
            },
            {
              "tipe": "formula_block",
              "latex": "S_n = \\dfrac{a(r^n - 1)}{r - 1}, \\quad \\text{untuk } r > 1"
            },
            {
              "tipe": "formula_block",
              "latex": "S_n = \\dfrac{a(1 - r^n)}{1 - r}, \\quad \\text{untuk } r < 1"
            },
            {
              "tipe": "example",
              "judul": "Contoh: Jumlah 6 Suku",
              "konten": [
                {
                  "tipe": "paragraph",
                  "text": "Hitung $S_6$ dari $3 + 6 + 12 + \\cdots$"
                },
                {
                  "tipe": "formula_block",
                  "latex": "\\begin{aligned} S_6 &= \\dfrac{3(2^6 - 1)}{2 - 1} \\\\ &= 3(63) \\\\ &= 189 \\end{aligned}"
                }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-05-step-02-q01",
              "tipe": "pilihan",
              "pertanyaan": "Jumlah 5 suku pertama deret $2 + 6 + 18 + \\cdots$ adalah...",
              "pilihan": ["162", "224", "242", "486"],
              "jawaban": 2,
              "pembahasan": "Penyelesaian:\n$a = 2$, $r = 3$, $n = 5$.\n$S_5 = \\dfrac{2(3^5 - 1)}{3 - 1} = \\dfrac{2(243 - 1)}{2} = 242$."
            },
            {
              "id": "10-barisan-bab-05-step-02-q02",
              "tipe": "isi_kosong",
              "pertanyaan": "Jumlah 4 suku pertama deret $1 + 3 + 9 + \\cdots$ adalah... (tulis angka saja)",
              "pilihan": [],
              "jawaban": "40",
              "pembahasan": "Penyelesaian:\n$a = 1$, $r = 3$, $n = 4$.\n$S_4 = \\dfrac{1(3^4 - 1)}{3 - 1} = \\dfrac{80}{2} = 40$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Deret Geometri Tak Hingga",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Jika $|r| < 1$ dan $n \\to \\infty$, maka $r^n \\to 0$, sehingga jumlahnya konvergen ke:"
            },
            {
              "tipe": "formula_block",
              "latex": "S_\\infty = \\dfrac{a}{1 - r}, \\quad |r| < 1"
            },
            {
              "tipe": "paragraph",
              "text": "<b>Penting:</b> Deret geometri tak hingga hanya konvergen (punya jumlah) jika $|r| < 1$. Kalau $|r| \\geq 1$, deretnya divergen."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                {
                  "tipe": "paragraph",
                  "text": "Hitung $S_\\infty$ dari $4 + 2 + 1 + \\dfrac{1}{2} + \\cdots$"
                },
                {
                  "tipe": "formula_block",
                  "latex": "S_\\infty = \\dfrac{4}{1 - \\frac{1}{2}} = \\dfrac{4}{\\frac{1}{2}} = 8"
                }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-05-step-03-q01",
              "tipe": "pilihan",
              "pertanyaan": "Jumlah tak hingga dari $8 + 4 + 2 + 1 + \\cdots$ adalah...",
              "pilihan": ["12", "14", "16", "18"],
              "jawaban": 2,
              "pembahasan": "Penyelesaian:\n$a = 8$, $r = \\dfrac{1}{2}$.\n$S_\\infty = \\dfrac{8}{1 - \\frac{1}{2}} = \\dfrac{8}{\\frac{1}{2}} = 16$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "rangkuman",
          "judul": "Rangkuman Bab 5",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "Deret geometri = jumlah suku barisan geometri",
                "Rumus: $S_n = \\dfrac{a(r^n - 1)}{r - 1}$ untuk $r > 1$",
                "Tak hingga: $S_\\infty = \\dfrac{a}{1 - r}$ jika $|r| < 1$"
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-05-step-04-q01",
              "tipe": "pilihan",
              "pertanyaan": "Deret tak hingga $9 + 3 + 1 + \\cdots$ punya jumlah...",
              "pilihan": ["12", "13", "13,5", "27/2"],
              "jawaban": 2,
              "pembahasan": "Penyelesaian:\n$a = 9$, $r = \\dfrac{1}{3}$.\n$S_\\infty = \\dfrac{9}{1 - \\frac{1}{3}} = \\dfrac{9}{\\frac{2}{3}} = \\dfrac{27}{2} = 13{,}5$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Ujian Bab 5",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Ujian terakhir bab geometri. Semangat!"
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-05-step-05-q01",
              "tipe": "pilihan",
              "pertanyaan": "Jumlah 6 suku pertama dari $1 + 2 + 4 + 8 + \\cdots$ adalah...",
              "pilihan": ["31", "63", "127", "255"],
              "jawaban": 1,
              "pembahasan": "Penyelesaian:\n$a = 1$, $r = 2$, $n = 6$.\n$S_6 = \\dfrac{1(2^6 - 1)}{2 - 1} = 63$."
            },
            {
              "id": "10-barisan-bab-05-step-05-q02",
              "tipe": "isi_kosong",
              "pertanyaan": "Jumlah tak hingga dari $12 + 4 + \\dfrac{4}{3} + \\cdots$ adalah... (tulis angka saja)",
              "pilihan": [],
              "jawaban": "18",
              "pembahasan": "Penyelesaian:\n$a = 12$, $r = \\dfrac{1}{3}$.\n$S_\\infty = \\dfrac{12}{1 - \\frac{1}{3}} = \\dfrac{12}{\\frac{2}{3}} = 18$."
            },
            {
              "id": "10-barisan-bab-05-step-05-q03",
              "tipe": "benar_salah",
              "pertanyaan": "Deret geometri dengan $r = 2$ memiliki jumlah tak hingga.",
              "pilihan": [],
              "jawaban": false,
              "pembahasan": "Penyelesaian:\n<b>SALAH</b>. Deret geometri tak hingga hanya konvergen (punya jumlah) kalau $|r| < 1$. Karena $r = 2 > 1$, deretnya divergen."
            },
            {
              "id": "10-barisan-bab-05-step-05-q04",
              "tipe": "pilihan",
              "pertanyaan": "Uang Rp1.000.000 ditabung bunga majemuk 10%/tahun. Setelah 3 tahun menjadi...",
