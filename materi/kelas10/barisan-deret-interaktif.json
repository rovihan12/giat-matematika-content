    {
      "id": "10-barisan-bab-04",
      "nomor": 4,
      "judul": "Barisan Geometri",
      "deskripsi": "Barisan dengan rasio tetap antar suku",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Kenalan dengan Barisan Geometri",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Kalau barisan aritmatika punya <b>beda</b> (dijumlah/dikurang), barisan geometri punya <b>rasio</b> (dikali/dibagi)!"
            },
            {
              "tipe": "paragraph",
              "text": "Perhatikan barisan $2, 6, 18, 54, \\ldots$. Setiap suku dikali $3$ dari suku sebelumnya. Angka $3$ inilah yang disebut <b>rasio</b> ($r$)."
            },
            {
              "tipe": "formula_block",
              "latex": "r = \\dfrac{U_2}{U_1} = \\dfrac{U_3}{U_2} = \\dfrac{U_n}{U_{n-1}}"
            }
          ],
          "latihan": []
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Rumus Suku ke-n Barisan Geometri",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "U_n = a \\cdot r^{n-1}"
            },
            {
              "tipe": "paragraph",
              "text": "Keterangan: $a$ = suku pertama, $r$ = rasio, $n$ = nomor suku."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Suku ke-6",
              "konten": [
                {
                  "tipe": "paragraph",
                  "text": "Tentukan suku ke-6 dari $2, 6, 18, 54, \\ldots$"
                },
                {
                  "tipe": "formula_block",
                  "latex": "\\begin{aligned} U_6 &= 2 \\cdot 3^{6-1} \\\\ &= 2 \\cdot 243 \\\\ &= 486 \\end{aligned}"
                }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-04-step-02-q01",
              "tipe": "pilihan",
              "pertanyaan": "Suku ke-5 dari barisan $3, 6, 12, 24, \\ldots$ adalah...",
              "pilihan": ["36", "42", "48", "54"],
              "jawaban": 2,
              "pembahasan": "Penyelesaian:\n$a = 3$, $r = 2$.\n$U_5 = 3 \\cdot 2^4 = 3 \\cdot 16 = 48$."
            },
            {
              "id": "10-barisan-bab-04-step-02-q02",
              "tipe": "isi_kosong",
              "pertanyaan": "Suku ke-4 dari barisan $5, 15, 45, \\ldots$ adalah... (tulis angka saja)",
              "pilihan": [],
              "jawaban": "135",
              "pembahasan": "Penyelesaian:\n$a = 5$, $r = 3$.\n$U_4 = 5 \\cdot 3^3 = 5 \\cdot 27 = 135$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Mencari Rasio dari Dua Suku",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "r = \\sqrt[m-n]{\\dfrac{U_m}{U_n}}"
            },
            {
              "tipe": "example",
              "judul": "Contoh: Cari Rasio",
              "konten": [
                {
                  "tipe": "paragraph",
                  "text": "Diketahui $U_2 = 6$ dan $U_5 = 162$. Tentukan $r$."
                },
                {
                  "tipe": "formula_block",
                  "latex": "\\begin{aligned} \\dfrac{U_5}{U_2} &= r^{5-2} = r^3 \\\\ \\dfrac{162}{6} &= 27 = r^3 \\\\ r &= 3 \\end{aligned}"
                }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-04-step-03-q01",
              "tipe": "pilihan",
              "pertanyaan": "Jika $U_1 = 2$ dan $U_4 = 54$, maka rasio barisan adalah...",
              "pilihan": ["2", "3", "4", "5"],
              "jawaban": 1,
              "pembahasan": "Penyelesaian:\n$\\dfrac{U_4}{U_1} = r^3$\n$\\dfrac{54}{2} = 27 = r^3 \\Rightarrow r = 3$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "rangkuman",
          "judul": "Rangkuman Bab 4",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Barisan geometri</b>: rasio antar suku selalu tetap",
                "Rumus suku ke-n: $U_n = a \\cdot r^{n-1}$",
                "Rasio: $r = \\dfrac{U_n}{U_{n-1}}$",
                "Jika $r > 1$ → naik, $0 < r < 1$ → turun"
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-04-step-04-q01",
              "tipe": "pilihan",
              "pertanyaan": "Barisan $100, 50, 25, 12{,}5, \\ldots$ memiliki rasio...",
              "pilihan": ["1/4", "1/3", "1/2", "2"],
              "jawaban": 2,
              "pembahasan": "Penyelesaian:\n$r = \\dfrac{U_2}{U_1} = \\dfrac{50}{100} = \\dfrac{1}{2}$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Ujian Bab 4",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Uji kemampuan barisan geometrimu!"
            }
          ],
          "latihan": [
            {
              "id": "10-barisan-bab-04-step-05-q01",
              "tipe": "pilihan",
              "pertanyaan": "Suku ke-6 dari $1, 2, 4, 8, \\ldots$ adalah...",
              "pilihan": ["16", "32", "48", "64"],
              "jawaban": 1,
              "pembahasan": "Penyelesaian:\n$a = 1$, $r = 2$.\n$U_6 = 1 \\cdot 2^5 = 32$."
            },
            {
              "id": "10-barisan-bab-04-step-05-q02",
              "tipe": "isi_kosong",
              "pertanyaan": "Jika $U_3 = 12$ dan $r = 2$, maka suku pertama $a$ = ... (tulis angka saja)",
              "pilihan": [],
              "jawaban": "3",
              "pembahasan": "Penyelesaian:\n$U_3 = a \\cdot r^2 = 12$\n$a \\cdot 4 = 12 \\Rightarrow a = 3$."
            },
            {
              "id": "10-barisan-bab-04-step-05-q03",
              "tipe": "benar_salah",
              "pertanyaan": "Barisan $2, -4, 8, -16$ adalah barisan geometri dengan $r = -2$.",
              "pilihan": [],
              "jawaban": true,
              "pembahasan": "Penyelesaian:\n$r = \\dfrac{-4}{2} = -2$.\nSetiap suku dikali $-2$, tandanya bergantian. <b>BENAR</b>."
