  "versi": "2.0.0",
  "bab": [
    {
      "id": "vektor-bab-01",
      "nomor": 1,
      "judul": "Pengertian, Notasi, dan Vektor Koordinat",
      "deskripsi": "Membedakan skalar dan vektor serta menyatakan vektor pada bidang koordinat 2D",
      "estimasi_menit": 10,
      "konten": [
        {
          "tipe": "heading",
          "level": 2,
          "text": "A. Pengertian dan Notasi Vektor"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "1. Besaran Skalar dan Besaran Vektor"
        },
        {
          "tipe": "paragraph",
          "text": "Besaran skalar adalah besaran yang cukup dinyatakan dengan nilai dan satuan saja, seperti massa, waktu, dan suhu. Besaran vektor adalah besaran yang memiliki nilai sekaligus arah, seperti perpindahan, kecepatan, dan gaya."
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "2. Vektor dari Dua Titik dan Bentuk Koordinat"
        },
        {
          "tipe": "paragraph",
          "text": "Jika titik pangkal adalah $A(x_1, y_1)$ dan titik ujung adalah $B(x_2, y_2)$, maka vektor $\\overrightarrow{AB}$ pada bidang koordinat 2D dinyatakan sebagai berikut:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\overrightarrow{AB} = \\begin{pmatrix} x_2 - x_1 \\\\ y_2 - y_1 \\end{pmatrix}"
        },
        {
          "tipe": "paragraph",
          "text": "Suatu vektor $\\vec{a}$ dengan komponen $x$ dan $y$ dapat ditulis dalam bentuk vektor kolom maupun kombinasi linear vektor basis satuan $\\vec{i}$ dan $\\vec{j}$:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\vec{a} = \\begin{pmatrix} x \\\\ y \\end{pmatrix} = x\\vec{i} + y\\vec{j}"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "3. Kesamaan Dua Vektor"
        },
        {
          "tipe": "paragraph",
          "text": "Dua vektor dikatakan sama jika besar dan arahnya sama, yaitu komponen-komponen yang bersesuaian bernilai sama:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\begin{pmatrix} x_1 \\\\ y_1 \\end{pmatrix} = \\begin{pmatrix} x_2 \\\\ y_2 \\end{pmatrix} \\Leftrightarrow x_1 = x_2 \\text{ dan } y_1 = y_2"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Contoh Soal"
        },
        {
          "tipe": "example",
          "judul": "Contoh 1: Menentukan Vektor Dua Titik",
          "konten": [
            { "tipe": "paragraph", "text": "Diketahui $A(1, 2)$ dan $B(4, 6)$. Tentukan vektor $\\overrightarrow{AB}$ dan bentuk basisnya." },
            { "tipe": "formula_block", "latex": "\\overrightarrow{AB} = \\begin{pmatrix} 4 - 1 \\\\ 6 - 2 \\end{pmatrix} = \\begin{pmatrix} 3 \\\\ 4 \\end{pmatrix} = 3\\vec{i} + 4\\vec{j}" }
          ]
        },
        {
          "tipe": "example",
          "judul": "Contoh 2: Kesamaan Dua Vektor",
          "konten": [
            { "tipe": "paragraph", "text": "Jika $\\begin{pmatrix} 2x \\\\ 7 \\end{pmatrix} = \\begin{pmatrix} 10 \\\\ y + 2 \\end{pmatrix}$, tentukan nilai $x$ dan $y$." },
            { "tipe": "formula_block", "latex": "2x = 10 \\Rightarrow x = 5" },
            { "tipe": "formula_block", "latex": "y + 2 = 7 \\Rightarrow y = 5" }
          ]
        }
      ]
    },
    {
      "id": "vektor-bab-02",
      "nomor": 2,
      "judul": "Panjang Vektor dan Vektor Satuan",
      "deskripsi": "Menghitung panjang (norm) vektor dan menentukan vektor satuan",
      "estimasi_menit": 10,
      "konten": [
        {
          "tipe": "heading",
          "level": 2,
          "text": "B. Panjang Vektor dan Vektor Satuan"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "1. Panjang Vektor (Norm)"
        },
        {
          "tipe": "paragraph",
          "text": "Panjang atau besar vektor $\\vec{a} = \\begin{pmatrix} x \\\\ y \\end{pmatrix}$ dihitung menggunakan rumus Pythagoras:"
        },
        {
          "tipe": "formula_block",
          "latex": "|\\vec{a}| = \\sqrt{x^2 + y^2}"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "2. Vektor Satuan"
        },
        {
          "tipe": "paragraph",
          "text": "Vektor satuan adalah vektor yang panjangnya sama dengan $1$ satuan. Vektor satuan yang searah dengan $\\vec{a}$ (dengan $|\\vec{a}| \\neq 0$) adalah:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\hat{e}_a = \\dfrac{\\vec{a}}{|\\vec{a}|}"
        },
        {
          "tipe": "list",
          "ordered": false,
          "items": [
            "Panjang vektor selalu bernilai non-negatif ($|\\vec{a}| \\ge 0$)",
            "Kuadrat komponen negatif selalu bernilai positif, yaitu $(-k)^2 = k^2$",
            "Panjang vektor satuan selalu sama dengan $1$, yaitu $|\\hat{e}_a| = 1$"
          ]
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Contoh Soal"
        },
        {
          "tipe": "example",
          "judul": "Contoh 1: Panjang Vektor",
          "konten": [
            { "tipe": "paragraph", "text": "Hitung panjang vektor $\\vec{a} = \\begin{pmatrix} 6 \\\\ 8 \\end{pmatrix}$." },
            { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{6^2 + 8^2}" },
            { "tipe": "formula_block", "latex": "= \\sqrt{36 + 64} = \\sqrt{100} = 10" }
          ]
        },
        {
          "tipe": "example",
          "judul": "Contoh 2: Vektor Satuan",
          "konten": [
            { "tipe": "paragraph", "text": "Tentukan vektor satuan searah $\\vec{a} = \\begin{pmatrix} 3 \\\\ 4 \\end{pmatrix}$." },
            { "tipe": "formula_block", "latex": "|\\vec{a}| = \\sqrt{3^2 + 4^2} = 5" },
            { "tipe": "formula_block", "latex": "\\hat{e}_a = \\dfrac{1}{5}\\begin{pmatrix} 3 \\\\ 4 \\end{pmatrix} = \\begin{pmatrix} \\dfrac{3}{5} \\\\ \\dfrac{4}{5} \\end{pmatrix}" }
          ]
        }
      ]
    },
    {
      "id": "vektor-bab-03",
      "nomor": 3,
      "judul": "Penjumlahan, Pengurangan, dan Perkalian Skalar",
      "deskripsi": "Operasi penjumlahan, pengurangan, perkalian skalar, dan kombinasi linear vektor",
      "estimasi_menit": 12,
      "konten": [
        {
          "tipe": "heading",
          "level": 2,
          "text": "C. Operasi Aljabar pada Vektor"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "1. Penjumlahan dan Pengurangan Vektor"
        },
        {
          "tipe": "paragraph",
          "text": "Untuk $\\vec{a} = \\begin{pmatrix} x_1 \\\\ y_1 \\end{pmatrix}$ dan $\\vec{b} = \\begin{pmatrix} x_2 \\\\ y_2 \\end{pmatrix}$, penjumlahan dan pengurangan dilakukan pada komponen yang bersesuaian:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\vec{a} + \\vec{b} = \\begin{pmatrix} x_1 + x_2 \\\\ y_1 + y_2 \\end{pmatrix}"
        },
        {
          "tipe": "formula_block",
          "latex": "\\vec{a} - \\vec{b} = \\begin{pmatrix} x_1 - x_2 \\\\ y_1 - y_2 \\end{pmatrix}"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "2. Perkalian Skalar dan Sifat Operasi"
        },
        {
          "tipe": "paragraph",
          "text": "Jika $k \\in \\mathbb{R}$ adalah bilangan skalar, maka perkalian skalar dengan vektor didefinisikan sebagai:"
        },
        {
          "tipe": "formula_block",
          "latex": "k \\cdot \\vec{a} = k \\cdot \\begin{pmatrix} x \\\\ y \\end{pmatrix} = \\begin{pmatrix} kx \\\\ ky \\end{pmatrix}"
        },
        {
          "tipe": "list",
          "ordered": false,
          "items": [
            "Sifat komutatif penjumlahan: $\\vec{a} + \\vec{b} = \\vec{b} + \\vec{a}$",
            "Sifat asosiatif penjumlahan: $(\\vec{a} + \\vec{b}) + \\vec{c} = \\vec{a} + (\\vec{b} + \\vec{c})$",
            "Sifat distributif skalar: $k(\\vec{a} + \\vec{b}) = k\\vec{a} + k\\vec{b}$"
          ]
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Contoh Soal"
        },
        {
          "tipe": "example",
          "judul": "Contoh 1: Penjumlahan dan Pengurangan",
          "konten": [
            { "tipe": "paragraph", "text": "Diketahui $\\vec{a} = \\begin{pmatrix} 2 \\\\ 5 \\end{pmatrix}$ dan $\\vec{b} = \\begin{pmatrix} 4 \\\\ -1 \\end{pmatrix}$." },
            { "tipe": "formula_block", "latex": "\\vec{a} + \\vec{b} = \\begin{pmatrix} 2 + 4 \\\\ 5 + (-1) \\end{pmatrix} = \\begin{pmatrix} 6 \\\\ 4 \\end{pmatrix}" },
            { "tipe": "formula_block", "latex": "\\vec{a} - \\vec{b} = \\begin{pmatrix} 2 - 4 \\\\ 5 - (-1) \\end{pmatrix} = \\begin{pmatrix} -2 \\\\ 6 \\end{pmatrix}" }
          ]
        },
        {
          "tipe": "example",
          "judul": "Contoh 2: Perkalian Skalar dan Kombinasi Linear",
          "konten": [
            { "tipe": "paragraph", "text": "Hitung $2\\vec{a} - \\vec{b}$ jika $\\vec{a} = \\begin{pmatrix} 3 \\\\ 1 \\end{pmatrix}$ dan $\\vec{b} = \\begin{pmatrix} 2 \\\\ 4 \\end{pmatrix}$." },
            { "tipe": "formula_block", "latex": "2\\vec{a} - \\vec{b} = 2\\begin{pmatrix} 3 \\\\ 1 \\end{pmatrix} - \\begin{pmatrix} 2 \\\\ 4 \\end{pmatrix}" },
            { "tipe": "formula_block", "latex": "= \\begin{pmatrix} 6 \\\\ 2 \\end{pmatrix} - \\begin{pmatrix} 2 \\\\ 4 \\end{pmatrix} = \\begin{pmatrix} 4 \\\\ -2 \\end{pmatrix}" }
          ]
        }
      ]
    },
    {
      "id": "vektor-bab-04",
      "nomor": 4,
      "judul": "Penerapan Vektor Sehari-Hari",
      "deskripsi": "Model perpindahan, posisi akhir, dan jarak lurus pada bidang koordinat",
      "estimasi_menit": 10,
      "konten": [
        {
          "tipe": "heading",
          "level": 2,
          "text": "D. Penerapan Vektor dalam Kehidupan Sehari-Hari"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "1. Resultan Perpindahan dan Posisi Akhir"
        },
        {
          "tipe": "paragraph",
          "text": "Jika suatu objek bergerak melalui beberapa perpindahan $\\vec{d}_1, \\vec{d}_2, \\dots$, maka vektor perpindahan total (resultan) adalah jumlah dari vektor-vektor perpindahan tersebut:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\vec{R} = \\vec{d}_1 + \\vec{d}_2 + \\cdots"
        },
        {
          "tipe": "paragraph",
          "text": "Jika posisi awal dinyatakan dengan vektor posisi $\\vec{r}_0$ dan mengalami pergeseran $\\Delta\\vec{r}$, maka vektor posisi akhir adalah:"
        },
        {
          "tipe": "formula_block",
          "latex": "\\vec{r} = \\vec{r}_0 + \\Delta\\vec{r}"
        },
        {
          "tipe": "heading",
          "level": 3,
          "text": "Contoh Soal"
        },
        {
          "tipe": "example",
          "judul": "Contoh 1: Perpindahan dan Jarak Lurus",
          "konten": [
            { "tipe": "paragraph", "text": "Seseorang berjalan $4\\text{ km}$ ke timur (sumbu $+x$) lalu $3\\text{ km}$ ke utara (sumbu $+y$). Tentukan vektor perpindahan dan jarak lurus dari titik awal." },
            { "tipe": "formula_block", "latex": "\\vec{r} = \\begin{pmatrix} 4 \\\\ 3 \\end{pmatrix}" },
            { "tipe": "formula_block", "latex": "|\\vec{r}| = \\sqrt{4^2 + 3^2} = \\sqrt{25} = 5\\text{ km}" }
          ]
        },
        {
          "tipe": "example",
          "judul": "Contoh 2: Menentukan Posisi Akhir",
          "konten": [
            { "tipe": "paragraph", "text": "Posisi awal kurir berada di $\\begin{pmatrix} 2 \\\\ 3 \\end{pmatrix}$ dan bergeser sejauh $\\begin{pmatrix} -1 \\\\ 4 \\end{pmatrix}$. Tentukan posisi akhirnya." },
            { "tipe": "formula_block", "latex": "\\vec{r} = \\begin{pmatrix} 2 \\\\ 3 \\end{pmatrix} + \\begin{pmatrix} -1 \\\\ 4 \\end{pmatrix} = \\begin{pmatrix} 1 \\\\ 7 \\end{pmatrix}" }
          ]
        }
      ]
    }
  ]
}