            },
            {
              "id": "10-plg-b01-s4-q3",
              "tipe": "isi_kosong",
              "pertanyaan": "Sebuah kantong berisi 5 bola berbeda warna. Nilai $n(S)$ = ... (tulis angka saja)",
              "jawaban": "5",
              "pembahasan": "Ada 5 bola berbeda, jadi $n(S) = 5$."
            }
          ]
        }
      ]
    },
    {
      "id": "10-plg-bab-02",
      "nomor": 2,
      "judul": "Peluang Suatu Kejadian",
      "deskripsi": "Menghitung peluang dengan pendekatan klasik",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Peluang?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Peluang</b> (probabilitas) adalah ukuran seberapa besar kemungkinan suatu kejadian terjadi. Nilainya selalu antara <b>0 dan 1</b>."
            },
            {
              "tipe": "formula_block",
              "latex": "P(A) = \\dfrac{n(A)}{n(S)}"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$P(A)$ = peluang kejadian $A$",
                "$n(A)$ = banyak titik sampel kejadian $A$",
                "$n(S)$ = banyak titik sampel ruang sampel"
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b02-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Rumus peluang suatu kejadian $A$ adalah...",
              "pilihan": ["$P(A) = n(S) / n(A)$", "$P(A) = n(A) / n(S)$", "$P(A) = n(A) \\times n(S)$", "$P(A) = n(A) + n(S)$"],
              "jawaban": 1,
              "pembahasan": "Rumus peluang: $P(A) = \\dfrac{n(A)}{n(S)}$."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Rentang Nilai Peluang",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Nilai peluang selalu berada di antara 0 dan 1:"
            },
            {
              "tipe": "formula_block",
              "latex": "0 \\leq P(A) \\leq 1"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$P(A) = 0$ → kejadian <b>mustahil</b> terjadi",
                "$P(A) = 1$ → kejadian <b>pasti</b> terjadi",
                "$P(A) = 0{,}5$ → kejadian <b>seimbang</b> (mis. lempar koin)"
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b02-s2-q1",
              "tipe": "benar_salah",
              "pertanyaan": "Nilai peluang bisa lebih besar dari 1.",
              "jawaban": false,
              "pembahasan": "Peluang selalu $0 \\leq P(A) \\leq 1$. Tidak mungkin lebih dari 1. Pernyataan <b>SALAH</b>."
            },
            {
              "id": "10-plg-b02-s2-q2",
              "tipe": "pilihan",
              "pertanyaan": "Jika $P(A) = 0$, maka kejadian $A$...",
              "pilihan": ["Pasti terjadi", "Mustahil terjadi", "Seimbang", "Tidak diketahui"],
              "jawaban": 1,
              "pembahasan": "$P(A) = 0$ berarti kejadian <b>mustahil</b> terjadi."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Peluang Komplemen",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Komplemen kejadian $A$ (ditulis $A'$ atau $A^c$) adalah kejadian <b>selain</b> $A$. Hubungannya:"
            },
            {
              "tipe": "formula_block",
              "latex": "P(A') = 1 - P(A)"
            },
            {
              "tipe": "paragraph",
              "text": "Ini sangat berguna kalau menghitung $P(A')$ lebih mudah daripada $P(A)$."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Peluang Bukan 6",
              "konten": [
                { "tipe": "paragraph", "text": "Sebuah dadu dilempar sekali. Berapa peluang muncul <b>bukan</b> angka 6?" },
                { "tipe": "paragraph", "text": "Peluang muncul angka 6: $P(\\text{6}) = \\dfrac{1}{6}$." },
                { "tipe": "formula_block", "latex": "P(\\text{bukan 6}) = 1 - \\dfrac{1}{6} = \\dfrac{5}{6}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b02-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Sebuah koin dilempar. Peluang muncul Angka = 1/2. Peluang muncul Gambar = ... (tulis dalam bentuk desimal, contoh 0,5)",
              "jawaban": "0,5",
              "pembahasan": "$P(\\text{Gambar}) = 1 - P(\\text{Angka}) = 1 - 0{,}5 = 0{,}5$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Frekuensi Harapan",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Kalau percobaan dilakukan $n$ kali, banyaknya kejadian $A$ yang diharapkan muncul disebut <b>frekuensi harapan</b>."
            },
            {
              "tipe": "formula_block",
              "latex": "F_h(A) = n \\times P(A)"
            },
            {
              "tipe": "example",
              "judul": "Contoh: Dadu 120 Kali",
              "konten": [
                { "tipe": "paragraph", "text": "Sebuah dadu dilempar 120 kali. Berapa frekuensi harapan muncul angka ganjil?" },
                { "tipe": "paragraph", "text": "Angka ganjil: 1, 3, 5 → $P(A) = \\dfrac{3}{6} = \\dfrac{1}{2}$." },
                { "tipe": "formula_block", "latex": "F_h = 120 \\times \\dfrac{1}{2} = 60" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b02-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Sebuah koin dilempar 100 kali. Frekuensi harapan muncul Angka = ... (tulis angka saja)",
              "jawaban": "50",
              "pembahasan": "$F_h = 100 \\times \\dfrac{1}{2} = 50$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 2",
          "konten": [],
          "latihan": [
            {
              "id": "10-plg-b02-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Sebuah dadu dilempar sekali. Peluang muncul angka prima adalah...",
              "pilihan": ["1/6", "1/3", "1/2", "2/3"],
              "jawaban": 2,
              "pembahasan": "Angka prima pada dadu: 2, 3, 5 → $n(A) = 3$. $P(A) = 3/6 = 1/2$."
            },
            {
              "id": "10-plg-b02-s5-q2",
              "tipe": "pilihan",
              "pertanyaan": "Kantong berisi 5 merah, 3 biru, 2 hijau. Peluang terambil biru adalah...",
              "pilihan": ["3/10", "1/3", "3/5", "1/10"],
              "jawaban": 0,
              "pembahasan": "Total = 10. Biru = 3. $P = 3/10$."
            },
            {
              "id": "10-plg-b02-s5-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Jika $P(A) = 0{,}7$, maka $P(A') = 0{,}3$.",
              "jawaban": true,
              "pembahasan": "$P(A') = 1 - 0{,}7 = 0{,}3$. <b>BENAR</b>."
            }
          ]
        }
      ]
    },
    {
      "id": "10-plg-bab-03",
      "nomor": 3,
      "judul": "Kejadian Majemuk: Gabungan",
      "deskripsi": "Peluang kejadian A atau B (union)",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Kejadian Saling Lepas",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Dua kejadian $A$ dan $B$ disebut <b>saling lepas</b> jika keduanya <b>tidak bisa terjadi bersamaan</b>. Artinya, $A \\cap B = \\emptyset$."
            },
            {
              "tipe": "image",
              "src": "images/kelas10/peluang/saling-lepas.png",
              "caption": "Diagram Venn dua kejadian saling lepas — tidak ada irisan antara $A$ dan $B$",
              "width": "medium"
            },
            {
              "tipe": "paragraph",
              "text": "Contoh: pada pelemparan dadu, kejadian \"muncul angka 1\" dan \"muncul angka 6\" saling lepas."
            },
            {
              "tipe": "formula_block",
              "latex": "P(A \\cup B) = P(A) + P(B)"
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b03-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Dua kejadian disebut saling lepas jika...",
              "pilihan": [
                "Bisa terjadi bersamaan",
                "Tidak bisa terjadi bersamaan",
                "Saling mempengaruhi",
                "Selalu terjadi"
              ],
              "jawaban": 1,
              "pembahasan": "Saling lepas = <b>tidak bisa terjadi bersamaan</b> (irisan kosong)."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Rumus Saling Lepas",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Untuk dua kejadian saling lepas, peluang gabungannya adalah:"
            },
            {
              "tipe": "formula_block",
              "latex": "P(A \\cup B) = P(A) + P(B)"
            },
            {
              "tipe": "example",
              "judul": "Contoh: Dadu 2 atau 5",
              "konten": [
                { "tipe": "paragraph", "text": "Sebuah dadu dilempar. Berapa peluang muncul angka 2 atau 5?" },
                { "tipe": "paragraph", "text": "\"Muncul 2\" dan \"muncul 5\" saling lepas." },
                { "tipe": "formula_block", "latex": "\\begin{aligned} P(2 \\cup 5) &= \\dfrac{1}{6} + \\dfrac{1}{6} \\\\ &= \\dfrac{2}{6} = \\dfrac{1}{3} \\end{aligned}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b03-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Sebuah dadu dilempar. Peluang muncul angka 1 atau 3 (tulis dalam bentuk desimal, contoh 0,333)",
              "jawaban": "0,333",
              "pembahasan": "$P = 1/6 + 1/6 = 2/6 = 1/3 \\approx 0{,}333$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Kejadian Tidak Saling Lepas",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Kalau $A$ dan $B$ <b>bisa terjadi bersamaan</b>, maka ada irisan $A \\cap B$. Rumusnya:"
            },
            {
              "tipe": "image",
              "src": "images/kelas10/peluang/tidak-saling-lepas.png",
              "caption": "Diagram Venn dua kejadian tidak saling lepas — ada irisan",
              "width": "medium"
            },
            {
              "tipe": "formula_block",
              "latex": "P(A \\cup B) = P(A) + P(B) - P(A \\cap B)"
            },
            {
              "tipe": "paragraph",
              "text": "Kenapa dikurangi? Karena irisan $A \\cap B$ terhitung <b>dua kali</b> (sekali di $P(A)$, sekali di $P(B)$), jadi perlu dikurangi sekali."
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b03-s3-q1",
              "tipe": "benar_salah",
              "pertanyaan": "Pada kejadian tidak saling lepas, kita kurangi $P(A \\cap B)$ karena irisan terhitung dua kali.",
              "jawaban": true,
              "pembahasan": "Benar — irisan dihitung sekali di $P(A)$ dan sekali lagi di $P(B)$, jadi harus dikurangi sekali. <b>BENAR</b>."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Contoh Tidak Saling Lepas",
          "konten": [
            {
              "tipe": "example",
              "judul": "Contoh 1: Prima atau Genap",
              "konten": [
                { "tipe": "paragraph", "text": "Dadu dilempar. Peluang muncul angka prima atau genap?" },
                { "tipe": "paragraph", "text": "Prima: $A = \\{2, 3, 5\\}$, $P(A) = \\dfrac{3}{6}$." },
                { "tipe": "paragraph", "text": "Genap: $B = \\{2, 4, 6\\}$, $P(B) = \\dfrac{3}{6}$." },
                { "tipe": "paragraph", "text": "Irisan: $A \\cap B = \\{2\\}$, $P(A \\cap B) = \\dfrac{1}{6}$." },
                { "tipe": "formula_block", "latex": "P(A \\cup B) = \\dfrac{3}{6} + \\dfrac{3}{6} - \\dfrac{1}{6} = \\dfrac{5}{6}" }
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh 2: Kartu Bridge",
              "konten": [
                { "tipe": "paragraph", "text": "Dari 52 kartu bridge, diambil 1 acak. Peluang terambil kartu As atau kartu hati?" },
                { "tipe": "paragraph", "text": "$P(\\text{As}) = \\dfrac{4}{52}$, $P(\\text{Hati}) = \\dfrac{13}{52}$, $P(\\text{As} \\cap \\text{Hati}) = \\dfrac{1}{52}$." },
                { "tipe": "formula_block", "latex": "P(A \\cup H) = \\dfrac{4}{52} + \\dfrac{13}{52} - \\dfrac{1}{52} = \\dfrac{16}{52} = \\dfrac{4}{13}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b03-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "Dadu dilempar. Peluang muncul angka ganjil atau angka prima adalah...",
              "pilihan": ["1/2", "2/3", "5/6", "1"],
              "jawaban": 1,
              "pembahasan": "Ganjil: {1,3,5}, Prima: {2,3,5}. Irisan: {3,5} = 2/6. $P = 3/6 + 3/6 - 2/6 = 4/6 = 2/3$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 3",
          "konten": [],
          "latihan": [
            {
              "id": "10-plg-b03-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Pada kejadian saling lepas, peluang gabungannya adalah...",
              "pilihan": [
                "$P(A) \\times P(B)$",
                "$P(A) + P(B)$",
                "$P(A) - P(B)$",
                "$P(A) + P(B) - P(A \\cap B)$"
              ],
              "jawaban": 1,
              "pembahasan": "Saling lepas → tidak ada irisan → $P(A \\cup B) = P(A) + P(B)$."
            },
            {
              "id": "10-plg-b03-s5-q2",
              "tipe": "benar_salah",
              "pertanyaan": "Pada kejadian tidak saling lepas, rumusnya $P(A \\cup B) = P(A) + P(B)$.",
              "jawaban": false,
