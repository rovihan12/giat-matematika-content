    {
      "id": "10-plg-bab-01",
      "nomor": 1,
      "judul": "Ruang Sampel dan Kejadian",
      "deskripsi": "Konsep dasar percobaan, ruang sampel, dan titik sampel",
      "total_step": 4,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Percobaan?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Dalam statistika dan peluang, <b>percobaan</b> adalah kegiatan yang dilakukan untuk mengamati hasil tertentu. Contohnya: melempar koin, melempar dadu, atau mengambil bola dari kotak."
            },
            {
              "tipe": "paragraph",
              "text": "Setiap percobaan punya <b>hasil</b> yang bisa bermacam-macam. Nah, kumpulan semua hasil yang mungkin inilah yang disebut <b>ruang sampel</b>."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Percobaan</b> — kegiatan yang menghasilkan hasil tertentu",
                "<b>Titik sampel</b> — satu hasil tunggal dari percobaan",
                "<b>Ruang sampel ($S$)</b> — himpunan semua titik sampel",
                "<b>Kejadian ($A$)</b> — himpunan bagian dari ruang sampel"
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Kumpulan semua hasil yang mungkin dari suatu percobaan disebut...",
              "pilihan": ["Titik sampel", "Ruang sampel", "Kejadian", "Peluang"],
              "jawaban": 1,
              "pembahasan": "Kumpulan semua hasil yang mungkin disebut <b>ruang sampel</b> (biasanya dilambangkan $S$)."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Notasi dan Istilah Penting",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Dalam peluang, kita sering pakai notasi berikut:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$S$ = ruang sampel",
                "$n(S)$ = banyaknya titik sampel di ruang sampel",
                "$A$ = kejadian yang diamati",
                "$n(A)$ = banyaknya titik sampel di kejadian $A$"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Konsep ini penting karena hampir semua soal peluang menggunakan notasi ini."
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b01-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Notasi $n(S)$ menyatakan...",
              "pilihan": [
                "Banyak titik sampel ruang sampel",
                "Nilai peluang kejadian",
                "Jumlah kejadian",
                "Total percobaan"
              ],
              "jawaban": 0,
              "pembahasan": "$n(S)$ = banyaknya titik sampel di ruang sampel $S$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Contoh Ruang Sampel",
          "konten": [
            {
              "tipe": "heading",
              "level": 3,
              "text": "1. Melempar Satu Koin"
            },
            {
              "tipe": "paragraph",
              "text": "Hasilnya hanya <b>Angka (A)</b> atau <b>Gambar (G)</b>."
            },
            {
              "tipe": "formula_block",
              "latex": "S = \\{A, G\\}, \\quad n(S) = 2"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "2. Melempar Satu Dadu"
            },
            {
              "tipe": "formula_block",
              "latex": "S = \\{1, 2, 3, 4, 5, 6\\}, \\quad n(S) = 6"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "3. Melempar Dua Koin Sekaligus"
            },
            {
              "tipe": "formula_block",
              "latex": "S = \\{AA, AG, GA, GG\\}, \\quad n(S) = 4"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "4. Melempar Dua Dadu Sekaligus"
            },
            {
              "tipe": "paragraph",
              "text": "Total $6 \\times 6 = 36$ kemungkinan. Ruang sampelnya disusun dalam tabel:"
            },
            {
              "tipe": "image",
              "src": "images/kelas10/peluang/ruang-sampel-dua-dadu.png",
              "caption": "Tabel ruang sampel pelemparan dua dadu — total 36 titik sampel",
