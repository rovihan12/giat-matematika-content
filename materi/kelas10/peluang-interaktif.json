              "jawaban": 2,
              "pembahasan": "$S = \\{AA, AG, GA, GG\\}$, jadi $n(S) = 4$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 1",
          "konten": [],
          "latihan": [
            {
              "id": "10-plg-b01-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "Himpunan bagian dari ruang sampel disebut...",
              "pilihan": ["Titik sampel", "Percobaan", "Kejadian", "Ruang sampel"],
              "jawaban": 2,
              "pembahasan": "<b>Kejadian</b> adalah himpunan bagian dari ruang sampel."
            },
