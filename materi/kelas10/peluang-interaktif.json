    {
      "id": "10-plg-bab-05",
      "nomor": 5,
      "judul": "Permutasi dan Kombinasi",
      "deskripsi": "Menghitung banyak susunan dan pilihan",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Aturan Perkalian & Faktorial",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Aturan perkalian</b>: kalau kejadian 1 punya $m$ cara dan kejadian 2 punya $n$ cara, total cara melakukan keduanya adalah $m \\times n$."
            },
            {
              "tipe": "formula_block",
              "latex": "\\text{Total cara} = m \\times n"
            },
            {
              "tipe": "paragraph",
              "text": "<b>Faktorial</b> dari $n$ (ditulis $n!$) adalah hasil kali $n$ dengan semua bilangan bulat positif di bawahnya."
            },
            {
              "tipe": "formula_block",
              "latex": "n! = n \\times (n-1) \\times (n-2) \\times \\cdots \\times 1"
            },
            {
              "tipe": "paragraph",
              "text": "Contoh: $5! = 5 \\times 4 \\times 3 \\times 2 \\times 1 = 120$. Dan $0! = 1$ (sudah didefinisikan)."
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b05-s1-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Nilai dari $4!$ = ... (tulis angka saja)",
              "jawaban": "24",
              "pembahasan": "$4! = 4 \\times 3 \\times 2 \\times 1 = 24$."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Permutasi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Permutasi</b> adalah susunan objek dengan <b>memperhatikan urutan</b>. Contoh: susunan juara 1, 2, 3 — (A, B, C) berbeda dengan (B, A, C)."
            },
            {
              "tipe": "formula_block",
              "latex": "P(n, r) = \\dfrac{n!}{(n-r)!}"
            },
            {
              "tipe": "paragraph",
              "text": "Rumus ini dipakai kalau kita memilih $r$ objek dari $n$ objek, dengan urutan penting."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Ketua, Sekretaris, Bendahara",
              "konten": [
                { "tipe": "paragraph", "text": "Dari 5 siswa akan dipilih 3 untuk Ketua, Sekretaris, dan Bendahara." },
                { "tipe": "formula_block", "latex": "P(5, 3) = \\dfrac{5!}{2!} = \\dfrac{120}{2} = 60" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b05-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$P(4, 2)$ = ... (tulis angka saja)",
              "jawaban": "12",
              "pembahasan": "$P(4, 2) = \\dfrac{4!}{2!} = \\dfrac{24}{2} = 12$."
            },
            {
              "id": "10-plg-b05-s2-q2",
              "tipe": "pilihan",
              "pertanyaan": "Berapa banyak susunan 3 huruf berbeda dari {A, B, C, D}?",
              "pilihan": ["12", "24", "6", "4"],
              "jawaban": 1,
              "pembahasan": "$P(4, 3) = \\dfrac{4!}{1!} = 24$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Permutasi Khusus",
          "konten": [
            {
              "tipe": "heading",
              "level": 3,
              "text": "Permutasi dengan Unsur Sama"
            },
            {
              "tipe": "paragraph",
              "text": "Kalau ada objek yang sama, bagi dengan faktorial jumlah objek yang sama:"
            },
            {
              "tipe": "formula_block",
              "latex": "P = \\dfrac{n!}{k_1! \\cdot k_2! \\cdots k_m!}"
            },
            {
              "tipe": "paragraph",
              "text": "Contoh: susunan huruf dari \"BUKU\" (ada 2 huruf U):"
            },
            {
              "tipe": "formula_block",
              "latex": "P = \\dfrac{4!}{2!} = \\dfrac{24}{2} = 12"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "Permutasi Siklis (Melingkar)"
            },
            {
              "tipe": "paragraph",
              "text": "Kalau objek disusun melingkar:"
            },
            {
              "tipe": "formula_block",
              "latex": "P_{\\text{siklis}} = (n - 1)!"
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b05-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "5 orang duduk melingkar. Banyak susunan = ... (tulis angka saja)",
              "jawaban": "24",
              "pembahasan": "$P_{\\text{siklis}} = (5-1)! = 4! = 24$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Kombinasi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Kombinasi</b> adalah pemilihan objek <b>tanpa memperhatikan urutan</b>. Contoh: memilih 3 orang dari 5 untuk jadi tim — (A, B, C) sama saja dengan (B, A, C)."
            },
            {
              "tipe": "formula_block",
              "latex": "C(n, r) = \\dfrac{n!}{r! (n-r)!}"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "Perbedaan Permutasi vs Kombinasi"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Permutasi</b> — urutan <b>penting</b> (mis. susunan juara, password)",
                "<b>Kombinasi</b> — urutan <b>tidak penting</b> (mis. memilih tim, memilih menu)"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh: Memilih Tim",
              "konten": [
                { "tipe": "paragraph", "text": "Dari 7 siswa akan dipilih 3 untuk lomba. Berapa cara memilihnya?" },
                { "tipe": "formula_block", "latex": "C(7, 3) = \\dfrac{7!}{3! \\cdot 4!} = \\dfrac{7 \\times 6 \\times 5}{6} = 35" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b05-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$C(5, 2)$ = ... (tulis angka saja)",
              "jawaban": "10",
              "pembahasan": "$C(5, 2) = \\dfrac{5!}{2! \\cdot 3!} = \\dfrac{120}{2 \\times 6} = 10$."
            },
            {
              "id": "10-plg-b05-s4-q2",
              "tipe": "pilihan",
              "pertanyaan": "Manakah yang menggunakan KOMBINASI?",
              "pilihan": [
                "Menyusun password 4 digit",
                "Memilih 3 anggota tim dari 10 orang",
                "Menyusun urutan juara 1-2-3",
                "Menyusun urutan duduk"
