                { "tipe": "formula_block", "latex": "P(M|F) = \\dfrac{P(M \\cap F)}{P(F)} = \\dfrac{5/20}{8/20} = \\dfrac{5}{8}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-plg-b06-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Rumus peluang bersyarat $P(B|A)$ adalah...",
