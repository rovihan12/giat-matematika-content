              "text": "Saat mengkuadratkan komponen negatif, hasilnya selalu positif sehingga panjang vektor tidak pernah bernilai negatif."
            },
            {
              "tipe": "formula_block",
              "latex": "(-k)^2 = k^2 \\ge 0"
            },
            {
              "tipe": "example",
              "judul": "Contoh Komponen Negatif",
              "konten": [
                { "tipe": "formula_block", "latex": "\\left|\\begin{pmatrix} -5 \\\\ 12 \\end{pmatrix}\\right| = \\sqrt{(-5)^2 + 12^2} = \\sqrt{25 + 144} = 13" }
