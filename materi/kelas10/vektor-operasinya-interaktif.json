      "judul": "Pengertian, Notasi, dan Vektor Koordinat",
      "deskripsi": "Membedakan besaran skalar dan vektor serta menyatakan vektor pada bidang 2D",
      "total_step": 4,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Besaran Skalar dan Besaran Vektor",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Besaran **skalar** adalah besaran yang cukup dinyatakan dengan nilai (besar) dan satuan saja, seperti massa, waktu, dan suhu. Besaran **vektor** adalah besaran yang memiliki nilai sekaligus arah, seperti perpindahan, kecepatan, dan gaya."
            },
            {
              "tipe": "formula_block",
              "latex": "\\vec{u} = \\overrightarrow{AB} = \\begin{pmatrix} x_2 - x_1 \\\\ y_2 - y_1 \\end{pmatrix}"
            },
            {
              "tipe": "paragraph",
              "text": "Keterangan: $A(x_1, y_1)$ adalah titik pangkal dan $B(x_2, y_2)$ adalah titik ujung vektor."
            },
            {
              "tipe": "example",
              "judul": "Contoh Vektor Posisi Dua Titik",
              "konten": [
                { "tipe": "paragraph", "text": "Jika $A(1, 2)$ dan $B(4, 6)$, maka vektor $\\overrightarrow{AB}$ adalah:" },
                { "tipe": "formula_block", "latex": "\\overrightarrow{AB} = \\begin{pmatrix} 4 - 1 \\\\ 6 - 2 \\end{pmatrix} = \\begin{pmatrix} 3 \\\\ 4 \\end{pmatrix}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-vektor-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Manakah di bawah ini yang termasuk besaran **vektor**?",
              "pilihan": ["Suhu ruangan", "Perpindahan mobil", "Massa benda", "Luas tanah"],
              "jawaban": 1,
              "pembahasan": "Perpindahan memiliki besar sekaligus arah, sehingga termasuk besaran vektor. Suhu, massa, dan luas adalah besaran skalar."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Bentuk Vektor Kolom dan Basis Satuan",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Pada bidang koordinat kartesius (2D), vektor $\\vec{a}$ dengan komponen $x$ dan $y$ dapat ditulis dalam bentuk vektor kolom maupun kombinasi linear vektor basis $\\vec{i}$ dan $\\vec{j}$."
            },
            {
              "tipe": "formula_block",
              "latex": "\\vec{a} = \\begin{pmatrix} x \\\\ y \\end{pmatrix} = x\\vec{i} + y\\vec{j}"
            },
            {
              "tipe": "example",
              "judul": "Contoh Konversi Bentuk Vektor",
              "konten": [
                { "tipe": "formula_block", "latex": "\\vec{a} = \\begin{pmatrix} -2 \\\\ 5 \\end{pmatrix} = -2\\vec{i} + 5\\vec{j}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-vektor-b01-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Bentuk vektor basis dari $\\vec{v} = \\begin{pmatrix} 3 \\\\ -4 \\end{pmatrix}$ adalah...",
              "pilihan": ["$3\\vec{i} - 4\\vec{j}$", "$-3\\vec{i} + 4\\vec{j}$", "$4\\vec{i} - 3\\vec{j}$", "$3\\vec{i} + 4\\vec{j}$"],
              "jawaban": 0,
              "pembahasan": "Komponen atas ($3$) berpasangan dengan $\\vec{i}$ dan komponen bawah ($-4$) berpasangan dengan $\\vec{j}$, sehingga $\\vec{v} = 3\\vec{i} - 4\\vec{j}$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Kesamaan Dua Vektor dan Vektor Nol",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Dua vektor dikatakan sama jika memiliki besar dan arah yang sama (komponen-komponen yang bersesuaian bernilai sama)."
            },
            {
              "tipe": "formula_block",
              "latex": "\\begin{pmatrix} x_1 \\\\ y_1 \\end{pmatrix} = \\begin{pmatrix} x_2 \\\\ y_2 \\end{pmatrix} \\Leftrightarrow x_1 = x_2 \\text{ dan } y_1 = y_2"
            },
            {
              "tipe": "example",
              "judul": "Contoh Mencari Nilai Variabel",
              "konten": [
                { "tipe": "paragraph", "text": "Jika $\\begin{pmatrix} 2x \\\\ 7 \\end{pmatrix} = \\begin{pmatrix} 10 \\\\ y + 2 \\end{pmatrix}$, maka $2x = 10 \\Rightarrow x = 5$ dan $y + 2 = 7 \\Rightarrow y = 5$." }
