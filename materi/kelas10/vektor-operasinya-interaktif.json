              "jawaban": 0,
              "pembahasan": "$2\\vec{p} = 2 \\cdot \\begin{pmatrix} -2 \\\\ 3 \\end{pmatrix} = \\begin{pmatrix} -4 \\\\ 6 \\end{pmatrix}$."
