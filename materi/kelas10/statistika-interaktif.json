    {
      "id": "10-sta-bab-03",
      "nomor": 3,
      "judul": "Ukuran Pemusatan Data",
      "deskripsi": "Mean, median, dan modus",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Ukuran Pemusatan?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Ukuran pemusatan</b> adalah nilai tunggal yang mewakili keseluruhan data. Ada tiga yang paling sering dipakai: <b>mean</b> (rata-rata), <b>median</b> (nilai tengah), dan <b>modus</b> (nilai tersering)."
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b03-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ada berapa ukuran pemusatan data utama?",
              "pilihan": ["1", "2", "3", "4"],
              "jawaban": 2,
              "pembahasan": "Tiga: <b>mean, median, modus</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Mean (Rata-Rata)",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\bar{x} = \\dfrac{x_1 + x_2 + \\cdots + x_n}{n} = \\dfrac{\\sum x_i}{n}"
            },
            {
              "tipe": "paragraph",
              "text": "$\\bar{x}$ dibaca \"x bar\", $\\sum x_i$ = jumlah semua data, $n$ = banyak data."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Mean Nilai",
              "konten": [
                { "tipe": "paragraph", "text": "Data: 7, 8, 6, 9, 10. Hitung mean-nya." },
                { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{7+8+6+9+10}{5} = \\dfrac{40}{5} = 8" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b03-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Mean dari data 4, 6, 8, 10, 12 = ... (tulis angka saja)",
              "jawaban": "8",
              "pembahasan": "$\\bar{x} = 40/5 = 8$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Median (Nilai Tengah)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Median adalah nilai yang berada <b>di tengah</b> setelah data <b>diurutkan</b>."
            },
            {
              "tipe": "list",
              "ordered": true,
              "items": [
                "Urutkan data dari kecil ke besar",
                "Kalau $n$ <b>ganjil</b>: median = data ke-$\\dfrac{n+1}{2}$",
                "Kalau $n$ <b>genap</b>: median = rata-rata data ke-$\\dfrac{n}{2}$ dan ke-$\\dfrac{n}{2} + 1$"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh: Median Genap",
              "konten": [
                { "tipe": "paragraph", "text": "Data: 6, 7, 7, 7, 7, 8, 8, 8, 9, 10 ($n = 10$, genap)." },
                { "tipe": "formula_block", "latex": "M_e = \\dfrac{7 + 8}{2} = 7{,}5" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b03-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Median data 2, 4, 6, 8, 10 = ... (tulis angka saja)",
              "jawaban": "6",
              "pembahasan": "$n = 5$ (ganjil), median = data ke-3 = 6."
            },
            {
              "id": "10-sta-b03-s3-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "Median data 3, 5, 7, 9 = ... (tulis angka saja)",
              "jawaban": "6",
              "pembahasan": "$n = 4$ (genap), median = $(5 + 7) / 2 = 6$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Modus (Nilai Tersering)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Modus adalah nilai yang <b>paling sering muncul</b>. Data bisa punya <b>satu modus</b>, <b>dua modus</b> (bimodal), atau <b>tidak punya modus</b>."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Modus",
              "konten": [
                { "tipe": "paragraph", "text": "Data: 7, 8, 6, 9, 7, 8, 7, 10, 8, 7." },
                { "tipe": "paragraph", "text": "Nilai 7 muncul 4 kali, 8 muncul 3 kali. Jadi modus = <b>7</b>." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b03-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Modus dari data 1, 2, 2, 3, 3, 3, 4, 5 = ... (tulis angka saja)",
              "jawaban": "3",
              "pembahasan": "Nilai 3 muncul 3 kali → paling sering → modus = 3."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Kapan Pakai Mean, Median, atau Modus?",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Mean</b> — paling umum, tapi <b>terpengaruh outlier</b> (nilai ekstrem)",
                "<b>Median</b> — lebih <b>tahan outlier</b>",
                "<b>Modus</b> — untuk data <b>kategorik</b> (warna, ukuran sepatu)"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Contoh: untuk gaji pegawai di perusahaan, lebih baik pakai <b>median</b> daripada mean — karena gaji direktur bisa jadi outlier yang membuat mean terlihat tinggi."
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b03-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ukuran pemusatan yang paling tahan terhadap outlier adalah...",
              "pilihan": ["Mean", "Median", "Modus", "Jangkauan"],
              "jawaban": 1,
              "pembahasan": "<b>Median</b> tidak terpengaruh nilai ekstrem karena hanya melihat posisi tengah."
