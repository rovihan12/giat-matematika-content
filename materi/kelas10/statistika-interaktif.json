    {
      "id": "10-sta-bab-04",
      "nomor": 4,
      "judul": "Ukuran Penyebaran Data",
      "deskripsi": "Jangkauan, kuartil, dan simpangan",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Mengapa Perlu Ukuran Penyebaran?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Dua kelompok data bisa punya <b>mean yang sama</b>, tapi <b>sebarannya berbeda</b>."
            },
            {
              "tipe": "paragraph",
              "text": "Contoh: {50, 50, 50} dan {10, 50, 90} sama-sama mean = 50, tapi yang pertama sangat merata, yang kedua sangat menyebar."
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b04-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ukuran penyebaran digunakan untuk mengukur...",
              "pilihan": [
                "Nilai tengah data",
                "Seberapa menyebar data",
                "Nilai tersering",
                "Jumlah data"
              ],
              "jawaban": 1,
              "pembahasan": "Ukuran penyebaran = seberapa <b>menyebar</b> data."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Jangkauan dan Kuartil",
          "konten": [
            {
              "tipe": "heading",
              "level": 3,
              "text": "Jangkauan"
            },
            {
              "tipe": "formula_block",
              "latex": "R = x_{\\text{maks}} - x_{\\text{min}}"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "Kuartil"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$Q_1$ — kuartil bawah (25%)",
                "$Q_2$ — kuartil tengah (= median)",
                "$Q_3$ — kuartil atas (75%)"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh: Kuartil",
              "konten": [
                { "tipe": "paragraph", "text": "Data: 4, 5, 6, 6, 7, 8, 8, 9, 10." },
                { "tipe": "paragraph", "text": "$Q_2$ = median = 7." },
                { "tipe": "paragraph", "text": "Data bawah (4, 5, 6, 6): $Q_1 = (5 + 6)/2 = 5{,}5$." },
                { "tipe": "paragraph", "text": "Data atas (8, 8, 9, 10): $Q_3 = (8 + 9)/2 = 8{,}5$." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b04-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Data: 3, 5, 7, 9, 11. Jangkauan = ... (tulis angka saja)",
              "jawaban": "8",
              "pembahasan": "$R = 11 - 3 = 8$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Jangkauan Interkuartil (JIK)",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\text{JIK} = Q_3 - Q_1"
            },
            {
              "tipe": "formula_block",
              "latex": "\\text{JSK} = \\dfrac{Q_3 - Q_1}{2}"
            },
            {
              "tipe": "paragraph",
              "text": "JIK dipakai untuk mendeteksi <b>outlier</b>: data yang nilainya < $Q_1 - 1{,}5 \\cdot \\text{JIK}$ atau > $Q_3 + 1{,}5 \\cdot \\text{JIK}$."
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b04-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Jika $Q_1 = 5$ dan $Q_3 = 12$, maka JIK = ... (tulis angka saja)",
              "jawaban": "7",
              "pembahasan": "JIK = $Q_3 - Q_1 = 12 - 5 = 7$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Simpangan Rata-Rata & Ragam",
          "konten": [
            {
              "tipe": "heading",
              "level": 3,
              "text": "Simpangan Rata-Rata"
            },
            {
              "tipe": "formula_block",
              "latex": "SR = \\dfrac{\\sum |x_i - \\bar{x}|}{n}"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "Ragam (Varians)"
            },
            {
              "tipe": "formula_block",
              "latex": "S^2 = \\dfrac{\\sum (x_i - \\bar{x})^2}{n}"
            },
            {
              "tipe": "paragraph",
              "text": "Ragam selalu ≥ 0. Semakin besar, semakin menyebar."
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b04-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ragam (varians) bisa bernilai...",
              "pilihan": ["Selalu positif", "Selalu negatif", "Bisa positif atau negatif", "Selalu nol"],
              "jawaban": 0,
              "pembahasan": "Ragam = rata-rata kuadrat selisih → selalu ≥ 0, jadi <b>selalu positif</b>."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Simpangan Baku",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "S = \\sqrt{S^2}"
            },
            {
              "tipe": "paragraph",
              "text": "Simpangan baku (S) punya satuan yang sama dengan data. Kalau data dalam cm, maka $S$ juga dalam cm. Semakin besar $S$, semakin menyebar data."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Simpangan Baku",
              "konten": [
                { "tipe": "paragraph", "text": "Data: 2, 4, 4, 4, 5, 5, 7, 9." },
                { "tipe": "paragraph", "text": "Mean $\\bar{x} = 5$." },
                { "tipe": "paragraph", "text": "Kuadrat selisih: 9 + 1 + 1 + 1 + 0 + 0 + 4 + 16 = 32." },
                { "tipe": "formula_block", "latex": "S^2 = 32/8 = 4 \\Rightarrow S = 2" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "10-sta-b04-s5-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Jika ragam $S^2 = 25$, maka simpangan baku $S$ = ... (tulis angka saja)",
              "jawaban": "5",
              "pembahasan": "$S = \\sqrt{25} = 5$."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 4",
          "konten": [],
          "latihan": [
            {
              "id": "10-sta-b04-s6-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Data: 2, 4, 6, 8, 10. Jangkauan = ... (tulis angka saja)",
              "jawaban": "8",
              "pembahasan": "$R = 10 - 2 = 8$."
            },
            {
              "id": "10-sta-b04-s6-q2",
              "tipe": "pilihan",
              "pertanyaan": "Ukuran yang satuannya SAMA dengan data aslinya adalah...",
              "pilihan": ["Ragam", "Simpangan baku", "JIK", "Frekuensi"],
              "jawaban": 1,
              "pembahasan": "Ragam satuannya kuadrat, sedangkan <b>simpangan baku</b> satuannya sama dengan data."
