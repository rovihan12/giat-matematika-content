      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Statistika?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Statistika</b> adalah ilmu yang mempelajari cara <b>mengumpulkan</b>, <b>mengolah</b>, <b>menyajikan</b>, dan <b>menganalisis</b> data untuk mengambil kesimpulan."
            },
            {
              "tipe": "paragraph",
              "text": "Kata \"statistika\" berasal dari bahasa Latin <i>status</i> yang berarti \"negara\" — karena dulu statistika dipakai negara untuk menghitung penduduk dan pajak."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Datum</b> — satu buah informasi (tunggal). Contoh: nilai ulangan Andi = 85",
                "<b>Data</b> — kumpulan datum (jamak). Contoh: 85, 90, 78, 92, 88"
              ]
