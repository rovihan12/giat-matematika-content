    {
      "id": "11-sta-bab-01",
      "nomor": 1,
      "judul": "Distribusi Data dan Histogram",
      "deskripsi": "Menyajikan dan menginterpretasi distribusi data",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Dari Data Tunggal ke Distribusi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Di Kelas 10, kamu belajar menghitung mean, median, modus dari data tunggal. Sekarang kita naik level: memahami <b>bagaimana data tersebar</b> — bukan hanya nilai tengahnya."
            },
            {
              "tipe": "paragraph",
              "text": "Dua kelompok data bisa punya mean sama tapi <b>bentuk distribusinya berbeda</b>. Ada yang simetris, ada yang menceng ke kiri atau ke kanan."
            },
            {
              "tipe": "image",
              "src": "images/kelas11/statistika-lanjutan/bentuk-distribusi.png",
              "caption": "Tiga bentuk distribusi: simetris (kiri), menceng kanan (tengah), dan menceng kiri (kanan)",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Dua kelompok data bisa punya mean sama tapi berbeda pada...",
              "pilihan": ["Jumlah data", "Bentuk distribusinya", "Satuan", "Nama variabel"],
              "jawaban": 1,
              "pembahasan": "Mean sama, tapi bisa berbeda <b>bentuk distribusi</b>-nya."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Bentuk-Bentuk Distribusi",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Simetris</b> — data seimbang di kiri dan kanan. Contoh: distribusi normal",
                "<b>Menceng kanan (positif)</b> — ekor panjang di kanan. Contoh: distribusi penghasilan",
                "<b>Menceng kiri (negatif)</b> — ekor panjang di kiri. Contoh: nilai ujian yang sangat mudah"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Posisi mean, median, modus bergeser sesuai bentuk distribusi:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "Distribusi <b>simetris</b>: Mean = Median = Modus",
                "Distribusi <b>menceng kanan</b>: Modus < Median < Mean",
                "Distribusi <b>menceng kiri</b>: Mean < Median < Modus"
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b01-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Distribusi penghasilan penduduk (banyak yang rendah, sedikit yang sangat tinggi) termasuk...",
              "pilihan": ["Simetris", "Menceng kanan", "Menceng kiri", "Tidak beraturan"],
              "jawaban": 1,
              "pembahasan": "Ekor panjang ke kanan (nilai sangat tinggi) → <b>menceng kanan</b>."
            },
            {
              "id": "11-sta-b01-s2-q2",
              "tipe": "benar_salah",
              "pertanyaan": "Pada distribusi simetris, mean = median = modus.",
              "jawaban": true,
              "pembahasan": "Benar — ketiganya bertemu di titik yang sama. <b>BENAR</b>."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Histogram dan Poligon Frekuensi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Histogram</b> adalah diagram batang untuk data berkelompok di mana batangnya <b>saling menempel</b> (tidak ada jarak). Ini membedakannya dari diagram batang biasa."
            },
            {
              "tipe": "paragraph",
              "text": "Kalau titik tengah setiap batang histogram dihubungkan dengan garis, kita dapat <b>poligon frekuensi</b> — yang menunjukkan bentuk distribusi lebih jelas."
            },
            {
              "tipe": "image",
              "src": "images/kelas11/statistika-lanjutan/histogram-poligon.png",
              "caption": "Histogram dengan poligon frekuensi",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b01-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Perbedaan histogram dengan diagram batang biasa adalah...",
              "pilihan": [
                "Histogram batangnya menempel",
                "Histogram tanpa sumbu",
                "Diagram batang lebih besar",
                "Tidak ada bedanya"
              ],
              "jawaban": 0,
              "pembahasan": "Histogram = batang <b>menempel</b> (data kontinu)."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Ogif (Ogive)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Ogif</b> adalah grafik yang menunjukkan <b>frekuensi kumulatif</b>. Ada dua jenis:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Ogif positif</b> — frekuensi kumulatif kurang dari. Naik dari kiri ke kanan",
                "<b>Ogif negatif</b> — frekuensi kumulatif lebih dari. Turun dari kiri ke kanan"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Ogif berguna untuk menentukan <b>median</b> dan <b>kuartil</b> secara grafis."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Membaca Distribusi",
              "konten": [
                { "tipe": "paragraph", "text": "Kelas A distribusinya simetris, Kelas B menceng kanan. Mean keduanya sama (75)." },
                { "tipe": "paragraph", "text": "Kelas B (menceng kanan): sebagian besar siswa nilainya <b>di bawah</b> 75, tapi ada beberapa yang sangat tinggi yang menarik mean ke atas. Jadi lebih mungkin ada siswa dengan nilai rendah." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b01-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ogif positif menunjukkan frekuensi kumulatif...",
              "pilihan": ["Kurang dari", "Lebih dari", "Sama dengan", "Tidak tentu"],
              "jawaban": 0,
              "pembahasan": "Ogif positif = frekuensi kumulatif <b>kurang dari</b>."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 1",
          "konten": [],
          "latihan": [
            {
              "id": "11-sta-b01-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Pada distribusi menceng kanan, urutan yang benar dari kiri ke kanan adalah...",
              "pilihan": [
                "Mean < Median < Modus",
                "Modus < Median < Mean",
                "Median < Modus < Mean",
                "Semua sama"
              ],
              "jawaban": 1,
              "pembahasan": "Menceng kanan: <b>Modus < Median < Mean</b> (mean tertarik ke ekor kanan)."
            },
            {
              "id": "11-sta-b01-s5-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "Grafik frekuensi kumulatif disebut ... (tulis 1 kata)",
              "jawaban": "ogif",
              "pembahasan": "Grafik frekuensi kumulatif = <b>ogif</b>."
            },
            {
              "id": "11-sta-b01-s5-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Pada distribusi menceng kiri, modus paling kecil.",
              "jawaban": false,
              "pembahasan": "<b>SALAH</b>. Menceng kiri: Mean < Median < Modus, jadi modus paling <b>besar</b>."
            }
          ]
        }
      ]
    },
    {
      "id": "11-sta-bab-02",
      "nomor": 2,
      "judul": "Ukuran Pemusatan dan Penyebaran Data Berkelompok",
      "deskripsi": "Mean, median, modus, dan simpangan untuk data berkelompok",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Data Berkelompok",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Ketika data sangat banyak, biasanya disajikan dalam <b>tabel distribusi frekuensi</b> dengan kelas interval. Kita tidak lagi tahu nilai persis setiap data — hanya tahu berapa banyak data di setiap interval."
            },
            {
              "tipe": "paragraph",
              "text": "Untuk data seperti ini, kita pakai <b>titik tengah kelas</b> sebagai perwakilan nilai."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$f_i$ = frekuensi kelas ke-$i$",
                "$x_i$ = titik tengah kelas ke-$i$",
                "$n = \\sum f_i$ = jumlah total data"
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b02-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Nilai perwakilan kelas interval dalam data berkelompok adalah...",
              "pilihan": ["Batas bawah", "Batas atas", "Titik tengah", "Frekuensi"],
              "jawaban": 2,
              "pembahasan": "Nilai perwakilan = <b>titik tengah</b> = rata-rata batas bawah & atas."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Mean Data Berkelompok",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\bar{x} = \\dfrac{\\sum f_i \\cdot x_i}{\\sum f_i}"
            },
            {
              "tipe": "paragraph",
              "text": "Kalikan frekuensi dengan titik tengah, jumlahkan, lalu bagi dengan total frekuensi."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tabel: 60–69 (f=4, xt=64,5), 70–79 (f=8, xt=74,5), 80–89 (f=12, xt=84,5), 90–99 (f=6, xt=94,5)." },
                { "tipe": "formula_block", "latex": "\\bar{x} = \\dfrac{(4)(64{,}5) + (8)(74{,}5) + (12)(84{,}5) + (6)(94{,}5)}{30}" },
                { "tipe": "formula_block", "latex": "= \\dfrac{2435}{30} \\approx 81{,}17" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b02-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\sum f_i x_i = 1000$ dan $\\sum f_i = 20$. Mean = ... (tulis angka saja)",
              "jawaban": "50",
              "pembahasan": "$\\bar{x} = 1000/20 = 50$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Median Data Berkelompok",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "M_e = L + \\left(\\dfrac{\\frac{n}{2} - F}{f}\\right) \\cdot c"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$L$ = tepi bawah kelas median",
                "$n$ = jumlah data",
                "$F$ = frekuensi kumulatif sebelum kelas median",
                "$f$ = frekuensi kelas median",
                "$c$ = panjang kelas"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Kelas median = kelas yang memuat data ke-$\\dfrac{n}{2}$."
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b02-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Kelas median adalah kelas yang memuat data ke...",
              "pilihan": ["$n$", "$n/2$", "$n/4$", "$2n$"],
              "jawaban": 1,
              "pembahasan": "Kelas median memuat data ke-$n/2$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Modus Data Berkelompok",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "M_o = L + \\left(\\dfrac{d_1}{d_1 + d_2}\\right) \\cdot c"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$L$ = tepi bawah kelas modus",
                "$d_1$ = selisih frekuensi kelas modus dengan kelas sebelumnya",
                "$d_2$ = selisih frekuensi kelas modus dengan kelas sesudahnya",
                "$c$ = panjang kelas"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Kelas modus = kelas dengan frekuensi terbesar."
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b02-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "Kelas modus adalah kelas dengan...",
              "pilihan": ["Frekuensi terkecil", "Frekuensi terbesar", "Titik tengah di tengah", "Nilai tertinggi"],
              "jawaban": 1,
              "pembahasan": "Kelas modus = kelas dengan frekuensi <b>terbesar</b>."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Simpangan Baku Data Berkelompok",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "S^2 = \\dfrac{\\sum f_i (x_i - \\bar{x})^2}{\\sum f_i}"
            },
            {
              "tipe": "formula_block",
              "latex": "S = \\sqrt{S^2}"
            },
            {
              "tipe": "paragraph",
              "text": "Simpangan baku menunjukkan seberapa menyebar data dari mean. Semakin besar $S$, semakin menyebar."
            },
            {
              "tipe": "example",
              "judul": "Contoh Interpretasi",
              "konten": [
                { "tipe": "paragraph", "text": "Kelas A: mean 75, S = 3. Kelas B: mean 75, S = 12." },
                { "tipe": "paragraph", "text": "Kelas A lebih konsisten (S kecil). Kelas B nilainya lebih beragam — mungkin ada yang sangat tinggi & sangat rendah." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b02-s5-q1",
              "tipe": "benar_salah",
              "pertanyaan": "Semakin besar simpangan baku, semakin konsisten data.",
              "jawaban": false,
              "pembahasan": "<b>SALAH</b>. Semakin besar S, semakin <b>menyebar</b> (kurang konsisten)."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 2",
          "konten": [],
          "latihan": [
            {
              "id": "11-sta-b02-s6-q1",
              "tipe": "pilihan",
              "pertanyaan": "Rumus mean data berkelompok adalah...",
              "pilihan": ["$\\dfrac{\\sum x_i}{n}$", "$\\dfrac{\\sum f_i x_i}{\\sum f_i}$", "$\\dfrac{\\sum f_i}{\\sum x_i}$", "$\\sum f_i x_i$"],
              "jawaban": 1,
              "pembahasan": "$\\bar{x} = \\dfrac{\\sum f_i x_i}{\\sum f_i}$."
            },
            {
              "id": "11-sta-b02-s6-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "Median data berkelompok rumusnya $M_e = L + ((n/2 - F)/... ) \\cdot c$. Tulis 1 huruf pembagi.",
              "jawaban": "f",
              "pembahasan": "Pembagi = frekuensi kelas median = $f$."
            },
            {
              "id": "11-sta-b02-s6-q3",
              "tipe": "pilihan",
              "pertanyaan": "$d_1$ dan $d_2$ pada rumus modus adalah...",
              "pilihan": [
                "Selisih frekuensi dengan kelas sebelum & sesudah",
                "Titik tengah kelas",
                "Batas kelas",
                "Panjang kelas"
              ],
              "jawaban": 0,
              "pembahasan": "$d_1, d_2$ = selisih frekuensi kelas modus dengan kelas sebelum/sesudahnya."
            }
          ]
        }
      ]
    },
    {
      "id": "11-sta-bab-03",
      "nomor": 3,
      "judul": "Data Bivariat dan Diagram Pencar",
      "deskripsi": "Hubungan antara dua variabel",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Data Bivariat?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Selama ini kita membahas <b>data univariat</b> — satu variabel saja. Sekarang kita masuk ke <b>data bivariat</b> — dua variabel yang diamati <b>bersamaan</b> pada objek yang sama."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "Tinggi badan & berat badan siswa",
                "Jam belajar & nilai ujian",
                "Harga rumah & luas tanah",
                "Suhu udara & penjualan es krim"
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b03-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Data bivariat adalah data dengan...",
              "pilihan": ["Satu variabel", "Dua variabel", "Tiga variabel", "Tidak tentu"],
              "jawaban": 1,
              "pembahasan": "Bivariat = <b>dua</b> variabel."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Diagram Pencar (Scatter Plot)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Cara paling mudah untuk melihat hubungan dua variabel adalah dengan <b>diagram pencar</b>. Setiap titik mewakili satu objek dengan koordinat (x, y)."
            },
            {
              "tipe": "image",
              "src": "images/kelas11/statistika-lanjutan/scatter-plot.png",
              "caption": "Contoh diagram pencar: hubungan jam belajar (x) dan nilai ujian (y)",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b03-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Pada diagram pencar, setiap titik mewakili...",
              "pilihan": ["Satu variabel", "Satu objek dengan koordinat (x, y)", "Semua data", "Mean data"],
              "jawaban": 1,
              "pembahasan": "Setiap titik = <b>satu objek</b> dengan koordinat (x, y)."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Jenis-Jenis Pola pada Diagram Pencar",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Korelasi positif</b> — x naik, y naik. Titik mengarah ke kanan atas",
                "<b>Korelasi negatif</b> — x naik, y turun. Titik mengarah ke kanan bawah",
                "<b>Tidak ada korelasi</b> — titik tersebar acak tanpa pola"
              ]
            },
            {
              "tipe": "image",
              "src": "images/kelas11/statistika-lanjutan/jenis-korelasi.png",
              "caption": "Tiga jenis korelasi: positif, negatif, tidak ada",
              "width": "full"
            },
            {
              "tipe": "paragraph",
              "text": "Kekuatan korelasi: <b>kuat</b> (titik rapat), <b>sedang</b>, <b>lemah</b> (titik tersebar)."
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b03-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Suhu udara naik, penjualan es krim naik. Ini contoh korelasi...",
              "pilihan": ["Positif", "Negatif", "Tidak ada", "Acak"],
              "jawaban": 0,
              "pembahasan": "Keduanya naik bersamaan → <b>positif</b>."
            },
            {
              "id": "11-sta-b03-s3-q2",
              "tipe": "pilihan",
              "pertanyaan": "Korelasi dikatakan KUAT jika titik-titik...",
              "pilihan": ["Tersebar acak", "Rapat mengikuti pola", "Membentuk lingkaran", "Berada di satu titik"],
              "jawaban": 1,
              "pembahasan": "Korelasi kuat = titik <b>rapat</b> mengikuti pola."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Korelasi ≠ Kausalitas",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "⚠️ <b>Penting:</b> dua variabel yang berkorelasi <b>belum tentu</b> punya hubungan sebab-akibat."
            },
            {
              "tipe": "paragraph",
              "text": "Contoh klasik: penjualan es krim dan jumlah orang tenggelam berkorelasi positif. Apakah es krim menyebabkan orang tenggelam? Tentu tidak. Penyebab sebenarnya: <b>musim panas</b>."
            },
            {
              "tipe": "paragraph",
              "text": "Variabel ketiga yang tidak diukur tapi mempengaruhi keduanya disebut <b>variabel perancu (confounding variable)</b>."
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b03-s4-q1",
              "tipe": "benar_salah",
              "pertanyaan": "Kalau dua variabel berkorelasi, pasti satu menyebabkan yang lain.",
              "jawaban": false,
              "pembahasan": "<b>SALAH</b>. Korelasi ≠ kausalitas. Bisa jadi ada variabel perancu."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 3",
          "konten": [],
          "latihan": [
            {
              "id": "11-sta-b03-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Korelasi negatif berarti...",
              "pilihan": [
                "x naik, y naik",
                "x naik, y turun",
                "Tidak ada hubungan",
                "Semua sama"
              ],
              "jawaban": 1,
