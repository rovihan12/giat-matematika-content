    {
      "id": "11-sta-bab-04",
      "nomor": 4,
      "judul": "Regresi Linear",
      "deskripsi": "Menemukan model linear terbaik dari data bivariat",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Dari Diagram Pencar ke Garis Regresi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Kalau diagram pencar menunjukkan pola linear, kita bisa menggambar <b>garis lurus</b> yang mewakili tren data. Garis ini disebut <b>garis regresi linear</b> atau <b>garis best-fit</b>."
            },
            {
              "tipe": "image",
              "src": "images/kelas11/statistika-lanjutan/garis-regresi.png",
              "caption": "Diagram pencar dengan garis regresi linear",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b04-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Garis yang mewakili tren data dalam diagram pencar disebut...",
              "pilihan": ["Garis singgung", "Garis regresi", "Garis normal", "Garis tengah"],
              "jawaban": 1,
              "pembahasan": "Garis tren = <b>garis regresi</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Persamaan Garis Regresi",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\hat{y} = a + bx"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$\\hat{y}$ = nilai prediksi",
                "$a$ = intersep (nilai y saat x = 0)",
                "$b$ = kemiringan (slope) — perubahan y untuk kenaikan 1 satuan x"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Interpretasi slope:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$b > 0$ → korelasi <b>positif</b>",
                "$b < 0$ → korelasi <b>negatif</b>",
                "$b = 0$ → <b>tidak ada</b> hubungan linear"
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b04-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Pada $\\hat{y} = a + bx$, nilai $b$ menunjukkan...",
              "pilihan": [
                "Nilai y saat x = 0",
                "Kemiringan garis",
                "Nilai prediksi",
                "Jumlah data"
              ],
              "jawaban": 1,
              "pembahasan": "$b$ = <b>kemiringan</b> (slope)."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Rumus Mencari a dan b",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "b = \\dfrac{n \\sum x_i y_i - \\sum x_i \\sum y_i}{n \\sum x_i^2 - (\\sum x_i)^2}"
            },
            {
              "tipe": "formula_block",
              "latex": "a = \\bar{y} - b \\bar{x}"
            },
            {
              "tipe": "paragraph",
              "text": "dengan $n$ = banyak data, $\\bar{x}$ = rata-rata x, $\\bar{y}$ = rata-rata y."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Data 5 siswa: (2,60), (4,70), (6,75), (8,85), (10,90)." },
                { "tipe": "list", "ordered": false, "items": [
                  "$\\sum x = 30$, $\\sum y = 380$, $n = 5$",
                  "$\\sum xy = 2400$, $\\sum x^2 = 220$"
                ]},
                { "tipe": "formula_block", "latex": "b = \\dfrac{5(2400) - 30(380)}{5(220) - 30^2} = \\dfrac{600}{200} = 3" },
                { "tipe": "formula_block", "latex": "a = 76 - 3(6) = 58" },
                { "tipe": "formula_block", "latex": "\\hat{y} = 58 + 3x" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b04-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Jika $\\bar{y} = 50$, $\\bar{x} = 10$, $b = 2$, maka $a$ = ... (tulis angka saja)",
              "jawaban": "30",
              "pembahasan": "$a = \\bar{y} - b\\bar{x} = 50 - 2(10) = 30$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Menggunakan Garis Regresi untuk Prediksi",
          "konten": [
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Dari $\\hat{y} = 58 + 3x$, prediksi nilai jika siswa belajar 7 jam?" },
                { "tipe": "formula_block", "latex": "\\hat{y} = 58 + 3(7) = 79" },
                { "tipe": "paragraph", "text": "Jadi prediksi nilainya <b>79</b>." }
              ]
            },
            {
              "tipe": "paragraph",
              "text": "⚠️ <b>Hati-hati ekstrapolasi</b> — memprediksi di luar rentang data asli bisa tidak akurat. Kalau data x dari 2–10, memprediksi x = 20 mungkin tidak valid."
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b04-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Jika $\\hat{y} = 20 + 5x$, prediksi $y$ saat $x = 4$ = ... (tulis angka saja)",
              "jawaban": "40",
              "pembahasan": "$\\hat{y} = 20 + 5(4) = 40$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Koefisien Determinasi (r²)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Seberapa baik garis regresi mewakili data? Kita ukur dengan <b>koefisien determinasi</b> ($r^2$)."
            },
            {
              "tipe": "formula_block",
              "latex": "r^2 = \\dfrac{\\text{SSR}}{\\text{SST}}"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$r^2$ mendekati <b>1</b> → garis regresi sangat baik",
                "$r^2$ mendekati <b>0</b> → garis regresi kurang baik"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Contoh: $r^2 = 0{,}85$ artinya <b>85%</b> variasi nilai y bisa dijelaskan oleh x. Sisanya 15% faktor lain."
            }
          ],
          "latihan": [
            {
              "id": "11-sta-b04-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Jika $r^2 = 0{,}9$, artinya...",
              "pilihan": [
                "90% variasi y dijelaskan oleh x",
                "10% variasi y dijelaskan oleh x",
                "Korelasi negatif",
                "Tidak ada hubungan"
              ],
              "jawaban": 0,
              "pembahasan": "$r^2 = 0{,}9$ = 90% variasi y bisa dijelaskan x."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 4",
          "konten": [],
          "latihan": [
            {
              "id": "11-sta-b04-s6-q1",
              "tipe": "pilihan",
              "pertanyaan": "Persamaan garis regresi adalah...",
              "pilihan": ["$y = ax^2 + bx$", "$\\hat{y} = a + bx$", "$y = a^x$", "$y = \\sin x$"],
              "jawaban": 1,
              "pembahasan": "Garis regresi = $\\hat{y} = a + bx$."
            },
            {
              "id": "11-sta-b04-s6-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "Jika $\\hat{y} = 10 + 2x$, prediksi saat $x = 5$ = ... (tulis angka saja)",
              "jawaban": "20",
              "pembahasan": "$\\hat{y} = 10 + 2(5) = 20$."
            },
            {
              "id": "11-sta-b04-s6-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Regresi linear membuktikan hubungan sebab-akibat.",
              "jawaban": false,
              "pembahasan": "<b>SALAH</b>. Regresi hanya menunjukkan korelasi, bukan kausalitas."
            }
          ]
        }
      ]
    },
