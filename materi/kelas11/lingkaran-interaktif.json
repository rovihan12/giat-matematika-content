              "tipe": "benar_salah",
              "pertanyaan": "Titik yang berada di dalam lingkaran memenuhi $x^2 + y^2 < r^2$.",
              "jawaban": true,
              "pembahasan": "Benar — di dalam lingkaran, jarak ke pusat < r. <b>BENAR</b>."
