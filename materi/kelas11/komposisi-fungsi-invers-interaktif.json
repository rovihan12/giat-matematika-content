    {
      "id": "11-kfi-bab-01",
      "nomor": 1,
      "judul": "Fungsi dan Bukan Fungsi",
      "deskripsi": "Memahami definisi fungsi, domain, kodomain, dan range",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Fungsi?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Fungsi</b> adalah relasi khusus yang memetakan <b>setiap</b> anggota domain ke <b>tepat satu</b> anggota kodomain. Bayangkan fungsi seperti mesin: masukkan satu input, keluar satu output."
            },
            {
              "tipe": "paragraph",
              "text": "Kalau ada satu input yang punya dua output, itu <b>bukan fungsi</b>. Tapi kalau dua input berbeda punya output yang sama, itu masih fungsi."
            },
            {
              "tipe": "image",
              "src": "images/kelas11/komposisi-fungsi-invers/diagram-panah-fungsi.png",
              "caption": "Diagram panah fungsi f: A → B. Domain = {1, 2, 3}, Kodomain = {a, b, c, d}, Range = {a, b, c}",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "11-kfi-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Setiap anggota domain harus punya berapa pasangan di kodomain agar disebut fungsi?",
              "pilihan": ["Tepat satu", "Minimal dua", "Tepat dua", "Tidak tentu"],
              "jawaban": 0,
              "pembahasan": "Fungsi = setiap domain punya <b>tepat satu</b> output."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Istilah Penting: Domain, Kodomain, Range",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Domain</b> — daerah asal (input). Contoh: himpunan A",
                "<b>Kodomain</b> — daerah kawan (output potensial). Contoh: himpunan B",
                "<b>Range</b> — daerah hasil (output aktual). Subset dari kodomain"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Fungsi $f: A \\to B$ dengan $A = \\{1, 2, 3\\}$ dan $B = \\{a, b, c, d\\}$." },
                { "tipe": "list", "ordered": false, "items": [
                  "Domain = $\\{1, 2, 3\\}$",
                  "Kodomain = $\\{a, b, c, d\\}$",
                  "Range = $\\{a, b, c\\}$ (subset dari kodomain)"
                ]}
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-kfi-b01-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Daerah asal (input) dari fungsi disebut...",
              "pilihan": ["Domain", "Kodomain", "Range", "Fungsi"],
              "jawaban": 0,
              "pembahasan": "Domain = daerah asal / input."
            },
            {
              "id": "11-kfi-b01-s2-q2",
              "tipe": "pilihan",
              "pertanyaan": "Range selalu merupakan...",
              "pilihan": [
                "Himpunan yang sama dengan kodomain",
                "Subset dari kodomain",
                "Superset dari domain",
                "Himpunan kosong"
              ],
              "jawaban": 1,
              "pembahasan": "Range = output aktual = <b>subset</b> dari kodomain (mungkin tidak semua kodomain terpakai)."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Cara Membedakan Fungsi vs Bukan Fungsi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Untuk menentukan apakah suatu relasi adalah fungsi, perhatikan <b>panah keluar dari domain</b>:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Fungsi</b> — setiap anggota domain punya <b>tepat satu</b> panah keluar",
                "<b>Bukan fungsi</b> — ada anggota domain yang punya <b>lebih dari satu</b> panah keluar, atau tidak punya panah"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh: Fungsi atau Bukan?",
              "konten": [
                { "tipe": "paragraph", "text": "Relasi dari $A = \\{1, 2, 3\\}$ ke $B = \\{a, b, c\\}$:" },
                { "tipe": "list", "ordered": false, "items": [
                  "Relasi 1: (1,a), (2,b), (3,c) → <b>Fungsi</b> ✓",
                  "Relasi 2: (1,a), (1,b), (2,c) → <b>Bukan fungsi</b> ✗ (1 punya dua output)",
                  "Relasi 3: (1,a), (2,a), (3,a) → <b>Fungsi</b> ✓ (dua input boleh punya output sama)"
                ]}
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-kfi-b01-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Relasi (1,a), (1,b), (2,c) adalah...",
              "pilihan": ["Fungsi", "Bukan fungsi", "Fungsi injektif", "Fungsi surjektif"],
              "jawaban": 1,
              "pembahasan": "Input 1 punya dua output (a dan b) → <b>bukan fungsi</b>."
            },
            {
              "id": "11-kfi-b01-s3-q2",
              "tipe": "benar_salah",
              "pertanyaan": "Relasi di mana dua input berbeda punya output sama masih disebut fungsi.",
              "jawaban": true,
              "pembahasan": "Benar — yang penting setiap input punya TEPAT satu output. Dua input boleh share output sama. <b>BENAR</b>."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Notasi Fungsi",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "f: A \\to B, \\quad x \\mapsto f(x)"
            },
            {
              "tipe": "paragraph",
              "text": "Dibaca: fungsi $f$ memetakan himpunan $A$ ke himpunan $B$, dengan $x$ dipetakan ke $f(x)$."
            },
            {
              "tipe": "list",
