      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Fungsi Invers?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Fungsi invers</b> adalah fungsi yang <b>membalikkan</b> operasi fungsi asal. Jika $f$ memetakan $x$ ke $y$, maka $f^{-1}$ memetakan $y$ kembali ke $x$."
            },
            {
              "tipe": "paragraph",
              "text": "Notasi $f^{-1}$ dibaca \"$f$ invers\". ⚠️ Angka $-1$ di sini <b>bukan pangkat</b>, melainkan simbol invers."
            },
            {
              "tipe": "image",
              "src": "images/kelas11/komposisi-fungsi-invers/fungsi-invers.png",
              "caption": "Diagram panah fungsi invers: f memetakan x ke y, sedangkan f⁻¹ memetakan y kembali ke x",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "11-kfi-b04-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Simbol $f^{-1}$ dibaca...",
              "pilihan": ["f pangkat -1", "f invers", "f pangkat satu per satu", "f bukan fungsi"],
              "jawaban": 1,
              "pembahasan": "$f^{-1}$ = <b>f invers</b>. Simbol $-1$ di sini bukan pangkat."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Syarat Fungsi Memiliki Invers",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Suatu fungsi memiliki invers jika dan hanya jika fungsi tersebut <b>bijektif</b> (injektif sekaligus surjektif)."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Injektif (satu-satu)</b> — setiap anggota kodomain dipetakan paling banyak satu kali",
                "<b>Surjektif (pada)</b> — setiap anggota kodomain punya pasangan di domain",
                "<b>Bijektif</b> — injektif sekaligus surjektif"
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-kfi-b04-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Suatu fungsi memiliki invers jika dan hanya jika fungsi tersebut...",
