    {
      "id": "11-mtl-bab-04",
      "nomor": 4,
      "judul": "Transformasi Geometri",
      "deskripsi": "Translasi, refleksi, rotasi, dan dilatasi",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Transformasi Geometri?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Transformasi geometri</b> adalah perubahan posisi, ukuran, atau orientasi suatu objek di bidang. Ada 4 jenis dasar: <b>translasi</b>, <b>refleksi</b>, <b>rotasi</b>, dan <b>dilatasi</b>."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "➡️ <b>Translasi</b> — geser (posisi berubah)",
                "🪞 <b>Refleksi</b> — cermin (orientasi berubah)",
                "🔄 <b>Rotasi</b> — putar (orientasi berubah)",
                "🔍 <b>Dilatasi</b> — perbesar/kecil (ukuran berubah)"
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-mtl-b04-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ada berapa jenis transformasi geometri dasar?",
              "pilihan": ["2", "3", "4", "5"],
              "jawaban": 2,
              "pembahasan": "4 jenis: <b>translasi, refleksi, rotasi, dilatasi</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "1. Translasi (Pergeseran)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Translasi menggeser titik sejauh vektor tertentu tanpa mengubah bentuk atau ukuran."
            },
            {
              "tipe": "formula_block",
              "latex": "\\begin{pmatrix} x' \\\\ y' \\end{pmatrix} = \\begin{pmatrix} x \\\\ y \\end{pmatrix} + \\begin{pmatrix} a \\\\ b \\end{pmatrix}"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Titik $A(3, 5)$ ditranslasi vektor $(2, -4)$." },
                { "tipe": "formula_block", "latex": "A' = (3 + 2, 5 - 4) = (5, 1)" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-mtl-b04-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Titik $A(2, 3)$ ditranslasi $(4, -1)$. $x'$ = ... (tulis angka saja)",
              "jawaban": "6",
              "pembahasan": "$x' = 2 + 4 = 6$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "2. Refleksi (Pencerminan)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Refleksi mencerminkan titik terhadap garis tertentu. Rumus tergantung sumbu cerminnya."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "Terhadap sumbu X: $(x, y) \\to (x, -y)$",
                "Terhadap sumbu Y: $(x, y) \\to (-x, y)$",
                "Terhadap garis $y = x$: $(x, y) \\to (y, x)$",
                "Terhadap garis $y = -x$: $(x, y) \\to (-y, -x)$",
                "Terhadap titik asal: $(x, y) \\to (-x, -y)$"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Bayangan $B(4, -2)$ dicerminkan terhadap sumbu X." },
                { "tipe": "formula_block", "latex": "B' = (4, 2)" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "11-mtl-b04-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Refleksi $(3, 5)$ terhadap sumbu Y adalah...",
              "pilihan": ["$(-3, 5)$", "$(3, -5)$", "$(-3, -5)$", "$(5, 3)$"],
              "jawaban": 0,
              "pembahasan": "Sumbu Y: $(x, y) \\to (-x, y)$. Jadi $(-3, 5)$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "3. Rotasi (Perputaran)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Rotasi memutar titik terhadap pusat tertentu (biasanya titik asal) sebesar sudut $\\theta$."
            },
            {
              "tipe": "paragraph",
              "text": "Rotasi $90^\\circ$ berlawanan arah jarum jam:"
            },
            {
              "tipe": "formula_block",
              "latex": "\\begin{pmatrix} x' \\\\ y' \\end{pmatrix} = \\begin{pmatrix} 0 & -1 \\\\ 1 & 0 \\end{pmatrix} \\begin{pmatrix} x \\\\ y \\end{pmatrix} = \\begin{pmatrix} -y \\\\ x \\end{pmatrix}"
            },
            {
              "tipe": "paragraph",
              "text": "Rotasi umum $\\theta$ (berlawanan arah jarum jam):"
            },
            {
              "tipe": "formula_block",
              "latex": "\\begin{pmatrix} x' \\\\ y' \\end{pmatrix} = \\begin{pmatrix} \\cos\\theta & -\\sin\\theta \\\\ \\sin\\theta & \\cos\\theta \\end{pmatrix} \\begin{pmatrix} x \\\\ y \\end{pmatrix}"
            }
          ],
          "latihan": [
            {
              "id": "11-mtl-b04-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "Titik $C(2, 3)$ dirotasi $90°$ berlawanan arah jarum jam. Bayangannya...",
              "pilihan": ["$(3, 2)$", "$(-3, 2)$", "$(2, -3)$", "$(-2, -3)$"],
              "jawaban": 1,
              "pembahasan": "Rotasi 90°: $(x, y) \\to (-y, x)$. Jadi $(-3, 2)$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "4. Dilatasi (Perkalian)",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Dilatasi memperbesar atau memperkecil objek terhadap pusat tertentu dengan faktor skala $k$."
            },
            {
              "tipe": "formula_block",
              "latex": "\\begin{pmatrix} x' \\\\ y' \\end{pmatrix} = k \\begin{pmatrix} x \\\\ y \\end{pmatrix} = \\begin{pmatrix} kx \\\\ ky \\end{pmatrix}"
            },
            {
              "tipe": "image",
              "src": "images/kelas11/matematika-tingkat-lanjutan/transformasi-geometri.png",
              "caption": "Empat jenis transformasi geometri",
              "width": "full"
            },
            {
              "tipe": "paragraph",
              "text": "Jika $k > 1$ → diperbesar; jika $0 < k < 1$ → diperkecil; jika $k < 0$ → diperbesar & dibalik arah."
            }
          ],
          "latihan": [
            {
              "id": "11-mtl-b04-s5-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Titik $A(2, 3)$ didilatasi dengan $k = 2$. $x'$ = ... (tulis angka saja)",
              "jawaban": "4",
              "pembahasan": "$x' = kx = 2 \\cdot 2 = 4$."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 4",
          "konten": [],
          "latihan": [
            {
              "id": "11-mtl-b04-s6-q1",
              "tipe": "pilihan",
              "pertanyaan": "Transformasi yang memperbesar objek disebut...",
              "pilihan": ["Translasi", "Refleksi", "Rotasi", "Dilatasi"],
              "jawaban": 3,
              "pembahasan": "Perbesar/perkecil = <b>dilatasi</b>."
            },
            {
              "id": "11-mtl-b04-s6-q2",
              "tipe": "pilihan",
              "pertanyaan": "Refleksi $(2, -3)$ terhadap sumbu X adalah...",
              "pilihan": ["$(2, 3)$", "$(-2, -3)$", "$(-2, 3)$", "$(3, 2)$"],
              "jawaban": 0,
              "pembahasan": "Sumbu X: $(x, y) \\to (x, -y)$. Jadi $(2, 3)$."
            },
            {
              "id": "11-mtl-b04-s6-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Semua transformasi geometri bisa direpresentasikan sebagai matriks.",
              "jawaban": true,
              "pembahasan": "Benar — transformasi linear bisa ditulis sebagai matriks. <b>BENAR</b>."
            },
            {
              "id": "11-mtl-b04-s6-q4",
              "tipe": "isi_kosong",
              "pertanyaan": "Titik $A(5, 2)$ ditranslasi $(-3, 4)$. $y'$ = ... (tulis angka saja)",
              "jawaban": "6",
              "pembahasan": "$y' = 2 + 4 = 6$."
            }
          ]
        }
      ]
    },
