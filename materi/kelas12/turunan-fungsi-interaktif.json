            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "$s(t) = 2t^3 - 6t^2 + 4t$. Tentukan $v(2)$ dan $a(2)$." },
                { "tipe": "formula_block", "latex": "v(t) = 6t^2 - 12t + 4 \\Rightarrow v(2) = 4 \\text{ m/detik}" },
                { "tipe": "formula_block", "latex": "a(t) = 12t - 12 \\Rightarrow a(2) = 12 \\text{ m/detik}^2" }
              ]
