        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Garis Normal",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Garis <b>normal</b> adalah garis yang <b>tegak lurus</b> dengan garis singgung. Jika gradien garis singgung $m$, maka gradien garis normal adalah $-\\dfrac{1}{m}$."
            },
            {
              "tipe": "formula_block",
              "latex": "m_{\\text{normal}} = -\\dfrac{1}{m_{\\text{tangen}}}"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Garis normal $y = x^2$ di $(2, 4)$." },
                { "tipe": "paragraph", "text": "Gradien tangen = $4$. Gradien normal = $-1/4$." },
                { "tipe": "formula_block", "latex": "y - 4 = -\\dfrac{1}{4}(x - 2)" }
              ]
            }
          ],
          "latihan": [
