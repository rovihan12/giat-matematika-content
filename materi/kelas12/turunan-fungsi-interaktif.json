            {
              "tipe": "paragraph",
              "text": "Jika posisi benda $s(t)$, maka:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "Kecepatan: $v(t) = s'(t)$",
                "Percepatan: $a(t) = v'(t) = s''(t)$"
