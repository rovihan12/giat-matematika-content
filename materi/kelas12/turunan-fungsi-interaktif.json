              "tipe": "formula_block",
              "latex": "MC = \\dfrac{dC}{dq}"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "$C(q) = 0{,}01q^2 + 50q + 10000$. Tentukan biaya marginal saat $q = 500$." },
                { "tipe": "formula_block", "latex": "MC = 0{,}02q + 50" },
                { "tipe": "formula_block", "latex": "MC(500) = 10 + 50 = 60 \\text{ rupiah/unit}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-trn-b06-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$C(q) = 0{,}01q^2 + 50q$. $MC = 0{,}02q + ...$. Tulis angka konstanta.",
