    {
      "id": "12-trn-bab-05",
      "nomor": 5,
      "judul": "Aplikasi Turunan: Nilai Maksimum & Minimum",
      "deskripsi": "Menentukan titik ekstrem dan mengoptimalkan fungsi",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Titik Ekstrem",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Titik ekstrem</b> adalah titik di mana fungsi mencapai nilai <b>maksimum lokal</b> atau <b>minimum lokal</b>."
            },
            {
              "tipe": "paragraph",
              "text": "Titik di mana $f'(x) = 0$ disebut <b>titik stasioner</b>. Di titik ini, garis singgungnya horizontal."
            },
            {
              "tipe": "formula_block",
              "latex": "f'(x) = 0"
            },
            {
              "tipe": "image",
              "src": "images/kelas12/turunan-fungsi/titik-ekstrem.png",
              "caption": "Tiga jenis titik stasioner",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "12-trn-b05-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Titik stasioner terjadi saat...",
              "pilihan": ["$f(x) = 0$", "$f'(x) = 0$", "$f''(x) = 0$", "$x = 0$"],
              "jawaban": 1,
              "pembahasan": "Titik stasioner: $f'(x) = 0$."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Uji Turunan Kedua",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$f''(x) < 0$ → titik <b>maksimum lokal</b>",
                "$f''(x) > 0$ → titik <b>minimum lokal</b>",
                "$f''(x) = 0$ → perlu uji lebih lanjut"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan titik ekstrem $f(x) = x^3 - 3x^2 + 2$." },
                { "tipe": "paragraph", "text": "$f'(x) = 3x^2 - 6x = 3x(x-2)$. Set = 0: $x = 0$ atau $x = 2$." },
                { "tipe": "paragraph", "text": "$f''(x) = 6x - 6$." },
                { "tipe": "list", "ordered": false, "items": [
                  "$f''(0) = -6 < 0$ → maksimum di $x = 0$, nilai $f(0) = 2$",
                  "$f''(2) = 6 > 0$ → minimum di $x = 2$, nilai $f(2) = -2$"
                ]}
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-trn-b05-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Jika $f''(x) < 0$, titik stasioner adalah...",
              "pilihan": ["Minimum lokal", "Maksimum lokal", "Titik belok", "Tidak tentu"],
              "jawaban": 1,
              "pembahasan": "$f'' < 0$ → <b>maksimum lokal</b>."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Selang Naik dan Turun",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$f'(x) > 0$ → fungsi <b>naik</b>",
                "$f'(x) < 0$ → fungsi <b>turun</b>",
                "$f'(x) = 0$ → titik stasioner"
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-trn-b05-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Fungsi naik saat...",
              "pilihan": ["$f'(x) > 0$", "$f'(x) < 0$", "$f'(x) = 0$", "$f(x) = 0$"],
              "jawaban": 0,
              "pembahasan": "Fungsi naik saat $f'(x) > 0$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Optimasi: Luas Maksimum",
          "konten": [
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Kawat panjang 40 cm dibuat persegi panjang. Ukuran agar luas maksimum?" },
                { "tipe": "paragraph", "text": "Misal panjang = $x$, lebar = $y$. $2x + 2y = 40 \\Rightarrow y = 20 - x$." },
                { "tipe": "paragraph", "text": "Luas: $L(x) = x(20 - x) = 20x - x^2$." },
                { "tipe": "formula_block", "latex": "L'(x) = 20 - 2x = 0 \\Rightarrow x = 10" },
                { "tipe": "paragraph", "text": "$L''(x) = -2 < 0$ → maksimum. Jadi $y = 10$." },
                { "tipe": "paragraph", "text": "Ukuran optimal: <b>10 cm × 10 cm</b> (persegi)." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-trn-b05-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Luas $L(x) = 20x - x^2$. Nilai $x$ optimal (saat $L' = 0$) = ... (tulis angka saja)",
              "jawaban": "10",
              "pembahasan": "$L' = 20 - 2x = 0 \\Rightarrow x = 10$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Optimasi: Keuntungan Maksimum",
          "konten": [
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Harga $p = 100 - 2q$, biaya $C = 20q + 50$. Tentukan $q$ optimal." },
                { "tipe": "paragraph", "text": "Pendapatan: $R = pq = 100q - 2q^2$." },
                { "tipe": "paragraph", "text": "Keuntungan: $\\pi = R - C = -2q^2 + 80q - 50$." },
                { "tipe": "formula_block", "latex": "\\pi'(q) = -4q + 80 = 0 \\Rightarrow q = 20" },
                { "tipe": "formula_block", "latex": "\\pi(20) = -800 + 1600 - 50 = 750" },
                { "tipe": "paragraph", "text": "Keuntungan maksimum = <b>Rp750.000</b>." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-trn-b05-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Keuntungan $\\pi(q) = -2q^2 + 80q$. Nilai $q$ optimal = ...",
              "pilihan": ["10", "20", "30", "40"],
              "jawaban": 1,
              "pembahasan": "$\\pi' = -4q + 80 = 0 \\Rightarrow q = 20$."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 5",
          "konten": [],
          "latihan": [
            {
              "id": "12-trn-b05-s6-q1",
              "tipe": "pilihan",
              "pertanyaan": "Untuk menemukan titik stasioner, selesaikan...",
              "pilihan": ["$f(x) = 0$", "$f'(x) = 0$", "$f''(x) = 0$", "$x = 0$"],
              "jawaban": 1,
              "pembahasan": "Titik stasioner: $f'(x) = 0$."
            },
            {
              "id": "12-trn-b05-s6-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "$f(x) = x^2 - 4x$. Titik stasioner $x$ = ... (tulis angka saja)",
              "jawaban": "2",
              "pembahasan": "$f' = 2x - 4 = 0 \\Rightarrow x = 2$."
            },
            {
              "id": "12-trn-b05-s6-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Jika $f''(x) > 0$, titik stasioner adalah minimum lokal.",
              "jawaban": true,
              "pembahasan": "Benar — $f'' > 0$ → minimum. <b>BENAR</b>."
            },
            {
              "id": "12-trn-b05-s6-q4",
              "tipe": "pilihan",
              "pertanyaan": "Fungsi turun saat...",
              "pilihan": ["$f'(x) > 0$", "$f'(x) < 0$", "$f'(x) = 0$", "$f(x) = 0$"],
              "jawaban": 1,
              "pembahasan": "Fungsi turun saat $f'(x) < 0$."
            }
          ]
        }
      ]
