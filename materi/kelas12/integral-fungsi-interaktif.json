  "bab": [
    {
      "id": "12-int-bab-01",
      "nomor": 1,
      "judul": "Konsep Dasar Integral",
      "deskripsi": "Integral sebagai anti-turunan dan notasi integral",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Integral?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Integral</b> adalah operasi kebalikan dari turunan. Kalau turunan mencari laju perubahan, integral mencari <b>fungsi asal</b> dari laju perubahannya. Karena itu integral sering disebut <b>anti-turunan</b>."
            },
            {
              "tipe": "paragraph",
              "text": "Bayangkan kamu tahu kecepatan sebuah mobil setiap saat. Kalau kamu ingin tahu <b>posisi</b> mobil itu di waktu tertentu, kamu butuh integral."
            },
            {
              "tipe": "image",
              "src": "images/kelas12/integral-fungsi/integral-turunan.png",
              "caption": "Hubungan turunan dan integral: turunan mencari laju perubahan, integral mencari fungsi asal",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "12-int-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Integral adalah operasi kebalikan dari...",
              "pilihan": ["Penjumlahan", "Turunan", "Perkalian", "Logaritma"],
              "jawaban": 1,
              "pembahasan": "Integral = <b>anti-turunan</b> = kebalikan turunan."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Notasi Integral",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\int f(x) \\, dx = F(x) + C"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$\\int$ = simbol integral",
                "$f(x)$ = integran (fungsi yang diintegralkan)",
                "$dx$ = variabel integrasi",
                "$F(x)$ = anti-turunan dari $f(x)$",
                "$C$ = konstanta integrasi"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Kenapa ada $+ C$? Karena turunan dari konstanta apa pun adalah nol. Jadi $F(x)$, $F(x) + 1$, $F(x) + 100$, semuanya punya turunan yang sama."
            }
          ],
          "latihan": [
            {
              "id": "12-int-b01-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Simbol $\\int$ dibaca...",
              "pilihan": ["Sigma", "Integral", "Delta", "Pi"],
              "jawaban": 1,
              "pembahasan": "$\\int$ = simbol <b>integral</b>."
            },
            {
              "id": "12-int-b01-s2-q2",
              "tipe": "benar_salah",
              "pertanyaan": "Konstanta $C$ muncul di integral tak tentu karena turunan konstanta = 0.",
              "jawaban": true,
              "pembahasan": "Benar — semua anti-turunan berbeda konstanta, jadi perlu + C. <b>BENAR</b>."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Integral dan Turunan Saling Membatalkan",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\dfrac{d}{dx}\\left[\\int f(x) \\, dx\\right] = f(x)"
            },
            {
              "tipe": "formula_block",
              "latex": "\\int f'(x) \\, dx = f(x) + C"
            },
            {
              "tipe": "paragraph",
              "text": "Artinya: kalau kita turunkan hasil integral, kita kembali ke fungsi asal. Begitu juga sebaliknya."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Verifikasi",
              "konten": [
                { "tipe": "paragraph", "text": "Cek apakah $\\int 2x \\, dx = x^2 + C$." },
                { "tipe": "paragraph", "text": "Turunkan $x^2 + C$: $\\dfrac{d}{dx}(x^2 + C) = 2x$ ✓" },
                { "tipe": "paragraph", "text": "Benar!" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-int-b01-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Jika $\\int 3x^2 \\, dx = x^3 + C$, turunan dari $x^3$ = ... (tulis angka koefisien x², misal 5)",
              "jawaban": "3",
              "pembahasan": "$\\frac{d}{dx}(x^3) = 3x^2$. Koefisien = 3."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Contoh-Contoh Integral Sederhana",
          "konten": [
            {
              "tipe": "example",
              "judul": "Contoh 1: Integral Konstanta",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan $\\int 5 \\, dx$." },
                { "tipe": "paragraph", "text": "Cari fungsi yang turunannya 5. Karena turunan $5x$ adalah 5:" },
                { "tipe": "formula_block", "latex": "\\int 5 \\, dx = 5x + C" }
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh 2: Integral Pangkat",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan $\\int x^3 \\, dx$." },
                { "tipe": "paragraph", "text": "Kita tahu turunan $x^4$ adalah $4x^3$, jadi turunan $\\dfrac{1}{4}x^4$ adalah $x^3$." },
                { "tipe": "formula_block", "latex": "\\int x^3 \\, dx = \\dfrac{1}{4}x^4 + C" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-int-b01-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "$\\int 7 \\, dx$ = ...",
              "pilihan": ["$7x + C$", "$7 + C$", "$x + C$", "$\\dfrac{7x^2}{2} + C$"],
              "jawaban": 0,
              "pembahasan": "$\\int c \\, dx = cx + C$. Jadi $7x + C$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 1",
          "konten": [],
          "latihan": [
            {
              "id": "12-int-b01-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Notasi integral tak tentu adalah...",
              "pilihan": ["$\\int_a^b f(x) \\, dx$", "$\\int f(x) \\, dx$", "$\\dfrac{d}{dx}$", "$\\sum f(x)$"],
              "jawaban": 1,
              "pembahasan": "Integral tak tentu: $\\int f(x) \\, dx$ (tanpa batas)."
            },
            {
              "id": "12-int-b01-s5-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\int 4x^3 \\, dx$ = $x^4 + C$. Koefisien x⁴ adalah ... (tulis angka saja)",
              "jawaban": "1",
              "pembahasan": "$\\int 4x^3 \\, dx = x^4 + C$. Koefisien = 1."
            },
            {
              "id": "12-int-b01-s5-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Integral adalah operasi kebalikan dari turunan.",
              "jawaban": true,
              "pembahasan": "Benar — integral = anti-turunan. <b>BENAR</b>."
            }
          ]
        }
      ]
    },
    {
      "id": "12-int-bab-02",
      "nomor": 2,
      "judul": "Integral Tak Tentu",
      "deskripsi": "Rumus dasar integral dan sifat-sifatnya",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Rumus Dasar Integral",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Untuk menghitung integral dengan cepat, kita butuh <b>rumus dasar</b>. Rumus ini diperoleh dari aturan turunan yang kita balik."
            },
            {
              "tipe": "image",
              "src": "images/kelas12/integral-fungsi/rumus-dasar-integral.png",
              "caption": "Rumus dasar integral tak tentu",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "12-int-b02-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Rumus dasar integral diperoleh dari...",
              "pilihan": ["Aturan turunan yang dibalik", "Penjumlahan", "Perkalian", "Logaritma"],
              "jawaban": 0,
              "pembahasan": "Rumus integral = <b>aturan turunan yang dibalik</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Aturan Pangkat",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\int x^n \\, dx = \\dfrac{x^{n+1}}{n+1} + C, \\quad n \\neq -1"
            },
            {
              "tipe": "paragraph",
              "text": "Ini rumus yang paling sering dipakai. Naikkan pangkat satu, lalu bagi dengan pangkat baru."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan $\\int x^5 \\, dx$." },
                { "tipe": "formula_block", "latex": "\\int x^5 \\, dx = \\dfrac{x^6}{6} + C" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-int-b02-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\int x^7 \\, dx$ = $x^{...}/8 + C$. Tulis angka pangkat.",
              "jawaban": "8",
              "pembahasan": "$\\int x^7 \\, dx = x^8/8 + C$. Pangkat = 8."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Integral Konstanta & 1/x",
          "konten": [
            {
              "tipe": "heading",
              "level": 3,
              "text": "Integral Konstanta"
            },
            {
              "tipe": "formula_block",
              "latex": "\\int c \\, dx = cx + C"
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "Integral $1/x$"
            },
            {
              "tipe": "formula_block",
              "latex": "\\int \\dfrac{1}{x} \\, dx = \\ln |x| + C"
            },
            {
              "tipe": "paragraph",
              "text": "Ini kasus khusus dari aturan pangkat. Karena $n = -1$, tidak bisa pakai $x^{n+1}/(n+1)$. Solusinya adalah $\\ln |x|$."
            }
          ],
          "latihan": [
            {
              "id": "12-int-b02-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "$\\int \\dfrac{1}{x} \\, dx$ = ...",
              "pilihan": ["$\\ln|x| + C$", "$x^{-2}/{-2} + C$", "$1/x + C$", "$e^x + C$"],
              "jawaban": 0,
              "pembahasan": "$\\int 1/x \\, dx = \\ln|x| + C$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Sifat-Sifat Integral",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$\\int [f(x) + g(x)] \\, dx = \\int f(x) \\, dx + \\int g(x) \\, dx$",
                "$\\int [f(x) - g(x)] \\, dx = \\int f(x) \\, dx - \\int g(x) \\, dx$",
                "$\\int c \\cdot f(x) \\, dx = c \\int f(x) \\, dx$"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Integral bersifat <b>linear</b> — bisa dipecah per suku, dan konstanta bisa dikeluarkan."
            },
            {
              "tipe": "example",
              "judul": "Contoh: Kombinasi Suku",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan $\\int (3x^2 + 4x - 5) \\, dx$." },
                { "tipe": "formula_block", "latex": "= 3 \\cdot \\dfrac{x^3}{3} + 4 \\cdot \\dfrac{x^2}{2} - 5x + C" },
                { "tipe": "formula_block", "latex": "= x^3 + 2x^2 - 5x + C" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-int-b02-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "$\\int 5x^4 \\, dx$ = ...",
              "pilihan": ["$x^5 + C$", "$5x^5 + C$", "$x^5/5 + C$", "$20x^3 + C$"],
              "jawaban": 0,
              "pembahasan": "$5 \\cdot x^5/5 = x^5$. Jadi $x^5 + C$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Menentukan Konstanta C",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Kalau ada kondisi tambahan (nilai fungsi di satu titik), kita bisa menentukan nilai $C$ yang spesifik."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Diketahui $f'(x) = 2x + 1$ dan $f(0) = 3$. Tentukan $f(x)$." },
                { "tipe": "formula_block", "latex": "f(x) = \\int (2x + 1) \\, dx = x^2 + x + C" },
                { "tipe": "paragraph", "text": "Gunakan $f(0) = 3$:" },
                { "tipe": "formula_block", "latex": "0 + 0 + C = 3 \\Rightarrow C = 3" },
                { "tipe": "formula_block", "latex": "f(x) = x^2 + x + 3" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-int-b02-s5-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$f'(x) = 3x^2$, $f(0) = 5$. Maka $C$ = ... (tulis angka saja)",
              "jawaban": "5",
              "pembahasan": "$f(x) = x^3 + C$. $f(0) = C = 5$."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 2",
          "konten": [],
          "latihan": [
            {
              "id": "12-int-b02-s6-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\int x^4 \\, dx$ = $x^{...}/5 + C$. Tulis pangkat.",
              "jawaban": "5",
              "pembahasan": "$\\int x^4 \\, dx = x^5/5 + C$."
            },
            {
              "id": "12-int-b02-s6-q2",
              "tipe": "pilihan",
              "pertanyaan": "$\\int (2x + 3) \\, dx$ = ...",
              "pilihan": ["$x^2 + 3x + C$", "$2x^2 + 3x + C$", "$x^2 + C$", "$2 + C$"],
              "jawaban": 0,
              "pembahasan": "$x^2 + 3x + C$."
            },
            {
              "id": "12-int-b02-s6-q3",
              "tipe": "benar_salah",
              "pertanyaan": "$\\int \\dfrac{1}{x} \\, dx = \\ln|x| + C$.",
              "jawaban": true,
              "pembahasan": "Benar — kasus khusus aturan pangkat. <b>BENAR</b>."
            },
            {
              "id": "12-int-b02-s6-q4",
              "tipe": "pilihan",
