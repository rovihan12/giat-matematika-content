                { "tipe": "paragraph", "text": "Bentuk $0/0$, gunakan L'Hôpital berulang:" },
                { "tipe": "formula_block", "latex": "= \\lim_{x \\to 0} \\dfrac{\\cos x - 1}{3x^2} = \\lim_{x \\to 0} \\dfrac{-\\sin x}{6x} = -\\dfrac{1}{6}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b03-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Aturan L'Hôpital dipakai untuk bentuk...",
              "pilihan": ["$\\dfrac{1}{1}$", "$\\dfrac{0}{0}$ atau $\\dfrac{\\infty}{\\infty}$", "$\\dfrac{0}{1}$", "$\\dfrac{1}{0}$"],
