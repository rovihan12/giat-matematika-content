      "deskripsi": "Teknik integrasi dan aplikasi lanjutan",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Teknik Integrasi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Tidak semua integral bisa diselesaikan dengan rumus dasar. Ada beberapa <b>teknik integrasi</b> yang perlu dikuasai untuk fungsi yang lebih kompleks."
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b04-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Mengapa perlu teknik integrasi lanjutan?",
              "pilihan": [
                "Karena rumus dasar cukup",
                "Karena tidak semua integral bisa pakai rumus dasar",
                "Karena guru suka",
                "Tidak ada alasan"
              ],
              "jawaban": 1,
              "pembahasan": "Karena <b>tidak semua</b> integral bisa pakai rumus dasar."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Integral Substitusi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Metode ini adalah kebalikan dari aturan rantai. Jika integran berbentuk $f(g(x)) \\cdot g'(x)$, kita misalkan $u = g(x)$, maka $du = g'(x) \\, dx$."
            },
            {
              "tipe": "formula_block",
              "latex": "\\int f(g(x)) \\cdot g'(x) \\, dx = \\int f(u) \\, du"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\int 2x(x^2 + 1)^5 \\, dx$." },
                { "tipe": "paragraph", "text": "Misal $u = x^2 + 1$, maka $du = 2x \\, dx$." },
                { "tipe": "formula_block", "latex": "= \\int u^5 \\, du = \\dfrac{u^6}{6} + C = \\dfrac{(x^2+1)^6}{6} + C" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b04-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "Metode substitusi adalah kebalikan dari...",
              "pilihan": ["Aturan jumlah", "Aturan rantai", "Aturan perkalian", "Aturan bagi"],
              "jawaban": 1,
              "pembahasan": "Substitusi = kebalikan <b>aturan rantai</b>."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Integral Parsial",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Metode ini adalah kebalikan dari aturan perkalian. Berguna untuk integral hasil kali dua fungsi berbeda jenis."
            },
            {
              "tipe": "formula_block",
              "latex": "\\int u \\, dv = uv - \\int v \\, du"
            },
            {
              "tipe": "paragraph",
              "text": "Pilih $u$ yang lebih mudah diturunkan (mis. $x$, $\\ln x$), dan $dv$ yang lebih mudah diintegralkan (mis. $e^x$, $\\sin x$)."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\int x e^x \\, dx$." },
                { "tipe": "paragraph", "text": "Misal $u = x$, $dv = e^x dx$, maka $du = dx$, $v = e^x$." },
                { "tipe": "formula_block", "latex": "= xe^x - \\int e^x \\, dx = xe^x - e^x + C" },
                { "tipe": "formula_block", "latex": "= e^x(x - 1) + C" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b04-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Rumus integral parsial adalah...",
              "pilihan": ["$\\int u \\, dv = uv - \\int v \\, du$", "$\\int u \\, dv = uv + \\int v \\, du$", "$\\int u \\, dv = u \\cdot v$", "$\\int u \\, dv = \\int u \\, du$"],
              "jawaban": 0,
              "pembahasan": "$\\int u \\, dv = uv - \\int v \\, du$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Volume Benda Putar & Panjang Busur",
          "konten": [
            {
              "tipe": "heading",
              "level": 3,
              "text": "Volume Benda Putar"
            },
            {
              "tipe": "paragraph",
              "text": "Volume benda dari memutar kurva $y = f(x)$ mengelilingi sumbu X:"
