        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Turunan Tingkat Tinggi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Turunan bisa diulang berkali-kali. <b>Turunan kedua</b> $f''(x)$ adalah turunan dari $f'(x)$, dan seterusnya."
            },
            {
              "tipe": "formula_block",
              "latex": "f'(x), \\quad f''(x), \\quad f'''(x), \\quad f^{(n)}(x)"
            },
            {
              "tipe": "paragraph",
              "text": "Aplikasi turunan kedua:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Uji kecekungan</b>: $f''(x) > 0$ → cekung ke atas, $f''(x) < 0$ → cekung ke bawah",
                "<b>Titik belok</b>: $f''(x) = 0$ dan berubah tanda",
                "<b>Percepatan</b>: turunan kedua dari posisi"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan turunan kedua $f(x) = x^4 - 3x^2 + 2x$." },
                { "tipe": "formula_block", "latex": "f'(x) = 4x^3 - 6x + 2" },
                { "tipe": "formula_block", "latex": "f''(x) = 12x^2 - 6" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b03-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$f(x) = x^3$. Turunan kedua $f''(x)$ = ...x. Tulis koefisien.",
              "jawaban": "6",
              "pembahasan": "$f'(x) = 3x^2$, $f''(x) = 6x$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Turunan Implisit & Parametrik",
          "konten": [
            {
              "tipe": "heading",
              "level": 3,
              "text": "Turunan Implisit"
            },
            {
              "tipe": "paragraph",
              "text": "Jika hubungan $x$ dan $y$ dalam bentuk <b>implisit</b>, gunakan turunan implisit:"
            },
            {
              "tipe": "formula_block",
              "latex": "\\dfrac{d}{dx}(y^n) = n y^{n-1} \\cdot \\dfrac{dy}{dx}"
            },
            {
              "tipe": "example",
              "judul": "Contoh: $x^2 + y^2 = 25$",
              "konten": [
                { "tipe": "paragraph", "text": "Turunkan kedua ruas terhadap $x$:" },
                { "tipe": "formula_block", "latex": "2x + 2y\\dfrac{dy}{dx} = 0 \\Rightarrow \\dfrac{dy}{dx} = -\\dfrac{x}{y}" }
              ]
            },
            {
              "tipe": "heading",
              "level": 3,
              "text": "Turunan Parametrik"
            },
            {
              "tipe": "paragraph",
              "text": "Jika $x = f(t)$, $y = g(t)$:" },
            {
              "tipe": "formula_block",
              "latex": "\\dfrac{dy}{dx} = \\dfrac{dy/dt}{dx/dt} = \\dfrac{g'(t)}{f'(t)}"
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b03-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Turunan implisit dari $x^2 + y^2 = 25$ adalah...",
              "pilihan": ["$-x/y$", "$x/y$", "$-y/x$", "$y/x$"],
              "jawaban": 0,
              "pembahasan": "$2x + 2y \\cdot dy/dx = 0 \\Rightarrow dy/dx = -x/y$."
            }
          ]
        },
