              "tipe": "formula_block",
              "latex": "\\lim_{x \\to 0} \\dfrac{\\ln(1 + x)}{x} = 1"
            },
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to \\infty} \\left(1 + \\dfrac{1}{x}\\right)^x = e"
