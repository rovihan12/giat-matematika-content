  "bab": [
    {
      "id": "12-mtl-bab-01",
      "nomor": 1,
      "judul": "Geometri Analitik: Lingkaran",
      "deskripsi": "Persamaan lingkaran, garis singgung, dan aplikasinya",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Lingkaran dalam Koordinat Kartesius",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Di Kelas 11, kita sudah mempelajari <b>lingkaran</b> dari sudut pandang geometri. Sekarang kita masuk lebih dalam: bagaimana lingkaran dinyatakan secara <b>aljabar</b> di bidang kartesius."
            },
            {
              "tipe": "paragraph",
              "text": "Pendekatan <b>geometri analitik</b> menggabungkan geometri dengan aljabar — setiap titik, garis, dan kurva direpresentasikan sebagai persamaan matematika."
            },
            {
              "tipe": "image",
              "src": "images/kelas12/matematika-tingkat-lanjut/lingkaran-kartesius.png",
              "caption": "Lingkaran dengan pusat P(a, b) dan jari-jari r di bidang kartesius",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Geometri analitik menggabungkan geometri dengan...",
              "pilihan": ["Statistika", "Aljabar", "Trigonometri", "Peluang"],
              "jawaban": 1,
              "pembahasan": "Geometri analitik = geometri + <b>aljabar</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Bentuk Persamaan Lingkaran",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Pusat di O(0, 0)</b>: $x^2 + y^2 = r^2$",
                "<b>Pusat di P(a, b)</b>: $(x - a)^2 + (y - b)^2 = r^2$",
                "<b>Bentuk umum</b>: $x^2 + y^2 + Ax + By + C = 0$"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Dari bentuk umum, kita bisa menentukan pusat dan jari-jari:"
            },
            {
              "tipe": "formula_block",
              "latex": "\\text{Pusat} = \\left(-\\dfrac{A}{2}, -\\dfrac{B}{2}\\right)"
            },
            {
              "tipe": "formula_block",
              "latex": "r = \\sqrt{\\dfrac{A^2}{4} + \\dfrac{B^2}{4} - C}"
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b01-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Lingkaran pusat (0,0) dengan $r = 4$. Persamaan: $x^2 + y^2 = ...$ (tulis angka saja)",
              "jawaban": "16",
              "pembahasan": "$r^2 = 4^2 = 16$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Posisi Titik terhadap Lingkaran",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Untuk menentukan posisi titik $(x_0, y_0)$ terhadap lingkaran $x^2 + y^2 = r^2$, bandingkan $x_0^2 + y_0^2$ dengan $r^2$:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$x_0^2 + y_0^2 < r^2$ → titik <b>di dalam</b> lingkaran",
                "$x_0^2 + y_0^2 = r^2$ → titik <b>pada</b> lingkaran",
                "$x_0^2 + y_0^2 > r^2$ → titik <b>di luar</b> lingkaran"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh: Pusat & Jari-Jari",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan pusat dan jari-jari lingkaran $x^2 + y^2 - 6x + 4y - 12 = 0$." },
                { "tipe": "paragraph", "text": "Diketahui $A = -6$, $B = 4$, $C = -12$." },
                { "tipe": "formula_block", "latex": "\\text{Pusat} = (3, -2)" },
                { "tipe": "formula_block", "latex": "r = \\sqrt{9 + 4 + 12} = \\sqrt{25} = 5" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b01-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Titik $(1, 1)$ terhadap lingkaran $x^2 + y^2 = 4$...",
              "pilihan": ["Di dalam", "Pada lingkaran", "Di luar", "Tidak tentu"],
              "jawaban": 0,
              "pembahasan": "$1^2 + 1^2 = 2 < 4$ → <b>di dalam</b> lingkaran."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Garis Singgung di Titik pada Lingkaran",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Jika titik $(x_1, y_1)$ berada pada lingkaran $x^2 + y^2 = r^2$, persamaan garis singgung di titik itu adalah:"
            },
            {
              "tipe": "formula_block",
              "latex": "x_1 x + y_1 y = r^2"
            },
            {
              "tipe": "paragraph",
              "text": "Untuk lingkaran dengan pusat $(a, b)$:"
            },
            {
              "tipe": "formula_block",
              "latex": "(x_1 - a)(x - a) + (y_1 - b)(y - b) = r^2"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan garis singgung $x^2 + y^2 = 25$ di titik $(3, 4)$." },
                { "tipe": "paragraph", "text": "Cek: $9 + 16 = 25$ ✓ (titik di lingkaran)." },
                { "tipe": "formula_block", "latex": "3x + 4y = 25" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b01-s4-q1",
              "tipe": "pilihan",
              "pertanyaan": "Garis singgung $x^2 + y^2 = 13$ di titik $(2, 3)$...",
              "pilihan": ["$2x + 3y = 13$", "$3x + 2y = 13$", "$2x - 3y = 13$", "$x + y = 13$"],
              "jawaban": 0,
              "pembahasan": "$x_1 x + y_1 y = r^2 \\Rightarrow 2x + 3y = 13$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Garis Singgung dengan Gradien Diketahui",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Jika gradien garis singgung $m$ diketahui, persamaannya:"
            },
            {
              "tipe": "formula_block",
              "latex": "y = mx \\pm r\\sqrt{1 + m^2}"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan garis singgung $x^2 + y^2 = 13$ dengan gradien 2." },
                { "tipe": "formula_block", "latex": "y = 2x \\pm \\sqrt{13} \\cdot \\sqrt{5} = 2x \\pm \\sqrt{65}" }
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Dari titik di luar lingkaran, ada <b>2 garis singgung</b>. Panjang garis singgung dari titik $(x_1, y_1)$ di luar lingkaran:"
            },
            {
              "tipe": "formula_block",
              "latex": "d = \\sqrt{(x_1 - a)^2 + (y_1 - b)^2 - r^2}"
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b01-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Dari titik di luar lingkaran, ada berapa garis singgung?",
              "pilihan": ["1", "2", "3", "Tak hingga"],
              "jawaban": 1,
              "pembahasan": "Dari titik di luar lingkaran, ada <b>2 garis singgung</b>."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 1",
          "konten": [],
          "latihan": [
            {
              "id": "12-mtl-b01-s6-q1",
              "tipe": "pilihan",
              "pertanyaan": "Bentuk umum persamaan lingkaran adalah...",
              "pilihan": [
                "$x^2 + y^2 = r^2$",
                "$x^2 + y^2 + Ax + By + C = 0$",
                "$y = mx + c$",
                "$ax^2 + bx + c = 0$"
              ],
              "jawaban": 1,
              "pembahasan": "Bentuk umum: $x^2 + y^2 + Ax + By + C = 0$."
            },
            {
              "id": "12-mtl-b01-s6-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "$x^2 + y^2 - 4x - 6y + 4 = 0$. Pusat = (2, ...). Tulis nilai y pusat.",
              "jawaban": "3",
              "pembahasan": "Pusat = $(-A/2, -B/2) = (2, 3)$."
            },
            {
              "id": "12-mtl-b01-s6-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Garis singgung lingkaran tegak lurus jari-jari di titik singgung.",
              "jawaban": true,
              "pembahasan": "Benar — sifat garis singgung. <b>BENAR</b>."
            }
          ]
        }
      ]
    },
    {
      "id": "12-mtl-bab-02",
      "nomor": 2,
      "judul": "Geometri Analitik: Elips, Parabola, dan Hiperbola",
      "deskripsi": "Irisan kerucut dan persamaannya",
      "total_step": 7,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Irisan Kerucut",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Irisan kerucut</b> (conic sections) adalah kurva yang terbentuk dari perpotongan bidang datar dengan kerucut ganda. Ada 4 jenis: <b>lingkaran</b>, <b>elips</b>, <b>parabola</b>, dan <b>hiperbola</b>."
            },
            {
              "tipe": "image",
              "src": "images/kelas12/matematika-tingkat-lanjut/irisan-kerucut.png",
              "caption": "Empat jenis irisan kerucut",
              "width": "full"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "🪐 <b>Elips</b> — orbit planet",
                "📡 <b>Parabola</b> — antena satelit",
                "🛰️ <b>Hiperbola</b> — sistem navigasi GPS",
                "⭕ <b>Lingkaran</b> — bentuk paling simetris"
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b02-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ada berapa jenis irisan kerucut?",
              "pilihan": ["2", "3", "4", "5"],
              "jawaban": 2,
              "pembahasan": "4 jenis: <b>lingkaran, elips, parabola, hiperbola</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Elips",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Elips</b> adalah kumpulan titik yang jumlah jaraknya ke dua titik tetap (disebut <b>fokus</b>) selalu konstan."
            },
            {
              "tipe": "paragraph",
              "text": "Elips dengan pusat di $(0, 0)$ dan sumbu mayor di sumbu X:"
            },
            {
              "tipe": "formula_block",
              "latex": "\\dfrac{x^2}{a^2} + \\dfrac{y^2}{b^2} = 1, \\quad a > b"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$a$ = setengah panjang sumbu mayor",
                "$b$ = setengah panjang sumbu minor",
                "$c = \\sqrt{a^2 - b^2}$ = jarak dari pusat ke fokus",
                "Fokus di $(\\pm c, 0)$",
                "Eksentrisitas $e = c/a$, dengan $0 < e < 1$"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan fokus dan eksentrisitas elips $\\dfrac{x^2}{25} + \\dfrac{y^2}{9} = 1$." },
                { "tipe": "paragraph", "text": "$a^2 = 25 \\Rightarrow a = 5$, $b^2 = 9 \\Rightarrow b = 3$." },
                { "tipe": "formula_block", "latex": "c = \\sqrt{25 - 9} = 4" },
                { "tipe": "paragraph", "text": "Fokus di $(\\pm 4, 0)$, eksentrisitas $e = 4/5 = 0{,}8$." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b02-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Elips $\\dfrac{x^2}{16} + \\dfrac{y^2}{9} = 1$. Nilai $c$ = ... (tulis angka saja)",
              "jawaban": "√7",
              "pembahasan": "$c = \\sqrt{a^2 - b^2} = \\sqrt{16 - 9} = \\sqrt{7}$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Parabola",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Parabola</b> adalah kumpulan titik yang jaraknya ke satu titik (fokus) sama dengan jaraknya ke satu garis (direktris)."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$y^2 = 4px$ → parabola <b>terbuka ke kanan</b>, fokus $(p, 0)$",
                "$y^2 = -4px$ → terbuka ke kiri, fokus $(-p, 0)$",
                "$x^2 = 4py$ → terbuka ke atas, fokus $(0, p)$",
                "$x^2 = -4py$ → terbuka ke bawah, fokus $(0, -p)$"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Persamaan direktris untuk $y^2 = 4px$ adalah $x = -p$. Jarak titik ke fokus = jarak ke direktris."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan fokus & direktris $y^2 = 12x$." },
                { "tipe": "formula_block", "latex": "4p = 12 \\Rightarrow p = 3" },
                { "tipe": "paragraph", "text": "Fokus di $(3, 0)$, direktris $x = -3$." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b02-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "Parabola $y^2 = 20x$. Nilai $p$ = ... (tulis angka saja)",
              "jawaban": "5",
              "pembahasan": "$4p = 20 \\Rightarrow p = 5$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Hiperbola",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Hiperbola</b> adalah kumpulan titik yang selisih jaraknya ke dua fokus selalu konstan."
            },
            {
              "tipe": "formula_block",
              "latex": "\\dfrac{x^2}{a^2} - \\dfrac{y^2}{b^2} = 1"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$a$ = setengah panjang sumbu transversal",
                "$b$ = setengah panjang sumbu konjugat",
                "$c = \\sqrt{a^2 + b^2}$ = jarak dari pusat ke fokus",
                "Fokus di $(\\pm c, 0)$",
                "Asimtot: $y = \\pm \\dfrac{b}{a} x$",
                "Eksentrisitas $e = c/a > 1$"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan fokus, asimtot, dan eksentrisitas $\\dfrac{x^2}{16} - \\dfrac{y^2}{9} = 1$." },
                { "tipe": "paragraph", "text": "$a = 4$, $b = 3$." },
                { "tipe": "formula_block", "latex": "c = \\sqrt{16 + 9} = 5" },
                { "tipe": "list", "ordered": false, "items": [
                  "Fokus: $(\\pm 5, 0)$",
                  "Asimtot: $y = \\pm \\dfrac{3}{4}x$",
                  "Eksentrisitas: $e = 5/4 = 1{,}25$"
                ]}
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b02-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\dfrac{x^2}{9} - \\dfrac{y^2}{16} = 1$. Nilai $c$ = ... (tulis angka saja)",
              "jawaban": "5",
              "pembahasan": "$c = \\sqrt{9 + 16} = 5$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Perbandingan 4 Irisan Kerucut",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Lingkaran</b>: $x^2 + y^2 = r^2$ — jarak ke pusat konstan",
                "<b>Elips</b>: $\\dfrac{x^2}{a^2} + \\dfrac{y^2}{b^2} = 1$ — jumlah jarak ke 2 fokus konstan",
                "<b>Parabola</b>: $y^2 = 4px$ — jarak ke fokus = jarak ke direktris",
                "<b>Hiperbola</b>: $\\dfrac{x^2}{a^2} - \\dfrac{y^2}{b^2} = 1$ — selisih jarak ke 2 fokus konstan"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Eksentrisitas: $e = 0$ (lingkaran), $0 < e < 1$ (elips), $e = 1$ (parabola), $e > 1$ (hiperbola)."
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b02-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Kurva dengan eksentrisitas $e = 1$ adalah...",
              "pilihan": ["Lingkaran", "Elips", "Parabola", "Hiperbola"],
              "jawaban": 2,
              "pembahasan": "$e = 1$ → <b>parabola</b>."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "rangkuman",
          "judul": "Rangkuman Irisan Kerucut",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "Elips: $\\dfrac{x^2}{a^2} + \\dfrac{y^2}{b^2} = 1$ dengan $c^2 = a^2 - b^2$",
                "Parabola: $y^2 = 4px$ dengan fokus $(p, 0)$, direktris $x = -p$",
                "Hiperbola: $\\dfrac{x^2}{a^2} - \\dfrac{y^2}{b^2} = 1$ dengan $c^2 = a^2 + b^2$",
                "Eksentrisitas: $0 \\leq e < 1$ (elips), $e = 1$ (parabola), $e > 1$ (hiperbola)"
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b02-s6-q1",
              "tipe": "pilihan",
              "pertanyaan": "Untuk elips, hubungan $a$, $b$, $c$ adalah...",
              "pilihan": ["$c^2 = a^2 + b^2$", "$c^2 = a^2 - b^2$", "$c^2 = b^2 - a^2$", "$c = a + b$"],
              "jawaban": 1,
              "pembahasan": "Elips: $c^2 = a^2 - b^2$."
            }
          ]
        },
        {
          "step": 7,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 2",
          "konten": [],
          "latihan": [
            {
              "id": "12-mtl-b02-s7-q1",
              "tipe": "pilihan",
              "pertanyaan": "Persamaan elips adalah...",
              "pilihan": [
                "$x^2 + y^2 = r^2$",
                "$\\dfrac{x^2}{a^2} + \\dfrac{y^2}{b^2} = 1$",
                "$y^2 = 4px$",
                "$\\dfrac{x^2}{a^2} - \\dfrac{y^2}{b^2} = 1$"
              ],
              "jawaban": 1,
              "pembahasan": "Elips: $\\dfrac{x^2}{a^2} + \\dfrac{y^2}{b^2} = 1$."
            },
            {
              "id": "12-mtl-b02-s7-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "Parabola $y^2 = 8x$. Fokus di $(..., 0)$. Tulis nilai x.",
              "jawaban": "2",
              "pembahasan": "$4p = 8 \\Rightarrow p = 2$. Fokus $(2, 0)$."
            },
            {
              "id": "12-mtl-b02-s7-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Hiperbola memiliki asimtot.",
              "jawaban": true,
              "pembahasan": "Benar — asimtot $y = \\pm (b/a)x$. <b>BENAR</b>."
            },
            {
              "id": "12-mtl-b02-s7-q4",
              "tipe": "pilihan",
              "pertanyaan": "Eksentrisitas hiperbola...",
              "pilihan": ["$e = 0$", "$0 < e < 1$", "$e = 1$", "$e > 1$"],
              "jawaban": 3,
              "pembahasan": "Hiperbola: $e > 1$."
            }
          ]
        }
      ]
    },
    {
      "id": "12-mtl-bab-03",
      "nomor": 3,
      "judul": "Kalkulus Lanjut: Limit dan Turunan",
      "deskripsi": "Limit dan turunan tingkat lanjut",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Limit Lanjutan",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Di materi wajib, kita sudah mempelajari dasar limit. Di tingkat lanjut, kita masuk lebih dalam: <b>aturan L'Hôpital</b>, <b>limit fungsi khusus</b>, dan aplikasi lanjutan."
            }
          ],
          "latihan": [
            {
              "id": "12-mtl-b03-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Limit lanjutan mencakup...",
              "pilihan": [
                "Hanya substitusi",
