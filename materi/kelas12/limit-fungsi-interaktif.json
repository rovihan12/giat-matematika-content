  "bab": [
    {
      "id": "12-lim-bab-01",
      "nomor": 1,
      "judul": "Konsep Dasar Limit",
      "deskripsi": "Pengertian limit dan pendekatan nilai",
      "total_step": 5,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Apa Itu Limit?",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "<b>Limit</b> adalah nilai yang didekati oleh suatu fungsi ketika variabelnya mendekati nilai tertentu. Konsep ini menjadi <b>dasar kalkulus</b> — turunan dan integral dibangun dari limit."
            },
            {
              "tipe": "paragraph",
              "text": "Bayangkan kamu berjalan menuju pintu. Semakin dekat, kamu hampir menyentuh — tapi belum tentu benar-benar menyentuh. Nah, limit menggambarkan <b>kemana</b> kamu mendekat."
            },
            {
              "tipe": "image",
              "src": "images/kelas12/limit-fungsi/limit-kiri-kanan.png",
              "caption": "Ilustrasi limit kiri dan limit kanan",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b01-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Limit adalah konsep dasar dari...",
              "pilihan": ["Aljabar", "Kalkulus", "Statistika", "Geometri"],
              "jawaban": 1,
              "pembahasan": "Limit = fondasi <b>kalkulus</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Notasi Limit",
          "konten": [
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to a} f(x) = L"
            },
            {
              "tipe": "paragraph",
              "text": "Dibaca: \"limit fungsi $f(x)$ ketika $x$ mendekati $a$ adalah $L$\". Artinya, saat $x$ semakin dekat ke $a$, nilai $f(x)$ semakin dekat ke $L$."
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$\\lim$ = notasi limit",
                "$x \\to a$ = x mendekati a",
                "$L$ = nilai limit"
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b01-s2-q1",
              "tipe": "pilihan",
              "pertanyaan": "$\\lim_{x \\to 3} f(x)$ dibaca...",
              "pilihan": [
                "Limit f(x) saat x sama dengan 3",
                "Limit f(x) saat x mendekati 3",
                "f(x) = 3",
                "f(3)"
              ],
              "jawaban": 1,
              "pembahasan": "$\\lim_{x \\to 3}$ = x <b>mendekati</b> 3."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Limit Kiri dan Limit Kanan",
          "konten": [
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "<b>Limit kiri</b>: $\\lim_{x \\to a^-} f(x)$ — $x$ mendekati $a$ dari kiri ($x < a$)",
                "<b>Limit kanan</b>: $\\lim_{x \\to a^+} f(x)$ — $x$ mendekati $a$ dari kanan ($x > a$)"
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Limit $\\lim_{x \\to a} f(x)$ <b>ada</b> jika dan hanya jika limit kiri = limit kanan:"
            },
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to a^-} f(x) = \\lim_{x \\to a^+} f(x) = L"
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b01-s3-q1",
              "tipe": "benar_salah",
              "pertanyaan": "Limit ada jika limit kiri = limit kanan.",
              "jawaban": true,
              "pembahasan": "Benar — syarat utama keberadaan limit. <b>BENAR</b>."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Pendekatan Numerik & Sifat Limit",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Cara intuitif memahami limit: coba nilai $x$ yang mendekati target dari kedua sisi."
            },
            {
              "tipe": "example",
              "judul": "Contoh Pendekatan Numerik",
              "konten": [
                { "tipe": "paragraph", "text": "Tentukan $\\lim_{x \\to 2} (x^2 + 1)$." },
                { "tipe": "paragraph", "text": "Coba nilai mendekati 2:" },
                { "tipe": "list", "ordered": false, "items": [
                  "$x = 1{,}9$ → 4,61",
                  "$x = 1{,}99$ → 4,96",
                  "$x = 2{,}01$ → 5,04",
                  "$x = 2{,}1$ → 5,41"
                ]},
                { "tipe": "paragraph", "text": "Dari kiri dan kanan, nilai mendekati 5. Jadi $\\lim_{x \\to 2}(x^2 + 1) = 5$." }
              ]
            },
            {
              "tipe": "paragraph",
              "text": "Sifat-sifat limit:" },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$\\lim_{x \\to a} c = c$",
                "$\\lim_{x \\to a} x = a$",
                "$\\lim [f + g] = \\lim f + \\lim g$",
                "$\\lim [f \\cdot g] = \\lim f \\cdot \\lim g$"
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b01-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 5} 7$ = ... (tulis angka saja)",
              "jawaban": "7",
              "pembahasan": "Limit konstanta = konstanta itu sendiri = 7."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 1",
          "konten": [],
          "latihan": [
            {
              "id": "12-lim-b01-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Notasi $\\lim_{x \\to 5}$ dibaca...",
              "pilihan": ["x sama dengan 5", "x mendekati 5", "x lebih besar dari 5", "x kurang dari 5"],
              "jawaban": 1,
              "pembahasan": "$\\to$ = mendekati."
            },
            {
              "id": "12-lim-b01-s5-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 3} (2x + 1)$ = ... (tulis angka saja)",
              "jawaban": "7",
              "pembahasan": "Substitusi $x = 3$: $2(3) + 1 = 7$."
            },
            {
              "id": "12-lim-b01-s5-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Limit kiri dan kanan harus sama agar limit ada.",
              "jawaban": true,
              "pembahasan": "Benar — syarat keberadaan limit. <b>BENAR</b>."
            }
          ]
        }
      ]
    },
    {
      "id": "12-lim-bab-02",
      "nomor": 2,
      "judul": "Limit Fungsi Aljabar",
      "deskripsi": "Menghitung limit dengan substitusi, faktorisasi, dan sekawan",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Tiga Metode Utama",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Untuk menghitung limit fungsi aljabar, ada tiga metode yang biasa dipakai. Pilih metode tergantung bentuk fungsinya."
            },
            {
              "tipe": "image",
              "src": "images/kelas12/limit-fungsi/metode-limit.png",
              "caption": "Tiga metode penyelesaian limit aljabar",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b02-s1-q1",
              "tipe": "pilihan",
              "pertanyaan": "Ada berapa metode utama untuk limit aljabar?",
              "pilihan": ["2", "3", "4", "5"],
              "jawaban": 1,
              "pembahasan": "Tiga: <b>substitusi, faktorisasi, perkalian sekawan</b>."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Metode Substitusi Langsung",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Coba substitusi langsung nilai $x = a$ ke fungsi. Kalau hasilnya <b>terdefinisi</b> (bukan bentuk tak tentu), maka itulah limitnya."
            },
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to a} f(x) = f(a)"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\lim_{x \\to 3} (2x^2 - 5x + 4)$." },
                { "tipe": "formula_block", "latex": "= 2(9) - 15 + 4 = 7" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b02-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 2} (x^2 + 3x)$ = ... (tulis angka saja)",
              "jawaban": "10",
              "pembahasan": "$2^2 + 3(2) = 4 + 6 = 10$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Bentuk Tak Tentu",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Bentuk tak tentu adalah hasil substitusi yang <b>tidak bisa langsung disimpulkan</b>. Yang paling umum:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$\\dfrac{0}{0}$ — paling sering, butuh faktorisasi atau sekawan",
                "$\\dfrac{\\infty}{\\infty}$ — untuk limit tak hingga",
                "$\\infty - \\infty$ — butuh manipulasi aljabar",
                "$0 \\times \\infty$ — butuh manipulasi aljabar"
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b02-s3-q1",
              "tipe": "pilihan",
              "pertanyaan": "Bentuk tak tentu yang paling sering muncul adalah...",
              "pilihan": ["$\\dfrac{1}{0}$", "$\\dfrac{0}{0}$", "$\\dfrac{0}{1}$", "$\\dfrac{1}{1}$"],
              "jawaban": 1,
              "pembahasan": "Bentuk tak tentu paling umum = $\\dfrac{0}{0}$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Metode Faktorisasi",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Kalau substitusi menghasilkan $\\dfrac{0}{0}$, coba <b>faktorkan</b> pembilang dan penyebut, lalu sederhanakan."
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\lim_{x \\to 2} \\dfrac{x^2 - 4}{x - 2}$." },
                { "tipe": "paragraph", "text": "Substitusi langsung: $\\dfrac{0}{0}$ (bentuk tak tentu)." },
                { "tipe": "paragraph", "text": "Faktorkan: $x^2 - 4 = (x-2)(x+2)$." },
                { "tipe": "formula_block", "latex": "\\dfrac{(x-2)(x+2)}{x-2} = x + 2" },
                { "tipe": "paragraph", "text": "Substitusi $x = 2$: $4$." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b02-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 3} \\dfrac{x^2 - 9}{x - 3}$ = ... (tulis angka saja)",
              "jawaban": "6",
              "pembahasan": "Faktorkan: $(x-3)(x+3)/(x-3) = x+3$. Substitusi: $3 + 3 = 6$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Metode Perkalian Sekawan",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Kalau ada bentuk akar dan substitusi menghasilkan $\\dfrac{0}{0}$, kalikan dengan <b>sekawan</b> untuk menghilangkan akar."
            },
            {
              "tipe": "formula_block",
              "latex": "\\sqrt{a} - \\sqrt{b} \\text{ sekawan dengan } \\sqrt{a} + \\sqrt{b}"
            },
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\lim_{x \\to 0} \\dfrac{\\sqrt{x+4} - 2}{x}$." },
                { "tipe": "paragraph", "text": "Kalikan dengan sekawan $\\sqrt{x+4} + 2$:" },
                { "tipe": "formula_block", "latex": "= \\dfrac{x}{x(\\sqrt{x+4} + 2)} = \\dfrac{1}{\\sqrt{x+4} + 2}" },
                { "tipe": "paragraph", "text": "Substitusi $x = 0$: $\\dfrac{1}{4}$." }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b02-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "Sekawan dari $\\sqrt{x} - 3$ adalah...",
              "pilihan": ["$\\sqrt{x} + 3$", "$-\\sqrt{x} + 3$", "$3 - \\sqrt{x}$", "$\\sqrt{x} - 3$"],
              "jawaban": 0,
              "pembahasan": "Sekawan: ubah tanda tengah. $\\sqrt{x} - 3 \\to \\sqrt{x} + 3$."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 2",
          "konten": [],
          "latihan": [
            {
              "id": "12-lim-b02-s6-q1",
              "tipe": "pilihan",
              "pertanyaan": "Metode faktorisasi dipakai untuk bentuk...",
              "pilihan": ["$\\dfrac{0}{0}$", "$\\dfrac{1}{1}$", "$\\dfrac{\\infty}{1}$", "$\\dfrac{0}{1}$"],
              "jawaban": 0,
              "pembahasan": "Faktorisasi untuk bentuk $\\dfrac{0}{0}$."
            },
            {
              "id": "12-lim-b02-s6-q2",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 1} \\dfrac{x^2 - 1}{x - 1}$ = ... (tulis angka saja)",
              "jawaban": "2",
              "pembahasan": "Faktorkan: $(x-1)(x+1)/(x-1) = x+1$. Substitusi: 2."
            },
            {
              "id": "12-lim-b02-s6-q3",
              "tipe": "benar_salah",
              "pertanyaan": "Perkalian sekawan dipakai untuk menghilangkan bentuk akar.",
              "jawaban": true,
              "pembahasan": "Benar — sekawan untuk hilangkan akar. <b>BENAR</b>."
            },
            {
              "id": "12-lim-b02-s6-q4",
              "tipe": "pilihan",
              "pertanyaan": "Substitusi langsung GAGAL jika menghasilkan...",
              "pilihan": ["$\\dfrac{1}{2}$", "$\\dfrac{0}{0}$", "$\\dfrac{1}{1}$", "5"],
              "jawaban": 1,
              "pembahasan": "Bentuk $\\dfrac{0}{0}$ = tak tentu, substitusi langsung gagal."
            }
          ]
        }
      ]
    },
    {
      "id": "12-lim-bab-03",
      "nomor": 3,
      "judul": "Limit Fungsi Trigonometri",
      "deskripsi": "Limit dengan fungsi sinus, cosinus, dan tangen",
      "total_step": 6,
      "langkah": [
        {
          "step": 1,
          "tipe": "intro",
          "judul": "Limit Trigonometri Dasar",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Limit fungsi trigonometri punya <b>sifat khusus</b> ketika sudutnya mendekati 0."
            },
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to 0} \\dfrac{\\sin x}{x} = 1"
            },
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to 0} \\dfrac{\\tan x}{x} = 1"
            },
            {
              "tipe": "image",
              "src": "images/kelas12/limit-fungsi/limit-trigonometri.png",
              "caption": "Grafik fungsi sin(x)/x mendekati 1 ketika x mendekati 0",
              "width": "full"
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b03-s1-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 0} \\dfrac{\\sin x}{x}$ = ... (tulis angka saja)",
              "jawaban": "1",
              "pembahasan": "$\\lim_{x \\to 0} \\sin x / x = 1$."
            }
          ]
        },
        {
          "step": 2,
          "tipe": "konsep",
          "judul": "Modifikasi Rumus Dasar",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Jika sudutnya bukan $x$ melainkan $ax$ (dengan $a$ konstanta):"
            },
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to 0} \\dfrac{\\sin ax}{bx} = \\dfrac{a}{b}"
            },
            {
              "tipe": "formula_block",
              "latex": "\\lim_{x \\to 0} \\dfrac{\\tan ax}{bx} = \\dfrac{a}{b}"
            },
            {
              "tipe": "paragraph",
              "text": "Catatan: <b>sudut harus dalam radian</b>. Kalau dalam derajat, rumus ini tidak berlaku."
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b03-s2-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 0} \\dfrac{\\sin 5x}{x}$ = ... (tulis angka saja)",
              "jawaban": "5",
              "pembahasan": "$\\lim \\sin(5x)/x = 5/1 = 5$."
            }
          ]
        },
        {
          "step": 3,
          "tipe": "konsep",
          "judul": "Perbandingan Sinus & Tangen",
          "konten": [
            {
              "tipe": "example",
              "judul": "Contoh: Sinus / Sinus",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\lim_{x \\to 0} \\dfrac{\\sin 5x}{\\sin 2x}$." },
                { "tipe": "paragraph", "text": "Kalikan dengan bentuk yang sesuai:" },
                { "tipe": "formula_block", "latex": "= \\dfrac{5}{2} \\cdot \\dfrac{\\lim \\frac{\\sin 5x}{5x}}{\\lim \\frac{\\sin 2x}{2x}} = \\dfrac{5}{2}" }
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh: Tangen / Sinus",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\lim_{x \\to 0} \\dfrac{\\tan 2x}{\\sin 4x}$." },
                { "tipe": "formula_block", "latex": "= \\dfrac{2}{4} = \\dfrac{1}{2}" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b03-s3-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 0} \\dfrac{\\sin 3x}{\\sin x}$ = ... (tulis angka saja)",
              "jawaban": "3",
              "pembahasan": "Perbandingan koefisien: $3/1 = 3$."
            }
          ]
        },
        {
          "step": 4,
          "tipe": "konsep",
          "judul": "Identitas Trigonometri",
          "konten": [
            {
              "tipe": "paragraph",
              "text": "Beberapa limit trigonometri butuh identitas untuk disederhanakan. Yang sering dipakai:"
            },
            {
              "tipe": "list",
              "ordered": false,
              "items": [
                "$\\sin^2 x + \\cos^2 x = 1$",
                "$1 - \\cos 2x = 2\\sin^2 x$",
                "$1 + \\cos 2x = 2\\cos^2 x$",
                "$\\sin 2x = 2\\sin x \\cos x$",
                "$\\tan x = \\dfrac{\\sin x}{\\cos x}$"
              ]
            },
            {
              "tipe": "example",
              "judul": "Contoh Kompleks",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\lim_{x \\to 0} \\dfrac{1 - \\cos 2x}{x^2}$." },
                { "tipe": "paragraph", "text": "Gunakan $1 - \\cos 2x = 2\\sin^2 x$:" },
                { "tipe": "formula_block", "latex": "= 2 \\cdot \\left(\\lim_{x \\to 0} \\dfrac{\\sin x}{x}\\right)^2 = 2 \\cdot 1 = 2" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b03-s4-q1",
              "tipe": "isi_kosong",
              "pertanyaan": "$\\lim_{x \\to 0} \\dfrac{1 - \\cos 2x}{x^2}$ = ... (tulis angka saja)",
              "jawaban": "2",
              "pembahasan": "Pakai identitas: $2\\sin^2 x / x^2 \\to 2 \\cdot 1 = 2$."
            }
          ]
        },
        {
          "step": 5,
          "tipe": "konsep",
          "judul": "Latihan Kombinasi",
          "konten": [
            {
              "tipe": "example",
              "judul": "Contoh",
              "konten": [
                { "tipe": "paragraph", "text": "Hitung $\\lim_{x \\to 0} \\dfrac{\\sin 4x}{\\tan 2x}$." },
                { "tipe": "paragraph", "text": "Ubah ke bentuk dasar:" },
                { "tipe": "formula_block", "latex": "= \\dfrac{\\frac{\\sin 4x}{4x} \\cdot 4x}{\\frac{\\tan 2x}{2x} \\cdot 2x} = \\dfrac{4}{2} = 2" }
              ]
            }
          ],
          "latihan": [
            {
              "id": "12-lim-b03-s5-q1",
              "tipe": "pilihan",
              "pertanyaan": "$\\lim_{x \\to 0} \\dfrac{\\tan 6x}{\\sin 3x}$ = ...",
              "pilihan": ["2", "3", "6", "1/2"],
              "jawaban": 0,
              "pembahasan": "Perbandingan koefisien: $6/3 = 2$."
            },
            {
              "id": "12-lim-b03-s5-q2",
              "tipe": "benar_salah",
              "pertanyaan": "Rumus limit trigonometri hanya berlaku jika sudut dalam radian.",
              "jawaban": true,
              "pembahasan": "Benar — jika sudut dalam derajat, rumus tidak berlaku. <b>BENAR</b>."
            }
          ]
        },
        {
          "step": 6,
          "tipe": "ujian_bab",
          "judul": "Uji Pemahaman Bab 3",
          "konten": [],
          "latihan": [
            {
              "id": "12-lim-b03-s6-q1",
              "tipe": "isi_kosong",
